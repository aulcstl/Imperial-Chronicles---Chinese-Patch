    # gabbto "Вроде похож."
    gabbto "看起来像。"

# game/a14/1lords_lords.rpy:831
translate english lords_lords4_868a37d0:

    # me "Нет. Я [mename]."
    me "不。我是[mename]。"

# game/a14/1lords_lords.rpy:832
translate english lords_lords4_25fca5c2:

    # murra "Тьфу ты. Еще ждать значит."
    murra "呸。还得等。"

# game/a14/1lords_lords.rpy:833
translate english lords_lords4_11f772c6:

    # gabbto "Все Mencha vondas flassan и bradas nes ovodos на одно лицо. И за что только они воевали."
    gabbto "所有的 Mencha vondas flassan 和 bradas nes ovodos 看起来都一个样。真不知道他们当初为啥打仗。"

# game/a14/1lords_lords.rpy:834
translate english lords_lords4_f9de3f6c:

    # me "Мы ищем дорогу к Даркхоллу."
    me "我们在找去达克霍尔的路。"

# game/a14/1lords_lords.rpy:835
translate english lords_lords4_290874d7:

    # murra "Даркхолл? Это Danklas Schalas?"
    murra "达克霍尔？就是 Danklas Schalas？"

# game/a14/1lords_lords.rpy:836
translate english lords_lords4_8e9a5b64:

    # gabbto "Так его люди называют. Его ведь гномы строили, знаешь?"
    gabbto "人类是这么叫的。要知道，那地方是矮人建的。"

# game/a14/1lords_lords.rpy:837
translate english lords_lords4_95d54c53:

    # me "Нет. Но спасибо, что поделились."
    me "不知道。但谢谢分享。"

# game/a14/1lords_lords.rpy:838
translate english lords_lords4_5fa649be:

    # murra "Тебе дальше по дороге. Не поверни направо случайно."
    murra "你们顺着路继续走。可别右拐。"

# game/a14/1lords_lords.rpy:839
translate english lords_lords4_bbad1bdc:

    # gabbto "Если не хочешь оказаться в наших землях, хе-хе."
    gabbto "除非你想进到我们的地盘里，呵呵。"

# game/a14/1lords_lords.rpy:841
translate english lords_lords4_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a14/1lords_lords.rpy:842
translate english lords_lords4_725707f8:

    # murra "Так о чем мы там... ах да. Так ты рад, что нас изгнали, baduk?"
    murra "我们刚才说到哪儿了... 啊，对。所以你高兴我们被放逐了，baduk？"

# game/a14/1lords_lords.rpy:843
translate english lords_lords4_bd4ae7d3:

    # gabbto "Чего? Я не рад. Я сказал мы нарушили закон."
    gabbto "什么？我不高兴。我说了我们违反了法律。"

# game/a14/1lords_lords.rpy:844
translate english lords_lords4_1d45a9f6:

    # murra "А я этот закон не подписывал."
    murra "这条法律我可没签同意。"

# game/a14/1lords_lords.rpy:845
translate english lords_lords4_3df10d62:

    # gabbto "И что? Если ты один не согласен, то его все равно переделать должны?"
    gabbto "那又怎样？难道你一个人不同意，就应该把它推翻重来吗？"

# game/a14/1lords_lords.rpy:846
translate english lords_lords4_809b3bce:

    # murra "А как я могу нарушить правило, с которым не соглашался?"
    murra "我怎么能违反一条我没同意的规矩？"

# game/a14/1lords_lords.rpy:847
translate english lords_lords4_c32373fe:

    # gabbto "Так что, нужно без правил жить, как гоблины?"
    gabbto "那你的意思就是，得像地精那样没有规矩地活着？"

# game/a14/1lords_lords.rpy:848
translate english lords_lords4_f42b9947:

    # murra "А они посчастливее многих живут."
    murra "他们过得可比很多人快活多了。"

# game/a14/1lords_lords.rpy:849
translate english lords_lords4_b24a0d08:

    # gabbto "Да они свое дерьмо жрут!"
    gabbto "他们吃自己的粪便！"

# game/a14/1lords_lords.rpy:850
translate english lords_lords4_18f831e3:

    # murra "Кто тебе такую чушь сказал?"
    murra "谁跟你说的这种胡话？"

# game/a14/1lords_lords.rpy:851
translate english lords_lords4_91c4ed39:

    # teos "Поверим им?"
    teos "我们相信他们吗？"

# game/a14/1lords_lords.rpy:852
translate english lords_lords4_af839b91:

    # me "Ну... врать им незачем."
    me "嗯... 他们没理由骗我们。"

# game/a14/1lords_lords.rpy:853
translate english lords_lords4_8017b0fd:

    # teos "Ну тогда по прямой?"
    teos "那就直走？"

# game/a14/1lords_lords.rpy:854
translate english lords_lords4_99f313cd:

    # me "Ага. Только дай мне секундочку."
    me "嗯。稍等我一下。"

# game/a14/1lords_lords.rpy:856
translate english lords_lords4_5a2bd0c0:

    # murra "Ну что? Мы же сказали - по прямой. Не поверни на право."
    murra "怎么了？我们说了——直走。别右拐。"

# game/a14/1lords_lords.rpy:857
translate english lords_lords4_c4d3a59b:

    # gabbto "Все люди кретины. Им надо по два раза повторять."
    gabbto "人类都是蠢货。非得跟他们重复两遍。"

# game/a14/1lords_lords.rpy:858
translate english lords_lords4_6ebc822a:

    # me "Я бы хотел узнать в чем предмет спора."
    me "我想知道你们在争论什么。"

# game/a14/1lords_lords.rpy:859
translate english lords_lords4_9cb53fbf:

    # murra "Никакого спора нет - мой лысый друг просто любит когда им помыкают."
    murra "没什么好争论的——我这秃头朋友就是喜欢被人使唤。"

# game/a14/1lords_lords.rpy:860
translate english lords_lords4_db6a7931:

    # gabbto "Мой волосатый друг любит жрать говно вместе с дикарями по типу гоблинов."
    gabbto "我这长毛的朋友喜欢和地精那样的野人一样吃屎。"

# game/a14/1lords_lords.rpy:861
translate english lords_lords4_60358084:

    # me "Эм..."
    me "呃..."

# game/a14/1lords_lords.rpy:862
translate english lords_lords4_fa907395:

    # murra "Я говорю - мы правила не подписывали. За что нас судить и выгонять за их неисполнение?"
    murra "我是说——规矩又没找我们签字。凭什么要审判我们，还把我们从家里赶出来，就因为我们没遵守？"

# game/a14/1lords_lords.rpy:863
translate english lords_lords4_f8bc215e:

    # gabbto "Так если тебе эти правила не нравится, ты счастлив должен быть что тебя изгнали и их больше не надо соблюдать!"
    gabbto "既然你不喜欢这些规矩，那你应该高兴被赶出来才对啊，这样不就不用再遵守了吗！"

# game/a14/1lords_lords.rpy:864
translate english lords_lords4_3820771a:

    # me "..."
    me "..."

# game/a14/1lords_lords.rpy:865
translate english lords_lords4_b44b8ba3:

    # murra "Ну идиот. Baduk!"
    murra "真是个白痴。Baduk！"

# game/a14/1lords_lords.rpy:866
translate english lords_lords4_35d374df:

    # gabbto "Baduk это ты!"
    gabbto "你才是 baduk！"

# game/a14/1lords_lords.rpy:867
translate english lords_lords4_70bc1aac:

    # me "Я так и не понял..."
    me "我还是没听懂..."

# game/a14/1lords_lords.rpy:868
translate english lords_lords4_e554a616:

    # murra "Да все просто. Я ему говорю - земли от Трех Братьев до ущелья хоть жопой жуй, а живем все одинаково дерьмово. Потому что за нас все Совет Кланов решает."
    murra "很简单。我跟他说——从三兄弟山到山沟那边，土地随你怎么用屁股啃，但我们都活得一样差劲。因为什么事都是氏族议会替我们决定。"

# game/a14/1lords_lords.rpy:869
translate english lords_lords4_e412b7cc:

    # gabbto "Тысячи лет решал и все нормально было, а теперь вдруг плохо стало!"
    gabbto "几千年来一直这么决定，都挺好的，现在突然变糟了！"

# game/a14/1lords_lords.rpy:870
translate english lords_lords4_276aa9ec:

    # murra "Ты послушай, baduk, я вот, допустим, не хочу десятину в клан уплачивать!"
    murra "你听我说，baduk，我，举个例子，就是不想给氏族交什一税！"

# game/a14/1lords_lords.rpy:871
translate english lords_lords4_e06bf3aa:

    # gabbto "Сам ты baduk. Так заведено. На эту десятину кормятся воины, строятся мосты и создаются тропы в горах!"
    gabbto "你才是 baduk。规矩就是这么定的。战士的口粮、修的桥、山里开的路，都得靠这什一税！"

# game/a14/1lords_lords.rpy:872
translate english lords_lords4_f441c0d6:

    # murra "А я вот может хочу кормить воинов и строить мосты, а тропы мне ни к чему, не люблю путешествовать."
    murra "可我，也许想养战士、造桥，但路我根本不需要，我不爱出远门。"

# game/a14/1lords_lords.rpy:873
translate english lords_lords4_8af3ec81:

    # gabbto "Тебе ни к чему. А остальным?"
    gabbto "你不需要。那其他人呢？"

# game/a14/1lords_lords.rpy:874
translate english lords_lords4_5a5568ee:

    # murra "А кому надо пусть и платит."
    murra "谁需要谁付钱呗。"

# game/a14/1lords_lords.rpy:876
translate english lords_lords4_4c3ca7fc:

    # gabbto "Эка ты придумал. И что же с каждого налог индивидуально собирать нужно, на что ему хочется?"
    gabbto "瞧你说的。那岂不是得按每个人的需求单独征税？"

# game/a14/1lords_lords.rpy:877
translate english lords_lords4_42dde5d6:

    # murra "А что не так?"
    murra "有什么不对吗？"

# game/a14/1lords_lords.rpy:878
translate english lords_lords4_f56e677c:

    # gabbto "Так ты сэкономить хочешь? Тебе на такую чушь такая армия бюрократов понадобиться, ты только в минус уйдешь."
    gabbto "你是想省钱吗？搞这种蠢事需要的官僚多得能组一支军队，你只会赔钱。"

# game/a14/1lords_lords.rpy:879
translate english lords_lords4_20faac49:

    # murra "А дело здесь не в экономии. Я может не хочу Мораху его пиры оплачивать."
    murra "这事跟省钱没关系。我只是不想出钱供莫拉赫开宴会。"

# game/a14/1lords_lords.rpy:880
translate english lords_lords4_a44225ff:

    # gabbto "Тыж сам на них сидел, жрал и пиво пил!"
    gabbto "你自己不也坐在那里，大吃大喝，喝啤酒吗！"

# game/a14/1lords_lords.rpy:881
translate english lords_lords4_64233cd2:

    # murra "Так что у меня что выбор был?"
    murra "那我还有选择吗？"

# game/a14/1lords_lords.rpy:882
translate english lords_lords4_ec6c0879:

    # gabbto "Со слезами на глазах красной рыбой давился!"
    gabbto "眼含热泪，被红鱼噎死！"

# game/a14/1lords_lords.rpy:883
translate english lords_lords4_3dbb1248:

    # murra "Так на мои деньги собрано! Еще бы."
    murra "那都是用我的钱置办的！我当然得吃回来。"

# game/a14/1lords_lords.rpy:884
translate english lords_lords4_348e5a12:

    # gabbto "А знаешь кто по другому живет? Эльфы да гоблины, все кто в дерьме или в болоте копошатся."
    gabbto "你知道还有谁过着不一样的日子吗？是精灵和地精，所有在粪堆或沼泽里刨食的家伙。"

# game/a14/1lords_lords.rpy:885
translate english lords_lords4_6c32c2bf:

    # murra "Ты не прав. Был бы у меня свой клан..."
    murra "你错了。要是我有自己的氏族..."

# game/a14/1lords_lords.rpy:886
translate english lords_lords4_b2d8ce9b:

    # gabbto "Ты бы налог не собирал. На добром слове казну держал."
    gabbto "你不会征税。就靠一句好话撑着金库。"

# game/a14/1lords_lords.rpy:887
translate english lords_lords4_6dde3d46:

    # murra "А мне много золота не надо. Все бы на что хотели на то и тратили."
    murra "我要那么多金子没用。钱就都花在大家想花的地方。"

# game/a14/1lords_lords.rpy:888
translate english lords_lords4_d0d4bf8a:

    # gabbto "И с чего ж тогда этот клан твой был, м?"
    gabbto "那你这个氏族，凭什么存在呢，嗯？"

# game/a14/1lords_lords.rpy:889
translate english lords_lords4_c98c7a3d:

    # murra "В смысле?"
    murra "什么意思？"

# game/a14/1lords_lords.rpy:890
translate english lords_lords4_4d8df48f:

    # gabbto "В смысле если ты не будешь собирать налоги как положено и палкой бить несогласных - то как ты этот клан вообще удержишь? На добром слове и своей бороде?"
    gabbto "意思是如果你不按规定征税，不用棍子打不服的，那你到底怎么维持这个氏族？就靠一句好话和你这把胡子？"

# game/a14/1lords_lords.rpy:891
translate english lords_lords4_cff21d69:

    # murra "Кто захочет - тот и внесёт. Кто не захочет - не внесёт и у себя оставит. Всё по совести."
    murra "谁愿意交谁就交。谁不愿意就不交，自己留着。全凭良心。"

# game/a14/1lords_lords.rpy:892
translate english lords_lords4_aa2f436d:

    # gabbto "А если люди нападут опять, или мост рухнет? Половина скажет, что не в настроении воевать, а другая что мост от них далековато, так что ремонт и без них обойдется."
    gabbto "那要是又有人来打我们，或者桥塌了呢？一半人说没心情打仗，另一半说桥离他们太远，修桥没他们的事儿。"

# game/a14/1lords_lords.rpy:893
translate english lords_lords4_c9a77991:

    # murra "Глупость какая, с разрушенным мостом все пострадают сразу. По цепочке. Ну от вторжения точно все защищаться будут."
    murra "多愚蠢啊，桥毁了所有人都会立刻受影响。会产生连锁反应的。嗯，至少对抗入侵者，大家肯定都会保卫自己的。"

# game/a14/1lords_lords.rpy:894
translate english lords_lords4_594bc91c:

    # gabbto "Тьфу! Тысячи лет Совет Кланов держал порядок, а ты всё хочешь на какую-то 'добровольность' перевести, мечтатель!"
    gabbto "呸！几千年来氏族议会维持着秩序，你却想用什么‘自愿’来改变一切，空想家！"

# game/a14/1lords_lords.rpy:895
translate english lords_lords4_31d49a12:

    # murra "Именно! Если клан действительно свободен - его будут поддерживать. И не потому что боятся изгнания или казни от Мораха, а потому что сами хотят."
    murra "正是！如果一个氏族是真正自由的——大家自然会支持它。不是因为害怕被莫拉赫放逐或处决，而是因为他们自己愿意。"

# game/a14/1lords_lords.rpy:896
translate english lords_lords4_159c8803:

    # gabbto "Без Мораха? Кто же без Мораха судить будет? М?"
    gabbto "没有莫拉赫？那让谁来审判，嗯？"

# game/a14/1lords_lords.rpy:897
translate english lords_lords4_303f6b3e:

    # murra "А все остальные."
    murra "其他人，所有人。"

# game/a14/1lords_lords.rpy:898
translate english lords_lords4_816e6d5d:

    # gabbto "Вот прям так все будут каждый раз из-за каждой кражи собираться."
    gabbto "那岂不是每次遇到盗窃案，所有人都得聚在一起。"

# game/a14/1lords_lords.rpy:899
translate english lords_lords4_d2cb4710:

    # murra "Ну значит тот, кому обе стороны доверяют."
    murra "那就找双方都信任的人来审判。"

# game/a14/1lords_lords.rpy:900
translate english lords_lords4_155a4e85:

    # gabbto "А если такого не найдется?"
    gabbto "那要是找不到呢？"

# game/a14/1lords_lords.rpy:901
translate english lords_lords4_5f623fbf:

    # murra "Быть того не может. В крайнем случае я решу."
    murra "不可能没有。实在不行，我来裁决。"

# game/a14/1lords_lords.rpy:902
translate english lords_lords4_1f131436:

    # gabbto "Ага. Все-таки Морах нужен."
    gabbto "啊哈。说来说去，还是需要一个莫拉赫。"

# game/a14/1lords_lords.rpy:903
translate english lords_lords4_71a69a18:

    # murra "Только если других вариантов нет. А не когда этот вариант - единственный."
    murra "只有万不得已时才需要。而不是让这成为唯一的选项。"

# game/a14/1lords_lords.rpy:904
translate english lords_lords4_22cc7314:

    # gabbto "И что же? Все так жить и должны?"
    gabbto "那又怎样？所有人都得这么过日子？"

# game/a14/1lords_lords.rpy:905
translate english lords_lords4_e5704f51:

    # murra "Не все. Кто хотят. Земли дайте и отстаньте."
    murra "不是所有人。想这么过的人。给他们土地，别管他们。"

# game/a14/1lords_lords.rpy:906
translate english lords_lords4_7784277b:

    # gabbto "Мечтатель..."
    gabbto "空想家..."

# game/a14/1lords_lords.rpy:907
translate english lords_lords4_389f9143:

    # murra "А ты не мечтаешь, радуешься что тебя Морах за бороду держит, когда ты в нужник ходишь!"
    murra "你不空想，你很高兴被莫拉赫揪着胡子，哪怕你去茅房！"

# game/a14/1lords_lords.rpy:908
translate english lords_lords4_cc7fb9d6:

    # gabbto "Кто? Я? А ты радуешься что тебя изгнали! Тьфу."
    gabbto "谁？我？你才高兴被放逐呢！呸。"

# game/a14/1lords_lords.rpy:913
translate english lords_lords4_46ddb6e4:

    # me "Ладно. Удачи вам... что бы вы тут не делали."
    me "好吧。祝你们顺利... 不管你们在这儿干什么。"

# game/a14/1lords_lords.rpy:914
translate english lords_lords4_49cc49fa:

    # murra "Baduk!"
    murra "Baduk！"

# game/a14/1lords_lords.rpy:915
translate english lords_lords4_150df7d4:

    # gabbto "Сам такой! Фантазёр!"
    gabbto "你才是！幻想家！"

# game/a14/1lords_lords.rpy:918
translate english lords_lords4_fe02d0a0:

    # me "Думаю в словах Муррабарда есть своя правда."
    me "我觉得Murrabard的话有他的道理。"

# game/a14/1lords_lords.rpy:919
translate english lords_lords4_e81ff542:

    # murra "Вот! Даже человек понял!"
    murra "瞧！连人类都懂了！"

# game/a14/1lords_lords.rpy:920
translate english lords_lords4_cda8ed75:

    # gabbto "Они поэтому все время друг друга и режут, что у них такие мечтатели до власти добираются."
    gabbto "就因为有这种空想家掌了权，他们才总互相残杀。"

# game/a14/1lords_lords.rpy:921
translate english lords_lords4_e7752d99:

    # me "Это конечно сложно осуществить. Но пожалуй это общество к которому стоит стремиться."
    me "这当然很难实现。但这也许是我们应该追求的社会形态。"

# game/a14/1lords_lords.rpy:922
translate english lords_lords4_9a0275c2:

    # murra "Верно! Но ведь никто и не пытается."
    murra "没错！但就是没人去尝试。"

