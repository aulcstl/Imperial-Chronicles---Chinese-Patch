# game/a14/3highland.rpy:437
translate english highland_6e263190:

    # krastan "{size=+4}За моего этого... как его там...{/size}"
    krastan "{size=+4}敬我的那个……那个谁……{/size}"

# game/a14/3highland.rpy:438
translate english highland_d9854871:

    # highlanders "{size=+8}...{/size}"
    highlanders "{size=+8}……{/size}"

# game/a14/3highland.rpy:439
translate english highland_9343329c:

    # krastan "{size=+4}За красного принца!{/size}"
    krastan "{size=+4}敬红衣王子！{/size}"

# game/a14/3highland.rpy:440
translate english highland_d9854871_1:

    # highlanders "{size=+8}...{/size}"
    highlanders "{size=+8}……{/size}"

# game/a14/3highland.rpy:441
translate english highland_82537c3f:

    # krastan "Ладно, мне надо сходить поссать."
    krastan "好了，我得去撒泡尿。"

# game/a14/3highland.rpy:442
translate english highland_8b3e7903:

    # highlander "{size=+8}Мне тоже!{/size}"
    highlander "{size=+8}我也是！{/size}"

# game/a14/3highland.rpy:444
translate english highland_23cbf6e3:

    # harold "{size=-2}Ну и что будем делать?{/size}"
    harold "{size=-2}那我们该怎么办？{/size}"

# game/a14/3highland.rpy:445
translate english highland_9509e650:

    # me "{size=-2}Ситуация странная. Думаю можно точно сделать вывод, что это не засада и не обман. Иначе бы они уже напали.{/size}"
    me "{size=-2}情况很奇怪。我想可以确定，这不是埋伏也不是骗局。否则他们早该动手了。{/size}"

# game/a14/3highland.rpy:446
translate english highland_fb888895:

    # harold "{size=-2}Но свадьба-то вполне настоящая.{/size}"
    harold "{size=-2}但婚礼确实是真的。{/size}"

# game/a14/3highland.rpy:447
translate english highland_8982cdfa:

    # me "{size=-2}Верно. Отправь людей к Скаладану. Пусть объяснится за свое письмо.{/size}"
    me "{size=-2}没错。派人去见Scaladan。就他写的信让他解释清楚。{/size}"

# game/a14/3highland.rpy:448
translate english highland_93cf7652:

    # harold "{size=-2}Понял. И вели ему постепенно подводить людей. Не знаю, сколько продлится эта свадьба, но времени у нас не очень много.{/size}"
    harold "{size=-2}明白。让他逐渐把兵力调过来。我不知道这个婚礼会持续多久，但留给我们的时间不多了。{/size}"

# game/a14/3highland.rpy:449
translate english highland_de54cfbd:

    # me "{size=-2}Мой принц?{/size}"
    me "{size=-2}我的王子？{/size}"

# game/a14/3highland.rpy:450
translate english highland_0ba6c7ec:

    # harold "{size=-2}Подозреваю, что они исполнят угрозу и после свадьбы заберут лорда Войцеха в Высокую Страну.{/size}"
    harold "{size=-2}我怀疑他们会履行威胁，婚礼结束后就把Vojceh大人带到高地之国去。{/size}"

# game/a14/3highland.rpy:451
translate english highland_aad434c9:

    # me "{size=-2}Зачем.{/size}"
    me "{size=-2}为什么。{/size}"

# game/a14/3highland.rpy:452
translate english highland_00294394:

    # harold "{size=-2}Хотят чтобы он точно консумировал брак. А потом и первенца его заберут, особенно если это будет мальчик.{/size}"
    harold "{size=-2}他们想确保他完成圆房。然后他们会带走他的第一个孩子，尤其如果是个男孩的话。{/size}"

# game/a14/3highland.rpy:453
translate english highland_152af068:

    # me "{size=-2}Зачем им это?{/size}"
    me "{size=-2}他们要这个干什么？{/size}"

# game/a14/3highland.rpy:454
translate english highland_ee709b90:

    # me "{size=-2}А разве непонятно? У Войцеха нет других детей. Высокая Страна это тоже часть Севера, а значит брак по их традициям легитимен, и наследники, рожденные в нем тоже.{/size}"
    me "{size=-2}还不明白吗？Vojceh没有别的孩子。高地之国也是北方的一部分，所以按照他们的传统，这个婚姻是合法的，其中出生的继承人也同样合法。{/size}"

# game/a14/3highland.rpy:455
translate english highland_60c6bb3e:

    # harold "{size=-2}Они взяли его в плен. Это другое.{/size}"
    harold "{size=-2}他们可是抓住了他。这是两码事。{/size}"

# game/a14/3highland.rpy:457
translate english highland_d1a60ee9:

    # highlander "{size=+5}Ах ты сука такая? И ты мне брат после этого?{/size}"
    highlander "{size=+5}你这个臭婊子？你跟我耍这哥哥之后？{/size}"

# game/a14/3highland.rpy:458
translate english highland_0eaf0105:

    # highlander2 "{size=+5}Успокойся!{/size}"
    highlander2 "{size=+5}冷静！{/size}"

# game/a14/3highland.rpy:459
translate english highland_a1318597:

    # me "{size=-2}Брак будет легитимен не для лордов. А для других кланов. Я все еще уверен, что все это представление для их одобрения.{/size}"
    me "{size=-2}这桩婚姻对其他领主来说并非合法。但对其他氏族是。我依然确信这整场戏是为了获得他们的认同。{/size}"

# game/a14/3highland.rpy:460
translate english highland_3d3e19ca:

    # harold "{size=-2}Так просто украдем лорда Войцеха.{/size}"
    harold "{size=-2}那我们干脆把Vojceh大人偷出来。{/size}"

# game/a14/3highland.rpy:461
translate english highland_b6664539:

    # me "{size=-2}Они водят вокруг него хороводы. Просто так не получится.{/size}"
    me "{size=-2}他们围着他团团转。没那么容易。{/size}"

# game/a14/3highland.rpy:462
translate english highland_ef43fa32:

    # harold "{size=-2}И что тогда будем делать?{/size}"
    harold "{size=-2}那到时候我们怎么办？{/size}"

# game/a14/3highland.rpy:463
translate english highland_398c6555:

    # me "{size=-2}Прикончим всех. Ну это если я не найду варианты получше.{/size}"
    me "{size=-2}把他们全干掉。除非我能找到更好的办法。{/size}"

# game/a14/3highland.rpy:464
translate english highland_b56e3e0f:

    # harold "{size=-2}А если мы на них нападем, другие кланы не вступятся?{/size}"
    harold "{size=-2}如果我们攻击他们，其他氏族会不会介入？{/size}"

# game/a14/3highland.rpy:465
translate english highland_0d83dfba:

    # me "{size=-2}Может и вступятся. Но у нас вариантов не много. Так мы хотя бы спасем Войцеха и разобьем один из кланов до того, как он вернется в Высокую Страну с пленником.{/size}"
    me "{size=-2}可能会。但我们的选择不多。至少这样我们能救出Vojceh，并在他们带着俘虏返回高地之国前，消灭其中一个氏族。{/size}"

# game/a14/3highland.rpy:466
translate english highland_f167c4e7:

    # harold "{size=-2}Мы просто будем в более сильной позиции.{/size}"
    harold "{size=-2}我们将处于更有利的地位。{/size}"

# game/a14/3highland.rpy:467
translate english highland_d4a3ebf4:

    # me "{size=-2}Да. Но и к этому нужно подготовиться. Пусть оставшиеся силы распределятся вокруг. Тогда наш отряд ударит из центра, а остальные сомкнут кольцо.{/size}"
    me "{size=-2}是的。但也需要为此做好准备。让其余兵力在周围分散部署。我们的队伍到时候从中央突击，其他人收紧包围圈。{/size}"

# game/a14/3highland.rpy:468
translate english highland_e88d5150:

    # me "{size=-2}Где их лагерь и основные силы мы теперь знаем. Передай все это Скаладану вместе с гонцом.{/size}"
    me "{size=-2}现在我们知道了他们的营地和主力在哪里。把这些情报都通过信使一并传给Scaladan。{/size}"

# game/a14/3highland.rpy:469
translate english highland_2b13f454:

    # harold "{size=-2}Да, мой принц. Думаю к утру уже получим ответ.{/size}"
    harold "{size=-2}是的，我的王子。我想明天早上之前就能收到回复。{/size}"

# game/a14/3highland.rpy:470
translate english highland_10a2477f:

    # me "{size=-2}Я пойду освежусь.{/size}"
    me "{size=-2}我去洗把脸。{/size}"

# game/a14/3highland.rpy:471
translate english highland_cab7fe3c:

    # harold "{size=-2}Я с вами.{/size}"
    harold "{size=-2}我和您一起。{/size}"

# game/a14/3highland.rpy:472
translate english highland_29c5cfdc:

    # me "{size=-2}Не нужно. Я только умою лицо и вернусь.{/size}"
    me "{size=-2}不必了。我只是洗个脸就回来。{/size}"

# game/a14/3highland.rpy:474
translate english highland_fc7d3a18:

    # "Пару минут спустя."
    "几分钟后。"

# game/a14/3highland.rpy:475
translate english highland_85e7ef53:

    # me "{i}А может...{/i}"
    me "{i}或许……{/i}"

# game/a14/3highland.rpy:476
translate english highland_87897399:

    # me "{i}Нет. Это какая-то чушь.{/i}"
    me "{i}不。这太荒谬了。{/i}"

# game/a14/3highland.rpy:477
translate english highland_887d404e:

    # me "{i}Нет ни единой причины, зачем бы это было нужно лорду Скаладану.{/i}"
    me "{i}完全没有理由，Scaladan大人为什么要这么做。{/i}"

# game/a14/3highland.rpy:478
translate english highland_d145fdca:

    # me "{i}Если бы он договорился с горцами за спиной, чтобы получить землю Войцеха - об этом бы узнали в тот момент, когда бы земля стала его.{/i}"
    me "{i}如果他和山地人在背后达成了协议，想要夺取Vojceh大人的土地，那在他得到土地的那一刻，事情就会败露。{/i}"

# game/a14/3highland.rpy:480
translate english highland_b3d1d29d:

    # me "{i}Да и к тому же, если бы не я, то клерик не аннулировал бы брак.{/i}"
    me "{i}而且，要不是我，神职人员也不会废除那个婚约。{/i}"

# game/a14/3highland.rpy:481
translate english highland_05566720:

    # me "{i}Письмо он написал неделю назад, может и позже. Скорее всего в тот же день, как мы вернулись из церкви.{/i}"
    me "{i}他大约一周前写的信，也许更晚一些。很可能就是我们离开教堂的那天。{/i}"

# game/a14/3highland.rpy:482
translate english highland_7a5ead27:

    # me "{i}Если бы только я мог прочитать это письмо, я бы сразу понял, это злой умысел Скаладана или глупость Войцеха.{/i}"
    me "{i}要是我能读到那封信就好了，我就能立刻明白，到底是斯卡拉丹的恶毒算计，还是Vojceh的愚蠢。{/i}"

# game/a14/3highland.rpy:483
translate english highland_6c590b64:

    # me "{i}Но если это первое - то зачем?{/i}"
    me "{i}但如果是前者，又是为了什么呢？{/i}"

# game/a14/3highland.rpy:484
translate english highland_9c79a230:

    # me "{i}Если бы он хотел его подставить, то сделал бы это раньше.{/i}"
    me "{i}他要是想坑害他，早就这么做了。{/i}"

# game/a14/3highland.rpy:486
translate english highland_da77af93:

    # me "{i}Он явно импровизировал.{/i}"
    me "{i}他显然是临时起意。{/i}"

# game/a14/3highland.rpy:487
translate english highland_ec3f23ee:

    # me "{i}А может он не хотел мира?{/i}"
    me "{i}又或者他压根不想要和平？{/i}"

# game/a14/3highland.rpy:488
translate english highland_a6d3560d:

    # me "{i}Но какая ему выгода от войны? Погибнут его люди.{/i}"
    me "{i}但战争对他有什么好处？他的人会死。{/i}"

# game/a14/3highland.rpy:489
translate english highland_6fc8fe7c:

    # me "{i}А если бы он хотел что-то скрыть, то не отпустил бы жену, а меня точно не отправил с документом вперед.{/i}"
    me "{i}如果他真想隐瞒什么，就不会放他妻子走，也肯定不会派我带着文件走在前面。{/i}"

# game/a14/3highland.rpy:490
translate english highland_2e8d603b:

    # me "{i}Ладно. Нужно дождаться его ответа.{/i}"
    me "{i}算了。得等他的回复。{/i}"

# game/a14/3highland.rpy:491
translate english highland_451d4b24:

    # me "{i}Кто там крадется?{/i}"
    me "{i}是谁在那儿鬼鬼祟祟的？{/i}"

# game/a14/3highland.rpy:493
translate english highland_86cb511c:

    # me "Я тебя слышу."
    me "我能听见你。"

# game/a14/3highland.rpy:494
translate english highland_1ed13ede:

    # me "И вижу."
    me "还能看见你。"

# game/a14/3highland.rpy:495
translate english highland_b74e2a64:

    # amina "Не видишь. Ты в мою сторону даже не смотришь."
    amina "你看不见。你甚至都没往我这边看。"

# game/a14/3highland.rpy:496
translate english highland_a91ca33c:

    # me "Положи мой меч или останешься без руки."
    me "放下我的剑，否则你的手就没了。"

# game/a14/3highland.rpy:498
translate english highland_c82876de:

    # amina "Чем же ты ее у меня отнимешь, если у тебя не будет меча?"
    amina "你连剑都没有，怎么砍我的手？"

# game/a14/3highland.rpy:499
translate english highland_ea7aac68:

    # me "Сначала заберу у тебя, а потом отрублю руку."
    me "先抢下你的，再砍你的手。"

# game/a14/3highland.rpy:500
translate english highland_edc2a492:

    # amina "Не успеешь."
    amina "你来不及的。"

# game/a14/3highland.rpy:501
translate english highland_54259c11:

    # me "Не успею? Это еще почему?"
    me "来不及？为什么？"

# game/a14/3highland.rpy:502
translate english highland_378707af:

    # amina "Я убегу быстрее."
    amina "我跑得更快。"

# game/a14/3highland.rpy:503
translate english highland_f756701c:

    # me "Не убежишь. С двумя тяжелыми мечами вряд ли."
    me "你跑不掉的。带着两把沉重的剑恐怕不行。"

# game/a14/3highland.rpy:504
translate english highland_b9d6d5ec:

    # amina "Я может буду с мечами, зато я все тут знаю - шмыгну за дерево и камень и ты меня сразу потеряешь из виду."
    amina "也许我会带着剑，但我熟悉这儿——往树后或石头后面一闪，你就立刻看不见我了。"

# game/a14/3highland.rpy:505
translate english highland_fd4f2a8b:

    # me "Твой отец знает, что ты воровка?"
    me "你的爸爸知道你是贼吗？"

# game/a14/3highland.rpy:506
translate english highland_7ed522cd:

    # amina "Я не воровка. Я до твоего меча даже не коснулась."
    amina "我不是贼。我碰都没碰你的剑。"

# game/a14/3highland.rpy:507
translate english highland_48832e70:

    # me "Но хотела."
    me "但你本来想碰。"

# game/a14/3highland.rpy:508
translate english highland_dddd405f:

    # amina "Я просто хотела проверить твою внимательность. Только и всего."
    amina "我只是想测试你的警觉性。仅此而已。"

# game/a14/3highland.rpy:510
translate english highland_7a170c59:

    # me "Ну да. А меч, что у тебя в руке?"
    me "哦，是吗。那你手上的剑呢？"

# game/a14/3highland.rpy:511
translate english highland_dc9ae359:

    # amina "Это мой."
    amina "这是我的。"

# game/a14/3highland.rpy:512
translate english highland_f002da59:

    # me "Не лги."
    me "别撒谎。"

# game/a14/3highland.rpy:513
translate english highland_2572f200:

    # amina "Я не лгу."
    amina "我没撒谎。"

# game/a14/3highland.rpy:514
translate english highland_2e1fc648:

    # me "Он для тебя большеват."
    me "这剑对你来说太大了。"

# game/a14/3highland.rpy:515
translate english highland_b50f0c61:

    # amina "В самый раз."
    amina "刚刚好。"

# game/a14/3highland.rpy:516
translate english highland_684072ec:

    # me "Это не твой меч."
    me "那不是你的剑。"

# game/a14/3highland.rpy:517
translate english highland_323f1b92:

    # amina "Откуда тебе знать, это мой меч или нет?"
    amina "你怎么知道这是我的剑，还是不是我的？"

# game/a14/3highland.rpy:518
translate english highland_f59bda6e:

    # me "Никто не станет тупить свой меч о камни, еще и окунать его в реку."
    me "没人会把自己的剑往石头上磕钝，还把它浸在河里。"

# game/a14/3highland.rpy:519
translate english highland_6649c9e9:

    # amina "..."
    amina "……"

# game/a14/3highland.rpy:520
translate english highland_3bc0aa52:

    # me "Что? Я прав? У кого ты его взяла? Или вернее так - у кого ты его украла? Потому что добровольно бы тебе никто меч не отдал."
    me "怎么？我说对了？你从谁那儿拿的？或者该这样问——你从谁那儿偷的？因为没人会自愿给你一把剑。"

# game/a14/3highland.rpy:521
translate english highland_f02d58c9:

    # amina "Это мой меч."
    amina "这是我的剑。"

# game/a14/3highland.rpy:522
translate english highland_0a269503:

    # me "Стащила у кого-то пьяного? Хотя нет. Он был у тебя и до того, как все начали пить. Наверное это меч лорда Войцеха."
    me "从哪个醉鬼那儿偷的？不，等等。在大家开始喝酒前，你就拿着它了。这大概是Vojceh大人的剑。"

# game/a14/3highland.rpy:523
translate english highland_6649c9e9_1:

    # amina "..."
    amina "……"

# game/a14/3highland.rpy:524
translate english highland_4dad23ab:

    # me "Ну да. Точно. Его разоружили, а ты прихватила, что плохо лежало."
    me "没错。肯定是的。他被缴了械，你就顺手拿走了没放好的东西。"

# game/a14/3highland.rpy:526
translate english highland_e5909bc1:

    # amina "Бери."
    amina "拿着。"

# game/a14/3highland.rpy:527
translate english highland_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a14/3highland.rpy:528
translate english highland_6adf6959:

    # amina "Бери свой меч. Доставай его."
    amina "拿你的剑。拔出来。"

# game/a14/3highland.rpy:529
translate english highland_7332342b:

    # me "Зачем?"
    me "为什么？"

# game/a14/3highland.rpy:530
translate english highland_d966ccd2:

    # amina "А я тебе докажу!"
    amina "我要向你证明！"

# game/a14/3highland.rpy:531
translate english highland_e01a4af2:

    # me "Что докажешь?"
    me "证明什么？"

# game/a14/3highland.rpy:532
translate english highland_c75d1d5e:

    # amina "Что это мой меч. Когда я тебе наваляю, ты сразу поймешь, что ошибался."
    amina "证明这是我的剑。等我揍扁你的时候，你就会明白自己错了。"

# game/a14/3highland.rpy:533
translate english highland_684072ec_1:

    # me "Это не твой меч."
    me "这不是你的剑。"

# game/a14/3highland.rpy:535
translate english highland_ea4683af:

    # amina "Что? Боишься?"
    amina "怎么？你怕了？"

# game/a14/3highland.rpy:536
translate english highland_23ed23df:

    # me "Я? Боюсь?"
    me "我？怕？"

# game/a14/3highland.rpy:537
translate english highland_c53c4d52:

    # amina "Да. Ты трус. Боишься что тебя победит девчонка?"
    amina "对。你是个懦夫。怕被一个小姑娘打败？"

# game/a14/3highland.rpy:538
translate english highland_885c3da7:

    # me "Ты его едва в руке держишь."
    me "你拿着它都费劲。"

# game/a14/3highland.rpy:539
translate english highland_f9e7f41e:

    # amina "Трус."
    amina "懦夫。"

# game/a14/3highland.rpy:540
translate english highland_284d5926:

    # me "Ты предлагаешь мне убить ребенка, чтобы доказать ему же, что он лжет?"
    me "你是在建议我杀死一个孩子，来向她证明她在撒谎吗？"

# game/a14/3highland.rpy:541
translate english highland_ca381926:

    # amina "Я не ребенок. Если бы Алия была замужем, я бы сейчас женилась на лорде Войцехе."
    amina "我不是孩子。要是Alia嫁人了，我现在就已经嫁给沃伊切赫大人了。"

# game/a14/3highland.rpy:542
translate english highland_84aa403c:

    # me "А... так ты дочь вождя."
    me "啊……你是族长的女儿。"

# game/a14/3highland.rpy:543
translate english highland_230f2061:

    # amina "Она самая."
    amina "正是在下。"

# game/a14/3highland.rpy:544
translate english highland_371bd131:

    # me "Ну тогда мне точно нельзя тебя убивать или калечить."
    me "那我就更不能杀你，或是弄伤你了。"

# game/a14/3highland.rpy:545
translate english highland_f9e7f41e_1:

    # amina "Трус."
    amina "懦夫。"

# game/a14/3highland.rpy:546
translate english highland_5f031b18:

    # me "Ага..."
    me "嗯……"

# game/a14/3highland.rpy:547
translate english highland_dfc45f3f:

    # amina "До первой крови."
    amina "打到见血为止。"

# game/a14/3highland.rpy:548
translate english highland_3820771a_7:

    # me "..."
    me "……"

# game/a14/3highland.rpy:549
translate english highland_0be6b0b4:

    # amina "Трус? Боишься?"
    amina "懦夫？害怕了？"

# game/a14/3highland.rpy:550
translate english highland_5f9abfe2:

    # me "Уверена?"
    me "你确定？"

# game/a14/3highland.rpy:551
translate english highland_ffa56e47:

    # amina "Уверена."
    amina "确定。"

# game/a14/3highland.rpy:553
translate english highland_3a71e683:

    # me "Еще не поздно передумать."
    me "现在反悔还来得及。"

# game/a14/3highland.rpy:554
translate english highland_9e9174c3:

    # amina "Кому? Тебе? Так и быть, если упадешь на колени и будешь умолять о милосердии - я сжалюсь."
    amina "谁？你吗？行啊，如果你跪下来求饶，我倒可以发发慈悲。"

# game/a14/3highland.rpy:555
translate english highland_3820771a_8:

    # me "..."
    me "……"

# game/a14/3highland.rpy:556
translate english highland_b753eb8c:

    # amina "Доставай меч."
    amina "拔剑吧。"

# game/a14/3highland.rpy:557
translate english highland_840e69b2:

    # me "Пока не буду."
    me "暂时不。"

# game/a14/3highland.rpy:558
translate english highland_fdc739f9:

    # amina "Как же ты будешь сражаться?"
    amina "那你怎么打？"

# game/a14/3highland.rpy:559
translate english highland_4ae63c60:

    # me "До первой крови."
    me "打到见血为止。"

# game/a14/3highland.rpy:560
translate english highland_1c72a139:

    # amina "И как ты ее собираешься пролить мечом в ножнах?"
    amina "你拿着收在鞘里的剑，怎么让人见血？"

# game/a14/3highland.rpy:561
translate english highland_44db1c23:

    # me "Что-нибудь придумаю. Боюсь если я достану меч, через секунду ты будешь лежать, захлебываясь кровью."
    me "总会有办法的。我怕要是我拔出来，不出几秒你就会躺在那里，被自己的血呛死。"

# game/a14/3highland.rpy:562
translate english highland_ecde5238:

    # amina "Как хочешь. Я тебя жалеть не собираюсь."
    amina "随你便。我可不打算手下留情。"

# game/a14/3highland.rpy:563
translate english highland_8613242c_1:

    # me "Угу."
    me "嗯哼。"

# game/a14/3highland.rpy:564
translate english highland_ed8ceca4:

    # amina "Начинаем?"
    amina "开始？"

# game/a14/3highland.rpy:565
translate english highland_cd917d11:

    # me "Давай."
    me "来吧。"

# game/a14/3highland.rpy:567
translate english highland_510eb06d:

    # amina "Сейчас ты ощутишь на себе ярость гор!"
    amina "现在，你就感受一下大山的怒火吧！"

# game/a14/3highland.rpy:568
translate english highland_3820771a_9:

    # me "..."
    me "……"

# game/a14/3highland.rpy:569
translate english highland_04acfb55:

    # amina "Только не убегай в страхе!"
    amina "别吓得逃跑！"

# game/a14/3highland.rpy:570
translate english highland_3820771a_10:

    # me "..."
    me "……"

# game/a14/3highland.rpy:571
translate english highland_ca7da13a:

    # amina "Приготовься умереть!"
    amina "准备受死！"

# game/a14/3highland.rpy:574
translate english highland_3820771a_11:

    # me "..."
    me "……"

# game/a14/3highland.rpy:575
translate english highland_95f2b749:

    # amina "Ты чего?"
    amina "你怎么了？"

# game/a14/3highland.rpy:576
translate english highland_356100b3:

    # me "Ну? Я готов."
    me "嗯？我准备好了。"

# game/a14/3highland.rpy:577
translate english highland_32ac9650:

    # amina "Что?"
    amina "什么？"

# game/a14/3highland.rpy:578
translate english highland_13559a20:

    # me "К смерти. Ты сказала приготовиться умереть - я готов. Давай. Бей."
    me "准备好受死。你让我准备受死，我准备好了。来吧。动手。"

# game/a14/3highland.rpy:579
translate english highland_fbbce7c3:

    # amina "Нет... что? Ты должен биться!"
    amina "不……什么？你应该和我对打！"

# game/a14/3highland.rpy:580
translate english highland_b3148cb5:

    # me "Я бьюсь. Просто очень жажду смерти. Так что бей первая."
    me "我是在打啊。就是特别想死。所以你先动手吧。"

# game/a14/3highland.rpy:581
translate english highland_f48cb80f:

    # amina "Как это?"
    amina "这算什么？"

# game/a14/3highland.rpy:582
translate english highland_9a573cd5:

    # me "Вот так. Бей."
    me "就这样。动手。"

# game/a14/3highland.rpy:583
translate english highland_6efc167f:

    # amina "Эм..."
    amina "嗯……"

# game/a14/3highland.rpy:584
translate english highland_00129556:

    # me "Ладно, тогда я."
    me "行吧，那我来了。"

# game/a14/3highland.rpy:587
translate english highland_a9dd4f73:

    # amina "{size=+5}АЙ!{/size}"
    amina "{size=+5}哎哟！{/size}"

# game/a14/3highland.rpy:590
translate english highland_146d1672:

    # amina "Ой! Что это?"
    amina "哦！什么东西？"

# game/a14/3highland.rpy:593
translate english highland_a9dd4f73_1:

    # amina "{size=+5}АЙ!{/size}"
    amina "{size=+5}哎哟！{/size}"

# game/a14/3highland.rpy:597
translate english highland_2f8548f5:

    # amina "{size=+5}Агрх!{/size}"
    amina "{size=+5}呃啊！{/size}"

# game/a14/3highland.rpy:600
translate english highland_e7b41a23:

    # me "Я победил."
    me "我赢了。"

# game/a14/3highland.rpy:601
translate english highland_32ac9650_1:

    # amina "Что?"
    amina "什么？"

# game/a14/3highland.rpy:602
translate english highland_41e994b7:

    # me "Мы договорились до первой крови - она у тебя под носом. Так что я выиграл."
    me "我们说好打到见血——你鼻子下面正在流血。所以我赢了。"

# game/a14/3highland.rpy:603
translate english highland_8a7075cd:

    # amina "Ну это..."
    amina "这个……"

# game/a14/3highland.rpy:604
translate english highland_ad02f53a:

    # me "Что?"
    me "怎么？"

# game/a14/3highland.rpy:605
translate english highland_fa71fcbc:

    # amina "Это нечестно!"
    amina "这不公平！"

# game/a14/3highland.rpy:606
translate english highland_3642f725:

    # me "Почему это?"
    me "怎么不公平了？"

# game/a14/3highland.rpy:608
translate english highland_499408f4:

    # amina "Ты меня ослепил чем-то!"
    amina "你用什么玩意儿晃花了我的眼！"

# game/a14/3highland.rpy:610
translate english highland_6649698b:

    # amina "Ты отошел в сторону!"
    amina "你自己往旁边退了！"

# game/a14/3highland.rpy:612
translate english highland_37482f4e:

    # amina "Ты меня обманул!"
    amina "你骗人！"

# game/a14/3highland.rpy:613
translate english highland_2325fa76:

    # me "И что?"
    me "那又怎样？"

# game/a14/3highland.rpy:614
translate english highland_c8dcdf70:

    # amina "Это нечестно... Ты сжульничал, ты должен был биться со мной мечом."
    amina "这不公平……你耍赖，你本该跟我用剑打的。"

# game/a14/3highland.rpy:615
translate english highland_f504d98e:

    # me "Об этом мы не договаривались. Мы договаривались биться до первой крови. Ты проиграла."
    me "我们可没商量用不用剑。我们说好了打到见血为止。你输了。"

# game/a14/3highland.rpy:616
translate english highland_e1510469:

    # amina "Но... Как же... я..."
    amina "可是……怎么会……我……"

# game/a14/3highland.rpy:617
translate english highland_6c55d66e:

    # me "Да-да. Мир полон разочарований. Я тоже когда-то думал, что биться с мечом очень просто. До тех пор пока Акер не окунул меня головой в грязь раз двадцать подряд."
    me "是啊是啊。世界充满了失望。我也曾经以为用剑打斗很简单。直到Aker把我的头按在泥地里，足足按了二十来次。"

# game/a14/3highland.rpy:619
translate english highland_6e559866:

    # krastan "Она меня тоже бесит, но прости, я не могу тебе ее позволить убить. К сожалению это моя сестра."
    krastan "她也让我很恼火，但是抱歉，我不能让你杀了她。她毕竟是我妹妹，这真遗憾。"

# game/a14/3highland.rpy:620
translate english highland_6cd67fe4:

    # me "Она на меня первая напала."
    me "是她先攻击我的。"

# game/a14/3highland.rpy:621
translate english highland_a6fdb9e9:

    # krastan "В это я как раз охотно верю."
    krastan "这个我倒非常乐意相信。"

# game/a14/3highland.rpy:622
translate english highland_1a7b48cd:

    # amina "А он сжульничал!"
    amina "可他耍赖了！"

# game/a14/3highland.rpy:623
translate english highland_c0ad0a40:

    # krastan "В это я тоже верю."
    krastan "这个我也非常相信。"

# game/a14/3highland.rpy:624
translate english highland_c9e92556:

    # me "Я не жульничал. Я просто не хотел ее убивать."
    me "我没耍赖。我只是不想杀她。"

# game/a14/3highland.rpy:625
translate english highland_965087f2:

    # krastan "Знакомое чувство. Мне тоже часто приходится изворачиваться, чтобы ее не убить."
    krastan "这种感觉我很熟悉。为了不杀她，我也得常常绞尽脑汁。"

# game/a14/3highland.rpy:626
translate english highland_32a5f139:

    # me "Она украла меч."
    me "她偷了剑。"

# game/a14/3highland.rpy:627
translate english highland_f6d679b3:

    # amina "Я его не крала!"
    amina "我才没偷！"

# game/a14/3highland.rpy:628
translate english highland_28d3aa3a:

    # krastan "Я его ей дал."
    krastan "那剑是我给她的。"

# game/a14/3highland.rpy:629
translate english highland_27f6f961:

    # me "Ну так верни."
    me "那就还回去。"

# game/a14/3highland.rpy:630
translate english highland_d383fbb8:

    # krastan "Ну это... знаешь... Войцех такой буйный, когда напьется. Было бы опасно давать ему меч."
    krastan "嗯这个嘛……你知道……Vojceh喝醉时实在太闹了。给他剑太危险。"

# game/a14/3highland.rpy:631
translate english highland_d4e257f9:

    # me "Я твой вернул."
    me "我把你的还了。"

# game/a14/3highland.rpy:632
translate english highland_5f739aa4_2:

    # krastan "..."
    krastan "……"

# game/a14/3highland.rpy:633
translate english highland_f71c90f1_1:

    # me "Ну?"
    me "怎么样？"

# game/a14/3highland.rpy:634
translate english highland_2e21df33:

    # krastan "Ладно, я его ему верну."
    krastan "好吧，我会还给他的。"

# game/a14/3highland.rpy:636
translate english highland_83b2bdd5:

    # amina "{size=+5}ДО ПЕРВОЙ КРОВИ, ДА?{/size}"
    amina "{size=+5}打到见血，是吗？{/size}"

# game/a14/3highland.rpy:637
translate english highland_468380b7:

    # me "Ты чего творишь?"
    me "你干什么？"

# game/a14/3highland.rpy:638
translate english highland_984050ff:

    # krastan "Видимо хочет ничью."
    krastan "看来她想要平局。"

# game/a14/3highland.rpy:639
translate english highland_0c4139b4:

    # amina "Я тебе сейчас горло вскрою!"
    amina "我现在就割开你的喉咙！"

# game/a14/3highland.rpy:640
translate english highland_71c71ba8:

    # me "Слезь с меня."
    me "从我身上下去。"

# game/a14/3highland.rpy:641
translate english highland_e5157adb:

    # krastan "Амина, если ты убьешь нашего гостя, отец выпустит тебе кишки."
    krastan "Amina，你要是杀了我们的客人，父亲会把你的肠子都掏出来。"

# game/a14/3highland.rpy:642
translate english highland_aa34a741:

    # amina "Да мне насрать! Он меня обманул!"
    amina "我他妈才不在乎！他耍了我！"

# game/a14/3highland.rpy:643
translate english highland_f08749d1:

    # me "Я тебя не обманывал."
    me "我没耍你。"

# game/a14/3highland.rpy:644
translate english highland_f03d6a9d:

    # amina "И из-за него я теперь буду без меча!"
    amina "就因为他，我就要没剑了！"

# game/a14/3highland.rpy:645
translate english highland_5b34688c:

    # me "Это не твой меч!"
    me "那不是你的剑！"

# game/a14/3highland.rpy:646
translate english highland_ec188033:

    # amina "А если я тебе нож в горло воткну, он чей будет? Твой или мой? М?"
    amina "那要是我现在把这把匕首插进你喉咙里，它算谁的？你的还是我的？嗯？"

# game/a14/3highland.rpy:647
translate english highland_fd6175af:

    # me "Ну тай бей!"
    me "那你就扎啊！"

# game/a14/3highland.rpy:649
translate english highland_32ac9650_2:

    # amina "Что?"
    amina "什么？"

# game/a14/3highland.rpy:650
translate english highland_433df7f5:

    # me "БЕЙ ДАВАЙ! Или я сейчас упаду на спину и разобью тебе голову об камни."
    me "扎啊，快点！不然我就仰面倒下去，把你的脑袋在石头上撞开花。"

# game/a14/3highland.rpy:651
translate english highland_7a1d5952:

    # krastan "Эх... младшие сестры... у тебя есть младшая сестра, [mename]?"
    krastan "唉……妹妹们……你有妹妹吗，[mename]？"

# game/a14/3highland.rpy:652
translate english highland_a319795d:

    # me "Есть. Но она меня убить не пыталась."
    me "有。但她从没想杀我。"

# game/a14/3highland.rpy:653
translate english highland_9b5979cb:

    # krastan "Ну тогда у вас не очень крепкие отношения."
    krastan "哦，那看来你们关系不太铁啊。"

# game/a14/3highland.rpy:654
translate english highland_2901dc79:

    # amina "Не вертись, придурок, или я действительно тебя порежу!"
    amina "别乱动，白痴，不然我真的会划伤你！"

# game/a14/3highland.rpy:655
translate english highland_8ad6854a:

    # krastan "Шрам на лице у меня как раз от нее."
    krastan "我脸上这道疤就是她留下的。"

# game/a14/3highland.rpy:656
translate english highland_c3581bdd:

    # me "Может вместо того, чтобы предаваться приятным воспоминаниям, ты уже скажешь ей слезть с меня."
    me "比起沉浸在愉快的回忆里，你能不能先让她从我身上下去。"

# game/a14/3highland.rpy:657
translate english highland_d6bea666:

    # krastan "Да расслабься ты. Она только притворяется дикой. На самом деле зашуганный котенок."
    krastan "哎呀，放松点。她只是装得野性，其实是个受惊的小猫。"

# game/a14/3highland.rpy:658
translate english highland_459029f0:

    # amina "Я его прикончу!"
    amina "我宰了他！"

# game/a14/3highland.rpy:659
translate english highland_8591a96a:

    # me "Ты не помогаешь!"
    me "你这可帮不上忙！"

# game/a14/3highland.rpy:660
translate english highland_e03c4d22:

    # krastan "У нее духу не хватит."
    krastan "她没那个胆。"

# game/a14/3highland.rpy:661
translate english highland_ef88d825:

    # amina "У меня? У меня не хватит? Я его убью сейчас!"
    amina "我？我没那个胆？我现在就杀了他！"

# game/a14/3highland.rpy:662
translate english highland_2a8f287d:

    # me "Ты только хуже делаешь."
    me "你只会越帮越忙。"

# game/a14/3highland.rpy:663
translate english highland_e47aaa41:

    # krastan "Ну так убей или слезь с него уже. Или я тебя сам убью."
    krastan "行了，要么杀了他，要么快下去。不然我自己动手杀了你。"

# game/a14/3highland.rpy:664
