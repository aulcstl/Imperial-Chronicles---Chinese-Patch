# TODO: Translation updated at 2026-05-28 21:50

# game/a14/3highland.rpy:3
translate english highland_24b271ca:

    # "Неделю спустя."
    "一周后。"

# game/a14/3highland.rpy:4
translate english highland_17eb1196:

    # teos "Фух... начинает холодать."
    teos "呼……开始变冷了。"

# game/a14/3highland.rpy:5
translate english highland_8474cd5e:

    # me "Ага. Зима отчаянно приближается..."
    me "是啊。冬天正在无情地逼近……"

# game/a14/3highland.rpy:6
translate english highland_4fe373ea:

    # teos "Не волнуйтесь. Снег еще не скоро."
    teos "别担心。雪还不会这么快下。"

# game/a14/3highland.rpy:7
translate english highland_7077d58f:

    # me "С чего ты взял?"
    me "你怎么知道？"

# game/a14/3highland.rpy:8
translate english highland_45c10605:

    # teos "Трава слишком зеленая. Начнет жухнуть и чернеть - тогда и снег пойдет."
    teos "草还太绿了。等到开始枯萎发黑，那时才会下雪。"

# game/a14/3highland.rpy:9
translate english highland_3820771a:

    # me "..."
    me "……"

# game/a14/3highland.rpy:10
translate english highland_a4a2f01e:

    # teos "К тому же первый снег это еще не полноценная зима. Он может выпасть и сразу же растаять."
    teos "而且初雪还不算真正的冬天。它可能下了就马上融化。"

# game/a14/3highland.rpy:11
translate english highland_06f53b35:

    # me "Меня больше беспокоят северные морозы."
    me "我更担心的是北方的严寒。"

# game/a14/3highland.rpy:13
translate english highland_df33ce6a:

    # teos "Ну мы же не планируем оставаться тут слишком долго."
    teos "我们又没打算在这里待太久。"

# game/a14/3highland.rpy:14
translate english highland_81ca6ba0:

    # me "Здесь - нет. Но нам еще нужно вернуться. Я слышал порт в Хельвике замерзает."
    me "这里是不打算。但我们还需要回去。我听说赫尔维克的港口会结冰。"

# game/a14/3highland.rpy:15
translate english highland_80e2c18e:

    # teos "Ну это на пару месяцев, не больше. К тому же на западе есть Селедкин Порт у Черной Косы. Он не всегда замерзает."
    teos "那也就几个月的事，不会更长。而且西边黑镰那边的塞莱德金港不总会结冰。"

# game/a14/3highland.rpy:16
translate english highland_a8f0435c:

    # me "Нет. Если я начну метаться по зимнему Северу, как полоумный, а потом еще и поплыву через Запад, то точно потрачу времени больше, чем нужно."
    me "不行。要是我像疯子一样在冬天的北方乱跑，然后再穿越西部航行，那肯定会浪费更多不必要的时间。"

# game/a14/3highland.rpy:17
translate english highland_1a70c5f4:

    # me "Проще будет дождаться, когда лёд отступит."
    me "不如等冰退了更简单。"

# game/a14/3highland.rpy:18
translate english highland_35f8c679:

    # teos "Око бури стихло. Может в этот раз холода не наступят дольше или хотя бы долго не продлятся."
    teos "风暴之眼平息了。也许这次寒冷不会那么快来，或者至少不会持续太久。"

# game/a14/3highland.rpy:19
translate english highland_27ab4225:

    # me "С чего это вдруг? Если морские течения ослабли, то лёд простоит дольше."
    me "怎么会突然这么想？如果洋流减弱了，冰层只会持续更久。"

# game/a14/3highland.rpy:20
translate english highland_d45c0886:

    # teos "Правда?"
    teos "真的？"

# game/a14/3highland.rpy:21
translate english highland_8613242c:

    # me "Угу."
    me "嗯。"

# game/a14/3highland.rpy:22
translate english highland_5ca905f1:

    # teos "А как ваш визит в церковь Безымянного бога?"
    teos "那你们去无名之神教堂的拜访怎么样？"

# game/a14/3highland.rpy:23
translate english highland_11199ad4:

    # me "Нормально. Правда пришлось слушать проповедь о конце света."
    me "还行。不过被迫听了一场关于世界末日的布道。"

# game/a14/3highland.rpy:24
translate english highland_adcc6cad:

    # teos "Ух..."
    teos "呃……"

# game/a14/3highland.rpy:25
translate english highland_3a395912:

    # me "Вообще было не так плохо."
    me "其实也没那么糟。"

# game/a14/3highland.rpy:26
translate english highland_6a71421f:

    # teos "Ну их идея со странствующими пророками хорошая, так они всегда на короткой ноге с прихожанами... стойте. СТОЙТЕ!"
    teos "嗯，他们关于行游先知的想法倒是不错，这样他们总能和信徒保持密切联系……等等。站住！"

# game/a14/3highland.rpy:28
translate english highland_6273d965:

    # highlander "Добро пожаловать в наши новые земли."
    highlander "欢迎来到我们的新领地。"

# game/a14/3highland.rpy:29
translate english highland_7152bf74:

    # teos "Будьте наготове. Это может быть засада."
    teos "准备好。这可能是个埋伏。"

# game/a14/3highland.rpy:30
translate english highland_ec6f8557:

    # me "Это земли лорда Скаладана."
    me "这是Scaladan大人的领地。"

# game/a14/3highland.rpy:31
translate english highland_d7d8c2f0:

    # highlander "Правда? Я думал это уже наши."
    highlander "是吗？我以为这已经是我们的了。"

# game/a14/3highland.rpy:32
translate english highland_03b9ba4a:

    # teos "Монтак, скачи назад, скажи чтобы поторопились."
    teos "Montak，骑马回去，叫他们加快速度。"

# game/a14/3highland.rpy:33
translate english highland_b703798e:

    # me "Я везу документ, который подтверждает, что это не так."
    me "我正带着一份文件，证明事实并非如此。"

# game/a14/3highland.rpy:34
translate english highland_9f264e06:

    # highlander "Нда? И что за документ?"
    highlander "哦？什么文件？"

# game/a14/3highland.rpy:35
translate english highland_80ae3974:

    # me "Может представишься?"
    me "也许你先自我介绍一下？"

# game/a14/3highland.rpy:36
translate english highland_4bc44406:

    # krastan "Меня зовут Крастан. А тебя как?"
    krastan "我叫Krastan。你呢？"

# game/a14/3highland.rpy:37
translate english highland_bfbf8bc6:

    # me "Я принц [mename]. Наследник Рагвеллиона, Императора Золотой Империи."
    me "我是[mename]王子。拉格维利昂的继承人，黄金帝国的皇帝。"

# game/a14/3highland.rpy:38
translate english highland_196bb02c:

    # krastan "Ты как-то далековато от своей Империи забрался, принц."
    krastan "你离你的帝国可够远的，王子。"

# game/a14/3highland.rpy:39
translate english highland_3820771a_1:

    # me "..."
    me "……"

# game/a14/3highland.rpy:40
translate english highland_6e33f135:

    # krastan "Ааа... у тебя тоже хороший аппетит на землю, да? Возможно даже больше нашего. Нам весь Север не нужен."
    krastan "啊……你对土地的胃口也不小嘛，是吧？说不定比我们还大。我们可不需要整个北方。"

# game/a14/3highland.rpy:41
translate english highland_6b093d9c:

    # teos "Я разберусь."
    teos "我来处理。"

# game/a14/3highland.rpy:43
translate english highland_6f7a93eb:

    # teos "Слезай."
    teos "下马。"

# game/a14/3highland.rpy:44
translate english highland_7ee1bc2f:

    # krastan "Не хочу."
    krastan "不想下。"

# game/a14/3highland.rpy:45
translate english highland_c9d25f42:

    # teos "Слезай, говорю."
    teos "我说，下马。"

# game/a14/3highland.rpy:46
translate english highland_8941a972:

    # krastan "Ты на меня сразу нападешь."
    krastan "你会立刻攻击我。"

# game/a14/3highland.rpy:47
translate english highland_822ebb45:

    # teos "Тогда отдай меч."
    teos "那把剑交出来。"

# game/a14/3highland.rpy:48
translate english highland_9ed48cb9:

    # krastan "...ладно."
    krastan "……好吧。"

# game/a14/3highland.rpy:50
translate english highland_0557b0b1:

    # krastan "И зачем это?"
    krastan "这是为了什么？"

# game/a14/3highland.rpy:51
translate english highland_96b62a2e:

    # teos "Для нашей общей безопасности."
    teos "为了我们共同的安全。"

# game/a14/3highland.rpy:52
translate english highland_5997a93d:

    # krastan "Зачем это для вашей безопасности я понимаю, а я по-моему в опасность попадаю."
    krastan "为了你们的安全我倒是理解，但我觉得我反而陷入危险了。"

# game/a14/3highland.rpy:53
translate english highland_a37f9c22:

    # teos "Закрой рот и давай меч."
    teos "闭嘴，把剑拿来。"

# game/a14/3highland.rpy:54
translate english highland_75fd5abb:

    # krastan "Ну бери-бери."
    krastan "喏，拿去吧拿去吧。"

# game/a14/3highland.rpy:56
translate english highland_45248b29:

    # teos "Блядь!"
    teos "妈的！"

# game/a14/3highland.rpy:57
translate english highland_759a1658:

    # krastan "Ты слишком медлишь, приятель."
    krastan "你太磨蹭了，伙计。"

# game/a14/3highland.rpy:59
translate english highland_696020df:

    # teos "СУКИН СЫН!"
    teos "狗娘养的！"

# game/a14/3highland.rpy:60
translate english highland_52585d06:

    # krastan "Это очень грубо!"
    krastan "这话可真粗鲁！"

# game/a14/3highland.rpy:61
translate english highland_578916ea:

    # me "К оружию."
    me "准备拔剑！"

# game/a14/3highland.rpy:63
translate english highland_03e88f48:

    # krastan "Тише тише тише. Вы же не хотите, чтобы я перерезал вашему другу горло?"
    krastan "别动别动别动。你们总不想我割开你们朋友的喉咙吧？"

# game/a14/3highland.rpy:64
translate english highland_2e6b833f:

    # teos "Пидарас!"
    teos "混蛋！"

# game/a14/3highland.rpy:65
translate english highland_2b753229:

    # me "Ты собираешься перерезать ему горло мечом? Это будет трудно провернуть за те секунды, что мы до тебя доберемся."
    me "你打算用剑割开他喉咙？在我们冲到你面前的那几秒里，这可不容易办到。"

# game/a14/3highland.rpy:66
translate english highland_566fe4bd:

    # krastan "Хочешь проверить?"
    krastan "想试试看？"

# game/a14/3highland.rpy:67
translate english highland_153a9559:

    # me "...ну и что тебе надо?"
    me "……那么，你想怎么样？"

# game/a14/3highland.rpy:68
translate english highland_7f5258aa:

    # krastan "Мне? Ничего. Я так. Проверяю уровень вашей компетенции. Нам ведь, вероятно, придется сражаться. Оцениваю уровень подготовки противников к бою."
    krastan "我？没什么。我就是这样。试试你们的能力水平。我们毕竟可能要交战。评估一下对手的战斗准备程度。"

# game/a14/3highland.rpy:69
translate english highland_10528b92:

    # me "Мы едем не сражаться. У нас есть документ, который позволит избежать бессмысленной драки."
    me "我们不是来打仗的。我们有一份文件，可以避免无谓的争斗。"

# game/a14/3highland.rpy:70
translate english highland_09bf163e:

    # krastan "А ежели нам будет плевать на этот документ?"
    krastan "那如果我们对这份文件毫不在乎呢？"

# game/a14/3highland.rpy:71
translate english highland_f677f64e:

    # me "Тогда сюда прибудет еще две с половиной тысячи воинов."
    me "那么，随后会有两千五百名战士抵达这里。"

# game/a14/3highland.rpy:72
translate english highland_fc8818ef:

    # krastan "А если за нас выступят все кланы?"
    krastan "那如果所有氏族都站出来支持我们呢？"

# game/a14/3highland.rpy:73
translate english highland_8d32e517:

    # me "Не выступят. Пока у вас нет легитимной причины тут быть, они за вас не вступятся."
    me "他们不会的。只要你们没有合法的理由待在这里，他们就不会为你们出头。"

# game/a14/3highland.rpy:74
translate english highland_4025a865:

    # krastan "А если есть?"
    krastan "那如果有呢？"

# game/a14/3highland.rpy:76
translate english highland_cd6e98a1:

    # me "Уже нет."
    me "现在已经没有了。"

# game/a14/3highland.rpy:77
translate english highland_5a8ef5dd:

    # krastan "А если они и без всякой причины нас поддержат?"
    krastan "那如果他们不问缘由就支持我们呢？"

# game/a14/3highland.rpy:78
translate english highland_8ff9fd67:

    # me "Тогда вас явится резать и вешать весь Север. Но я думаю лидеры остальных кланов не настолько глупы, чтобы поддержать нарушителей договоров."
    me "那么整个北方都会来砍杀和绞死你们。但我想其他氏族的领袖还没蠢到去支持破坏协议的人。"

# game/a14/3highland.rpy:79
translate english highland_aae946ee:

    # krastan "А кто сказал, что это мы первые нарушили договор? М?"
    krastan "谁说我们是先破坏协议的一方？嗯？"

# game/a14/3highland.rpy:80
translate english highland_dfd3abcc:

    # me "Это уже не имеет значения."
    me "这已经不重要了。"

# game/a14/3highland.rpy:81
translate english highland_19bf355f:

    # krastan "Даже интересно, что там за документ ты везешь."
    krastan "我倒好奇你带着什么文件。"

# game/a14/3highland.rpy:82
translate english highland_ae1ee5b1:

    # me "А ты вождь клана?"
    me "你是氏族领袖吗？"

# game/a14/3highland.rpy:83
translate english highland_93095a42:

    # krastan "Нет. Но я почти вождь."
    krastan "不是。但也差不多是领袖了。"

# game/a14/3highland.rpy:84
translate english highland_1b32cfea:

    # me "Как это?"
    me "什么意思？"

# game/a14/3highland.rpy:85
translate english highland_913f3391:

    # krastan "Я его сын. Так что за документ?"
    krastan "我是他的儿子。所以，什么文件？"

# game/a14/3highland.rpy:86
translate english highland_be105388:

    # me "Я покажу его только вождю клана."
    me "我只会给氏族领袖看。"

# game/a14/3highland.rpy:87
translate english highland_dd8c9058:

    # krastan "А если..."
    krastan "那如果……"

# game/a14/3highland.rpy:88
translate english highland_164fb974:

    # me "Слушай. Я не буду с тобой говорить, пока ты держишь сталь у горла моего человека."
    me "听着。只要你还把刀架在我手下的喉咙上，我就不会跟你谈。"

# game/a14/3highland.rpy:89
translate english highland_23e6e1d8:

    # krastan "А я думаю ты именно поэтому со мной и говоришь."
    krastan "我倒觉得，你正是因此才跟我谈的。"

# game/a14/3highland.rpy:91
translate english highland_8c960e9d:

    # me "Отпусти его?"
    me "放开他？"

# game/a14/3highland.rpy:92
translate english highland_9d926d3d:

    # krastan "Или что?"
    krastan "否则？"

# game/a14/3highland.rpy:93
translate english highland_461d64f5:

    # me "Или умрешь."
    me "否则你就死。"

# game/a14/3highland.rpy:94
translate english highland_538dd5c3:

    # krastan "Ты убьешь сына вождя клана?"
    krastan "你要杀氏族领袖的儿子？"

# game/a14/3highland.rpy:95
translate english highland_9bff52a1:

    # me "А у меня есть причина. Вы, кажется, уважаете принцип кровь за кровь, верно?"
    me "我有理由。你们似乎很看重血债血偿的原则，对吧？"

# game/a14/3highland.rpy:96
translate english highland_5f739aa4:

    # krastan "..."
    krastan "……"

# game/a14/3highland.rpy:97
translate english highland_d987d981:

    # me "Я покажу тело своего человека и твое. И скажу что ты умер, за свою глупую самонадеянность. Нас здесь сотня человек. Сзади еще четыре. Ты собираешься всех нас победить в одиночку?"
    me "我会展示我手下和你的尸体。然后说你死于自己愚蠢的自大。我们这里有一百人。后面还有四百人。你打算一个人打败我们所有人？"

# game/a14/3highland.rpy:98
translate english highland_5f739aa4_1:

    # krastan "..."
    krastan "……"

# game/a14/3highland.rpy:99
translate english highland_f71c90f1:

    # me "Ну?"
    me "怎么样？"

# game/a14/3highland.rpy:100
translate english highland_7c7027b8:

    # krastan "Думаю, вы правы, мой принц."
    krastan "我想，您是对的，我的王子。"

# game/a14/3highland.rpy:102
translate english highland_4a2cdfc1:

    # krastan "Я сдаюсь!"
    krastan "我投降！"

# game/a14/3highland.rpy:103
translate english highland_e64e7de0:

    # teos "Вот сука! Я его сейчас..."
    teos "这王八蛋！我现在就……"

# game/a14/3highland.rpy:104
translate english highland_d950c634:

    # me "Стой. Подбери меч и вернись к нам."
    me "等等。把剑捡起来，回到我们这边来。"

# game/a14/3highland.rpy:105
translate english highland_f79893f8:

    # teos "Но..."
    teos "可是……"

# game/a14/3highland.rpy:106
translate english highland_58310b44:

    # me "Это приказ."
    me "这是命令。"

# game/a14/3highland.rpy:107
translate english highland_d62547bc:

    # krastan "Давай-давай, шагай."
    krastan "快走快走，迈步。"

# game/a14/3highland.rpy:109
translate english highland_e2a19e25:

    # me "Не трогать его. Пока что."
    me "别碰他。暂时。"

# game/a14/3highland.rpy:110
translate english highland_388c4234:

    # krastan "Пока что?"
    krastan "暂时？"

# game/a14/3highland.rpy:111
translate english highland_4b750597:

    # me "Ты проведешь нас к твоему клану?"
    me "你会带我们去你的氏族那里吗？"

# game/a14/3highland.rpy:112
translate english highland_cd8a9698:

    # krastan "Запросто."
    krastan "没问题。"

# game/a14/3highland.rpy:113
translate english highland_fd24baaa:

    # me "И без фокусов. Если кто-то из нас пострадает - вы все будете висеть вдоль этой дороги."
    me "别耍花样。如果我们有谁受伤，你们全部都会被吊死在这条路边。"

# game/a14/3highland.rpy:114
translate english highland_0fca67f5:

    # krastan "Как скажешь, ужасный и опасный красный принц."
    krastan "随您怎么吩咐，可怕又危险的红衣王子。"

# game/a14/3highland.rpy:115
translate english highland_3da98a98:

    # me "Вы расположились у ущелья?"
    me "你们驻扎在峡谷那边？"

# game/a14/3highland.rpy:116
translate english highland_facf5ed3:

    # krastan "Почти. Чуть ниже у реки. Вы не найдете. Тут много окольных троп."
    krastan "差不多。往河下游走一点。你们找不到的。这里绕路的小道很多。"

# game/a14/3highland.rpy:117
translate english highland_dbcf2d80:

    # me "Ладно. Покажешь. Свяжите его."
    me "好吧。你带路。把他绑起来。"

# game/a14/3highland.rpy:118
translate english highland_e678bd10:

    # krastan "А вот это вовсе не обязательно."
    krastan "这个完全没必要。"

# game/a14/3highland.rpy:119
translate english highland_ad2e682b:

    # me "И заберите меч."
    me "把他的剑也拿走。"

# game/a14/3highland.rpy:120
translate english highland_49ebc5db:

    # krastan "Может можем договориться на других условиях?"
    krastan "也许我们可以谈点别的条件？"

# game/a14/3highland.rpy:121
translate english highland_48ba67f6:

    # me "Я бы договорился на других условиях, если бы ты не попытался убить моего человека."
    me "如果你没有试图杀我的人，我倒愿意谈别的条件。"

# game/a14/3highland.rpy:123
translate english highland_d17e42a1:

    # "Пять минут спустя."
    "五分钟后。"

# game/a14/3highland.rpy:124
translate english highland_b8704391:

    # krastan "Знаешь это бессмысленная трата веревки. Я бы не сбежал без своего меча."
    krastan "知道吗，这纯粹是浪费绳子。没了自己的剑我也不会跑。"

# game/a14/3highland.rpy:125
translate english highland_e27649b9:

    # me "Иди давай."
    me "走吧。"

# game/a14/3highland.rpy:126
translate english highland_e0329a2d:

    # krastan "Может хоть лошадь мне дадите? Дело пойдет быстрее."
    krastan "也许你们至少可以给我匹马？这样会快些。"

# game/a14/3highland.rpy:127
translate english highland_ec7a0af6:

    # me "Может тебе еще и отсосать?"
    me "也许你还想让我们给你口交？"

# game/a14/3highland.rpy:128
translate english highland_3feb4d43:

    # krastan "Я не против, вот этот парень, которого я пленил. Пусть он отсосет. Мне кажется у него очень нежный рот."
    krastan "我不介意，就那个被我俘虏的家伙。让他来。我觉得他的嘴一定很嫩。"

# game/a14/3highland.rpy:129
translate english highland_cd7a46e3:

    # me "Закрой рот и веди."
    me "闭嘴，带路。"

# game/a14/3highland.rpy:130
translate english highland_44b2fecd:

    # krastan "Лошадь можно привязать к другой лошади."
    krastan "马可以拴在另一匹马上。"

# game/a14/3highland.rpy:131
translate english highland_4591c379:

    # me "Тебе никто не говорил, что после того как начинаешь знакомство с обмана, тебе больше доверять не будут?"
    me "没人告诉过你，一旦以欺骗开始认识他人，之后别人就不会再信任你了吗？"

# game/a14/3highland.rpy:132
translate english highland_38f04301:

    # krastan "А кого я обманул?"
    krastan "我骗谁了？"

# game/a14/3highland.rpy:133
translate english highland_c118d749:

    # me "Ты сказал, что сдаешься и не сдался."
    me "你说你投降了，但并没有。"

# game/a14/3highland.rpy:134
translate english highland_07594b7c:

    # krastan "Но по итогу то у меня руки связаны."
    krastan "可结果我的手还是被绑起来了。"

# game/a14/3highland.rpy:136
translate english highland_cc50ce4d:

    # me "Если не заткнешься, то будет еще и кляп во рту."
    me "再不闭嘴，就再给你塞上嘴巴。"

# game/a14/3highland.rpy:137
translate english highland_b5420f41:

    # krastan "Ты какой-то грубый. Я ведь могу нажаловаться папочке и он не примет твой документ."
    krastan "你这人真粗鲁。我可以向老爹告状，他可能就不接受你的文件了。"

# game/a14/3highland.rpy:138
translate english highland_f9603b13:

    # me "Сомневаюсь."
    me "我怀疑。"

# game/a14/3highland.rpy:139
translate english highland_14e20d62:

    # krastan "Так что за документ?"
    krastan "所以到底是什么文件？"

# game/a14/3highland.rpy:140
translate english highland_3820771a_2:

    # me "..."
    me "……"

# game/a14/3highland.rpy:141
translate english highland_f07a482a:

    # krastan "Да ладно тебе. Я ведь все равно узнаю."
    krastan "哎呀，你就说吧。反正我迟早也会知道。"

# game/a14/3highland.rpy:142
translate english highland_9a5aec41:

    # me "Я не уверен, что ты не соврал. Может ты и не сын вождя клана."
    me "我不确定你有没有撒谎。也许你根本就不是氏族领袖的儿子。"

# game/a14/3highland.rpy:143
translate english highland_d95041f3:

    # krastan "Но хоть в то, что я горец, ты веришь?"
    krastan "但你至少相信我确实是山地人，对吧？"

# game/a14/3highland.rpy:144
translate english highland_9f2781f3:

    # me "Верю."
    me "相信。"

# game/a14/3highland.rpy:145
translate english highland_68c8bcb6:

    # krastan "И что, по-твоему, отец... вождь клана не расскажет остальным почему мы должны уйти?"
    krastan "那你觉得，爸爸……氏族领袖难道不会告诉其他人我们为什么要离开吗？"

# game/a14/3highland.rpy:146
translate english highland_3820771a_3:

    # me "..."
    me "……"

# game/a14/3highland.rpy:147
translate english highland_4fbb8dc2:

    # krastan "Ну же. Расскажи."
    krastan "哎呀。告诉我吧。"

# game/a14/3highland.rpy:149
translate english highland_39ab4adb:

    # krastan "А хотя не надо. Вот мы и пришли."
    krastan "啊，算了，不用了。我们到了。"

# game/a14/3highland.rpy:150
translate english highland_0eeb89a4:

    # me "Уже? Мы бы и сами сюда дошли, проводник хренов."
    me "到了？我们自己也能走到这儿，你这向导真不怎么样。"

# game/a14/3highland.rpy:151
translate english highland_267f229f:

    # krastan "Без меня бы не дошли."
    krastan "没我你们走不到。"

# game/a14/3highland.rpy:152
translate english highland_e046f496:

    # me "Да ну? И почему же?"
    me "是吗？为什么？"

# game/a14/3highland.rpy:153
translate english highland_6ba935d4:

    # krastan "Я гарант безопасности. Проверяю ваши намерения."
    krastan "我是安全保障。正在查验你们的意图。"

# game/a14/3highland.rpy:154
translate english highland_20ed8724:

    # me "То есть ты мог убить и себя и подставить свой клан. Что же за кретин послал именно тебя?"
    me "也就是说，你可能把自己都杀了，还连累你的氏族。是哪个白痴偏偏派你来的？"

# game/a14/3highland.rpy:155
translate english highland_5dc63bf6:

    # krastan "Мой отец. Как раз сейчас познакомитесь."
    krastan "我的爸爸。正好，你们现在就能认识下。"

# game/a14/3highland.rpy:156
translate english highland_5fa4f207:

    # me "Как его зовут."
    me "他叫什么？"

# game/a14/3highland.rpy:157
translate english highland_137524a6:

    # krastan "Он представится."
    krastan "他会自我介绍的。"

# game/a14/3highland.rpy:159
translate english highland_22e9a14a:

    # makhal "Приветствую, меня зовут Макхал. Я вождь клана Железных Поясов."
    makhal "向您致敬，我叫Makhal。铁腰带氏族的族长。"

# game/a14/3highland.rpy:160
translate english highland_2e5ba47b:

    # krastan "А это красный..."
    krastan "这是红衣的……"

# game/a14/3highland.rpy:161
translate english highland_2ed96480:

    # me "Я сам представлюсь. Меня зовут [mename]. Я принц Золотой Империи."
    me "我会自我介绍。我叫[mename]。黄金帝国的王子。"

# game/a14/3highland.rpy:162
translate english highland_033dfbb4:

    # makhal "Прежде чем мы перейдем к взаимным вопросам, я бы хотел узнать, почему мой сын связан?"
    makhal "在我们开始互相提问之前，我想知道，为什么我的儿子被绑起来了？"

# game/a14/3highland.rpy:163
translate english highland_9287102c:

    # me "Он напал на нашего человека."
    me "他袭击了我们的人。"

# game/a14/3highland.rpy:164
translate english highland_58623276:

    # makhal "Правда?"
    makhal "是吗？"

# game/a14/3highland.rpy:165
translate english highland_733ddcab:

    # krastan "Никто не пострадал!"
    krastan "没人受伤！"

# game/a14/3highland.rpy:166
translate english highland_33f3363d:

    # me "Никто не пострадал только потому что мы его окружили."
    me "没人受伤只是因为我们把他围住了。"

# game/a14/3highland.rpy:167
translate english highland_be09729c:

    # makhal "Понятно..."
    makhal "明白了……"

# game/a14/3highland.rpy:168
translate english highland_eee80f7d:

    # krastan "Все было немного не так."
    krastan "事情有点不太一样。"

# game/a14/3highland.rpy:169
translate english highland_43008790:

    # me "Мы прибыли с документом."
    me "我们是带着文件来的。"

# game/a14/3highland.rpy:170
translate english highland_d06714fc:

    # makhal "Давайте не здесь. У нас лагерь в старой крепости у реки. Совсем рядом. Пойдемте."
    makhal "别在这儿说。我们在河边旧堡垒那有营地，很近。我们走吧。"

# game/a14/3highland.rpy:172
translate english highland_b7edd1d3:

    # me "Почему не здесь?"
    me "为什么不在这里？"

# game/a14/3highland.rpy:173
translate english highland_6e678d48:

    # makhal "Что бы вы ни показали, мне нужно будет показать это моему клану."
    makhal "无论你们要展示什么，我都需要展示给我的氏族看。"

# game/a14/3highland.rpy:174
translate english highland_06543abb:

    # me "Они не поверят вам на слово?"
    me "他们不会相信你们的口头承诺吗？"

# game/a14/3highland.rpy:175
translate english highland_4bb5bc87:

    # makhal "А вы часто верите на слово незнакомцам?"
    makhal "您经常相信陌生人的口头承诺吗？"

# game/a14/3highland.rpy:176
translate english highland_bca79273:

    # me "Пару раз приходилось."
    me "有过一两次。"

# game/a14/3highland.rpy:177
translate english highland_f3970bb8:

    # makhal "Тогда вы либо знаете, либо скоро узнаете, что на слово верить незнакомцам нельзя."
    makhal "那您要么知道，要么很快就会明白，陌生人的话是不能信的。"

# game/a14/3highland.rpy:178
translate english highland_9ebffac9:

    # me "Я думал давать слово вы умеете."
    me "我以为你们是信守承诺的。"

# game/a14/3highland.rpy:179
translate english highland_dda80acd:

    # makhal "Я вас не знаю. А вы не знаете меня. Мое слово для вас ничего и ваше для меня - пыль."
    makhal "我不了解你。你也不了解我。我的承诺对你一文不值，你的承诺对我来说也如同尘埃。"

# game/a14/3highland.rpy:180
translate english highland_3820771a_4:

    # me "..."
    me "……"

# game/a14/3highland.rpy:181
translate english highland_603040ac:

    # makhal "Ну так что?"
    makhal "那么，怎么样？"

# game/a14/3highland.rpy:182
translate english highland_01822020:

    # me "Ладно."
    me "好吧。"

# game/a14/3highland.rpy:183
translate english highland_32acd3fb:

    # makhal "Не беспокойтесь. Я гарантирую вам безопасность, вы будете нашим гостем."
    makhal "别担心。我保证你们的安全，你们将是我们的客人。"

# game/a14/3highland.rpy:184
translate english highland_4f209318:

    # me "Это слово незнакомца."
    me "这是陌生人的承诺。"

# game/a14/3highland.rpy:185
translate english highland_a5444ad5:

    # makhal "Верно. Вы быстро учитесь. Именно потому, что вы меня пока не знаете, я не требую отдать ваше оружие или разделяться."
    makhal "没错。你学得很快。正因为你现在还不了解我，我才不要求你交出武器，或者把我们分开。"

# game/a14/3highland.rpy:186
translate english highland_4dbbd69b:

    # me "Нас пять сотен человек."
    me "我们有五百人。"

# game/a14/3highland.rpy:187
translate english highland_536fcbff:

    # makhal "Хоть тысячу. Места полно."
    makhal "一千人也没问题。地方有的是。"

# game/a14/3highland.rpy:188
translate english highland_389a7596:

    # krastan "Кхм-хкм..."
    krastan "咳咳……"

# game/a14/3highland.rpy:189
translate english highland_4da797c5:

    # makhal "Могу я развязать вашего пленника?"
    makhal "我可以解开你们的俘虏吗？"

# game/a14/3highland.rpy:190
translate english highland_db01d7c1:

    # me "Да. Иди."
    me "解开吧。去吧。"

# game/a14/3highland.rpy:192
translate english highland_fd6054f0:

    # krastan "Спасибо, отец."
    krastan "谢谢你，爸爸。"

# game/a14/3highland.rpy:193
translate english highland_7cd06923:

    # makhal "Закрой рот. Я что сказал тебе сделать? Встретить их, а не атаковать."
    makhal "闭嘴。我叫你去做什么？去迎接他们，不是去攻击。"

# game/a14/3highland.rpy:194
translate english highland_3a8b66aa:

    # krastan "Я просто проверил их на крепкость духа."
    krastan "我只是测试一下他们的精神坚强不坚强。"

# game/a14/3highland.rpy:195
translate english highland_4cab03ef:

    # makhal "Не будь ты мой сын, я бы отрезал тебе ухо, может ты бы стал слышать получше."
    makhal "你要不是我的儿子，我早就割掉你一只耳朵，也许你就能听进去话了。"

# game/a14/3highland.rpy:196
translate english highland_b910ef34:

    # krastan "Да можешь резать, там уже и отрезать то нечего."
    krastan "你割呗，反正那上面也没剩啥可割的了。"

# game/a14/3highland.rpy:197
translate english highland_b58e8a5c:

    # makhal "Еще раз меня ослушаешься и назначу преемником твоего брата, понял?"
    makhal "你再违抗我一次，我就让你的哥哥当继承人，明白了吗？"

# game/a14/3highland.rpy:198
translate english highland_159e3e5e:

    # krastan "Понял-понял."
    krastan "明白了，明白了。"

# game/a14/3highland.rpy:199
translate english highland_6107fa6d:

    # makhal "..."
    makhal "……"

# game/a14/3highland.rpy:200
translate english highland_293b1f5d:

    # krastan "Чуть аккуратнее. Не порежь мне руки, отец."
    krastan "小心点，爸爸，别割到我的手。"

# game/a14/3highland.rpy:201
translate english highland_dc5d7caf:

    # makhal "Тебе это только на пользу будет."
    makhal "这对你只有好处。"

# game/a14/3highland.rpy:202
translate english highland_24b9f727:

    # makhal "Идите за нами. Тут недалеко. Надо просто перейти реку. Будете гостями. Я гарантирую вам безопасность."
    makhal "跟我来，不远了。只要过河就到。你们是我们的客人。我保证你们的安全。"

# game/a14/3highland.rpy:203
translate english highland_e43ca92d:

    # me "{size=-4}Будьте начеку.{/size}"
    me "{size=-4}保持警惕。{/size}"

# game/a14/3highland.rpy:205
translate english highland_cbfb29ff:

    # krastan "Это вовсе не обязательно. Мой отец держит слово. "
    krastan "这完全没必要。我的爸爸言出必行。"

# game/a14/3highland.rpy:206
translate english highland_81efbc46:

    # me "Слова незнакомца."
    me "陌生人的承诺。"

# game/a14/3highland.rpy:207
translate english highland_c0d2ccf3:

    # krastan "Его вы не знаете, но меня то уже - да."
    krastan "你们不了解他，但已经了解我了吧。"

# game/a14/3highland.rpy:208
translate english highland_a9ab9502:

    # me "У нас было не самое приятное знакомство."
    me "我们的认识过程可不太愉快。"

# game/a14/3highland.rpy:209
translate english highland_88aab73e:

    # krastan "Но мы можем начать все сначала."
    krastan "但我们可以重新开始。"

# game/a14/3highland.rpy:210
translate english highland_3820771a_5:

    # me "..."
    me "……"

# game/a14/3highland.rpy:211
translate english highland_668ed860:

    # krastan "Да ладно тебе, красный принц, мы сможем стать друзьями. Посидишь на свадьбе. Угощу тебя снежным горцем."
    krastan "哎呀别这样，红衣王子，我们可以成为朋友。来参加婚礼。我请你喝雪地山民酒。"

# game/a14/3highland.rpy:212
translate english highland_fdf9e277:

    # me "Какой еще свадьбе."
    me "什么婚礼？"

# game/a14/3highland.rpy:213
translate english highland_8e303b24:

    # krastan "Ой."
    krastan "哦。"

# game/a14/3highland.rpy:214
translate english highland_901a087b:

    # makhal "Крастан, захлопни пасть и иди сюда."
    makhal "Krastan，闭上你的臭嘴，过来。"

# game/a14/3highland.rpy:215
translate english highland_02647ce0:

    # krastan "Упс. Отец зол. Встретимся попозже."
    krastan "糟糕。父亲生气了。我们晚点见。"

# game/a14/3highland.rpy:217
translate english highland_72c275f6:

    # teos "Думаете ловушка?"
    teos "你觉得是陷阱吗？"

# game/a14/3highland.rpy:218
translate english highland_e75d9230:

    # me "Не похоже."
    me "不像。"

# game/a14/3highland.rpy:219
translate english highland_87ca0d07:

    # teos "Прошу прощения, что позволил себя обезоружить."
    teos "请原谅我让自己被缴了械。"

# game/a14/3highland.rpy:220
translate english highland_2d42945b:

    # me "Aha."
    me "嗯哼。"

# game/a14/3highland.rpy:221
translate english highland_c145199c:

    # teos "Я вернусь в обоз."
    teos "我回辎重队去。"

# game/a14/3highland.rpy:222
translate english highland_c8792540:

    # me "Это необязательно."
    me "没这个必要。"

# game/a14/3highland.rpy:223
translate english highland_357f19ae:

    # teos "Обязательно. Вы должны быть защищены, мой принц."
    teos "有必要。您必须得到保护，我的王子。"

# game/a14/3highland.rpy:224
translate english highland_d16250e6:

    # me "Ну ты теперь знаешь, чего от горцев ждать, так что пригодишься мне рядом."
    me "现在你已经了解了山地人会耍什么手段，所以待在我身边会有用。"

# game/a14/3highland.rpy:225
translate english highland_98881dfa:

    # teos "Спасибо, мой принц. Я больше вас не подведу."
    teos "谢谢，我的王子。我不会再让您失望了。"

# game/a14/3highland.rpy:227
translate english highland_7f32b9ce:

    # "Двадцать минут спустя."
    "二十分钟后。"

# game/a14/3highland.rpy:228
translate english highland_a411350a:

    # highlandin "Идут!"
    highlandin "他们来了！"

# game/a14/3highland.rpy:229
translate english highland_816280de:

    # highlander "Кто там?"
    highlander "谁来了？"

# game/a14/3highland.rpy:230
translate english highland_fb048bc1:

    # highlandin "Отец и Крастан. А за ними вереница всадников."
    highlandin "父亲和Krastan。他们身后还有一队骑马的人。"

# game/a14/3highland.rpy:231
translate english highland_82179c9c:

    # highlander "Сколько?"
    highlander "多少人？"

# game/a14/3highland.rpy:232
translate english highland_ae4e47ee:

    # highlandin "Тысяча!"
    highlandin "一千人！"

# game/a14/3highland.rpy:233
translate english highland_f0265277:

    # highlander "Чего?"
    highlander "什么？"

# game/a14/3highland.rpy:234
translate english highland_9535b763:

    # highlandin "Может десять!"
    highlandin "也许十个！"

# game/a14/3highland.rpy:235
translate english highland_c67e682c:

    # highlander "Что ты несешь!"
    highlander "你在胡说什么！"

# game/a14/3highland.rpy:236
translate english highland_de45b20f:

    # highlandin "Они до горизонта растянулись."
    highlandin "他们队伍排到天边了。"

# game/a14/3highland.rpy:237
translate english highland_2ef9f2c4:

    # highlander "Это погоня?"
    highlander "是追兵吗？"

# game/a14/3highland.rpy:238
translate english highland_de0e76e9:

    # highlandin "Нет. Просто идут!"
    highlandin "不是，就是跟着来的！"

# game/a14/3highland.rpy:239
translate english highland_d2904f7a:

    # highlander "Отправь людей, Вога."
    highlander "沃加，派人去安排。"

# game/a14/3highland.rpy:241
translate english highland_f2a2f044:

    # highlander "Макхал? Это... это с вами?"
    highlander "Makhal？这……这些是和您一起的吗？"

# game/a14/3highland.rpy:242
translate english highland_96708cbd:

    # makhal "Да. Это наши гости. Разместите, всех кто захочет внутри, а остальным принесите еды."
    makhal "是的，这是我们的客人。想进里面的人就安排一下，其余的人送上食物。"

# game/a14/3highland.rpy:243
translate english highland_7eb0e23f:

    # highlander "Да их сотни три!"
    highlander "他们可有三百人呢！"

# game/a14/3highland.rpy:244
translate english highland_c85615a3:

    # makhal "И что? Мы забили пару оленей недавно."
    makhal "那又怎样？我们最近打了几头鹿。"

# game/a14/3highland.rpy:245
translate english highland_c87add38:

    # highlander "Кто это?"
    highlander "他们是谁？"

# game/a14/3highland.rpy:246
translate english highland_ab7f0bb0:

    # makhal "Люди Скаладана."
    makhal "Scaladan的人。"

# game/a14/3highland.rpy:247
translate english highland_1855eefa:

    # highlander "И мы их пустим? С оружием?"
    highlander "我们就这么让他们进来？还带着武器？"

# game/a14/3highland.rpy:248
translate english highland_e47312bf:

    # makhal "Не всех. Сюда только пропустите десятка два."
    makhal "不全让进。只放二十人左右进这里。"

# game/a14/3highland.rpy:249
translate english highland_ced2273d:

    # highlander "Хорошо."
    highlander "好的。"

# game/a14/3highland.rpy:251
translate english highland_ef97a01a:

    # highlander "И что они здесь делают?"
    highlander "他们在这里做什么？"

# game/a14/3highland.rpy:252
translate english highland_b2d38f15:

    # highlander2 "Пришли за землей, разве непонятно?"
    highlander2 "来要土地的，还不明白吗？"

# game/a14/3highland.rpy:253
translate english highland_4fe42a5f:

    # highlander "А чего мы тогда не сражаемся?"
    highlander "那我们为什么不打？"

# game/a14/3highland.rpy:254
translate english highland_6d7a8c57:

    # highlander2 "Сначала болтать будут, разве не понятно?"
    highlander2 "先谈呗，还不明白吗？"

# game/a14/3highland.rpy:255
translate english highland_337d42a4:

    # highlander "А потом?"
    highlander "那然后呢？"

# game/a14/3highland.rpy:256
translate english highland_d3eefe85:

    # highlander2 "А потом посмотрим. Но меч далеко не прячь."
    highlander2 "然后看情况。但剑别收太远。"

# game/a14/3highland.rpy:258
translate english highland_3bd00eae:

    # me "... так что брак больше недействителен."
    me "……因此，那个婚姻已经无效了。"

# game/a14/3highland.rpy:259
translate english highland_e70d345e:

    # krastan "О! Это хорошие новости!"
    krastan "哇！这可是好消息！"

# game/a14/3highland.rpy:260
translate english highland_67c5f2d1:

    # me "Чего?"
    me "什么？"

# game/a14/3highland.rpy:261
translate english highland_da68f78c:

    # makhal "Значит тот парень не врал."
    makhal "看来那家伙没撒谎。"

# game/a14/3highland.rpy:262
translate english highland_26f5f92a:

    # krastan "Спасибо, что позаботился об этом за нас."
    krastan "谢谢你替我们处理好了这事。"

# game/a14/3highland.rpy:263
translate english highland_b3e6c56b:

    # me "Я ничего не пойму."
    me "我有点不明白。"

# game/a14/3highland.rpy:264
translate english highland_c567d282:

    # makhal "Брак разорван по инициативе Скаладана? Он его снова ввести в силу не сможет?"
    makhal "是Scaladan主动解除了婚姻关系吗？他不能再让它重新生效吗？"

# game/a14/3highland.rpy:265
translate english highland_22c1f391:

    # me "Эм... думаю что нет. Без невесты тем более. Да даже если бы она и была, клерик бы их снова не поженил."
    me "呃……我想不能了。尤其没了新娘都不行。哪怕她还在，神职人员也不会再给他们主持婚礼了。"

# game/a14/3highland.rpy:266
translate english highland_a7a907e2:

    # krastan "Отлично!"
    krastan "太棒了！"

# game/a14/3highland.rpy:267
translate english highland_122cde26:

    # me "Отлично? Брака больше не существует. А значит вы обязаны выполнять условия договора."
    me "太棒了？婚姻关系不复存在。这意味着你们必须遵守条约条款。"

# game/a14/3highland.rpy:268
translate english highland_02cb9cdb:

    # makhal "А мы и выполняем."
    makhal "我们是在遵守啊。"

# game/a14/3highland.rpy:269
translate english highland_3990bde4:

    # me "Как это? Вы не можете находиться на земле Скаладана."
    me "怎么遵守？你们不能待在Scaladan的土地上。"

# game/a14/3highland.rpy:270
translate english highland_09c6168f:

    # krastan "А мы и не на земле Скаладана. Забыл что мы перешли реку?"
    krastan "我们现在又不在Scaladan的土地上。忘了我们已经过河了吗？"

# game/a14/3highland.rpy:271
translate english highland_56dd3770:

    # makhal "Это земля лорда Войцеха."
    makhal "这是Vojceh大人的领地了。"

# game/a14/3highland.rpy:272
translate english highland_019f9322:

    # me "Вы не можете быть и на ней."
    me "你们也不能待在他这儿。"

# game/a14/3highland.rpy:273
translate english highland_78c0580a:

    # makhal "А мы гости."
    makhal "我们是客人。"

# game/a14/3highland.rpy:274
translate english highland_699c0cec:

    # me "Гости чего?"
    me "赴什么宴的客人？"

# game/a14/3highland.rpy:275
translate english highland_c1b50786:

    # krastan "Как чего? Свадьбы, конечно!"
    krastan "什么宴？当然是婚礼啦！"

# game/a14/3highland.rpy:276
translate english highland_8973df77:

    # me "Какой еще свадьбы?"
    me "什么婚礼？"

# game/a14/3highland.rpy:277
translate english highland_b1cd3219:

    # krastan "Я ему все покажу, отец."
    krastan "我向他展示一切，爸爸。"

# game/a14/3highland.rpy:279
translate english highland_943cca06:

    # krastan "Лорд Войцех женится на моей сестре, Алии."
    krastan "Vojceh大人要娶我的妹妹，阿莉娅。"

# game/a14/3highland.rpy:280
translate english highland_a5668f84:

    # me "Лорд Войцех? Что он тут делает?"
    me "Vojceh大人？他在这里做什么？"

# game/a14/3highland.rpy:281
translate english highland_25615deb:

    # krastan "Наверное совесть замучила, после того как Скаладан выгнал мою сестру."
    krastan "大概是Scaladan把我的妹妹赶走之后，他良心不安吧。"

# game/a14/3highland.rpy:282
translate english highland_5fd719da:

    # me "Что за..."
    me "什么……"

# game/a14/3highland.rpy:283
translate english highland_3f89b943:

    # krastan "А раз уж ты помог нам и разорвал для нас этот порочащий честь моей сестры союз - будешь самым почетным гостем на новой свадьбе и сядешь рядом с женихом."
    krastan "既然你帮了我们，替我们解除了这桩侮辱我妹妹名誉的婚约，你将是我们新婚礼上最尊贵的客人，就坐在新郎旁边。"

# game/a14/3highland.rpy:284
translate english highland_54f9bd79:

    # krastan "Это благодарность. Искренняя. Раз уже старый брак разорван, новый будет легитимен и по вашим нормам и по нашим. Мы решили в этот раз не доверять клерикам и женить Войцеха по горским обычаям."
    krastan "这是诚挚的谢意。既然旧的婚约已经解除，新的婚姻按照你们的规范和我们的规范都将是合法的。我们决定这次不再信任神职人员，按山地人的习俗来给Vojceh大人办婚礼。"

# game/a14/3highland.rpy:285
translate english highland_fc4cff23:

    # me "Я чего-то не понимаю... вы его пленили?"
    me "我有点搞不懂……你们俘虏了他？"

# game/a14/3highland.rpy:286
translate english highland_9dec0608:

    # krastan "Что? Кто же пленит жениха? Какая глупость. Он сам приехал. Предложил свадьбу моей сестре. Сегодня как раз первый день!"
    krastan "什么？谁会俘虏新郎？真是愚蠢。他是自己来的。向我妹妹求婚。今天正是婚礼的第一天！"

# game/a14/3highland.rpy:287
translate english highland_d0b84b4b:

    # me "Первый день?"
    me "第一天？"

# game/a14/3highland.rpy:288
translate english highland_6949b9f1:

    # krastan "Первый день свадьбы! Присаживайся. Я пока принесу выпить."
    krastan "婚礼第一天！请坐。我去拿点喝的来。"

# game/a14/3highland.rpy:290
translate english highland_b90a1922:

    # krastan "Войцех. Почетный гость прибыл."
    krastan "Vojceh。贵客到了。"

# game/a14/3highland.rpy:291
translate english highland_1eefdb61:

    # me "Лорд Войцех?"
    me "Vojceh大人？"

# game/a14/3highland.rpy:292
translate english highland_f37d33c0:

    # woiceh "Вы кто?"
    woiceh "你们是谁？"

# game/a14/3highland.rpy:293
translate english highland_33da5b6c:

    # krastan "Красный принц!"
    krastan "红衣王子！"

# game/a14/3highland.rpy:294
translate english highland_16cf4675:

    # me "Я принц [mename] из Золотой Империи."
    me "我是黄金帝国的王子，[mename]。"

# game/a14/3highland.rpy:295
translate english highland_add9544f:

    # krastan "Важный. Почетный гость."
    krastan "真是个大人物。贵客啊。"

# game/a14/3highland.rpy:296
translate english highland_8b4cbffb:

    # woiceh "И что вы здесь делаете?"
    woiceh "你在这里做什么？"

# game/a14/3highland.rpy:297
translate english highland_bccd00f5:

    # me "Я хотел это у вас спросить."
    me "这问题我倒想问你。"

# game/a14/3highland.rpy:298
translate english highland_e1272bf2:

    # krastan "Как это, что? Женится на моей сестре!"
    krastan "做什么？当然是娶我妹妹！"

# game/a14/3highland.rpy:299
translate english highland_78e86c10:

    # me "Крастан, не принесешь мне выпить, ты вроде обещал."
    me "Krastan，你不是答应给我拿酒来吗？"

# game/a14/3highland.rpy:300
translate english highland_ac0846dc:

    # krastan "Конечно! Я сейчас."
    krastan "当然！马上来。"

# game/a14/3highland.rpy:301
translate english highland_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a14/3highland.rpy:303
translate english highland_855b1a6b:

    # me "{size=-4}Какого хрена вы здесь забыли?{/size}"
    me "{size=-4}你他妈的怎么在这里？{/size}"

# game/a14/3highland.rpy:304
translate english highland_299852e6:

    # woiceh "Женюсь."
    woiceh "结婚啊。"

# game/a14/3highland.rpy:305
translate english highland_71794967:

    # me "{size=-4}Добровольно?{/size}"
    me "{size=-4}自愿的？{/size}"

# game/a14/3highland.rpy:306
translate english highland_322ee306:

    # woiceh "А разве по мне не видно, что я очень счастлив?"
    woiceh "难道你看不出来我非常幸福吗？"

# game/a14/3highland.rpy:307
translate english highland_39e375dc:

    # me "{size=-4}Вас били?{/size}"
    me "{size=-4}他们打你了？{/size}"

# game/a14/3highland.rpy:308
translate english highland_3fbea7f1:

    # woiceh "Aha. Wedding tradition."
    woiceh "嗯哼。婚礼传统。"

# game/a14/3highland.rpy:309
translate english highland_759e7fb3:

    # me "{size=-4}Вас, что, выкрали?{/size}"
    me "{size=-4}你是被他们绑来的？{/size}"

# game/a14/3highland.rpy:310
translate english highland_87feeee9:

    # woiceh "Я приехал сюда по просьбе лорда Скаладана."
    woiceh "我是应Scaladan大人的要求来这里的。"

# game/a14/3highland.rpy:311
translate english highland_049d407d:

    # me "{size=-4}Чего? Зачем?{/size}"
    me "{size=-4}什么？为什么？{/size}"

# game/a14/3highland.rpy:312
translate english highland_23bf6c93:

    # woiceh "Он написал мне. Попросил помочь с горцами."
    woiceh "他写信给我。请我帮忙处理山地人的事。"

# game/a14/3highland.rpy:313
translate english highland_822bae46:

    # me "{size=-4}Когда?{/size}"
    me "{size=-4}什么时候？{/size}"

# game/a14/3highland.rpy:314
translate english highland_29ce4910:

    # woiceh "Может неделю назад. Может чуть меньше."
    woiceh "大约一周前吧。也许更近一点。"

# game/a14/3highland.rpy:315
translate english highland_776065fe:

    # me "{size=-4}Неделю? Мы как раз тогда разорвали брак! Если бы вы не приехали, горцам просто пришлось бы уйти.{/size}"
    me "{size=-4}一周？我们那时正好解除了婚约！如果你不来，这些山地人本就只能离开了。{/size}"

# game/a14/3highland.rpy:316
translate english highland_3933a094:

    # woiceh "Что вы от меня хотите? Я действовал так, как меня попросил собрат по несчастью. По-вашему я хотел оказаться в этой ситуации?"
    woiceh "你想让我怎么办？我只是按我那位难兄难弟的请求行事。你以为我想陷入这种境地吗？"

# game/a14/3highland.rpy:317
translate english highland_23ff4559:

    # me "{size=-4}Ничего не понимаю. Скаладан с ними заодно? Зачем ему это?{/size}"
    me "{size=-4}我完全不明白。Scaladan和他们是一伙的吗？他为什么要这么做？{/size}"

# game/a14/3highland.rpy:318
translate english highland_84d74704:

    # krastan "А вот и я. Смотрю выпивка уже и не нужна?"
    krastan "我来了。看来酒已经不需要了？"

# game/a14/3highland.rpy:319
translate english highland_c58ab423:

    # me "Ага. Нашел на столе."
    me "嗯。在桌上找到了。"

# game/a14/3highland.rpy:321
translate english highland_930f9c3d:

    # krastan "Ну тогда выпьем за моего нового свояка."
    krastan "那么，为我新的连襟干杯。"

# game/a14/3highland.rpy:322
translate english highland_33a5afc3:

    # woiceh "Не стоит."
    woiceh "不用了吧。"

# game/a14/3highland.rpy:323
translate english highland_19ffa033:

    # krastan "Конечно стоит. Ты настоящий мужчина. Сильный, но сострадательный."
    krastan "当然要的。你是个真正的男人。强大，又有同情心。"

# game/a14/3highland.rpy:324
translate english highland_332d63f8:

    # woiceh "A?"
    woiceh "啊？"

# game/a14/3highland.rpy:325
translate english highland_a410defc:

    # krastan "Взять в жены мою сестру, после того что творил с ней этот ублюдок... это смело."
    krastan "在那个混蛋对我的妹妹做了那些事之后，还敢娶她……这真是勇敢。"

# game/a14/3highland.rpy:326
translate english highland_cc707f5a:

    # woiceh "Угу.."
    woiceh "嗯……"

# game/a14/3highland.rpy:327
translate english highland_9641abf1:

    # krastan "Наш клан этого не забудет. Мы хотим отблагодарить тебя за это! Будешь жить с нами на полном обеспечении, пока не родится первенец!"
    krastan "我们氏族不会忘记这一点。我们要为此感谢你！在孩子出生之前，你会和我们住在一起，我们全额供养！"

# game/a14/3highland.rpy:328
translate english highland_48050cb7:

    # woiceh "Это еще зачем?"
    woiceh "这又是为什么？"

# game/a14/3highland.rpy:329
translate english highland_4864e80c:

    # krastan "Ну как? На нашей родине сами горы помогают делать сильных наследников!"
    krastan "有什么不好呢？在我们家乡，正是这些山脉帮助造就强大的继承人！"

# game/a14/3highland.rpy:330
translate english highland_7daadc7f:

    # woiceh "Чего? Я никуда не поеду..."
    woiceh "什么？我哪儿都不去……"

# game/a14/3highland.rpy:331
translate english highland_104c8c12:

