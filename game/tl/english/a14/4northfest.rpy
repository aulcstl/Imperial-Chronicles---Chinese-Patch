    # amina "Кто там смеялся надо мной из-за лисы? А?"
    amina "刚才是谁因为狐狸笑话我来着？啊？"

# game/a14/4northfest.rpy:676
translate english northfest_896b45fd:

    # amina "Сколько у вас лент? Ноль? А у меня одна! Это на одну больше, чем у вас!"
    amina "你们有几条丝带？零条？我有一条诶！比你们多一条！"

# game/a14/4northfest.rpy:677
translate english northfest_7d05ed24:

    # amina "АХахаххаах. Какие же вы неудачники!"
    amina "啊哈哈哈。瞧瞧你们多没用！"

# game/a14/4northfest.rpy:678
translate english northfest_7a1b9751:

    # amina "Вот ты особенно, братец. Смеялся надо мной? А у меня сейчас тоже лента есть! И мне даже жульничать не пришлось и в холодной реке купаться!"
    amina "尤其是你，小哥哥。你笑话我？现在我也有一条丝带了！我可没作弊，也没在冷水河里泡澡！"

# game/a14/4northfest.rpy:679
translate english northfest_3372ab56:

    # amina "Мемемемеме! Кретины невнимательные! А надо было всего лишь под ноги смотреть!"
    amina "哼！……吓到了吧！没脑子的倒霉蛋！只需要低头看脚下就行了！"

# game/a14/4northfest.rpy:680
translate english northfest_c99732bf:

    # amina "АХАХАХАХ! Я вас победила! БРФЮЮЮ! БРФЮЮЮ!"
    amina "啊哈哈哈！我打败你们了！噜略略！噜略略！"

# game/a14/4northfest.rpy:681
translate english northfest_5a39fdb7:

    # amina "Мой победный клич! БРФЮЮЮ! Жрите дерьмо, дебилы!"
    amina "这是我的胜利战吼！噜略略！吃屎去吧，白痴们！"

# game/a14/4northfest.rpy:682
translate english northfest_dfa9bc97:

    # krastan "А разве отец не запретил тебе участвовать?"
    krastan "等等，爸爸不是不让你参加吗？"

# game/a14/4northfest.rpy:683
translate english northfest_6efc167f:

    # amina "Эм..."
    amina "呃……"

# game/a14/4northfest.rpy:685
translate english northfest_f221b203:

    # highlander1 "И что нам там есть надо?"
    highlander1 "那我们该吃点啥？"

# game/a14/4northfest.rpy:686
translate english northfest_41df9df8:

    # amina "Да я это... хех... не то чтобы я эту ленту нашла."
    amina "呃，这个嘛……嘿嘿……其实也不是我在洞里找到的。"

# game/a14/4northfest.rpy:687
translate english northfest_c9d21c83:

    # highlander1 "Да ну? А кто."
    highlander1 "是吗。那是谁？"

# game/a14/4northfest.rpy:688
translate english northfest_9ced323f:

    # amina "Вот он. [mename]."
    amina "是他。[mename]。"

# game/a14/4northfest.rpy:689
translate english northfest_68d2e63f:

    # highlander2 "А вроде ты ее нашла."
    highlander2 "可刚才明明是你在洞里找到的。"

# game/a14/4northfest.rpy:690
translate english northfest_c1e37135:

    # amina "Нет. Нет. Это я так... пошутила."
    amina "不是。不是。我那时就……开个玩笑。"

# game/a14/4northfest.rpy:691
translate english northfest_a7ad28a3:

    # highlander1 "Пошутила?"
    highlander1 "开个玩笑？"

# game/a14/4northfest.rpy:692
translate english northfest_c7b6e082:

    # amina "Ага. Мне и нельзя было участвовать знаете ли..."
    amina "嗯。你们也知道，我不能参加的……"

# game/a14/4northfest.rpy:693
translate english northfest_33f3fb3a:

    # highlander2 "Да ну..."
    highlander2 "是吗……"

# game/a14/4northfest.rpy:694
translate english northfest_44ebcd3e:

    # amina "Ага. Это [mename] нашел, я у него взяла поносить немного. Вот - возвращаю."
    amina "是啊。是[mename]找到的，我问他借来戴一戴。看——还你。"

# game/a14/4northfest.rpy:695
translate english northfest_d472f94b:

    # highlander1 "Точно не твоя лента?"
    highlander1 "真不是你找到的？"

# game/a14/4northfest.rpy:696
translate english northfest_e28aa128:

    # amina "Точно. Точно."
    amina "真的。真的。"

# game/a14/4northfest.rpy:697
translate english northfest_de1a8639:

    # highlander2 "Может отцу твоему рассказать?"
    highlander2 "要不要我去跟你爸说说？"

# game/a14/4northfest.rpy:698
translate english northfest_5d3d886f:

    # amina "Нет. Не надо. Шутка. Это шутка была."
    amina "别。千万别。开玩笑。刚才是开玩笑。"

# game/a14/4northfest.rpy:699
translate english northfest_69bbc27d:

    # highlander1 "А лицо в чем измазала? В дерьме наверное?"
    highlander1 "那你脸上糊的是啥？该不会是屎吧？"

# game/a14/4northfest.rpy:700
translate english northfest_727803f8:

    # amina "Ну да. Хе-хе."
    amina "嗯，大概是吧。嘿嘿。"

# game/a14/4northfest.rpy:701
translate english northfest_87c40098:

    # highlander2 "Ладно. Пойдемте."
    highlander2 "行吧。咱们走。"

# game/a14/4northfest.rpy:703
translate english northfest_4df671e0:

    # me "Тебе не стоило отдавать мне ленту."
    me "你不该把丝带让给我的。"

# game/a14/4northfest.rpy:704
translate english northfest_cf7b5416:

    # amina "Все нормально."
    amina "没事。"

# game/a14/4northfest.rpy:705
translate english northfest_752b2ba5:

    # me "Ты дочь вождя. Они бы тебе ничего не сделали."
    me "你是族长的女儿。他们不会拿你怎么样。"

# game/a14/4northfest.rpy:706
translate english northfest_55215ddc:

    # amina "Да, забудь."
    amina "算了，别提了。"

# game/a14/4northfest.rpy:707
translate english northfest_38db0efb:

    # me "Я могу вернуть тебе ее."
    me "我可以还给你。"

# game/a14/4northfest.rpy:708
translate english northfest_40f032d0:

    # amina "Не надо."
    amina "用不着。"

# game/a14/4northfest.rpy:709
translate english northfest_5ac38cf1_3:

    # me "Почему?"
    me "为什么？"

# game/a14/4northfest.rpy:710
translate english northfest_5b91992f:

    # amina "Ее надо было спрятать, а сейчас уже без разницы."
    amina "这丝带本来是应该藏起来的，可现在已经无所谓了。"

# game/a14/4northfest.rpy:711
translate english northfest_5ac38cf1_4:

    # me "Почему?"
    me "为什么？"

# game/a14/4northfest.rpy:712
translate english northfest_4f8d01ac:

    # amina "Потому что любой, кто получил ленту - может бросить вызов за нее такому же. Отказаться нельзя."
    amina "因为任何拿到丝带的人，都可以向另一个有丝带的人发起挑战，争夺它。而且不能拒绝。"

# game/a14/4northfest.rpy:713
translate english northfest_00d68cd0_1:

    # me "Серьезно?"
    me "当真？"

# game/a14/4northfest.rpy:714
translate english northfest_ac69e1ff:

    # amina "Ну... не сейчас. В конце свадьбы. В любом случае мне ее не защитить. А тебе может пригодиться."
    amina "嗯……不是现在。是在婚礼结束时。反正我也保不住它。说不定你留着还有用。"

# game/a14/4northfest.rpy:715
translate english northfest_8c7d5c9e:

    # me "Так если бы ты не хвасталась..."
    me "要是你没那么炫耀的话……"

# game/a14/4northfest.rpy:716
translate english northfest_a02ab0ea:

    # amina "Ну да... Я бы могла спрятать ее. Но я ни о чем не жалею. Увидеть их кислые рожи это лучшая награда."
    amina "说得是……我本来可以藏起来的。但我一点也不后悔。看到他们那副酸溜溜的表情，就是最好的奖赏了。"

# game/a14/4northfest.rpy:717
translate english northfest_5b4d7047:

    # me "Ну ладно. Спасибо."
    me "嗯，好吧。谢谢。"

# game/a14/4northfest.rpy:718
translate english northfest_fb928eaf:

    # amina "Ты придешь на завтрашнее испытание?"
    amina "你会参加明天的试炼吗？"

# game/a14/4northfest.rpy:719
translate english northfest_1d8ca0ac:

    # me "Думаю да."
    me "我想会的。"

# game/a14/4northfest.rpy:720
translate english northfest_87d77a1f:

    # amina "Хорошо. Тогда до встречи."
    amina "好的。那就明天见。"

# game/a14/4northfest.rpy:721
translate english northfest_e078d8a2:

    # me "До встречи, Амина."
    me "明天见，Amina。"

