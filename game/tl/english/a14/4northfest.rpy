    higlanders "也许还有人能再抓来一只。"

# game/a14/4northfest.rpy:219
translate english northfest_9646f478:

    # higlander "А что толку, если ее Аслан заберет?"
    higlander "那有啥用，最后还不是被Aslan抢走？"

# game/a14/4northfest.rpy:220
translate english northfest_6decf945:

    # aslan "Больше не буду. Мне и одной хватит."
    aslan "我再也不参加了。一只就够了。"

# game/a14/4northfest.rpy:221
translate english northfest_35ef0e1f:

    # higlander "Надо убрать из правил возможность забрать лису у другого."
    higlander "规则里得去掉能从别人手里抢狐狸这条。"

# game/a14/4northfest.rpy:222
translate english northfest_30a511e6:

    # aslan "А мне это правило очень даже по душе."
    aslan "我倒觉得这条规则妙极了。"

# game/a14/4northfest.rpy:223
translate english northfest_f2b8731a:

    # higlander2 "Не сомневаюсь."
    higlander2 "我毫不怀疑。"

# game/a14/4northfest.rpy:224
translate english northfest_3997092b:

    # aslan "Ты точно так же можешь подождать кого-нибудь и отобрать лису."
    aslan "你照样可以等别人来，抢走他的狐狸。"

# game/a14/4northfest.rpy:225
translate english northfest_495bff99:

    # higlander "И что же? Если каждый будет так делать, кто лису загонять будет?"
    higlander "然后呢？如果人人都这么干，谁去追狐狸？"

# game/a14/4northfest.rpy:226
translate english northfest_6f2313f4:

    # aslan "Какой-нибудь дурак вроде тебя найдется."
    aslan "总有像你一样的傻子会去。"

# game/a14/4northfest.rpy:228
translate english northfest_a31f7e1a:

    # makhal "Почти полдень. А ты как-то не спешишь."
    makhal "快正午了。你倒是一点不急。"

# game/a14/4northfest.rpy:229
translate english northfest_57dea531:

    # krastan "Холодно! Я из реки вылез."
    krastan "冻死我了！我刚从河里爬出来。"

# game/a14/4northfest.rpy:230
translate english northfest_870adc76:

    # makhal "Она прыгнула в воду?"
    makhal "狐狸跳水里了？"

# game/a14/4northfest.rpy:231
translate english northfest_6a6e4d3a:

    # krastan "Нет. Я просто хотел поплавать."
    krastan "没。就是想游个泳。"

# game/a14/4northfest.rpy:232
translate english northfest_6107fa6d:

    # makhal "..."
    makhal "……"

# game/a14/4northfest.rpy:233
translate english northfest_8f8fdfe2:

    # krastan "Отобрал ее. А на меня сразу пять человек выскочили. Пришлось в реку прыгать."
    krastan "我抢到了狐狸。可转眼就跳出五个人围我。我只好跳河了。"

# game/a14/4northfest.rpy:234
translate english northfest_84b44982:

    # makhal "Понятно. Иди к остальным. Еще одна лиса осталась. Пару минут подождем."
    makhal "明白了。去找其他人吧。还剩下一只狐狸。我们再等几分钟。"

# game/a14/4northfest.rpy:235
translate english northfest_a78acfa4:

    # krastan "Как это еще одна? Последняя должна быть у Амины."
    krastan "怎么还剩一只？最后一只应该在阿米娜那儿才对。"

# game/a14/4northfest.rpy:237
translate english northfest_56815bb1:

    # makhal "Амина?"
    makhal "Amina的？"

# game/a14/4northfest.rpy:238
translate english northfest_45bd7141:

    # amina "А... нет... у меня нет ее..."
    amina "啊……没……我没拿到……"

# game/a14/4northfest.rpy:239
translate english northfest_8d2cba05:

    # krastan "Как это? Ты же в руках держала."
    krastan "怎么回事？你刚才明明抓在手里的。"

# game/a14/4northfest.rpy:240
translate english northfest_07fa7da6:

    # amina "Кхм-кхм... она это... сбежала...."
    amina "咳咳……它那个……跑了……"

# game/a14/4northfest.rpy:241
translate english northfest_867aa45b:

    # higlanders "{size=+4}Ха-ха-ха. Сбежала, говорит.{/size}"
    higlanders "{size=+4}哈哈哈。她说跑了。{/size}"

# game/a14/4northfest.rpy:242
translate english northfest_17b8da19:

    # krastan "Как это сбежала? Ты ее за холку держала с ножом у горла."
    krastan "怎么跑的？你当时都揪住它后颈肉，刀都架在它脖子上了。"

# game/a14/4northfest.rpy:243
translate english northfest_4b90250b:

    # amina "Ну она... это... вывернулась..."
    amina "嗯它……那个……一扭身……"

# game/a14/4northfest.rpy:244
translate english northfest_b49a41e9:

    # higlanders "{size=+4}Вывернулась! Хахахаха!{/size}"
    higlanders "{size=+4}一扭身！哈哈哈哈！{/size}"

# game/a14/4northfest.rpy:245
translate english northfest_6871cc13:

    # krastan "Вывернулась?"
    krastan "扭身跑了？"

# game/a14/4northfest.rpy:246
translate english northfest_bb78c3e4:

    # amina "Ну да."
    amina "嗯，是啊。"

# game/a14/4northfest.rpy:247
translate english northfest_9383908d:

    # krastan "Ты ее отпустила? Мы почти у старта были, значит третья лиса сбежала."
    krastan "是你把它放了吧？我们差点就到起点了，这下第三只狐狸跑了。"

# game/a14/4northfest.rpy:249
translate english northfest_728020af:

    # higlanders "{size=+4}Хахахах!{/size}"
    higlanders "{size=+4}哈哈哈哈！{/size}"

# game/a14/4northfest.rpy:250
translate english northfest_00b869c6:

    # amina "Нет!"
    amina "不是的！"

# game/a14/4northfest.rpy:251
translate english northfest_b972469e:

    # krastan "Чушь какая. Ты ее отпустила."
    krastan "胡说八道。你就是把它放了。"

# game/a14/4northfest.rpy:252
translate english northfest_f5d05472:

    # higlander "Может ты ее и покормила, перед тем как отпустить?"
    higlander "你是不是放它走前，还喂了它点东西？"

# game/a14/4northfest.rpy:253
translate english northfest_9f32f7b3:

    # higlanders "{size=+4}ХАхахаха!{/size}"
    higlanders "{size=+4}哈哈哈哈！{/size}"

# game/a14/4northfest.rpy:254
translate english northfest_4d40f48e:

    # makhal "Амина, скажи честно, чтобы мы не тратили время."
    makhal "Amina，说实话吧，好让我们别浪费时间。"

# game/a14/4northfest.rpy:255
translate english northfest_55873053_1:

    # krastan "Давай."
    krastan "说吧。"

# game/a14/4northfest.rpy:256
translate english northfest_6649c9e9_1:

    # amina "..."
    amina "……"

# game/a14/4northfest.rpy:257
translate english northfest_3c9b4c21:

    # higlanders "{size=+4}Ахахахах! У девочки просто доброе сердце!{/size}"
    higlanders "{size=+4}哈哈哈哈！这姑娘就是心肠太软！{/size}"

# game/a14/4northfest.rpy:258
translate english northfest_3b2acec3:

    # makhal "Понятно. Всё. Охота окончена. Возвращаемся на свадьбу."
    makhal "明白了。行了。打猎结束了。回婚礼去。"

# game/a14/4northfest.rpy:260
translate english northfest_7dac0600_1:

    # "Пару часов спустя."
    "几个小时后。"

# game/a14/4northfest.rpy:261
translate english northfest_cc0d48db:

    # me "Ну... гонец вернулся. Скаладан выполняет мои приказы."
    me "嗯……信使回来了。Scaladan正在执行我的命令。"

# game/a14/4northfest.rpy:262
translate english northfest_2db3a537:

    # me "Если бы он был заодно с горцами, то специально перешел бы реку и Войцеха спрятали, а то и увезли в Высокую Страну."
    me "要是他和山民一伙，早该渡过河，把Vojceh藏起来，甚至直接带去高原了。"

# game/a14/4northfest.rpy:263
translate english northfest_7fffeae3:

    # me "Но это все еще не объясняет, зачем он подставил Войцеха..."
    me "但这还是没法解释他为什么要陷害Vojceh……"

# game/a14/4northfest.rpy:264
translate english northfest_af4d3436:

    # me "Да. Точно. Я вспомнил. Его поведение в церкви Безымянного Бога. Он будто специально хотел помешать аннулированию брака."
    me "对。确实。我记起来了。他在无名之神教堂里的行为。他当时好像是故意要阻挠解除婚约的。"

# game/a14/4northfest.rpy:265
translate english northfest_9d351240:

    # me "Но зачем ему это нужно? Он получает наслаждение от войны или что-то вроде того?"
    me "但他为什么需要这么做？他能从战争里得到快感还是怎么着？"

# game/a14/4northfest.rpy:268
translate english northfest_60fce591:

    # cass "А может он хочет вторгнуться в Высокую Страну?"
    cass "也许他想入侵高原？"

# game/a14/4northfest.rpy:269
translate english northfest_0efa6a9e:

    # me "Шутишь? Там десятки кланов. Как только он перейдет рубиновое ущелье они тут же объединятся."
    me "你开玩笑？那儿有几十个氏族。他只要一跨过红宝石峡谷，他们立刻就会联手。"

# game/a14/4northfest.rpy:270
translate english northfest_339d342a:

    # cass "А может... нет."
    cass "也许……不对。"

# game/a14/4northfest.rpy:271
translate english northfest_71f0da37:

    # me "Вот и я об этом. Зачем ему это? Он явно хочет войны, но я не понимаю зачем она ему."
    me "我也这么想。他到底图什么？他明显想要战争，但我不明白他为什么想要。"

# game/a14/4northfest.rpy:272
translate english northfest_5747f4ca:

    # cass "А может ты прав? Может у него хрен не стоит, пока он на истекающее кровью тело не взглянет?"
    cass "难道你真说对了？他非得看到流血不止的尸体才能硬起来？"

# game/a14/4northfest.rpy:273
translate english northfest_a00f0bf4:

    # me "Он лорд. Может организовывать себе такое зрелище хоть каждый день. Скажет, что будет отныне казнить всех преступников сам и все."
    me "他是领主。他想看这种场面，随时都能组织。他可以说今后他要亲自处决所有犯人，这不就行了。"

# game/a14/4northfest.rpy:274
translate english northfest_bbfd5eeb:

    # cass "Да уж... загадка."
    cass "是啊……真是个谜。"

# game/a14/4northfest.rpy:275
translate english northfest_e4f1682f:

    # me "Может у него какие-то личные счеты?"
    me "会不会是他跟谁有什么私仇？"

# game/a14/4northfest.rpy:276
translate english northfest_59e4b3a2:

    # cass "Месть? Да. Это хороший вариант. Из-за твоего решения проблемы он не сможет убить тех, кто его обманули."
    cass "复仇？对。这是个好理由。因为你已经把问题解决了，他就没法杀掉那些骗了他的人。"

# game/a14/4northfest.rpy:277
translate english northfest_fd98f483:

    # me "Обманули? Судя по всему он сам был рад обмануться."
    me "骗他？从一切迹象看，他本人很乐意被骗。"

# game/a14/4northfest.rpy:278
translate english northfest_721a5f53:

    # cass "Ну... в его голове это наверняка выглядит иначе."
    cass "嗯……在他自己脑袋里，事情肯定不是这么想的。"

# game/a14/4northfest.rpy:279
translate english northfest_91a0f8be:

    # me "Ну пока он там, а я здесь, мне у него не спросить."
    me "嗯，只要他在那边，我在这边，我就没法亲口问他。"

# game/a14/4northfest.rpy:280
translate english northfest_94b83388:

    # cass "Хочешь чтобы это я сделала?"
    cass "你想让我去办这件事？"

# game/a14/4northfest.rpy:281
translate english northfest_3e865f51:

    # me "Он ничего нового тебе не скажет. Соврет, как соврал моему гонцу."
    me "他就算见了你也不会说什么新东西。肯定又撒谎，就像对去找他的人撒谎一样。"

# game/a14/4northfest.rpy:283
translate english northfest_e1c244c4:

    # cass "Ну и ладно."
    cass "那算了。"

# game/a14/4northfest.rpy:284
translate english northfest_1498a749:

    # me "Ну и ладно?"
    me "那算了？"

# game/a14/4northfest.rpy:285
translate english northfest_78a6e239:

    # cass "Дубовицкий ведь сказал тебе решить проблему с горцами. Всех их убить это тоже решение."
    cass "Dubovitsky不是让你解决山民问题吗。把他们全杀光也是一种解决方式。"

# game/a14/4northfest.rpy:286
translate english northfest_82990509:

    # me "Это я и так знаю."
    me "这我当然知道。"

# game/a14/4northfest.rpy:287
translate english northfest_50df1351:

    # cass "Ну так чего ты нервничаешь? Скаладан твои приказы выполняет. Через пару дней это место будет окружено. Все убьем и все."
    cass "那你紧张什么？Scaladan正执行你的命令呢。再过几天这块地方就会被包围。把他们全宰了就完事了。"

# game/a14/4northfest.rpy:288
translate english northfest_63196ed9:

    # me "Мне просто не нравится быть чужим инструментом."
    me "我只是不喜欢当别人手里的工具。"

# game/a14/4northfest.rpy:289
translate english northfest_529efd3b:

    # cass "Ты ведь согласился им быть."
    cass "你自己同意当的。"

# game/a14/4northfest.rpy:290
translate english northfest_48cee946:

    # me "Да. Но теперь я чувствую, что от меня что-то ускользает. Что-то мне не сказали. О чем-то недоговорили..."
    me "是的。但现在我感觉有些东西脱离了我的掌控。有些话没对我说。有些事没跟我讲全……"

# game/a14/4northfest.rpy:291
translate english northfest_6bd4078a:

    # cass "Да и насрать."
    cass "管他呢。"

# game/a14/4northfest.rpy:292
translate english northfest_3820771a_4:

    # me "..."
    me "……"

# game/a14/4northfest.rpy:293
translate english northfest_473dbe61:

    # cass "Слушай. Главное ведь, чтобы тебя не подставили, верно? Ты пытался решить все мирно, у тебя не вышло, но не по твоей вине."
    cass "听着。最重要的是你别被人陷害了，对吧？你试过和平解决，没成，但不是你的错。"

# game/a14/4northfest.rpy:294
translate english northfest_a263b186:

    # me "Поэтому нужно просто всех убить?"
    me "所以就干脆把所有人都杀了？"

# game/a14/4northfest.rpy:295
translate english northfest_a6826702:

    # cass "Поэтому нужно просто всех убить."
    cass "所以就干脆把所有人都杀了。"

# game/a14/4northfest.rpy:296
translate english northfest_855db9ee:

    # me "Ясно."
    me "明白。"

# game/a14/4northfest.rpy:298
translate english northfest_ac1b218f:

    # cass "Да расслабься. Ты все правильно сделал."
    cass "放轻松。你做的都对。"

# game/a14/4northfest.rpy:299
translate english northfest_e79d0fd5:

    # me "Да?"
    me "是吗？"

# game/a14/4northfest.rpy:300
translate english northfest_c92405fc:

    # cass "Ну да. Проверил не ловушка ли это именно для тебя и твоих людей. Остальное уже не так важно."
    cass "对啊。你已经检验过，这不是一个专门针对你和你手下的陷阱。其他的事就没那么重要了。"

# game/a14/4northfest.rpy:301
translate english northfest_42b75fc0:

    # me "Если меня не хотят убить, это вовсе не значит, что меня не хотят подставить."
    me "就算他们没想杀我，也不代表没想陷害我。"

# game/a14/4northfest.rpy:302
translate english northfest_e699f454:

    # cass "Понимаю. Но я даже предположить не могу, как это можно осуществить."
    cass "懂。但我实在想不出，这怎么才能做到。"

# game/a14/4northfest.rpy:303
translate english northfest_200fb280:

    # me "Может Скаладан умнее, чем кажется."
    me "也许Scaladan比看上去要聪明。"

# game/a14/4northfest.rpy:304
translate english northfest_35350c69:

    # cass "Ну это вряд ли."
    cass "嗯，那不太可能。"

# game/a14/4northfest.rpy:305
translate english northfest_3820771a_5:

    # me "..."
    me "……"

# game/a14/4northfest.rpy:306
translate english northfest_063a6582:

    # cass "Не волнуйся. Я бы делала все то же самое, что и ты."
    cass "别担心。换做是我，也会和你做的一样。"

# game/a14/4northfest.rpy:307
translate english northfest_489a247d:

    # me "Правда?"
    me "真的？"

# game/a14/4northfest.rpy:308
translate english northfest_dd178904:

    # cass "Да. У тебя есть договор и ты его выполняешь. Когда вернешься - у тебя будут и свидетели и документы, подтверждающие твои намерения и злой умысел Скаладана."
    cass "真的。你手里有份协议，你正在履行它。等你回去——会有证人和文件，既能证明你的意图，也能证明Scaladan的恶意。"

# game/a14/4northfest.rpy:309
translate english northfest_3820771a_6:

    # me "..."
    me "……"

# game/a14/4northfest.rpy:310
translate english northfest_59807f1a:

    # cass "Я все еще раз проверю. Не волнуйся."
    cass "我会再复查一遍的。别担心。"

# game/a14/4northfest.rpy:311
translate english northfest_2e2b7a66:

    # me "Спасибо, [cass]."
    me "谢谢，[cass]。"

# game/a14/4northfest.rpy:314
translate english northfest_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a14/4northfest.rpy:315
translate english northfest_244ef71b:

    # me "{i}Ненавижу ее контроль.{/i}"
    me "{i}我恨她这种掌控。{/i}"

# game/a14/4northfest.rpy:316
translate english northfest_0addf8b1:

    # me "{i}Но когда она рядом мне как-то спокойнее.{/i}"
    me "{i}但只要她在我身边，我就莫名感到安心。{/i}"

# game/a14/4northfest.rpy:317
translate english northfest_dfa0ee1e:

    # me "{i}Тяжело в этом признаваться самому себе... но она мне нужна.{/i}"
    me "{i}很难向自己承认……但我需要她。{/i}"

# game/a14/4northfest.rpy:318
translate english northfest_ce12c984:

    # me "{i}Как моя правая рука уж точно.{/i}"
    me "{i}至少，绝对需要她做我的左膀右臂。{/i}"

# game/a14/4northfest.rpy:319
translate english northfest_d718b304:

    # me "{i}А может и не только...{/i}"
    me "{i}也许还不止于此……{/i}"

# game/a14/4northfest.rpy:320
translate english northfest_5c76dbe7:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a14/4northfest.rpy:321
translate english northfest_94709ca1:

    # me "{i}Как все к этому пришло?{/i}"
    me "{i}这一切是怎么发展到这一步的？{/i}"

# game/a14/4northfest.rpy:322
translate english northfest_325ab45e:

    # me "{i}Я на другом конце мира целую ее, готовясь убивать людей, которые мне ничего не сделали?{/i}"
    me "{i}我在世界的另一端亲吻着她，准备去杀一群跟我无冤无仇的人？{/i}"

# game/a14/4northfest.rpy:324
translate english northfest_e32beb54:

    # cass "И да, [mename], постарайся не сдохнуть, ладно?"
    cass "对了，[mename]，尽量别死了，行吗？"

# game/a14/4northfest.rpy:325
translate english northfest_01822020_1:

    # me "Ладно."
    me "行。"

# game/a14/4northfest.rpy:326
translate english northfest_42f77970:

    # cass "Я серьезно. Если вдруг ты заметишь, что горцы что-то замышляют... Вовсе не позорно будет отступить."
    cass "我是认真的。万一你发现那些山民有什么密谋……退却一点也不可耻。"

# game/a14/4northfest.rpy:327
translate english northfest_9a5d239a:

    # me "Это против интересов Империи."
    me "那不符合帝国的利益。"

# game/a14/4northfest.rpy:328
translate english northfest_614d9775:

    # cass "Ты сейчас главный интерес для Империи."
    cass "你现在就是帝国最重要的利益。"

# game/a14/4northfest.rpy:329
translate english northfest_569da24e:

    # me "Угу. Просто признайся, что боишься меня потерять."
    me "哼。你干脆直说你怕失去我不就行了。"

# game/a14/4northfest.rpy:330
translate english northfest_416818c9:

    # cass "Заткнись."
    cass "闭嘴。"

# game/a14/4northfest.rpy:331
translate english northfest_141354df:

    # me "Ну тогда устрою резню прямо сегодня. Это опасно. Но если получится, обо мне будут петь песни."
    me "那我今晚就去大开杀戒。这很危险。但要是成了，以后我就是歌谣里传唱的英雄。"

# game/a14/4northfest.rpy:332
translate english northfest_ea705770:

    # cass "...угу..."
    cass "……哼……"

# game/a14/4northfest.rpy:333
translate english northfest_ad02f53a:

    # me "Что?"
    me "怎么了？"

# game/a14/4northfest.rpy:334
translate english northfest_8cae5cab:

    # cass "Ладно. Я за тебя беспокоюсь. Пожалуйста, не делай ничего тупого."
    cass "好吧。我是担心你。拜托，别干傻事。"

# game/a14/4northfest.rpy:335
translate english northfest_2c2f652f:

    # me "Хорошо, [cass], ты тоже."
    me "不会的，[cass]，你也一样。"

# game/a14/4northfest.rpy:336
translate english northfest_9d1722b9:

    # cass "Постараюсь. Увидимся позже. Я отправляюсь следить за стариной Скаладаном."
    cass "我尽量。回头见。我去盯着咱们的老朋友Scaladan去了。"

# game/a14/4northfest.rpy:337
translate english northfest_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a14/4northfest.rpy:340
translate english northfest_fb24391c:

    # me "Знаешь, мне некомфортно, когда я человек, с которым я общаюсь, стоит сзади."
    me "你知道吗，谈话对象站在我身后，会让我很不舒服。"

# game/a14/4northfest.rpy:341
translate english northfest_9d9a9db1:

    # selest "А я и не человек."
    selest "可我又不是人。"

# game/a14/4northfest.rpy:342
translate english northfest_94db922e:

    # me "Ты поняла о чем я."
    me "你懂我的意思。"

# game/a14/4northfest.rpy:344
translate english northfest_310dc93d:

    # selest "Параноишь? Это хорошо. Значит ты осторожен и не глуп."
    selest "疑心病犯了？挺好的。说明你谨慎，还不蠢。"

# game/a14/4northfest.rpy:345
translate english northfest_8beb5400:

    # me "Нет. Это просто неудобно."
    me "不。我只是觉得不方便。"

# game/a14/4northfest.rpy:346
translate english northfest_abd0715d:

    # selest "Я думаю тебе не стоит сейчас об этом думать."
    selest "我觉得你现在不该想这个。"

# game/a14/4northfest.rpy:347
translate english northfest_dfcceeac_1:

    # me "М?"
    me "嗯？"

# game/a14/4northfest.rpy:348
translate english northfest_7d6a0478:

    # selest "Про то, зачем Скаладан это сделал. Ты попытался решить все мирно - не получилось."
    selest "想Scaladan为什么要这么做。你试过和平解决——没成。"

# game/a14/4northfest.rpy:349
translate english northfest_b386ce11:

    # me "У меня то как раз все получилось. Скаладан все испортил."
    me "我这边其实成了。Scaladan把一切搞砸了。"

# game/a14/4northfest.rpy:350
translate english northfest_f96b69e8:

    # selest "В любом случае для всех нас будет выгоднее убить этих людей."
    selest "无论如何，杀死这些人对我们大家都更有利。"

# game/a14/4northfest.rpy:351
translate english northfest_e7c3e620:

    # me "Для нас?"
    me "对我们？"

# game/a14/4northfest.rpy:352
translate english northfest_bd5ffdde:

    # selest "Ты хочешь чтобы я это сказала? Хорошо. Это будет полезно для эльфов. Ты ведь все еще нам помогаешь?"
    selest "你想让我把话说白吗？好吧。这对精灵有利。你仍是在帮我们，对吧？"

# game/a14/4northfest.rpy:353
translate english northfest_fc30fd2b:

    # me "Да."
    me "是的。"

# game/a14/4northfest.rpy:354
translate english northfest_7ae085e6:

    # selest "Ну так вот. Если эти ублюдки умрут - это нам поможет."
    selest "那就对了。如果这帮杂种死了——对我们就是帮助。"

# game/a14/4northfest.rpy:355
translate english northfest_cbe79a70:

    # me "И чем же?"
    me "具体帮在哪儿？"

# game/a14/4northfest.rpy:356
translate english northfest_aae7bd1f:

    # selest "Тем, что в этом мире станет на сотню другую меньше дегенератов и варваров."
    selest "帮在让这世上少了一两百个堕落的垃圾和野蛮人。"

# game/a14/4northfest.rpy:357
translate english northfest_58e08d2e:

    # me "Откуда такая ненависть?"
    me "你哪儿来的这股恨意？"

# game/a14/4northfest.rpy:358
translate english northfest_8cc91943:

    # selest "Это не ненависть. Это презрение. Люди не слишком цивилизованны, но горцы это худшие их представители. Блевотина. Мусор."
    selest "这不是恨。是蔑视。人类已经够不开化了，可山民却是其中最烂的货色。渣滓。垃圾。"

# game/a14/4northfest.rpy:359
translate english northfest_3820771a_7:

    # me "..."
    me "……"

# game/a14/4northfest.rpy:360
translate english northfest_0e322467:

    # selest "Знаешь, люди хотя бы выдумывают за что вешать эльфов, эти ублюдки делают это просто так."
    selest "你知道么，人类好歹会为绞死精灵编个罪名，但这些渣滓动手杀人根本不需要理由。"

# game/a14/4northfest.rpy:362
translate english northfest_f5de9266:

    # me "Выдумывают?"
    me "编罪名？"

# game/a14/4northfest.rpy:363
translate english northfest_560ebcc6:

    # selest "Хочешь сказать, нас убивают справедливо?"
    selest "你是不是想说，他们杀我们杀得对？"

# game/a14/4northfest.rpy:364
translate english northfest_cca3d65e:

    # me "Хочу сказать, что несправедлив сам закон. И все же он закон. Странно предъявлять людям, за то что они живут по своим правилам."
    me "我是想说，那不公正的是法律本身。但它终究是法律。指责别人按自己的规矩活，这有点奇怪。"

# game/a14/4northfest.rpy:365
translate english northfest_f3dd510f:

    # selest "Как думаешь, какой закон люди исполнят охотнее - о том, что нужно повесить эльфа за кражу хлеба или что этот хлеб нужно сдать в качестве оброка лорду?"
    selest "你觉得人们会更乐意执行哪条法律——是“精灵偷了面包就要被绞死”，还是“面包得当成租税交给领主”？"

# game/a14/4northfest.rpy:366
translate english northfest_60358084:

    # me "Эм..."
    me "呃……"

# game/a14/4northfest.rpy:367
translate english northfest_6cc9f771:

    # selest "Можешь не отвечать. Вопрос риторический. Да и к тому же у горцев никаких законов нет. Как я и сказала, чтобы убить эльфа им повод не нужен."
    selest "不用回答。这是个反问。再说了，山民根本没有任何法律。就像我说过的，他们要杀精灵，根本不需要理由。"

# game/a14/4northfest.rpy:368
translate english northfest_e47cc4aa:

    # me "Ясно. Так мне убить их всех в качестве мести?"
    me "懂了。所以你是要我杀光他们，替你报仇？"

# game/a14/4northfest.rpy:369
translate english northfest_a8dd2b38:

    # selest "Ты ведь здесь именно за этим. Разве нет?"
    selest "你本就是为这个来的。不是吗？"

# game/a14/4northfest.rpy:370
translate english northfest_20b9a137:

    # me "Я здесь, чтобы решить проблему с горцами."
    me "我来这儿，是为了解决山民的问题。"

# game/a14/4northfest.rpy:371
translate english northfest_f23268b8:

    # selest "Ну так реши. Раз и навсегда."
    selest "那就解决吧。一劳永逸。"

# game/a14/4northfest.rpy:372
translate english northfest_989bfba0:

    # me "У меня вопрос."
    me "我有个问题。"

# game/a14/4northfest.rpy:373
translate english northfest_ee7d11dc:

    # selest "Задавай."
    selest "问。"

# game/a14/4northfest.rpy:374
translate english northfest_e7298e6f:

    # me "Ты что-нибудь знаешь о письме, которое написал Скаладан Войцеху?"
    me "关于斯卡拉丹写给Vojceh的那封信，你知道些什么吗？"

# game/a14/4northfest.rpy:375
translate english northfest_b0541c32:

    # selest "Нет."
    selest "不知道。"

# game/a14/4northfest.rpy:376
translate english northfest_3820771a_8:

    # me "..."
    me "……"

# game/a14/4northfest.rpy:378
translate english northfest_898a1fbb:

    # selest "[mename], мне нет смысла тебе врать."
    selest "[mename]，我没必要对你说谎。"

# game/a14/4northfest.rpy:379
translate english northfest_489a247d_1:

    # me "Правда?"
    me "真的？"

# game/a14/4northfest.rpy:380
translate english northfest_96e2465b:

    # selest "Я бы не стала скрывать, если бы эльфы были к этому причастны."
    selest "要是精灵参与了这事，我不会隐瞒你。"

# game/a14/4northfest.rpy:381
translate english northfest_868f4cc1:

    # me "А самому Скаладану?"
    me "那关于Scaladan本人的动机呢？"

# game/a14/4northfest.rpy:382
translate english northfest_00210cef:

    # selest "Всмысле?"
    selest "什么意思？"

# game/a14/4northfest.rpy:383
translate english northfest_17b1498d:

    # me "Его мотивация мне не до конца понятна."
    me "他的动机我还没完全搞明白。"

# game/a14/4northfest.rpy:384
translate english northfest_7cea9325:

    # selest "Аналогично. Мы к этому отношения не имеем."
    selest "一样。我们跟这事无关。"

# game/a14/4northfest.rpy:385
translate english northfest_b77a7f8b:

    # me "Точно?"
    me "确定？"

# game/a14/4northfest.rpy:386
translate english northfest_174a2014:

    # selest "Точно. Я бы тебе сказала. Видимо у него какие-то личные счеты. Но нам это только на руку."
    selest "确定。不然我一定告诉你。看来是他的私仇。但这对我们只有好处。"

# game/a14/4northfest.rpy:387
translate english northfest_11f44407:

    # me "Ну хорошо."
    me "嗯，好吧。"

# game/a14/4northfest.rpy:388
translate english northfest_4edff5e8:

    # selest "И насчет битвы... мы поможем."
    selest "关于战斗……我们会帮忙。"

# game/a14/4northfest.rpy:389
translate english northfest_489a247d_2:

    # me "Правда?"
    me "真的？"

# game/a14/4northfest.rpy:390
translate english northfest_c080c068:

    # selest "Да. Нас немного тут и в атаке будем бесполезны. Но мы не дадим никому отсюда уйти, если вдруг кто-то побежит. Перекроем все тропы в Высокую Страну."
    selest "是的。我们在这里人不多，冲锋陷阵没什么用。但要是有人想逃跑，我们不会让他们逃走的，我们会封锁所有通往高原的小路。"

# game/a14/4northfest.rpy:391
translate english northfest_3066598f_1:

    # me "Спасибо."
    me "谢谢。"

# game/a14/4northfest.rpy:392
translate english northfest_4abecfc9:

    # selest "Не за что."
    selest "不客气。"

# game/a14/4northfest.rpy:393
translate english northfest_729e30c6:

    # me "...ну... мне пора."
    me "……嗯……我得走了。"

# game/a14/4northfest.rpy:394
translate english northfest_b6d6ee6c:

    # selest "Иди."
    selest "去吧。"

# game/a14/4northfest.rpy:397
translate english northfest_6027f41c:

    # me "{i}Бред какой-то.{/i}"
    me "{i}真是见鬼了。{/i}"

# game/a14/4northfest.rpy:398
translate english northfest_51f249cf:

    # me "{i}Как бы все не закончилось, этот вопрос ему задать нужно.{/i}"
    me "{i}不管结果如何，这个问题都得问他。{/i}"

# game/a14/4northfest.rpy:399
translate english northfest_25484563:

    # me "{i}Главное сохранить все документы. Свидетели у меня тоже есть.{/i}"
    me "{i}关键是保管好所有文件。证人我也有。{/i}"

# game/a14/4northfest.rpy:400
translate english northfest_e91db80f:

    # me "{i}Борис должен знать, что я пытался, но его лорд мне помешал.{/i}"
    me "{i}Boris必须知道，我试过了，是他自己的领主从中作梗。{/i}"

# game/a14/4northfest.rpy:401
translate english northfest_5c76dbe7_1:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a14/4northfest.rpy:402
translate english northfest_8f972ccd:

    # me "{i}Ладно, пора на свадьбу.{/i}"
    me "{i}好了，该去参加婚礼了。{/i}"

# game/a14/4northfest.rpy:404
translate english northfest_f3333816:

    # "Следующим утром."
    "次日清晨。"

# game/a14/4northfest.rpy:405
translate english northfest_7324ca88:

    # makhal "...невеста спрятала ленту где-то в пещере. Задача - первым ее найти."
    makhal "……新娘把丝带藏在洞窟里的某个地方了。任务就是第一个找到它。"

# game/a14/4northfest.rpy:406
translate english northfest_71fa9a97:

    # me "А она может быть где угодно?"
    me "丝带可能藏在任何地方吗？"

# game/a14/4northfest.rpy:407
translate english northfest_cbab3647:

    # makhal "Она там, где ее спрятала моя дочь."
    makhal "就在我女儿藏的地方。"

# game/a14/4northfest.rpy:408
translate english northfest_e531fdc1:

    # krastan "Может быть хоть в самом начале."
    krastan "甚至可能就在入口处。"

# game/a14/4northfest.rpy:409
translate english northfest_489a247d_3:

    # me "Правда?"
    me "真的？"

# game/a14/4northfest.rpy:410
translate english northfest_c7e39654:

    # makhal "Правда. Но это вряд ли."
    makhal "真的。不过这不太可能。"

# game/a14/4northfest.rpy:411
translate english northfest_54e616ea:

    # me "И что? Все эти люди ломануться в пещеру одновременно?"
    me "怎么？难道那些人都会一窝蜂地同时冲进洞窟吗？"

# game/a14/4northfest.rpy:412
translate english northfest_04e4cbcb:

    # krastan "А может стоит приходить вовремя и выслушивать все правила вместе со всеми?"
    krastan "或许你该按时到场，跟大家一起把规则听全了？"

# game/a14/4northfest.rpy:413
translate english northfest_6fb1b367:

    # makhal "Не оскорбляй нашего гостя, Крастан."
    makhal "别侮辱我们的客人，Krastan。"

# game/a14/4northfest.rpy:414
translate english northfest_c05eff3d:

    # me "Я не оскорблен."
    me "我没觉得被侮辱。"

# game/a14/4northfest.rpy:415
translate english northfest_58e32d16:

    # makhal "Скорость не имеет значения. В пещере множество ходов."
    makhal "速度不重要。洞窟里岔道很多。"

# game/a14/4northfest.rpy:416
translate english northfest_b1540e4c:

    # me "Выходит, все зависит от удачи."
    me "看来全靠运气了。"

# game/a14/4northfest.rpy:417
translate english northfest_36ae6eb8:

    # makhal "Скорее от внимательности."
    makhal "不如说靠眼力。"

# game/a14/4northfest.rpy:419
translate english northfest_e534cd5d:

    # krastan "Ну так что, жених. Объявишь о начале? Тем более раз уж это твои пещеры."
    krastan "那么，新郎。该宣布开始了吧？再说了，这好歹是你的洞窟。"

# game/a14/4northfest.rpy:420
translate english northfest_56701e80:

    # wojceh "Это не мои пещеры."
    wojceh "这不是我的洞窟。"

# game/a14/4northfest.rpy:421
translate english northfest_96562b34:

    # krastan "Скоро будут твоими. Такие большие. Глубокие. Ты наверняка рад."
    krastan "很快就归你了。这么大。这么深。你肯定高兴坏了吧。"

# game/a14/4northfest.rpy:422
translate english northfest_d8a02295:

    # wojceh "Ага. Безумно счастлив."
    wojceh "是啊。高兴得不得了。"

# game/a14/4northfest.rpy:423
translate english northfest_c8d35646:

    # krastan "И всего лишь за пару полос леса! Он тебе и даром не нужен был, правда?"
    krastan "而且只用一小片林地就换来了！反正那片地你也用不着，对吧？"

# game/a14/4northfest.rpy:424
translate english northfest_ee4fa5d4:

    # wojceh "Нужен."
    wojceh "用得着。"

# game/a14/4northfest.rpy:425
translate english northfest_e05b57b1:

    # krastan "Ну... может однажды эта земля к тебе вернется. Правда уже без леса. Хахахаха."
    krastan "嗯……也许有一天这片地会回到你手上。当然了，上面没了林子。哈哈哈哈。"

# game/a14/4northfest.rpy:426
translate english northfest_42ae495a:

    # wojceh "..."
    wojceh "……"

# game/a14/4northfest.rpy:427
translate english northfest_dd243c92:

    # makhal "Закрой рот, Крастан."
    makhal "闭上你的嘴，Krastan。"

# game/a14/4northfest.rpy:428
translate english northfest_19400dcd:

    # krastan "Что? Я просто рад за Корхалис моей сестры."
    krastan "怎么？我只是替我姐的嫁妆高兴。"

# game/a14/4northfest.rpy:429
translate english northfest_60a6515f:

    # makhal "Объявляй о начале."
    makhal "宣布开始。"

# game/a14/4northfest.rpy:430
translate english northfest_89936d0e:

