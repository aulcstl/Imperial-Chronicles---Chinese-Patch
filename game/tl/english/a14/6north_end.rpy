    # highlanders "{size=+5}Крастан! Крастан!{/size}"
    highlanders "{size=+5}Krastan！Krastan！{/size}"

# game/a14/6north_end.rpy:667
translate english highland_end_rib_1ab05412:

    # krastan "Это смело. Но очень глупо."
    krastan "有胆量。但很蠢。"

# game/a14/6north_end.rpy:668
translate english highland_end_rib_489a247d:

    # me "Правда?"
    me "是吗？"

# game/a14/6north_end.rpy:669
translate english highland_end_rib_2c979856:

    # krastan "Да. Тебе даже камень не поможет."
    krastan "对。连石头都救不了你。"

# game/a14/6north_end.rpy:670
translate english highland_end_rib_2a6b0212:

    # me "А что поможет?"
    me "那什么能救？"

# game/a14/6north_end.rpy:671
translate english highland_end_rib_ef28b4ed:

    # krastan "Слушай, это же просто абсурд. Ты бы и Аслана не победил без помощи моей неравнодушной сестренки."
    krastan "听着，这太荒谬了。没有我那个好心的妹妹帮忙，你连Aslan都赢不了。"

# game/a14/6north_end.rpy:672
translate english highland_end_rib_3820771a_2:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:673
translate english highland_end_rib_f1c69a27:

    # krastan "Ты серьезно рассчитываешь победить?"
    krastan "你真觉得自己能赢？"

# game/a14/6north_end.rpy:674
translate english highland_end_rib_0f7784c2:

    # highlanders "{size=+5}Деритесь!{/size}"
    highlanders "{size=+5}打啊！{/size}"

# game/a14/6north_end.rpy:675
translate english highland_end_rib_3820771a_3:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:676
translate english highland_end_rib_4061d30b:

    # krastan "Нет, правда?"
    krastan "说真的？"

# game/a14/6north_end.rpy:677
translate english highland_end_rib_3820771a_4:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:678
translate english highland_end_rib_d482fe37:

    # highlanders "{size=+5}Деритесь уже!{/size}"
    highlanders "{size=+5}快打啊！{/size}"

# game/a14/6north_end.rpy:679
translate english highland_end_rib_67182cde:

    # krastan "Зачем ты это делаешь? Я не понимаю. Ты уже доказал, что ты мужчина. К чему продолжать стоять? Сдайся."
    krastan "你为什么要这样？我不明白。你已经证明你是条汉子了。何必还站着？认输吧。"

# game/a14/6north_end.rpy:681
translate english highland_end_rib_7102576a:

    # me "{size=-5}Я не сдамся. Я не сдаюсь, когда на кону стоит что-то важное.{/size}"
    me "{size=-5}我不会认输。当赌注够大的时候，我不会认输。{/size}"

# game/a14/6north_end.rpy:682
translate english highland_end_rib_30939655:

    # krastan "{size=-5}Ленты? Это что-то важное? Зачем они тебе?{/size}"
    krastan "{size=-5}丝带？这算大赌注？你要它们干吗？{/size}"

# game/a14/6north_end.rpy:683
translate english highland_end_rib_35964be0:

    # me "{size=-5}...{/size}"
    me "{size=-5}……{/size}"

# game/a14/6north_end.rpy:684
translate english highland_end_rib_7718279b:

    # krastan "{size=-5}Я хочу стать следующим вождем. А ты что попросишь? Лошадей? Золота?{/size}"
    krastan "{size=-5}我想当下一任首领。你呢，你会求什么？马？金子？{/size}"

# game/a14/6north_end.rpy:685
translate english highland_end_rib_e967c54e:

    # me "{size=-5}Ты знаешь, что я попрошу.{/size}"
    me "{size=-5}你知道我会求什么。{/size}"

# game/a14/6north_end.rpy:686
translate english highland_end_rib_18edab07:

    # krastan "{size=-5}Нет.{/size}"
    krastan "{size=-5}不。{/size}"

# game/a14/6north_end.rpy:687
translate english highland_end_rib_73f5cd51:

    # me "{size=-5}Знаешь.{/size}"
    me "{size=-5}你知道。{/size}"

# game/a14/6north_end.rpy:688
translate english highland_end_rib_da9b06ab:

    # krastan "{size=-5}Понятия не имею...{/size}"
    krastan "{size=-5}我完全不知道……{/size}"

# game/a14/6north_end.rpy:689
translate english highland_end_rib_a94f6a4f:

    # me "{size=-5}Вокруг этого места полторы тысячи солдат. Через реку еще две.{/size}"
    me "{size=-5}这地方周围有一千五百名士兵。河对面还有两千。{/size}"

# game/a14/6north_end.rpy:690
translate english highland_end_rib_48043f0b:

    # krastan "{size=-5}И...{/size}"
    krastan "{size=-5}然后……{/size}"

# game/a14/6north_end.rpy:691
translate english highland_end_rib_8e91e5fe:

    # me "{size=-5}Я же сказал - я сражаюсь до конца только когда на кону стоит что-то важное. Например жизнь. Даже если это не моя жизнь.{/size}"
    me "{size=-5}我说过——只有当赌注够大时我才会拼到底。比如性命。哪怕不是我的命。{/size}"

# game/a14/6north_end.rpy:692
translate english highland_end_rib_b231ce45:

    # me "{size=-5}Иногда поддаться это не значит проиграть.{/size}"
    me "{size=-5}有时候服输并不等于失败。{/size}"

# game/a14/6north_end.rpy:694
translate english highland_end_rib_597387b6:

    # krastan "{size=-5}[mename]?{/size}"
    krastan "{size=-5}[mename]？{/size}"

# game/a14/6north_end.rpy:695
translate english highland_end_rib_0e538831:

    # me "{size=-5}Поддайся.{/size}"
    me "{size=-5}服输吧。{/size}"

# game/a14/6north_end.rpy:696
translate english highland_end_rib_33bb92f8:

    # krastan "{size=-5}...{/size}"
    krastan "{size=-5}……{/size}"

# game/a14/6north_end.rpy:697
translate english highland_end_rib_95a2431a:

    # me "{size=-5}Поддайся или мы все сегодня умрем.{/size}"
    me "{size=-5}服输吧，否则我们今天都会死。{/size}"

# game/a14/6north_end.rpy:698
translate english highland_end_rib_631c11cd:

    # krastan "{size=-5}Я...{/size}"
    krastan "{size=-5}我……{/size}"

# game/a14/6north_end.rpy:699
translate english highland_end_rib_5b4dbdc8:

    # me "{size=-5}Хочешь стать вождем? Ты будешь вождем костей и черепов, если не переступишь через свою гордость.{/size}"
    me "{size=-5}想当首领？你要是跨不过自己的骄傲，就只能当白骨堆的首领了。{/size}"

# game/a14/6north_end.rpy:700
translate english highland_end_rib_1fbae7ec:

    # krastan "{size=-5}...дерись... я пройду в ноги, а ты хватай меня за шею.{/size}"
    krastan "{size=-5}……打吧……我会往你脚下冲，你就抓我脖子。{/size}"

# game/a14/6north_end.rpy:702
translate english highland_end_rib_5125daaa:

    # amina "Крастан?"
    amina "Krastan？"

# game/a14/6north_end.rpy:703
translate english highland_end_rib_d59c127e:

    # krastan "Твою мать!"
    krastan "我靠！"

# game/a14/6north_end.rpy:704
translate english highland_end_rib_3820771a_5:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:705
translate english highland_end_rib_6a2bd49b_2:

    # amina "[mename]?"
    amina "[mename]？"

# game/a14/6north_end.rpy:706
translate english highland_end_rib_eede5ac6:

    # krastan "Блядь!"
    krastan "妈的！"

# game/a14/6north_end.rpy:707
translate english highland_end_rib_3820771a_6:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:708
translate english highland_end_rib_1ec08aa4:

    # amina "Что... что происходит?"
    amina "怎……怎么回事？"

# game/a14/6north_end.rpy:709
translate english highland_end_rib_7cb7db23:

    # krastan "...сука..."
    krastan "……操……"

# game/a14/6north_end.rpy:710
translate english highland_end_rib_364a5411:

    # krastan "...блядь..."
    krastan "……妈的……"

# game/a14/6north_end.rpy:711
translate english highland_end_rib_0a74f274:

    # krastan "Сдаюсь!"
    krastan "我认输！"

# game/a14/6north_end.rpy:712
translate english highland_end_rib_58173931:

    # me "Громче!"
    me "大声点！"

# game/a14/6north_end.rpy:713
translate english highland_end_rib_0ab25764:

    # krastan "{size=+5}Сдаюсь!{/size}"
    krastan "{size=+5}我认输！{/size}"

# game/a14/6north_end.rpy:715
translate english highland_end_rib_93792cc2:

    # highlanders "{size=+5}Слабак! Упал за минуту! Червяк!{/size}"
    highlanders "{size=+5}废物！一分钟就倒了！虫豸！{/size}"

# game/a14/6north_end.rpy:716
translate english highland_end_rib_2923ac10:

    # amina "Ты... ты это специально?"
    amina "你……你是故意的？"

# game/a14/6north_end.rpy:717
translate english highland_end_rib_30c81f70:

    # krastan "Ага. Надеюсь это было не слишком очевидно?"
    krastan "对。希望不会太明显？"

# game/a14/6north_end.rpy:718
translate english highland_end_rib_eae71b39:

    # amina "Нет. Выглядело, будто ты ошибся."
    amina "不会。看起来像你失误了。"

# game/a14/6north_end.rpy:719
translate english highland_end_rib_d2bf184e:

    # krastan "Может надо было еще дать ему меня подушить?"
    krastan "是不是该让他多勒我一会儿？"

# game/a14/6north_end.rpy:720
translate english highland_end_rib_630dbd35:

    # amina "... почему ты?"
    amina "……为什么是你？"

# game/a14/6north_end.rpy:721
translate english highland_end_rib_89269626:

    # krastan "Я и сам не знаю, Амина. Я ему поверил."
    krastan "我自己也不知道，Amina。我相信他了。"

# game/a14/6north_end.rpy:722
translate english highland_end_rib_f8cfd15e:

    # highlanders "{size=+5}Щенок сраный! Позор Севера!{/size}"
    highlanders "{size=+5}臭崽子！北方的耻辱！{/size}"

# game/a14/6north_end.rpy:723
translate english highland_end_rib_16ddee19:

    # amina "Что он тебе сказал?"
    amina "他跟你说什么了？"

# game/a14/6north_end.rpy:724
translate english highland_end_rib_279c7a74:

    # krastan "Да так. Какую-то южанскую чушь."
    krastan "没什么。一堆南方人的废话。"

# game/a14/6north_end.rpy:725
translate english highland_end_rib_6649c9e9_1:

    # amina "..."
    amina "……"

# game/a14/6north_end.rpy:726
translate english highland_end_rib_456aca8a:

    # krastan "Отец будет зол."
    krastan "父亲会发火的。"

# game/a14/6north_end.rpy:727
translate english highland_end_rib_af9c2972:

    # amina "Очень."
    amina "非常火。"

# game/a14/6north_end.rpy:728
translate english highland_end_rib_a65ea758:

    # krastan "Хорошо что Аслан тоже опозорился. Не хотелось бы чтобы все ненавидели только меня."
    krastan "还好Aslan也丢人了。我可不想所有人都只恨我一个。"

# game/a14/6north_end.rpy:729
translate english highland_end_rib_bc7b4d16:

    # amina "Тебя... тебя все равно будут ненавидеть больше."
    amina "你……反正他们还是会更恨你的。"

# game/a14/6north_end.rpy:730
translate english highland_end_rib_f6b84465:

    # krastan "Может ты тогда станешь следующим вождем?"
    krastan "也许你来当下一任首领？"

# game/a14/6north_end.rpy:731
translate english highland_end_rib_32ac9650:

    # amina "Что?"
    amina "什么？"

# game/a14/6north_end.rpy:732
translate english highland_end_rib_c7021d02:

    # krastan "Да так. Просто мысленно прощаюсь с одобрением отца и старейшин. Не обращай внимания."
    krastan "没什么。只是心里跟父亲和长老们的认可说再见了。别在意。"

# game/a14/6north_end.rpy:733
translate english highland_end_rib_012c5741:

    # highlanders "{size=+5}Волк проиграл льву!{/size}"
    highlanders "{size=+5}狼输给了狮子！{/size}"

# game/a14/6north_end.rpy:735
translate english highland_end_rib_8c75f527:

    # highlanders "{size=+5}Смотрите! Лев идет с лентами! Какой позор!{/size}"
    highlanders "{size=+5}看！狮子拿着丝带来了！真丢人！{/size}"

# game/a14/6north_end.rpy:736
translate english highland_end_rib_17cb8e61:

    # me "{size=+5}Заткнитесь. Я буду говорить.{/size}"
    me "{size=+5}闭嘴。我来发言。{/size}"

# game/a14/6north_end.rpy:737
translate english highland_end_rib_310eb5d2:

    # me "{size=+5}...{/size}"
    me "{size=+5}……{/size}"

# game/a14/6north_end.rpy:738
translate english highland_end_rib_7754256b:

    # me "{size=+5}Я соревновался по вашим правилам.{/size}"
    me "{size=+5}我是按你们的规矩比赛的。{/size}"

# game/a14/6north_end.rpy:739
translate english highland_end_rib_72997f45:

    # me "{size=+5}И выиграл. Традиция гласит - тот, кто собрал все ленты, может попросить что угодно.{/size}"
    me "{size=+5}而且我赢了。传统说——集齐所有丝带的人，可以提出任何要求。{/size}"

# game/a14/6north_end.rpy:740
translate english highland_end_rib_11d1c5e1:

    # me "{size=+5}И я хочу попросить.{/size}"
    me "{size=+5}我想提这个要求。{/size}"

# game/a14/6north_end.rpy:741
translate english highland_end_rib_d703ff1a:

    # me "{size=+5}Вся эта свадьба - ошибка. Ее не должно быть.{/size}"
    me "{size=+5}整场婚礼是个错误。它不该存在。{/size}"

# game/a14/6north_end.rpy:742
translate english highland_end_rib_8bf00bb4:

    # me "{size=+5}И прежде чем она будет окончена, я прошу отменить ее. Ее и Корхалис.{/size}"
    me "{size=+5}在它完成之前，我请求取消它。取消婚礼，也取消科尔哈里斯。{/size}"

# game/a14/6north_end.rpy:743
translate english highland_end_rib_3388d7c2:

    # me "{size=+5}Вернитесь к себе в Высокую Страну, а лорда Войцеха отпустите.{/size}"
    me "{size=+5}你们回你们的高地去，把Vojceh领主放了。{/size}"

# game/a14/6north_end.rpy:744
translate english highland_end_rib_4d5d4469:

    # me "{size=+5}Я выиграл все ленты честно. Я не жульничал и дрался за них с лучшими из вас.{/size}"
    me "{size=+5}我公平地赢得了所有丝带。我没有作弊，并且为了它们和你们中最强的人交过手。{/size}"

# game/a14/6north_end.rpy:745
translate english highland_end_rib_07f69909:

    # me "{size=+5}Я слышал горцы славятся тем, что уважают традиции и держат слово.{/size}"
    me "{size=+5}我听说山地人以尊重传统、信守承诺著称。{/size}"

# game/a14/6north_end.rpy:746
translate english highland_end_rib_72f9a658:

    # me "{size=+5}Это правда или мне лгали?{/size}"
    me "{size=+5}这是真的，还是有人在骗我？{/size}"

# game/a14/6north_end.rpy:748
translate english highland_end_rib_22e33a07:

    # alia "Отец?"
    alia "父亲？"

# game/a14/6north_end.rpy:749
translate english highland_end_rib_69280361:

    # makhal "Я... не могу..."
    makhal "我……不能……"

# game/a14/6north_end.rpy:750
translate english highland_end_rib_0b04dd36:

    # alia "Ты можешь. Он выиграл честно."
    alia "你能。他是公平赢的。"

# game/a14/6north_end.rpy:751
translate english highland_end_rib_f725b285:

    # makhal "Я все еще могу бросить ему вызов. Забрать ленты. Он еле стоит на ногах."
    makhal "我仍然可以向他挑战。夺回丝带。他连站都快站不稳了。"

# game/a14/6north_end.rpy:752
translate english highland_end_rib_752d2297:

    # alia "Ты же знаешь, что будет дальше."
    alia "你知道接下来会发生什么。"

# game/a14/6north_end.rpy:753
translate english highland_end_rib_6107fa6d:

    # makhal "..."
    makhal "……"

# game/a14/6north_end.rpy:754
translate english highland_end_rib_e8afd7ff:

    # alia "Будет много крови. Бойня. Но даже если мы ее переживем - ты опозоришь свое имя."
    alia "会流很多血。大屠杀。但就算我们活下来——你也会玷污自己的名声。"

# game/a14/6north_end.rpy:755
translate english highland_end_rib_d9e8d664:

    # makhal "Если я приму его просьбу - значит все это было зря."
    makhal "如果我接受他的请求——那这一切都白费了。"

# game/a14/6north_end.rpy:756
translate english highland_end_rib_2367f943:

    # alia "Не зря. Ты сделал все что мог. Но твои сыновья подвели тебя. Когда мы вернемся, у тебя будет больше власти над ними, чем когда-либо."
    alia "没有白费。你做了你能做的一切。但你的儿子们拖累了你。等我们回去，你对他们将拥有前所未有的掌控力。"

# game/a14/6north_end.rpy:757
translate english highland_end_rib_0a290232:

    # makhal "Я делал все это не для власти над моими детьми."
    makhal "我做这些不是为了掌控我的孩子们。"

# game/a14/6north_end.rpy:758
translate english highland_end_rib_dc15e023:

    # alia "Терпеливый охотник всегда вернется с добычей. Пусть и с малой. Гордый охотник бросится на льва и будет растерзан."
    alia "有耐心的猎人终究会带回猎物，哪怕不大。骄傲的猎人会扑向狮子，然后被撕碎。"

# game/a14/6north_end.rpy:759
translate english highland_end_rib_6107fa6d_1:

    # makhal "..."
    makhal "……"

# game/a14/6north_end.rpy:760
translate english highland_end_rib_0fa947ce:

    # alia "Ты терпеливый охотник или гордый, отец?"
    alia "你是有耐心的猎人，还是骄傲的猎人，爸爸？"

# game/a14/6north_end.rpy:761
translate english highland_end_rib_6107fa6d_2:

    # makhal "..."
    makhal "……"

# game/a14/6north_end.rpy:762
translate english highland_end_rib_7656dcbc:

    # me "{size=+5}Каково твое решение, Макхал?{/size}"
    me "{size=+5}你的决定是什么，Makhal？{/size}"

# game/a14/6north_end.rpy:764
translate english highland_end_rib_5eb9e788:

    # makhal "То, чего ты просишь - оскорбительно."
    makhal "你所求的——是侮辱。"

# game/a14/6north_end.rpy:765
translate english highland_end_rib_3820771a_7:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:766
translate english highland_end_rib_da1dd81c:

    # makhal "То, чего ты просишь - против интересов моего рода. Моего клана."
    makhal "你所求的——违背了我家族、我部族的利益。"

# game/a14/6north_end.rpy:767
translate english highland_end_rib_3820771a_8:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:768
translate english highland_end_rib_8fc88805:

    # makhal "То, чего ты просишь - заберет у нас то, что по праву наше."
    makhal "你所求的——会夺走我们本该拥有的东西。"

# game/a14/6north_end.rpy:769
translate english highland_end_rib_3820771a_9:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:770
translate english highland_end_rib_86d335d5:

    # makhal "То, чего ты просишь - не искупит вины, ран и обиды, нанесенные нам северянами."
    makhal "你所求的——无法弥补北方人给我们带来的罪责、伤痛和屈辱。"

# game/a14/6north_end.rpy:771
translate english highland_end_rib_3820771a_10:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:772
translate english highland_end_rib_8eda0c6c:

    # makhal "То, что ты просишь - сделает отмщение неизбежным."
    makhal "你所求的——会使复仇不可避免。"

# game/a14/6north_end.rpy:773
translate english highland_end_rib_3820771a_11:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:775
translate english highland_end_rib_8e76876b:

    # makhal "Но я никогда не нарушу наших священных традиций."
    makhal "但我永远不会违背我们神圣的传统。"

# game/a14/6north_end.rpy:776
translate english highland_end_rib_b100b568:

    # makhal "Для меня они ценнее моих желаний, моей гордости и моей жажды мести."
    makhal "对我来说，它们比我的欲望、我的骄傲和我的复仇心更珍贵。"

# game/a14/6north_end.rpy:777
translate english highland_end_rib_6ee9d624:

    # makhal "Я никогда не оскорблю наших предков, не будь я Макхал из клана Железных Поясов."
    makhal "我绝不会侮辱我们的祖先，否则我就不配称为铁腰带部族的Makhal。"

# game/a14/6north_end.rpy:778
translate english highland_end_rib_6570b4a1:

    # makhal "Но не думай, что я забуду все, что сделал лорд Скаладан. Мы отомстим."
    makhal "但别以为我会忘记Scaladan领主所做的一切。我们会复仇。"

# game/a14/6north_end.rpy:779
translate english highland_end_rib_63f2f28b:

    # makhal "Но не сейчас. Ибо традиция велит мне исполнить волю победителя. И я это сделаю."
    makhal "但不是现在。因为传统要求我执行胜利者的意愿。我会照做。"

# game/a14/6north_end.rpy:780
translate english highland_end_rib_63c2fb3d:

    # makhal "Я клянусь кровью. Своей и кровью своего клана. Свадьбы не будет. Мы отпустим лорда Войцеха."
    makhal "我以鲜血起誓。以我自己的血和我部族的血。婚礼不会举行。我们会释放Vojceh领主。"

# game/a14/6north_end.rpy:781
translate english highland_end_rib_02a0594e:

    # makhal "Корхалис будет отменен. Ваша земля - ваша. А наша - снова наша."
    makhal "科尔哈里斯将被废除。你们的土地归你们。我们的土地重新归我们。"

# game/a14/6north_end.rpy:782
translate english highland_end_rib_6afa77af:

    # makhal "Да будет так, принц [mename], из Золотой Империи."
    makhal "就这样吧，黄金帝国的王子[mename]。"

# game/a14/6north_end.rpy:783
translate english highland_end_rib_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a14/6north_end.rpy:784
translate english highland_end_rib_0be119e5:

    # makhal "Не благодари меня, благодари богов, что помогли тебе победить."
    makhal "不用谢我，去谢那些帮你获胜的神明吧。"

# game/a14/6north_end.rpy:785
translate english highland_end_rib_7ed45391:

    # makhal "Я уважаю их решение. И они это видят. Но не думай, что они вечно будут на твоей стороне."
    makhal "我尊重他们的决定。他们也看在眼里。但别以为他们会永远站在你这边。"

