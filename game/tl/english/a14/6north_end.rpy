translate english highland_end2_d47a1025:

    # aslan "Пф... все ленты ты бы не собрал."
    aslan "Pff... de todas formas no reunirías todas las cintas."

# game/a14/6north_end.rpy:446
translate english highland_end2_3820771a:

    # me "..."
    me "..."

# game/a14/6north_end.rpy:447
