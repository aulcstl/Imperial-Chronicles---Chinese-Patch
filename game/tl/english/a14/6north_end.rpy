# game/a14/6north_end.rpy:4
translate english highland_end_1fdb4425:

    # me "Не придуривайся. Ты шпионишь за мной для отца. Мне просто интересно, это вышло случайно или на реку он тоже подослал тебя специально?"
    me "No finjas. Estás espiando para mi padre. Solo me interesa saber si fue casualidad o si él también te envió al río a propósito."

# game/a14/6north_end.rpy:81
translate english highland_end_9c4002cb:

    # amina "Вроде в свой лагерь."
    amina "Parece que a su campamento."

# game/a14/6north_end.rpy:82
translate english highland_end_2c5b9de2:

    # makhal "Иди и найди его. Разузнай еще о пещерах. Мне нужно поговорить, найдешь меня у башни."
    makhal "Ve y encuéntralo. Averigua más sobre las cuevas. Necesito hablar, me encontrarás en la torre."

# game/a14/6north_end.rpy:206
translate english highland_end_lair_3c202b13:

    # me "Поосторожней с выражениями. Перед тобой принц Золотой Империи."
    me "Más cuidado con tus palabras. Estás ante el Príncipe del Imperio Dorado."

# game/a14/6north_end.rpy:236
translate english highland_end_lair_2f191337:

    # makhal "Не зря я вынес этому ублюдку вотум недоверия. Но ты так и не ответил."
    makhal "No en vano le hice un voto de censura a este bastardo. Pero aún no has respondido."

# game/a14/6north_end.rpy:265
translate english highland_end_lair_4e588324:

    # makhal "Это не Корхалис. Открой."
    makhal "Esto no es Corhalis. Ábrelo."

# game/a14/6north_end.rpy:291
translate english highland_end_lair_5f9b51da:

    # makhal "Жаль, но не выйдет. И да. Бери своих людей и выпездывайте из моих пещер к хуям, ясно?"
    makhal "Lástima, pero no funcionará. Y sí. Toma a tu gente y sal de mis cuevas ahora mismo, ¿entendido?"

# game/a14/6north_end.rpy:333
translate english highland_end_lair_ca40d212:

    # harold "600 серебряных северных марок."
    harold "600 marcos de plata del norte."

# game/a14/6north_end.rpy:340
translate english highland_end2_ad5efb6c:

    # "На следующий день."
    "Al día siguiente."

# game/a14/6north_end.rpy:341
translate english highland_end2_2b56ac22:

    # highlanders "{size=+4}Этой свинье больше не наливать!{/size}"
    highlanders "{size=+4}¡No le sirvan más a este cerdo!{/size}"

# game/a14/6north_end.rpy:342
translate english highland_end2_0a36e43f:

    # harold "Все готово, мой принц."
    harold "Todo está listo, mi príncipe."

# game/a14/6north_end.rpy:343
translate english highland_end2_c5ccc76e:

    # me "Отряд с запада готов?"
    me "¿El escuadrón del oeste está listo?"

# game/a14/6north_end.rpy:344
translate english highland_end2_426477fa:

    # harold "Прибыли вчера. Готовы биться."
    harold "Llegaron ayer. Listos para luchar."

# game/a14/6north_end.rpy:345
translate english highland_end2_3d312973:

    # me "Скаладан?"
    me "¿Scaladan?"

# game/a14/6north_end.rpy:346
translate english highland_end2_7b56878c:

    # highlanders "{size=+4}Эй! Я танцевать хочу!{/size}"
    highlanders "{size=+4}¡Oye! ¡Quiero bailar!{/size}"

# game/a14/6north_end.rpy:347
translate english highland_end2_71da150b:

    # harold "Рвется в бой. Говорит, что готовы действовать."
    harold "Está ansioso por luchar. Dice que están listos para actuar."

# game/a14/6north_end.rpy:348
translate english highland_end2_3a1a5db3:

    # me "Отправь гонца. Пусть переходят реку в полночь, если не дождутся нашего сигнала."
    me "Envía un mensajero. Que crucen el río a medianoche si no reciben nuestra señal."

# game/a14/6north_end.rpy:349
translate english highland_end2_9c099331:

    # harold "Так сегодня? Точно?"
    harold "¿Entonces es hoy? ¿Seguro?"

# game/a14/6north_end.rpy:350
translate english highland_end2_74fa1c22:

    # me "Да. Тянуть больше нельзя."
    me "Sí. No se puede retrasar más."

# game/a14/6north_end.rpy:351
translate english highland_end2_1a20604f:

    # highlanders "{size=+4}Я первый буду с ней танцевать!{/size}"
    highlanders "{size=+4}¡Yo seré el primero en bailar con ella!{/size}"

# game/a14/6north_end.rpy:353
translate english highland_end2_482b851c:

    # harold "Что с Войцехом?"
    harold "¿Qué hay de Vojceh?"

# game/a14/6north_end.rpy:354
translate english highland_end2_ca80b081:

    # me "Я с ним поговорил. Ты готов?"
    me "Hablé con él. ¿Estás listo?"

# game/a14/6north_end.rpy:355
translate english highland_end2_ec6c4e5d:

    # wojceh "Я готов."
    wojceh "Estoy listo."

# game/a14/6north_end.rpy:356
translate english highland_end2_7e728f30:

    # me "Он твоя зона ответственности, Гарольд."
    me "Él es tu responsabilidad, Harold."

# game/a14/6north_end.rpy:357
translate english highland_end2_cad701fd:

    # harold "Да, мой принц."
    harold "Sí, mi príncipe."

# game/a14/6north_end.rpy:358
translate english highland_end2_e00cbb41:

    # highlanders "{size=+4}Ая! Смотри как танцуют!{/size}"
    highlanders "{size=+4}¡Aya! ¡Mira cómo bailan!{/size}"

# game/a14/6north_end.rpy:359
translate english highland_end2_daf3a385:

    # harold "А что с остальными?"
    harold "¿Y qué hay de los demás?"

# game/a14/6north_end.rpy:360
translate english highland_end2_1929d0e4:

    # me "С кем?"
    me "¿Quiénes?"

# game/a14/6north_end.rpy:361
translate english highland_end2_7d2c6c0d:

    # harold "Ну... женщины и дети?"
    harold "Bueno... mujeres y niños?"

# game/a14/6north_end.rpy:362
translate english highland_end2_b8fe4b98:

    # me "Не трогайте безоружных. Берите в плен. Но если они..."
    me "No toquen a los desarmados. Tómenlos prisioneros. Pero si ellos..."

# game/a14/6north_end.rpy:363
translate english highland_end2_357fa4b6:

    # harold "Я понял, мой принц."
    harold "Entendí, mi príncipe."

# game/a14/6north_end.rpy:364
translate english highland_end2_df3f7f22:

    # highlanders "{size=+4}Я следующий с ней танцую!{/size}"
    highlanders "{size=+4}¡Yo bailaré después de él con ella!{/size}"

# game/a14/6north_end.rpy:366
translate english highland_end2_b3ea584e:

    # highlanders "{size=+4}За свободу! За Высокую Страну!{/size}"
    highlanders "{size=+4}¡Por la libertad! ¡Por la Tierra Alta!{/size}"

# game/a14/6north_end.rpy:367
translate english highland_end2_d6b75e47:

    # harold "А что делать с Макхалом?"
    harold "¿Y qué hacemos con Makhal?"

# game/a14/6north_end.rpy:368
translate english highland_end2_149b3064:

    # me "В каком смысле?"
    me "¿En qué sentido?"

# game/a14/6north_end.rpy:369
translate english highland_end2_6980fe25:

    # harold "Его нам брать в плен?"
    harold "¿Lo tomamos prisionero, hermano?"

# game/a14/6north_end.rpy:370
translate english highland_end2_d4a779b5:

    # me "По возможности. Он и его семья в приоритете. Но рисковать жизнями не стоит. Если будет он и его сыновья будут представлять угрозу..."
    me "Si es posible. Él y su familia son la prioridad. Pero no vale la pena arriesgar vidas. Si él y sus hijos representan una amenaza..."

# game/a14/6north_end.rpy:371
translate english highland_end2_3849c8a3:

    # highlanders "{size=+4}Несите еще молока и спирта!{/size}"
    highlanders "{size=+4}¡Traigan más leche y alcohol!{/size}"

# game/a14/6north_end.rpy:372
translate english highland_end2_357fa4b6_1:

    # harold "Я понял, мой принц."
    harold "Entendí, mi príncipe."

# game/a14/6north_end.rpy:373
translate english highland_end2_9957fecc:

    # me "Главное не дайте им уйти. Они нужны нам или живыми или мертвыми."
    me "Lo principal es no dejarlos escapar. Los necesitamos vivos o muertos."

# game/a14/6north_end.rpy:374
translate english highland_end2_327d0af6:

    # harold "А что с остальными горцами? Если те попытаются сбежать?"
    harold "¿Y qué hay de los otros montañeses? ¿Si intentan huir?"

# game/a14/6north_end.rpy:375
translate english highland_end2_6d1419eb:

    # me "Это демонстративная порка. Пусть бегут. Пусть бегут и расскажут."
    me "Esto es un castigo ejemplar. Que huyan. Que huyan y lo cuenten."

# game/a14/6north_end.rpy:376
translate english highland_end2_904b89b2:

    # highlanders "{size=+4}Еще по одной!{/size}"
    highlanders "{size=+4}¡Una más!{/size}"

# game/a14/6north_end.rpy:378
translate english highland_end2_cca162ce:

    # harold "Возможно остальные кланы захотят отомстить."
    harold "Es posible que los otros clanes quieran vengarse."

# game/a14/6north_end.rpy:379
translate english highland_end2_17e6ab57:

    # me "А это уже не наша проблема. Я пытался решить все мирно."
    me "Eso ya no es problema nuestro. Intenté resolverlo todo pacíficamente."

# game/a14/6north_end.rpy:380
translate english highland_end2_20f6fa62:

    # harold "Верно."
    harold "Cierto."

# game/a14/6north_end.rpy:381
translate english highland_end2_bf10d3d0:

    # me "Мы делаем что от нас требуется и уходим. Все что будет дальше - это уже головная боль для лорда Скаладана."
    me "Hacemos lo que se nos exige y nos vamos. Todo lo que pase después será dolor de cabeza para el Lord Scaladan."

# game/a14/6north_end.rpy:382
translate english highland_end2_38f65a91:

    # highlanders "{size=+4}Несите пирог!{/size}"
    highlanders "{size=+4}¡Traigan el pastel!{/size}"

# game/a14/6north_end.rpy:383
translate english highland_end2_eb8bbfe3:

    # harold "Хорошо. Тогда мы начнем по вашей команде, мой принц."
    harold "Bien. Entonces comenzaremos a su orden, mi príncipe."

# game/a14/6north_end.rpy:384
translate english highland_end2_d1fc4593:

    # me "Отлично. Дайте горцам вдоволь напиться и начнем."
    me "Excelente. Dejen que los montañeses beban a gusto y empecemos."

# game/a14/6north_end.rpy:385
translate english highland_end2_1e8a2595:

    # harold "С этим они хорошо справляются. Но вот вы бы лучше не пили."
    harold "Ellos se encargan bien de eso. Pero sería mejor que usted no bebiera."

# game/a14/6north_end.rpy:386
translate english highland_end2_d3c81626:

    # me "Расслабся. Это по большей части вода. Не хочу, чтобы наши друзья увидели, что я не пью и занервничали."
    me "Relájate. Esto es principalmente agua. No quiero que nuestros amigos vean que no bebo y se pongan nerviosos."

# game/a14/6north_end.rpy:387
translate english highland_end2_9ac62fdd:

    # highlanders "{size=+4}Аслан идет!{/size}"
    highlanders "{size=+4}¡Ahí viene Aslan!{/size}"

# game/a14/6north_end.rpy:389
translate english highland_end2_9e1c0a1f:

    # aslan "Ты выиграл метание топоров?"
    aslan "¿Ganaste el lanzamiento de hachas?"

# game/a14/6north_end.rpy:390
translate english highland_end2_ed4b1370:

    # highlander "А?"
    highlander "¿Eh?"

# game/a14/6north_end.rpy:391
translate english highland_end2_2db35d6c:

    # aslan "У тебя лента?"
    aslan "¿Tienes una cinta?"

# game/a14/6north_end.rpy:392
translate english highland_end2_6ec62c05:

    # highlander "Ну да..."
    highlander "Bueno, sí..."

# game/a14/6north_end.rpy:393
translate english highland_end2_eee5cb1f:

    # aslan "Ну тогда ты знаешь о чем я попрошу."
    aslan "Entonces sabes lo que te voy a pedir."

# game/a14/6north_end.rpy:394
translate english highland_end2_e2c56ad5:

    # highlander "Кхем..."
    highlander "Ejem..."

# game/a14/6north_end.rpy:395
translate english highland_end2_de58ec27:

    # aslan "Ну если хочешь - можем и подраться."
    aslan "Bueno, si quieres, podemos pelear."

# game/a14/6north_end.rpy:396
translate english highland_end2_6b333681:

    # highlander "..."
    highlander "..."

# game/a14/6north_end.rpy:397
translate english highland_end2_e3203001:

    # aslan "Или отдавай ее добровольно."
    aslan "O entrégala voluntariamente."

# game/a14/6north_end.rpy:398
translate english highland_end2_be9501cc:

    # highlander "Нет... Пойдем драться."
    highlander "No... Vamos a pelear."

# game/a14/6north_end.rpy:400
translate english highland_end2_2094ae1d:

    # krastan "Как дела?"
    krastan "¿Cómo estás?"

# game/a14/6north_end.rpy:401
translate english highland_end2_e7ce88cd:

    # me "Нормально."
    me "Normal."

# game/a14/6north_end.rpy:402
translate english highland_end2_ec1463eb:

    # krastan "Видел? У него ни шанса. Но сдаваться публично... такое себе ни один приличный горец позволить не может."
    krastan "¿Viste? No tuvo ni una oportunidad. Pero rendirse en público... eso ningún montañés decente puede permitírselo."

# game/a14/6north_end.rpy:403
translate english highland_end2_4a752315:

    # me "И кто победит?"
    me "¿Y quién ganará?"

# game/a14/6north_end.rpy:404
translate english highland_end2_7eea3a4c:

    # krastan "Ну а ты как думаешь?"
    krastan "Bueno, ¿tú qué crees?"

# game/a14/6north_end.rpy:405
translate english highland_end2_1b813c78:

    # me "Думаю твой брат."
    me "Creo que tu 哥哥."

# game/a14/6north_end.rpy:406
translate english highland_end2_a1715cfc:

    # krastan "Правильно думаешь."
    krastan "Piensas correctamente."

# game/a14/6north_end.rpy:407
translate english highland_end2_fdf9abee:

    # me "Знаешь, вы как-то не слишком похожи."
    me "Sabes, ustedes no se parecen mucho."

# game/a14/6north_end.rpy:408
translate english highland_end2_127a9edc:

    # krastan "У нас разные матери. Свою он убил при рождении. Порвал ее так, что она умерла прежде чем он полностью из нее вылез."
    krastan "Tenemos madres diferentes. Él mató a la suya al nacer. La desgarró tanto que murió antes de que él saliera por completo."

# game/a14/6north_end.rpy:409
translate english highland_end2_a1f81d3a:

    # me "Так он твой старший брат?"
    me "¿Así que él es tu 哥哥 mayor?"

# game/a14/6north_end.rpy:410
translate english highland_end2_92cbd13b:

    # krastan "Вроде того."
    krastan "Algo así."

# game/a14/6north_end.rpy:411
translate english highland_end2_759f2a5c:

    # me "Полагаю я знаю, кто станет следующим вождем."
    me "Supongo que sé quién será el próximo jefe."

# game/a14/6north_end.rpy:412
translate english highland_end2_8d9bf81c:

    # krastan "Неправильно полагаешь. У нас не как у вас, южанин."
    krastan "Supones incorrectamente. No es como en el sur, sureño."

# game/a14/6north_end.rpy:413
translate english highland_end2_3e92deae:

    # me "Наследует не старший?"
    me "¿No hereda el mayor?"

# game/a14/6north_end.rpy:414
translate english highland_end2_aecd4d01:

    # krastan "Наследует тот, кого выбрал вождь и кого одобрили старейшины. Все, чтобы избежать недостойного наследника. Вам такое незнакомо."
    krastan "Hereda aquel a quien el jefe eligió y los ancianos aprobaron. Todo para evitar un heredero indigno. Eso no lo conocen ustedes."

# game/a14/6north_end.rpy:415
translate english highland_end2_c162bea6:

    # me "Очень мудро. И какие у тебя шансы?"
    me "Muy sabio. ¿Y qué posibilidades tienes?"

# game/a14/6north_end.rpy:416
translate english highland_end2_e381ba49:

    # krastan "Не очень большие. Но собираюсь попросить отца объявить меня наследником."
    krastan "No muy altas. Pero voy a pedirle a mi padre que me declare heredero."

# game/a14/6north_end.rpy:417
translate english highland_end2_34ab5191:

    # me "Вот так просто?"
    me "¿Así de simple?"

# game/a14/6north_end.rpy:419
translate english highland_end2_f613d301:

    # krastan "Не так уж и просто. Для начала мне нужны все ленты."
    krastan "No es tan simple. Para empezar, necesito todas las cintas."

# game/a14/6north_end.rpy:420
translate english highland_end2_877d3d95:

    # me "С лентами можно попросить и об этом?"
    me "¿Con las cintas se puede pedir eso también?"

# game/a14/6north_end.rpy:421
