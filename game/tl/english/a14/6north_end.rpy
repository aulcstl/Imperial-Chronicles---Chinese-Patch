    # me "Это они настояли на встрече?"
    me "是他们坚持要见面的？"

# game/a14/6north_end.rpy:178
translate english highland_end_lair_e860c2c5:

    # harold "Аж шесть человек просило вашего присутствия."
    harold "有六个人请求您出席。"

# game/a14/6north_end.rpy:179
translate english highland_end_lair_71d3b8c8:

    # me "Хорошо."
    me "好。"

# game/a14/6north_end.rpy:180
translate english highland_end_lair_989b005c:

    # harold "Все идет как надо?"
    harold "一切顺利吗？"

# game/a14/6north_end.rpy:181
translate english highland_end_lair_0cf6b154:

    # me "Прости. Не могу делиться деталями."
    me "抱歉。不能透露细节。"

# game/a14/6north_end.rpy:182
translate english highland_end_lair_a2ae029e:

    # harold "Понимаю. Он нас что-нибудь требуется?"
    harold "明白。您需要我们做什么吗？"

# game/a14/6north_end.rpy:183
translate english highland_end_lair_e23058f1:

    # me "Ничего. Просто стойте и молчите. Копируйте мои эмоции."
    me "不用。就站着别说话。学我的表情。"

# game/a14/6north_end.rpy:184
translate english highland_end_lair_e6188c61:

    # harold "М?"
    harold "嗯？"

# game/a14/6north_end.rpy:185
translate english highland_end_lair_5830102a:

    # me "Если я довольно ухмыляюсь - довольно ухмыляйтесь. Если раздосадован - делаете недовольные и кислые лица."
    me "要是我得意地笑，你们也跟着得意地笑。要是我烦躁，你们就摆出不满和苦脸。"

# game/a14/6north_end.rpy:186
translate english highland_end_lair_b27d3d23:

    # harold "Понял."
    harold "懂了。"

# game/a14/6north_end.rpy:188
translate english highland_end_lair_1e3a81b6:

    # me "Все. Идут. Пора."
    me "来了。他们到了。该上了。"

# game/a14/6north_end.rpy:189
translate english highland_end_lair_cad701fd:

    # harold "Да, мой принц."
    harold "是，我的王子。"

# game/a14/6north_end.rpy:190
translate english highland_end_lair_1e4f97d1:

    # makhal "Давай быстрее."
    makhal "快点。"

# game/a14/6north_end.rpy:191
translate english highland_end_lair_0da4a71a:

    # wojceh "У меня голова болит."
    wojceh "我头疼。"

# game/a14/6north_end.rpy:192
translate english highland_end_lair_9e29655e:

    # makhal "Не нужно было столько пить."
    makhal "谁让你喝那么多。"

# game/a14/6north_end.rpy:193
translate english highland_end_lair_f8ee8fc3:

    # me "У него праздник. Он же жених. Ему можно."
    me "他这是过节嘛。他是新郎。他可以喝。"

# game/a14/6north_end.rpy:194
translate english highland_end_lair_3e42419f:

    # makhal "Это не надолго."
    makhal "这不会太久。"

# game/a14/6north_end.rpy:195
translate english highland_end_lair_cd0173b8:

    # me "Ну да. От свадьбы всего один денек то и остался."
    me "是啊。婚礼也就剩一天了。"

# game/a14/6north_end.rpy:196
translate english highland_end_lair_730d0ad6:

    # makhal "Садись."
    makhal "坐。"

# game/a14/6north_end.rpy:197
translate english highland_end_lair_ad118766:

    # wojceh "Здесь?"
    wojceh "这儿？"

# game/a14/6north_end.rpy:198
translate english highland_end_lair_769c68f1:

    # makhal "Где хочешь."
    makhal "随你便。"

# game/a14/6north_end.rpy:199
translate english highland_end_lair_3d8377cc:

    # me "Вы как хотите, а я выпью."
    me "你们随意，我可要喝一杯。"

# game/a14/6north_end.rpy:201
translate english highland_end_lair_c01f5a58:

    # makhal "Стой. Мы здесь не чтобы вино пить."
    makhal "等等。我们不是来喝酒的。"

# game/a14/6north_end.rpy:202
translate english highland_end_lair_810f39c8:

    # me "А зачем?"
    me "那是来干嘛的？"

# game/a14/6north_end.rpy:203
translate english highland_end_lair_5ca0485f:

    # makhal "Ты знаешь зачем."
    makhal "你知道是来干嘛的。"

# game/a14/6north_end.rpy:204
translate english highland_end_lair_4a3f9100:

    # me "Понятия не имею. Какая-то особая свадебная традиция?"
    me "完全不知道。是什么特别的婚礼习俗吗？"

# game/a14/6north_end.rpy:205
translate english highland_end_lair_38c40836:

    # makhal "Не строй из себя идиота."
    makhal "别装傻。"

# game/a14/6north_end.rpy:206
translate english highland_end_lair_2d88f3c0:

    # me "Поострожней с выражениями. Перед тобой принц Золотой Империи."
    me "说话注意点。你面前的是黄金帝国的王子。"

# game/a14/6north_end.rpy:207
translate english highland_end_lair_1a6f3d46:

    # makhal "А здесь не Золотая Империя."
    makhal "这儿可不是黄金帝国。"

# game/a14/6north_end.rpy:208
translate english highland_end_lair_82360348:

    # me "Да? Как-то так вышло, что я еще и временно исполняющий обязанности хозяина Холодного Конца. Так что ты сейчас на моей земле."
    me "是吗？碰巧我还是冷港的代理主人呢。所以你现在站在我的土地上。"

# game/a14/6north_end.rpy:209
translate english highland_end_lair_c2cddf7e:

    # makhal "Так это правда."
    makhal "这么说，是真的了。"

# game/a14/6north_end.rpy:211
translate english highland_end_lair_a8f35c79:

    # me "Ну... у лорда Войцеха ведь нет детей."
    me "嗯……Vojceh领主不是没孩子嘛。"

# game/a14/6north_end.rpy:212
translate english highland_end_lair_0695721b:

    # wojceh "Ага."
    wojceh "嗯。"

# game/a14/6north_end.rpy:213
translate english highland_end_lair_63f76a87:

    # makhal "И родственников видимо тоже."
    makhal "看来也没亲戚。"

# game/a14/6north_end.rpy:214
translate english highland_end_lair_a7c132a4:

    # me "Ну... Главное, что прямых наследников нет."
    me "嗯……关键是没直系继承人。"

# game/a14/6north_end.rpy:215
translate english highland_end_lair_9432efac:

    # wojceh "Да. Совсем один. Такой вот я одиночка по жизни."
    wojceh "对。孤零零一个人。我这辈子就是个独行者。"

# game/a14/6north_end.rpy:216
translate english highland_end_lair_48920162:

    # me "Но я рад, что скоро это исправится."
    me "但我很高兴，很快就要改变了。"

# game/a14/6north_end.rpy:217
translate english highland_end_lair_611c7a4d:

    # wojceh "Я тоже этому очень рад."
    wojceh "我也很高兴。"

# game/a14/6north_end.rpy:218
translate english highland_end_lair_f6c7ca59:

    # makhal "И кто сделал тебя лордом?"
    makhal "是谁让你当领主的？"

# game/a14/6north_end.rpy:219
translate english highland_end_lair_58b518bb:

    # me "Пришло разрешение от Короля Севера. И не лордом. Временным лордом. Как только лорд Войцех вернется с Высокой Страны с наследником, я сразу же верну ему его замок."
    me "北方国王的许可到了。不是正式的领主，是代理领主。等Vojceh领主带着继承人从高地回来，我立刻把城堡还给他。"

# game/a14/6north_end.rpy:220
translate english highland_end_lair_ccf002c2:

    # me "И не просто верну, а с подарками."
    me "而且不止是归还，还会带上礼物。"

# game/a14/6north_end.rpy:221
translate english highland_end_lair_b3d02023:

    # wojceh "Ох.. жду не дождусь."
    wojceh "哦……我可真等不及了。"

# game/a14/6north_end.rpy:222
translate english highland_end_lair_fff3c6fe:

    # makhal "Заебешься ждать."
    makhal "等着去吧。"

# game/a14/6north_end.rpy:223
translate english highland_end_lair_8d1bddc6:

    # me "К чему эта грубость?"
    me "何必这么粗鲁？"

# game/a14/6north_end.rpy:224
translate english highland_end_lair_140f8d7d:

    # wojceh "Тоже не пойму. Свадьба. Все должны быть счастливы."
    wojceh "我也搞不懂。婚礼嘛。大家都该高高兴兴的。"

# game/a14/6north_end.rpy:225
translate english highland_end_lair_5413ed33:

    # makhal "Ага."
    makhal "对。"

# game/a14/6north_end.rpy:227
translate english highland_end_lair_9aa51cd2:

    # makhal "Что твои люди забыли в наших пещерах?"
    makhal "你的人在我们的山洞里干什么？"

# game/a14/6north_end.rpy:228
translate english highland_end_lair_6af6cba6:

    # me "В ваших? Они уже не ваши."
    me "你们的？已经不是你们的了。"

# game/a14/6north_end.rpy:229
translate english highland_end_lair_4015f8ac:

    # makhal "Твои видимо."
    makhal "那就是你的了。"

# game/a14/6north_end.rpy:230
translate english highland_end_lair_29d17a05:

    # me "Ну да. Я же теперь лорд Холодного Конца."
    me "嗯。我现在可是冷港的领主了。"

# game/a14/6north_end.rpy:231
translate english highland_end_lair_e96329e0:

    # makhal "Пока еще тут есть настоящий лорд."
    makhal "这儿还有一个真正的领主在呢。"

# game/a14/6north_end.rpy:232
translate english highland_end_lair_2119937a:

    # me "Пока что. И пока он здесь, он разрешает мне распоряжаться его землей. Верно?"
    me "暂时是。但只要他在这儿，他就允许我支配他的土地。对吧？"

# game/a14/6north_end.rpy:233
translate english highland_end_lair_df7278e3:

    # wojceh "Верно."
    wojceh "对。"

# game/a14/6north_end.rpy:234
translate english highland_end_lair_e4f6e42c:

    # makhal "Заткнись. Это наша земля."
    makhal "闭嘴。那是我们的地。"

# game/a14/6north_end.rpy:235
translate english highland_end_lair_d23736fc:

    # me "Нет. Корхалис. Публичный. Все слышали об этом. Я отправил письмо Королю Севера."
    me "不。科尔哈里斯。公开的。所有人都听见了。我已经给北方国王送了信。"

# game/a14/6north_end.rpy:236
translate english highland_end_lair_156582b2:

    # makhal "Ты так не ответил."
    makhal "你还没回答我。"

# game/a14/6north_end.rpy:237
translate english highland_end_lair_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a14/6north_end.rpy:238
translate english highland_end_lair_73d49d77:

    # makhal "Что твои люди делают в пещерах и почему не пускают туда моих людей?"
    makhal "你的人在洞里干什么，为什么不让我的人进去？"

# game/a14/6north_end.rpy:239
translate english highland_end_lair_2de10dec:

    # me "А это наши пещеры. Какая вам разница, что мы в них делаем?"
    me "那是我们的山洞了。我们在里面干什么关你什么事？"

# game/a14/6north_end.rpy:240
translate english highland_end_lair_8d2814d1:

    # makhal "Пять сотен людей защищает пустые пещеры, да?"
    makhal "五百个人守着一堆空山洞，是吗？"

# game/a14/6north_end.rpy:241
translate english highland_end_lair_a1c8c532:

    # me "Там грибы вкусные. Не хотим делиться."
    me "那儿长着好吃的蘑菇。不想分给你。"

# game/a14/6north_end.rpy:242
translate english highland_end_lair_bacec05e:

    # makhal "Грибы, да..."
    makhal "蘑菇，是吧……"

# game/a14/6north_end.rpy:243
translate english highland_end_lair_ae898471:

    # me "Ага. Плодородная почва. Как раз под Корхалис."
    me "嗯。肥沃的土地。正适合科尔哈里斯。"

# game/a14/6north_end.rpy:245
translate english highland_end_lair_0141aa2d:

    # makhal "Убирайтесь оттуда."
    makhal "从那儿滚出去。"

# game/a14/6north_end.rpy:246
translate english highland_end_lair_72dc3987:

    # me "Нет. Это вы убирайтесь оттуда."
    me "不。该滚的是你们。"

# game/a14/6north_end.rpy:247
translate english highland_end_lair_94227cde:

    # makhal "Я призову клану."
    makhal "我会召集部族。"

# game/a14/6north_end.rpy:248
translate english highland_end_lair_334916a6:

    # me "Попробуй, ублюдок. У меня тысяча свидетелей, что это твоя идея."
    me "你试试看，杂种。我有一千个证人，证明这是你的主意。"

# game/a14/6north_end.rpy:249
translate english highland_end_lair_ea5c93b2:

    # makhal "Ты думаешь, что ты самый умный?"
    makhal "你以为你最聪明？"

# game/a14/6north_end.rpy:250
translate english highland_end_lair_de012637:

    # me "Я думаю, что ты слишком хитрый, но это сыграло с тобой злую шутку."
    me "我觉得你太狡猾了，但这回可害了你自己。"

# game/a14/6north_end.rpy:251
translate english highland_end_lair_e8ffa52a:

    # makhal "Да ну."
    makhal "是吗。"

# game/a14/6north_end.rpy:252
translate english highland_end_lair_a89ce91e:

    # me "Ага. Не подходи к моим пещерам. Отныне все, кто к ним приблизятся без моего ведома - подохнут, ясно?"
    me "对。别靠近我的山洞。从今以后，任何没经我允许靠近的人——都得死，明白吗？"

# game/a14/6north_end.rpy:253
translate english highland_end_lair_7a2070a9:

    # makhal "Тогда и ты убирайся. Это земля наша по Корхалису."
    makhal "那你给我滚。按科尔哈里斯，这片地是我们的。"

# game/a14/6north_end.rpy:254
translate english highland_end_lair_26dfc26a:

    # me "Ты сам меня сюда пригласил. Но как скажешь. Не смею задерживаться."
    me "是你自己请我来的。不过随你便。我不打扰了。"

# game/a14/6north_end.rpy:255
translate english highland_end_lair_6107fa6d:

    # makhal "..."
    makhal "……"

# game/a14/6north_end.rpy:257
translate english highland_end_lair_e39e72c8:

    # makhal "Стоять. Сначала прочти это."
    makhal "站住。先看看这个。"

# game/a14/6north_end.rpy:258
translate english highland_end_lair_40e3a1ae:

    # me "Что это за дрянь?"
    me "这破玩意儿是什么？"

# game/a14/6north_end.rpy:259
translate english highland_end_lair_d1a1664a:

    # makhal "Документ. Копия."
    makhal "文件。副本。"

# game/a14/6north_end.rpy:260
translate english highland_end_lair_bd65fe1a:

    # me "Что еще за документ?"
    me "什么文件？"

# game/a14/6north_end.rpy:261
translate english highland_end_lair_b6219dfe:

    # makhal "Открой и посмотри."
    makhal "打开看看。"

# game/a14/6north_end.rpy:262
translate english highland_end_lair_d4abaf33:

    # me "Подписанный Корхалис менять нельзя. Я засвидетельствовал твои условия, это слышали мои люди, твои люди и даже парочку бедолаг, которых я пригнал с Нарграда."
    me "签好的科尔哈里斯不能改。我把你的条件记录在案了，我的人、你的人，甚至还有我从纳格拉德拉来的几个可怜虫都听见了。"

# game/a14/6north_end.rpy:263
translate english highland_end_lair_5e4279eb:

    # makhal "А ты подготовился."
    makhal "你倒是准备充分。"

# game/a14/6north_end.rpy:264
translate english highland_end_lair_ac88bccb:

    # me "Еще бы."
    me "当然。"

# game/a14/6north_end.rpy:265
translate english highland_end_lair_ac0370cd:

    # makhal "Это не Корхалис. Отрой."
    makhal "这不是科尔哈里斯。打开。"

# game/a14/6north_end.rpy:267
translate english highland_end_lair_01afca6f:

    # me "...этим свидетельствую что..."
    me "……兹此证明……"

# game/a14/6north_end.rpy:268
translate english highland_end_lair_3ea304d1:

    # makhal "Ну?"
    makhal "嗯？"

# game/a14/6north_end.rpy:269
translate english highland_end_lair_df4d2f13:

    # me "Погоди..."
    me "等等……"

# game/a14/6north_end.rpy:270
translate english highland_end_lair_ce4e0695:

    # makhal "Читай-читай."
    makhal "念啊念啊。"

# game/a14/6north_end.rpy:271
translate english highland_end_lair_0328ae9c:

    # me "...граница будет проложена по Рубиновому ущелью..."
    me "……边界将沿红宝石峡谷划定……"

# game/a14/6north_end.rpy:272
translate english highland_end_lair_1329a4d0:

    # makhal "И?"
    makhal "然后？"

# game/a14/6north_end.rpy:273
translate english highland_end_lair_51c2c17c:

    # me "Что это?"
    me "这是什么？"

# game/a14/6north_end.rpy:274
translate english highland_end_lair_b95fe688:

    # makhal "Договор. О границах. Пещеры часть гор."
    makhal "边界条约。山洞属于山脉的一部分。"

# game/a14/6north_end.rpy:275
translate english highland_end_lair_da29fcdf:

    # me "И что? Плодородной землей меняться можно. Ты был прав, там и вправду растут грибы. Так что..."
    me "那又怎样？肥沃土地是可以交换的。你说得对，那儿确实长蘑菇。所以……"

# game/a14/6north_end.rpy:276
translate english highland_end_lair_5c81ac98:

    # makhal "При чем тут это. Эти пещеры и горы - часть земель клана железных поясов."
    makhal "这跟那有什么关系。这些山洞和山脉是铁腰带部族领地的一部分。"

# game/a14/6north_end.rpy:277
translate english highland_end_lair_5c6a6519:

    # me "И что с того? Корхалис..."
    me "那又怎样？科尔哈里斯……"

# game/a14/6north_end.rpy:278
translate english highland_end_lair_2f57098a:

    # makhal "Корхалис это часть свадьбы, а свадьбы не будет."
    makhal "科尔哈里斯是婚礼的一部分，而婚礼不会有了。"

# game/a14/6north_end.rpy:279
translate english highland_end_lair_ad02f53a:

    # me "Что?"
    me "什么？"

# game/a14/6north_end.rpy:281
translate english highland_end_lair_88602b29:

    # makhal "Что слышал. Прощай."
    makhal "你听见了。再见。"

# game/a14/6north_end.rpy:282
translate english highland_end_lair_4c836dc7:

    # me "Стоять! Как это не будет? Свадьба уже состоялась! Были клятвы!"
    me "站住！什么叫不会有了？婚礼已经举行了！誓言已经立了！"

# game/a14/6north_end.rpy:283
translate english highland_end_lair_2235865d:

    # makhal "А это не важно. Невесты больше нет. Не с кем консумировать и подтвердить брак!"
    makhal "那不重要。新娘不在了。没人可以圆房来确认婚姻了！"

# game/a14/6north_end.rpy:284
translate english highland_end_lair_71e35a2f:

    # me "Как это? Где она?"
    me "什么意思？她在哪儿？"

# game/a14/6north_end.rpy:285
translate english highland_end_lair_e3e63f9c:

    # makhal "Пропала."
    makhal "不见了。"

# game/a14/6north_end.rpy:286
translate english highland_end_lair_9cd7cbc8:

    # me "Пропала?"
    me "不见了？"

# game/a14/6north_end.rpy:287
translate english highland_end_lair_f192ef46:

    # makhal "Ага. К сожалению свадьбу придется отменить."
    makhal "对。很遗憾，婚礼只能取消了。"

# game/a14/6north_end.rpy:288
translate english highland_end_lair_af3e24e8:

    # me "Ты ее спрятал."
    me "是你把她藏起来了。"

# game/a14/6north_end.rpy:289
translate english highland_end_lair_4ca9acd9:

    # makhal "Понятия не имею о чем ты!"
    makhal "我完全不知道你在说什么！"

# game/a14/6north_end.rpy:290
translate english highland_end_lair_ae0783fe:

    # me "Сукин ты сын! Верни Алию! Свадьба должна состояться!"
    me "你个儿子养的！把阿莉亚还回来！婚礼必须举行！"

# game/a14/6north_end.rpy:291
translate english highland_end_lair_f0c15472:

    # makhal "Жаль, но не выйдет. И да. Бери своих людей и выпездывайте из поих пещер у хуям, ясно?"
    makhal "遗憾，但不行了。还有。带上你的人，从我的山洞里滚出去，明白吗？"

# game/a14/6north_end.rpy:292
translate english highland_end_lair_89bea5c9:

    # me "Это мои пещеры!"
    me "那是我的山洞！"

# game/a14/6north_end.rpy:293
translate english highland_end_lair_be1ad805:

    # makhal "Больше нет. Войцех остается."
    makhal "不再是了。Vojceh留下。"

# game/a14/6north_end.rpy:294
translate english highland_end_lair_70fdf432:

    # me "Нет. Забирай его! Свадьба состоялась!"
    me "不。你带走他！婚礼举行了！"

# game/a14/6north_end.rpy:295
translate english highland_end_lair_dbefa6e1:

    # makhal "Не состоялась. Сам забирай этого ублюдка. И да, если твои люди не покинут мои пещеры за три дня, нет... за два дня. То через неделю там будут все двадцать семь кланов, ясно?"
    makhal "没举行。你自己带走那杂种。还有，要是你的人在三天内……不，两天内不离开我的山洞，那一周后二十七个部族都会出现在那儿，明白吗？"

# game/a14/6north_end.rpy:296
translate english highland_end_lair_bc5b957f:

    # me "Ты не посмеешь! Я все им расскажу!"
    me "你不敢！我会告诉他们一切！"

# game/a14/6north_end.rpy:297
translate english highland_end_lair_38429d48:

    # makhal "Что расскажешь? Что мы защищаем нашу землю? Нашу по договору?"
    makhal "告诉他们什么？说我们在保卫我们的土地？按条约属于我们的土地？"

# game/a14/6north_end.rpy:298
translate english highland_end_lair_5703405b:

    # me "Свадьба!"
    me "婚礼！"

# game/a14/6north_end.rpy:299
translate english highland_end_lair_7b8b8474:

    # makhal "Свадьбы не было. Прощай, принц. Или лучше сказать - принц-дурак?"
    makhal "没有婚礼。再见了，王子。还是说——傻王子？"

# game/a14/6north_end.rpy:301
translate english highland_end_lair_3eceb320:

    # me "Ублюдок!"
    me "杂种！"

# game/a14/6north_end.rpy:302
translate english highland_end_lair_3820771a:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:303
translate english highland_end_lair_3d0b6cfd:

    # harold "Ушли."
    harold "走了。"

# game/a14/6north_end.rpy:304
translate english highland_end_lair_c8085554:

    # wojceh "Это что блядь было?"
    wojceh "这他妈算什么？"

# game/a14/6north_end.rpy:305
translate english highland_end_lair_36f40ef8:

    # me "Поражение. Сладкое поражение. Они нас переиграли."
    me "失败。甜蜜的失败。他们把我们耍了。"

# game/a14/6north_end.rpy:306
translate english highland_end_lair_48f03d8f:

    # wojceh "Но как он поверил?"
    wojceh "但他怎么就信了？"

# game/a14/6north_end.rpy:307
translate english highland_end_lair_a3ef6fbf:

