# game/a14/6north_end.rpy:249
translate english highland_end_lair_32d28975:

    # makhal "Я призову кланы."
    makhal "我会召集部族。"

# game/a14/6north_end.rpy:390
translate english highland_end2_3944dc2b:

    # me "Расслабься. Это по большей части вода. Не хочу, чтобы наши друзья увидели, что я не пью и занервничали."
    me "别担心。大部分是水。我可不想让我们的朋友们看到我不喝酒而紧张起来。"

# game/a14/6north_end.rpy:465
translate english highland_end_rib_9863c30f:

    # aslan "О. Это славно! Хотел разбить твое лицо с того дня, как впервые тебя увидел."
    aslan "哦。太好了！从我第一次见到你那天起，我就想揍烂你的脸。"

# game/a14/6north_end.rpy:551
translate english highland_end_rib_d6d4cf2f:

    # amina "Выползай из-под него!"
    amina "从他身下爬出来！"

# game/a14/6north_end.rpy:641
translate english highland_end_rib_05f5adec:

    # krastan "Прости, малышка, но мне нужны все."
    krastan "抱歉，小丫头，但我需要全部。"

# game/a14/6north_end.rpy:666
translate english highland_end_rib_e5f024f6:

    # krastan "Я? Да ты хрипишь, пока дышишь. Мне неохота тебя калечить."
    krastan "我？你连喘气都带嘶嘶声。我可不想把你打残了。"

