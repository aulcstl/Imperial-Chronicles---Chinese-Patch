# game/a14/6north_end.rpy:403
translate english highland_end2_4a752315:

    # me "И кто победит?"
    me "谁会赢？"

# game/a14/6north_end.rpy:404
translate english highland_end2_7eea3a4c:

    # krastan "Ну а ты как думаешь?"
    krastan "你觉得呢？"

# game/a14/6north_end.rpy:405
translate english highland_end2_1b813c78:

    # me "Думаю твой брат."
    me "我觉得是你那位哥哥。"

# game/a14/6north_end.rpy:406
translate english highland_end2_a1715cfc:

    # krastan "Правильно думаешь."
    krastan "猜对了。"

# game/a14/6north_end.rpy:407
translate english highland_end2_fdf9abee:

    # me "Знаешь, вы как-то не слишком похожи."
    me "你知道吗，你们俩长得不太像。"

# game/a14/6north_end.rpy:408
translate english highland_end2_127a9edc:

    # krastan "У нас разные матери. Свою он убил при рождении. Порвал ее так, что она умерла прежде чем он полностью из нее вылез."
    krastan "我们母亲不同。他母亲生他时死了。被他撕裂了，他还没完全出来，她就死了。"

# game/a14/6north_end.rpy:409
translate english highland_end2_a1f81d3a:

    # me "Так он твой старший брат?"
    me "所以他是你哥哥？"

# game/a14/6north_end.rpy:410
translate english highland_end2_92cbd13b:

    # krastan "Вроде того."
    krastan "差不多吧。"

# game/a14/6north_end.rpy:411
translate english highland_end2_759f2a5c:

    # me "Полагаю я знаю, кто станет следующим вождем."
    me "我猜我知道谁会当下任首领了。"

# game/a14/6north_end.rpy:412
translate english highland_end2_8d9bf81c:

    # krastan "Неправильно полагаешь. У нас не как у вас, южанин."
    krastan "错。我们跟你们南方人不一样。"

# game/a14/6north_end.rpy:413
translate english highland_end2_3e92deae:

    # me "Наследует не старший?"
    me "不是长子继承？"

# game/a14/6north_end.rpy:414
translate english highland_end2_aecd4d01:

    # krastan "Наследует тот, кого выбрал вождь и кого одобрили старейшины. Все, чтобы избежать недостойного наследника. Вам такое незнакомо."
    krastan "继承的是首领选定、长老认可的人。是为了避免不肖子孙。你们不懂这套。"

# game/a14/6north_end.rpy:415
translate english highland_end2_c162bea6:

    # me "Очень мудро. И какие у тебя шансы?"
    me "很明智。你有多大机会？"

# game/a14/6north_end.rpy:416
translate english highland_end2_e381ba49:

    # krastan "Не очень большие. Но собираюсь попросить отца объявить меня наследником."
    krastan "不大。但我打算求父亲宣布我为继承人。"

# game/a14/6north_end.rpy:417
translate english highland_end2_34ab5191:

    # me "Вот так просто?"
    me "就这么简单？"

# game/a14/6north_end.rpy:419
translate english highland_end2_f613d301:

    # krastan "Не так уж и просто. Для начала мне нужны все ленты."
    krastan "没那么简单。首先我需要所有丝带。"

# game/a14/6north_end.rpy:420
translate english highland_end2_877d3d95:

    # me "С лентами можно попросить и об этом?"
    me "有丝带就可以提这种要求？"

# game/a14/6north_end.rpy:421
translate english highland_end2_1f5a7295:

    # krastan "Можно попросить о чем угодно."
    krastan "可以提任何要求。"

# game/a14/6north_end.rpy:422
translate english highland_end2_7be52d8c:

    # me "Похоже твой брат собирается попросить о том же самом."
    me "看来你那位哥哥也想提同样的要求。"

# game/a14/6north_end.rpy:423
translate english highland_end2_0bf766fa:

    # krastan "Ага. Хорошо, что в этом году некому было спрятать ленту. Гордость моей сестрички не позволила ей это сделать."
    krastan "嗯。还好今年没人藏丝带。我妹妹的自尊心不允许她那么做。"

# game/a14/6north_end.rpy:424
translate english highland_end2_3b686666:

    # me "Так ты пришел за моей лентой?"
    me "所以你是来要我的丝带？"

# game/a14/6north_end.rpy:425
translate english highland_end2_7eeb0b8d:

    # krastan "Нет. К чему мне тратить силы сейчас?"
    krastan "不。何必现在浪费力气？"

# game/a14/6north_end.rpy:426
translate english highland_end2_149b3064_1:

    # me "В каком смысле?"
    me "什么意思？"

# game/a14/6north_end.rpy:427
translate english highland_end2_72da4f93:

    # krastan "Аслан забрал уже почти все ленты. Я хорошо дерусь, так что за моей он придет последним."
    krastan "Aslan已经拿走了几乎全部丝带。我打架还行，所以他最后才会来找我。"

# game/a14/6north_end.rpy:428
translate english highland_end2_8c76aeab:

    # me "А..."
    me "啊……"

# game/a14/6north_end.rpy:429
translate english highland_end2_ecd36dfe:

    # krastan "А за твоей придет сейчас. Просто решил предупредить. Он там побеждает?"
    krastan "他现在是来找你的。只是来提醒你一下。他那边赢了吗？"

# game/a14/6north_end.rpy:430
translate english highland_end2_938cc459:

    # me "Его противник хрипит и просит пощады."
    me "他的对手在喘着气求饶。"

# game/a14/6north_end.rpy:431
translate english highland_end2_37da489c:

    # krastan "Ну значит ты следующий."
    krastan "那就下一个是你了。"

# game/a14/6north_end.rpy:432
translate english highland_end2_edcfc204:

    # me "А может все же ты?"
    me "也许还是你吧？"

# game/a14/6north_end.rpy:433
translate english highland_end2_727e31b7:

    # krastan "Нет. Думаю ты. Впрочем может и я, если ты просто сдашься."
    krastan "不。我觉得是你。不过如果你直接认输，也许就是我。"

# game/a14/6north_end.rpy:435
translate english highland_end2_a28ce321:

    # aslan "Ленту."
    aslan "丝带。"

# game/a14/6north_end.rpy:436
translate english highland_end2_de5dd677:

    # me "Я?"
    me "我？"

# game/a14/6north_end.rpy:437
translate english highland_end2_fb9ea49d:

    # aslan "А кто? Кому Амина ее отдала?"
    aslan "不然呢？Amina把它给了谁？"

# game/a14/6north_end.rpy:438
translate english highland_end2_33b4a2c5:

    # me "Может и не мне."
    me "也许不是给我。"

# game/a14/6north_end.rpy:439
translate english highland_end2_de60a8b5:

    # aslan "Не лги, все видели, как она повязала тебе ее на руку."
    aslan "别撒谎，所有人都看见她把它系在你胳膊上了。"

# game/a14/6north_end.rpy:440
translate english highland_end2_15b52f73:

    # me "Мне вот интересно. Если можно просить о ленте кого угодно, как ее спрятать до конца свадьбы?"
    me "我挺好奇的。要是可以向任何人讨要丝带，那怎么才能把它藏到婚礼结束？"

# game/a14/6north_end.rpy:441
translate english highland_end2_de55de2d:

    # aslan "Легко. Был бы ты поумнее - не приходил бы сюда. Хотя зачем она тебе?"
    aslan "简单。你要是聪明点，就不会来这儿了。不过你要它干吗？"

# game/a14/6north_end.rpy:442
translate english highland_end2_b9442c96:

    # me "Для приза."
    me "为了奖品。"

# game/a14/6north_end.rpy:443
translate english highland_end2_8f58e13d:

    # aslan "Сомневаюсь, что принцу нужна лошадь или новый меч."
    aslan "我不信一个王子会缺马或新剑。"

# game/a14/6north_end.rpy:444
translate english highland_end2_9c97c459:

    # me "А если я хочу попросить о чем-то большем?"
    me "那如果我想求的是更大的东西呢？"

# game/a14/6north_end.rpy:445
translate english highland_end2_d47a1025:

    # aslan "Пф... все ленты ты бы не собрал."
    aslan "噗……你也集不齐全部丝带。"

# game/a14/6north_end.rpy:446
translate english highland_end2_3820771a:

    # me "..."
    me "……"

# game/a14/6north_end.rpy:447
translate english highland_end2_eca46b6d:

    # aslan "Но можешь попытаться."
    aslan "不过你可以试试。"

# game/a14/6north_end.rpy:458
translate english highland_end_rib_93384972:

    # me "А я и попытаюсь."
    me "我正打算试试。"

# game/a14/6north_end.rpy:459
translate english highland_end_rib_6bc52a24:

    # harold "Принц!"
    harold "王子！"

# game/a14/6north_end.rpy:460
translate english highland_end_rib_8b9a8536:

    # krastan "[mename]?"
    krastan "[mename]？"

# game/a14/6north_end.rpy:461
translate english highland_end_rib_63461efc:

    # aslan "О. Это славно! Хотел разбить твоего лицо с того дня, как впервые тебя увидел."
    aslan "哦。太好了！从我第一次见到你那天起，我就想揍烂你的脸。"

# game/a14/6north_end.rpy:462
translate english highland_end_rib_f1330dce:

    # me "Взаимно."
    me "彼此彼此。"

# game/a14/6north_end.rpy:463
translate english highland_end_rib_089fafb2:

    # harold "Мой принц!"
    harold "我的王子！"

# game/a14/6north_end.rpy:464
translate english highland_end_rib_0ebdf6bd:

    # me "Все нормально, Гарольд. Я просто попробую."
    me "没事，Harold。我只是试试。"

# game/a14/6north_end.rpy:465
translate english highland_end_rib_f5d94afb:

    # krastan "А ты... полон сюрпризов, львенок."
    krastan "你……你真是充满惊喜，小狮子。"

# game/a14/6north_end.rpy:466
translate english highland_end_rib_8ee28215:

    # aslan "У этого львенка скоро не будет зубов."
    aslan "这小狮子很快就要没牙了。"

# game/a14/6north_end.rpy:467
translate english highland_end_rib_eba77b5f:

    # me "Так мы идем драться, или ты только языком чесать умеешь?"
    me "我们是来打架，还是你只会耍嘴皮子？"

# game/a14/6north_end.rpy:468
translate english highland_end_rib_86eadd04:

    # krastan "Уу... Дело серьезное."
    krastan "唔……来真的了。"

# game/a14/6north_end.rpy:469
translate english highland_end_rib_86f7e4c5:

    # aslan "Ну пойдем."
    aslan "走吧。"

# game/a14/6north_end.rpy:470
translate english highland_end_rib_21d78709:

    # me "Пойдем."
    me "走吧。"

# game/a14/6north_end.rpy:472
translate english highland_end_rib_0dbc11cb:

    # aslan "Я тебя жалеть не буду."
    aslan "我可不会手软。"

# game/a14/6north_end.rpy:473
translate english highland_end_rib_2ec4bce8:

    # me "И не надо."
    me "不需要。"

# game/a14/6north_end.rpy:474
translate english highland_end_rib_b8d8ca0c:

    # aslan "Если захочешь сдаться - громко это скажешь. Все остальное - слюни, хрипы, слезы, кровь, я как сдачу не принимаю."
    aslan "你要是想认输，就大声说出来。其他什么口水、喘气、眼泪、血，我都不算认输。"

# game/a14/6north_end.rpy:475
translate english highland_end_rib_b8ce9279:

    # me "А если у меня не будет возможности сказать, что я сдаюсь?"
    me "那如果我没法说出认输呢？"

# game/a14/6north_end.rpy:476
translate english highland_end_rib_b076c625:

    # aslan "А это уже твои проблемы."
    aslan "那就是你的问题了。"

# game/a14/6north_end.rpy:477
translate english highland_end_rib_855db9ee:

    # me "Ясно."
    me "明白。"

# game/a14/6north_end.rpy:478
translate english highland_end_rib_f12f3fcf:

    # amina "{size=-5}[mename]!{/size}"
    amina "{size=-5}[mename]！{/size}"

# game/a14/6north_end.rpy:479
translate english highland_end_rib_09c73465:

    # me "М? Амина? Ты чего там делаешь?"
    me "嗯？Amina？你在这儿干什么？"

# game/a14/6north_end.rpy:480
translate english highland_end_rib_99e4c820:

    # amina "{size=-5}Я чего тут делаю? Ты чего тут делаешь? Ты спятил?{/size}"
    amina "{size=-5}我在这儿干什么？你在这儿干什么？你疯了吗？{/size}"

# game/a14/6north_end.rpy:481
translate english highland_end_rib_1c16ebe5:

    # me "Все нормально. Я хочу попытаться."
    me "没事。我想试试。"

# game/a14/6north_end.rpy:482
translate english highland_end_rib_8b440f71:

    # amina "{size=-5}Ты идиот? Он раза в два тебя больше!{/size}"
    amina "{size=-5}你是白痴吗？他比你大一倍！{/size}"

# game/a14/6north_end.rpy:483
translate english highland_end_rib_e4698ae3:

    # me "Не преувеличивай."
    me "没那么夸张。"

# game/a14/6north_end.rpy:484
translate english highland_end_rib_1b68702a:

    # amina "{size=-5}Ты же проиграешь!{/size}"
    amina "{size=-5}你会输的！{/size}"

# game/a14/6north_end.rpy:485
translate english highland_end_rib_458b73ab:

    # me "Может быть."
    me "也许吧。"

# game/a14/6north_end.rpy:486
translate english highland_end_rib_7d78000e:

    # amina "{size=-5}Ты сумасшедший! Бей в голову!{/size}"
    amina "{size=-5}你疯了！打他头！{/size}"

# game/a14/6north_end.rpy:487
translate english highland_end_rib_b6626098:

    # me "А?"
    me "啊？"

# game/a14/6north_end.rpy:488
translate english highland_end_rib_e27a17f7:

    # amina "{size=-5}Глянь на его тело. Это гора мышц. Если хочешь победить - бей в голову!{/size}"
    amina "{size=-5}看他的身体。那是肌肉堆成山。想赢就打头！{/size}"

# game/a14/6north_end.rpy:489
translate english highland_end_rib_f5c433b2:

    # aslan "Ну ты готов там или как?"
    aslan "你准备好了没有啊？"

# game/a14/6north_end.rpy:491
translate english highland_end_rib_4a5a4207:

    # me "Что? Не терпится получить тумаков?"
    me "怎么？急着挨揍？"

# game/a14/6north_end.rpy:492
translate english highland_end_rib_03646e08:

    # aslan "А... хехехех, ты смешной, львенок. Я же тебя уничтожу."
    aslan "啊……嘿嘿嘿，你真逗，小狮子。我会把你碾碎的。"

# game/a14/6north_end.rpy:493
translate english highland_end_rib_37730b33:

    # me "Да ну?"
    me "是吗？"

# game/a14/6north_end.rpy:494
translate english highland_end_rib_b7ecea5b:

    # aslan "Ты хоть раз в жизни дрался?"
    aslan "你这辈子打过架吗？"

# game/a14/6north_end.rpy:495
translate english highland_end_rib_7a89e51d:

    # me "А ты меня вчера не видел на арене?"
    me "你昨天没在竞技场看到我吗？"

# game/a14/6north_end.rpy:496
translate english highland_end_rib_9db503f5:

    # aslan "Видел. Мой брат положил тебя за минуту."
    aslan "看到了。我哥哥一分钟就把你撂倒了。"

# game/a14/6north_end.rpy:497
translate english highland_end_rib_7f322870:

    # me "Я не старался."
    me "我没出全力。"

# game/a14/6north_end.rpy:498
translate english highland_end_rib_fb7bc6c1:

    # aslan "Да ну?"
    aslan "是吗？"

# game/a14/6north_end.rpy:499
translate english highland_end_rib_494510ee:

    # me "Ага. Экономил силы на здоровенный мешок говна, который мне нужно победить сейчас."
    me "嗯。省着力气对付现在要打败的那一坨大屎包。"

# game/a14/6north_end.rpy:500
translate english highland_end_rib_aeb99cab:

    # aslan "Хех. Как бы не кончить, когда у тебя зубы полетят долой."
    aslan "嘿。别等会儿把你牙都打飞了。"

# game/a14/6north_end.rpy:501
translate english highland_end_rib_f97f40ab:

    # me "Может уже нападешь, пидорас здоровенный?"
    me "你倒是上啊，大屁精？"

# game/a14/6north_end.rpy:504
translate english highland_end_rib_9c255691:

    # aslan "{size=+5}Иди сюд...аа! Сука!{/size}"
    aslan "{size=+5}过……啊！我操！{/size}"

# game/a14/6north_end.rpy:505
translate english highland_end_rib_0cf0cc59:

    # me "Получай, мразь!"
    me "挨打吧，人渣！"

# game/a14/6north_end.rpy:506
translate english highland_end_rib_1a74a150:

    # aslan "{size=+5}Сука!{/size}"
    aslan "{size=+5}操！{/size}"

# game/a14/6north_end.rpy:509
translate english highland_end_rib_003f0010:

    # aslan "{size=+5}Блядь!{/size}"
    aslan "{size=+5}妈的！{/size}"

# game/a14/6north_end.rpy:510
translate english highland_end_rib_be25dc9d:

    # me "Что ты там про зубы говорил, мразь?"
    me "你刚说牙怎么了，人渣？"

# game/a14/6north_end.rpy:511
translate english highland_end_rib_4076e4d3:

    # aslan "{size=+5}Я тебя сейчас...{/size}"
    aslan "{size=+5}我这就……{/size}"

# game/a14/6north_end.rpy:514
translate english highland_end_rib_05d61849:

    # aslan "{size=+5}Убью!{/size}"
    aslan "{size=+5}杀了你！{/size}"

# game/a14/6north_end.rpy:515
translate english highland_end_rib_9739b1d1:

    # me "Твою мать..."
    me "我靠……"

# game/a14/6north_end.rpy:516
translate english highland_end_rib_17583bff:

    # aslan "{size=+5}Подставился, тварь!{/size}"
    aslan "{size=+5}露出空档了，畜生！{/size}"

# game/a14/6north_end.rpy:518
translate english highland_end_rib_b99c61cd:

    # wojceh "А мы обязаны смотреть на это?"
    wojceh "我们非得看这个吗？"

# game/a14/6north_end.rpy:519
translate english highland_end_rib_0f556eb2:

    # alia "М?"
    alia "嗯？"

# game/a14/6north_end.rpy:520
translate english highland_end_rib_1d59cebd:

    # wojceh "Это тоже часть вашей горской свадьбы? Наблюдать как гости друг друга убивают?"
    wojceh "这也是你们山地婚礼的一部分？看着宾客们互相残杀？"

# game/a14/6north_end.rpy:521
translate english highland_end_rib_4e49a3bb:

    # alia "Они не убьют друг друга."
    alia "他们不会杀了对方的。"

# game/a14/6north_end.rpy:522
translate english highland_end_rib_b7498753:

    # wojceh "Я в этом не уверен."
    wojceh "我不确定。"

# game/a14/6north_end.rpy:523
translate english highland_end_rib_52d3393a:

    # alia "Лев одержит победу."
    alia "狮子会赢。"

