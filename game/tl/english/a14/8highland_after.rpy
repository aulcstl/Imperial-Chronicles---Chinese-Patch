# game/a14/8highland_after.rpy:574
translate english highland_after_amina_1b7b2109:

    # amina "У Рубинового ущелья есть башня. За маленькую плату можно связаться с нужным кланом или даже нанять проводника."
    amina "红宝石峡谷旁有座塔楼。花一点小钱，就可以联络到你想要的部族，甚至雇一名向导。"

# game/a14/8highland_after.rpy:575
translate english highland_after_amina_71d3b8c8:

    # me "Хорошо."
    me "好的。"

# game/a14/8highland_after.rpy:576
translate english highland_after_amina_fa495c8f:

    # amina "Ты ведь еще помнишь название нашего клана?"
    amina "你还记得我们部族的名字吧？"

# game/a14/8highland_after.rpy:577
translate english highland_after_amina_7f3c1e55:

    # me "Железные пояса."
    me "铁腰带。"

# game/a14/8highland_after.rpy:578
translate english highland_after_amina_1b3ad41a:

    # amina "Верно."
    amina "没错。"

# game/a14/8highland_after.rpy:579
translate english highland_after_amina_a5c35059:

    # me "Слушай, Амина. Мне пора. А тебе не стоит стоять на холоде раздетой."
    me "听着，Amina。我该走了。你也不该敞着身子站在外面受冻。"

# game/a14/8highland_after.rpy:580
translate english highland_after_amina_49b5eddd:

    # amina "Да. Ты прав."
    amina "嗯。你说得对。"

# game/a14/8highland_after.rpy:582
translate english highland_after_amina_fdca4813:

    # amina "До встречи, южный принц!"
    amina "再见了，南方的王子！"

# game/a14/8highland_after.rpy:583
translate english highland_after_amina_539269f8:

    # me "До встречи, горная принцесса."
    me "再见了，山地公主。"

# game/a14/8highland_after.rpy:584
translate english highland_after_amina_3290e1c6:

    # amina "Если ты не навестишь меня до свадьбы, я тебя прокляну, ясно?"
    amina "你要是在我婚礼前都不来看我，我就诅咒你，明白吗？"

# game/a14/8highland_after.rpy:585
translate english highland_after_amina_045d877b:

    # me "А когда она у тебя будет?"
    me "那你什么时候会有婚礼？"

# game/a14/8highland_after.rpy:586
translate english highland_after_amina_fdeca57b:

    # amina "Когда я найду в Высокой стране кого-нибудь такого же красивого, как ты!"
    amina "等我在高地上找到一个像你一样英俊的人！"

# game/a14/8highland_after.rpy:587
translate english highland_after_amina_518398a0:

    # me "Тогда я могу не торопиться."
    me "那我大概是不用着急了。"

# game/a14/8highland_after.rpy:588
translate english highland_after_amina_972de143:

    # amina "Эй!"
    amina "喂！"

# game/a14/8highland_after.rpy:589
translate english highland_after_amina_a58fe4e3:

    # me "Не оставь случайно своего 'южного принца' ржаветь на камнях."
    me "可别让你的“南方王子”失落在石头堆里锈掉。"

# game/a14/8highland_after.rpy:590
translate english highland_after_amina_7e9db6c0:

    # amina "Ох. Точно. Спасибо!"
    amina "哦。没错。谢谢你提醒！"

# game/a14/8highland_after.rpy:594
translate english highland_after2_adff26a9:

    # "Вечером следующего дня."
    "第二天傍晚。"

# game/a14/8highland_after.rpy:595
translate english highland_after2_e6fc2c5d:

    # harold "...мы можем ехать быстрее, мой принц."
    harold "...我们可以走快点，我的王子。"

# game/a14/8highland_after.rpy:596
translate english highland_after2_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a14/8highland_after.rpy:597
translate english highland_after2_34edf446:

    # harold "В порту несколько кораблей. Если хотите, можем идти совсем налегке, остальные отплывут на других кораблях позже."
    harold "港口有几艘船。如果您想的话，我们可以轻装简行，剩下的人晚些时候乘别的船出发。"

# game/a14/8highland_after.rpy:598
translate english highland_after2_3743f85e:

    # me "Мне еще нужно вернуть лордам их людей."
    me "我还需要把士兵还回领主们手里。"

# game/a14/8highland_after.rpy:599
translate english highland_after2_c122edd3:

    # harold "Большая часть это люди лорда Гастона."
    harold "大部分是Gaston领主的人。"

# game/a14/8highland_after.rpy:600
translate english highland_after2_804d2a98:

    # me "...верно. Ладно. Тогда оставим людей в Даркхолле и поедем налегке."
    me "...没错。好吧。那我们就把人留在暗影堡，然后轻装简行。"

# game/a14/8highland_after.rpy:604
translate english highland_after2_a7a4e7de:

    # cass "Думаешь эти уроды еще рыскают где-нибудь здесь?"
    cass "你觉得那些混账还在附近鬼鬼祟祟地晃荡吗？"

# game/a14/8highland_after.rpy:605
translate english highland_after2_223b59de:

    # me "Ты про горцев?"
    me "你是指那些高地人？"

# game/a14/8highland_after.rpy:606
translate english highland_after2_b9b405b7:

    # cass "Ага. Они наверняка злы, как собаки. Хотят тебе отомстить."
    cass "对。他们肯定气得像疯狗一样。想找你报仇呢。"

# game/a14/8highland_after.rpy:607
translate english highland_after2_887889bb:

    # me "Мне?"
    me "找我？"

# game/a14/8highland_after.rpy:608
translate english highland_after2_7f3f0fcc:

    # cass "А кому же еще."
    cass "不找你找谁。"

# game/a14/8highland_after.rpy:609
translate english highland_after2_4700a888:

    # me "Скаладану."
    me "找Scaladan。"

# game/a14/8highland_after.rpy:610
translate english highland_after2_afa2646b:

    # cass "Они пустили тебя на свою свадьбу, ты для них теперь клятвопреступник похуже Скаладана."
    cass "他们让你参加了他们的婚礼，你现在对他们来说，是个比Scaladan还要可恶的背誓者了。"

# game/a14/8highland_after.rpy:611
translate english highland_after2_a7219698:

    # me "Они взяли лорда Войцеха в заложники. Это была не свадьба, а фарс."
    me "他们劫持了Vojceh领主当人质。那不是婚礼，是一场闹剧。"

# game/a14/8highland_after.rpy:612
translate english highland_after2_33a9cf7b:

    # cass "О. Именно об этом они сейчас и думаю. 'Да, половину моего клана зарезали как свиней на празднике, но раз уже свадьба была нелегитимной, наверное мы сами виноваты.'"
    cass "哦。他们现在大概就是这么想的吧。“没错，我的部族有一半在节日上像猪一样被宰了，不过既然婚礼不合法，大概是我们自己的错吧。”"

# game/a14/8highland_after.rpy:613
translate english highland_after2_fe772114:

    # me "И что ты предлагаешь мне сделать?"
    me "那你建议我怎么做？"

# game/a14/8highland_after.rpy:614
translate english highland_after2_f8b7aff1:

    # cass "Да ничего. Просто мысли вслух."
    cass "没什么。我只是随便想想，随口说说。"

# game/a14/8highland_after.rpy:615
translate english highland_after2_97913d44:

    # me "Тогда оставь свои мысли при себе."
    me "那就把你的想法留在自己心里吧。"

# game/a14/8highland_after.rpy:616
translate english highland_after2_8f8d4f82:

    # cass "Ладно-ладно, лорд Зануда. Просто пыталась начать разговор."
    cass "好吧好吧，扫兴鬼领主。我只是想找个话题聊聊。"

# game/a14/8highland_after.rpy:618
translate english highland_after2_0386ebef:

    # cass "Думаешь они вернутся?"
    cass "你觉得他们会回来吗？"

# game/a14/8highland_after.rpy:619
translate english highland_after2_aeab8fae:

    # me "Кто? Горцы?"
    me "谁？高地人？"

# game/a14/8highland_after.rpy:620
translate english highland_after2_997c3068:

    # cass "Ага. Ведь вернутся же."
    cass "对。他们会回来的，对吧。"

# game/a14/8highland_after.rpy:621
translate english highland_after2_0649fbe4:

    # me "Это уже будет не моя проблема."
    me "那就不关我的事了。"

# game/a14/8highland_after.rpy:622
translate english highland_after2_2259d62f:

    # cass "Если Север станет частью Империи это будет твоя проблема."
    cass "如果北方成为了帝国的一部分，那就是你的事了。"

# game/a14/8highland_after.rpy:623
translate english highland_after2_3820771a:

    # me "..."
    me "..."

# game/a14/8highland_after.rpy:624
translate english highland_after2_911f3b69:

    # cass "Что? Ты уже не уверен, что это произойдет?"
    cass "怎么？你已经不确定这会不会发生了吗？"

# game/a14/8highland_after.rpy:625
translate english highland_after2_a3f87b93:

    # me "Не знаю. Давай сначала доберемся в Совиный Камень."
    me "不知道。我们先到猫头鹰石堡再说吧。"

# game/a14/8highland_after.rpy:626
translate english highland_after2_651ccc28:

    # cass "..."
    cass "..."

# game/a14/8highland_after.rpy:627
translate english highland_after2_ad02f53a:

    # me "Что?"
    me "怎么？"

# game/a14/8highland_after.rpy:628
translate english highland_after2_3fad5dda:

    # cass "Нет-нет. Ничего. Действуем по твоему плану. Я молчу."
    cass "不不。没什么。就按你的计划来。我不说话了。"

# game/a14/8highland_after.rpy:629
translate english highland_after2_bd7d2601:

    # me "Вот и молчи дальше."
    me "那就继续闭嘴吧。"

# game/a14/8highland_after.rpy:633
translate english highland_after2_50b6ae87:

    # harold "Пока мы туда не добрались - лучше быть начеку."
    harold "在我们到那儿之前，最好警觉点。"

# game/a14/8highland_after.rpy:634
translate english highland_after2_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a14/8highland_after.rpy:635
translate english highland_after2_9fa9eb69:

    # harold "Мы явно убили не всех горцев. Кто-то еще может прятаться в Черном Лесу."
    harold "我们显然没杀光所有的高地人。黑森林里可能还有藏着的。"

# game/a14/8highland_after.rpy:636
translate english highland_after2_0d774c36:

    # me "Единицы."
    me "零星几个。"

# game/a14/8highland_after.rpy:637
translate english highland_after2_c080ef26:

    # harold "Озлобленные единицы. Жаждущие мести единицы."
    harold "满腔怒火的零星几个人。渴望复仇的零星几个人。"

# game/a14/8highland_after.rpy:638
translate english highland_after2_81d281e0:

    # me "Ну да. Ты прав."
    me "嗯，你说得对。"

# game/a14/8highland_after.rpy:640
translate english highland_after2_2423c4c6:

    # harold "Я рад, что вам удалось решить все без крови. Хоть вы и здорово рисковали, мой принц."
    harold "我很高兴你们能兵不血刃地解决所有事。尽管你们冒了很大的风险，我的王子。"

# game/a14/8highland_after.rpy:641
translate english highland_after2_f97f3912:

    # me "Я тоже рад. В таких делах иногда не обойтись без риска, верно?"
    me "我也很高兴。有些事，不冒点风险是不行的，对吧？"

# game/a14/8highland_after.rpy:642
translate english highland_after2_42945db2:

    # harold "...верно."
    harold "...是的。"

# game/a14/8highland_after.rpy:643
translate english highland_after2_8157b195:

    # me "Тем более когда на кону человеческие жизни."
    me "更何况事关人命。"

# game/a14/8highland_after.rpy:644
translate english highland_after2_366b22a2:

    # harold "Вы будете хорошим королем, мой принц."
    harold "您会成为一个好国王的，我的王子。"

# game/a14/8highland_after.rpy:645
translate english highland_after2_f386f496:

    # me "Императором."
    me "皇帝。"

# game/a14/8highland_after.rpy:646
translate english highland_after2_cb0cfc2a:

    # harold "Конечно. Да. Императором."
    harold "当然。是的。皇帝。"

# game/a14/8highland_after.rpy:648
translate english highland_after2_0e884946:

    # me "Как думаешь, Гарольд, мы могли бы не возвращать людей лордам, пока не доберемся до Совиного Камня?"
    me "你觉得呢，Harold，在我们到达猫头鹰石堡之前，能不把士兵还给领主们吗？"

# game/a14/8highland_after.rpy:649
translate english highland_after2_b9d9f87d:

    # harold "Зачем нам это?"
    harold "我们为什么要这么做？"

# game/a14/8highland_after.rpy:650
translate english highland_after2_492e0422:

    # me "Меня одолевают сомнения. Нехорошие мысли."
    me "我感到疑虑。有些不祥的念头。"

# game/a14/8highland_after.rpy:651
translate english highland_after2_d60c70fc:

    # harold "Какие?"
    harold "什么念头？"

# game/a14/8highland_after.rpy:652
translate english highland_after2_2bcb2b74:

    # me "Скаладан. Уж больно нагло он действовал."
    me "Scaladan。他行事太嚣张了。"

# game/a14/8highland_after.rpy:653
translate english highland_after2_6188b021:

    # harold "Думаете ему приказал Дубовицкий?"
    harold "您觉得是Dubovitsky授意他的吗？"

# game/a14/8highland_after.rpy:654
translate english highland_after2_10183293:

    # me "Либо молчаливо одобрил его идею. Он столько лет правит Севером, а его вассал так нагло нарушает все священные договоры. Он что, его не боится?"
    me "要么是默许了他的做法。他统治北方这么多年，他的封臣如此胆大妄为地践踏所有神圣契约。他难道不忌惮他吗？"

# game/a14/8highland_after.rpy:655
translate english highland_after2_cad17368:

    # me "А если не боится - то почему?"
    me "要是不忌惮——那又是为什么？"

# game/a14/8highland_after.rpy:656
translate english highland_after2_68e2b706:

    # harold "Может из-за голосования?"
    harold "会不会是因为投票表决？"

# game/a14/8highland_after.rpy:657
translate english highland_after2_61a292aa:

    # me "Вече? Я думал об этом. Но не один же Скаладан голосует. Впрочем..."
    me "集会？我想过这一点。但投票的不止Scaladan一个人。不过嘛..."

# game/a14/8highland_after.rpy:658
translate english highland_after2_789373a5:

    # harold "Впрочем что?"
    harold "不过什么？"

# game/a14/8highland_after.rpy:659
translate english highland_after2_0529aeb7:

    # me "Впрочем сейчас нет смысла об этом думать. Узнаем на месте."
    me "不过现在想这些没意义。到了地方就知道了。"

# game/a14/8highland_after.rpy:661
translate english highland_after2_dfe42f4f:

    # "Три дня спустя."
    "三天后。"

# game/a14/8highland_after.rpy:662
translate english highland_after2_3917cb95:

    # me "{i}Забавно. Их всех замков по пути - этот самый высокий, хотя именно его помогали строить дворфы.{/i}"
    me "{i}真有趣。一路上这些城堡里——这座是最高的，可偏偏只有它是矮人帮忙修建的。{/i}"

# game/a14/8highland_after.rpy:663
translate english highland_after2_9c186f5e:

    # me "{i}Хотел бы я посмотреть на Трех Братьев и Северную Цитадель. Говорят Три Брата длинные, как горная цепь. А Северная Цитадель высокая, как гора.{/i}"
    me "{i}真想去看看三兄弟山和北方堡垒。据说三兄弟山像山脉一样绵长。而北方堡垒像高山一样巍峨。{/i}"

# game/a14/8highland_after.rpy:664
translate english highland_after2_e3170552:

    # me "{i}Может поехать северным путем?{/i}"
    me "{i}说不定走北边的路？{/i}"

# game/a14/8highland_after.rpy:665
translate english highland_after2_5de6fc8e:

    # me "{i}Нет. Мне еще нужно вернуть солдат леди Украдской.{/i}"
    me "{i}不。我还得把士兵还给乌克拉德女领主。{/i}"

# game/a14/8highland_after.rpy:666
translate english highland_after2_13aa7667:

    # me "{i}К тому же если я буду так вольно путешествовать, то точно не успею до морозов.{/i}"
    me "{i}而且，我要是这么随意地绕路旅行，肯定没法在霜冻前赶到了。{/i}"

# game/a14/8highland_after.rpy:669
translate english highland_after2_5aa16952:

    # giel "Приветствую вас, принц [mename]."
    giel "欢迎您，[mename]王子。"

# game/a14/8highland_after.rpy:670
translate english highland_after2_e6ae88d2:

    # me "Здравствуй, Гиль."
    me "你好，吉尔。"

# game/a14/8highland_after.rpy:671
translate english highland_after2_071ac8cd:

    # giel "Рад, что вы добрались в целости и невредимости."
    giel "很高兴您能安然无恙地抵达。"

# game/a14/8highland_after.rpy:672
translate english highland_after2_6ebf39b2:

    # me "Я тоже этому рад."
    me "我对此也很高兴。"

# game/a14/8highland_after.rpy:673
translate english highland_after2_d9d80eb8:

    # giel "Мой управляющий сказал вы вернули солдат."
    giel "我的总管说，您还回了士兵。"

# game/a14/8highland_after.rpy:674
translate english highland_after2_6fd4a69f:

    # me "Да. Они могут идти домой."
    me "是的。他们可以回家了。"

# game/a14/8highland_after.rpy:675
translate english highland_after2_a4ac1418:

    # giel "Они храбро бились?"
    giel "他们英勇奋战了吗？"

# game/a14/8highland_after.rpy:677
translate english highland_after2_25abfb6b:

    # me "Они мне не понадобились. Но возможно именно их присутствие помогло бойне не случиться."
    me "我没用上他们。不过，很可能正是因为他们的存在，才避免了屠杀的发生。"

# game/a14/8highland_after.rpy:678
translate english highland_after2_3e4c9acc:

    # giel "Замечательно."
    giel "太好了。"

# game/a14/8highland_after.rpy:680
translate english highland_after2_e3d285c0:

    # me "Храбро. Они бились как настоящие северные воины."
    me "非常英勇。他们像真正的北方勇士一样战斗。"

# game/a14/8highland_after.rpy:681
translate english highland_after2_54635bfb:

    # giel "Хорошо."
    giel "很好。"

# game/a14/8highland_after.rpy:682
translate english highland_after2_5f871598:

    # me "Я могу поговорить с вашим отцом?"
    me "我能和令尊谈谈吗？"

# game/a14/8highland_after.rpy:683
translate english highland_after2_a613346e:

    # giel "Боюсь что нет."
    giel "恐怕不行。"

# game/a14/8highland_after.rpy:684
translate english highland_after2_b5617c5e:

    # me "Ох..."
    me "哦..."

# game/a14/8highland_after.rpy:686
translate english highland_after2_52294ace:

    # giel "Не переживайте. С ним все в порядке."
    giel "别担心。他一切都好。"

# game/a14/8highland_after.rpy:687
translate english highland_after2_1fe7cd27:

    # me "Так..."
    me "那..."

# game/a14/8highland_after.rpy:688
translate english highland_after2_9098cef1:

    # giel "Он отправился к Борису Дубовицкому."
    giel "他去了杜波维茨基的Boris那儿了。"

# game/a14/8highland_after.rpy:689
translate english highland_after2_7332342b:

    # me "Зачем?"
    me "为什么？"

# game/a14/8highland_after.rpy:690
translate english highland_after2_86acf426:

    # giel "Боюсь отец меня не уведомил."
    giel "恐怕爸爸没有通知我。"

# game/a14/8highland_after.rpy:691
translate english highland_after2_4216afc1:

    # me "Ясно... это как-то связано со мной?"
    me "明白了...这和我有关吗？"

# game/a14/8highland_after.rpy:692
translate english highland_after2_a8c9e372:

    # giel "Не могу сказать. Не знаю."
    giel "说不好。我不知道。"

# game/a14/8highland_after.rpy:693
translate english highland_after2_01822020:

    # me "Ладно."
    me "好吧。"

# game/a14/8highland_after.rpy:694
translate english highland_after2_3ce094ab:

    # giel "Он только велел дать вам возможность отдыхать вам и вашим людям, сколько вам нужно."
    giel "他只吩咐，让您和您的人能得到所需的休息。"

# game/a14/8highland_after.rpy:695
translate english highland_after2_ef54991a:

    # me "Спасибо. Но мы завтра же отправимся в путь. Насчет припасов он что-нибудь говорил?"
    me "谢谢。但我们明天就动身。关于补给，他说过什么吗？"

# game/a14/8highland_after.rpy:696
translate english highland_after2_defe9ca2:

    # giel "Конечно. Сказал дать вам, что вам будет нужно."
    giel "当然。他说要给您所需的一切。"

# game/a14/8highland_after.rpy:697
translate english highland_after2_01c6250e:

    # me "Отлично."
    me "太好了。"

# game/a14/8highland_after.rpy:700
translate english highland_after2_5aa16952_1:

    # giel "Приветствую вас, принц [mename]."
    giel "欢迎您，[mename]王子。"

# game/a14/8highland_after.rpy:701
translate english highland_after2_f2845318:

    # me "Здравствуй, Гиль. Здравствуй, Рамона."
    me "你好，吉尔。你好，Ramona。"

# game/a14/8highland_after.rpy:702
translate english highland_after2_22507e3d:

    # ramona "Принц [mename]."
    ramona "[mename]王子。"

# game/a14/8highland_after.rpy:703
translate english highland_after2_071ac8cd_1:

    # giel "Рад, что вы добрались в целости и невредимости."
    giel "很高兴您能安然无恙地抵达。"

# game/a14/8highland_after.rpy:704
translate english highland_after2_6ebf39b2_1:

    # me "Я тоже этому рад."
    me "我对此也很高兴。"

# game/a14/8highland_after.rpy:705
translate english highland_after2_d9d80eb8_1:

    # giel "Мой управляющий сказал вы вернули солдат."
    giel "我的总管说，您还回了士兵。"

# game/a14/8highland_after.rpy:706
translate english highland_after2_6fd4a69f_1:

    # me "Да. Они могут идти домой."
    me "是的。他们可以回家了。"

# game/a14/8highland_after.rpy:707
translate english highland_after2_a4ac1418_1:

    # giel "Они храбро бились?"
    giel "他们英勇奋战了吗？"

# game/a14/8highland_after.rpy:709
translate english highland_after2_25abfb6b_1:

    # me "Они мне не понадобились. Но возможно именно их присутствие помогло бойне не случиться."
    me "我没用上他们。不过，很可能正是因为他们的存在，才避免了屠杀的发生。"

# game/a14/8highland_after.rpy:710
translate english highland_after2_3e4c9acc_1:

    # giel "Замечательно."
    giel "太好了。"

# game/a14/8highland_after.rpy:712
translate english highland_after2_e3d285c0_1:

    # me "Храбро. Они бились как настоящие северные воины."
    me "非常英勇。他们像真正的北方勇士一样战斗。"

# game/a14/8highland_after.rpy:713
translate english highland_after2_54635bfb_1:

    # giel "Хорошо."
    giel "很好。"

# game/a14/8highland_after.rpy:714
translate english highland_after2_5f871598_1:

    # me "Я могу поговорить с вашим отцом?"
    me "我能和令尊谈谈吗？"

# game/a14/8highland_after.rpy:715
translate english highland_after2_3083fa64:

    # giel "Боюсь что нет. Я за главного."
    giel "恐怕不行。现在由我当家。"

# game/a14/8highland_after.rpy:716
translate english highland_after2_48732577:

    # me "Ох... Он болен?"
    me "哦...他生病了吗？"

# game/a14/8highland_after.rpy:717
translate english highland_after2_f9c2d90c:

    # giel "Не переживайте. С ним все в порядке. Он отправился к Борису Дубовицкому?"
    giel "别担心。他一切都好。他去了杜波维茨基的Boris那儿了吧？"

# game/a14/8highland_after.rpy:718
translate english highland_after2_a7332d2d:

    # me "Зачем? Это как-то связано со мной?"
    me "为什么？这和我有关吗？"

# game/a14/8highland_after.rpy:719
translate english highland_after2_bc5e3f51:

    # giel "Боюсь отец меня не уведомил. Он только велел дать вам возможность отдыхать вам и вашим людям, сколько вам нужно."
    giel "恐怕爸爸没有通知我。他只吩咐，让您和您的人能得到所需的休息。"

# game/a14/8highland_after.rpy:720
translate english highland_after2_ef54991a_1:

    # me "Спасибо. Но мы завтра же отправимся в путь. Насчет припасов он что-нибудь говорил?"
    me "谢谢。但我们明天就动身。关于补给，他说过什么吗？"

# game/a14/8highland_after.rpy:721
translate english highland_after2_defe9ca2_1:

    # giel "Конечно. Сказал дать вам, что вам будет нужно."
    giel "当然。他说要给您所需的一切。"

# game/a14/8highland_after.rpy:722
translate english highland_after2_01c6250e_1:

    # me "Отлично."
    me "太好了。"

# game/a14/8highland_after.rpy:724
translate english highland_after2_59d1afaa:

    # me "Ну как ты?"
    me "你怎么样啊？"

# game/a14/8highland_after.rpy:725
translate english highland_after2_9fcaa691:

    # ramona "Хорошо."
    ramona "挺好的。"

# game/a14/8highland_after.rpy:726
translate english highland_after2_804739ae:

    # me "Точно? Тебя не обижали тут?"
    me "真的吗？他们没在这怠慢你吧？"

# game/a14/8highland_after.rpy:727
translate english highland_after2_4e0b7874:

    # ramona "Нет. Ко мне относились тут очень хорошо. Наверное даже лучше, чем дома."
    ramona "没有。我在这里过得非常好。可能比在家还好呢。"

# game/a14/8highland_after.rpy:728
translate english highland_after2_00d68cd0:

    # me "Серьезно?"
    me "真的吗？"

# game/a14/8highland_after.rpy:729
translate english highland_after2_17e92851:

    # ramona "Да. Слуга каждый вечер спрашивал чего я хочу на завтрак, Гиль приносил мне любые книги, мне готовили горячую ванну по требованию и даже учили кататься на лошади."
    ramona "嗯。仆人每晚都问我第二天早餐想吃什么，吉尔给我带来各种我想看的书，我还能随时要求泡热水澡，他们甚至还教我骑马。"

# game/a14/8highland_after.rpy:730
translate english highland_after2_0f7aaa07:

    # me "Ух ты."
    me "哇。"

# game/a14/8highland_after.rpy:731
translate english highland_after2_ecfd84b6:

    # ramona "Да. Гиль водил меня в тоннели под замком. Было страшно, но очень интересно. А еще я впервые попробовала мороженное!"
    ramona "嗯。吉尔还带我去了城堡底下的地道。挺吓人的，但特别有趣。而且我还第一次尝到了冰激凌！"

# game/a14/8highland_after.rpy:732
translate english highland_after2_6b92c9c4:

    # me "Мороженное?"
    me "冰激凌？"

# game/a14/8highland_after.rpy:733
translate english highland_after2_f2ba9a6c:

    # ramona "Да. Это такое холодно лакомство. Очень вкусное."
    ramona "对。就是一种冷冰冰的甜食。非常好吃。"

# game/a14/8highland_after.rpy:734
translate english highland_after2_e11f3f32:

    # me "Так тебе здесь понравилось?"
    me "所以你还挺喜欢这儿？"

# game/a14/8highland_after.rpy:735
translate english highland_after2_b87ee422:

    # ramona "Здесь было хорошо."
    ramona "在这儿挺好的。"

# game/a14/8highland_after.rpy:736
translate english highland_after2_97263599:

    # me "А как тебе Гиль?"
    me "你觉得吉尔怎么样？"

# game/a14/8highland_after.rpy:737
translate english highland_after2_1086bd49:

    # ramona "Ну он..."
    ramona "呃，他..."

# game/a14/8highland_after.rpy:738
translate english highland_after2_ad02f53a_1:

    # me "Что?"
    me "怎么？"

# game/a14/8highland_after.rpy:739
translate english highland_after2_b1e0b9ba:

    # ramona "Он славный. Но он... эм... солнцепоклонник."
    ramona "他人挺好的。但他...呃...是个太阳崇拜者。"

# game/a14/8highland_after.rpy:740
translate english highland_after2_51c2c17c:

    # me "Что это?"
    me "那是什么？"

# game/a14/8highland_after.rpy:741
translate english highland_after2_3b27679e:

    # ramona "Не знаю. Какая-то религия. С Юга. С настоящего Юга."
    ramona "不知道。某种宗教吧。来自南方。真正的南方。"

# game/a14/8highland_after.rpy:742
translate english highland_after2_f2d29fb8:

    # me "И..."
    me "然后..."

# game/a14/8highland_after.rpy:743
translate english highland_after2_9c280004:

    # ramona "Он иногда ведет себя странно. Совершает какие-то странные ритуалы и разговаривает сам с собой."
    ramona "他有时举止挺奇怪的。会做一些古怪的仪式，还会自言自语。"

# game/a14/8highland_after.rpy:744
translate english highland_after2_5d6f0181:

    # me "Ну это не так уж и странно."
    me "嗯，这也不算太奇怪吧。"

# game/a14/8highland_after.rpy:745
translate english highland_after2_044748d7:

    # ramona "Да. Но пару раз я видела как он пытался разговаривать с солнцем."
    ramona "是。但我有几次看见他试图和太阳说话。"

# game/a14/8highland_after.rpy:746
translate english highland_after2_3820771a_1:

    # me "..."
    me "..."

# game/a14/8highland_after.rpy:747
translate english highland_after2_bcc33451:

    # ramona "But overall, he's quite nice."
    ramona "不过总得来说，他人挺好的。"

# game/a14/8highland_after.rpy:748
translate english highland_after2_1a973a6a:

    # me "Ладно. Давай доберемся до замка Дубовицких и там уже решим вопрос с твоим женихом."
    me "好吧。我们先到杜波维茨基家的城堡，然后再解决你未婚夫的问题。"

# game/a14/8highland_after.rpy:749
translate english highland_after2_be27df89:

    # ramona "Ладно."
    ramona "好。"

# game/a14/8highland_after.rpy:751
translate english highland_after2_06f71100:

    # "Пару дней спустя."
    "几天后。"

# game/a14/8highland_after.rpy:752
translate english highland_after2_b835c4f4:

    # me "{i}Холодает.{/i}"
    me "{i}天变冷了。{/i}"

# game/a14/8highland_after.rpy:753
translate english highland_after2_e47eb2f7:

    # me "{i}Уже и днем солнце светит не так ярко.{/i}"
    me "{i}白天太阳都没那么亮了。{/i}"

# game/a14/8highland_after.rpy:754
translate english highland_after2_ae01a47e:

    # me "{i}А ночью и вовсе чувствуется легкий мороз.{/i}"
    me "{i}到了夜晚，甚至能感觉到轻微的霜冻。{/i}"

# game/a14/8highland_after.rpy:755
translate english highland_after2_66cb7100:

    # me "{i}Отсюда я мог бы поехать северной дорогой. Но пожалуй не стоит.{/i}"
    me "{i}从这里我本可以走北边的路。但大概不要了吧。{/i}"

# game/a14/8highland_after.rpy:756
translate english highland_after2_e1aa3488:

    # me "{i}Посмотрю на Трех Братьев и Северную Цитадель в следующий раз.{/i}"
    me "{i}下次再看三兄弟山和北方堡垒吧。{/i}"

# game/a14/8highland_after.rpy:758
translate english highland_after2_32fecaaa:

    # "Два дня спустя."
    "两天后。"

# game/a14/8highland_after.rpy:760
translate english highland_after2_dd779ae5:

    # ukrad "...так все же крови избежать не удалось."
    ukrad "...所以最终还是没能避免流血。"

# game/a14/8highland_after.rpy:761
translate english highland_after2_6196ebb1:

    # me "К сожалению нет."
    me "很遗憾，是。"

# game/a14/8highland_after.rpy:762
translate english highland_after2_b5dd3c34:

    # ukrad "Жаль. Ублюдок Скаладан получил чего хотел."
    ukrad "真可惜。Scaladan那个混蛋算是得逞了。"

# game/a14/8highland_after.rpy:764
translate english highland_after2_88d31b66:

    # ukrad "...так ты решил все миром?"
    ukrad "...这么说，是你和平解决了？"

# game/a14/8highland_after.rpy:765
translate english highland_after2_fc30fd2b:

    # me "Да."
    me "是的。"

# game/a14/8highland_after.rpy:766
translate english highland_after2_50a085dc:

    # ukrad "Молодец. Ублюдок Скаладан не получил того, чего хотел."
    ukrad "好孩子。Scaladan那个混蛋没能得逞。"

# game/a14/8highland_after.rpy:767
translate english highland_after2_6af8c92c:

    # me "Откуда вы это знали?"
    me "您怎么知道会这样？"

# game/a14/8highland_after.rpy:768
translate english highland_after2_391273a9:

    # ukrad "Что знала?"
    ukrad "知道什么？"

# game/a14/8highland_after.rpy:769
translate english highland_after2_4ffcae6e:

    # me "Что ему нужно кровопролитие."
    me "知道他想要流血事件。"

# game/a14/8highland_after.rpy:770
translate english highland_after2_b6bf6819:

    # ukrad "Сразу понятно, что ты тут недавно."
    ukrad "一看就知道你刚来不久。"

# game/a14/8highland_after.rpy:771
translate english highland_after2_f098bce7:

    # me "На Севере?"
    me "刚来北方？"

# game/a14/8highland_after.rpy:772
translate english highland_after2_f2432f29:

    # ukrad "Да. Здесь же так заведено."
    ukrad "对。这儿的规矩就是这样。"

# game/a14/8highland_after.rpy:773
translate english highland_after2_8606e04c:

    # me "Объясните."
    me "请解释一下。"

# game/a14/8highland_after.rpy:775
translate english highland_after2_1e2dc70e:

    # ukrad "Маленькая война с горцами это местная традиция. Раз в несколько лет какой-нибудь клан выбирается из своей Высокой Страны и их тут же всех убивают."
    ukrad "和高地人小打小闹，算是本地传统了。每隔几年，就会有个部族走出他们的高地，然后他们马上就会遭到屠戮。"

# game/a14/8highland_after.rpy:776
translate english highland_after2_f103ab14:

    # me "Ну... это ведь справедливо? Они нарушают договор о границах."
    me "呃...这不公平吗？他们破坏了边界协议。"

# game/a14/8highland_after.rpy:777
translate english highland_after2_3c55aedb:

    # ukrad "Справедливо? Пожалуй. Я бы делала то же самое, если бы они появились на моей земле."
    ukrad "公平？也许是吧。如果他们出现在我的地盘上，我也会做同样的事。"

# game/a14/8highland_after.rpy:778
translate english highland_after2_3ed7754d:

    # me "Так в чем же дело?"
    me "那问题出在哪儿呢？"

# game/a14/8highland_after.rpy:779
translate english highland_after2_52199779:

    # ukrad "Ты еще помнишь о чем спрашивал сначала?"
    ukrad "你还记得你一开始问的是什么吗？"

# game/a14/8highland_after.rpy:780
translate english highland_after2_0e431626:

    # me "Да. Про Скаладана."
    me "记得。关于Scaladan。"

# game/a14/8highland_after.rpy:781
translate english highland_after2_3f53cce3:

    # ukrad "Ты бы не спросил об этом, если бы он пытался решить все миром, а не был бы отвратительной кровожадной рыжей свиньей."
    ukrad "如果是他试图和平解决，你就不会问起他了；正因为他是一头让人作呕、嗜血成性的红毛猪，你才会问。"

# game/a14/8highland_after.rpy:782
translate english highland_after2_3820771a_2:

    # me "..."
    me "..."

# game/a14/8highland_after.rpy:783
translate english highland_after2_8056e558:

    # ukrad "Что? Хочешь сказать он был миротворцем?"
    ukrad "怎么？你想说他是个和平使者？"

# game/a14/8highland_after.rpy:784
translate english highland_after2_2d97b04a:

    # me "Нет. Он мешал решить все миром."
    me "不。他阻挠了和平解决。"

# game/a14/8highland_after.rpy:785
translate english highland_after2_13c5def4:

    # ukrad "Вот именно. Это его работа."
    ukrad "正是如此。这就是他的活儿。"

# game/a14/8highland_after.rpy:786
translate english highland_after2_88a52e7b:

    # me "Работа?"
    me "活儿？"

# game/a14/8highland_after.rpy:787
translate english highland_after2_a0040964:

    # ukrad "Он провоцирует кланы лучше остальных. И убивает их тоже. Гастон и Войцех просто защищают границы. Но только не этот ублюдок."
    ukrad "他比别人更擅长挑衅那些部族。也擅长杀他们。加斯顿和Vojceh只是守卫边境。但这个混蛋不一样。"

# game/a14/8highland_after.rpy:788
translate english highland_after2_96e4beca:

    # me "В этот раз все начал сам клан. Они устроили пьяную свадьбу."
    me "这次是那个部族先挑的事。他们办了一场醉醺醺的婚礼。"

# game/a14/8highland_after.rpy:789
translate english highland_after2_f10cb8ac:

    # ukrad "Кто это тебе сказал? Скаладан?"
    ukrad "谁跟你说的？Scaladan？"

# game/a14/8highland_after.rpy:790
translate english highland_after2_fb2ed5b9:

    # me "Члены клана не сильно с этим спорили."
    me "部族的人对此并没有多加辩驳。"

# game/a14/8highland_after.rpy:791
translate english highland_after2_dd371344:

    # ukrad "Может быть. Даже если он не лжет - это все равно может быть провокацией. Соблазнить на преступление против тебя, чтобы потом ответить стократно это настоящее искусство."
    ukrad "也许吧。就算他没撒谎——这依然可能是个圈套。引诱别人对你犯罪，然后百倍地报复，这是一门真正的艺术。"

# game/a14/8highland_after.rpy:792
translate english highland_after2_962021f9:

    # me "Соблазнить на преступление? Чувствую в этом некую предвзятость. Не то чтобы лорд Скаладан образец добродетели, но разве неосторожно широко открытый карман с золотом на рынке делает вора менее виноватым?"
    me "引诱犯罪？我觉得这有点偏见。不是说Scaladan领主是个道德楷模，但难道因为在市场上大大咧咧地敞开装着金币的口袋，小偷的罪责就能减轻吗？"

# game/a14/8highland_after.rpy:793
translate english highland_after2_6038ee85:

    # ukrad "Я лишь говорю о том, что если ты не хочешь, чтобы у тебя украли золото - не держи карман открытым на рынке вовсе."
    ukrad "我只想说，如果你不想让别人偷你的金币——那就压根别在市场上敞开口袋。"

# game/a14/8highland_after.rpy:794
translate english highland_after2_71b1423a:

    # ukrad "Потому что если ты делаешь иначе, ты либо дурак, либо провокатор и злодей."
    ukrad "因为如果你没这么做，你要么是傻子，要么就是个煽动者和恶棍。"

# game/a14/8highland_after.rpy:795
translate english highland_after2_791bae25:

    # me "А преступник не злодей?"
    me "那罪犯就不是恶棍了吗？"

# game/a14/8highland_after.rpy:796
translate english highland_after2_4978f75a:

    # ukrad "Мотив имеет значение. Если бы женщина твоей мечты раскрыла перед тобой ноги, можно подумать ты бы не залез на нее."
    ukrad "动机很重要。如果你梦寐以求的女人在你面前张开双腿，我可不觉得你会不爬上她的身。"

# game/a14/8highland_after.rpy:797
translate english highland_after2_f95c9fc9:

    # me "И?"
    me "所以呢？"

# game/a14/8highland_after.rpy:798
translate english highland_after2_71331cea:

    # ukrad "А если бы она потом завопила, что ты ее насилуешь, она ведь была бы права. Она не говорила тебе ее трахать. Ты сам так решил."
    ukrad "但如果她事后尖叫，说你强暴了她，她说的也没错。她没让你干她。是你自己那么决定的。"

# game/a14/8highland_after.rpy:799
translate english highland_after2_fcc5c03d:

    # ukrad "Но если бы она не хотела, чтобы ты ее трахал, она бы не раздвигала ноги, верно? Выходит она либо дура, либо сделала это специально."
    ukrad "但如果她不想让你干她，她就根本不会张开腿，对吧？所以，她要嘛是傻子，要嘛是故意这么做的。"

# game/a14/8highland_after.rpy:800
translate english highland_after2_bd94cdac:

    # me "И все равно я не понимаю, зачем Складану это нужно."
    me "我还是不明白，斯克拉丹为什么要这么做。"

# game/a14/8highland_after.rpy:801
translate english highland_after2_7a176915:

    # ukrad "А вот это уже точно вопрос не ко мне. Это у вас, у мужчин, надо спросить отчего вам так нравится убивать друг друга, даже когда в этом нет необходимости."
    ukrad "唉，这就肯定不是该问我的问题了。这得问你们男人了，为什么你们那么喜欢互相残杀，哪怕根本没必要。"

# game/a14/8highland_after.rpy:802
translate english highland_after2_3820771a_3:

    # me "..."
    me "..."

# game/a14/8highland_after.rpy:803
translate english highland_after2_0aa739f3:

    # me "Ваш муж в замке?"
    me "您丈夫在城堡里吗？"

# game/a14/8highland_after.rpy:804
translate english highland_after2_d3e09000:

    # ukrad "Нет. Он отправился к Борису. Но я приму у тебя наших воинов и дам припасов."
    ukrad "不在。他去Boris那儿了。但我会接收我们的士兵，并提供补给。"

# game/a14/8highland_after.rpy:807
translate english highland_after2_28363173:

    # ukrad "И да. [mename], начет того что между нами было. Вернее не было. Ну ты понял."
    ukrad "还有一件事。[mename]，关于我们之间那件事。或者更准确地说，没发生的事。嗯你明白的。"

# game/a14/8highland_after.rpy:808
translate english highland_after2_e79d0fd5:

    # me "Да?"
    me "嗯？"

# game/a14/8highland_after.rpy:809
translate english highland_after2_c01734bd:

    # ukrad "Ты ведь осторожен."
    ukrad "你是个谨慎的人吧。"

# game/a14/8highland_after.rpy:810
translate english highland_after2_bb686f7a:

    # me "Ну да."
    me "嗯，是的。"

# game/a14/8highland_after.rpy:811
translate english highland_after2_e08fb40c:

    # ukrad "Хорошо. Просто хотела убедиться, что ты не болтаешь лишнего."
    ukrad "好。只是想确认一下，你不会乱说话。"

# game/a14/8highland_after.rpy:812
translate english highland_after2_d2338d57:

    # me "Я похож на такого человека?"
    me "我看上去像那种人吗？"

# game/a14/8highland_after.rpy:813
translate english highland_after2_1c65e385:

    # ukrad "Ты похож на полуэльфа."
    ukrad "你看上去像半精灵。"

# game/a14/8highland_after.rpy:814
translate english highland_after2_2325fa76:

    # me "И что?"
    me "什么意思？"

# game/a14/8highland_after.rpy:815
translate english highland_after2_66be7582:

    # ukrad "Эльфы мстительные."
    ukrad "精灵都记仇。"

# game/a14/8highland_after.rpy:816
translate english highland_after2_59206454:

    # me "Все еще не понимаю."
    me "我还是不明白。"

# game/a14/8highland_after.rpy:817
translate english highland_after2_5f1db9b4:

    # ukrad "Мне бы не хотелось, чтобы ты в порыве гнева ляпнул какую-нибудь чушь."
    ukrad "我可不想你在怒头上，口不择言地说出什么蠢话。"

# game/a14/8highland_after.rpy:818
translate english highland_after2_68216793:

    # me "В порыве гнева?"
    me "怒头上？"

# game/a14/8highland_after.rpy:819
translate english highland_after2_679b3c61:

    # ukrad "Ты познакомишься с моим мужем у Дубовицкого. Не знаю, как у вас это пройдет, но мне..."
    ukrad "你会在杜波维茨基那儿见到我丈夫。不知道你们见面会怎么样，但我..."

# game/a14/8highland_after.rpy:820
translate english highland_after2_08d57002:

    # me "Ваш муж должен сообщить мне что-то неприятное?"
    me "您丈夫有什么坏消息要告诉我吗？"

# game/a14/8highland_after.rpy:821
translate english highland_after2_c3d03b9b:

    # ukrad "Не знаю."
    ukrad "不知道。"

# game/a14/8highland_after.rpy:822
translate english highland_after2_7f77ab09:

    # me "Хелен?"
    me "Helen Ukradskaya？"

# game/a14/8highland_after.rpy:823
translate english highland_after2_94e726f0:

    # ukrad "Не знаю. Но если он что-то и скажет. Или у тебя испортится настроение..."
    ukrad "不知道。但如果他真的说了什么。或者你的心情变得很糟..."

# game/a14/8highland_after.rpy:824
translate english highland_after2_5b7e1ba3:

    # me "Я представить не могу, что он должен сделать или сказать, чтобы я решил выдать этот секрет."
    me "我想象不出他能做或说什么，会让我想泄露这个秘密。"

# game/a14/8highland_after.rpy:825
translate english highland_after2_705ae1f0:

    # ukrad "Все равно. Я бы хотела чтобы ты пообещал мне."
    ukrad "无论如何。我希望你能向我保证。"

# game/a14/8highland_after.rpy:826
translate english highland_after2_9538b431:

    # me "Обещаю."
    me "我保证。"

# game/a14/8highland_after.rpy:827
translate english highland_after2_0f433da0:

    # ukrad "Хорошо. Надеюсь полуэльфы держат слово лучше, чем просто эльфы."
    ukrad "好。希望半精灵比纯精灵更能信守诺言。"

# game/a14/8highland_after.rpy:828
translate english highland_after2_3820771a_4:

    # me "..."
    me "..."

# game/a14/8highland_after.rpy:829
translate english highland_after2_4942b914:

    # ukrad "Прости. Просто немного переживаю."
    ukrad "抱歉。我只是有点担心。"

# game/a14/8highland_after.rpy:830
translate english highland_after2_f075d627:

    # me "Я дал слово. И я его сдержу."
    me "我发了誓。我就会遵守。"

# game/a14/8highland_after.rpy:832
translate english highland_after2_32fecaaa_1:

    # "Два дня спустя."
    "两天后。"

# game/a14/8highland_after.rpy:833
translate english highland_after2_240ce6e5:

    # miranda "Дорога была легкой?"
    miranda "路上还算轻松吧？"

# game/a14/8highland_after.rpy:834
translate english highland_after2_8613242c:

    # me "Угу."
    me "嗯。"

# game/a14/8highland_after.rpy:835
translate english highland_after2_e5d684f1:

    # miranda "Другие слуги говорят, что ночью уже подмораживает."
    miranda "其他仆人说，晚上已经开始有点霜冻了。"

# game/a14/8highland_after.rpy:836
translate english highland_after2_0f5c66bb:

    # me "Да. Немного."
    me "是的。一点点。"

# game/a14/8highland_after.rpy:837
translate english highland_after2_8c29004c:

    # miranda "Надеюсь это не сказалось на путешествии."
    miranda "希望没影响到你们的旅程。"

# game/a14/8highland_after.rpy:838
translate english highland_after2_0d65cb00:

    # me "Неа. Пока что нет."
    me "没。还没有。"

# game/a14/8highland_after.rpy:839
translate english highland_after2_b2123beb:

    # miranda "Припасы лорда Корвина пригодились?"
    miranda "Corwin领主的补给还合用吗？"

# game/a14/8highland_after.rpy:840
translate english highland_after2_0f0e6637:

    # me "Да. Благодарю."
    me "是的。谢谢。"

# game/a14/8highland_after.rpy:841
translate english highland_after2_c461e5ba:

    # miranda "Вы можете приступать к еде, принц [mename]."
    miranda "您可以开始用餐了，[mename]王子。"

# game/a14/8highland_after.rpy:842
translate english highland_after2_423043a6:

    # me "Да..."
    me "嗯..."

# game/a14/8highland_after.rpy:845
translate english highland_after2_09ef4b4b:

    # selest "Может уже хватит этих блевотворных формальностей?"
    selest "这些令人作呕的礼节是不是可以免了？"

# game/a14/8highland_after.rpy:846
translate english highland_after2_85c42cec:

    # miranda "Просто интересуюсь."
    miranda "我只是关心一下。"

# game/a14/8highland_after.rpy:847
translate english highland_after2_afd73e3d:

    # selest "Звучишь как настоящая слуга."
    selest "听起来你可真像个十足的仆人。"

# game/a14/8highland_after.rpy:848
translate english highland_after2_76ebb755:

    # miranda "А я и есть слуга. Слуга лорда Корвина, помнишь."
    miranda "我本来就是仆人。Corwin领主的仆人，记得吗。"

# game/a14/8highland_after.rpy:849
translate english highland_after2_3820771a_5:

    # me "..."
    me "..."

# game/a14/8highland_after.rpy:850
translate english highland_after2_2c5f4340:

    # selest "Тебе это по душе, я смотрю."
    selest "我看你还蛮适合这角色的。"

# game/a14/8highland_after.rpy:851
translate english highland_after2_3727f166:

    # miranda "Не самое худшее положение, верно, принц [mename]? В тепле, накормлена и под защитой."
    miranda "这还不算是最坏的处境，对吧，[mename]王子？暖暖和和的，吃饱穿暖，还受保护。"

# game/a14/8highland_after.rpy:852
translate english highland_after2_60358084:

    # me "Эм..."
    me "呃..."

# game/a14/8highland_after.rpy:853
translate english highland_after2_27349fb8:

    # selest "И с членом лорда Корвина в заднице забыла добавить."
    selest "你还忘了加上屁股里塞着Corwin领主的老二。"

# game/a14/8highland_after.rpy:854
translate english highland_after2_d1944acf:

    # miranda "Ну... это мелочи жизни. Небольшая плата за нормальную жизнь."
    miranda "哎呀...这些只是生活琐事。为过上正常生活付出的一点小小代价。"

# game/a14/8highland_after.rpy:855
translate english highland_after2_a33cebb0:

    # me "А где сам Лорд Корвин?"
    me "那Corwin领主本人在哪儿？"

# game/a14/8highland_after.rpy:856
translate english highland_after2_a662a554:

    # selest "Там же, где и остальные лорды. Mindon Aelrwe."
    selest "和其他领主一样的地方。Mindon Aelrwe。"

# game/a14/8highland_after.rpy:857
translate english highland_after2_74e4f93a:

    # miranda "В замке Дубовицкого."
    miranda "在杜波维茨基的城堡。"

# game/a14/8highland_after.rpy:860
translate english highland_after2_94eb9c7e:

    # selest "Причину ты знаешь."
    selest "原因你知道了。"

# game/a14/8highland_after.rpy:861
translate english highland_after2_03424b7d:

    # me "Горцы."
    me "高地人。"

# game/a14/8highland_after.rpy:862
translate english highland_after2_a9f78d70:

    # selest "Да. Ты хорошо справился."
    selest "对。你干得不错。"

# game/a14/8highland_after.rpy:863
translate english highland_after2_a894b059:

    # miranda "Они собираются, чтобы тебе все вместе отсосать?"
    miranda "他们是聚到一起，好一起给你献殷勤吗？"

# game/a14/8highland_after.rpy:864
translate english highland_after2_742059b4:

    # selest "У принца и короля Севера небольшой договор."
    selest "王子和北方国王之间有个小小的协议。"

# game/a14/8highland_after.rpy:865
translate english highland_after2_864a4296:

    # miranda "Правда? И какой же?"
    miranda "是吗？什么协议？"

# game/a14/8highland_after.rpy:866
translate english highland_after2_d5c0d84a:

    # me "По поводу Империи."
    me "关于帝国的。"

# game/a14/8highland_after.rpy:867
translate english highland_after2_c77763f5:

    # miranda "Правда? Они склонят колени за то, что ты убил шайку горцев?"
    miranda "是吗？他们因为你杀了一群高地人，就要向你屈膝称臣？"

# game/a14/8highland_after.rpy:868
translate english highland_after2_7ec889f0:

    # me "Они станут автономным королевством."
    me "他们将成为自治的王国。"

# game/a14/8highland_after.rpy:869
translate english highland_after2_e375896b:

    # miranda "Вот это ты фантазер."
    miranda "你这可真是异想天开呀。"

# game/a14/8highland_after.rpy:870
translate english highland_after2_c5add5ce:

    # selest "Дай ему помечтать, Миранда. Пусть он сам набьет себе синяки."
    selest "让他做做梦吧，Miranda。让他自己去碰一鼻子灰。"

# game/a14/8highland_after.rpy:871
translate english highland_after2_515d98f0:

    # me "По-вашему они этого не сделают?"
    me "你们认为他们不会这么做吗？"

# game/a14/8highland_after.rpy:872
translate english highland_after2_c5e01f36:

    # miranda "Дубовицкий? Преклонит колено? Да ты спятил, мальчик."
    miranda "Dubovitsky？屈膝？你疯了吗，小子。"

# game/a14/8highland_after.rpy:873
translate english highland_after2_c43957c6:

    # selest "Следи за языком."
    selest "注意你的言辞。"

# game/a14/8highland_after.rpy:874
translate english highland_after2_af0a2c08:

    # miranda "Простите. Да вы, видимо, не в лучшем состоянии ума, мой принц, если считаете, что Дубовицкий преклонит колено."
    miranda "对不起。我的王子，如果您觉得Dubovitsky会屈膝，那您的精神状态恐怕确实不太好。"

# game/a14/8highland_after.rpy:875
translate english highland_after2_5708bb62:

    # selest "Закрой рот."
    selest "闭嘴。"

# game/a14/8highland_after.rpy:876
translate english highland_after2_439e0857:

    # me "Но я ведь все равно не зря это сделал, верно? Судя по тому, что я узнал, моя помощь не была необходима. Что-то мне подсказывает, что это была проверка."
    me "不过，我这么做也并非毫无意义，对吧？根据我了解到的情况，我的帮助并非不可或缺。我觉得，这更像是一次考验。"

# game/a14/8highland_after.rpy:878
translate english highland_after2_fe9cc184:

    # selest "Ты ее прошел."
    selest "你通过了。"

# game/a14/8highland_after.rpy:879
translate english highland_after2_e966af74:

    # me "Так я теперь заслуживаю вашего доверия?"
    me "那么，现在我赢得了您的信任？"

# game/a14/8highland_after.rpy:880
translate english highland_after2_e4c96b6a:

    # selest "Больше, чем месяц назад."
    selest "比一个月前要多。"

# game/a14/8highland_after.rpy:881
translate english highland_after2_8b97e47f:

    # me "Может теперь я даже смогу выполнять настоящие поручения?"
    me "或许现在，我甚至可以执行真正的任务了？"

# game/a14/8highland_after.rpy:882
translate english highland_after2_ea482e7c:

    # selest "Ты умнее чем кажешься, [mename]."
    selest "你比看上去要聪明，[mename]。"

# game/a14/8highland_after.rpy:883
translate english highland_after2_467ba803:

    # me "Надеюсь, это тоже повод больше меня не проверять."
    me "希望这也能成为不再考验我的理由。"

# game/a14/8highland_after.rpy:884
translate english highland_after2_d8497aea:

    # selest "Прости. Я верю леде Алейне. Но мне нужно было убедиться."
    selest "对不起。我相信阿莱恩女士。但我需要确定一下。"

# game/a14/8highland_after.rpy:885
translate english highland_after2_8420406b:

    # me "По-моему я не давал поводов в себе сомневаться."
    me "我想我没有给过您怀疑我的理由。"

# game/a14/8highland_after.rpy:886
translate english highland_after2_eef85409:

    # selest "Мне нужно было увидеть, что ты готов убивать наших врагов."
    selest "我需要看到你准备好去杀我们的敌人。"

# game/a14/8highland_after.rpy:887
