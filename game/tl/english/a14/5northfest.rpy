translate english northfest2_ef7d0b09:

    # me "Ну не купайся."
    me "那你别洗。"

# game/a14/5northfest.rpy:123
translate english northfest2_27b75779:

    # amina "А ты... ты раздеваешься!"
    amina "可你……你在脱衣服！"

# game/a14/5northfest.rpy:124
translate english northfest2_fb933724:

    # me ""
    me "（脱就脱呗。）"

# game/a14/5northfest.rpy:125
translate english northfest2_387bc56c:

    # amina "...ну...ну да. Точно."
    amina "……嗯……好像也是。没错。"

# game/a14/5northfest.rpy:127
translate english northfest2_e28fecf8:

    # amina "Ну как?"
    amina "怎么样？"

# game/a14/5northfest.rpy:128
translate english northfest2_413f72a3:

    # me "Отлично. Присоединяйся."
    me "棒极了。一起来吧。"

# game/a14/5northfest.rpy:129
translate english northfest2_757977df:

    # amina "Нет. Мне нельзя."
    amina "不行。我不能这么做。"

# game/a14/5northfest.rpy:130
translate english northfest2_81ecc127:

    # me "Никто не узнает."
    me "没人会知道的。"

# game/a14/5northfest.rpy:131
translate english northfest2_00b869c6:

    # amina "Нет!"
    amina "不行！"

# game/a14/5northfest.rpy:132
translate english northfest2_dfe48796:

    # me "Ладно. Тогда стой там."
    me "好吧。那你就在那站着吧。"

# game/a14/5northfest.rpy:133
translate english northfest2_6649c9e9:

    # amina "..."
    amina "..."

# game/a14/5northfest.rpy:134
translate english northfest2_99ba76da:

    # me "Посушишь мою одежду?"
    me "帮我把衣服烤干？"

# game/a14/5northfest.rpy:135
translate english northfest2_b09df071:

    # amina "Ты мне не муж, не буду я сушить твою одежду!"
    amina "你又不是我丈夫，我才不会给你烤衣服！"

# game/a14/5northfest.rpy:136
translate english northfest2_42cfee24:

    # me "Ну тебе там скучно стоять будет."
    me "你不是站在那儿无聊嘛。"

# game/a14/5northfest.rpy:137
translate english northfest2_d00f369e:

    # amina "Не будет."
    amina "我才不无聊。"

# game/a14/5northfest.rpy:138
translate english northfest2_3ebafacc:

    # me "Как знаешь."
    me "随你便。"

# game/a14/5northfest.rpy:140
translate english northfest2_2e6b4621:

    # me "Упс..."
    me "哎呀……"

# game/a14/5northfest.rpy:141
translate english northfest2_cda53284:

    # amina "Что там?"
    amina "怎么了？"

# game/a14/5northfest.rpy:142
translate english northfest2_3bcf80fe:

    # me "Про сушку вещей..."
    me "关于烤衣服的事……"

# game/a14/5northfest.rpy:143
translate english northfest2_a1302f88:

    # amina "Не буду я сушить твои вещи! Сам вылезешь и посушишь."
    amina "我说了不会给你烤衣服！你自己出来烤。"

# game/a14/5northfest.rpy:144
translate english northfest2_9694a1b8:

    # me "Я не об этом. Помнишь ты сказала, что здесь кто-то сушит платье?"
    me "不是这个。你记得你说这里有人在烤裙子吗？"

# game/a14/5northfest.rpy:145
translate english northfest2_13a5e142:

    # amina "М?"
    amina "嗯？"

# game/a14/5northfest.rpy:146
translate english northfest2_2e6fb891:

    # me "Кажется ты ошиблась."
    me "看来你弄错了。"

# game/a14/5northfest.rpy:147
translate english northfest2_f4980f6d:

    # amina "О нет, ты серьезно?"
    amina "哦不，你是认真的？"

# game/a14/5northfest.rpy:148
translate english northfest2_55063cff:

    # me "Ага. Мне вылезти?"
    me "嗯。我需要出来吗？"

# game/a14/5northfest.rpy:150
translate english northfest2_5c39c8b0:

    # alia "Не надо. Я почти закончила."
    alia "不用。我快好了。"

# game/a14/5northfest.rpy:151
translate english northfest2_f0cd4a3e:

    # amina "{size=-4}Кто там?{/size}"
    amina "{size=-4}谁在那儿？{/size}"

# game/a14/5northfest.rpy:152
translate english northfest2_66bc78c5:

    # me "Твоя сестра."
    me "你的妹妹。"

# game/a14/5northfest.rpy:153
translate english northfest2_a9c6e62f:

    # amina "{size=-4}О нет! Правда?{/size}"
    amina "{size=-4}哦不！真的？{/size}"

# game/a14/5northfest.rpy:154
translate english northfest2_5f9abfe2:

    # me "Уверена?"
    me "你确定吗？"

# game/a14/5northfest.rpy:155
translate english northfest2_4649c526:

    # alia "Да."
    alia "是的。"

# game/a14/5northfest.rpy:156
translate english northfest2_23931ce5:

    # amina "{size=-4}Вылазь!{/size}"
    amina "{size=-4}快出来！{/size}"

# game/a14/5northfest.rpy:157
translate english northfest2_3a59da50:

    # me "Все нормально."
    me "没事的。"

# game/a14/5northfest.rpy:158
translate english northfest2_d42d5f14:

    # amina "{size=-4}Алия?{/size}"
    amina "{size=-4}Alia？{/size}"

# game/a14/5northfest.rpy:159
translate english northfest2_1e007b20:

    # me "Она не против."
    me "她不介意。"

# game/a14/5northfest.rpy:161
translate english northfest2_c95a775e:

    # me "Простоватое платье для невесты, не находишь?"
    me "作为新娘，这条裙子也太朴素了，你不觉得吗？"

# game/a14/5northfest.rpy:162
translate english northfest2_606cd3d9:

    # alia "Я одеваюсь так, чтобы прошмыгнуть мимо людей отца."
    alia "我穿成这样，是为了避开我父亲的眼线溜出来。"

# game/a14/5northfest.rpy:163
translate english northfest2_99210e78:

    # me "А ты из тех невест, что могут сбежать со свадьбы?"
    me "这么说，你是那种会逃婚的新娘？"

# game/a14/5northfest.rpy:164
translate english northfest2_661f8b9c:

    # alia "Я из тех невест, за которыми слишком много следят."
    alia "我是那种，被看得太紧的新娘。"

# game/a14/5northfest.rpy:165
translate english northfest2_6d627a9a:

    # me "Выходит, я прав?"
    me "那我就是说中了？"

# game/a14/5northfest.rpy:166
translate english northfest2_86591f25:

    # alia ""
    alia "（这温泉真不错。）"

# game/a14/5northfest.rpy:167
translate english northfest2_a61b007a:

    # me "Можно питаться случайно забредшими путниками."
    me "我们可以靠偶尔迷路进来的旅人填饱肚子。"

# game/a14/5northfest.rpy:168
translate english northfest2_26a57927:

    # alia "Боюсь от такого питания появляются побочные эффекты."
    alia "恐怕这种吃法会有副作用。"

# game/a14/5northfest.rpy:169
translate english northfest2_adc36abc:

    # me "Какие например?"
    me "比如说？"

# game/a14/5northfest.rpy:170
translate english northfest2_519b84f7:

    # alia "Ну если учесть, что каннибалов варят в кипящем масле - то хрустящая корочка."
    alia "想想看，食人族是要被扔进滚油里煮的——那副作用大概就是会炸出酥脆的外皮。"

# game/a14/5northfest.rpy:171
translate english northfest2_21693b25:

    # me "Звучит аппетитно."
    me "听起来还挺美味的。"

# game/a14/5northfest.rpy:172
translate english northfest2_139df7bd:

    # alia "Ну тогда такой способ побега больше подошел бы тебе."
    alia "那这种逃跑的方法，大概更适合你。"

# game/a14/5northfest.rpy:173
translate english northfest2_641fe8b5:

    # me "Поздно. Я уже женат."
    me "晚了。我已经娶了老婆。"

# game/a14/5northfest.rpy:174
translate english northfest2_6cbc43b3:

    # alia "Я тоже."
    alia "我也是。"

# game/a14/5northfest.rpy:175
translate english northfest2_665f140a:

    # me "Разве? Я думал свадьба только завтра."
    me "是吗？我以为婚礼明天才举行。"

# game/a14/5northfest.rpy:176
translate english northfest2_deb6caee:

    # alia "По-вашему мой отец будет так рисковать во второй раз?"
    alia "在你们看来，我爸爸还会冒第二次险吗？"

# game/a14/5northfest.rpy:177
translate english northfest2_149b3064:

    # me "В каком смысле?"
    me "什么意思？"

# game/a14/5northfest.rpy:178
translate english northfest2_532b0b06:

    # alia "Корхалис уже подписан."
    alia "科尔哈利斯婚约已经签了。"

# game/a14/5northfest.rpy:180
translate english northfest2_0544fe21:

    # alia "Привет, Амина."
    alia "嗨，Amina。"

# game/a14/5northfest.rpy:181
translate english northfest2_347dd086:

    # me "Привет, Амина."
    me "嗨，Amina。"

# game/a14/5northfest.rpy:182
translate english northfest2_72a4666b:

    # amina "Тебе следует вылезти."
    amina "你该出来了。"

# game/a14/5northfest.rpy:183
translate english northfest2_e2c51b87:

    # alia "Успокойся, сестра, у меня больше нет причин защищать свою девичью невинность."
    alia "别紧张，妹妹，我已经没有理由再守护我的处子之身了。"

# game/a14/5northfest.rpy:184
translate english northfest2_17d31b8a:

    # me "Но вот ты лучше к нам не залезай."
    me "不过你最好还是别下来了。"

# game/a14/5northfest.rpy:185
translate english northfest2_248cb750:

    # amina "Дурак?"
    amina "傻瓜？"

# game/a14/5northfest.rpy:186
translate english northfest2_ead914b3:

    # alia "Расслабься. Мужчины сюда не ходят."
    alia "放轻松。男人不来这儿。"

# game/a14/5northfest.rpy:187
translate english northfest2_db928cf3:

    # me "Кроме меня."
    me "除了我。"

# game/a14/5northfest.rpy:188
translate english northfest2_43a77bf0:

    # amina "А что если кто-то из других женщин увидит?"
    amina "可要是被其他女人看到了怎么办？"

# game/a14/5northfest.rpy:189
translate english northfest2_8c9db6b1:

    # alia "И что они сделают? Все расскажут отцу и он разорвет брак?"
    alia "她们能怎么样？跑去告诉我父亲，然后他解除婚约吗？"

# game/a14/5northfest.rpy:190
translate english northfest2_10da3e11:

    # me "Или расскажут Войцеху. И он откажется от своей невесты."
    me "或者告诉Vojceh。然后他拒绝他的新娘。"

# game/a14/5northfest.rpy:191
translate english northfest2_152dfe46:

    # amina "Не смешно. Так нельзя."
    amina "不好笑。这样不行。"

# game/a14/5northfest.rpy:192
translate english northfest2_f50555b9:

    # alia "Можешь закрыть глаза, если наше бесстыдство тебя сильно смущает."
    alia "如果我们的不知羞耻让你非常难堪，你可以闭上眼睛。"

# game/a14/5northfest.rpy:193
translate english northfest2_43afc866:

    # me "Но потом уже лучше их не открывать. Мало ли что может между нами произойти, пока ты не смотришь."
    me "不过之后最好就别睁开了。谁知道你闭眼的时候，我们之间会发生什么。"

# game/a14/5northfest.rpy:194
translate english northfest2_94c7acf5:

    # amina "Вы... издеваетесь надо мной?"
    amina "你们……是在戏弄我吗？"

# game/a14/5northfest.rpy:195
translate english northfest2_ac03d026:

    # alia "Нет."
    alia "没有。"

# game/a14/5northfest.rpy:196
translate english northfest2_02462389:

    # me "Я чуть-чуть да."
    me "我是有一点。"

# game/a14/5northfest.rpy:197
translate english northfest2_f24b759f:

    # amina "Я уже пожалела, что привела тебя сюда."
    amina "我已经后悔把你带到这儿来了。"

# game/a14/5northfest.rpy:198
translate english northfest2_23a71492:

    # me "Ты надеялась, что мы останемся наедине?"
    me "你是希望我们能独处吗？"

# game/a14/5northfest.rpy:199
translate english northfest2_f6225d3b:

    # amina "Я! Пф...ты..."
    amina "我！噗……你……"

# game/a14/5northfest.rpy:200
translate english northfest2_b478ee53:

    # alia "Ладно. Давайте сменим тему."
    alia "好吧。我们换个话题。"

# game/a14/5northfest.rpy:201
translate english northfest2_c65981a3:

    # me "Как скажешь, ответишь на вопрос?"
    me "那行，你回答我一个问题？"

# game/a14/5northfest.rpy:202
translate english northfest2_92e944fb:

    # alia "Давай."
    alia "问吧。"

# game/a14/5northfest.rpy:204
translate english northfest2_f1ecaeb8:

    # me "Этот ожог. Он давно с тобой или это свадебный подарок от лорда Скаладана?"
    me "那个烧伤。是一直就有，还是Scaladan领主送你的结婚礼物？"

# game/a14/5northfest.rpy:205
translate english northfest2_d41fdc77:

    # alia "..."
    alia "..."

# game/a14/5northfest.rpy:206
translate english northfest2_f71c90f1:

    # me "Ну?"
    me "嗯？"

# game/a14/5northfest.rpy:207
translate english northfest2_3ce4c9f0:

    # alia "Если я отвечу, это что-то изменит?"
    alia "我回答了，又能改变什么吗？"

# game/a14/5northfest.rpy:208
translate english northfest2_830c4e83:

    # me "Может и изменит."
    me "也许能。"

# game/a14/5northfest.rpy:209
translate english northfest2_d41fdc77_1:

    # alia "..."
    alia "..."

# game/a14/5northfest.rpy:210
translate english northfest2_f7e63dde:

    # me "Можешь не отвечать, если не хочешь."
    me "如果不想说，可以不回答。"

# game/a14/5northfest.rpy:211
translate english northfest2_99e74f60:

    # alia "Я отвечу. Это сделал Марц."
    alia "我回答。这是马尔茨干的。"

# game/a14/5northfest.rpy:212
translate english northfest2_a444ac12:

    # me "Кто?"
    me "谁？"

# game/a14/5northfest.rpy:213
translate english northfest2_a09119f4:

    # alia "Это имя лорда Скаладана."
    alia "Scaladan领主的名字。"

# game/a14/5northfest.rpy:214
translate english northfest2_c7079d3d:

    # me "И зачем он это сделал?"
    me "他为什么这么做？"

# game/a14/5northfest.rpy:215
translate english northfest2_d41fdc77_2:

    # alia "..."
    alia "..."

# game/a14/5northfest.rpy:216
translate english northfest2_ba122213:

    # me "Просто так? Без причины?"
    me "就这样？没有理由？"

# game/a14/5northfest.rpy:218
translate english northfest2_ac55b73b:

    # alia "Ты привез с собой много боли, [mename], боли и смерти."
    alia "你带来了太多的痛苦，[mename]，痛苦和死亡。"

# game/a14/5northfest.rpy:219
translate english northfest2_b6626098:

    # me "А?"
    me "啊？"

# game/a14/5northfest.rpy:220
translate english northfest2_f4f32e8c:

    # alia "Ты вез ее на спинах лошадей, на телегах обоза, она маршировала вместе с людьми, которых ты привез. Смерть стоит вдоль реки и сидит глубоко в ножнах. Пока что."
    alia "你把它们驮在马背上，装在辎重车里，它们跟着你带来的人一起行军。死亡沿着河岸矗立，深藏在剑鞘之中。暂时如此。"

# game/a14/5northfest.rpy:221
translate english northfest2_3820771a_3:

    # me "..."
    me "..."

# game/a14/5northfest.rpy:222
translate english northfest2_5a781749:

    # alia "Смерть никто не звал. Она шла с вами сама. Она вечный попутчик тех, кто просто делает, что должно. Даже самые отвратительные из людей не желают ее."
    alia "没人召唤死亡。是它自己跟着你们来的。它是那些只是「做该做之事」的人永恒的旅伴。即使是那些最可憎的人，也不希望见到它。"

# game/a14/5northfest.rpy:223
translate english northfest2_1ed01027:

    # me "Даже лорд Скаладан?"
    me "甚至Scaladan领主也是这样吗？"

# game/a14/5northfest.rpy:224
translate english northfest2_6c07fa30:

    # alia "Даже он. Даже он просто делает то, что должно. Он так думает. Ты так думаешь. Мой отец так думает. Все так думают."
    alia "甚至连他也是。连他也只是做他该做的事。他是这么认为的。你是这么认为的。我的爸爸是这么认为的。所有人都是这么认为的。"

# game/a14/5northfest.rpy:225
translate english northfest2_3820771a_4:

    # me "..."
    me "..."

# game/a14/5northfest.rpy:226
translate english northfest2_5fe3588d:

    # alia "Я не могу просить тебя избегать кровопролития. Ведь тот, кто сегодня боится пролить малую кровь - завтра будет стоять в ней по колени."
    alia "我不能要求你避免流血。因为今天害怕流一点血的人，明天血就会淹到他的膝盖。"

# game/a14/5northfest.rpy:227
translate english northfest2_e9e77bd9:

    # me "Алия?"
    me "Alia？"

# game/a14/5northfest.rpy:228
translate english northfest2_f0bc21fc:

    # alia "Но если ты будешь делать то, что должно, я лишь хочу, чтобы оставил в своем сердце место для тех, кто еще не вплетен в эту паутину смерти. Тех, кто еще ничего и никому не должны."
    alia "但如果你必须做你该做的事，我只希望你能在心里给那些还未被卷入这场死亡罗网的人留一点空间。给那些还不曾亏欠任何人的人。"

# game/a14/5northfest.rpy:229
translate english northfest2_72eaf121:

    # alia "Пожалей хотя бы их."
    alia "至少，怜悯他们。"

# game/a14/5northfest.rpy:230
translate english northfest2_f5926177:

    # me "...я постараюсь."
    me "……我会尽力。"

# game/a14/5northfest.rpy:231
translate english northfest2_9f111d9f:

    # alia "Я видела тебя во снах, [mename], на твой век выпадет столько боли и столько смерти, что руки твои всегда будут в крови, а глаза полны слез."
    alia "我在梦中见过你，[mename]，在你的一生中，将遭遇那么多的痛苦和死亡，你的双手将总是沾满鲜血，你的双眼将总是噙满泪水。"

# game/a14/5northfest.rpy:232
translate english northfest2_daa12c44:

    # alia "Пусть в дни Великой Скорби ты вспомнишь о маленьком милосердии, а не только о том, что сделал все, как должно."
    alia "但愿在那大哀之日，你能记起这小小的仁慈，而不仅仅是你做了所有该做的事。"

# game/a14/5northfest.rpy:234
translate english northfest2_02b78396:

    # me "И что это было?"
    me "她刚才是怎么了？"

# game/a14/5northfest.rpy:235
translate english northfest2_0b16193a:

    # amina "Не стоило спрашивать про ее ожог. Для нее это болезненная тема."
    amina "不该问她的烧伤。对她来说，这是个痛苦的话题。"

# game/a14/5northfest.rpy:236
translate english northfest2_505c1bb7:

