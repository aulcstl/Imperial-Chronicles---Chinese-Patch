# game/a14/7highland_war.rpy:3
translate english highland_war_e50044a2:

    # me "Держи."
    me "拿着。"

# game/a14/7highland_war.rpy:4
translate english highland_war_e71e00cf:

    # aslan "Мудрое решение."
    aslan "明智的选择。"

# game/a14/7highland_war.rpy:5
translate english highland_war_ed3176f5:

    # krastan "Точно не хочешь немного его измотать?"
    krastan "你确定不想先消耗他一下？"

# game/a14/7highland_war.rpy:6
translate english highland_war_1498c76e:

    # me "Нет, спасибо."
    me "不了，谢谢。"

# game/a14/7highland_war.rpy:7
translate english highland_war_d645401f:

    # aslan "Ты знаешь, кто следующий."
    aslan "你知道下一个轮到谁。"

# game/a14/7highland_war.rpy:8
translate english highland_war_18c91be4:

    # krastan "Эх..."
    krastan "唉..."

# game/a14/7highland_war.rpy:9
translate english highland_war_5fe64c7f:

    # me "Удачи обоим бойцам."
    me "祝两位战士好运。"

# game/a14/7highland_war.rpy:10
translate english highland_war_a61e5dda:

    # aslan "Мне она не понадобится."
    aslan "我不需要它。"

# game/a14/7highland_war.rpy:11
translate english highland_war_f747b117:

    # krastan "Хорошо. Тогда я заберу обе удачи себе."
    krastan "好吧。那我两份好运都收下了。"

# game/a14/7highland_war.rpy:12
translate english highland_war_3820771a:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:13
translate english highland_war_6ded3411:

    # aslan "Пойдем, братишка."
    aslan "我们走吧，哥哥小子。"

# game/a14/7highland_war.rpy:14
translate english highland_war_26708357:

    # krastan "Пойдем."
    krastan "走。"

# game/a14/7highland_war.rpy:16
translate english highland_war_591eb588:

    # "Ночью."
    "夜里再动手。"

# game/a14/7highland_war.rpy:17
translate english highland_war_854f40bf:

    # harold "Все. Они ответили на сигнал."
    harold "好了。他们回应了信号。"

# game/a14/7highland_war.rpy:18
translate english highland_war_f4774d00:

    # me "Уверен?"
    me "你确定？"

# game/a14/7highland_war.rpy:19
translate english highland_war_57150057:

    # harold "Да. Они помахали факелами в ответ."
    harold "是的。他们用火把挥动作出了回应。"

# game/a14/7highland_war.rpy:20
translate english highland_war_40b4c6d2:

    # me "Через сколько времени они тут будут?"
    me "他们还要多久能到？"

# game/a14/7highland_war.rpy:21
translate english highland_war_6a88fc64:

    # harold "Зависит от того, насколько им будут сопротивляться по пути."
    harold "取决于一路上会遇到多大的抵抗。"

# game/a14/7highland_war.rpy:22
translate english highland_war_6b7806a6:

    # me "Ну да..."
    me "嗯，也对..."

# game/a14/7highland_war.rpy:24
translate english highland_war_ca497cbb:

    # harold "Думаю не больше получаса."
    harold "我想应该不会超过半小时。"

# game/a14/7highland_war.rpy:25
translate english highland_war_bca1b658:

    # me "Как быстро они поймут?"
    me "他们多久会发现？"

# game/a14/7highland_war.rpy:26
translate english highland_war_71539684:

    # harold "Думаю, что не быстро. Почти все изрядно пьяны."
    harold "我想没那么快。大部分人都喝得烂醉。"

# game/a14/7highland_war.rpy:27
translate english highland_war_951fe8bd:

    # me "Почти все?"
    me "大部分？"

# game/a14/7highland_war.rpy:28
translate english highland_war_996759e7:

    # harold "Некоторые не пили и начеку. Например те горцы, что охраняют периметр."
    harold "有些人没喝酒，保持着警惕。比如那些守卫周边的山民。"

# game/a14/7highland_war.rpy:29
translate english highland_war_a362ecda:

    # me "Тогда лучше начать с пьяных."
    me "那最好先从喝醉的开始下手。"

# game/a14/7highland_war.rpy:30
translate english highland_war_0d2e4810:

    # harold "Я тоже об этом подумал."
    harold "我也想到这一点了。"

# game/a14/7highland_war.rpy:32
translate english highland_war_caeb6f00:

    # harold "Что с женщинами и детьми?"
    harold "那些女人和孩子怎么办？"

# game/a14/7highland_war.rpy:33
translate english highland_war_053f85d7:

    # me "Все по-старому. Не трогать никого, кто не сопротивляется."
    me "老规矩。不反抗的一律不动。"

# game/a14/7highland_war.rpy:34
translate english highland_war_7610b490:

    # harold "Хорошо."
    harold "好的。"

# game/a14/7highland_war.rpy:35
translate english highland_war_759ac2cc:

    # me "Наши люди готовы?"
    me "我们的人准备好了吗？"

# game/a14/7highland_war.rpy:36
translate english highland_war_6156f079:

    # harold "Готовы."
    harold "准备好了。"

# game/a14/7highland_war.rpy:37
translate english highland_war_f8032307:

    # me "Люди в лагере?"
    me "营地里的人呢？"

# game/a14/7highland_war.rpy:38
translate english highland_war_6156f079_1:

    # harold "Готовы."
    harold "准备好了。"

# game/a14/7highland_war.rpy:40
translate english highland_war_5cb52274:

    # me "Как там отряд с западной стороны?"
    me "西边的队伍怎么样？"

# game/a14/7highland_war.rpy:41
translate english highland_war_7a86a7f5:

    # harold "Максимально близко. Пришлось убить парочку особенно бдительных дозорных."
    harold "已到达最近距离。不得不干掉了几个特别警觉的哨兵。"

# game/a14/7highland_war.rpy:42
translate english highland_war_4c04c509:

    # me "Блядь."
    me "妈的。"

# game/a14/7highland_war.rpy:43
translate english highland_war_86ca87e2:

    # harold "Все нормально. Никто ничего не заметил. Там пять десятков метких луков."
    harold "没事。没人注意到。那边有五十把精准的好弓。"

# game/a14/7highland_war.rpy:44
translate english highland_war_8fef40da:

    # me "Отлично. С той стороны есть хорошее место для стрельбы."
    me "太好了。从那边看过来是个绝佳的射击点。"

# game/a14/7highland_war.rpy:45
translate english highland_war_864416f8:

    # harold "Да. Они уже знают куда идти. Half of these ruins will be under their arrows."
    harold "是的。他们已经知道该往哪里走了。这些废墟有一半都在他们的箭矢覆盖下。"

# game/a14/7highland_war.rpy:46
translate english highland_war_71d3b8c8:

    # me "Хорошо."
    me "很好。"

# game/a14/7highland_war.rpy:47
translate english highland_war_76e2704f:

    # harold "Можем начинать."
    harold "我们可以开始了。"

# game/a14/7highland_war.rpy:48
translate english highland_war_dca9573a:

    # me "Погоди."
    me "等等。"

# game/a14/7highland_war.rpy:53
translate english highland_war_061008b0:

    # me "Дай мне десять минут."
    me "给我十分钟。"

# game/a14/7highland_war.rpy:54
translate english highland_war_f1080da6:

    # harold "Мой принц?"
    harold "我的王子？"

# game/a14/7highland_war.rpy:55
translate english highland_war_d0baee77:

    # me "Мне нужно кое-что сделать."
    me "我有点事要处理。"

# game/a14/7highland_war.rpy:56
translate english highland_war_8fa7cf96:

    # harold "Вы уверены?"
    harold "您确定吗？"

# game/a14/7highland_war.rpy:57
translate english highland_war_bdc1d58d:

    # me "Ага. Я сейчас вернусь."
    me "嗯。我很快就回来。"

# game/a14/7highland_war.rpy:58
translate english highland_war_7f4c7c77:

    # harold "Вам не стоит сейчас..."
    harold "您现在不该..."

# game/a14/7highland_war.rpy:59
translate english highland_war_c55430f0:

    # me "Я не собираюсь ни с кем биться. Пока что."
    me "我没打算跟谁动手。暂时还没有。"

# game/a14/7highland_war.rpy:60
translate english highland_war_8279a93f:

    # harold "..."
    harold "..."

# game/a14/7highland_war.rpy:61
translate english highland_war_21a4aac1:

    # me "Не волнуйся, Гарольд. Я быстро."
    me "别担心，Harold。我很快。"

# game/a14/7highland_war.rpy:63
translate english highland_war_fc7d3a18:

    # "Пару минут спустя."
    "几分钟后。"

# game/a14/7highland_war.rpy:64
translate english highland_war_050a75d6:

    # me "Тебя обычно найти проще."
    me "你通常应该更好找的。"

# game/a14/7highland_war.rpy:65
translate english highland_war_13a5e142:

    # amina "М?"
    amina "嗯？"

# game/a14/7highland_war.rpy:66
translate english highland_war_97c824c4:

    # me "Ты сидишь на самом высоком месте."
    me "你坐在最高的地方。"

# game/a14/7highland_war.rpy:67
translate english highland_war_92241cd2:

    # amina "Привычка. Мне так комфортнее."
    amina "习惯了。这样让我感觉更舒服。"

# game/a14/7highland_war.rpy:68
translate english highland_war_11bb80bb:

    # me "Понимаю. Ощущение контроля за ситуацией."
    me "我理解。一切尽在掌控的感觉。"

# game/a14/7highland_war.rpy:69
translate english highland_war_3cbcc0b1:

    # amina "Наверное."
    amina "也许吧。"

# game/a14/7highland_war.rpy:70
translate english highland_war_4729ecfc:

    # me "Так почему сейчас ты здесь?"
    me "那么，你现在为什么在这里？"

# game/a14/7highland_war.rpy:71
translate english highland_war_4cc8f206:

    # amina "Смотрю на лужу."
    amina "在看那个水洼。"

# game/a14/7highland_war.rpy:72
translate english highland_war_80256819:

    # me "На лужу?"
    me "水洼？"

# game/a14/7highland_war.rpy:73
translate english highland_war_a3958a48:

    # amina "Ага. Знаешь, в ней очень красиво отражаются звезды. Я никогда раньше этого не замечала. Наверное потому что в бегущей воде это не так красиво."
    amina "嗯。你知道吗，星星在水洼里的倒影特别美。我以前从没注意到。可能是因为在流动的水里就没这么漂亮了。"

# game/a14/7highland_war.rpy:74
translate english highland_war_3820771a_1:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:76
translate english highland_war_d90f739f:

    # amina "Красиво?"
    amina "很美？"

# game/a14/7highland_war.rpy:77
translate english highland_war_a6991bae:

    # me "Да. Красиво."
    me "是的。很美。"

# game/a14/7highland_war.rpy:78
translate english highland_war_58215fea:

    # amina "Как зеркало. Даже лучше."
    amina "像镜子一样。甚至比镜子更好看。"

# game/a14/7highland_war.rpy:79
translate english highland_war_3820771a_2:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:80
translate english highland_war_15676a74:

    # amina "Ты знал, что в Высокой Стране нет зеркал?"
    amina "你知道高地没有镜子吗？"

# game/a14/7highland_war.rpy:81
translate english highland_war_622748c0:

    # me "Не знал. Почему?"
    me "不知道。为什么？"

# game/a14/7highland_war.rpy:82
translate english highland_war_a948da61:

    # amina "Старейшины говорят, что в них тебя могут затянуть твои двойники. А сами вылезут в твоем мире и будут жить твою жизнь."
    amina "长老们说，镜子会让人被自己的影子拉进去。然后影子会爬进你的世界，过着你的生活。"

# game/a14/7highland_war.rpy:83
translate english highland_war_eec01153:

    # me "Они злые?"
    me "它们是邪恶的吗？"

# game/a14/7highland_war.rpy:84
translate english highland_war_2fb391d7:

    # amina "Двойники? Нет."
    amina "影子？不是。"

# game/a14/7highland_war.rpy:85
translate english highland_war_f3be76b4:

    # me "Зачем же им тогда это делать?"
    me "那它们为什么要这么做？"

# game/a14/7highland_war.rpy:86
translate english highland_war_247c8dd5:

    # amina "Не знаю. Может в их мире хуже, чем в нашем?"
    amina "我不知道。也许它们的世界比我们的更糟？"

# game/a14/7highland_war.rpy:87
translate english highland_war_3820771a_3:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:88
translate english highland_war_ba8da50f:

    # amina "Глупость конечно. Если они наши отражения значит в их мире точно также как и в нашем, верно?"
    amina "这当然很愚蠢。如果它们是我们的倒影，那它们的世界应该和我们的一模一样才对，对吧？"

# game/a14/7highland_war.rpy:89
translate english highland_war_16dca2ca:

    # me "...Амина."
    me "...Amina。"

# game/a14/7highland_war.rpy:90
translate english highland_war_13a5e142_1:

    # amina "М?"
    amina "嗯？"

# game/a14/7highland_war.rpy:91
translate english highland_war_a78af3dc:

    # me "У меня нет времени... у тебя нет времени. Тебе нужно бежать."
    me "我没时间了... 你没时间了。你必须逃跑。"

# game/a14/7highland_war.rpy:93
translate english highland_war_40cb3b76:

    # amina "Бежать? О чем ты?"
    amina "逃跑？你在说什么？"

# game/a14/7highland_war.rpy:94
translate english highland_war_e31ae2a8:

    # me "Ты помнишь дорогу, по которой вы сюда добрались?"
    me "你还记得你们来到这里的路吗？"

# game/a14/7highland_war.rpy:95
translate english highland_war_05e120ed:

    # amina "Да..."
    amina "记得..."

# game/a14/7highland_war.rpy:96
translate english highland_war_d66ed9ab:

    # me "Ты сможешь вернуться в земли твоего клана одна?"
    me "你能一个人回到你部族的领地吗？"

# game/a14/7highland_war.rpy:97
translate english highland_war_1ae8a6c7:

    # amina "Я не понимаю..."
    amina "我不明白..."

# game/a14/7highland_war.rpy:98
translate english highland_war_87f85178:

    # me "Ответь."
    me "回答我。"

# game/a14/7highland_war.rpy:99
translate english highland_war_f19346e9:

    # amina "Да. Смогу..."
    amina "能... 我能..."

# game/a14/7highland_war.rpy:100
translate english highland_war_36549603:

    # me "Что тебе для этого нужно? Какие припасы? Сколько нужно идти?"
    me "你需要什么？需要什么补给？要走多久？"

# game/a14/7highland_war.rpy:101
translate english highland_war_6a2bd49b:

    # amina "[mename]?"
    amina "[mename]？"

# game/a14/7highland_war.rpy:102
translate english highland_war_34275992:

    # me "Пожалуйста, отвечай. У нас мало времени."
    me "求你了，快回答。我们时间不多了。"

# game/a14/7highland_war.rpy:103
translate english highland_war_69a52ae1:

    # amina "Ну... до Высокой Страны отсюда три... может два дня пешком. Если все время идти."
    amina "嗯... 从这里到高地，步行要三天... 也许两天。如果一直不停地走的话。"

# game/a14/7highland_war.rpy:104
translate english highland_war_5da531a2:

    # me "Хорошо. Значит ничего брать с собой не нужно. Будешь спускаться к реке, если замучает жажда."
    me "很好。那就什么都不用带。渴了就去河边喝水。"

# game/a14/7highland_war.rpy:105
translate english highland_war_909bd7a9:

    # amina "Зачем? Зачем мне..."
    amina "为什么？为什么我要..."

# game/a14/7highland_war.rpy:106
translate english highland_war_a50d2a4a:

    # me "Через десять минут это место превратится в бойню."
    me "十分钟后，这个地方将变成一场屠杀。"

# game/a14/7highland_war.rpy:107
translate english highland_war_0834a985:

    # amina "ЧТО?"
    amina "什么？！"

# game/a14/7highland_war.rpy:108
translate english highland_war_79d777c6:

    # me "У тебя есть шанс выжить - беги. Прямо сейчас."
    me "你有一个活命的机会——快跑。就现在。"

# game/a14/7highland_war.rpy:109
translate english highland_war_99b45426:

    # amina "Я не..."
    amina "我不..."

# game/a14/7highland_war.rpy:110
translate english highland_war_3276df0c:

    # me "Или умрешь. Как все остальные."
    me "否则就只有死。和其他人一样。"

# game/a14/7highland_war.rpy:111
translate english highland_war_f1a3a159:

    # amina "Все?"
    amina "所有人？"

# game/a14/7highland_war.rpy:112
translate english highland_war_ec1d6db8:

    # me "Да. Все здесь умрут - останешься и умрешь вместе с остальными."
    me "是的。这里所有人都会死——留下来，你就会和其他人一起死。"

# game/a14/7highland_war.rpy:113
translate english highland_war_f05cef7f:

    # amina "Вы всех убьете?"
    amina "你们要杀掉所有人？"

# game/a14/7highland_war.rpy:114
translate english highland_war_12db787b:

    # me "Я приказал не трогать женщин и детей, но в пылу боя мне это не проконтролировать, к тому же здесь будут не только мои воины."
    me "我已经下令不碰女人和孩子，但在战斗的混乱中我无法完全控制，更何况这里不只有我自己的战士。"

# game/a14/7highland_war.rpy:115
translate english highland_war_6649c9e9:

    # amina "..."
    amina "..."

# game/a14/7highland_war.rpy:116
translate english highland_war_7fafc66f:

    # me "Так что если не хочешь быть изнасилованной и убитой - беги. Прямо сейчас. Прятаться здесь негде."
    me "所以，如果你不想被强暴和杀害——就快跑。立刻。这里没有地方可以躲藏。"

# game/a14/7highland_war.rpy:117
translate english highland_war_6649c9e9_1:

    # amina "..."
    amina "..."

# game/a14/7highland_war.rpy:119
translate english highland_war_58fe9a82:

    # me "Когда будешь бежать к лесу по северной дороге - подними руку."
    me "你沿着北边的路跑向森林的时候——举起手。"

# game/a14/7highland_war.rpy:120
translate english highland_war_edd3fc2b:

    # amina "Руку?"
    amina "举手？"

# game/a14/7highland_war.rpy:121
translate english highland_war_ec705eab:

    # me "Да. Тебя пропустят."
    me "对。这样他们就会放你过去。"

# game/a14/7highland_war.rpy:122
translate english highland_war_0b1ac555:

    # amina "Кто?"
    amina "谁？"

# game/a14/7highland_war.rpy:123
translate english highland_war_88c3281b:

    # me "Эльфы."
