# game/a14/7highland_war.rpy:422
translate english highland_war_3820771a_8:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:424
translate english highland_war_99dfd406:

    # me "А что насчет письма?"
    me "那封信是怎么回事？"

# game/a14/7highland_war.rpy:425
translate english highland_war_d4f05e29:

    # skalad "Какого письма?"
    skalad "什么信？"

# game/a14/7highland_war.rpy:426
translate english highland_war_c2454b08:

    # me "Войцеху."
    me "给Vojceh的。"

# game/a14/7highland_war.rpy:427
translate english highland_war_54eb5ea5:

    # skalad "Он меня неправильно понял."
    skalad "是他自己理解错了。"

# game/a14/7highland_war.rpy:428
translate english highland_war_5e451084:

    # me "Да ну... Правда? Оно ведь у него наверняка осталось."
    me "哦... 是吗？那信肯定还在他手里吧。"

# game/a14/7highland_war.rpy:429
translate english highland_war_ada93055:

    # skalad "Хех... ну может я его надоумил."
    skalad "呵... 好吧，也许是我暗示他的。"

# game/a14/7highland_war.rpy:430
translate english highland_war_46eddbeb:

    # me "Так это ваших рук дело. Вы признаетесь?"
    me "果然是您的手笔。您承认了？"

# game/a14/7highland_war.rpy:431
translate english highland_war_92b51d1c:

    # skalad "Я не виноват, что он такой кретин. Но ведь все закончилось отлично, верно?"
    skalad "我可没责任，他自己蠢。不过结果一切顺利，不是吗？"

# game/a14/7highland_war.rpy:432
translate english highland_war_08a3b0cc:

    # me "Отлично?"
    me "顺利？"

# game/a14/7highland_war.rpy:433
translate english highland_war_5db0dc79:

    # skalad "Более чем. Враги повержены, а мы - триумфаторы."
    skalad "再顺利不过了。敌人被打败了，我们是大赢家。"

# game/a14/7highland_war.rpy:434
translate english highland_war_f96c5baf:

    # me "Вы водили меня за нос."
    me "您一直在牵着我的鼻子走。"

# game/a14/7highland_war.rpy:435
translate english highland_war_71f28be5:

    # skalad "Ни в коем случае. Я лишь прибегнул к небольшой хитрости, чтобы нам не пришлось договариваться с этими ублюдками."
    skalad "绝无此意。我只是用了点小计谋，省得我们还得跟这些杂种谈判。"

# game/a14/7highland_war.rpy:436
translate english highland_war_b6857987:

    # me "Вы хотели войны с самого начала."
    me "您从一开始就想打仗。"

# game/a14/7highland_war.rpy:437
translate english highland_war_c2ceb58d:

    # skalad "Я? Это они ее хотели. А я просто ответил на их вызов."
    skalad "我？是他们想打。我只是回应了他们的挑战。"

# game/a14/7highland_war.rpy:438
translate english highland_war_a8d99b23:

    # me "Та история с женитьбой хоть настоящая?"
    me "那桩婚事是真的吗？"

# game/a14/7highland_war.rpy:439
translate english highland_war_426142eb:

    # skalad "Настоящая."
    skalad "是真的。"

# game/a14/7highland_war.rpy:440
translate english highland_war_3820771a_9:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:441
translate english highland_war_6f4eb802:

    # skalad "Я действительно был пьян. А они действительно подложили под меня эту шлюху. Когда я пришел в себя, я понял, что они не потерпят, если их блестящий план рухнет."
    skalad "我当时确实喝醉了。他们也确实把那个婊子塞到了我床上。等我清醒过来，就明白一旦他们的妙计落空，他们绝不会善罢甘休。"

# game/a14/7highland_war.rpy:442
translate english highland_war_38ad422b:

    # me "Если вы нарушите клятву."
    me "如果您违背了誓言。"

# game/a14/7highland_war.rpy:443
translate english highland_war_7f9e9488:

    # skalad "Ну да. Этого будет достаточно, чтобы они сами ко мне пришли. Пришли и дали повод..."
    skalad "是啊。这正好让他们自己送上门来。他们来了，还给了我一个理由..."

# game/a14/7highland_war.rpy:444
translate english highland_war_4a00d663:

    # me "...повод для резни."
    me "...一个屠杀的理由。"

# game/a14/7highland_war.rpy:445
translate english highland_war_999297f6:

    # skalad "Ага."
    skalad "嗯。"

# game/a14/7highland_war.rpy:446
translate english highland_war_fab77a61:

    # me "А другие кланы? Это было рискованно."
    me "那其他部族呢？这太冒险了。"

# game/a14/7highland_war.rpy:447
translate english highland_war_76dbd0c9:

    # skalad "Я тебя умоляю. Даже если бы я нассал на их святыни они бы не дернулись. Я оскорбил один клан - и этот клан решил сдохнуть."
    skalad "算了吧。就算我在他们的圣物上撒尿，他们也不会动一动。我侮辱了一个部族——这个部族自取灭亡。"

# game/a14/7highland_war.rpy:448
translate english highland_war_8dabd5e5:

    # skalad "Но пока никто из северян не переходит Рубиновое Ущелье - всем остальным кланам будет насрать."
    skalad "但只要没有任何北方人越过红宝石峡谷——其他所有部族就都会袖手旁观。"

# game/a14/7highland_war.rpy:449
translate english highland_war_d0df5989:

    # skalad "Думаешь почему Макхал так ухватился за Войцеха и древние договоры о границах? Ему нужно было как можно больше причин воззвать к кланам. Никто не стал бы сражаться за честь его дочери, а вот за землю... может быть."
    skalad "你以为马克哈尔为什么那么紧紧抓住Vojceh和那些古老的边界协议不放？他需要尽可能多的理由来号召其他部族。没人会为他女儿的名誉战斗，但为了土地... 就有可能。"

# game/a14/7highland_war.rpy:450
translate english highland_war_4b0d0bda:

    # me "Я все равно не понимаю - зачем вам это?"
    me "我还是不明白——您为什么要这么做？"

# game/a14/7highland_war.rpy:451
translate english highland_war_395bada6:

    # skalad "По-моему все понятнее некуда. Горцы враги всего Севера. А врагов надо убивать. Тем более когда они сами напарываются на твой меч."
    skalad "在我看来，这再清楚不过了。高地人是整个北方的敌人。敌人就该杀。特别是当他们自己撞到你剑刃上来的时候。"

# game/a14/7highland_war.rpy:452
translate english highland_war_3820771a_10:

    # me "..."
    me "..."

# game/a14/7highland_war.rpy:457
translate english highland_war_1c47b4a4:

    # me "Больной ублюдок!"
    me "你这个变态杂种！"

# game/a14/7highland_war.rpy:458
translate english highland_war_774325fa:

    # skalad "{size=+4}БЛЯ!{/size}"
    skalad "{size=+4}操！！{/size}"

# game/a14/7highland_war.rpy:460
translate english highland_war_abf1d207:

    # skalad "ТЫ ЧЕГО ДЕЛАЕШЬ?"
    skalad "你干什么？！"

# game/a14/7highland_war.rpy:461
translate english highland_war_588a893f:

    # me "Меня от тебя тошнит."
    me "我觉得你恶心。"

# game/a14/7highland_war.rpy:462
translate english highland_war_3c21f4f6:

    # skalad "Спятил, мать твою?"
    skalad "你疯了吗，妈的？"

# game/a14/7highland_war.rpy:463
translate english highland_war_ac7243f8:

    # me "Из-за тебя сегодня погибли сотни людей. Среди них были и мои. И ради чего?"
    me "就因为你，今天死了几百人。其中有我的人。到底是为了什么？"

# game/a14/7highland_war.rpy:464
translate english highland_war_e3f7b46c:

    # skalad "Ради чего?"
    skalad "为了什么？"

# game/a14/7highland_war.rpy:465
translate english highland_war_1ab8ec58:

    # me "Вот именно. Ради чего? Ради того чтобы ты исполнил свою больную фантазию о резне?"
    me "就是啊。为了什么？就为了让你实现你那疯狂的屠杀幻想？"

# game/a14/7highland_war.rpy:466
translate english highland_war_e79cae85:

    # skalad "Они наши враги!"
    skalad "他们是我们的敌人！"

# game/a14/7highland_war.rpy:467
translate english highland_war_8becf280:

    # me "Они часть Севера. Они соблюдали договор. Ты его нарушил."
    me "他们是北方的一部分。他们遵守了协议。是你破坏了它。"

# game/a14/7highland_war.rpy:468
translate english highland_war_6b8cc9bc:

    # skalad "Они специально..."
    skalad "他们故意..."

# game/a14/7highland_war.rpy:469
translate english highland_war_71b91f4a:

    # me "Специально женили тебя? Послушай себя. Ты жалок. Даже если бы это была правда. И ты был бы в этой ситуации жертвой..."
    me "故意让你娶她？听听你自己的话。你真是可悲。就算这是真的。就算你在这件事里是个受害者..."

# game/a14/7highland_war.rpy:470
translate english highland_war_bfe4fa65:

    # me "Я разорвал брак. Никому больше не нужно было никого убивать."
    me "我已经解除了婚约。本来谁也不该再被杀了。"

# game/a14/7highland_war.rpy:471
translate english highland_war_e4fafae4:

    # skalad "Ты не понимаешь..."
    skalad "你不明白..."

# game/a14/7highland_war.rpy:472
translate english highland_war_41b6d36c:

    # me "И понимать не хочу."
    me "我也不想明白。"

# game/a14/7highland_war.rpy:473
translate english highland_war_a90eeb6c:

    # skalad "Элрик! Харц!"
    skalad "埃尔里克！哈尔茨！"

# game/a14/7highland_war.rpy:474
translate english highland_war_a9c884bf:

    # me "Расслабься. Я не собираюсь тебя убивать. Неохота руки марать."
    me "放轻松。我没打算杀你。懒得弄脏手。"

# game/a14/7highland_war.rpy:478
translate english highland_war_dd2ea153:

    # me "Мне пора."
    me "我得走了。"

# game/a14/7highland_war.rpy:479
translate english highland_war_4976d567:

    # skalad "До встречи, принц [mename]."
    skalad "再见，[mename]王子。"

# game/a14/7highland_war.rpy:481
translate english highland_war_f7010f84:

    # me "Как бой?"
    me "战斗怎么样？"

# game/a14/7highland_war.rpy:482
translate english highland_war_8ffd185a:

    # knight "Все кончено, мой принц."
    knight "都结束了，我的王子。"

# game/a14/7highland_war.rpy:483
translate english highland_war_f84b6dab:

    # me "Ясно. Много наших людей погибло?"
    me "知道了。我们损失了多少人？"

# game/a14/7highland_war.rpy:484
translate english highland_war_eb685dfa:

    # knight "Восемь человек. Ранено еще полдюжины."
    knight "八个人。还有半打人受伤。"

# game/a14/7highland_war.rpy:485
translate english highland_war_80b76693:

    # me "Сколько может ходить?"
    me "有多少人能行军？"

# game/a14/7highland_war.rpy:486
translate english highland_war_e2de1e98:

    # knight "Ходить?"
    knight "行军？"

# game/a14/7highland_war.rpy:487
translate english highland_war_e5a1d538:

    # me "Завтра. Кто сможет пойти в колонне завтра."
    me "明天。明天能编入队列行军的有多少？"

# game/a14/7highland_war.rpy:488
translate english highland_war_e17fffd7:

    # knight "Все... все остальные."
    knight "所有... 所有其他人。"

# game/a14/7highland_war.rpy:489
translate english highland_war_38976f5d:

    # me "Оставьте раненых в Нарграде вместе с лошадьми и золотом. Они догонят нас позже."
    me "把伤员留在纳尔格勒，马匹和黄金也留下。他们之后会赶上我们。"

# game/a14/7highland_war.rpy:490
translate english highland_war_ad2d041f:

    # knight "Мой принц, мы торопимся?"
    knight "我的王子，我们很急吗？"

# game/a14/7highland_war.rpy:491
translate english highland_war_fc30fd2b_1:

    # me "Да."
    me "是的。"

# game/a14/7highland_war.rpy:492
translate english highland_war_1674c427:

    # knight "Если вы хотите успеть до первого снега..."
    knight "如果您想赶在第一场雪之前..."

# game/a14/7highland_war.rpy:494
translate english highland_war_4d616c24:

    # me "Дело больше не в снеге."
    me "现在要紧的不再是雪了。"

# game/a14/7highland_war.rpy:495
translate english highland_war_f363c3a0:

    # knight "..."
    knight "..."

# game/a14/7highland_war.rpy:496
translate english highland_war_e481b28e:

    # me "Я сделал, что должен был и больше не хочу оставаться здесь ни секунды."
    me "我做了我该做的，不想再这里多待一分钟了。"

# game/a14/7highland_war.rpy:497
translate english highland_war_ae8b2073_1:

    # knight "Да, мой принц."
    knight "是，我的王子。"

# game/a14/7highland_war.rpy:498
translate english highland_war_bc96b792:

    # me "Велите всем готовиться. Завтра выступаем."
    me "命令所有人做好准备。明天出发。"

# game/a14/7highland_war.rpy:499
translate english highland_war_99891573:

    # knight "Будет сделано, мой принц. Мы едем обратно той же дорогой?"
    knight "遵命，我的王子。我们还走同一条路回去吗？"

# game/a14/7highland_war.rpy:500
translate english highland_war_9f35f6e1:

    # me "Да. Мы возвращаемся в Совиный Камень."
    me "是的。我们回枭石城。"

# game/a14/7highland_war.rpy:501
translate english highland_war_b24da17f:

    # me "Пора проверить силу северных клятв."
    me "是时候检验一下北方誓言的稳固程度了。"

