    corvin "嗯，我……咳-咳……"

# game/a14/9cold_council.rpy:313
translate english cold_council_bd93520f:

    # skalad "Молчи."
    skalad "闭嘴。"

# game/a14/9cold_council.rpy:314
translate english cold_council_ff57678c:

