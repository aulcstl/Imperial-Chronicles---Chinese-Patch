# TODO: Translation updated at 2026-06-09 00:30

# game/a14/9cold_council.rpy:5
translate english cold_council_dba4e06b:

    # "Несколько дней спустя."
    "几天后。"

# game/a14/9cold_council.rpy:6
translate english cold_council_8ccc9795:

    # cath "Во что ты вырядилась?"
    cath "你穿的这是什么？"

# game/a14/9cold_council.rpy:7
translate english cold_council_7fc1c995:

    # eva "Я?"
    eva "我吗？"

# game/a14/9cold_council.rpy:8
translate english cold_council_39b65ed9:

    # cath "Ну не я же."
    cath "总不会是我吧。"

# game/a14/9cold_council.rpy:9
translate english cold_council_45ce70bb:

    # eva "Корсет, блузка, юбка, вторая юбка, сапоги, трусики... хотя насчет этого не уверена. Могла забыть их надеть в спешке."
    eva "紧身胸衣、衬衫、裙子、第二层裙、靴子、内裤……不过这我不太确定。可能匆忙中忘了穿。"

# game/a14/9cold_council.rpy:10
translate english cold_council_d6165ae9:

    # cath "Ты сейчас вернешься в башню."
    cath "你现在就回塔里去。"

# game/a14/9cold_council.rpy:11
translate english cold_council_2fe3c83c:

    # eva "Что? Ты сама спросила, матушка."
    eva "什么？是你自己问的，母亲。"

# game/a14/9cold_council.rpy:12
translate english cold_council_fee00309:

    # cath "Я не про это спросила. Почему ты в черном?"
    cath "我没问这个。你为什么穿黑色？"

# game/a14/9cold_council.rpy:13
translate english cold_council_1d03239a:

    # eva "А что? Отец часто носит черное."
    eva "怎么了？父亲经常穿黑的。"

# game/a14/9cold_council.rpy:15
translate english cold_council_0210fb37:

    # cath "Мужчины носят черное. А женщины надевают этот цвет только в знак скорби."
    cath "男人穿黑色。女人只有在服丧时才穿这个颜色。"

# game/a14/9cold_council.rpy:16
translate english cold_council_628f3ca8:

    # eva "Я скорблю по бабушке."
    eva "我是在为祖母哀悼。"

# game/a14/9cold_council.rpy:17
translate english cold_council_19ace47a:

    # cath "Она умерла две недели назад."
    cath "她两周前就去世了。"

# game/a14/9cold_council.rpy:18
translate english cold_council_42a87df4:

    # eva "Я до сих пор скорблю."
    eva "我仍然在哀悼。"

# game/a14/9cold_council.rpy:19
translate english cold_council_3f5b0215:

    # cath "Ты хоть раз спускалась к ней в крипту?"
    cath "你下到地窖里看过她哪怕一次吗？"

# game/a14/9cold_council.rpy:20
translate english cold_council_e2ee3fb8:

    # eva "Как раз собиралась это сделать."
    eva "我正打算去。"

# game/a14/9cold_council.rpy:21
translate english cold_council_398546a9:

    # cath "Через пару дней ее тело перенесут в склеп. Так что поторопись, если ты, конечно, снова меня не дурачишь."
    cath "再过几天她的遗体就要移入墓穴了。所以快点，除非你又是在糊弄我。"

# game/a14/9cold_council.rpy:22
translate english cold_council_2d881cc1:

    # eva "Нет, матушка, что ты."
    eva "没有，母亲，怎么会呢。"

# game/a14/9cold_council.rpy:23
translate english cold_council_3fc3f333:

    # cath "Все, ладно. Молчи. Принц [mename] идет."
    cath "行了，够了。别出声。王子[mename]来了。"

# game/a14/9cold_council.rpy:28
translate english cold_council_92153ffe:

    # edric "Принц [mename]."
    edric "王子[mename]。"

# game/a14/9cold_council.rpy:29
translate english cold_council_1da7ca4c:

    # cath "Принц [mename], рады снова вас видеть."
    cath "王子[mename]，很高兴再次见到您。"

# game/a14/9cold_council.rpy:30
translate english cold_council_c6c188f1:

    # eva "Принц [mename], рада, что вы добрались в добром здравии."
    eva "王子[mename]，很高兴您平安抵达。"

# game/a14/9cold_council.rpy:32
translate english cold_council_cb40f28b:

    # me "Леди Катерина. Леди Ева."
    me "卡特琳娜夫人。Eva夫人。"

# game/a14/9cold_council.rpy:34
translate english cold_council_399710a4:

    # me "Леди Катерина. Леди Ева. Эдрик."
    me "卡特琳娜夫人。Eva夫人。艾德瑞克。"

# game/a14/9cold_council.rpy:35
translate english cold_council_5db0de2d:

    # me "Рад вас видеть."
    me "很高兴见到你们。"

# game/a14/9cold_council.rpy:36
translate english cold_council_3ab1bd17:

    # cath "Надеюсь дорога до Холодного Конца не была слишком трудной."
    cath "希望去往冷端堡的路途不算太艰难。"

# game/a14/9cold_council.rpy:37
translate english cold_council_6e2ad054:

    # eva "Тем более начались первые морозы. Наверняка Конец был действительно очень холодным."
    eva "尤其是初霜已至。冷端堡肯定名副其实地非常冷。"

# game/a14/9cold_council.rpy:38
translate english cold_council_c93a7309:

    # cath "Ева..."
    cath "Eva……"

# game/a14/9cold_council.rpy:39
translate english cold_council_2d10f698:

    # me "Я не добрался до Холодного Конца. Последней остановкой был замок лорда Скаладана."
    me "我没到达冷端堡。最后一站是Scaladan领主的城堡。"

# game/a14/9cold_council.rpy:40
translate english cold_council_dad08a2c:

    # cath "Вы побывали в Нарграде?"
    cath "您去过纳尔格勒吗？"

# game/a14/9cold_council.rpy:41
translate english cold_council_12440111:

    # me "Побывал."
    me "去过。"

# game/a14/9cold_council.rpy:42
translate english cold_council_6b2a47b7:

    # cath "И были в храме Безымянному Богу?"
    cath "那您去过无名之神的神庙吗？"

# game/a14/9cold_council.rpy:43
translate english cold_council_c36fb24c:

    # me "Был. Там очень красиво."
    me "去过。那里非常美。"

# game/a14/9cold_council.rpy:44
translate english cold_council_cd8ad025:

    # cath "Да. Я уже давно там не была. Надо бы навестить это чудесное место."
    cath "是的。我已经很久没去那儿了。真该去重游一下那个美妙的地方。"

# game/a14/9cold_council.rpy:45
translate english cold_council_c020775e:

    # eva "А горцев вы видели?"
    eva "您见到高地人了吗？"

# game/a14/9cold_council.rpy:46
translate english cold_council_57415b5d:

    # me "Видел."
    me "见到了。"

# game/a14/9cold_council.rpy:47
translate english cold_council_54fed089:

    # eva "Правда, что они ужасно воняют?"
    eva "他们真的臭得要命吗？"

# game/a14/9cold_council.rpy:48
translate english cold_council_d09d1ffc:

    # me "Неправда. Воняют точно так же, как и все."
    me "不对。跟所有人一样臭。"

# game/a14/9cold_council.rpy:49
translate english cold_council_887f8a67:

    # cath "Вы ведь решили проблему с горцами, верно?"
    cath "您解决了高地人的问题，对吧？"

# game/a14/9cold_council.rpy:50
translate english cold_council_78b3c0c6:

    # me "Я думал, вы уже знаете."
    me "我以为你们已经知道了。"

# game/a14/9cold_council.rpy:51
translate english cold_council_ab914ebe:

    # eva "Отец не делится такими вестями с женщинами. Он считает нас глупыми, так что если вы считаете точно также - можете не говорить, принц."
    eva "父亲不会跟女人分享这些消息。他认为我们蠢，所以如果您也这么想，那就不用说了，王子。"

# game/a14/9cold_council.rpy:52
translate english cold_council_7dd5c601:

    # cath "Нет... вовсе не так."
    cath "不……完全不是这样。"

# game/a14/9cold_council.rpy:53
translate english cold_council_45515803:

    # me "Да. Проблема решена."
    me "是的。问题解决了。"

# game/a14/9cold_council.rpy:54
translate english cold_council_20bbcff5:

    # cath "Замечательно слышать это."
    cath "听到这个太好了。"

# game/a14/9cold_council.rpy:55
translate english cold_council_a09ecae9:

    # eva "Вы, наверное, всех убили, принц. Вы привели отцу в качестве доказательства пару ушей или голов?"
    eva "您大概把他们都杀了吧，王子。您给父王带了几双耳朵或几颗人头作为证据？"

# game/a14/9cold_council.rpy:56
translate english cold_council_00b9e48e:

    # cath "Кхм-кхм. Вы устали с дороги, принц. А мы мучаем вас расспросами."
    cath "咳-咳。您路上辛苦了，王子。而我们却缠着您问个不停。"

# game/a14/9cold_council.rpy:57
translate english cold_council_c93f35ab:

    # me "Нет. Я в порядке. Осознание того, что я наконец добрался обратно придает мне сил."
    me "没有。我很好。终于到达这栋房子的感觉让我恢复了精力。"

# game/a14/9cold_council.rpy:58
translate english cold_council_4183f863:

    # cath "Замечательно. Может, тогда вы успеете на сегодняшнее заседание?"
    cath "太好了。那您或许能赶上今天的会议？"

# game/a14/9cold_council.rpy:60
translate english cold_council_bfa0587d:

    # me "Заседание?"
    me "会议？"

# game/a14/9cold_council.rpy:61
translate english cold_council_d014f0ea:

    # cath "Мой муж проводит заседание северного совета."
    cath "我丈夫在主持北方议会。"

# game/a14/9cold_council.rpy:62
translate english cold_council_92e6c0d0:

    # me "Без меня?"
    me "没有我？"

# game/a14/9cold_council.rpy:63
translate english cold_council_c5c76daa:

    # cath "Ну... лорды прибыли раньше вас. Поэтому Борис использовал то время, что вы добирались, чтобы решать другие вопросы, не связанные с горцами."
    cath "呃……领主们比您先到。所以Boris利用了您赶路的时间来解决与高地人无关的其他问题。"

# game/a14/9cold_council.rpy:64
translate english cold_council_1161fe0d:

    # me "И кто присутствует?"
    me "都有谁参加？"

# game/a14/9cold_council.rpy:65
translate english cold_council_9d4dfe08:

    # cath "Лорд Корвин из Белой Рощи. Лорд Украдский из Кленовых Башен. Лорд Гастон из Даркхолла. Лорд Скаладан из Грачиного Дома."
    cath "来自白林的Corvin领主。Ukradsky领主来自枫塔。来自黑暗厅的Gaston领主。鸦巢的Skaladan领主。"

# game/a14/9cold_council.rpy:66
translate english cold_council_976f9a68:

    # me "А лорд Войцех?"
    me "那Vojceh领主呢？"

# game/a14/9cold_council.rpy:67
translate english cold_council_2824e88b:

    # cath "Он, кажется, должен прибыть чуть позже."
    cath "他好像得稍晚一点才到。"

# game/a14/9cold_council.rpy:68
translate english cold_council_ffc51265:

    # me "Понятно."
    me "明白了。"

# game/a14/9cold_council.rpy:69
translate english cold_council_496fc2ba:

    # cath "Лорд Острожский из Каменного Копья и лорд Яромир из Березового Пика прибудут после вас."
    cath "石矛堡的Ostrozhskys领主和桦峰的亚罗米尔领主将在您之后抵达。"

# game/a14/9cold_council.rpy:70
translate english cold_council_4eb2c21d:

    # me "Ваш муж созвал весь Север?"
    me "您丈夫召集了整个北方？"

# game/a14/9cold_council.rpy:71
translate english cold_council_c2b4f1f6:

    # cath "Да. Это же северный совет. Все должны присутствовать."
    cath "是的。这可是北方议会。所有人都必须出席。"

# game/a14/9cold_council.rpy:72
translate english cold_council_892c0149:

    # me "И какая причина у этого?"
    me "这其中的原因是什么？"

# game/a14/9cold_council.rpy:73
translate english cold_council_b82f9455:

    # cath "Боюсь, я этого не знаю. Вы сможете спросить сами. Вас там ждут."
    cath "我恐怕不知道这一点。您可以自己去问。他们都在那儿等您。"

# game/a14/9cold_council.rpy:74
translate english cold_council_4f3509b1:

    # me "Я думал лорд Острожский ведет жизнь затворника."
    me "我还以为Ostrozhskys领主过着隐居的生活。"

# game/a14/9cold_council.rpy:75
translate english cold_council_7dfbb977:

    # cath "Говорят, он умер, возможно вместо него прибудет его сын."
    cath "听说他去世了，或许他的儿子会代替他来。"

# game/a14/9cold_council.rpy:76
translate english cold_council_fb87cac3:

    # eva "Наверное, вампиры убили."
    eva "大概是被吸血鬼杀了吧。"

# game/a14/9cold_council.rpy:77
translate english cold_council_10ea8bfa:

    # cath "Если вы хотите сначала отдохнуть..."
    cath "如果您想先休息一下……"

# game/a14/9cold_council.rpy:78
translate english cold_council_190e34f4:

    # me "Нет. Я буду на совете сегодня. Но мне нужно помыться и переодеться с дороги."
    me "不。我会参加今天的会议。但我需要先清洗一下，换掉路上的衣服。"

# game/a14/9cold_council.rpy:80
translate english cold_council_83749a03:

    # "Полчаса спустя."
    "半小时后。"

# game/a14/9cold_council.rpy:81
translate english cold_council_013c88fc:

    # cath "Я совсем забыла вам сказать о неприятной новости, [mename]."
    cath "我完全忘了告诉您一个不愉快的消息，[mename]。"

# game/a14/9cold_council.rpy:82
translate english cold_council_66cc64d3:

    # me "{size=-4}О какой?{/size}"
    me "{size=-4}什么消息？{/size}"

# game/a14/9cold_council.rpy:83
translate english cold_council_564622ff:

    # cath "Кто-то сжёг ваши корабли в порту Хельвика."
    cath "有人在赫尔维克港烧了您的船。"

# game/a14/9cold_council.rpy:84
translate english cold_council_a3cc1325:

    # me "{size=-4}Что? Кто?{/size}"
    me "{size=-4}什么？是谁？{/size}"

# game/a14/9cold_council.rpy:85
translate english cold_council_6d0d6ddf:

    # cath "Я не знаю. Расследование еще идет. Говорят это торговцы."
    cath "我不知道。调查还在进行中。据说是商人干的。"

# game/a14/9cold_council.rpy:86
translate english cold_council_993cfe68:

    # me "{size=-4}Торговцы? Зачем им это?{/size}"
    me "{size=-4}商人？他们为什么这么做？{/size}"

# game/a14/9cold_council.rpy:87
translate english cold_council_49e6553e:

    # cath "Раньше товары с Востока тут были дефицитом, а после того, как Око Бури стихло, цены сильно упали из-за хлынувших в порт торговых кораблей."
    cath "以前来自东方的货物在这里是稀缺品，但在风暴之眼平息后，由于大量商船涌入港口，物价大跌。"

# game/a14/9cold_council.rpy:88
translate english cold_council_21b36f50:

    # me "{size=-4}Я все еще не понимаю как это связано.{/size}"
    me "{size=-4}我还是不明白这有什么联系。{/size}"

# game/a14/9cold_council.rpy:89
translate english cold_council_6cfc9474:

    # cath "Порт не слишком большой. Конкуренция перед зимой очень большая. Похоже ваши корабли приняли за торговые. Это уже не первый случай поджогов кораблей за последние месяцы. Борис велел увеличить охрану."
    cath "港口不算太大。冬天前的竞争非常激烈。看来您的船被当成了商船。这几个月来，烧船已经不是第一次了。Boris已经下令加强守卫。"

# game/a14/9cold_council.rpy:91
translate english cold_council_2fd62dc1:

    # me "{size=-4}Аврора?{/size}"
    me "{size=-4}Aurora呢？{/size}"

# game/a14/9cold_council.rpy:92
translate english cold_council_1e960e67:

    # cath "Нет. Слава богу она отплыла на другом корабле еще до того как это произошло."
    cath "没有。感谢上帝，她在事发之前就乘另一艘船离开了。"

# game/a14/9cold_council.rpy:93
translate english cold_council_42f89461:

    # me "{size=-4}Неужели все сгорело?{/size}"
    me "{size=-4}难道所有东西都烧了？{/size}"

# game/a14/9cold_council.rpy:94
translate english cold_council_3e9a5f0c:

    # cath "Не все. Но ремонт, кажется, обойдется дорого. Борис велел компенсировать вам стоимость починки."
    cath "不是全部。但修理费似乎很贵。Boris已下令补偿您的修理费用。"

# game/a14/9cold_council.rpy:95
translate english cold_council_8299f4e0:

    # me "{size=-4}Золото меня интересует не так сильно, как время.{/size}"
    me "{size=-4}相比时间，我对黄金没那么感兴趣。{/size}"

# game/a14/9cold_council.rpy:96
translate english cold_council_14a3c1d7:

    # cath "Были повреждены мачты. Боюсь месяц, не меньше."
    cath "桅杆受损了。恐怕要修一个月，至少。"

# game/a14/9cold_council.rpy:97
translate english cold_council_0ef2e45d:

    # me "{size=-4}...{/size}"
    me "{size=-4}……{/size}"

# game/a14/9cold_council.rpy:98
translate english cold_council_210e468c:

    # cath "Мы будем только рады, если вы перезимуете у нас."
    cath "如果您在我们这儿过冬，我们会非常高兴。"

# game/a14/9cold_council.rpy:100
translate english cold_council_92d85661:

    # me "Может я смогу нанять другой корабль?"
    me "也许我可以另租一艘船？"

# game/a14/9cold_council.rpy:101
translate english cold_council_3f26efcc:

    # cath "Сомневаюсь. Порт стал замерзать раньше в этом году."
    cath "我对此怀疑。今年港口提前封冻了。"

# game/a14/9cold_council.rpy:102
translate english cold_council_2325fa76:

    # me "И что?"
    me "所以呢？"

# game/a14/9cold_council.rpy:103
translate english cold_council_7e38d4f8:

    # cath "Капитаны предпочитают торговать, а не стоять в замерзшем порту. Можете попробовать, но я не думаю, что к концу недели в порту будет хоть один корабль."
    cath "船长们更愿意去贸易，而不是停在冻住的港口里。您可以试试，但我不认为到周末时港口里还会有哪怕一艘船。"

# game/a14/9cold_council.rpy:104
translate english cold_council_9e9a14ce:

    # me "Вы сказали, что конкуренция большая."
    me "您说过竞争激烈。"

# game/a14/9cold_council.rpy:105
translate english cold_council_0b15961c:

    # cath "Перед зимой. А она уже наступила."
    cath "在冬天之前。而现在冬天已经来了。"

# game/a14/9cold_council.rpy:106
translate english cold_council_42e31b98:

    # me "Тогда зачем было сжигать мои корабли?"
    me "那他们为什么要烧我的船？"

# game/a14/9cold_council.rpy:107
translate english cold_council_63fa5502:

    # cath "Это было месяц назад. Почти сразу после вашего отбытия."
    cath "那是两个月前的事了。差不多是您刚离开的时候。"

# game/a14/9cold_council.rpy:108
translate english cold_council_3820771a:

    # me "..."
    me "..."

# game/a14/9cold_council.rpy:109
translate english cold_council_f07cef44:

    # cath "Мне жаль, принц [mename]. Мне хотелось бы, чтобы Север встретил вас более гостеприимно."
    cath "我很遗憾，[mename]王子。我真希望北方能更热情地迎接您。"

# game/a14/9cold_council.rpy:110
translate english cold_council_c4456ff5:

    # me "А что с болотной лихорадкой?"
    me "那沼泽热呢？"

# game/a14/9cold_council.rpy:111
translate english cold_council_4a44ba65:

    # cath "Она поутихла. Частично."
    cath "它消退了。部分地。"

# game/a14/9cold_council.rpy:112
translate english cold_council_489a247d:

    # me "Правда?"
    me "真的吗？"

# game/a14/9cold_council.rpy:113
translate english cold_council_923843df:

    # cath "Но я бы все равно не советовала вам путь через Вольные Города."
    cath "但我仍然不建议您走自由城邦那条路。"

# game/a14/9cold_council.rpy:114
translate english cold_council_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a14/9cold_council.rpy:115
translate english cold_council_5f21260e:

    # cath "Болезни порождают голод, а голод - разбойников. Тракт сейчас небезопасен, к тому же болотная чума утихла только в деревнях. Города до сих пор страдают."
    cath "疾病引发饥荒，饥荒滋生强盗。那条商道现在不安全，而且沼泽瘟疫只在村庄里消退了。城市至今仍在受苦。"

# game/a14/9cold_council.rpy:116
translate english cold_council_855db9ee:

    # me "Ясно."
    me "清楚了。"

# game/a14/9cold_council.rpy:117
translate english cold_council_4ec780fb:

    # cath "Готовы?"
    cath "准备好了吗？"

# game/a14/9cold_council.rpy:118
translate english cold_council_56f48945:

    # me "Да. Сопроводите меня."
    me "好了。带我去吧。"

# game/a14/9cold_council.rpy:120
translate english cold_council_a8de39ef:

    # skalad "А есть карта побольше и поподробнее?"
    skalad "有没有更大更详细的地图？"

# game/a14/9cold_council.rpy:121
translate english cold_council_5f1b56b7:

    # dubov "Я попрошу найти что-нибудь для следующего совета."
    dubov "我会让人为下次会议找一份。"

# game/a14/9cold_council.rpy:123
translate english cold_council_e4e40cef:

    # skalad "В общем они здесь. Пару десятков, не больше. Крадут скот. Нападают на деревни, насилуют и убивают."
    skalad "总的来说，他们就在这一带。几十个，不多。偷牲口，袭击村子，奸淫掳掠，杀人放火。"

# game/a14/9cold_council.rpy:124
translate english cold_council_6809c6a3:

    # dubov "Мстят?"
    dubov "在报复？"

# game/a14/9cold_council.rpy:125
translate english cold_council_ffca7648:

    # skalad "Ага. Часть со свадьбы, часть новые из Высокой Страны. Не успеваем всех вешать."
    skalad "嗯。一部分是婚宴上的人，一部分是来自高原的新人。我们来不及把他们都吊死。"

# game/a14/9cold_council.rpy:126
translate english cold_council_2d97f37d:

    # dubov "Это все Железные Пояса?"
    dubov "这些都是铁腰带氏族的？"

# game/a14/9cold_council.rpy:127
translate english cold_council_b701570d:

    # skalad "Да. Может парочка из смежных кланов."
    skalad "是的。可能有一两个来自邻近氏族。"

# game/a14/9cold_council.rpy:128
translate english cold_council_4719520a:

    # dubov "Парочка?"
    dubov "一两个？"

# game/a14/9cold_council.rpy:129
translate english cold_council_5050db12:

    # skalad "Другие кланы не вступятся."
    skalad "其他氏族不会插手。"

# game/a14/9cold_council.rpy:130
translate english cold_council_6d080816:

    # dubov "Уверен?"
    dubov "你确定？"

# game/a14/9cold_council.rpy:131
translate english cold_council_e53ef2d5:

    # skalad "Уверен. После того, что мы устроили у них надолго отобьет охоту лезть на нашу землю."
    skalad "确定。在我们做了那件事之后，很长一段时间内，他们都不敢再来侵犯我们的土地。"

# game/a14/9cold_council.rpy:132
translate english cold_council_cd76a617:

    # dubov "Хорошо. Удвой количество людей у Рубинового Ущелья."
    dubov "好的。把红宝石峡谷的兵力加倍。"

# game/a14/9cold_council.rpy:133
translate english cold_council_98d4fc55:

    # skalad "Утрою. Все равно моим ребятам зимой делать нечего."
    skalad "我派三倍的人手。反正我手下那帮小子冬天也没事干。"

# game/a14/9cold_council.rpy:134
translate english cold_council_11ba90cf:

    # dubov "Не переходи границ, Скаладан."
    dubov "别越过边界，Scaladan。"

# game/a14/9cold_council.rpy:135
translate english cold_council_a31c0900:

    # skalad "Больно надо. Зачем? Камней в жопу насобирать?"
    skalad "我才不稀罕。为什么去？去捡石头砸自己屁股吗？"

# game/a14/9cold_council.rpy:137
translate english cold_council_43fcfc17:

    # skalad "Вот. Сюда пошли. По левую сторону от течения. Там их клановая земля."
    skalad "看这里。派人到这里来。沿着河流的左侧。那里是他们的氏族领地。"

# game/a14/9cold_council.rpy:138
translate english cold_council_82ce086c:

    # dubov "Все вернулись?"
    dubov "所有人都回来了？"

# game/a14/9cold_council.rpy:139
translate english cold_council_a3f72313:

    # skalad "Парочка осталось. Пришлось повесить."
    skalad "还有一两个没回来。不得不吊死了他们。"

# game/a14/9cold_council.rpy:140
translate english cold_council_3e9b63da:

    # dubov "Вернуться?"
    dubov "回来？"

# game/a14/9cold_council.rpy:141
translate english cold_council_94e772f2:

    # skalad "Не знаю. Это теперь только Безымянный Бог знает. Мальчишка все испортил."
    skalad "不知道。这事儿现在只有无名之神知道了。那小子把事情全搞砸了。"

# game/a14/9cold_council.rpy:142
translate english cold_council_9e45b40f:

    # dubov "Не нужно на него все перекладывать. Это была твоя зона ответственности."
    dubov "别把责任都推给他。这是你的职责范围。"

# game/a14/9cold_council.rpy:143
translate english cold_council_e3472686:

    # skalad "У него талант к быстрым переговорам, ебать его в жопу."
    skalad "他妈的，他很有快速谈判的天赋，我操他妈的。"

# game/a14/9cold_council.rpy:144
translate english cold_council_338901d5:

    # dubov "..."
    dubov "..."

# game/a14/9cold_council.rpy:145
translate english cold_council_6e5f5355:

    # skalad "Я выставлю здесь патрули. Организую лагерь в руинах. Если сунутся - отвечу."
    skalad "我会在这里设置巡逻队。在废墟里建个营地。如果他们敢来犯，我就回击。"

# game/a14/9cold_council.rpy:146
translate english cold_council_232a01a2:

    # dubov "Хорошо."
    dubov "好的。"

# game/a14/9cold_council.rpy:147
translate english cold_council_424dc214:

    # skalad "Проблема только в этих сраных пещерах. Это их земля... по документам."
    skalad "问题就出在那些他妈的洞穴。那里是他们的土地……根据文件。"

# game/a14/9cold_council.rpy:148
translate english cold_council_a53e5400:

    # dubov "И что?"
    dubov "那又怎样？"

# game/a14/9cold_council.rpy:149
translate english cold_council_9a47b80e:

    # skalad "Есть парочка сквозных. Оттуда им будет удобно совершать вылазки и набеги."
    skalad "有那么几条能穿过去的通道。从那里他们可以很方便地进行突击和劫掠。"

# game/a14/9cold_council.rpy:150
translate english cold_council_9815dac2:

    # dubov "Ну так завалите их камнями."
    dubov "那就用石头把它们都堵上。"

# game/a14/9cold_council.rpy:152
translate english cold_council_e5f2f940:

    # me "Лорды. Король."
    me "领主们。国王。"

# game/a14/9cold_council.rpy:153
translate english cold_council_e3fe73a7:

    # skalad "О. А вот и он. Достопочтенный золотой принц."
    skalad "哦。他来了。尊贵的黄金王子。"

# game/a14/9cold_council.rpy:154
translate english cold_council_2a041faf:

    # gaston "Рад вас видеть, принц [mename]."
    gaston "很高兴见到您，[mename]王子。"

# game/a14/9cold_council.rpy:155
translate english cold_council_27d787bb:

    # corvin "Принц [mename]. Хорошо выглядите."
    corvin "[mename]王子。您看起来气色不错。"

# game/a14/9cold_council.rpy:156
translate english cold_council_59cdf9ed:

    # urkradd "Принц [mename]."
    urkradd "[mename]王子。"

# game/a14/9cold_council.rpy:157
translate english cold_council_43f687dc:

    # dubov "Присаживайтесь, принц [mename]."
    dubov "请坐，[mename]王子。"

# game/a14/9cold_council.rpy:158
translate english cold_council_07ae5ed7:

    # me "Благодарю."
    me "谢谢。"

# game/a14/9cold_council.rpy:160
translate english cold_council_b1dde64d:

    # urkradd "Боюсь мы не встречались раньше. Хелен сказала, что мы разминулись всего на пару дней."
    urkradd "恐怕我们以前没见过面。Helen Ukradskaya说我们刚好错过了几天。"

# game/a14/9cold_council.rpy:161
translate english cold_council_f22757b3:

    # me "Да. Так и было."
    me "是的。是这样。"

# game/a14/9cold_council.rpy:162
translate english cold_council_5c35e127:

    # urkradd "Моя жена была достаточно гостеприимна?"
    urkradd "我妻子是否足够好客？"

# game/a14/9cold_council.rpy:163
translate english cold_council_8f9071f9:

    # me "Конечно."
    me "当然。"

# game/a14/9cold_council.rpy:164
translate english cold_council_92b5376d:

    # urkradd "Она предоставила вам все необходимое для похода?"
    urkradd "她是否为您的征途提供了所有必需品？"

# game/a14/9cold_council.rpy:165
translate english cold_council_d4731720:

    # me "Даже больше."
    me "不止如此。"

# game/a14/9cold_council.rpy:166
translate english cold_council_b332b520:

    # urkradd "Хорошо."
    urkradd "很好。"

# game/a14/9cold_council.rpy:167
translate english cold_council_f779a95a:

    # me "Рад вас наконец увидеть."
    me "终于见到您，我很高兴。"

# game/a14/9cold_council.rpy:168
translate english cold_council_55cb55f2:

    # urkradd "Я тоже."
    urkradd "我也是。"

# game/a14/9cold_council.rpy:170
translate english cold_council_c99a9f22:

    # urkradd "Жена сказала, что вы ищете жениха для своей родственницы."
    urkradd "我妻子说您在为您的一位亲戚找丈夫。"

# game/a14/9cold_council.rpy:171
translate english cold_council_4ddf6001:

    # me "Да. Рамона Вингхэд."
    me "是的。Ramona 温格海德。"

# game/a14/9cold_council.rpy:172
translate english cold_council_023bec69:

    # urkradd "Эйрик будет рад жене из именитого рыцарского дома. Если, конечно, невесте он понравился."
    urkradd "Eirik会很高兴有一位来自显赫骑士家族的妻子。当然，前提是新娘得喜欢他。"

# game/a14/9cold_council.rpy:173
translate english cold_council_a246d07e:

    # me "Я спрошу у нее."
    me "我会问问她。"

# game/a14/9cold_council.rpy:174
translate english cold_council_a14d5b6c:

    # urkradd "Конечно."
    urkradd "当然。"

# game/a14/9cold_council.rpy:176
translate english cold_council_a4810624:

    # dubov "Как добрались?"
    dubov "您路上怎么样？"

# game/a14/9cold_council.rpy:177
translate english cold_council_08c05f10:

    # me "Нормально. Не ожидал, что лорд Скаладан меня опередит."
    me "还行。没想到Scaladan领主会赶在我前面。"

# game/a14/9cold_council.rpy:178
translate english cold_council_d9bdfcfe:

    # skalad "Я каждую тропу на Севере знаю."
    skalad "北方上的每条路我都知道。"

# game/a14/9cold_council.rpy:179
translate english cold_council_0e37dd04:

    # dubov "Лорд Скаладан прибыл всего на пару часов раньше. Как раз рассказывал нам, чем закончилась история с горцами."
    dubov "Scaladan领主只比您早到了几个小时。刚刚正在跟我们讲述与高地人之事的结局。"

# game/a14/9cold_council.rpy:180
translate english cold_council_146709b9:

    # me "И что же именно он рассказал?"
    me "他究竟讲了些什么？"

# game/a14/9cold_council.rpy:181
translate english cold_council_0e4037bc:

    # dubov "Полагаю, вы в пересказе не нуждаетесь, принц [mename]. Вы ведь и сами там были."
    dubov "我想您不需要我再复述了，[mename]王子。您本人就在那里。"

# game/a14/9cold_council.rpy:183
translate english cold_council_30738265:

    # me "Был. Я даже сражался."
    me "我在那里。我甚至还战斗了。"

# game/a14/9cold_council.rpy:184
translate english cold_council_4e509a1d:

    # dubov "Лорд Скаладан упомянул и это."
    dubov "Scaladan领主也提到了这一点。"

# game/a14/9cold_council.rpy:185
translate english cold_council_13da59a6:

    # me "Хорошо. "
    me "很好。"

# game/a14/9cold_council.rpy:187
translate english cold_council_753154c0:

    # skalad "Мы хорошо справились. Принц [mename] бился смело."
    skalad "我们处理得很好。[mename]王子勇敢作战。"

# game/a14/9cold_council.rpy:188
translate english cold_council_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a14/9cold_council.rpy:189
translate english cold_council_39c222d6:

    # skalad "Его люди тоже храбро бились. Закрыли проход на север и благодаря этому Макхал теперь висит на ветке, если его еще не сожрали птицы и белки."
    skalad "他的人也很勇敢地战斗。他们封锁了北边的通道，正因如此，Makhal现在吊在树枝上，要是还没被鸟和松鼠吃掉的话。"

# game/a14/9cold_council.rpy:190
translate english cold_council_59be7b54:

    # skalad "Если только он не распугал все зверье. Смердело от него ужасно. Наверное навалил в штаны, когда сдох."
    skalad "除非他把所有野兽都吓跑了。他死的时候臭得要命。大概死的时候吓拉在裤子里了。"

# game/a14/9cold_council.rpy:191
translate english cold_council_0ed6d9f1:

    # ukradd "А можно не о повешенных и дерьме? Я собирался поесть после совета."
    ukradd "能不能别谈上吊和粪便了？我还打算会后吃点东西。"

# game/a14/9cold_council.rpy:192
translate english cold_council_a85376f0:

    # skalad "Помолчи, пока мужчины разговаривают, Корвин."
    skalad "男人说话时，Corwin，你闭嘴。"

# game/a14/9cold_council.rpy:193
translate english cold_council_6ee98d68:

    # me "Надо сказать некоторая безальтернативность решения этого вопроса меня смутила."
    me "必须指出，这个问题的解决办法有些别无选择，让我感到困惑。"

# game/a14/9cold_council.rpy:194
translate english cold_council_3ec51ba0:

    # skalad "В каком смысле?"
    skalad "什么意义上的？"

# game/a14/9cold_council.rpy:195
translate english cold_council_a55f01cb:

    # me "Сначала я попытался решить проблему миром. А лорд Скаладан..."
    me "起初我试图和平解决这个问题。而Scaladan领主……"

# game/a14/9cold_council.rpy:196
translate english cold_council_49d81791:

    # skalad "Все кончилось как нельзя лучше. Поделом ублюдкам."
    skalad "结果再好不过了。那些杂种活该。"

# game/a14/9cold_council.rpy:197
translate english cold_council_3820771a_1:

    # me "..."
    me "..."

# game/a14/9cold_council.rpy:198
translate english cold_council_a1d0820d:

    # skalad "Что? Они понимают только силу."
    skalad "怎么？他们只懂得以暴制暴。"

# game/a14/9cold_council.rpy:199
translate english cold_council_8fff7c3f:

    # me "Я уже понял, что вы и не собирались решать это другим способом. Мне просто интересно, знает ли об этом Король Севера."
    me "我已经明白您也不打算用其他方式解决问题。我只是好奇，北方的国王是否知道这件事。"

# game/a14/9cold_council.rpy:200
translate english cold_council_7488abba:

    # skalad "О чем ты?"
    skalad "你指什么？"

# game/a14/9cold_council.rpy:202
translate english cold_council_1acec9e1:

    # me "Полгаю, у меня и лорда Скаладана истории будут отличаться."
    me "我想我和Scaladan领主的故事版本将会不同。"

# game/a14/9cold_council.rpy:203
translate english cold_council_899eb3d7:

    # dubov "В каком смысле?"
    dubov "什么意义上的？"

# game/a14/9cold_council.rpy:204
translate english cold_council_3de0e0e1:

    # me "События были одни и те же, но вот наши интенции и действия скорее друг другу противоречили."
    me "事件是相同的，但我们的意图和行动却更像是互相矛盾的。"

# game/a14/9cold_council.rpy:205
translate english cold_council_338901d5_1:

    # dubov "..."
    dubov "..."

# game/a14/9cold_council.rpy:206
translate english cold_council_973f214b:

    # me "Я пытался решить проблему без оружия и лишней крови."
    me "我试图在不使用武器和不造成多余流血的情况下解决问题。"

# game/a14/9cold_council.rpy:208
translate english cold_council_f6fb48ac:

    # skalad "Ну так у тебя получилось. В чем проблема?"
    skalad "那你不是做到了吗。问题在哪？"

# game/a14/9cold_council.rpy:209
translate english cold_council_75bb4843:

    # me "Полагаю проблема в том, что когда кто-то пытается решить проблему, обычно от союзника ожидается помощь, а не преграды."
    me "我认为问题在于，当有人试图解决问题时，通常期望的是来自盟友的帮助，而不是阻碍。"

# game/a14/9cold_council.rpy:210
translate english cold_council_f96849d1:

    # ukradd "Сейчас начнется..."
    ukradd "这就开始了……"

# game/a14/9cold_council.rpy:211
translate english cold_council_69d5b809:

    # skalad "И чем же я тебе помешал?"
    skalad "我哪里妨碍你了？"

# game/a14/9cold_council.rpy:212
translate english cold_council_54c904b7:

    # me "Я договорился об отмене брака."
    me "我谈妥了取消婚约。"

# game/a14/9cold_council.rpy:213
translate english cold_council_b5cb7abf:

    # skalad "Тебе повезло, клерик спятил."
    skalad "你小子走运了，那个修士疯了。"

# game/a14/9cold_council.rpy:214
translate english cold_council_1ce6f9fc:

    # me "Какая разница? Дело было решено."
    me "有什么区别吗？事情已经解决了。"

# game/a14/9cold_council.rpy:215
translate english cold_council_c1c3857d:

    # skalad "По-твоему они бы просто ушли?"
    skalad "在你看来，他们会就这么走掉吗？"

# game/a14/9cold_council.rpy:216
translate english cold_council_fc30fd2b:

    # me "Да."
    me "是的。"

# game/a14/9cold_council.rpy:217
translate english cold_council_6a026d52:

    # skalad "Они ушли по другой причине."
    skalad "他们离开是另有原因。"

# game/a14/9cold_council.rpy:218
translate english cold_council_ffb7442e:

    # me "По другой причине?"
    me "另有原因？"

# game/a14/9cold_council.rpy:220
translate english cold_council_bdf7602e:

    # me "Мне пришлось балансировать на острие ножа, лгать не переставая, подвергаясь опасности быть раскрытым в любую минуту."
    me "我不得不像走在刀锋上，不停地撒谎，时刻都冒着被揭穿的危险。"

# game/a14/9cold_council.rpy:222
translate english cold_council_ea4c4859:

    # me "Мне пришлось участвовать в испытаниях горцев и драться практически насмерть."
    me "我不得不参加高地人的试炼，几乎是生死搏斗。"

# game/a14/9cold_council.rpy:223
translate english cold_council_22d7a911:

    # skalad "Ну ты ведь справился."
    skalad "反正你最后成功了。"

# game/a14/9cold_council.rpy:224
translate english cold_council_97bcea12:

    # me "Вопреки вашим стараниям, лорд Скаладан."
    me "不顾您的极力阻挠，Scaladan领主。"

# game/a14/9cold_council.rpy:225
translate english cold_council_8cfbeb64:

    # skalad "Тебя никто не заставлял. Это было твое право, как и мое право было всех их переубивать."
    skalad "没人逼你。那是你的权利，而我的权利是把他们全杀了。"

# game/a14/9cold_council.rpy:226
translate english cold_council_04e68aa9:

    # me "И Король Севера об этом знал?"
    me "北方的国王知道这件事吗？"

# game/a14/9cold_council.rpy:227
translate english cold_council_0f1996d1:

    # me "Хотя да... стоило догадаться сразу."
    me "虽然是的……我本该立刻猜到。"

# game/a14/9cold_council.rpy:229
translate english cold_council_1e45b476:

    # dubov "Озвучите свою мысль, принц [mename]?"
    dubov "能把您的想法说出来吗，[mename]王子？"

# game/a14/9cold_council.rpy:230
translate english cold_council_4375498c:

    # me "Озвучу. Я так понимаю я был некой страховкой на тот случай, если лорд Скаладан не справится сам."
    me "我说。据我理解，我扮演的是某种保险的角色，以防Scaladan领主自己搞不定。"

# game/a14/9cold_council.rpy:231
translate english cold_council_2f7d035a:

    # dubov "Кажется, я этого от вас и не скрывал."
    dubov "这一点，我似乎并没有对您隐瞒。"

# game/a14/9cold_council.rpy:232
translate english cold_council_4f2a2516:

    # skalad "Ты мне помог. Спасибо."
    skalad "你帮了我。谢谢。"

# game/a14/9cold_council.rpy:233
translate english cold_council_4bf35e1c:

    # me "Я не об этом. Я с самого начала должен был помочь Скаладану убить всех горцев. Никакого мирного решения и не подразумевалось, верно?"
    me "我说的不是这个。我从一开始就该帮助Scaladan杀掉所有高地人。从来就没有什么和平解决方案，对吧？"

# game/a14/9cold_council.rpy:234
translate english cold_council_8701e2cd:

    # dubov "Разве я об этом говорил?"
    dubov "我有这么说过吗？"

# game/a14/9cold_council.rpy:235
translate english cold_council_ea11e012:

    # me "Вот именно. Не говорили. Я этого не знал. Я думал, что еду решать проблему с непослушным вассалом, но раз он сидит рядом с вами у него целы все зубы и на месте все пальцы..."
    me "正是。您没说。我不知道这一点。我以为我是来解决一个不听话的封臣的问题，但既然他坐在您旁边，牙齿完好，手指也全在……"

# game/a14/9cold_council.rpy:236
translate english cold_council_bcf4955d:

    # skalad "Поострожней парень."
    skalad "说话小心点，小子。"

# game/a14/9cold_council.rpy:237
translate english cold_council_9b8b8f95:

    # me "Похоже, что вы все знали с самого начала. Все обстоятельства."
    me "看起来你们从一开始就知道一切。所有的情况。"

# game/a14/9cold_council.rpy:238
translate english cold_council_f9da4b29:

    # dubov "Лорд Украдский поделился подробностями."
    dubov "Ukradsky领主分享了细节。"

# game/a14/9cold_council.rpy:239
translate english cold_council_42a97c5b:

    # me "И вас все устраивает?"
    me "而您对此完全满意吗？"

# game/a14/9cold_council.rpy:240
translate english cold_council_92d14bca:

    # dubov "А что я должен был сделать? Повесить своего вассала, за то что горцы попытались его обмануть?"
    dubov "那我应该怎么做？把我的封臣吊死，就因为高地人试图骗他？"

# game/a14/9cold_council.rpy:241
translate english cold_council_9295a253:

    # me "Попытались его обмануть. Очень интересная формулировка. Хорошо. Допустим горцы сами виноваты. А что насчет лорда Войцеха? Он тоже ваш вассал."
    me "试图骗他。很有趣的措辞。好吧。假设是高地人罪有应得。那Vojceh领主呢？他也是您的封臣。"

# game/a14/9cold_council.rpy:242
translate english cold_council_8a340bb6:

    # dubov "А при чем тут он?"
    dubov "这关他什么事？"

# game/a14/9cold_council.rpy:243
translate english cold_council_72f2300a:

    # me "Он пострадал из-за действий лорда Скаладана."
    me "他因为Scaladan领主的行动而受到了损害。"

# game/a14/9cold_council.rpy:244
translate english cold_council_3ba41dc0:

    # skalad "Он сам виноват."
    skalad "是他自己的错。"

# game/a14/9cold_council.rpy:245
translate english cold_council_5d7356c0:

    # me "Вы его обманули."
    me "您欺骗了他。"

# game/a14/9cold_council.rpy:246
translate english cold_council_d66ba7e7:

    # dubov "Никто никого не обманывал. Он неправильно проинтерпретировал послание лорда Скаладана."
    dubov "没人欺骗谁。是他错误地解读了Scaladan领主的口信。"

# game/a14/9cold_council.rpy:247
translate english cold_council_56fb7470:

    # skalad "Вот именно."
    skalad "正是这样。"

# game/a14/9cold_council.rpy:248
translate english cold_council_b2b791e4:

    # me "А, да? Так вы действительно знаете обо ВСЕМ. Я так понимаю лорда Войцеха здесь нет именно по этой причине? Чтобы не мог рассказать свою версию событий?"
    me "啊，是吗？所以你们确实知道所有事情。那么据我推测，Vojceh领主不在此处，正是出于这个原因？让他无法讲述自己对事件的叙述？"

# game/a14/9cold_council.rpy:249
translate english cold_council_f8987cf3:

    # dubov "Не волнуйтесь, принц. Лорд Войцех тоже здесь будет."
    dubov "别担心，王子。Vojceh也会来的。"

# game/a14/9cold_council.rpy:250
translate english cold_council_be1cb2a5:

    # me "И что вы сделаете? Откупитесь от него? Или его голос не так важен на Вече?"
    me "那您会怎么做？用钱收买他？还是说他的声音在议事会会议上不那么重要？"

# game/a14/9cold_council.rpy:251
translate english cold_council_6cf573f6:

    # skalad "Поострожней с языком, золотой принц."
    skalad "注意你的言辞，黄金王子。"

# game/a14/9cold_council.rpy:252
translate english cold_council_d527ac04:

    # dubov "Вы хотите меня в чем-то обвинить?"
    dubov "您这是在指责我吗？"

# game/a14/9cold_council.rpy:253
translate english cold_council_e8f7eec4:

    # me "Нет. Что вы. Я только не понимаю, зачем было держать меня в неведении."
    me "不。哪能啊。我只是不明白，为什么要把我蒙在鼓里。"

# game/a14/9cold_council.rpy:254
translate english cold_council_a64dc975:

    # dubov "Разве я так делал?"
    dubov "我有这样做吗？"

# game/a14/9cold_council.rpy:255
translate english cold_council_9cbff2f1:

    # me "Ну да... только не понимаю зачем. Хотя... Лорд Скаладан, могу я спросить вам о кое-чем?"
    me "嗯，是啊……只是不明白为什么。不过……Scaladan领主，我能问您件事吗？"

# game/a14/9cold_council.rpy:256
translate english cold_council_b6a4a255:

    # skalad "Спрашивай."
    skalad "问。"

# game/a14/9cold_council.rpy:257
translate english cold_council_d329df4f:

    # me "Вы выносили вотум недоверия Королю Севера?"
    me "您对北方的国王提出过不信任动议吗？"

# game/a14/9cold_council.rpy:258
translate english cold_council_a665d694:

    # skalad "Понятия не имею о чем ты."
    skalad "完全不知道你在说什么。"

# game/a14/9cold_council.rpy:259
translate english cold_council_029d18f9:

    # me "Король Дубовицкий, вы получили мое письмо из Грачиного Дома?"
    me "Dubovitsky国王，您收到我从鸦巢发出的信了吗？"

# game/a14/9cold_council.rpy:260
translate english cold_council_966f2251:

    # skalad "Да, он получил..."
    skalad "是的，他收到了……"

# game/a14/9cold_council.rpy:261
translate english cold_council_bf66671c:

    # me "Я не у вас спрашиваю."
    me "我是在问他。"

# game/a14/9cold_council.rpy:262
translate english cold_council_338901d5_2:

    # dubov "..."
    dubov "..."

# game/a14/9cold_council.rpy:263
translate english cold_council_9ae53ffd:

    # me "Хах. Ну теперь мне действительно все ясно. Все сходится."
    me "哈。现在我算是全明白了。都对上了。"

# game/a14/9cold_council.rpy:264
translate english cold_council_ce13eff8:

    # me "Вы тогда еще не решили, какой фигурой на шахматной доске я должен стать. Клан и Скаладан вынесли вам два вотума недоверия. "
    me "那时您还没决定棋盘上我该充当哪枚棋子。氏族和Scaladan对您提出了两次不信任动议。"

# game/a14/9cold_council.rpy:265
translate english cold_council_b3652465:

    # me "Они думали так заставить вас встать на их сторону. Но вы специально не поддержали ни горцев, ни своего лорда."
    me "他们以为这样能迫使您站到他们那边。但您特意既不支持高地人，也不支持自己的领主。"

# game/a14/9cold_council.rpy:266
translate english cold_council_586e5bd2:

    # me "И вы отправили меня надавить на Скаладана. Но не напрямую. Опосредованно. Если бы я решил эту проблему за него, а может и без него вовсе, да еще и так, как он не хотел бы... Это бы его серьезно опозорило, а вас возвысило."
    me "于是您派我去向Scaladan施压。但不是直接地。而是间接地。如果我替他解决了这个问题，甚至可能完全撇开他，而且还是以他不想要的方式……这会严重羞辱他，同时抬高您自己。"

# game/a14/9cold_council.rpy:267
translate english cold_council_abd551bc:

    # me "Он это понимал. Потому что когда я прибыл, настроение у него резко испортилось. Он хотел авторитетно убить всех своих врагов, а я мог этому помешать, еще и оставить его в положении клятвопреступника."
    me "他明白这一点。因为当我到达时，他的心情立刻变坏了。他本想以权威方式杀死所有敌人，而我却可能阻碍他，甚至让他背上违背誓言者的罪名。"

# game/a14/9cold_council.rpy:268
translate english cold_council_57c1c62b:

    # me "При этом вы не были заодно с самого начала. Иначе лорд Скаладан не попросил бы меня написать это идиотское письмо, которое он очевидно приберег для себя."
    me "与此同时，你们从一开始就不是一伙的。否则Scaladan领主不会让我写那封愚蠢的信，显然他是为自己留着的。"

# game/a14/9cold_council.rpy:269
translate english cold_council_bcf4e680:

    # me "Видимо оно нужно было ему, как доказательство того, что он медлит не по собственной воле."
    me "显然，他需要信作为证据，证明他的拖延不是出于自己的意愿。"

# game/a14/9cold_council.rpy:270
translate english cold_council_a25f2b2e:

    # skalad "..."
    skalad "..."

# game/a14/9cold_council.rpy:271
translate english cold_council_ac651666:

    # me "И вот для чего вы послали со мной своих людей. Вовсе не для моей защиты. Они приехали с предложением, от которого Скаладан не смог отказаться."
    me "这就是您派人跟着我的原因。根本不是为了保护我。他们是带着Scaladan无法拒绝的提议来的。"

# game/a14/9cold_council.rpy:272
translate english cold_council_52d5a202:

    # me "Вернее сначала он, вероятно, раздумывал, но после того, как я решил проблему с браком, понял, что придется принять ваше предложение."
    me "更准确地说，起初他大概在犹豫，但在我解决了婚约问题后，他明白他必须接受您的提议了。"

# game/a14/9cold_council.rpy:273
translate english cold_council_4227bc0f:

    # me "Кстати, клерик возможно тоже работает на вас. Как-то он слишком легко согласился. Хотя насчет этого я не уверен."
    me "顺便说一句，那个修士可能也是为您工作的。他同意得太容易了。虽然这点我不确定。"

# game/a14/9cold_council.rpy:274
translate english cold_council_b88613b8:

    # me "Поэтому Скаладан и продержал меня и других людей в замке целую неделю. Видимо в спешке соглашался на ваше предложение."
    me "所以Scaladan才在城堡里扣留了我和其他人整整一周。看来是在匆忙中同意了您的提议。"

# game/a14/9cold_council.rpy:275
translate english cold_council_cd7d505c:

    # me "Ну да... Ждал ответа. Конечно. Он бы не провернул трюк с Войцехом без вашего одобрения. Хотя недели маловато. Либо его гонец загнал десять лошадей, либо лорд Скаладан был уверен, что вы согласитесь."
    me "没错……在等回音。当然。没有您的许可，他不可能对Vojceh耍花招。虽然一周时间有点短。要么他的信使跑死了十匹马，要么Skaladan领主确信您会同意。"

# game/a14/9cold_council.rpy:276
translate english cold_council_5101bf72:

    # me "А если он так думал, значит его контрпредложение было ценным. Снятия вотума недоверия? Маловато. Видимо еще голос на следующем Вече."
    me "如果他这么想，就意味着他的反提议很有价值。撤销不信任动议？这太少了。显然还有下次议事会会议的一票。"

# game/a14/9cold_council.rpy:277
translate english cold_council_7ebfa696:

    # me "Ну да. Вотум недоверия от клана и от лорда. Но за короля Севера голосует только лорды. Так что вы поступили мудро. Решить проблему, как того хочет лорд, получить за это голос и убить недовольных горцев."
    me "没错。来自氏族和领主的不信任动议。但为北方的国王投票的只有领主们。所以您做得很明智。按领主想要的方式解决问题，以此换取他的一票，同时杀掉那些心怀不满的高地人。"

# game/a14/9cold_council.rpy:278
translate english cold_council_338901d5_3:

    # dubov "..."
    dubov "..."

# game/a14/9cold_council.rpy:279
translate english cold_council_5b08e2a3:

    # skalad "Какая бредятина."
    skalad "多么荒谬。"

# game/a14/9cold_council.rpy:280
translate english cold_council_d539ec3e:

    # me "Триумфатор Лорд Скаладан. Мудрый Король Севера и бедняга Войцех."
    me "胜利者Skaladan领主。睿智的北方国王和可怜的Vojceh。"

# game/a14/9cold_council.rpy:282
translate english cold_council_03ab7b1d:

    # me "Жаль я сразу всего этого не понял. Поздравляю, вы сыграли мной в этой партии, как пешкой."
    me "可惜我没能立刻明白这一切。恭喜，您在这局棋里把我当成了卒子。"

# game/a14/9cold_council.rpy:284
translate english cold_council_bd2a1b41:

    # me "Я нарушил ваши планы, да? Вы явно не расчитывали, что я смогу договорится даже после всех провокаций Лорда Скаладана."
    me "我打乱了您的计划，是吧？您显然没料到，即使在Scaladan领主的种种挑衅之后，我还能谈成。"

# game/a14/9cold_council.rpy:285
translate english cold_council_9d1a2b95:

    # dubov "Ты закончил?"
    dubov "你说完了吗？"

# game/a14/9cold_council.rpy:286
translate english cold_council_201caf79:

    # me "Мне лишь интересно что бы было, если бы Скаладан не согласился? Вы бы прислали мне письмо с просьбой встать на сторону горцев? Защитить священный северный закон?"
    me "我只是好奇，如果Scaladan不同意会怎样？您会给我送信，让我站到高地人一边吗？去维护神圣的北方律法？"

# game/a14/9cold_council.rpy:288
translate english cold_council_3820771a_2:

    # me "..."
    me "..."

# game/a14/9cold_council.rpy:289
translate english cold_council_7e606bf9:

    # gaston "Это правда?"
    gaston "这是真的吗？"

# game/a14/9cold_council.rpy:290
translate english cold_council_8d15fefe:

    # skalad "Коненечно нет. Парню отморозило голову, пока сюда добирался."
    skalad "当然不是。这小子来这儿的路上，脑子冻坏了。"

# game/a14/9cold_council.rpy:291
translate english cold_council_e371a0da:

    # corvin "По мне так звучало довольно правдоподобно."
    corvin "但我觉得听起来非常合理。"

# game/a14/9cold_council.rpy:292
translate english cold_council_e7694922:

    # ukradd "Закрой пасть, Корвин."
    ukradd "闭嘴，Corwin。"

# game/a14/9cold_council.rpy:293
translate english cold_council_3a87a1c3:

    # corvin "Ладно-ладно."
    corvin "好吧，好吧。"

# game/a14/9cold_council.rpy:294
translate english cold_council_c9bae629:

    # gaston "Думаю вы ошблись, принц [mename]. Горцы регулярно мучают наши земли. Скаладан просто защищался. Борис ведь послал вас с сопроводительным письмом."
    gaston "我想您弄错了，[mename]王子。高地人经常劫掠我们的土地。Skaladan只是在自卫。Boris可是派您带着随行信函过去的。"

# game/a14/9cold_council.rpy:295
translate english cold_council_a36ba241:

    # skalad "Вот именно. Ты шел помогать Северу от горцев."
    skalad "正是这样。你是去帮助北方对付高地人的。"

# game/a14/9cold_council.rpy:296
translate english cold_council_789bb0e4:

    # me "Я шел решать спор между двумя клятвопреступниками. Но оказалось, что одному из них есть что проложить главному арбитру."
    me "我是去解决两个违背誓言者之间的争端的。但结果呢，其中一人能拿出点什么来献给最高仲裁者。"

# game/a14/9cold_council.rpy:297
translate english cold_council_fc40e206:

    # ukradd "Это серьезные обвинения, принц. Такое не подкрепляют одними только словами."
    ukradd "这是很严厉的指控，王子。这种事不能仅仅凭言语来支持。"

# game/a14/9cold_council.rpy:298
translate english cold_council_df43eb6f:

    # me "Ладно. Забудьте. Я ничего не говорил. Наверное на мне сказалась дорога."
    me "好吧。忘了吧。我什么都没说。大概是我路上太累了。"

# game/a14/9cold_council.rpy:299
translate english cold_council_4ac59ac9:

    # skalad "Я же говорю - подморозил мозги."
    skalad "我就说吧——脑子冻坏了。"

# game/a14/9cold_council.rpy:300
translate english cold_council_7db7958c:

    # me "А что насчет обещанного. Север, как автономное королевство в составе Империи."
    me "那关于答应过的事呢。让北方成为帝国属下的自治王国。"

# game/a14/9cold_council.rpy:301
translate english cold_council_a4b4064e:

    # dubov "Мы вынесем это на голосование, как только прибудут другие лорды."
    dubov "等其余领主一到，我们就将此付诸表决。"

# game/a14/9cold_council.rpy:302
translate english cold_council_3be9adc5:

    # me "Голосование."
    me "表决。"

# game/a14/9cold_council.rpy:303
translate english cold_council_093ea98b:

    # dubov "Конечно. Я ведь не могу принимать такие решения в одиночку."
    dubov "当然。这种事我总不能一个人决定吧。"

# game/a14/9cold_council.rpy:304
translate english cold_council_35349c04:

    # me "{i}Месяц назад ты говорил иначе, ублюдок.{/i}"
    me "{i}一个月前你可不是这么说的，混蛋。{/i}"

# game/a14/9cold_council.rpy:305
translate english cold_council_1122f54b:

    # me "И что же, ваш голос будет стоить столько же, сколько и голоса остальных?"
    me "那么，您的票会和其他领主的票同等价值吗？"

# game/a14/9cold_council.rpy:306
translate english cold_council_0eb39057:

    # dubov "Разумеется. Разве что наши мнения разделяться поровну. В таком случае мой голос будет решающим."
    dubov "当然。除非我们的意见恰好平局。那样的话，我的票将起到决定性作用。"

# game/a14/9cold_council.rpy:307
translate english cold_council_bd56f83c:

    # me "И кто из присутствующих согласен проголосовать за вступление в Империю?"
    me "在场的人中，谁同意投票支持加入帝国？"

# game/a14/9cold_council.rpy:308
translate english cold_council_338901d5_4:

    # dubov "..."
    dubov "..."

