# game/a15/7wed_prep.rpy:3
translate english wed_prep_9f2a99fe:

    # "Утром."
    "早上。"

# game/a15/7wed_prep.rpy:4
translate english wed_prep_de5afd9e:

    # lia "...зачем это?"
    lia "……为什么要这样？"

# game/a15/7wed_prep.rpy:5
translate english wed_prep_6bff915a:

    # lartua_y "Это же правила приличия. Мы обязаны отблагодарить за подарки."
    lartua_y "这是礼仪规矩。我们必须为礼物致谢。"

# game/a15/7wed_prep.rpy:6
translate english wed_prep_226e1d49:

    # lia "Но свадьбы еще не было!"
    lia "可婚礼还没举行！"

# game/a15/7wed_prep.rpy:7
translate english wed_prep_3b70a885:

    # lartua_y "Но она скоро будет."
    lartua_y "但很快就举行了。"

# game/a15/7wed_prep.rpy:8
translate english wed_prep_d03c03aa:

    # lia "Мы даже не знаем, что нам подарят. Может и благодарить не за что."
    lia "我们甚至不知道他们会送什么。也许根本没什么可谢的。"

# game/a15/7wed_prep.rpy:9
translate english wed_prep_49ae3f90:

    # lartua_y "Это..."
    lartua_y "这是……"

# game/a15/7wed_prep.rpy:10
translate english wed_prep_5796f750:

    # lia "...правило приличия. Да. Я поняла. Я шучу. Надо отблагодарить всех."
    lia "……礼仪规矩。对。我懂了。我开玩笑的。得感谢所有人。"

# game/a15/7wed_prep.rpy:11
translate english wed_prep_ac1997c7:

    # lartua_y "Всех, кого мы приглашали."
    lartua_y "所有我们邀请的人。"

# game/a15/7wed_prep.rpy:12
translate english wed_prep_6f466156:

    # lia "Мы можем поблагодарить их лично."
    lia "我们可以亲自感谢他们。"

# game/a15/7wed_prep.rpy:13
translate english wed_prep_77c27322:

    # lartua_y "Тех, кто будет присутствовать лично - отблагодарим лично. Тех, кто не смог приехать, но прислал дары - письменно."
    lartua_y "那些亲自到场的人——我们亲自感谢。那些没能来却送来礼物的人——书面感谢。"

# game/a15/7wed_prep.rpy:14
translate english wed_prep_d1dab67e:

    # lia "Кто может не захотеть посетить свадьбу?"
    lia "谁会不想来参加婚礼？"

# game/a15/7wed_prep.rpy:16
translate english wed_prep_b84e1f1c:

    # lartua_y "Например, лорд Лагариус, он занят делами в Долине."
    lartua_y "比如拉加里乌斯领主，他忙着山谷的事务。"

# game/a15/7wed_prep.rpy:18
translate english wed_prep_41507db7:

    # lartua_y "Например, лорд Пойнас, он занят делами в Долине."
    lartua_y "比如珀纳斯领主，他忙着山谷的事务。"

# game/a15/7wed_prep.rpy:20
translate english wed_prep_11de67a6:

    # lartua_y "Много западных лордов не прибудут, но наверняка пришлют подарки."
    lartua_y "许多西方领主不会来，但肯定会送礼物。"

# game/a15/7wed_prep.rpy:21
translate english wed_prep_605c9f45:

    # lartua_y "Мой дедушка, Лорт Лартуа, например."
    lartua_y "比如我的祖父，洛尔特·拉尔图阿。"

# game/a15/7wed_prep.rpy:22
translate english wed_prep_7920d1f4:

    # lia "Ты будешь слать формальную благодарность собственному деду?"
    lia "你要给自己的祖父寄正式感谢信？"

# game/a15/7wed_prep.rpy:23
translate english wed_prep_49ae3f90_1:

    # lartua_y "Это..."
    lartua_y "这是……"

# game/a15/7wed_prep.rpy:24
translate english wed_prep_f42e2c14:

    # lia "Да-да. Правила приличия. Этих правил тут целая стопка."
    lia "是是。礼仪规矩。这里有一整摞规矩。"

# game/a15/7wed_prep.rpy:25
translate english wed_prep_52dd32d9:

    # lartua_y "Мы должны упомянуть всех вассалов. Больших и малых. Здесь и благодарности для тех, кто приедет с дарами лично."
    lartua_y "我们必须提到所有附庸。大小都要。这里也有给那些亲自带礼物来的人的谢辞。"

# game/a15/7wed_prep.rpy:27
translate english wed_prep_d9e9021d:

    # lia "Ты не устал все это писать?"
    lia "你写这些不累吗？"

# game/a15/7wed_prep.rpy:28
translate english wed_prep_5a8d9e89:

    # lartua_y "Я привык. До того, как отец отослал меня в Столицу - я вел все его дела в замке."
    lartua_y "我习惯了。在父亲把我送到首都之前——我在城堡里处理他所有事务。"

# game/a15/7wed_prep.rpy:29
translate english wed_prep_d535823f:

    # lia "Так ты был замковым писарем?"
    lia "所以你是城堡文书？"

# game/a15/7wed_prep.rpy:30
translate english wed_prep_3226e321:

    # lartua_y "Ну можно и так сказать."
    lartua_y "也可以这么说。"

# game/a15/7wed_prep.rpy:31
translate english wed_prep_44fe0bcc:

    # lia "Это там ты научился всем этим... формальностям?"
    lia "你是在那儿学会这些……形式规矩的？"

# game/a15/7wed_prep.rpy:32
translate english wed_prep_211f78f0:

    # lartua_y "Это правила хорошего тона. Мы должны."
    lartua_y "这是礼貌规矩。我们必须如此。"

# game/a15/7wed_prep.rpy:33
translate english wed_prep_045218f7:

    # lia "Нет. Я не об этом. Я и сама люблю писать, но обязательно делать это так... сухо."
    lia "不。我不是说这个。我自己也喜欢写东西，但非得写得这么……干巴巴吗。"

# game/a15/7wed_prep.rpy:34
translate english wed_prep_9c015542:

    # lartua_y "В каком смысле?"
    lartua_y "什么意思？"

# game/a15/7wed_prep.rpy:35
translate english wed_prep_2df53b04:

    # lia "Ну было бы гораздо лучше, если бы мы сначала узнали о дарах и потом уже персонализировано поблагодарили за каждый из них."
    lia "嗯，如果我们先知道礼物是什么，然后针对每一件分别感谢，会好得多。"

# game/a15/7wed_prep.rpy:36
translate english wed_prep_cb2e0b24:

    # lartua_y "Персонализированно? Это займет кучу времени."
    lartua_y "分别感谢？那要花一大堆时间。"

# game/a15/7wed_prep.rpy:37
translate english wed_prep_87ee419d:

    # lia "Ты и так всю ночь просидел."
    lia "你本来就已经坐了一整晚。"

# game/a15/7wed_prep.rpy:38
translate english wed_prep_9081acd3:

    # lartua_y "Мой дед говорит, что все что можно сделать заранее - стоит сделать заранее."
    lartua_y "我祖父说，能提前做的事——就该提前做。"

# game/a15/7wed_prep.rpy:39
translate english wed_prep_687f733b:

    # lia "В этом секрет его долголетия? Он уже прожил все жизненные трудности и опасности заранее?"
    lia "这就是他长寿的秘诀？他已经提前经历完了一生的艰辛和危险？"

# game/a15/7wed_prep.rpy:40
translate english wed_prep_192a9017:

    # lartua_y "М?"
    lartua_y "嗯？"

# game/a15/7wed_prep.rpy:41
translate english wed_prep_c6ac39e1:

    # lia "Можно я хоть строчку от себя добавлю, когда мы увидим дары?"
    lia "等我们看到礼物时，我至少能加一句自己的话吗？"

# game/a15/7wed_prep.rpy:42
translate english wed_prep_e40e4ae3:

    # lartua_y "Конечно."
    lartua_y "当然。"

# game/a15/7wed_prep.rpy:44
translate english wed_prep_f12efe55:

    # me "Дары? Я как раз привез полный трюм северной селедки. Подойдет?"
    me "礼物？我正好带了一整舱北方鲱鱼。行吗？"

# game/a15/7wed_prep.rpy:45
translate english wed_prep_48c17b03:

    # lia "А?"
    lia "啊？"

# game/a15/7wed_prep.rpy:46
translate english wed_prep_e03edfc1:

    # me "Хотя полагаю часть уже стухла, надеюсь принцесса не воспримет это как оскорбление? Не хотелось бы потом читать от нее гадости в письме."
    me "不过我想有一部分已经臭了。希望公主不会把这当成侮辱？我可不想之后在信里读到她的难听话。"

# game/a15/7wed_prep.rpy:47
translate english wed_prep_d3072613:

    # lia "[mename]?"
    lia "[mename]？"

# game/a15/7wed_prep.rpy:50
translate english wed_prep_9770a311:

    # lia "[mename]!"
    lia "[mename]！"

# game/a15/7wed_prep.rpy:51
translate english wed_prep_dba51542:

    # me "Осторожнее. Если упадем - придется свадьбу отложить."
    me "小心点。要是我们摔了——婚礼就得推迟了。"

# game/a15/7wed_prep.rpy:52
translate english wed_prep_a43b078e:

    # lartua_y "Рад вас видеть, мой принц."
    lartua_y "很高兴见到您，我的王子。"

# game/a15/7wed_prep.rpy:53
translate english wed_prep_90008846:

    # lia "Ну наконец-то ты приехал!"
    lia "你终于回来了！"

# game/a15/7wed_prep.rpy:54
translate english wed_prep_55e92d9f:

    # me "И я рад вас видеть."
    me "我也很高兴见到你们。"

# game/a15/7wed_prep.rpy:55
translate english wed_prep_4dc21ff9:

    # lia "Я уже думала, что ты не успеешь!"
    lia "我都以为你赶不上了！"

# game/a15/7wed_prep.rpy:56
translate english wed_prep_6b3a55fd:

    # me "Я бы не пропустил свадьбу своей сестренки."
    me "我不会错过我妹妹的婚礼。"

# game/a15/7wed_prep.rpy:57
translate english wed_prep_6b576cae:

    # lia "Кайден говорил, порты уже замерзли и ты не приплывешь!"
    lia "凯登说港口已经冻住了，你坐船回不来了！"

# game/a15/7wed_prep.rpy:58
translate english wed_prep_8feeabdc:

    # lartua_y "Ну... я..."
    lartua_y "嗯……我……"

# game/a15/7wed_prep.rpy:59
translate english wed_prep_d9781010:

    # me "А они и замерзли."
    me "它们确实冻住了。"

# game/a15/7wed_prep.rpy:60
translate english wed_prep_8c0b11af:

    # lia "Правда?"
    lia "真的？"

# game/a15/7wed_prep.rpy:61
translate english wed_prep_fc30fd2b:

    # me "Да."
    me "对。"

# game/a15/7wed_prep.rpy:62
translate english wed_prep_f91ec4f1:

    # lia "А как тогда ты приплыл?"
    lia "那你怎么坐船回来的？"

# game/a15/7wed_prep.rpy:64
translate english wed_prep_81a6b669:

    # lia "Постой. Не говори. Я сама угадаю."
    lia "等等。别说。我自己猜。"

# game/a15/7wed_prep.rpy:65
translate english wed_prep_0dac9ee2:

    # lia "Ты сказал, что ни за что не пропустишь свадьбу сестры и вы с командой неделю рубили ледоколами проход из порта в море?"
    lia "你说过绝不会错过妹妹的婚礼，于是你和船员用破冰船花了一周从港口砍出一条通往海的路？"

# game/a15/7wed_prep.rpy:66
translate english wed_prep_5a7a7577:

    # me "Нет."
    me "不。"

# game/a15/7wed_prep.rpy:67
translate english wed_prep_13ab4d95:

    # lia "Вы... вы поставили корабль на бревна и покатили его по ним, пока не достигли воды."
    lia "你们……把船放到圆木上，一路滚到水边。"

# game/a15/7wed_prep.rpy:68
translate english wed_prep_27e3f41f:

    # me "Нет. Хотя идея не такая уж и плохая. Но тут нужно было готовиться заранее и доставать корабль из воды."
    me "不。不过这主意不坏。但得提前准备，还得先把船从水里弄出来。"

# game/a15/7wed_prep.rpy:69
translate english wed_prep_308d2a39:

    # lia "Либо сразу собирать его на льду и бревнах."
    lia "或者干脆直接在冰上和圆木上把船造出来。"

# game/a15/7wed_prep.rpy:70
translate english wed_prep_e7ead76d:

    # me "Нет. Мы этого не делали."
    me "不。我们没这么做。"

# game/a15/7wed_prep.rpy:71
translate english wed_prep_cb7fd2a5:

    # lia "Вы... развели десятки костров и растопили лед."
    lia "你们……点了数十堆篝火把冰融化了。"

# game/a15/7wed_prep.rpy:72
translate english wed_prep_42432f24:

    # me "Нет. Пришлось бы весь порт разобрать, чтобы развести такие большие костры."
    me "不。那得把整个港口拆了才点得起那么大的火。"

# game/a15/7wed_prep.rpy:73
translate english wed_prep_884f35e9:

    # lia "Дракон растопил лед."
    lia "一条龙融化了冰。"

# game/a15/7wed_prep.rpy:74
translate english wed_prep_a19194da:

    # me "Было бы круто. Но нет."
    me "那会很酷。但不是。"

# game/a15/7wed_prep.rpy:75
translate english wed_prep_fb8aadbf:

    # lia "Вы купили у гномов черной серы и взорвали лед."
    lia "你们从矮人那儿买了黑硫磺把冰炸了。"

# game/a15/7wed_prep.rpy:76
translate english wed_prep_6141c1e7:

    # me "Нет... но это интересная задумка."
    me "不……不过这想法挺有意思。"

# game/a15/7wed_prep.rpy:77
translate english wed_prep_89069516:

    # lia "Ладно, я сдаюсь. Как ты приплыл через лёд? Вы отплыли до того, как порт затянуло?"
    lia "好吧，我放弃。你怎么穿过冰的？你们在港口封冻前就出航了？"

# game/a15/7wed_prep.rpy:78
translate english wed_prep_966f1b63:

    # me "Нет. Мы просто добрались верхом."
    me "不。我们只是骑马回来的。"

# game/a15/7wed_prep.rpy:79
translate english wed_prep_3915c753:

    # lia "Оу..."
    lia "哦……"

# game/a15/7wed_prep.rpy:80
translate english wed_prep_2d42945b:

    # me "Ага."
    me "嗯。"

# game/a15/7wed_prep.rpy:81
translate english wed_prep_a9867176:

    # lia "Я скучала."
    lia "我想你了。"

# game/a15/7wed_prep.rpy:82
translate english wed_prep_f7ed4027:

    # me "Я тоже."
    me "我也想你。"

# game/a15/7wed_prep.rpy:85
translate english wed_prep_dc7ab885:

    # me "{i}Что-то она совсем не держит себя в руках.{/i}"
    me "{i}她完全控制不住自己。{/i}"

# game/a15/7wed_prep.rpy:86
translate english wed_prep_dc755162:

    # me "{i}Не то, чтобы я был против.{/i}"
    me "{i}倒不是说我反对。{/i}"

# game/a15/7wed_prep.rpy:87
translate english wed_prep_1c806e75:

    # me "{i}Но вот ее муж...{/i}"
    me "{i}但她丈夫……{/i}"

# game/a15/7wed_prep.rpy:88
translate english wed_prep_cd832d77:

    # me "{i}Будущий муж.{/i}"
    me "{i}未来的丈夫。{/i}"

# game/a15/7wed_prep.rpy:89
translate english wed_prep_23f365a0:

    # me "{i}Хотя в прошлый раз он был довольно терпелив.{/i}"
    me "{i}不过上次他挺有耐心的。{/i}"

# game/a15/7wed_prep.rpy:90
translate english wed_prep_6bcfb8a7:

    # me "{i}Надеюсь так и будет продолжаться.{/i}"
    me "{i}希望一直如此。{/i}"

# game/a15/7wed_prep.rpy:91
translate english wed_prep_5c76dbe7:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a15/7wed_prep.rpy:92
translate english wed_prep_be6bb981:

    # me "{i}Главное, чтобы она не повторила такое при гостях на свадьбе.{/i}"
    me "{i}最重要的是别在婚礼宾客面前也这样。{/i}"

# game/a15/7wed_prep.rpy:93
translate english wed_prep_a3d875c4:

    # me "{i}Это было бы неловко.{/i}"
    me "{i}那就尴尬了。{/i}"

# game/a15/7wed_prep.rpy:96
translate english wed_prep_e69cbbfb:

    # lia "Мы с Кайденом поговорили и решили, что не против, если ты будешь с нами в день свадьбы. Да?"
    lia "我和凯登谈过了，我们决定不介意你婚礼那天跟我们在一起。对吧？"

# game/a15/7wed_prep.rpy:97
translate english wed_prep_e4dfa19c:

    # lartua_y "Ну..."
    lartua_y "嗯……"

# game/a15/7wed_prep.rpy:98
translate english wed_prep_9ed966f4:

    # me "В каком плане?"
    me "什么意思？"

# game/a15/7wed_prep.rpy:99
translate english wed_prep_eb1f7d80:

    # lia "Ну... покажешь как... ну ты понимаешь."
    lia "嗯……你教教我们怎么……你懂的。"

# game/a15/7wed_prep.rpy:100
translate english wed_prep_c8875827:

    # lartua_y "Принц [mename] выглядит как сведущий в вопросах любви."
    lartua_y "[mename]王子看起来对爱情之事很在行。"

# game/a15/7wed_prep.rpy:101
translate english wed_prep_08168a7f:

    # me "Нужен учитель."
    me "你们需要老师。"

# game/a15/7wed_prep.rpy:102
translate english wed_prep_d6a4d1af:

    # lia "Да! Будешь нашим учителем?"
    lia "对！你愿意当我们的老师吗？"

# game/a15/7wed_prep.rpy:103
translate english wed_prep_4f5c8a2f:

    # me "Если Кайден не против?"
    me "如果凯登不介意？"

# game/a15/7wed_prep.rpy:104
translate english wed_prep_b97c5ac6:

    # lartua_y "Ну... пока Лия еще слаба и не подходит для деторождения, так что..."
    lartua_y "嗯……莉亚现在还很虚弱，不适合生育，所以……"

# game/a15/7wed_prep.rpy:105
translate english wed_prep_7759d1cf:

    # lia "Так что есть время всему научится и абсолютно... безопасно."
    lia "所以有时间学一切，而且绝对……安全。"

# game/a15/7wed_prep.rpy:106
translate english wed_prep_e3469546:

    # lartua_y "Ну да..."
    lartua_y "嗯对……"

# game/a15/7wed_prep.rpy:107
translate english wed_prep_0cb8f5f6:

    # me "Посмотрим. Но вы ведь понимаете, что даже если я соглашусь - об этом никому не слова."
    me "再说吧。但你们得明白，就算我同意——也一个字都不能外传。"

# game/a15/7wed_prep.rpy:108
translate english wed_prep_8be8d453:

    # lia "Конечно! Это только между нами троими, да, Кайден?"
    lia "当然！只在我们三个人之间，对吧，凯登？"

# game/a15/7wed_prep.rpy:109
translate english wed_prep_13eb9e6a:

    # lartua_y "Да."
    lartua_y "对。"

# game/a15/7wed_prep.rpy:110
translate english wed_prep_71d3b8c8:

    # me "Хорошо."
    me "好。"

# game/a15/7wed_prep.rpy:112
translate english wed_prep_c220ae4d:

    # me "Так когда свадьба?"
    me "那婚礼什么时候？"

# game/a15/7wed_prep.rpy:113
translate english wed_prep_28cc193c:

    # lia "Послезавтра."
    lia "后天。"

# game/a15/7wed_prep.rpy:114
translate english wed_prep_c4cf5b55:

    # lartua_y "Мы пару раз откладывали ее."
    lartua_y "我们已经推迟过两次了。"

# game/a15/7wed_prep.rpy:115
translate english wed_prep_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/7wed_prep.rpy:116
translate english wed_prep_e8b28ab5:

    # lia "Тебя ждали."
    lia "在等你。"

# game/a15/7wed_prep.rpy:117
translate english wed_prep_4f00bbba:

    # lartua_y "Не только поэтому."
    lartua_y "不只是因为这个。"

# game/a15/7wed_prep.rpy:118
translate english wed_prep_eee34a2c:

    # me "А почему еще?"
    me "还有什么原因？"

# game/a15/7wed_prep.rpy:119
translate english wed_prep_72e80495:

    # lartua_y "По разным причинам. Сначала мой дед, лорд Лартуа, захотел приехать. Мы отложили свадьбу до его приезда, но ему стало плохо в дороге и он вернулся."
    lartua_y "各种原因。起初我祖父拉尔图阿领主想来。我们把婚礼推迟到他来，但他在路上病了，只好返回。"

# game/a15/7wed_prep.rpy:120
translate english wed_prep_f4eb646d:

    # me "А потом?"
    me "然后呢？"

# game/a15/7wed_prep.rpy:121
translate english wed_prep_d08ce918:

    # lartua_y "Река разродилась золотом."
    lartua_y "河里涌出了黄金。"

# game/a15/7wed_prep.rpy:122
translate english wed_prep_2325fa76:

    # me "И что?"
    me "那又怎样？"

# game/a15/7wed_prep.rpy:123
translate english wed_prep_0a211785:

    # lartua_y "Простолюдины массово стали собирать его и на рынке Золотой Столицы взлетели цены практически на все."
    lartua_y "平民开始大规模淘金，黄金首都市场上的几乎所有东西都涨价了。"

# game/a15/7wed_prep.rpy:124
translate english wed_prep_f105d703:

    # me "И как вы с этим справились?"
    me "那你们怎么处理的？"

# game/a15/7wed_prep.rpy:125
translate english wed_prep_80e03eab:

    # lartua_y "Ваш отец ввел имперскую регуляцию. Запретил обменивать товары на необработанное золото."
    lartua_y "您父亲颁布了帝国管制令。禁止用商品交换未加工黄金。"

# game/a15/7wed_prep.rpy:126
translate english wed_prep_934e5a7f:

    # me "Звучит не очень хорошо."
    me "听起来不太好。"

# game/a15/7wed_prep.rpy:127
translate english wed_prep_f4a21c91:

    # lartua_y "О нет, он открыл обмен самородков на монеты в канцеляриях."
    lartua_y "哦不，他在各官署开设了金块换钱币的兑换。"

# game/a15/7wed_prep.rpy:128
translate english wed_prep_6dc2d9ff:

    # me "Так с ценами все нормально."
    me "那物价就正常了。"

# game/a15/7wed_prep.rpy:129
translate english wed_prep_c08d675f:

    # lartua_y "Уже намного лучше. Кстати об этом - вы не против, если я отлучусь? Мне нужно согласовать раздачу милостыни на свадьбе."
    lartua_y "已经好多了。说到这个——您不介意我离开一下吗？我得去安排婚礼上的施舍。"

# game/a15/7wed_prep.rpy:130
translate english wed_prep_8f9071f9:

    # me "Конечно."
    me "当然。"

# game/a15/7wed_prep.rpy:133
translate english wed_prep_c1007a42:

    # me "Это, конечно, твоя идея."
    me "这当然是你的主意。"

# game/a15/7wed_prep.rpy:134
translate english wed_prep_93e4c783:

    # lia "Какая?"
    lia "什么主意？"

# game/a15/7wed_prep.rpy:135
translate english wed_prep_edf13b90:

    # me "Ты знаешь, какая."
    me "你知道是什么。"

# game/a15/7wed_prep.rpy:136
translate english wed_prep_60e3855c:

    # lia "Ну это ведь лучше, чем травить его или что-то вроде того."
    lia "嗯，总比毒死他或者别的什么好。"

# game/a15/7wed_prep.rpy:137
translate english wed_prep_eb6e502d:

    # me "Как ты вообще его уговорила?"
    me "你到底怎么说服他的？"

# game/a15/7wed_prep.rpy:138
translate english wed_prep_cd93be34:

    # lia "Сказала как есть - сейчас я все равно вряд ли рожу ребенка, так что мы могли потратить время на обучение искусству любви."
    lia "我照实说了——反正我现在多半生不了孩子，所以我们可以把时间花在学习爱的艺术上。"

# game/a15/7wed_prep.rpy:139
translate english wed_prep_c88bcf21:

    # me "И Кайден это принял?"
    me "凯登接受了？"

# game/a15/7wed_prep.rpy:140
translate english wed_prep_c049e440:

    # lia "Он любит обучаться!"
    lia "他喜欢学习！"

# game/a15/7wed_prep.rpy:141
translate english wed_prep_6ebb6b31:

    # me "Он..."
    me "他……"

# game/a15/7wed_prep.rpy:142
translate english wed_prep_014e1f5c:

    # me "Кайден любит цифры и буквы, да?"
    me "凯登喜欢数字和文字，对吧？"

# game/a15/7wed_prep.rpy:143
translate english wed_prep_479ff12b:

    # lia "Ага."
    lia "嗯。"

# game/a15/7wed_prep.rpy:144
translate english wed_prep_224f75ac:

    # me "Может назначить его главой монетной канцелярии?"
    me "也许该任命他当铸币官署长？"

# game/a15/7wed_prep.rpy:145
translate english wed_prep_43c38844:

    # lia "Отец уже сделал это."
    lia "父亲已经这么做了。"

# game/a15/7wed_prep.rpy:146
translate english wed_prep_8e592ad1:

    # me "Стоп. Правда?"
    me "等等。真的？"

# game/a15/7wed_prep.rpy:147
translate english wed_prep_5d19d3bb:

    # lia "Ну да. Ему же нужна какая-то должность при дворе."
    lia "是啊。他总得在宫廷里有个职位。"

# game/a15/7wed_prep.rpy:148
translate english wed_prep_c97fadc0:

    # me "Ну..."
    me "嗯……"

# game/a15/7wed_prep.rpy:149
translate english wed_prep_52bac8aa:

    # lia "Ты же сам секунду назад предложил его назначить на это место."
    lia "你一秒前自己还提议任命他到这个位置。"

# game/a15/7wed_prep.rpy:150
translate english wed_prep_e88f5641:

    # me "Да. Ты права. Просто подумал, что он довольно молод."
    me "对。你说得对。只是觉得他相当年轻。"

# game/a15/7wed_prep.rpy:151
translate english wed_prep_adb57d12:

    # lia "А на этой должности старость и опыт ничего не решают. Наоборот."
    lia "可在这个职位上，年老和经验什么都决定不了。恰恰相反。"

# game/a15/7wed_prep.rpy:152
translate english wed_prep_3da38285:

    # me "Наоборот?"
    me "恰恰相反？"

# game/a15/7wed_prep.rpy:153
translate english wed_prep_09182842:

    # lia "Ну да. Молодой - значит лучше и быстрее думает. К тому же у Кайдена нет никаких связей в Столице и его трудно заподозрить в нечестности."
    lia "对。年轻——就意味着头脑更好、更快。而且凯登在首都毫无人脉，很难怀疑他不诚实。"

# game/a15/7wed_prep.rpy:154
translate english wed_prep_34cb7265:

    # me "А что прошлый глава монетной канцелярии?"
    me "那上一任铸币官署长呢？"

# game/a15/7wed_prep.rpy:155
translate english wed_prep_416bac82:

    # lia "А что он? Он подчинился воле отца. Папа много тут чего поменял."
    lia "他怎么了？他服从了父亲的意志。爸爸在这里改了很多东西。"

# game/a15/7wed_prep.rpy:156
translate english wed_prep_91b9bec5:

    # me "Ну да... я заметил."
    me "是啊……我注意到了。"

# game/a15/7wed_prep.rpy:158
translate english wed_prep_1341f827:

    # lia "Рада, что ты снова тут!"
    lia "很高兴你又在这儿了！"

# game/a15/7wed_prep.rpy:159
translate english wed_prep_c7e006b1:

    # me "Ты не представляешь, как я рад оказаться дома."
    me "你想象不到我回到家有多高兴。"

# game/a15/7wed_prep.rpy:160
translate english wed_prep_bcb1be76:

    # lia "Когда будем продолжать писать твои Хроники? Наверняка с тобой произошло множество приключений!"
    lia "我们什么时候继续写你的《编年史》？你肯定经历了许多冒险！"

# game/a15/7wed_prep.rpy:161
translate english wed_prep_20c6fd67:

    # me "Врать не буду. Кое-что действительно произошло."
    me "我不撒谎。确实发生了一些事。"

# game/a15/7wed_prep.rpy:162
translate english wed_prep_ed1e590a:

    # lia "Вот и отлично. Назовем эту главу как-нибудь... 'Северные приключения принца'."
    lia "那太好了。这章就叫……《王子的北方冒险》。"

# game/a15/7wed_prep.rpy:163
translate english wed_prep_807c077c:

    # me "Как-то банально."
    me "有点俗。"

# game/a15/7wed_prep.rpy:164
translate english wed_prep_83291349:

    # lia "Холодные приключения."
    lia "《寒冷的冒险》。"

# game/a15/7wed_prep.rpy:165
translate english wed_prep_1396a5a3:

    # me "Слово 'приключение' слишком неподходящее для серьезной книги."
    me "‘冒险’这个词对一本严肃的书来说太不合适了。"

# game/a15/7wed_prep.rpy:166
translate english wed_prep_7e2b2507:

    # lia "Северный дипломатический визит."
    lia "《北方外交访问》。"

# game/a15/7wed_prep.rpy:167
translate english wed_prep_c97fadc0_1:

    # me "Ну..."
    me "嗯……"

# game/a15/7wed_prep.rpy:168
translate english wed_prep_e58e4097:

    # lia "Слишком формально? Первый визит на Север."
    lia "太正式了？《首次造访北方》。"

# game/a15/7wed_prep.rpy:169
translate english wed_prep_8a4d2e37:

    # me "Он не первый."
    me "不是第一次。"

# game/a15/7wed_prep.rpy:170
translate english wed_prep_fe5a314d:

    # lia "Первый визит на настоящий Север."
    lia "《首次造访真正的北方》。"

# game/a15/7wed_prep.rpy:171
translate english wed_prep_6440bbec:

    # me "Пойдет."
    me "可以。"

# game/a15/7wed_prep.rpy:172
translate english wed_prep_fce64930:

    # lia "Когда приступим? Сегодня? Завтра?"
    lia "什么时候开始？今天？明天？"

# game/a15/7wed_prep.rpy:173
translate english wed_prep_3b3610f7:

    # me "Давай после твоей свадьбы. Сразу запишем два значимых для меня события."
    me "等你的婚礼之后吧。一下子记下两件对我重要的事。"

# game/a15/7wed_prep.rpy:174
translate english wed_prep_bf3f834b:

    # lia "Моя свадьба для тебя значима?"
    lia "我的婚礼对你重要？"

# game/a15/7wed_prep.rpy:175
translate english wed_prep_8f9071f9_1:

    # me "Конечно."
    me "当然。"

# game/a15/7wed_prep.rpy:176
translate english wed_prep_3b661429:

    # lia "Хорошо. Но только не забудь за эти дни, что там с тобой на Севере случилось."
    lia "好。但这几天可别忘记你在北方发生了什么。"

# game/a15/7wed_prep.rpy:177
translate english wed_prep_f3142ead:

    # me "О. Я тебя уверяю. Я этого не забуду."
    me "哦。我向你保证。我不会忘。"

# game/a15/7wed_prep.rpy:184
translate english wed_prep2_2e48ab95:

    # zabawa "...наш родовой замок - Березовый Пик."
    zabawa "……我们祖传的城堡是白桦峰。"

# game/a15/7wed_prep.rpy:185
translate english wed_prep2_af465598:

    # conrad "Что-то слышал."
    conrad "听说过一些。"

# game/a15/7wed_prep.rpy:186
translate english wed_prep2_121c6838:

    # zabawa "Мы на самом юге Севера."
    zabawa "我们在北方的最南端。"

# game/a15/7wed_prep.rpy:187
translate english wed_prep2_616e8de8:

    # conrad "Понятно. А ваш дом? Чем известен?"
    conrad "明白了。那你们家族呢？以什么闻名？"

# game/a15/7wed_prep.rpy:188
translate english wed_prep2_7275dbb1:

    # zabawa "Красины известны особой ковкой железа, воинами, деревянной мебелью и торговлей."
    zabawa "克拉辛家族以特殊的铁锻造、战士、木制家具和贸易闻名。"

# game/a15/7wed_prep.rpy:189
translate english wed_prep2_8328af39:

    # conrad "Торговлей?"
    conrad "贸易？"

# game/a15/7wed_prep.rpy:190
translate english wed_prep2_c8e2176a:

    # zabawa "Когда наступают паводки и дороги у Орвальда затапливает - через наш замок проходят единственные сухопутные торговые пути на Север отсюда."
    zabawa "当洪水来临、奥瓦尔德的道路被淹时——从这里通往北方的唯一陆上商路就要经过我们的城堡。"

# game/a15/7wed_prep.rpy:191
translate english wed_prep2_2afaf49b:

    # conrad "А когда паводков нет?"
    conrad "那没有洪水的时候呢？"

# game/a15/7wed_prep.rpy:192
translate english wed_prep2_c71e13c9:

    # zabawa "Все равно нашу дорогу выбирают чаще. Она охраняется."
    zabawa "大家还是更常走我们的路。它有人守卫。"

# game/a15/7wed_prep.rpy:193
translate english wed_prep2_004d1018:

    # conrad "Понятно."
    conrad "明白了。"

# game/a15/7wed_prep.rpy:194
translate english wed_prep2_a752876e:

    # zabawa "А чем известен ваш дом?"
    zabawa "那你们家族以什么闻名？"

# game/a15/7wed_prep.rpy:195
translate english wed_prep2_f10a7b90:

    # conrad "Вы серьезно?"
    conrad "您是认真的？"

# game/a15/7wed_prep.rpy:196
translate english wed_prep2_b9cbde85:

    # zabawa "Вообще-то нет. Просто хотела показаться вежливой."
    zabawa "其实不是。只是想显得有礼貌。"

# game/a15/7wed_prep.rpy:197
translate english wed_prep2_1db3d01a:

    # conrad "Хорошо. Вежливость - признак благородства."
    conrad "好。礼貌是高贵之人的标志。"

# game/a15/7wed_prep.rpy:198
translate english wed_prep2_222f018c:

    # zabawa "И кротости."
    zabawa "也是温顺。"

# game/a15/7wed_prep.rpy:199
translate english wed_prep2_d22e7b25:

    # conrad "О, уверяю, я этого от жены не требую."
    conrad "哦，我保证，我不要求妻子这样。"

# game/a15/7wed_prep.rpy:201
translate english wed_prep2_f20196ea:

    # me "Смотрю, вы уже познакомились."
    me "看来你们已经认识了。"

# game/a15/7wed_prep.rpy:202
translate english wed_prep2_16732cf0:

    # conrad "Мой любимый племянник."
    conrad "我最喜欢的侄子。"

# game/a15/7wed_prep.rpy:203
translate english wed_prep2_d428a84c:

    # zabawa "Принц [mename]."
    zabawa "[mename]王子。"

# game/a15/7wed_prep.rpy:204
translate english wed_prep2_30f2eace:

    # me "Прошу прощения, что потревожил. Просто хотел спросить, все ли нормально."
    me "抱歉打扰。只是想问一切是否正常。"

# game/a15/7wed_prep.rpy:205
translate english wed_prep2_689711b0:

    # zabawa "Все хорошо."
    zabawa "一切都好。"

# game/a15/7wed_prep.rpy:206
translate english wed_prep2_fdfca039:

    # conrad "Более чем."
    conrad "再好不过。"

# game/a15/7wed_prep.rpy:207
translate english wed_prep2_723fa3b3:

    # me "Не станете меня сразу прогонять?"
    me "不会马上赶我走吧？"

# game/a15/7wed_prep.rpy:208
translate english wed_prep2_d124586a:

    # zabawa "Конечно нет."
    zabawa "当然不会。"

# game/a15/7wed_prep.rpy:209
translate english wed_prep2_bada70b7:

    # conrad "Присоединяйтесь."
    conrad "加入我们吧。"

# game/a15/7wed_prep.rpy:211
translate english wed_prep2_f76fc28e:

    # me "Как невеста, что я подобрал вам, дядя?"
    me "叔叔，我给您找的新娘怎么样？"

# game/a15/7wed_prep.rpy:212
translate english wed_prep2_fd998182:

    # conrad "Прекрасна, как сам Север."
    conrad "像北方本身一样美。"

# game/a15/7wed_prep.rpy:213
translate english wed_prep2_e8d6b6b2:

    # zabawa "Ой. Спасибо."
    zabawa "哎呀。谢谢。"

# game/a15/7wed_prep.rpy:214
translate english wed_prep2_8e314715:

    # me "Я рад, а как вы невесте?"
    me "我很高兴。那您对新娘来说怎么样？"

# game/a15/7wed_prep.rpy:215
translate english wed_prep2_a739de2e:

    # conrad "Надеюсь, что она хотя бы не в ужасе."
    conrad "希望她至少没被吓到。"

# game/a15/7wed_prep.rpy:216
translate english wed_prep2_506ae0c8:

    # zabawa "Уверена, что Конрад будет мне замечательным мужем."
    zabawa "我相信康拉德会是我的好丈夫。"

# game/a15/7wed_prep.rpy:217
translate english wed_prep2_e13a09ae:

    # me "Ну это самое главное. Что вы друг другу понравились."
    me "这才是最重要的。你们彼此喜欢。"

# game/a15/7wed_prep.rpy:218
translate english wed_prep2_a546760e:

    # conrad "Единственное о чем стоит заранее поговорить - мои обязанности."
    conrad "唯一值得提前谈的是我的职责。"

# game/a15/7wed_prep.rpy:219
translate english wed_prep2_36ffb538:

    # zabawa "А что с ними?"
    zabawa "它们怎么了？"

# game/a15/7wed_prep.rpy:220
translate english wed_prep2_672b6b1c:

    # me "Уверен, дядя, Император решит этот вопрос."
    me "我相信皇帝会解决这个问题，叔叔。"

# game/a15/7wed_prep.rpy:221
translate english wed_prep2_9ebeb8b6:

    # conrad "Правда?"
    conrad "真的？"

# game/a15/7wed_prep.rpy:222
translate english wed_prep2_319dd048:

    # me "А в чем проблема? Здесь половина покоев никак не используется. Занимайте те, что нравятся и все. Будете охранять не только королевских особ, но и свою жену и семью."
    me "有什么问题？这里一半的房间都空着。挑喜欢的住下就是了。你不只护卫王室成员，也护卫自己的妻子和家人。"

# game/a15/7wed_prep.rpy:223
translate english wed_prep2_a07017aa:

    # conrad "Это может усложнить выполнение мной клятв."
    conrad "这可能会让我更难履行誓言。"

# game/a15/7wed_prep.rpy:224
translate english wed_prep2_d2b04ecc:

    # me "Как?"
    me "怎么？"

# game/a15/7wed_prep.rpy:225
translate english wed_prep2_1bf3798e:

    # conrad "Вдруг мне придется выбирать?"
    conrad "万一我不得不选择呢？"

# game/a15/7wed_prep.rpy:226
translate english wed_prep2_4a26761a:

    # me "Уверен, что Забава не претендует на трон моего отца. Верно?"
    me "我相信扎巴娃不觊觎我父亲的王位。对吧？"

# game/a15/7wed_prep.rpy:227
translate english wed_prep2_856cd4b8:

    # zabawa "О боже, нет, конечно."
    zabawa "哦天哪，当然不。"

# game/a15/7wed_prep.rpy:228
translate english wed_prep2_11f9444a:

    # conrad "Я не об этом."
    conrad "我不是说这个。"

# game/a15/7wed_prep.rpy:229
translate english wed_prep2_6df5808a:

    # me "А о чем?"
    me "那是什么？"

# game/a15/7wed_prep.rpy:230
translate english wed_prep2_373cb172:

    # conrad "Забава, можешь...."
    conrad "扎巴娃，你能……"

# game/a15/7wed_prep.rpy:231
translate english wed_prep2_e10bd690:

    # zabawa "Конечно. Мне выйти?"
    zabawa "当然。要我出去吗？"

# game/a15/7wed_prep.rpy:232
translate english wed_prep2_5d740333:

    # conrad "Нет. Присядь пока за стол."
    conrad "不。先在桌边坐会儿。"

# game/a15/7wed_prep.rpy:234
translate english wed_prep2_d4d69dd5:

    # me "Ну и в чем дело?"
    me "那到底怎么回事？"

# game/a15/7wed_prep.rpy:235
translate english wed_prep2_abe6f24f:

    # conrad "Мое положение холостяка делает меня менее опасной политической фигурой. За мной с меньшей охотой пойдут и меня с меньшей вероятность смогут чем-то шантажировать."
    conrad "我单身这一点让我成为不那么危险的政治人物。别人不太会追随我，我也不太可能被人拿什么来要挟。"

# game/a15/7wed_prep.rpy:236
translate english wed_prep2_a7effbfc:

    # me "Например семьей. Я понимаю, Конрад. Но вы ведь уже давно не мой рыцарь-защитник. И насколько я понимаю, теперь гвардия подчиняется Императору и Трибуналу."
    me "比如拿家人。我明白，康拉德。但你早就不再是我的护卫骑士了。而且据我所知，现在卫队听命于皇帝和法庭。"

# game/a15/7wed_prep.rpy:237
translate english wed_prep2_f600f60e:

    # conrad "Да. Моему брату уже намного лучше."
    conrad "对。我兄弟已经好多了。各方面都是。"

# game/a15/7wed_prep.rpy:238
translate english wed_prep2_ca73744b:

    # me "В таком случае в чем проблема?"
    me "那问题在哪儿？"

# game/a15/7wed_prep.rpy:239
translate english wed_prep2_28b1ec04:

    # conrad "...могу я спросить?"
    conrad "……我能问一句吗？"

# game/a15/7wed_prep.rpy:240
translate english wed_prep2_2b851828:

    # me "Я могу сразу ответить. Причин несколько, но самая главная, как и всегда, - союз и выгодная сделка."
    me "我可以直接回答。原因有几个，但最主要的，一如既往——联盟和划算的交易。"

# game/a15/7wed_prep.rpy:241
translate english wed_prep2_df24289e:

    # conrad "Насколько выгодная?"
    conrad "有多划算？"

# game/a15/7wed_prep.rpy:243
translate english wed_prep2_fe4a4481:

    # me "Очень выгодная. Этот брак - одна из причин, почему я вернулся с короной."
    me "非常划算。这桩婚姻是我带着王冠回来的原因之一。"

# game/a15/7wed_prep.rpy:244
translate english wed_prep2_42d9d0f1:

    # conrad "Север у нас в руках?"
    conrad "北方在我们手里了？"

# game/a15/7wed_prep.rpy:245
translate english wed_prep2_ca0f3dcc:

    # me "Отчасти. Титул и корона точно."
    me "部分吧。头衔和王冠肯定。"

# game/a15/7wed_prep.rpy:246
translate english wed_prep2_9bde757f:

    # conrad "А как эта девушка и наш с ней брак связаны с твоей короной? Она же сестра лорда Яромира, а не Бориса."
    conrad "那这姑娘和我和她的婚姻跟你的王冠有什么关系？她是亚罗米尔领主的妹妹，不是鲍里斯的。"

# game/a15/7wed_prep.rpy:247
translate english wed_prep2_85d9902d:

    # me "Долгая история. Это была... взаимовыгодная сделка."
    me "说来话长。那是一次……互利的交易。"

# game/a15/7wed_prep.rpy:248
translate english wed_prep2_acbdc361:

    # conrad "...."
    conrad "……"

# game/a15/7wed_prep.rpy:250
translate english wed_prep2_ea97056e:

    # me "Нам нужна связь с Севером. Твой брак нам ее обеспечит."
    me "我们需要与北方的联系。你的婚姻能给我们提供。"

# game/a15/7wed_prep.rpy:251
translate english wed_prep2_19d38db1:

    # conrad "Ты вернулся с короной?"
    conrad "你带着王冠回来了？"

# game/a15/7wed_prep.rpy:252
translate english wed_prep2_01d128ea:

    # me "Без. Именно поэтому я должен собирать новый поход. Медленно. Не торопясь. Может следующая попытка будет через три года, а может через двадцать лет."
    me "没有。正因如此我才必须筹划新的行动。慢慢来。不急。下一次尝试也许是三年后，也许是二十年后。"

# game/a15/7wed_prep.rpy:253
translate english wed_prep2_cc09d91d:

    # me "С Борисом Дубовицким нужно действовать аккуратнее."
    me "对付鲍里斯·杜博维茨基得更加小心。"

# game/a15/7wed_prep.rpy:254
translate english wed_prep2_f42f16e1:

    # conrad "И что же. Этот брак - это часть этого... похода?"
    conrad "所以呢。这桩婚姻是那次……行动的一部分？"

# game/a15/7wed_prep.rpy:255
translate english wed_prep2_86780d3d:

    # me "Все так."
    me "正是。"

# game/a15/7wed_prep.rpy:256
translate english wed_prep2_a5dde3ec:

    # conrad "..."
    conrad "……"

# game/a15/7wed_prep.rpy:257
translate english wed_prep2_77a327f4:

    # me "Ты можешь отказаться. Это подставит только меня, а не тебя."
    me "你可以拒绝。那只会让我陷入困境，不会是你。"

# game/a15/7wed_prep.rpy:258
translate english wed_prep2_ab493437:

    # conrad "Спятил? Мы семья. Я не стану тебя подставлять. К тому же Забава мне понравилась."
    conrad "你疯了吗？我们是一家人。我不会让你陷入困境。而且我喜欢扎巴娃。"

# game/a15/7wed_prep.rpy:259
translate english wed_prep2_489a247d:

    # me "Правда?"
    me "真的？"

# game/a15/7wed_prep.rpy:261
translate english wed_prep2_27a76ce0:

    # conrad "Мне всегда нравились северянки. Как и тебе, хех. Наверное, кровь моей матери."
    conrad "我一直喜欢北方女人。和你一样，嘿嘿。大概是我母亲的血缘。"

# game/a15/7wed_prep.rpy:262
translate english wed_prep2_335d343e:

    # me "Да. Теперь у нас в семье будет больше северной крови, чем когда-либо."
    me "对。现在我们家族里的北方血脉比以往任何时候都多。"

# game/a15/7wed_prep.rpy:264
translate english wed_prep2_02ed7e9a:

    # conrad "Мне всегда нравились северянки. Наверное кровь матери."
    conrad "我一直喜欢北方女人。大概是我母亲的血缘。"

# game/a15/7wed_prep.rpy:265
translate english wed_prep2_cb68e717:

    # conrad "Так что - я согласен."
    conrad "所以——我同意。"

# game/a15/7wed_prep.rpy:266
translate english wed_prep2_662394a7:

    # me "Хорошо. Спасибо, дядя Конрад."
    me "好。谢谢你，康拉德叔叔。"

# game/a15/7wed_prep.rpy:267
translate english wed_prep2_3c64b313:

    # conrad "Не за что, парень."
    conrad "别客气，小子。"

# game/a15/7wed_prep.rpy:269
translate english wed_prep2_368e24eb:

    # conrad "Вы там не скучаете, Забава?"
    conrad "你在那边不无聊吧，扎巴娃？"

# game/a15/7wed_prep.rpy:270
translate english wed_prep2_03b59ab4:

    # zabawa "Нет. Все нормально. А почему тут два вида вина?"
    zabawa "不。一切都好。为什么这儿有两种酒？"

# game/a15/7wed_prep.rpy:271
translate english wed_prep2_384dbc6c:

    # conrad "Такая традиция, одно для беседы - другое для еды."
    conrad "这是传统，一种用来谈话——另一种用来配餐。"

# game/a15/7wed_prep.rpy:272
translate english wed_prep2_bd83b8ff:

    # zabawa "Для беседы? Почему тогда вы и принц [mename] беседуете совсем без вина?"
    zabawa "用来谈话？那您和[mename]王子谈话时怎么完全不喝酒？"

# game/a15/7wed_prep.rpy:273
translate english wed_prep2_22359509:

    # conrad "Принц [mename] и я уже все обсудили. Правда?"
    conrad "我和[mename]王子已经谈完了一切。对吧？"

# game/a15/7wed_prep.rpy:274
translate english wed_prep2_2d42945b:

    # me "Ага."
    me "嗯。"

# game/a15/7wed_prep.rpy:275
translate english wed_prep2_96be4a7b:

    # zabawa "Значит можем приступать к еде?"
    zabawa "那我们可以开始吃了吗？"

# game/a15/7wed_prep.rpy:276
translate english wed_prep2_01d48d32:

    # conrad "Не совсем. Мы еще ждем."
    conrad "还不完全。我们还在等。"

# game/a15/7wed_prep.rpy:277
translate english wed_prep2_dc7a6776:

    # zabawa "Но ведь принц уже здесь."
    zabawa "可王子已经在这儿了。"

# game/a15/7wed_prep.rpy:278
translate english wed_prep2_6fbe9268:

    # me "О. Я здесь почти случайно."
    me "哦。我来这儿几乎是偶然。"

# game/a15/7wed_prep.rpy:279
translate english wed_prep2_cbf3c2b8:

    # zabawa "А кого же мы тогда ждем?"
    zabawa "那我们在等谁？"

# game/a15/7wed_prep.rpy:280
translate english wed_prep2_9412d9c9:

    # me "Мою сестру и ее жениха."
    me "我妹妹和她的未婚夫。"

# game/a15/7wed_prep.rpy:281
translate english wed_prep2_60136a3a:

    # conrad "Нужно обсудить свадьбу."
    conrad "得讨论婚礼。"

# game/a15/7wed_prep.rpy:282
translate english wed_prep2_c039f4cb:

    # me "Ее и вашу."
    me "她的和你们的。"

# game/a15/7wed_prep.rpy:284
translate english wed_prep2_bc922083:

    # conrad "А вот и они."
    conrad "他们来了。"

# game/a15/7wed_prep.rpy:285
translate english wed_prep2_10072c53:

    # zabawa "Приветствую. Я - Забава Красина."
    zabawa "幸会。我是扎巴娃·克拉辛娜。"

# game/a15/7wed_prep.rpy:286
translate english wed_prep2_c4fa0587:

    # lia "Ой! Я [ophelia]! Но ты можешь звать меня [lia]! Это мой будущий муж - Кайден Лартуа."
    lia "哦！我是[ophelia]！但你可以叫我[lia]！这是我未来的丈夫——凯登·拉尔图阿。"

# game/a15/7wed_prep.rpy:287
translate english wed_prep2_94ea5a13:

    # lartua_y "Приветствую вас."
    lartua_y "幸会。"

# game/a15/7wed_prep.rpy:288
translate english wed_prep2_9bc330fb:

    # conrad "Садитесь скорее, моя невеста уже давно хочет есть."
    conrad "快坐下，我的新娘早就想吃了。"

# game/a15/7wed_prep.rpy:289
translate english wed_prep2_228dcd95:

    # zabawa "Я вовсе не... но я бы не отказалась начать."
    zabawa "我没有……不过我不反对开始。"

# game/a15/7wed_prep.rpy:290
translate english wed_prep2_a36c1239:

    # lia "Конечно. Пойдем, Кайден."
    lia "当然。走吧，凯登。"

# game/a15/7wed_prep.rpy:291
translate english wed_prep2_1b75b193:

    # lartua_y "Ага. Вы ведь не против свадьбы в один день? Просто если против - мне нужно написать одно письмо и я присоединюсь позже..."
    lartua_y "嗯。你们不介意同一天举行婚礼吧？如果介意——我得写一封信，晚点再加入……"

# game/a15/7wed_prep.rpy:292
translate english wed_prep2_802aa52c:

    # zabawa "Конечно мы не против, верно... Конрад?"
    zabawa "我们当然不介意，对吧……康拉德？"

# game/a15/7wed_prep.rpy:293
translate english wed_prep2_76ed64d1:

    # conrad "Сэкономим казне кучу золота, если организуем две свадьбы в один день."
    conrad "同一天办两场婚礼，能替国库省下一大堆金子。"

# game/a15/7wed_prep.rpy:294
translate english wed_prep2_7c0dfa0e:

    # me "Приятного вам аппетита и приятного разговора."
    me "祝你们用餐愉快，谈话愉快。"

# game/a15/7wed_prep.rpy:295
translate english wed_prep2_57c11c3d:

    # conrad "Не останешься?"
    conrad "你不留下？"

# game/a15/7wed_prep.rpy:296
translate english wed_prep2_dd17af43:

    # me "Нет. У меня еще пара дел."
    me "不。我还有几件事。"

# game/a15/7wed_prep.rpy:300
translate english wed_prep_queen_0f476a5d:

    # "Чуть позже."
    "稍后。"

# game/a15/7wed_prep.rpy:301
translate english wed_prep_queen_ec993c48:

    # me "Эй? Кто-нибудь есть тут?"
    me "喂？这里有人吗？"

# game/a15/7wed_prep.rpy:302
translate english wed_prep_queen_695b8530:

    # me "Мам?"
    me "妈？"

# game/a15/7wed_prep.rpy:303
translate english wed_prep_queen_61eef05d:

    # me "Королева Серафина?"
    me "塞拉菲娜女王？"

# game/a15/7wed_prep.rpy:304
translate english wed_prep_queen_143b957d:

    # me "Императрица Серафина?"
    me "塞拉菲娜皇后？"

# game/a15/7wed_prep.rpy:305
translate english wed_prep_queen_00b49edc:

    # me "Ау!"
    me "喂！"

# game/a15/7wed_prep.rpy:306
translate english wed_prep_queen_3820771a:

    # me "..."
    me "……"

# game/a15/7wed_prep.rpy:309
translate english wed_prep_queen_dc2f9ede:

    # me "Ты здесь?"
    me "你在吗？"

# game/a15/7wed_prep.rpy:310
translate english wed_prep_queen_af4e5374:

    # me "... ты еще кто?"
    me "……你又是谁？"

# game/a15/7wed_prep.rpy:311
translate english wed_prep_queen_d142468a:

    # doc "Принц [mename]?"
    doc "[mename]王子？"

# game/a15/7wed_prep.rpy:312
translate english wed_prep_queen_5e648c4f:

    # me "Как видишь."
    me "如你所见。"

# game/a15/7wed_prep.rpy:313
translate english wed_prep_queen_522bfe2f:

    # doc "Можете не искать королеву. В замке ее нет."
    doc "您不必找女王了。她不在城堡里。"

# game/a15/7wed_prep.rpy:314
translate english wed_prep_queen_8cc053bc:

    # me "А где она?"
    me "那她在哪儿？"

# game/a15/7wed_prep.rpy:315
translate english wed_prep_queen_752f157f:

    # doc "Не здесь."
    doc "不在这儿。"

# game/a15/7wed_prep.rpy:316
translate english wed_prep_queen_a42666ba:

    # me "Это я уже понял. А что здесь делаете вы?"
    me "这我已经明白了。那您在这儿做什么？"

# game/a15/7wed_prep.rpy:317
translate english wed_prep_queen_62cfcde1:

    # doc "Жду вас."
    doc "等您。"

# game/a15/7wed_prep.rpy:318
translate english wed_prep_queen_e9a9a02d:

    # me "Ну вы дождались. Теперь отвечайте на вопросы."
    me "那您等到了。现在回答问题。"

# game/a15/7wed_prep.rpy:319
translate english wed_prep_queen_c5d498e4:

    # doc "Ваша мать попросила передать это письмо."
    doc "您母亲让我转交这封信。"

# game/a15/7wed_prep.rpy:320
translate english wed_prep_queen_a0fc3c22:

    # me "Письмо?"
    me "信？"

# game/a15/7wed_prep.rpy:322
translate english wed_prep_queen_b35213d6:

    # me "Что-то не выглядит, как письмо."
    me "看起来不太像信。"

# game/a15/7wed_prep.rpy:323
translate english wed_prep_queen_87f5e731:

    # doc "Я не читал содержимого, не волнуйтесь."
    doc "我没读过内容，别担心。"

# game/a15/7wed_prep.rpy:324
translate english wed_prep_queen_9dd0224f:

    # me "Я должен поверить на слово?"
    me "我该信你一面之词？"

# game/a15/7wed_prep.rpy:325
translate english wed_prep_queen_6b232a43:

    # doc "Это эльфийские чернила. Откроете свиток и когда свет их коснется - они начнут пропадать."
    doc "这是精灵墨水。您打开卷轴，光一照到——字迹就会开始消失。"

# game/a15/7wed_prep.rpy:326
translate english wed_prep_queen_e0e03f96:

    # me "Как я тогда прочту текст?"
    me "那我怎么读？"

# game/a15/7wed_prep.rpy:327
translate english wed_prep_queen_beead3f0:

    # doc "У вас будет пара минут."
    doc "您会有几分钟。"

# game/a15/7wed_prep.rpy:328
translate english wed_prep_queen_25ae4d2c:

    # me "Как я могу проверить, не дурачите ли вы меня? Откуда мне знать, что это писала моя мать?"
    me "我怎么知道您不是在骗我？我怎么知道这是我母亲写的？"

# game/a15/7wed_prep.rpy:329
translate english wed_prep_queen_28ee296e:

    # doc "Понятия не имею. Мое дело - передать письмо."
    doc "我不知道。我的任务就是送信。"

# game/a15/7wed_prep.rpy:330
translate english wed_prep_queen_c164021f:

    # me "И долго вы здесь ждете меня?"
    me "您在这儿等我多久了？"

# game/a15/7wed_prep.rpy:331
translate english wed_prep_queen_f023bcd3:

    # doc "Дольше, чем хотелось бы. Но я дал обещание."
    doc "比我希望的久。但我许过诺。"

# game/a15/7wed_prep.rpy:332
translate english wed_prep_queen_611685a5:

    # me "Я вас помню. Вы врачеватель."
    me "我记得您。您是医师。"

# game/a15/7wed_prep.rpy:333
translate english wed_prep_queen_61976a23:

    # doc "Совершенно верно. Я помогал и вашей жене тоже. С уходом за беременностью."
    doc "完全正确。我也帮助过您的妻子。照顾孕期。"

