# game/a15/3frost_council.rpy:11
translate english frost_council_774a5ec6:

    # yar "...а может лучше проведем совет на старом добром пиру?"
    yar "……或者我们干脆在以前那种好宴席上开议会？"

# game/a15/3frost_council.rpy:12
translate english frost_council_b3047567:

    # corwin "Звучит неплохо."
    corwin "听起来不错。"

# game/a15/3frost_council.rpy:13
translate english frost_council_47b956fb:

    # ukradd "Может еще и деревенских девок приведем?"
    ukradd "要不要再叫些乡下姑娘来？"

# game/a15/3frost_council.rpy:14
translate english frost_council_187241d8:

    # yar "А что? Я только за!"
    yar "怎么不行？我完全赞成！"

# game/a15/3frost_council.rpy:15
translate english frost_council_806e9e13:

    # ukradd "Не сомневаюсь."
    ukradd "我不怀疑。"

# game/a15/3frost_council.rpy:16
translate english frost_council_da4da9b6:

    # yar "Мой отец всегда говорил - самые лучшие решения принимаются на полный желудок и пустые яица."
    yar "我父亲总说——最好的决定都是在吃饱肚子、蛋空了的时候做出的。"

# game/a15/3frost_council.rpy:17
translate english frost_council_e628be17:

    # ukradd "Насколько я помню, ваш отец погиб пьяным на охоте."
    ukradd "据我所知，您父亲是喝醉后打猎时死的。"

# game/a15/3frost_council.rpy:18
translate english frost_council_9f54bd0e:

    # yar "Это лучшая смерть для мужчины, лучше только умереть в бою, но бездна не смогла его забрать в битве у Синих Гор, пришлось утопиться в вине."
    yar "这是男人最好的死法，只有战死更好。但深渊没能在蓝山之战中带走他，他只好淹死在酒里。"

# game/a15/3frost_council.rpy:19
translate english frost_council_e5344e27:

    # gaston "Решение о судьбе нашего королевства лучше принимать на трезвую голову."
    gaston "决定我们王国命运的事，最好还是清醒时做。"

# game/a15/3frost_council.rpy:20
translate english frost_council_dc77db33:

    # skalad "К тому же никто не запрещает нам утонуть в вине и девках уже после собрания, лорд Яромир."
    skalad "而且没人禁止我们在大会之后再沉溺于酒和女人，亚罗米尔领主。"

# game/a15/3frost_council.rpy:21
translate english frost_council_d5d84e73:

    # yar "Звучит отлично. Нас уже двое, может еще кто? Так... кто тут не женат и еще не слишком стар?"
    yar "听起来好极了。已经有两个了，还有谁？那么……谁没结婚又还没太老？"

# game/a15/3frost_council.rpy:22
translate english frost_council_13e781fb:

    # yar "Лорд Корвин."
    yar "科文领主。"

# game/a15/3frost_council.rpy:23
translate english frost_council_78a41ba9:

    # corwin "Я вдовец."
    corwin "我是鳏夫。"

# game/a15/3frost_council.rpy:25
translate english frost_council_fd61f85a:

    # yar "Уверен, что ваша супруга не хотела бы, чтобы ее смерть превратила вас в евнуха."
    yar "我确信您妻子不会希望她的死把您变成太监。"

# game/a15/3frost_council.rpy:26
translate english frost_council_d580a335:

    # corwin "Я пожалуй воздержусь."
    corwin "我还是算了。"

# game/a15/3frost_council.rpy:27
translate english frost_council_5da701e0:

    # yar "Да ладно тебе. Как там звучит клятва перед безымянным богом? 'До самой смерти?' Думаю вам бояться нечего."
    yar "得了吧。在无名之神面前立的誓是怎么说的？‘至死为止？’我想您没什么好怕的。"

# game/a15/3frost_council.rpy:28
translate english frost_council_590f1228:

    # corwin "Дело не в клятвах."
    corwin "问题不在誓言。"

# game/a15/3frost_council.rpy:29
translate english frost_council_912b8631:

    # yar "А в чем? А... вы из 'этих'..."
    yar "那是什么？啊……您是‘那种’人……"

# game/a15/3frost_council.rpy:30
translate english frost_council_c9d3b82f:

    # corwin "Из 'этих'?"
    corwin "‘那种’人？"

# game/a15/3frost_council.rpy:31
translate english frost_council_9add78bd:

    # yar "Вам нравятся дамы поушастее, да?"
    yar "您喜欢耳朵尖一点的女人，对吧？"

# game/a15/3frost_council.rpy:32
translate english frost_council_b3331d99:

    # corwin "Что?"
    corwin "什么？"

# game/a15/3frost_council.rpy:33
translate english frost_council_ee6acacf:

    # yar "Найдем вам эльфику, лорд Корвин. К зиме они выползают из своих лесных нор в города."
    yar "我们给您找个精灵姑娘，科文领主。到冬天她们会从林中洞穴爬进城里。"

# game/a15/3frost_council.rpy:34
translate english frost_council_af152fb4:

    # corwin "Мне не нужны девки, ни человеческие, ни эльфиские."
    corwin "我不需要女人，人类的也好，精灵的也好。"

# game/a15/3frost_council.rpy:35
translate english frost_council_52ce21fe:

    # yar "Да ладно, вам, лорд Корвин. Здесь все свои. К тому же ваша репутация говорит сама за себя."
    yar "别这样，科文领主。这里都是自己人。而且您的名声已经说明一切了。"

# game/a15/3frost_council.rpy:36
translate english frost_council_631666a2:

    # corwin "Моя репутация?"
    corwin "我的名声？"

# game/a15/3frost_council.rpy:37
translate english frost_council_f27312e9:

    # yar "Кто бы еще стал держать в служанках эльфиек? Только тот, кто их любит потрахивать."
    yar "还有谁会雇精灵姑娘当女仆？只有喜欢上她们的人。"

# game/a15/3frost_council.rpy:38
translate english frost_council_453f8e61:

    # wojceh "Прекратите, лорд Яромир."
    wojceh "住口，亚罗米尔领主。"

# game/a15/3frost_council.rpy:40
translate english frost_council_2ae03a24:

    # yar "Разве я чем-то оскорбляю лорда Корвина? Это же все чистая правда?"
    yar "我哪里侮辱科文领主了？这不全是实话吗？"

# game/a15/3frost_council.rpy:41
translate english frost_council_2dec858d:

    # wojceh "Вы ведете себя неподобающе."
    wojceh "您的行为不得体。"

# game/a15/3frost_council.rpy:42
translate english frost_council_6d847374:

    # yar "Разве?"
    yar "是吗？"

# game/a15/3frost_council.rpy:43
translate english frost_council_7a9bb75b:

    # ukradd "Вынужден согласиться с лордом Войцехом."
    ukradd "我不得不赞同沃伊采赫领主。"

# game/a15/3frost_council.rpy:44
translate english frost_council_9890dc9e:

    # yar "Пф.. ну ладно. Простите, лорд Корвин."
    yar "噗……好吧。抱歉，科文领主。"

# game/a15/3frost_council.rpy:45
translate english frost_council_dc33101f:

    # corwin "Ага."
    corwin "嗯。"

# game/a15/3frost_council.rpy:46
translate english frost_council_eed45782:

    # ukradd "Думаю наши пристрастия вовсе не повод для оскорбления нашей чести, особенно если мы держим их под контролем, верно, лорд Войцех?"
    ukradd "我认为我们的癖好绝不是侮辱我们荣誉的理由，尤其是当我们能控制它们时，对吧，沃伊采赫领主？"

# game/a15/3frost_council.rpy:47
translate english frost_council_0b0f8f75:

    # wojceh "Разумеется."
    wojceh "当然。"

# game/a15/3frost_council.rpy:48
translate english frost_council_4e7031f8:

    # ukradd "Но вот те, кто себя не сдерживают, достойны и осуждения, и наказания. Особенно те, кто в попытке спасти свою репутацию губят и репутацию и иногда даже жизнь и свободу."
    ukradd "但那些不克制自己的人，就该受到谴责和惩罚。尤其是那些为了挽救自己名声，却毁掉名声、有时甚至毁掉生命和自由的人。"

# game/a15/3frost_council.rpy:49
translate english frost_council_4baab43b:

    # yar "Чего? Кого это я погубил?"
    yar "什么？我毁了谁？"

# game/a15/3frost_council.rpy:50
translate english frost_council_07c0fa85:

    # wojceh "Полагаю разговор больше не о вас, лорд Яромир."
    wojceh "我想这话已经不是关于您了，亚罗米尔领主。"

# game/a15/3frost_council.rpy:51
translate english frost_council_6a1e85a6:

    # skalad "А о ком это?"
    skalad "那是关于谁？"

# game/a15/3frost_council.rpy:52
translate english frost_council_5950563e:

    # ukradd "Да так. Абстрактный пример."
    ukradd "没什么。只是个抽象的例子。"

# game/a15/3frost_council.rpy:53
translate english frost_council_df0e82c1:

    # wojceh "Угу."
    wojceh "嗯。"

# game/a15/3frost_council.rpy:54
translate english frost_council_aaa6021d:

    # ukradd "Думаю, что в таком случае молчать бы было неразумным. Стоило бы высказать свою претензию."
    ukradd "我认为在这种情况下保持沉默是不明智的。应该说出自己的不满。"

# game/a15/3frost_council.rpy:55
translate english frost_council_36d40106:

    # wojceh "Вы в такой ситуации не были. Откуда вы можете судить, как бы поступили, лорд Украдский?"
    wojceh "您没经历过那种情况。您凭什么判断自己会怎么做，乌克拉德斯基领主？"

# game/a15/3frost_council.rpy:56
translate english frost_council_bd337bf0:

    # yar "Вы вообще о чем?"
    yar "你们到底在说什么？"

# game/a15/3frost_council.rpy:57
translate english frost_council_45b2509e:

    # skalad "Да. Проясните для нас ситуацию."
    skalad "对。给我们说清楚。"

# game/a15/3frost_council.rpy:58
translate english frost_council_6c17cb9c:

    # ukradd "Ну?"
    ukradd "怎么样？"

# game/a15/3frost_council.rpy:59
translate english frost_council_565e2a2b:

    # wojceh "Да не о чем. Забудьте."
    wojceh "没什么。忘了吧。"

# game/a15/3frost_council.rpy:60
translate english frost_council_3ba1f314:

    # skalad "Понятно."
    skalad "明白了。"

# game/a15/3frost_council.rpy:61
translate english frost_council_fa58857b:

    # ukradd "..."
    ukradd "……"

# game/a15/3frost_council.rpy:64
translate english frost_council_089cf339:

    # ostr_old "Это место хорошо защищено от вампиров?"
    ostr_old "这地方对吸血鬼防护得好吗？"

# game/a15/3frost_council.rpy:65
translate english frost_council_5a34b108:

    # wojceh "Вы со мной говорите?"
    wojceh "您在和我说话？"

# game/a15/3frost_council.rpy:66
translate english frost_council_a6e52c4e:

    # ostr_old "Мне кажется не очень. Здесь слишком много окон."
    ostr_old "我觉得不太好。这里窗户太多了。"

# game/a15/3frost_council.rpy:67
translate english frost_council_32f4992b:

    # ostr_old "Они могут наблюдать."
    ostr_old "他们能监视。"

# game/a15/3frost_council.rpy:68
translate english frost_council_5538f126:

    # wojceh "Кто?"
    wojceh "谁？"

# game/a15/3frost_council.rpy:69
translate english frost_council_4f46f6b6:

    # ostr_old "Сами знаете... если вы, конечно... нда..."
    ostr_old "您自己知道……当然，如果您……嗯……"

# game/a15/3frost_council.rpy:70
translate english frost_council_1f1e0251:

    # ostr_old "Покажите зубы."
    ostr_old "把牙露出来。"

# game/a15/3frost_council.rpy:71
translate english frost_council_7f28564a:

    # wojceh "Чего?"
    wojceh "什么？"

# game/a15/3frost_council.rpy:72
translate english frost_council_18f36f1f:

    # skalad "Лорд Войцех не вампир, не волнуйтесь, лорд Острожский. Я его сам проверил."
    skalad "沃伊采赫领主不是吸血鬼，别担心，奥斯特罗日斯基领主。我亲自检查过他。"

# game/a15/3frost_council.rpy:73
translate english frost_council_11720662:

    # ostr_old "Да? Ладно... ладно... но я ему все равно не верю..."
    ostr_old "是吗？好吧……好吧……但我还是不信他……"

# game/a15/3frost_council.rpy:76
translate english frost_council_63f55aea:

    # skalad "А где твой отец, Виктор?"
    skalad "你父亲在哪儿，维克？"

# game/a15/3frost_council.rpy:77
translate english frost_council_618158dd:

    # ostr_young "Вчера ночью выехал в Каменное Копье."
    ostr_young "昨晚去了石矛。"

# game/a15/3frost_council.rpy:78
translate english frost_council_efcc042d:

    # skalad "Что-то случилось?"
    skalad "出什么事了吗？"

# game/a15/3frost_council.rpy:79
translate english frost_council_71b398a6:

    # ostr_young "Срочные дела."
    ostr_young "紧急事务。"

# game/a15/3frost_council.rpy:80
translate english frost_council_98af29b3:

    # skalad "Настолько срочные, что он пропустил голосование?"
    skalad "紧急到错过了投票？"

# game/a15/3frost_council.rpy:81
translate english frost_council_b2cb7b34:

    # ostr_young "Не пропустил. Он оставил меня."
    ostr_young "没错过。他让我代替他。"

# game/a15/3frost_council.rpy:82
translate english frost_council_e568a6c5:

    # skalad "И что же, он и как проголосовать вам сказал?"
    skalad "那他也告诉您该怎么投票了？"

# game/a15/3frost_council.rpy:83
translate english frost_council_ffd1882a:

    # ostr_young "Разумеется."
    ostr_young "当然。"

# game/a15/3frost_council.rpy:84
translate english frost_council_dd86fc8c:

    # skalad "Да ну..."
    skalad "是吗……"

# game/a15/3frost_council.rpy:85
translate english frost_council_de9932ea:

    # ostr_young "Вы сомневаетесь в моей добродетели?"
    ostr_young "您怀疑我的品德？"

# game/a15/3frost_council.rpy:86
translate english frost_council_da5da056:

    # skalad "Я сомневаюсь в... здравии вашего отца."
    skalad "我怀疑……您父亲的神智。"

# game/a15/3frost_council.rpy:87
translate english frost_council_89698740:

    # ostr_young "На подобные решения и поручения мой отец еще вполне способен."
    ostr_young "我父亲还完全有能力做这样的决定和吩咐。"

# game/a15/3frost_council.rpy:88
translate english frost_council_824d554e:

    # skalad "Ну конечно... конечно..."
    skalad "当然……当然……"

# game/a15/3frost_council.rpy:90
translate english frost_council_58a81523:

    # skalad "Эх... рановато наше собрание."
    skalad "唉……我们这会开得有点早。"

# game/a15/3frost_council.rpy:91
translate english frost_council_31d89bc8:

    # ukradd "Полдень для вас это рано?"
    ukradd "正午对您来说算早？"

# game/a15/3frost_council.rpy:92
translate english frost_council_7ce8e3fe:

    # skalad "Ну..."
    skalad "嗯……"

# game/a15/3frost_council.rpy:93
translate english frost_council_48785188:

    # yar "Похоже лорд Скаладан прислушался к моему совету о девках, еще до того, как я его озвучил."
    yar "看来斯凯拉丹领主在我提出建议之前就听了我的女人建议。"

# game/a15/3frost_council.rpy:94
translate english frost_council_739fe517:

    # skalad "Нет... нет... я бы не стал... ни в коем случае."
    skalad "不……不……我不会……绝对不会。"

# game/a15/3frost_council.rpy:95
translate english frost_council_d7b1fd82:

    # yar "Ну конечно."
    yar "当然。"

# game/a15/3frost_council.rpy:96
translate english frost_council_e7c25c1a:

    # skalad "Но спал я не очень хорошо."
    skalad "但我没睡好。"

# game/a15/3frost_council.rpy:97
translate english frost_council_8018b188:

    # skalad "Надоело ждать."
    skalad "等烦了。"

# game/a15/3frost_council.rpy:98
translate english frost_council_b8f9328d:

    # skalad "Где главный виновник этого торжества?"
    skalad "这场庆典的主角在哪儿？"

# game/a15/3frost_council.rpy:103
translate english frost_council2_938fc252:

    # me "Лорд Войцех, Лорд Яромир, Лорд Гастон, Лорд Украдский, Лорд Острожский, Лорд Корвин, Лорд Скаладан. Рад вас видеть."
    me "沃伊采赫领主，亚罗米尔领主，加斯顿领主，乌克拉德斯基领主，奥斯特罗日斯基领主，科文领主，斯凯拉丹领主。很高兴见到诸位。"

# game/a15/3frost_council.rpy:104
translate english frost_council2_c0572a21:

    # wojceh "Принц [mename]."
    wojceh "[mename]王子。"

# game/a15/3frost_council.rpy:105
translate english frost_council2_a7d1fcdb:

    # yar "Принц! Ну наконец-то."
    yar "王子！终于来了。"

# game/a15/3frost_council.rpy:106
translate english frost_council2_82ba82ad:

    # corwin "Рад вас видеть, принц."
    corwin "很高兴见到您，王子。"

# game/a15/3frost_council.rpy:107
translate english frost_council2_4d3ed164:

    # gaston "Рад вас видеть, Принц [mename]."
    gaston "很高兴见到您，[mename]王子。"

# game/a15/3frost_council.rpy:108
translate english frost_council2_fa58857b:

    # ukradd "..."
    ukradd "……"

# game/a15/3frost_council.rpy:110
translate english frost_council2_e2be61d0:

    # ostr_old "Я вас уже где-то видел."
    ostr_old "我在哪儿见过您。"

# game/a15/3frost_council.rpy:112
translate english frost_council2_64dfcd80:

    # ostr_young "Принц."
    ostr_young "王子。"

# game/a15/3frost_council.rpy:113
translate english frost_council2_176b8bf8:

    # skalad "Я уже думал посылать слуг. Мы тут битый час сидим."
    skalad "我都在想该派仆人了。我们在这儿坐了整整一小时。"

# game/a15/3frost_council.rpy:114
translate english frost_council2_23ac9988:

    # me "Думаю пора начинать."
    me "我想该开始了。"

# game/a15/3frost_council.rpy:115
translate english frost_council2_fd67e667:

    # yar "Давно пора."
    yar "早该开始了。"

