translate english frost_counci_after_poison_32e3e1d5:

    # dubov "Что именно вы не понимаете?"
    dubov "您具体不明白什么？"

# game/a15/3frost_council.rpy:949
translate english frost_counci_after_poison_055f9f40:

    # me "Если вы все знали, почему вас не было на голосовании?"
    me "如果您全知道，为什么没去投票？"

# game/a15/3frost_council.rpy:951
translate english frost_counci_after_poison_79a535f3:

    # dubov "Мне было интересно. "
    dubov "我好奇。"

# game/a15/3frost_council.rpy:952
translate english frost_counci_after_poison_e89c8385:

    # me "Интересно притворяться отравленным?"
    me "好奇假装中毒？"

# game/a15/3frost_council.rpy:953
translate english frost_counci_after_poison_63f98955:

    # dubov "Интересно, что ты будешь делать."
    dubov "好奇你会怎么做。"

# game/a15/3frost_council.rpy:954
translate english frost_counci_after_poison_83692b1e:

    # me "А Скаладан и горцы? Это тоже из желания посмотреть, что я буду делать?"
    me "那斯凯拉丹和高地人呢？也是因为想看看我会怎么做？"

# game/a15/3frost_council.rpy:955
translate english frost_counci_after_poison_61b28e4e:

    # dubov "Разумеется. Я должен знать, способен ли будущий правитель Севера видеть не только перед своим носом и анализировать события в целом."
    dubov "当然。我必须知道北方未来的统治者能否不只看鼻子底下，而能整体分析事件。"

# game/a15/3frost_council.rpy:956
translate english frost_counci_after_poison_0b353441:

    # me "Ну и? Я справился?"
    me "然后呢？我通过了吗？"

# game/a15/3frost_council.rpy:957
translate english frost_counci_after_poison_3086c760:

    # dubov "Ты мне скажи."
    dubov "你告诉我。"

# game/a15/3frost_council.rpy:958
translate english frost_counci_after_poison_8f22b951:

    # me "Я справился. А голосование? Это тоже какая-то проверка?"
    me "我通过了。那投票呢？也是某种试探？"

# game/a15/3frost_council.rpy:959
translate english frost_counci_after_poison_029429e8_1:

    # dubov "Да."
    dubov "对。"

# game/a15/3frost_council.rpy:960
translate english frost_counci_after_poison_18f763a8:

    # me "И что я должен был показать на этой проверке?"
    me "那我在这个试探里应该展示什么？"

# game/a15/3frost_council.rpy:961
translate english frost_counci_after_poison_5f9f84ab:

    # dubov "Ты? Ничего. Тут ты просто действовал в своих интересах. Я проверял не тебя."
    dubov "你？没什么。你只是为自己的利益行动。我试探的不是你。"

# game/a15/3frost_council.rpy:962
translate english frost_counci_after_poison_fad187c3:

    # me "А кого?"
    me "那是谁？"

# game/a15/3frost_council.rpy:963
translate english frost_counci_after_poison_88151379:

    # dubov "Своих лордов."
    dubov "我的领主们。"

# game/a15/3frost_council.rpy:964
translate english frost_counci_after_poison_3820771a_2:

    # me "..."
    me "……"

# game/a15/3frost_council.rpy:965
translate english frost_counci_after_poison_bbca70c3:

    # dubov "Думаешь так сложно приставить к тебе стражу? Или созвать лордов раньше?"
    dubov "你觉得给你派个守卫很难？或者早点召集领主？"

# game/a15/3frost_council.rpy:966
translate english frost_counci_after_poison_4b98e7a0:

    # me "Вы проверяли их лояльность..."
    me "您在试探他们的忠诚……"

# game/a15/3frost_council.rpy:967
translate english frost_counci_after_poison_5d25ab52:

    # dubov "Молодец. И теперь, когда голосование прошло, я знаю, кто готов эту лояльность сменить."
    dubov "很好。现在投票结束了，我知道谁愿意改变忠诚。"

# game/a15/3frost_council.rpy:968
translate english frost_counci_after_poison_b3fb5428:

    # me "Вы не знаете... я не говорил вам, кто как проголосовал."
    me "您不知道……我没告诉您谁投了什么。"

# game/a15/3frost_council.rpy:969
translate english frost_counci_after_poison_1558f534:

    # dubov "[mename], ну неужели ты думаешь я об этом не позаботился?"
    dubov "[mename]，你真觉得我没安排好吗？"

# game/a15/3frost_council.rpy:970
translate english frost_counci_after_poison_3820771a_3:

    # me "..."
    me "……"

# game/a15/3frost_council.rpy:971
translate english frost_counci_after_poison_9b6156d6:

    # me "Вы назвали меня будущим правителем Севера."
    me "您称我为北方未来的统治者。"

# game/a15/3frost_council.rpy:972
translate english frost_counci_after_poison_1f577287:

    # dubov "Назвал. И это будущее очень скоро наступит, если ты, конечно, выполнишь пару моих условий."
    dubov "我说了。如果你完成我几个条件，这个未来很快就会到来。"

# game/a15/3frost_council.rpy:974
translate english frost_counci_after_poison_65a01e4e:

    # me "А я должен?"
    me "我必须吗？"

# game/a15/3frost_council.rpy:975
translate english frost_counci_after_poison_a017ccae:

    # dubov "Должен. Без меня тебе Север не получить. А теперь, когда ты попытался меня отравить..."
    dubov "必须。没有我你拿不到北方。而现在，既然你试图毒害我……"

# game/a15/3frost_council.rpy:976
translate english frost_counci_after_poison_282a6881:

    # me "Не смертельно отравить..."
    me "不是致命地下毒……"

# game/a15/3frost_council.rpy:977
translate english frost_counci_after_poison_079c0425:

    # dubov "[mename]... ты совершил преступление против короля Севера. У меня есть свидетель."
    dubov "[mename]……你对北方之王犯了罪。我有证人。"

# game/a15/3frost_council.rpy:979
translate english frost_counci_after_poison_01d27f10:

    # me "Свидетель и исполнитель. А еще это ваша дочь."
    me "证人和执行者。而且她还是您女儿。"

# game/a15/3frost_council.rpy:980
translate english frost_counci_after_poison_a6329614:

    # dubov "Все так. Это как-то отменяет факт преступления?"
    dubov "没错。这能取消犯罪事实吗？"

# game/a15/3frost_council.rpy:981
translate english frost_counci_after_poison_18dcdeca:

    # me "В это еще надо поверить."
    me "人们还得信才行。"

# game/a15/3frost_council.rpy:983
translate english frost_counci_after_poison_09556370:

    # me "Свидетель и исполнитель. А еще это ваша жена."
    me "证人和执行者。而且她还是您妻子。"

# game/a15/3frost_council.rpy:984
translate english frost_counci_after_poison_a6329614_1:

    # dubov "Все так. Это как-то отменяет факт преступления?"
    dubov "没错。这能取消犯罪事实吗？"

# game/a15/3frost_council.rpy:985
translate english frost_counci_after_poison_18dcdeca_1:

    # me "В это еще надо поверить."
    me "人们还得信才行。"

# game/a15/3frost_council.rpy:986
translate english frost_counci_after_poison_0935c1a4:

    # dubov "Кто-то не поверит. А кто-то поверит. Самое главное, что после таких обвинений предыдущее голосование ничего не будет значить."
    dubov "有人不信。有人信。最重要的是，这种指控之后，先前的投票就毫无意义了。"

# game/a15/3frost_council.rpy:987
translate english frost_counci_after_poison_d55ee101:

    # dubov "А новое тебе не выиграть."
    dubov "而新的投票你赢不了。"

# game/a15/3frost_council.rpy:988
translate english frost_counci_after_poison_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/3frost_council.rpy:989
translate english frost_counci_after_poison_eb87e184:

    # dubov "Потому что у меня достаточно рычагов давления, чтобы заставить каждого из лордов проголосовать так как я хочу."
    dubov "因为我有足够的施压手段，能让每个领主按我想要的方式投票。"

# game/a15/3frost_council.rpy:990
translate english frost_counci_after_poison_645cafa4:

    # dubov "Это испортит мои отношения с ними. Но я воспользуюсь компроматом, если это потребуется."
    dubov "这会破坏我和他们的关系。但如果需要，我会动用把柄。"

# game/a15/3frost_council.rpy:991
translate english frost_counci_after_poison_125425d1:

    # me "Компроматом? Каким например?"
    me "把柄？比如什么？"

# game/a15/3frost_council.rpy:992
translate english frost_counci_after_poison_c10450e4:

    # dubov "Например половина картин лорда Корвина украдена у Западной знати. Остальное у знати Золотого Королевства."
    dubov "比如科文领主一半的画是从西方贵族那里偷来的。其余来自黄金王国贵族。"

# game/a15/3frost_council.rpy:993
translate english frost_counci_after_poison_378cbc43:

    # me "То же мне секрет."
    me "那算什么秘密。"

# game/a15/3frost_council.rpy:994
translate english frost_counci_after_poison_138796fa:

    # dubov "Например один из лордов часто проводит время в компании своих рыцарей и их мальчишек-оруженосцев. А иногда и вовсе с простолюдинами. Но неизменно только с мужчинами."
    dubov "比如某位领主经常和他的骑士以及他们的侍从男孩待在一起。有时甚至和平民。但始终只和男人。"

# game/a15/3frost_council.rpy:995
translate english frost_counci_after_poison_3820771a_4:

    # me "..."
    me "……"

# game/a15/3frost_council.rpy:996
translate english frost_counci_after_poison_9b730a5c:

    # dubov "Кое-кто долго неформально...встречался с женой другого лорда, пока она не подцепила хворь по дороге домой и не умерла."
    dubov "某人长期非正式地……和另一位领主的妻子见面，直到她在回家路上染病死了。"

# game/a15/3frost_council.rpy:997
translate english frost_counci_after_poison_3820771a_5:

    # me "..."
    me "……"

# game/a15/3frost_council.rpy:998
translate english frost_counci_after_poison_b58965e6:

    # dubov "А кто-то растит своего внука, как сына, ибо настоящий отец покрыл себя таким позором, что его кровь теперь проклята в веках."
    dubov "而某人把孙子当儿子养，因为真正的父亲蒙受了如此耻辱，他的血如今被世代诅咒。"

# game/a15/3frost_council.rpy:999
translate english frost_counci_after_poison_b9d22102:

    # dubov "Мне продолжать?"
    dubov "还要我继续吗？"

# game/a15/3frost_council.rpy:1000
translate english frost_counci_after_poison_3820771a_6:

    # me "..."
    me "……"

# game/a15/3frost_council.rpy:1001
translate english frost_counci_after_poison_ffbdc63b:

    # dubov "Без меня тебе корону Севера не получить."
    dubov "没有我你拿不到北方王冠。"

# game/a15/3frost_council.rpy:1002
translate english frost_counci_after_poison_3f03bf05:

    # me "Хорошо. Ладно. Что вы хотите взамен?"
    me "好。好吧。您要什么回报？"

# game/a15/3frost_council.rpy:1003
translate english frost_counci_after_poison_f6b6b878:

    # dubov "Должность Имперского Смотрителя. Я хочу, чтобы ты ее оставил."
    dubov "帝国监视者一职。我要你保留它。"

# game/a15/3frost_council.rpy:1004
translate english frost_counci_after_poison_2769eae9:

    # me "Она почти повторяет полномочия короля, в чем смысл?"
    me "它几乎重复了国王的权力，有什么意义？"

# game/a15/3frost_council.rpy:1005
translate english frost_counci_after_poison_a3fae911:

    # dubov "Срастим их. Сделаем должность короля и смотрителя одним и тем же. Добавим самое лучшее из обоих миров."
    dubov "把它们合并。让国王和监视者成为同一个职位。取两者之长。"

# game/a15/3frost_council.rpy:1006
translate english frost_counci_after_poison_0022d6b1:

    # dubov "Оставим полномочия короля и добавим несменяемую назначаемость."
    dubov "保留国王的权力，加上不可撤换的任命。"

# game/a15/3frost_council.rpy:1007
translate english frost_counci_after_poison_e0cb25df:

    # me "А... теперь я понял. Вы хотите чтобы я сделал вас королем. Королем, которого нельзя больше сместить вотумами недоверия."
    me "啊……现在我明白了。您想让我把您变成国王。一个再也不能被不信任投票赶下台的国王。"

# game/a15/3frost_council.rpy:1008
translate english frost_counci_after_poison_c0363089:

    # dubov "Именно. Пожизненно."
    dubov "正是。终身。"

# game/a15/3frost_council.rpy:1009
translate english frost_counci_after_poison_905b678a:

    # me "И как на это отреагируют лорды?"
    me "那领主们会怎么反应？"

# game/a15/3frost_council.rpy:1010
translate english frost_counci_after_poison_865502e2:

    # dubov "В первый раз ты назначишь меня совместно с лордами. Сейчас у меня достаточно... поддержки, чтобы выиграть голосование."
    dubov "第一次你会和领主们一起任命我。现在我有足够的……支持来赢得投票。"

# game/a15/3frost_council.rpy:1011
translate english frost_counci_after_poison_d4a566d0:

    # me "А больше голосований и не будет. Вы будете на этом месте вечно."
    me "而且不会再有投票了。您将永远坐在这个位置上。"

# game/a15/3frost_council.rpy:1012
translate english frost_counci_after_poison_a0cfd20b:

    # dubov "Все верно кроме одного - вечного нет ничего. Однажды я умру."
    dubov "全对，除了一点——没有什么是永恒的。总有一天我会死。"

# game/a15/3frost_council.rpy:1013
translate english frost_counci_after_poison_3536d353:

    # me "А до этого никто и никогда не посмеет вас сместить?"
    me "在那之前没人敢撤换您？"

# game/a15/3frost_council.rpy:1016
translate english frost_counci_after_poison_8d76f64a:

    # dubov "Если только ты не нарушишь свое слово."
    dubov "除非你违背诺言。"

# game/a15/3frost_council.rpy:1017
translate english frost_counci_after_poison_87c0078e:

    # me "Как вы не нарушили свое?"
    me "就像您没违背自己的诺言一样？"

# game/a15/3frost_council.rpy:1018
translate english frost_counci_after_poison_0fb5b018:

    # dubov "Я не нарушал свое слово - ты станешь новым хозяином Севера. Как мы и договаривались."
    dubov "我没违背诺言——你会成为北方的新主人。正如我们约定的。"

# game/a15/3frost_council.rpy:1019
translate english frost_counci_after_poison_5dc2f44d:

    # me "Нет. Вы будете его хозяином. До самой смерти."
    me "不。您会是它的主人。直到死。"

# game/a15/3frost_council.rpy:1020
translate english frost_counci_after_poison_bebed51f:

    # dubov "Я лучший на этом месте. Я хорошо знаю каждого лорда, каждую их слабую и каждую сильную сторону. Я хозяин этой земли достаточно давно, чтобы и сама земля это чувствовала."
    dubov "我是这个位置最好的人选。我熟悉每一位领主，他们的每个弱点和强项。我统治这片土地够久，连土地本身都感觉得到。"

# game/a15/3frost_council.rpy:1021
translate english frost_counci_after_poison_d684eda4:

    # me "Так... ваше условие сделать вас несменяемым королем?"
    me "那……您的条件是把您变成不可撤换的国王？"

# game/a15/3frost_council.rpy:1022
translate english frost_counci_after_poison_df6347d0:

    # dubov "Не только."
    dubov "不只是。"

# game/a15/3frost_council.rpy:1023
translate english frost_counci_after_poison_33a30eaf:

    # me "Что еще?"
    me "还有什么？"

# game/a15/3frost_council.rpy:1024
translate english frost_counci_after_poison_3b10f790:

    # dubov "Имперский Ауксилат."
    dubov "帝国援助权。"

# game/a15/3frost_council.rpy:1025
translate english frost_counci_after_poison_f781d6c3:

    # me "Что? Тоже вернуть?"
    me "什么？这个也要恢复？"

# game/a15/3frost_council.rpy:1026
translate english frost_counci_after_poison_7c42fcdf:

    # dubov "Да. Но только для Короля."
    dubov "对。但只给国王。"

# game/a15/3frost_council.rpy:1027
translate english frost_counci_after_poison_e1c14a3a:

    # me "Короля-имперского смотрителя."
    me "国王兼帝国监视者。"

# game/a15/3frost_council.rpy:1028
translate english frost_counci_after_poison_72a45734:

    # dubov "Все верно."
    dubov "没错。"

# game/a15/3frost_council.rpy:1029
translate english frost_counci_after_poison_55e665fd:

    # me "Это прямая узурпация. Я назначаю вас вечным королем и только у вас будет возможность обратиться к Империи за помощью от несправедливости."
    me "这是赤裸裸的篡权。我任命您为永恒国王，只有您能向帝国请求援助以对抗不公。"

# game/a15/3frost_council.rpy:1030
translate english frost_counci_after_poison_b6dcf5a8:

    # dubov "Узурпация? [mename], ты забыл чей ты сын? Когда твой отец умрет, никто не станет голосовать за твое назначение на должность Императора, ты просто сам станешь им и все."
    dubov "篡权？[mename]，你忘了自己是谁的儿子？你父亲死后，没人会投票任命你为皇帝，你直接就是皇帝。"

# game/a15/3frost_council.rpy:1031
translate english frost_counci_after_poison_c97fadc0:

    # me "Ну..."
    me "嗯……"

# game/a15/3frost_council.rpy:1032
translate english frost_counci_after_poison_5c3da0c0:

    # dubov "Ты знаешь, что я прав."
    dubov "你知道我是对的。"

# game/a15/3frost_council.rpy:1033
translate english frost_counci_after_poison_2324170c:

    # dubov "А еще ты знаешь, что я лучший на этом месте. Ты видел всех моих лордов. Только я достоин ими управлять."
    dubov "而且你也知道我是这个位置最好的人选。你见过我所有领主。只有我配统治他们。"

# game/a15/3frost_council.rpy:1034
translate english frost_counci_after_poison_d0770267:

    # dubov "Я ведь не предлагаю тебе фальшивую корону - налоги рекрутами и золотом будут платиться, имперские законы будут соблюдаться, а в случае войны - северяне выполнят долг."
    dubov "我不是给你假王冠——征兵税和黄金税都会缴，帝国法律会遵守，战争时北方人会履行义务。"

# game/a15/3frost_council.rpy:1035
translate english frost_counci_after_poison_a7642595:

    # me "А взамен я сделаю своего нового друга королем. Навсегда."
    me "而作为回报，我把我的新朋友变成国王。永远。"

# game/a15/3frost_council.rpy:1036
translate english frost_counci_after_poison_5f611a12:

    # dubov "У меня нет сыновей, [mename]. Ты молод, а я стар. Для тебя эта сделка намного выгоднее, чем для меня. Решайся."
    dubov "我没有儿子，[mename]。你年轻，我老了。这笔交易对你远比对我有利。决定吧。"

# game/a15/3frost_council.rpy:1046
translate english frost_counci_after_poison_8d76f64a_1:

    # dubov "Если только ты не нарушишь свое слово."
    dubov "除非你违背诺言。"

# game/a15/3frost_council.rpy:1047
translate english frost_counci_after_poison_87c0078e_1:

    # me "Как вы не нарушили свое?"
    me "就像您没违背自己的诺言一样？"

# game/a15/3frost_council.rpy:1048
translate english frost_counci_after_poison_0fb5b018_1:

    # dubov "Я не нарушал свое слово - ты станешь новым хозяином Севера. Как мы и договаривались."
    dubov "我没违背诺言——你会成为北方的新主人。正如我们约定的。"

# game/a15/3frost_council.rpy:1049
translate english frost_counci_after_poison_5dc2f44d_1:

    # me "Нет. Вы будете его хозяином. До самой смерти."
    me "不。您会是它的主人。直到死。"

# game/a15/3frost_council.rpy:1050
translate english frost_counci_after_poison_bebed51f_1:

    # dubov "Я лучший на этом месте. Я хорошо знаю каждого лорда, каждую их слабую и каждую сильную сторону. Я хозяин этой земли достаточно давно, чтобы и сама земля это чувствовала."
    dubov "我是这个位置最好的人选。我熟悉每一位领主，他们的每个弱点和强项。我统治这片土地够久，连土地本身都感觉得到。"

# game/a15/3frost_council.rpy:1051
translate english frost_counci_after_poison_d684eda4_1:

    # me "Так... ваше условие сделать вас несменяемым королем?"
    me "那……您的条件是把您变成不可撤换的国王？"

# game/a15/3frost_council.rpy:1052
translate english frost_counci_after_poison_df6347d0_1:

    # dubov "Не только."
    dubov "不只是。"

# game/a15/3frost_council.rpy:1053
translate english frost_counci_after_poison_33a30eaf_1:

    # me "Что еще?"
    me "还有什么？"

# game/a15/3frost_council.rpy:1054
translate english frost_counci_after_poison_3b10f790_1:

    # dubov "Имперский Ауксилат."
    dubov "帝国援助权。"

# game/a15/3frost_council.rpy:1055
translate english frost_counci_after_poison_f781d6c3_1:

    # me "Что? Тоже вернуть?"
    me "什么？这个也要恢复？"

# game/a15/3frost_council.rpy:1056
translate english frost_counci_after_poison_7c42fcdf_1:

    # dubov "Да. Но только для Короля."
    dubov "对。但只给国王。"

# game/a15/3frost_council.rpy:1057
translate english frost_counci_after_poison_e1c14a3a_1:

    # me "Короля-имперского смотрителя."
    me "国王兼帝国监视者。"

# game/a15/3frost_council.rpy:1058
translate english frost_counci_after_poison_72a45734_1:

    # dubov "Все верно."
    dubov "没错。"

# game/a15/3frost_council.rpy:1059
translate english frost_counci_after_poison_9da21309:

    # me "Это прямая узурпация. Я назначаю вас вечным королем и только у вас будет возможность обратится к Империи за помощью от несправедливости."
    me "这是赤裸裸的篡权。我任命您为永恒国王，只有您能向帝国请求援助以对抗不公。"

# game/a15/3frost_council.rpy:1060
translate english frost_counci_after_poison_b6dcf5a8_1:

    # dubov "Узурпация? [mename], ты забыл чей ты сын? Когда твой отец умрет, никто не станет голосовать за твое назначение на должность Императора, ты просто сам станешь им и все."
    dubov "篡权？[mename]，你忘了自己是谁的儿子？你父亲死后，没人会投票任命你为皇帝，你直接就是皇帝。"

# game/a15/3frost_council.rpy:1061
translate english frost_counci_after_poison_c97fadc0_1:

    # me "Ну..."
    me "嗯……"

# game/a15/3frost_council.rpy:1062
translate english frost_counci_after_poison_eca2d2d2:

    # dubov "И еще кое-что. Раз уж ты проиграл голосование, мне придется приложить больше усилий."
    dubov "还有一件事。既然你输了投票，我就得付出更多努力。"

# game/a15/3frost_council.rpy:1063
translate english frost_counci_after_poison_5db4e0f3:

    # me "Значит еще одно условие?"
    me "所以还有一个条件？"

# game/a15/3frost_council.rpy:1064
translate english frost_counci_after_poison_fb1767d7:

    # dubov "Верно. Никаких Имперских сборщиков. Я буду собирать налоги рекрутами и золотом сам."
    dubov "没错。不要帝国税吏。征兵税和黄金税由我自己收。"

# game/a15/3frost_council.rpy:1065
translate english frost_counci_after_poison_065a28d3:

    # me "А до Империи что-то доходить будет?"
    me "那有什么会到帝国手里吗？"

# game/a15/3frost_council.rpy:1066
translate english frost_counci_after_poison_fa0277fb:

    # dubov "Разумеется."
    dubov "当然。"

# game/a15/3frost_council.rpy:1067
translate english frost_counci_after_poison_3820771a_7:

    # me "..."
    me "……"

# game/a15/3frost_council.rpy:1068
translate english frost_counci_after_poison_29cbd1e6:

    # dubov "Я лучший на этом месте. Ты видел всех моих лордов. Только я достоин ими управлять."
    dubov "我是这个位置最好的人选。你见过我所有领主。只有我配统治他们。"

