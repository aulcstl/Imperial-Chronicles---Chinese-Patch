# TODO: Translation updated at 2026-09-02 02:24

# game/a15/6cold_arriv.rpy:9
translate english cold_arriv_isi_f3c17626:

    # slug "...они подчиняются Королю... Императору, как главе Золотого Порядка."
    slug "……他们听命于国王……皇帝，作为黄金秩序的领袖。"

# game/a15/6cold_arriv.rpy:10
translate english cold_arriv_isi_c5ffbf38:

    # isi "Ну что ты, милая, я спрашиваю не о формальностях."
    isi "别这样，亲爱的，我问的不是形式上的东西。"

# game/a15/6cold_arriv.rpy:11
translate english cold_arriv_isi_4c52d6f2:

    # slug "А о чем?"
    slug "那是什么？"

# game/a15/6cold_arriv.rpy:12
translate english cold_arriv_isi_89f7f688:

    # isi "О том, кому эта новая гвардия подчиняется на самом деле."
    isi "这支新卫队实际上听命于谁。"

# game/a15/6cold_arriv.rpy:13
translate english cold_arriv_isi_404edb91:

    # slug "Не понимаю..."
    slug "我不明白……"

# game/a15/6cold_arriv.rpy:14
translate english cold_arriv_isi_91653e48:

    # isi "Ты наверняка видела и слышала, кто отдает им приказы. Кроме Императора разумеется."
    isi "你肯定看到也听到过是谁给他们下令。当然，除了皇帝之外。"

# game/a15/6cold_arriv.rpy:15
translate english cold_arriv_isi_9465d22a:

    # slug "Ну..."
    slug "嗯……"

# game/a15/6cold_arriv.rpy:16
translate english cold_arriv_isi_ffd3b4af:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:17
translate english cold_arriv_isi_ddab7a68:

    # slug "Ими часто руководит лорд Леонард. Кажется часть из новых гвардейцев из Арании."
    slug "他们常由莱昂纳德领主指挥。新卫兵里好像有一部分来自阿拉尼亚。"

# game/a15/6cold_arriv.rpy:19
translate english cold_arriv_isi_4e0126d5:

    # isi "Как ты это поняла?"
    isi "你怎么知道的？"

# game/a15/6cold_arriv.rpy:20
translate english cold_arriv_isi_146586d1:

    # slug "Ну они пьют это свое вино..."
    slug "嗯，他们喝那种自己的酒……"

# game/a15/6cold_arriv.rpy:21
translate english cold_arriv_isi_ff1e56fa:

    # isi "Аранское золотое."
    isi "阿兰金酒。"

# game/a15/6cold_arriv.rpy:22
translate english cold_arriv_isi_5b18d8ee:

    # slug "Да."
    slug "对。"

# game/a15/6cold_arriv.rpy:23
translate english cold_arriv_isi_9d4fc153:

    # isi "Это еще не значит, что они из Арании."
    isi "这还不能说明他们来自阿拉尼亚。"

# game/a15/6cold_arriv.rpy:24
translate english cold_arriv_isi_6beb2c4c:

    # slug "Пару девушек... из прислуги... не я... они рассказывали... в общем..."
    slug "有几个姑娘……女仆里的……不是我……她们说……总之……"

# game/a15/6cold_arriv.rpy:25
translate english cold_arriv_isi_ac8f092a:

    # isi "Что же они рассказывали?"
    isi "她们说了什么？"

# game/a15/6cold_arriv.rpy:26
translate english cold_arriv_isi_997a940a:

    # slug "Даже не знаю... это..."
    slug "我甚至不知道……这……"

# game/a15/6cold_arriv.rpy:27
translate english cold_arriv_isi_b17f7e80:

    # isi "Ну же, милая, мы почти подруги."
    isi "说吧，亲爱的，我们差不多算朋友了。"

# game/a15/6cold_arriv.rpy:28
translate english cold_arriv_isi_ce57662c:

    # slug "..."
    slug "……"

# game/a15/6cold_arriv.rpy:29
translate english cold_arriv_isi_84663e9a:

    # isi "А если будем всем делиться - станем подругами."
    isi "如果我们什么都说，就会成为朋友。"

# game/a15/6cold_arriv.rpy:30
translate english cold_arriv_isi_0b45d08e:

    # slug "Они соблазняли девушек из прислуги сладкими речами и говорили, что увезут их с собой в Аранию."
    slug "他们用甜言蜜语勾引女仆，说会把她们带去阿拉尼亚。"

# game/a15/6cold_arriv.rpy:31
translate english cold_arriv_isi_b833882f:

    # isi "Ну и что? Кто-нибудь соблазнился?"
    isi "那又怎样？有人上钩了吗？"

# game/a15/6cold_arriv.rpy:32
translate english cold_arriv_isi_9f89ae72:

    # slug "Не знаю."
    slug "不知道。"

# game/a15/6cold_arriv.rpy:33
translate english cold_arriv_isi_ffd3b4af_1:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:34
translate english cold_arriv_isi_841ef77d:

    # slug "Правда не знаю. Если бы и да... то они бы мне не рассказали."
    slug "真的不知道。就算有……她们也不会告诉我。"

# game/a15/6cold_arriv.rpy:35
translate english cold_arriv_isi_d8ee6237:

    # isi "Ну если узнаешь - обязательно расскажи."
    isi "如果你知道了——一定要告诉我。"

# game/a15/6cold_arriv.rpy:36
translate english cold_arriv_isi_74d523a2:

    # slug "Конечно."
    slug "当然。"

# game/a15/6cold_arriv.rpy:37
translate english cold_arriv_isi_9381192c:

    # isi "А что насчет других лордов? Чьи еще указания исполняют новые гвардейцы?"
    isi "那其他领主呢？新卫兵还执行谁的指示？"

# game/a15/6cold_arriv.rpy:38
translate english cold_arriv_isi_47446c90:

    # slug "Ммм... еще..."
    slug "嗯……还有……"

# game/a15/6cold_arriv.rpy:40
translate english cold_arriv_isi_4297051e:

    # slug "Кажется еще лорд Пойнас."
    slug "好像还有珀纳斯领主。"

# game/a15/6cold_arriv.rpy:42
translate english cold_arriv_isi_8d94cf34:

    # slug "Кажется еще лорд Лаггариус."
    slug "好像还有拉加里乌斯领主。"

# game/a15/6cold_arriv.rpy:44
translate english cold_arriv_isi_8d94cf34_1:

    # slug "Кажется еще лорд Лаггариус."
    slug "好像还有拉加里乌斯领主。"

# game/a15/6cold_arriv.rpy:46
translate english cold_arriv_isi_af08d037:

    # me "Прошу прощения, жена, я прерываю тебя?"
    me "恕我打扰，妻子，我打断你了吗？"

# game/a15/6cold_arriv.rpy:47
translate english cold_arriv_isi_26abaa19:

    # isi "Ох. [mename]. Ты наконец-то вернулся."
    isi "哦。[mename]。你终于回来了。"

# game/a15/6cold_arriv.rpy:48
translate english cold_arriv_isi_bc42f6c5:

    # slug "Ой.."
    slug "哎呀……"

# game/a15/6cold_arriv.rpy:49
translate english cold_arriv_isi_2197c9fa:

    # me "Сиди. Сиди, не волнуйся."
    me "坐着。坐着，别紧张。"

# game/a15/6cold_arriv.rpy:50
translate english cold_arriv_isi_a58600ec:

    # isi "Ты давно приехал?"
    isi "你回来多久了？"

# game/a15/6cold_arriv.rpy:51
translate english cold_arriv_isi_47966813:

    # me "Может час назад. Успел только помыться и переодеться."
    me "大概一小时前。只来得及洗漱换衣。"

# game/a15/6cold_arriv.rpy:52
translate english cold_arriv_isi_ec30c6b3:

    # isi "Странно. Я велела страже сообщить о твоем прибытии."
    isi "奇怪。我吩咐守卫通知我你回来了。"

# game/a15/6cold_arriv.rpy:53
translate english cold_arriv_isi_7474874f:

    # me "Мы заехали со стороны города. В этот раз вместо стражи меня встретили гвардейцы."
    me "我们从城市那侧进来的。这次迎接我的不是守卫，而是卫兵。"

# game/a15/6cold_arriv.rpy:54
translate english cold_arriv_isi_8964ee9d:

    # isi "О... мы как раз о них говорили."
    isi "哦……我们正谈他们呢。"

# game/a15/6cold_arriv.rpy:55
translate english cold_arriv_isi_489a247d:

    # me "Правда?"
    me "是吗？"

# game/a15/6cold_arriv.rpy:56
translate english cold_arriv_isi_8ecec372:

    # isi "Ага. Моя... новая подруга многое о них знает."
    isi "对。我的……新朋友知道很多他们的事。"

# game/a15/6cold_arriv.rpy:57
translate english cold_arriv_isi_1cd775c6:

    # slug "Я? Ну я не то чтобы много, но..."
    slug "我？嗯，也不能说很多，但……"

# game/a15/6cold_arriv.rpy:58
translate english cold_arriv_isi_60b6f7ac:

    # isi "Договорим чуть позже, дорогуша, мой муж вернулся после стольких месяцев разлуки, сама понимаешь. Оставь нас наедине."
    isi "我们晚点再聊，亲爱的。我丈夫分别这么多月回来了，你懂的。让我们单独待会儿。"

# game/a15/6cold_arriv.rpy:59
translate english cold_arriv_isi_fa605a99:

    # slug "Да моя короле... да, леди Исида."
    slug "是，我的女……是，伊西达女士。"

# game/a15/6cold_arriv.rpy:61
translate english cold_arriv_isi_3820771a:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:62
translate english cold_arriv_isi_ffd3b4af_2:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:63
translate english cold_arriv_isi_4fae060e:

    # me "...моя королева."
    me "……我的女王。"

# game/a15/6cold_arriv.rpy:64
translate english cold_arriv_isi_6d85ba00:

    # isi "Девочка просто оговорилась."
    isi "那姑娘只是口误。"

# game/a15/6cold_arriv.rpy:65
translate english cold_arriv_isi_37d07954:

    # me "Ну да. Конечно. Заводишь шпионскую сеть?"
    me "是啊。当然。在建立间谍网？"

# game/a15/6cold_arriv.rpy:66
translate english cold_arriv_isi_1aee13e5:

    # isi "Нет. Просто хочу с кем-нибудь подружиться."
    isi "不。只是想交个朋友。"

# game/a15/6cold_arriv.rpy:67
translate english cold_arriv_isi_80ec9cfd:

    # me "Подружиться. Со слугами."
    me "交朋友。和仆人。"

# game/a15/6cold_arriv.rpy:68
translate english cold_arriv_isi_41f55c04:

    # isi "А что?"
    isi "怎么了？"

# game/a15/6cold_arriv.rpy:69
translate english cold_arriv_isi_85426e27:

    # me "Нет. Ничего. Пожалуй это действительно полезное знакомство. На слуг редко кто-то обращает внимание. Но они часто видят и слышат больше остальных."
    me "不。没什么。也许这确实是有用的交情。很少有人注意仆人。但他们往往比其他人看到和听到的更多。"

# game/a15/6cold_arriv.rpy:70
translate english cold_arriv_isi_11babd5a:

    # isi "Так ты одобряешь?"
    isi "所以你赞成？"

# game/a15/6cold_arriv.rpy:71
translate english cold_arriv_isi_0c8dc9e4:

    # me "Думаю мое одобрение тебе не требуется, чтобы действовать так, как ты была научена."
    me "我想你按被教的方式行事，不需要我的批准。"

# game/a15/6cold_arriv.rpy:72
translate english cold_arriv_isi_9f737dda:

    # isi "Думаешь меня этому учили?"
    isi "你觉得有人教过我这个？"

# game/a15/6cold_arriv.rpy:73
translate english cold_arriv_isi_5276beb1:

    # me "Не сомневаюсь. Как называется этот метод вхождения в доверие? Десертный? Сладости и лесть?"
    me "我不怀疑。这种取得信任的方法叫什么？甜点法？糖果和奉承？"

# game/a15/6cold_arriv.rpy:74
translate english cold_arriv_isi_49efd308:

    # isi "Этот называется вежливость и дружелюбие."
    isi "这个叫礼貌和友善。"

# game/a15/6cold_arriv.rpy:75
translate english cold_arriv_isi_9aff69a1:

    # me "Дружелюбие?"
    me "友善？"

# game/a15/6cold_arriv.rpy:76
translate english cold_arriv_isi_19e2294b:

    # isi "Да. Для некоторых хватает и этого."
    isi "对。对有些人来说这就够了。"

# game/a15/6cold_arriv.rpy:78
translate english cold_arriv_isi_f988a66d:

    # me "И в чем причина этого дружелюбия?"
    me "那这份友善的原因是什么？"

# game/a15/6cold_arriv.rpy:79
translate english cold_arriv_isi_e6b793d7:

    # isi "Думаю ты это и так понял."
    isi "我想你已经明白了。"

# game/a15/6cold_arriv.rpy:80
translate english cold_arriv_isi_9106c7e3:

    # me "Новая королевская гвардия."
    me "新的王室卫队。"

# game/a15/6cold_arriv.rpy:81
translate english cold_arriv_isi_f4653167:

    # isi "Теперь она имперская."
    isi "现在是帝国卫队了。"

# game/a15/6cold_arriv.rpy:82
translate english cold_arriv_isi_f9b63a91:

    # me "Мой отец одобрил?"
    me "我父亲批准了？"

# game/a15/6cold_arriv.rpy:83
translate english cold_arriv_isi_1e81d3b1:

    # isi "Да. Не больше недели назад."
    isi "对。不超过一周前。"

# game/a15/6cold_arriv.rpy:84
translate english cold_arriv_isi_8f1209fb:

    # me "И в чем причина?"
    me "原因是什么？"

# game/a15/6cold_arriv.rpy:85
translate english cold_arriv_isi_ef0b99a6:

    # isi "Не знаю. Кажется болезнь совсем отошла и он стал чувствовать себя лучше."
    isi "不知道。似乎病情彻底退了，他感觉好多了。"

# game/a15/6cold_arriv.rpy:86
translate english cold_arriv_isi_9f4b1d34:

    # me "Так всему виной прилив новых сил на старости лет."
    me "所以一切都是老年新生的精力作祟。"

# game/a15/6cold_arriv.rpy:87
translate english cold_arriv_isi_1f67284c:

    # isi "Разумеется не только. Советы от добрых лордов тоже помогли."
    isi "当然不只是。好领主们的建议也帮了忙。"

# game/a15/6cold_arriv.rpy:88
translate english cold_arriv_isi_fed0caf1:

    # me "Леонард."
    me "莱昂纳德。"

# game/a15/6cold_arriv.rpy:89
translate english cold_arriv_isi_f36fba0b:

    # isi "Верно."
    isi "没错。"

# game/a15/6cold_arriv.rpy:91
translate english cold_arriv_isi_2b25ba41:

    # isi "Но и, как ты мог услышать, лорд Пойнас."
    isi "而且，如你可能听到的，还有珀纳斯领主。"

# game/a15/6cold_arriv.rpy:93
translate english cold_arriv_isi_17b11baf:

    # isi "Но и, как ты мог услышать, лорд Лаггариус."
    isi "而且，如你可能听到的，还有拉加里乌斯领主。"

# game/a15/6cold_arriv.rpy:95
translate english cold_arriv_isi_17b11baf_1:

    # isi "Но и, как ты мог услышать, лорд Лаггариус."
    isi "而且，如你可能听到的，还有拉加里乌斯领主。"

# game/a15/6cold_arriv.rpy:96
translate english cold_arriv_isi_589e94c8:

    # me "А ему это зачем?"
    me "他为什么要这样？"

# game/a15/6cold_arriv.rpy:97
translate english cold_arriv_isi_ece361d8:

    # isi "Не знаю. Видимо мстит тебе, раз уж ты не отдал ему Долину."
    isi "不知道。看来是在向你报复，既然你没把山谷给他。"

# game/a15/6cold_arriv.rpy:98
translate english cold_arriv_isi_07852096:

    # me "Мстит? И в чем месть?"
    me "报复？报复在哪里？"

# game/a15/6cold_arriv.rpy:99
translate english cold_arriv_isi_668df0dd:

    # isi "[mename], не будь наивным, укрепление власти твоего отца и лордов - это ослабление твоей."
    isi "[mename]，别天真了。加强你父亲和领主们的权力，就是削弱你的。"

# game/a15/6cold_arriv.rpy:100
translate english cold_arriv_isi_d1410275:

    # me "Ослабление? В чем же..."
    me "削弱？怎么……"

# game/a15/6cold_arriv.rpy:101
translate english cold_arriv_isi_1a6e0407:

    # isi "Да в чем угодно. Золотой Порядок - это не только порядок, но и оковы."
    isi "什么都算。黄金秩序不仅是秩序，也是枷锁。"

# game/a15/6cold_arriv.rpy:102
translate english cold_arriv_isi_3820771a_1:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:103
translate english cold_arriv_isi_1fed46cc:

    # isi "Попробуешь действовать слишком непредсказуемо и невыгодно для лордов твоего отца и они найдут пункт закона, который ты этим нарушишь."
    isi "你若试图行事太不可预测、太不利于你父亲的领主，他们就会找到一条你因此违反的法律。"

# game/a15/6cold_arriv.rpy:104
translate english cold_arriv_isi_3820771a_2:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:105
translate english cold_arriv_isi_b3fbfd0f:

    # isi "Не поможешь с накидкой? Здесь стало прохладно."
    isi "能帮我披上披肩吗？这里变凉了。"

# game/a15/6cold_arriv.rpy:107
translate english cold_arriv_isi_de87aa8c:

    # me "Как ты?"
    me "你怎么样？"

# game/a15/6cold_arriv.rpy:108
translate english cold_arriv_isi_25c07d31:

    # isi "Тебе правда интересно, или это просто для поддержания беседы?"
    isi "你是真的关心，还是只是随口一问？"

# game/a15/6cold_arriv.rpy:109
translate english cold_arriv_isi_7e655868:

    # me "Должен же я знать, как чувствует себя мать моего наследника. И как чувствует себя мой наследник."
    me "我总该知道我继承人的母亲怎么样。还有我的继承人怎么样。"

# game/a15/6cold_arriv.rpy:110
translate english cold_arriv_isi_50ccf7c7:

    # isi "О, уверяю тебя, он чувствует себя гораздо лучше моего."
    isi "哦，我向你保证，他比我好得多。"

# game/a15/6cold_arriv.rpy:111
translate english cold_arriv_isi_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/6cold_arriv.rpy:112
translate english cold_arriv_isi_b9460a31:

    # isi "Потому что он младенец, которого круглые сутки окружают няньки."
    isi "因为他是个婴儿，整天被保姆围着。"

# game/a15/6cold_arriv.rpy:113
translate english cold_arriv_isi_ea7c8436:

    # me "Ты тоже можешь облепить себя слугами."
    me "你也可以让仆人围着你转。"

# game/a15/6cold_arriv.rpy:114
translate english cold_arriv_isi_8ebd8846:

    # isi "Мне они не помогут. Мои потребности уже давно вышли за рамки голода и желания спать."
    isi "他们帮不了我。我的需求早已超出饥饿和想睡觉。"

# game/a15/6cold_arriv.rpy:115
translate english cold_arriv_isi_73a2bf43:

    # me "Понимаю."
    me "我明白。"

# game/a15/6cold_arriv.rpy:116
translate english cold_arriv_isi_80888119:

    # isi "И еще эта проклятая головная боль."
    isi "还有这该死的头痛。"

# game/a15/6cold_arriv.rpy:117
translate english cold_arriv_isi_2db90ff9:

    # me "Она все еще преследует тебя?"
    me "它还在缠着你？"

# game/a15/6cold_arriv.rpy:118
translate english cold_arriv_isi_66c22ab2:

    # isi "Уже меньше. Но все равно иногда приходится заглушать ее вином."
    isi "已经好一些。但有时还是得用酒压下去。"

# game/a15/6cold_arriv.rpy:119
translate english cold_arriv_isi_d9e8f356:

    # me "Что говорят доктора?"
    me "医生怎么说？"

# game/a15/6cold_arriv.rpy:120
translate english cold_arriv_isi_e0db898d:

    # isi "Заглушать боль маковым эфиром."
    isi "用罂粟醚止痛。"

# game/a15/6cold_arriv.rpy:121
translate english cold_arriv_isi_f95c9fc9:

    # me "И?"
    me "然后？"

# game/a15/6cold_arriv.rpy:122
translate english cold_arriv_isi_658c3ee4:

    # isi "От него разжижается мозг. Лучше моя голова будет болеть, чем я буду пускать слюни от радости созерцания красивых бабочек в саду."
    isi "它会让脑子化掉。我宁愿头痛，也不要坐在花园里流着口水看漂亮蝴蝶傻乐。"

# game/a15/6cold_arriv.rpy:123
translate english cold_arriv_isi_a26bfc72:

    # me "Не такая уж и плохая судьба."
    me "也不算太糟的命运。"

# game/a15/6cold_arriv.rpy:124
translate english cold_arriv_isi_ec50574a:

    # isi "Для меня? Может быть. Но думаю пару лет еще надо протянуть в добром расположении ума. Проследить чтобы ты не угробил наследие для нашего сына."
    isi "对我来说？也许吧。但我想还得在头脑清醒的状态下再撑几年。看着你别把咱们儿子的遗产毁了。"

# game/a15/6cold_arriv.rpy:126
translate english cold_arriv_isi_d11d579a:

    # isi "Кстати об этом..."
    isi "说到这个……"

# game/a15/6cold_arriv.rpy:127
translate english cold_arriv_isi_e79d0fd5:

    # me "Да?"
    me "嗯？"

# game/a15/6cold_arriv.rpy:128
translate english cold_arriv_isi_f6b66a7f:

    # isi "Не заставляй меня спрашивать."
    isi "别让我开口问。"

# game/a15/6cold_arriv.rpy:129
translate english cold_arriv_isi_bd542ccb:

    # me "Север."
    me "北方。"

# game/a15/6cold_arriv.rpy:130
translate english cold_arriv_isi_caff28e0:

    # isi "Да. Как там твоя дипломатическая поездка? Судя по тому, сколько тебя не было - дипломатия была... интенсивной."
    isi "对。你的外交之行怎么样？看你去了这么久——外交相当……激烈。"

# game/a15/6cold_arriv.rpy:131
translate english cold_arriv_isi_37830e24:

    # me "Что-то вроде того."
    me "差不多吧。"

# game/a15/6cold_arriv.rpy:132
translate english cold_arriv_isi_d5ed4565:

    # isi "И чем все кончилось?"
    isi "结果如何？"

# game/a15/6cold_arriv.rpy:135
translate english cold_arriv_isi_8f89e579:

    # me "Ничем. Корона осталась на голове у лорда Дубовицкого."
    me "没什么。王冠还留在杜博维茨基领主头上。"

# game/a15/6cold_arriv.rpy:136
translate english cold_arriv_isi_18007198:

    # isi "А ты пытался ее снять?"
    isi "那你试过把它摘下来吗？"

# game/a15/6cold_arriv.rpy:137
translate english cold_arriv_isi_d970972c:

    # me "Пытался. Но она плотно приросла. А единственным условием ее снятия было... было дать ему в руки меч."
    me "试过。但它长得太牢。而摘下它的唯一条件……是把剑交到他手里。"

# game/a15/6cold_arriv.rpy:138
translate english cold_arriv_isi_ef64393d:

    # isi "Что ты имеешь в виду?"
    isi "你什么意思？"

# game/a15/6cold_arriv.rpy:139
translate english cold_arriv_isi_85deddb1:

    # me "Он предложил сделку. Сделать его королем. Несменяемым. Гарантировать ему место."
    me "他提出交易。让他当国王。不可撤换。保证他的位置。"

# game/a15/6cold_arriv.rpy:140
translate english cold_arriv_isi_49a61b3c:

    # isi "И ты отказался?"
    isi "你拒绝了？"

# game/a15/6cold_arriv.rpy:141
translate english cold_arriv_isi_abbd046c:

    # me "Отказался. Я просто укреплю его власть на Севере, а взамен получу формальную лояльность. Ничего не помешает ему в любой момент снова объявить независимость."
    me "拒绝了。我只会加强他在北方的权力，换来的只是形式上的忠诚。他随时都能再次宣布独立。"

# game/a15/6cold_arriv.rpy:142
translate english cold_arriv_isi_a2c5339c:

    # isi "Понятно..."
    isi "明白了……"

# game/a15/6cold_arriv.rpy:143
translate english cold_arriv_isi_3785b39a:

    # me "Ты считаешь, что я должен был поступить иначе?"
    me "你觉得我该另作选择？"

# game/a15/6cold_arriv.rpy:144
translate english cold_arriv_isi_d545a98d:

    # isi "Я ничего не считаю. Меня там не было. Я не знаю всех обстоятельств. Но если ты говоришь правду - твое решение звучит разумным."
    isi "我什么都不觉得。我不在场。我不知道所有情况。但如果你说的是真的——你的决定听起来合理。"

# game/a15/6cold_arriv.rpy:145
translate english cold_arriv_isi_489a247d_1:

    # me "Правда?"
    me "是吗？"

# game/a15/6cold_arriv.rpy:146
translate english cold_arriv_isi_b0c233ee:

    # isi "Правда. Реальная власть заключена не в короне."
    isi "真的。真正的权力不在王冠里。"

# game/a15/6cold_arriv.rpy:147
translate english cold_arriv_isi_c160faef:

    # me "Я думаю так же."
    me "我也这么想。"

# game/a15/6cold_arriv.rpy:148
translate english cold_arriv_isi_dd97c9bb:

    # isi "Но ты ведь нашел... за что зацепиться?"
    isi "但你找到了……可以抓住的东西吧？"

# game/a15/6cold_arriv.rpy:149
translate english cold_arriv_isi_2687798d:

    # me "Разумеется. Я говорил со всеми лордами Севера, и знаю, что власть Дубовицкого не столь монолитна, как кажется."
    me "当然。我和所有北方领主都谈过，我知道杜博维茨基的权力并不像看起来那么铁板一块。"

# game/a15/6cold_arriv.rpy:150
translate english cold_arriv_isi_9f40ac91:

    # isi "Хорошо. Расскажешь мне об этом позже."
    isi "好。这事以后再说。"

# game/a15/6cold_arriv.rpy:154
translate english cold_arriv_isi_11d2fd4b:

    # me "Корона Севера моя."
    me "北方王冠是我的。"

# game/a15/6cold_arriv.rpy:155
translate english cold_arriv_isi_b7e03bcb:

    # isi "Ох... только корона?"
    isi "哦……只有王冠？"

# game/a15/6cold_arriv.rpy:156
translate english cold_arriv_isi_d876f4f1:

    # me "Тебя не радует то, что я добыл нам целое королевство?"
    me "我为我们赢得了一整个王国，这不能让你高兴？"

# game/a15/6cold_arriv.rpy:157
translate english cold_arriv_isi_4ef44457:

    # isi "Я просто пытаюсь понять, привез ли ты с собой что-то кроме титула и золотой безделушки на голову."
    isi "我只是想弄清，除了头衔和头上那件金饰，你有没有带回别的东西。"

# game/a15/6cold_arriv.rpy:158
translate english cold_arriv_isi_19a2b703:

    # me "Ну конечно. Я привез договор."
    me "当然有。我带回了条约。"

# game/a15/6cold_arriv.rpy:159
translate english cold_arriv_isi_43700a13:

    # isi "Договор? С Дубовицким?"
    isi "条约？和杜博维茨基？"

# game/a15/6cold_arriv.rpy:160
translate english cold_arriv_isi_9146b2ff:

    # me "Да. Он останется королем. А Север станет частью Империи."
    me "对。他仍是国王。而北方将成为帝国的一部分。"

# game/a15/6cold_arriv.rpy:161
translate english cold_arriv_isi_d7d73c4b:

    # isi "И все?"
    isi "就这些？"

# game/a15/6cold_arriv.rpy:162
translate english cold_arriv_isi_e13ec7a3:

    # me "Нет. Он попросил... вечного правления. Он будет королем там до самой смерти."
    me "不。他要求……永久统治。他会在那里当国王直到死。"

# game/a15/6cold_arriv.rpy:163
translate english cold_arriv_isi_aaf3d6f6:

    # isi "Звучит не очень хорошо..."
    isi "听起来不太好……"

# game/a15/6cold_arriv.rpy:164
translate english cold_arriv_isi_c254b2e4:

    # me "Я выиграл в голосовании на вече. Пришлось схитрить, но это оправдалось - прямо при Дубовицком его лорды отдавали голос за голосом. Я набрал большинство."
    me "我在市民大会的投票中赢了。不得不耍了点手段，但奏效了——就在杜博维茨基面前，他的领主一个接一个投票。我拿到了多数。"

# game/a15/6cold_arriv.rpy:165
translate english cold_arriv_isi_12c2150d:

    # isi "Так у его лордов возникло единство..."
    isi "所以他的领主们产生了团结……"

# game/a15/6cold_arriv.rpy:166
translate english cold_arriv_isi_c4d2d77d:

    # me "Да. Но у него все равно слишком много рычагов влияния. Он так давно на этом месте, что мог бы низложить это решение, даже идя против воли своих вассалов."
    me "对。但他仍有太多施压手段。他在这个位置上太久，甚至能违背自己附庸的意愿推翻这个决定。"

# game/a15/6cold_arriv.rpy:167
translate english cold_arriv_isi_86f860f3:

    # isi "Так..."
    isi "所以……"

# game/a15/6cold_arriv.rpy:168
translate english cold_arriv_isi_374f55ae:

    # me "Это что-то вроде взаимных уступок. Он принимает власть Империи, а делаю его своей правой рукой на Севере. Уверен, что если бы я не схитрил и не объединил против него лордов, условия были бы жестче."
    me "这算是互相让步。他接受帝国的权力，而我让他做我在北方的右手。我确信如果我没耍手段、没把领主们联合起来反对他，条件会更苛刻。"

# game/a15/6cold_arriv.rpy:169
translate english cold_arriv_isi_e88a97ca:

    # isi "Ну... звучит не так плохо. Хотя я и уверена, что все, чем он будет занят, это попытка установить контроль над нелояльными лордами. Раз уж ты для него их раскрыл."
    isi "嗯……听起来不算太糟。不过我确信他忙着做的，就是设法控制那些不忠的领主。既然你替他暴露了他们。"

# game/a15/6cold_arriv.rpy:170
translate english cold_arriv_isi_d37dc257:

    # me "Эти лорды теперь знают друг о друге. Тем более Ауксилат никто не отменял. Если понадобится - я встану на защиту лояльного Севера от тирана."
    me "那些领主现在彼此知道了。而且没人废除援助权。如果需要——我会保护忠诚的北方不受暴君侵害。"

# game/a15/6cold_arriv.rpy:171
translate english cold_arriv_isi_c745b7cb:

    # isi "...хорошо. Хорошо. С этим можно работать."
    isi "……好。好。这可以操作。"

# game/a15/6cold_arriv.rpy:175
translate english cold_arriv_isi_11d2fd4b_1:

    # me "Корона Севера моя."
    me "北方王冠是我的。"

# game/a15/6cold_arriv.rpy:176
translate english cold_arriv_isi_b7e03bcb_1:

    # isi "Ох... только корона?"
    isi "哦……只有王冠？"

# game/a15/6cold_arriv.rpy:177
translate english cold_arriv_isi_f3a2c598:

    # me "И титул. К сожалению это не все."
    me "还有头衔。遗憾的是不止这些。"

# game/a15/6cold_arriv.rpy:178
translate english cold_arriv_isi_dfaeb356:

    # isi "К сожалению?"
    isi "遗憾？"

# game/a15/6cold_arriv.rpy:179
translate english cold_arriv_isi_f314c91b:

    # me "Да. Я привез договор."
    me "对。我带回了条约。"

# game/a15/6cold_arriv.rpy:180
translate english cold_arriv_isi_43700a13_1:

    # isi "Договор? С Дубовицким?"
    isi "条约？和杜博维茨基？"

# game/a15/6cold_arriv.rpy:181
translate english cold_arriv_isi_9146b2ff_1:

    # me "Да. Он останется королем. А Север станет частью Империи."
    me "对。他仍是国王。而北方将成为帝国的一部分。"

# game/a15/6cold_arriv.rpy:182
translate english cold_arriv_isi_d7d73c4b_1:

    # isi "И все?"
    isi "就这些？"

# game/a15/6cold_arriv.rpy:183
translate english cold_arriv_isi_e13ec7a3_1:

    # me "Нет. Он попросил... вечного правления. Он будет королем там до самой смерти."
    me "不。他要求……永久统治。他会在那里当国王直到死。"

# game/a15/6cold_arriv.rpy:184
translate english cold_arriv_isi_aaf3d6f6_1:

    # isi "Звучит не очень хорошо..."
    isi "听起来不太好……"

# game/a15/6cold_arriv.rpy:185
translate english cold_arriv_isi_4805c3ca:

    # me "Боюсь вариантов у меня не было. Пришлось пойти на уступки."
    me "恐怕我没有选择。只能让步。"

# game/a15/6cold_arriv.rpy:186
translate english cold_arriv_isi_e9a20260:

    # isi "И сколько таких уступок? "
    isi "有多少这样的让步？"

# game/a15/6cold_arriv.rpy:187
translate english cold_arriv_isi_4c6b878d:

    # me "Достаточно, чтобы сказать, что имперская власть там будет зависеть от воли короля Севера."
    me "多到可以说，那里的帝国权力将取决于北方之王的意志。"

# game/a15/6cold_arriv.rpy:189
translate english cold_arriv_isi_9c9f3b0a:

    # isi "Хм..."
    isi "嗯……"

# game/a15/6cold_arriv.rpy:190
translate english cold_arriv_isi_37b4edf2:

    # me "Я начал."
    me "我开了个头。"

# game/a15/6cold_arriv.rpy:191
translate english cold_arriv_isi_6930a697:

    # isi "Да. Конечно. Но я бы не сказала, что положение сильно улучшилось."
    isi "对。当然。但我不会说局势有多大改善。"

# game/a15/6cold_arriv.rpy:192
translate english cold_arriv_isi_b4abbc78:

    # me "Я добыл нам Север. Пусть и номинально - это обрадует подданных."
    me "我为帝国赢得了北方。哪怕只是名义上的——也会让臣民高兴。"

# game/a15/6cold_arriv.rpy:193
translate english cold_arriv_isi_c7a59beb:

    # isi "Обрадует. Но лорды быстро поймут, что твоя Имперская власть там номинальна."
    isi "会高兴。但领主们很快会明白，你在那里的帝国权力只是名义上的。"

# game/a15/6cold_arriv.rpy:194
translate english cold_arriv_isi_c27c86bf:

    # me "И что они сделают?"
    me "那他们会怎么做？"

# game/a15/6cold_arriv.rpy:195
translate english cold_arriv_isi_cede5f3f:

    # isi "Лорды? Что угодно. Ты пустил его в большую игру, [mename]. И у тебя над ним совсем нет власти."
    isi "领主们？什么都可能。你把他放进了更大的棋局，[mename]。而你对他毫无权力。"

# game/a15/6cold_arriv.rpy:196
translate english cold_arriv_isi_d96c532b:

    # me "Большую игру?"
    me "更大的棋局？"

# game/a15/6cold_arriv.rpy:197
translate english cold_arriv_isi_b0b3875e:

    # isi "Здесь. При дворе. Ты пустил его в Империю. Кто знает? Может уже завтра он начнет договариваться с лордами твоего отца."
    isi "这里。在宫廷。你把他放进了帝国。谁知道呢？也许明天他就开始和你父亲的领主们做交易。"

# game/a15/6cold_arriv.rpy:198
translate english cold_arriv_isi_ad764fba:

    # me "О чем договариваться?"
    me "交易什么？"

# game/a15/6cold_arriv.rpy:199
translate english cold_arriv_isi_58a99188:

    # isi "О чем угодно. Раньше это было невозможно. Но сейчас... Он однажды стал причиной падения твоей семьи и всей Империи. Его нельзя недооценивать."
    isi "什么都行。以前这不可能。但现在……他曾是你家族和整个帝国覆灭的原因。不能低估他。"

# game/a15/6cold_arriv.rpy:200
translate english cold_arriv_isi_21ec00bb:

    # me "Ты считаешь, что я ошибся?"
    me "你觉得我错了吗？"

# game/a15/6cold_arriv.rpy:201
translate english cold_arriv_isi_fde3384a:

    # isi "Нет. Но ты сильно изменил правила игры... и к ним придется перестраиваться."
    isi "不。但你大大改变了游戏规则……大家得重新适应。"

# game/a15/6cold_arriv.rpy:202
translate english cold_arriv_isi_3820771a_3:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:203
translate english cold_arriv_isi_38d46fda:

    # isi "Ладно. Обсудим это позже. Думаю, ты сильно устал с дороги."
    isi "好了。以后再谈。我想你一路很累了。"

# game/a15/6cold_arriv.rpy:206
translate english cold_arriv_isi_7fbf8cbf:

    # isi "Ммм."
    isi "嗯嗯。"

# game/a15/6cold_arriv.rpy:207
translate english cold_arriv_isi_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a15/6cold_arriv.rpy:208
translate english cold_arriv_isi_fbe342fd:

    # isi "Мгм."
    isi "嗯。"

# game/a15/6cold_arriv.rpy:209
translate english cold_arriv_isi_1b759b30:

    # me "Что за... нежность?"
    me "这是……什么温柔？"

# game/a15/6cold_arriv.rpy:210
translate english cold_arriv_isi_8b8bd0a2:

    # isi "Мнмм."
    isi "嗯嗯。"

# game/a15/6cold_arriv.rpy:211
translate english cold_arriv_isi_3820771a_4:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:212
translate english cold_arriv_isi_ffd3b4af_3:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:213
translate english cold_arriv_isi_a5e5cf80:

    # me "Исида..."
    me "伊西达……"

# game/a15/6cold_arriv.rpy:214
translate english cold_arriv_isi_6e5003bd:

    # isi "[mename]..."
    isi "[mename]……"

# game/a15/6cold_arriv.rpy:217
translate english cold_arriv_isi_b7476af7:

    # isi "Скучал по мне?"
    isi "想我了吗？"

# game/a15/6cold_arriv.rpy:218
translate english cold_arriv_isi_c97fadc0:

    # me "Ну..."
    me "嗯……"

# game/a15/6cold_arriv.rpy:219
translate english cold_arriv_isi_7661cd54:

    # isi "Или северные девки не давали тебе поводов для грусти по дому?"
    isi "还是北方姑娘让你没理由想家？"

# game/a15/6cold_arriv.rpy:220
translate english cold_arriv_isi_18da8649:

    # me "По-твоему у меня было время на северных девок?"
    me "你觉得我有时间找北方姑娘？"

# game/a15/6cold_arriv.rpy:221
translate english cold_arriv_isi_3b936a6a:

    # isi "Ну может и не на северных. Одну ты взял с собой."
    isi "也许不是北方的。你带回来一个。"

# game/a15/6cold_arriv.rpy:222
translate english cold_arriv_isi_67c5f2d1:

    # me "Чего?"
    me "什么？"

# game/a15/6cold_arriv.rpy:223
translate english cold_arriv_isi_9a94cc7b:

    # isi "Рамона. Кстати как там с союзом?"
    isi "拉莫娜。顺便问一句，联姻怎么样？"

# game/a15/6cold_arriv.rpy:225
translate english cold_arriv_isi_5c2b0867:

    # me "Выдал ее за сына лорда Украдского."
    me "我把她嫁给了乌克拉德斯基领主之子。"

# game/a15/6cold_arriv.rpy:227
translate english cold_arriv_isi_cff1106c:

    # me "Выдал ее за сына лорда Сапеги."
    me "我把她嫁给了萨佩加领主之子。"

# game/a15/6cold_arriv.rpy:228
translate english cold_arriv_isi_3fc77d18:

    # isi "И как? Жених не будет неприятно удивлен?"
    isi "怎么样？新郎不会感到不快吧？"

# game/a15/6cold_arriv.rpy:229
translate english cold_arriv_isi_d355dc3b:

    # me "О чем ты?"
    me "你说什么？"

# game/a15/6cold_arriv.rpy:230
translate english cold_arriv_isi_708f54b5:

    # isi "Ты понимаешь о чем я."
    isi "你知道我什么意思。"

# game/a15/6cold_arriv.rpy:231
translate english cold_arriv_isi_14c83344:

    # me "Рамона выглядит так, будто у нее первая кровь была на прошлой неделе."
    me "拉莫娜看起来像是上周才来初潮。"

# game/a15/6cold_arriv.rpy:232
translate english cold_arriv_isi_f957e6c9:

    # isi "О, если бы мужчин это останавливало, мы бы жили в гораздо более цивилизованном мире."
    isi "哦，如果这能拦住男人，我们早活在一个文明得多的世界里了。"

# game/a15/6cold_arriv.rpy:233
translate english cold_arriv_isi_46d4fbba:

    # me "Нет. Я с ней не спал."
    me "不。我没和她上床。"

# game/a15/6cold_arriv.rpy:234
translate english cold_arriv_isi_711560b5:

    # isi "Поразительная сдержанность. Так, а что насчет северянок?"
    isi "惊人的克制。那么，北方女人呢？"

# game/a15/6cold_arriv.rpy:235
translate english cold_arriv_isi_bd2ee9eb:

    # me "А может лучше поговорим о южанках?"
    me "不如谈谈南方女人？"

# game/a15/6cold_arriv.rpy:236
translate english cold_arriv_isi_f4a457b2:

    # isi "...хмм.. а ты хочешь?"
    isi "……嗯……你想吗？"

# game/a15/6cold_arriv.rpy:241
translate english cold_arriv_isi_1ca57355:

    # isi "А ты хочешь только поговорить или..."
    isi "你只是想谈谈，还是……"

# game/a15/6cold_arriv.rpy:242
translate english cold_arriv_isi_3fd05c5b:

    # me "Не только."
    me "不只是谈。"

# game/a15/6cold_arriv.rpy:243
translate english cold_arriv_isi_0338fbb6:

    # isi "А что же еще?"
    isi "那还有什么？"

# game/a15/6cold_arriv.rpy:245
translate english cold_arriv_isi_fc7d3a18:

    # "Пару минут спустя."
    "几分钟后。"

# game/a15/6cold_arriv.rpy:246
translate english cold_arriv_isi_6d182f68:

    # isi "...ах... ну и как?"
    isi "……啊……怎么样？"

# game/a15/6cold_arriv.rpy:247
translate english cold_arriv_isi_dfcceeac_1:

    # me "М?"
    me "嗯？"

# game/a15/6cold_arriv.rpy:248
translate english cold_arriv_isi_5811e50e:

    # isi "Северные девки поуже?"
    isi "北方姑娘更紧吗？"

# game/a15/6cold_arriv.rpy:249
translate english cold_arriv_isi_7759b3e7:

    # me "Прекрати."
    me "别说了。"

# game/a15/6cold_arriv.rpy:250
translate english cold_arriv_isi_2b0b37e0:

    # isi "Да ладно, я хочу честное мнение."
    isi "别这样，我想听实话。"

# game/a15/6cold_arriv.rpy:251
translate english cold_arriv_isi_01b2b510:

    # me "Мнение о чем?"
    me "关于什么的实话？"

# game/a15/6cold_arriv.rpy:253
translate english cold_arriv_isi_e3fa115c:

    # isi "Я... ах... сильно изменилась там? Внизу?"
    isi "我……啊……下面……变化很大吗？"

# game/a15/6cold_arriv.rpy:254
translate english cold_arriv_isi_b6626098:

    # me "А?"
    me "啊？"

# game/a15/6cold_arriv.rpy:255
translate english cold_arriv_isi_892ac9ff:

    # isi "Моя мать говорила, что каждые роды накладывают изменения на женское тело."
    isi "我母亲说，每一次生产都会在女人身上留下变化。"

# game/a15/6cold_arriv.rpy:256
translate english cold_arriv_isi_2325fa76:

    # me "И что?"
    me "那又怎样？"

# game/a15/6cold_arriv.rpy:257
translate english cold_arriv_isi_9f295cf8:

    # isi "В том числе и те изменения, что мешают мужскому удовольствию."
    isi "包括那些妨碍男人快感的变化。"

# game/a15/6cold_arriv.rpy:258
translate english cold_arriv_isi_95844858:

    # me "Уверяю тебя, мне приятно так же, как и в день нашей свадьбы."
    me "我向你保证，感觉和我们婚礼那天一样好。"

# game/a15/6cold_arriv.rpy:259
translate english cold_arriv_isi_45fe9aa3:

    # isi "Какая неприкрытая грубая лесть."
    isi "多么赤裸裸的粗俗奉承。"

# game/a15/6cold_arriv.rpy:260
translate english cold_arriv_isi_af062695:

    # me "Думай как хочешь, но я бы не оказался тут на тебе, если бы этого не хотел."
    me "随你怎么想，但如果我不想，我就不会在你身上了。"

# game/a15/6cold_arriv.rpy:261
translate english cold_arriv_isi_e87b59fa:

    # isi "Ты просто исполняешь супружеский долг. Но если не хочешь - то ты ведь помнишь, о чем я с тобой говорила? Я вовсе не против, если ты..."
    isi "你只是在履行夫妻义务。但如果你不想——你记得我跟你说过的话吧？我完全不介意你……"

# game/a15/6cold_arriv.rpy:262
translate english cold_arriv_isi_4c9448ae:

    # me "Это... это какая-то твоя проверка? Игра?"
    me "这是……你的试探？游戏？"

# game/a15/6cold_arriv.rpy:263
translate english cold_arriv_isi_38d144a0:

    # isi "Никаких игр. Наша обязанность, как супругов, рожать наследников и..."
    isi "没有游戏。我们作为夫妻的义务，是生继承人，还有……"

# game/a15/6cold_arriv.rpy:264
translate english cold_arriv_isi_72d1040e:

    # me "Это мое искреннее желание. Не обязанность."
    me "这是我真诚的愿望。不是义务。"

# game/a15/6cold_arriv.rpy:265
translate english cold_arriv_isi_ffd3b4af_4:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:266
translate english cold_arriv_isi_aa743e6e:

    # me "Я просто наслаждаюсь воссоединением со своей женой."
    me "我只是在享受与妻子的重逢。"

# game/a15/6cold_arriv.rpy:267
translate english cold_arriv_isi_dd73c00d:

    # isi "Ну... приятно это слышать... "
    isi "嗯……很高兴听到这个……"

# game/a15/6cold_arriv.rpy:268
translate english cold_arriv_isi_1f7398d4:

    # me "А чувствовать?"
    me "那感觉到呢？"

# game/a15/6cold_arriv.rpy:269
translate english cold_arriv_isi_ffd3b4af_5:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:270
translate english cold_arriv_isi_f6f856d5:

    # me "Не стоит делать наши отношения слишком формальными. Иногда можно и просто... любить друг друга."
    me "不必把我们的关系弄得太正式。有时也可以只是……彼此相爱。"

# game/a15/6cold_arriv.rpy:271
translate english cold_arriv_isi_168b98b7:

    # isi "Как хочешь. Но только здесь. Наедине друг с другом."
    isi "随你。但只能在这里。只有我们两个人时。"

# game/a15/6cold_arriv.rpy:272
translate english cold_arriv_isi_c4dfb201:

    # me "Почему же?"
    me "为什么？"

# game/a15/6cold_arriv.rpy:273
translate english cold_arriv_isi_85292bca:

    # isi "Потому что чувства - это болевая точка, и не стоит никому показывать свои слабости."
    isi "因为感情是软肋，不该向任何人展示自己的弱点。"

# game/a15/6cold_arriv.rpy:274
translate english cold_arriv_isi_46132d11:

    # me "Ты испытываешь ко мне нежные чувства, Исида? Любишь меня?"
    me "你对我有温柔的感情吗，伊西达？你爱我吗？"

# game/a15/6cold_arriv.rpy:275
translate english cold_arriv_isi_ffd3b4af_6:

    # isi "..."
    isi "……"

# game/a15/6cold_arriv.rpy:276
translate english cold_arriv_isi_9362729a:

    # me "Скажи это."
    me "说出来。"

# game/a15/6cold_arriv.rpy:277
translate english cold_arriv_isi_28af75c5:

    # isi "Не стану."
    isi "不。"

# game/a15/6cold_arriv.rpy:278
translate english cold_arriv_isi_3642f725:

    # me "Почему это?"
    me "为什么？"

# game/a15/6cold_arriv.rpy:279
translate english cold_arriv_isi_0d138307:

    # isi "Потому что ты сейчас кончишь, и тебя перестанет это так беспокоить."
    isi "因为你马上要射了，然后这就不会再让你这么在意了。"

# game/a15/6cold_arriv.rpy:281
translate english cold_arriv_isi_b5617c5e:

    # me "Ох..."
    me "哦……"

# game/a15/6cold_arriv.rpy:282
translate english cold_arriv_isi_571c34f3:

    # isi "Хороший мальчик."
    isi "好孩子。"

# game/a15/6cold_arriv.rpy:283
translate english cold_arriv_isi_c76e1e6d:

    # me "Как ты... как ты поняла?"
    me "你怎么……你怎么知道的？"

# game/a15/6cold_arriv.rpy:284
translate english cold_arriv_isi_45be352b:

    # isi "Боюсь я не смогу объяснить."
    isi "恐怕我解释不了。"

# game/a15/6cold_arriv.rpy:285
translate english cold_arriv_isi_3820771a_5:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:286
translate english cold_arriv_isi_f531454e:

    # isi "В силу наших физиологических отличий."
    isi "因为我们生理上的差异。"

# game/a15/6cold_arriv.rpy:288
translate english cold_arriv_isi_3820771a_6:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:289
translate english cold_arriv_isi_28301a9f:

    # isi "Устал?"
    isi "累了？"

# game/a15/6cold_arriv.rpy:290
translate english cold_arriv_isi_f12f5c61:

    # me "Мгм... но я могу постараться еще раз..."
    me "嗯……但我还能再来一次……"

# game/a15/6cold_arriv.rpy:291
translate english cold_arriv_isi_1f7fafa0:

    # isi "Не стоит. Мне не нужно ничего доказывать."
    isi "不必。我不需要证明什么。"

# game/a15/6cold_arriv.rpy:292
translate english cold_arriv_isi_72c6f7e3:

    # me "Я не..."
    me "我不是……"

# game/a15/6cold_arriv.rpy:293
translate english cold_arriv_isi_caaca130:

    # isi "Расслабься. Ты устал после долгой дороги."
    isi "放松。你长途跋涉累了。"

# game/a15/6cold_arriv.rpy:294
translate english cold_arriv_isi_3820771a_7:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:295
translate english cold_arriv_isi_4d6a1eb1:

    # isi "Тебе нужно отдохнуть."
    isi "你需要休息。"

# game/a15/6cold_arriv.rpy:296
translate english cold_arriv_isi_423043a6:

    # me "Да..."
    me "对……"

# game/a15/6cold_arriv.rpy:297
translate english cold_arriv_isi_2224c2bf:

    # me "А как же [sonname]? Я его не проведал."
    me "那[sonname]呢？我还没去看他。"

# game/a15/6cold_arriv.rpy:298
translate english cold_arriv_isi_54917a63:

    # isi "С ним все в порядке. Как раз хотела его навестить."
    isi "他没事。我正想去看他。"

# game/a15/6cold_arriv.rpy:299
translate english cold_arriv_isi_66670793:

    # me "Принесешь его?"
    me "把他带来？"

# game/a15/6cold_arriv.rpy:300
translate english cold_arriv_isi_3ab90ea9:

    # isi "Если ты не уснешь к тому моменту."
    isi "如果你到那时还没睡着。"

# game/a15/6cold_arriv.rpy:301
translate english cold_arriv_isi_7820b551:

    # me "Я не... не усну."
    me "我不会……不会睡。"

# game/a15/6cold_arriv.rpy:302
translate english cold_arriv_isi_a7567aa8:

    # isi "Ладно."
    isi "好吧。"

# game/a15/6cold_arriv.rpy:303
translate english cold_arriv_isi_3820771a_8:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:304
translate english cold_arriv_isi_12c3e524:

    # isi "[mename], была бы благодарна, если бы ты с меня слез."
    isi "[mename]，如果你从我身上下去，我会很感激。"

# game/a15/6cold_arriv.rpy:306
translate english cold_arriv_isi_6e8114b7:

    # me "Прости. Похоже это напряжение - единственное, что удерживало меня от осознания того, как я устал за эти недели дороги."
    me "抱歉。看来正是这股紧绷感，让我没意识到这几周赶路有多累。"

# game/a15/6cold_arriv.rpy:307
translate english cold_arriv_isi_cf381426:

    # isi "Хм... мужчины."
    isi "嗯……男人。"

# game/a15/6cold_arriv.rpy:308
translate english cold_arriv_isi_cda9dd78:

    # me "Ты не скучаешь по своей семье, по своему дому, по Югу?"
    me "你不想念你的家人、你的家、南方吗？"

# game/a15/6cold_arriv.rpy:309
translate english cold_arriv_isi_7c6ffb38:

    # isi "Эм... ты уверен, что хотел задать именно этот вопрос? По-моему ты уже засыпаешь."
    isi "呃……你确定想问的是这个吗？我觉得你已经快睡着了。"

# game/a15/6cold_arriv.rpy:310
translate english cold_arriv_isi_3820771a_9:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:311
translate english cold_arriv_isi_4452a0de:

    # isi "Немного. Немного скучаю. Но тоска по дому и семье, это тоска по воспоминаниям, что вас связывали."
    isi "有一点。有一点想。但对家和家人的思念，是对把你们联系在一起的回忆的思念。"

# game/a15/6cold_arriv.rpy:312
translate english cold_arriv_isi_6947d4d4:

    # isi "А тот, кто слишком много думает о прошлом, не будет иметь будущего."
    isi "而太沉溺于过去的人，就不会有未来。"

# game/a15/6cold_arriv.rpy:313
translate english cold_arriv_isi_3820771a_10:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:314
translate english cold_arriv_isi_08d3bbff:

    # isi "Хотя... иногда мне приятно вспомнить вечера за игрой в yarad'bar с отцом или как я гонялась с палкой за старшими братьями, пока они смеялись, специально подставляясь под удары."
    isi "不过……有时我喜欢回忆和父亲玩 yarad'bar 的夜晚，或者我拿着棍子追哥哥们，他们笑着故意挨打。"

# game/a15/6cold_arriv.rpy:315
translate english cold_arriv_isi_3820771a_11:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:316
translate english cold_arriv_isi_7f6c00df:

    # isi "Или как мать водила меня в гарем отца."
    isi "或者母亲带我去父亲的后宫。"

# game/a15/6cold_arriv.rpy:317
translate english cold_arriv_isi_3820771a_12:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:318
translate english cold_arriv_isi_f389fc0e:

    # isi "Она пила вино вместе с остальными женщинами, обсуждая город, бога и мужчин. Ну и конечно главного мужчину их жизни."
    isi "她和其他女人一起喝酒，谈论城市、神和男人。当然，还有她们生命中最重要的那个男人。"

# game/a15/6cold_arriv.rpy:319
translate english cold_arriv_isi_3820771a_13:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:320
translate english cold_arriv_isi_3d3380fa:

    # isi "Знаешь. Я видела, как почтительна и уважительна моя мать с отцом. Но за столом я ловила в ее глазах солнечные зайчики тех разговоров в гареме."
    isi "你知道。我看到母亲对父亲多么恭敬尊重。但在餐桌上，我在她眼里捕捉到后宫谈话留下的光斑。"

# game/a15/6cold_arriv.rpy:321
translate english cold_arriv_isi_3820771a_14:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:322
translate english cold_arriv_isi_f9cf2452:

    # isi "Наверное это была проверка. Потому что я ничего не говорила отцу и уже через пару раз женщины налили вино и мне."
    isi "大概那是一次试探。因为我什么都没告诉父亲，几次之后，女人们也给我倒了酒。"

# game/a15/6cold_arriv.rpy:323
translate english cold_arriv_isi_3820771a_15:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:324
translate english cold_arriv_isi_689cb0e1:

    # isi "Я смеялась вместе с ними. Обсуждала отца. А на следующем семейном застолье мне стало так невыносимо стыдно и страшно..."
    isi "我和她们一起笑。谈论父亲。而下一次家庭聚餐时，我感到难以忍受的羞耻和恐惧……"

# game/a15/6cold_arriv.rpy:325
translate english cold_arriv_isi_3820771a_16:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:326
translate english cold_arriv_isi_1bfdb233:

    # isi "Я будто была сообщником в заговоре. Я не выдержала и вечером того же дня все рассказала ему. Старалась вспомнить каждую деталь сквозь слезы, стоя на коленях."
    isi "我仿佛成了阴谋的同谋。我受不了，当晚就把一切都告诉了他。我跪着，流着泪，努力回忆每一个细节。"

# game/a15/6cold_arriv.rpy:327
translate english cold_arriv_isi_3820771a_17:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:328
translate english cold_arriv_isi_4631c789:

    # isi "А отец просто улыбнулся и сказал, что знает. Что женщинам нужно место, где они могут отвести душу. Сказал, что не злится на меня, мать и наложниц."
    isi "而父亲只是笑了笑，说他知道。女人需要一个能倾诉心声的地方。他说他不生我、母亲和嫔妃们的气。"

# game/a15/6cold_arriv.rpy:329
translate english cold_arriv_isi_3820771a_18:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:330
translate english cold_arriv_isi_d78d893e:

    # isi "И мне уже стало стыдно перед моей матерью. Я пришла к ней в слезах, но она тоже просто улыбнулась. Я даже ничего ей не сказала. Она и так все поняла. Поняла, но простила меня."
    isi "然后我又在母亲面前感到羞耻。我哭着去找她，但她也只是笑了笑。我甚至什么都没说。她就已经全明白了。明白了——却原谅了我。"

# game/a15/6cold_arriv.rpy:331
translate english cold_arriv_isi_3820771a_19:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:332
translate english cold_arriv_isi_046193c4:

    # isi "Ты спишь, [mename]?"
    isi "你睡着了吗，[mename]？"

# game/a15/6cold_arriv.rpy:333
translate english cold_arriv_isi_3820771a_20:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:335
translate english cold_arriv_isi_34790f75:

    # isi "Спокойной ночи, мой золотой лев."
    isi "晚安，我的黄金之狮。"

# game/a15/6cold_arriv.rpy:336
translate english cold_arriv_isi_3820771a_21:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:337
translate english cold_arriv_isi_ea8dfa29:

    # isi "Пусть твой покой охраняет само вечное солнце."
    isi "愿永恒太阳亲自守护你的安眠。"

# game/a15/6cold_arriv.rpy:338
translate english cold_arriv_isi_3820771a_22:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:339
translate english cold_arriv_isi_65692856:

    # isi "Sulan vira'as vora zilar tella Azza'as va vora kazara Taran."
    isi "Sulan vira'as vora zilar tella Azza'as va vora kazara Taran."

# game/a15/6cold_arriv.rpy:344
translate english cold_arriv_isi_c1620009:

    # me "Да. Например хотел спросить как там моя с южанкой кровать."
    me "对。比如我想问问我和南方女人的床怎么样。"

# game/a15/6cold_arriv.rpy:345
translate english cold_arriv_isi_d7d4e3e3:

    # isi "А для чего тебя она нужна?"
    isi "你要它做什么？"

# game/a15/6cold_arriv.rpy:346
translate english cold_arriv_isi_afeda1a4:

    # me "Для сна."
    me "睡觉。"

# game/a15/6cold_arriv.rpy:347
translate english cold_arriv_isi_d7d73c4b_2:

    # isi "И все?"
    isi "就这些？"

# game/a15/6cold_arriv.rpy:348
translate english cold_arriv_isi_4b616ad9:

    # me "Пока что да. Я ужасно устал."
    me "暂时是。我累坏了。"

# game/a15/6cold_arriv.rpy:349
translate english cold_arriv_isi_c758dd1a:

    # isi "Ну ладно. Иди спи."
    isi "好吧。去睡吧。"

# game/a15/6cold_arriv.rpy:350
translate english cold_arriv_isi_a7dd185f:

    # me "Пойду."
    me "我去了。"

# game/a15/6cold_arriv.rpy:351
translate english cold_arriv_isi_623fc70f:

    # isi "Иди."
    isi "去吧。"

# game/a15/6cold_arriv.rpy:355
translate english cold_arriv_aur_b468200d:

    # aur "Спи, дитя, пока метель нам стучит в окно."
    aur "睡吧，孩子，趁暴风雪还在敲打我们的窗。"

# game/a15/6cold_arriv.rpy:356
translate english cold_arriv_aur_fede80d1:

    # aur "Спи, пока седая ель, гнется тяжело."
    aur "睡吧，趁苍老的云杉在雪下沉重弯腰。"

# game/a15/6cold_arriv.rpy:357
translate english cold_arriv_aur_c063bca3:

    # aur "Скоро снег накроет двор, реку лед скует."
    aur "很快白雪会盖住庭院，河面会结上冰，"

# game/a15/6cold_arriv.rpy:358
translate english cold_arriv_aur_16aeca77:

    # aur "Спрячет тропы зимний снег, вьюга запоет."
    aur "冬雪会藏起小径，狂风会独自歌唱。"

# game/a15/6cold_arriv.rpy:359
translate english cold_arriv_aur_e8463d10:

    # aur "Спи, дитя, не бойся тьмы, ночь не навсегда."
    aur "睡吧，孩子，别怕黑暗，黑夜终会过去。"

# game/a15/6cold_arriv.rpy:360
translate english cold_arriv_aur_7ebe43d6:

    # aur "Даже там, где нет огней, нас хранит звезда."
    aur "即使在无火无光之处，也有星辰守护我们。"

# game/a15/6cold_arriv.rpy:361
translate english cold_arriv_aur_3966e6dd:

    # aur "За горами, за снегами, где молчит земля,"
    aur "在山外，在雪外，在大地沉默之处，"

# game/a15/6cold_arriv.rpy:362
translate english cold_arriv_aur_1b1bf362:

    # aur "Безымянный Бог идет, путь тебе храня."
    aur "无名之神仍在行走，守护你的道路。"

# game/a15/6cold_arriv.rpy:363
translate english cold_arriv_aur_bb78fff8:

    # aur "Спи, дитя, придет весна, снег уйдет с земли."
    aur "睡吧，孩子，春天会来，雪会从大地退去。"

# game/a15/6cold_arriv.rpy:364
translate english cold_arriv_aur_cca74a50:

    # aur "Снова птицы прилетят, зазвенят ручьи."
    aur "鸟群会再次归来，溪流会再次叮咚。"

# game/a15/6cold_arriv.rpy:365
translate english cold_arriv_aur_298ad4f7:

    # aur "Но пока лежит мороз и метели злы,"
    aur "但只要寒霜仍在、暴风雪仍狂，"

# game/a15/6cold_arriv.rpy:366
translate english cold_arriv_aur_ed531c0c:

    # aur "К матери сильней прижмись и скорее спи."
    aur "就再抱紧母亲一些，快快睡吧。"

# game/a15/6cold_arriv.rpy:367
translate english cold_arriv_aur_9725a966:

    # me "Я думаю он спит."
    me "我想他已经睡着了。"

# game/a15/6cold_arriv.rpy:369
translate english cold_arriv_aur_1604474b:

    # aur "[mename]?"
    aur "[mename]？"

# game/a15/6cold_arriv.rpy:370
translate english cold_arriv_aur_494a8c2d:

    # me "Ты ожидала увидеть кого-то другого?"
    me "你期待见到别人吗？"

# game/a15/6cold_arriv.rpy:371
translate english cold_arriv_aur_a4792f3e:

    # aur "Нет. Мне не сообщили..."
    aur "不。没人告诉我……"

# game/a15/6cold_arriv.rpy:372
translate english cold_arriv_aur_0d83456b:

    # me "Я попросил. Хотел чтобы это было сюрпризом."
    me "我要求的。想给你个惊喜。"

# game/a15/6cold_arriv.rpy:373
translate english cold_arriv_aur_1972f27d:

    # aur "Ох..."
    aur "哦……"

# game/a15/6cold_arriv.rpy:374
translate english cold_arriv_aur_3820771a:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:375
translate english cold_arriv_aur_1a6f03a4:

    # aur "..."
    aur "……"

# game/a15/6cold_arriv.rpy:376
translate english cold_arriv_aur_f16564d3:

    # me "Ну иди сюда."
    me "过来吧。"

# game/a15/6cold_arriv.rpy:378
translate english cold_arriv_aur_c64842cd:

    # aur "Я молилась за тебя каждый день! Я так рада, что с тобой все в порядке."
    aur "我每天都为你祈祷！我太高兴你平安无事。"

# game/a15/6cold_arriv.rpy:379
translate english cold_arriv_aur_e9796163:

    # me "Да что со мной могло произойти? Разве что я бы утонул в снеге и грязи по пути."
    me "我能出什么事？最多就是路上淹死在雪和泥里。"

# game/a15/6cold_arriv.rpy:380
translate english cold_arriv_aur_3db48bf5:

    # aur "Корабли так и не починили?"
    aur "船还是没修好？"

# game/a15/6cold_arriv.rpy:381
translate english cold_arriv_aur_20dcda76:

    # me "Не успели вовремя. Порт замерз. Погоди, а откуда ты знаешь?"
    me "没来得及。港口冻住了。等等，你怎么知道？"

# game/a15/6cold_arriv.rpy:382
translate english cold_arriv_aur_475cf974:

    # aur "Отец отправил письмо. Написал, что остальные корабли подожгли сразу после моего отплытия."
    aur "父亲寄了信。他写其余的船在我启航后不久就被烧了。"

# game/a15/6cold_arriv.rpy:383
translate english cold_arriv_aur_b1a84ffc:

    # me "Да... ты что-нибудь об этом знаешь?"
    me "对……你知道这件事吗？"

# game/a15/6cold_arriv.rpy:384
translate english cold_arriv_aur_c38c7483:

    # aur "Нет. Когда мы отплывали все было в порядке."
    aur "不。我们启航时一切都好。"

# game/a15/6cold_arriv.rpy:385
translate english cold_arriv_aur_d8b77f4e:

    # me "Ладно. Как ты сама? Как [sonname]?"
    me "好吧。你怎么样？[sonname]怎么样？"

# game/a15/6cold_arriv.rpy:386
translate english cold_arriv_aur_c480db31:

    # aur "Со мной все хорошо. С ним тоже. Растет сильным мальчиком."
    aur "我很好。他也好。正在长成强壮的男孩。"

# game/a15/6cold_arriv.rpy:387
translate english cold_arriv_aur_5bd0e22b:

    # me "Может нам стоит говорить потише?"
    me "也许我们该小声点？"

# game/a15/6cold_arriv.rpy:388
translate english cold_arriv_aur_9573f916:

    # aur "Не беспокойся, он с трудом засыпает, но если уж закрыл глаза - его ничего не разбудит."
    aur "别担心。他很难入睡，但一旦闭上眼睛，什么都吵不醒他。"

# game/a15/6cold_arriv.rpy:389
translate english cold_arriv_aur_73eadfa4:

    # me "Хорошо. Я рад, что с вами все в порядке."
    me "好。我很高兴你们都平安。"

# game/a15/6cold_arriv.rpy:391
translate english cold_arriv_aur_10fbc675:

    # aur "Как твоя дорога? Не страшно было ехать через Вольные Города?"
    aur "你路上怎么样？穿过自由城市不害怕吗？"

# game/a15/6cold_arriv.rpy:392
translate english cold_arriv_aur_7dcfed03:

    # me "Я еще недавно жил в них."
    me "我不久前还住在那里。"

# game/a15/6cold_arriv.rpy:393
translate english cold_arriv_aur_ac404acf:

    # aur "Я имею в виду чуму..."
    aur "我是说瘟疫……"

# game/a15/6cold_arriv.rpy:394
translate english cold_arriv_aur_9e7cfe61:

    # me "Она пошла на убыль."
    me "它在消退。"

# game/a15/6cold_arriv.rpy:395
translate english cold_arriv_aur_caf89f13:

    # aur "Правда?"
    aur "真的？"

# game/a15/6cold_arriv.rpy:396
translate english cold_arriv_aur_0e638ed9:

    # me "Да. Но мы все равно были осторожны. Не покупали там припасы и объезжали города."
    me "对。但我们还是很小心。没在那里买补给，也绕开了城市。"

# game/a15/6cold_arriv.rpy:397
translate english cold_arriv_aur_e1d43d5e:

    # aur "Хорошо. Это хорошо. С болезнями нужно быть осторожным. Дети переносят их особенно плохо."
    aur "好。这很好。对疾病必须小心。孩子尤其受不了。"

# game/a15/6cold_arriv.rpy:398
translate english cold_arriv_aur_f20c32e3:

    # me "Я был осторожен."
    me "我很小心。"

# game/a15/6cold_arriv.rpy:399
translate english cold_arriv_aur_6bde488c:

    # aur "Я так рада тебя видеть, [mename]. Мне было очень одиноко без тебя. Я и представить не могла, что так к тебе привыкну. Только наш сын помогал мне справиться с тоской."
    aur "我太高兴见到你了，[mename]。没有你我非常孤独。我没想到会这么习惯你。只有我们的儿子帮我撑过思念。"

# game/a15/6cold_arriv.rpy:400
translate english cold_arriv_aur_c5a10551:

    # me "Это такое милое признание в любви?"
    me "这算是甜蜜的告白吗？"

# game/a15/6cold_arriv.rpy:401
translate english cold_arriv_aur_ca6ddd8c:

    # aur "Да."
    aur "是。"

# game/a15/6cold_arriv.rpy:402
translate english cold_arriv_aur_3250bbfa:

    # me "Я тоже рад снова тебя видеть."
    me "我也很高兴再见到你。"

# game/a15/6cold_arriv.rpy:403
translate english cold_arriv_aur_1822c578:

    # aur "Тебе ведь больше не нужно на Север?"
    aur "你不用再去北方了吧？"

# game/a15/6cold_arriv.rpy:404
translate english cold_arriv_aur_a86a6d34:

    # me "Я только оттуда."
    me "我刚从那儿回来。"

# game/a15/6cold_arriv.rpy:405
translate english cold_arriv_aur_bd313549:

    # aur "Да. Но... вы ведь все решили с моим отцом?"
    aur "对。但……你和我父亲都解决了吗？"

# game/a15/6cold_arriv.rpy:411
translate english cold_arriv_aur_50329ac1:

    # me "Как тебе сказать..."
    me "怎么说呢……"

# game/a15/6cold_arriv.rpy:412
translate english cold_arriv_aur_bb2b5aa2:

    # aur "Скажи как есть."
    aur "照实说。"

# game/a15/6cold_arriv.rpy:413
translate english cold_arriv_aur_01822020:

    # me "Ладно."
    me "好吧。"

# game/a15/6cold_arriv.rpy:416
translate english cold_arriv_aur_ddbfabaa:

    # me "Твой отец мной манипулировал."
    me "你父亲操纵了我。"

# game/a15/6cold_arriv.rpy:417
translate english cold_arriv_aur_e202cb5b:

    # aur "Манипулировал? Как?"
    aur "操纵？怎么操纵？"

# game/a15/6cold_arriv.rpy:418
translate english cold_arriv_aur_280235b1:

    # me "Он мне солгал. О цели моей миссии, о моей роли в ней. Из-за него я даже рисковал жизнью."
    me "他骗了我。关于我任务的目的，以及我在其中的角色。因为他我甚至冒了生命危险。"

# game/a15/6cold_arriv.rpy:419
translate english cold_arriv_aur_d65456b4:

    # aur "Не может быть."
    aur "不可能。"

# game/a15/6cold_arriv.rpy:420
translate english cold_arriv_aur_7c3b060c:

    # me "Это правда. Боюсь наш союз не остановил твоего отца от... мягко говоря не самого дипломатичного обращения с мужем его дочери."
    me "这是真的。恐怕我们的联姻并没阻止你父亲……说得委婉点，以不太外交的方式对待他女儿的丈夫。"

# game/a15/6cold_arriv.rpy:421
translate english cold_arriv_aur_6eb2ae41:

    # aur "Но как же... зачем..."
    aur "可怎么……为什么……"

# game/a15/6cold_arriv.rpy:422
translate english cold_arriv_aur_e4d6a18a:

    # me "Боюсь, что я с самого начала должен был стать просто одной из шахматных фигур в большой игре Короля Севера."
    me "恐怕我从一开始就注定只是北方之王大棋局里的一枚棋子。"

# game/a15/6cold_arriv.rpy:423
translate english cold_arriv_aur_26798895:

    # aur "С самого начала?"
    aur "从一开始？"

# game/a15/6cold_arriv.rpy:424
translate english cold_arriv_aur_3c8e83b3:

    # me "С того момента, как он пригласил нас к себе. Возможно с того самого момента, как он выдал тебя за меня замуж."
    me "从他邀请我们去他那儿开始。也许从他把你嫁给我的那一刻起。"

# game/a15/6cold_arriv.rpy:425
translate english cold_arriv_aur_82d22909:

    # aur "И что? И что это за игра?"
    aur "然后呢？这是什么棋局？"

# game/a15/6cold_arriv.rpy:426
translate english cold_arriv_aur_05990ef5:

    # me "Игра во власть очевидно. Я должен был против своей воли стать инструментом проверки на лояльность лордов Севера их королю."
    me "显然是一场权力游戏。我本该违背自己的意愿，成为检验北方领主对其国王忠诚的工具。"

# game/a15/6cold_arriv.rpy:427
translate english cold_arriv_aur_1a6f03a4_1:

    # aur "..."
    aur "……"

# game/a15/6cold_arriv.rpy:428
translate english cold_arriv_aur_138a983f:

    # me "Я слишком поздно это понял. Твой отец сумел использовать меня."
    me "我明白得太晚了。你父亲成功利用了我。"

# game/a15/6cold_arriv.rpy:431
translate english cold_arriv_aur_f2f7f118:

    # aur "[mename], прости меня..."
    aur "[mename]，原谅我……"

# game/a15/6cold_arriv.rpy:432
translate english cold_arriv_aur_df64e93f:

    # me "Тебя? Ты тут при чем?"
    me "你？跟你有什么关系？"

# game/a15/6cold_arriv.rpy:433
translate english cold_arriv_aur_6723b397:

    # aur "Прости моего отца, он..."
    aur "原谅我父亲吧，他……"

# game/a15/6cold_arriv.rpy:434
translate english cold_arriv_aur_fc32f60a:

    # me "Что он? Не хотел? Это очень вряд ли."
    me "他什么？不是故意的？不太可能。"

# game/a15/6cold_arriv.rpy:435
translate english cold_arriv_aur_e534bcfd:

    # aur "Наверное он... наверное он хотел... я не знаю."
    aur "也许他……也许他想……我不知道。"

# game/a15/6cold_arriv.rpy:436
translate english cold_arriv_aur_2887a9a2:

    # me "Я знаю. Я его инструмент в узурпации власти на Севере."
    me "我知道。我是他篡夺北方权力的工具。"

# game/a15/6cold_arriv.rpy:437
translate english cold_arriv_aur_1e3b8657:

    # aur "Узурпации? Не может быть. Моего отца избирали раз за разом..."
    aur "篡夺？不可能。我父亲一次又一次被选上……"

# game/a15/6cold_arriv.rpy:438
translate english cold_arriv_aur_b69e798d:

    # me "Уверен, ты и сама знаешь, почему его выбирали постоянно королем."
    me "我相信你自己也知道，为什么他总被选为国王。"

# game/a15/6cold_arriv.rpy:439
translate english cold_arriv_aur_9be9cf04:

    # aur "Да. Знаю..."
    aur "对。我知道……"

# game/a15/6cold_arriv.rpy:440
translate english cold_arriv_aur_566f8f03:

    # me "Жаль только, что свои грязные приемы он применил и ко мне. Я надеялся, что наш брак от этого защитит."
    me "只是遗憾他也把那些肮脏手段用在了我身上。我本以为我们的婚姻能保护我免受这些。"

# game/a15/6cold_arriv.rpy:441
translate english cold_arriv_aur_79acae28:

    # aur "Прости... прости, пожалуйста..."
    aur "对不起……求你，对不起……"

# game/a15/6cold_arriv.rpy:446
translate english cold_arriv_aur_c605e4e9:

    # me "Успокойся. Это не твоя вина. Дети не несут ответ за грехи отцов."
    me "冷静。这不是你的错。孩子不必为父亲的罪负责。"

# game/a15/6cold_arriv.rpy:447
translate english cold_arriv_aur_e9ee1e67:

    # aur "Несут. Еще как несут."
    aur "要的。太要了。"

# game/a15/6cold_arriv.rpy:448
translate english cold_arriv_aur_5354fe45:

    # me "В данном случае я решаю. И я никогда не стану винить тебя и уж тем более наказывать."
    me "这件事由我决定。我永远不会责怪你，更不会惩罚你。"

# game/a15/6cold_arriv.rpy:449
translate english cold_arriv_aur_caf89f13_1:

    # aur "Правда?"
    aur "真的？"

# game/a15/6cold_arriv.rpy:450
translate english cold_arriv_aur_2fcb8566:

    # me "Даже не сомневайся. Ты - невиновна. Очень сомневаюсь, что Борис посвящал тебя в свои коварные планы."
    me "别怀疑。你是无辜的。我很怀疑鲍里斯会把他的阴谋告诉你。"

# game/a15/6cold_arriv.rpy:451
translate english cold_arriv_aur_ef230ee5:

    # aur "Нет. О, боже, конечно нет."
    aur "不。哦，天哪，当然没有。"

# game/a15/6cold_arriv.rpy:452
translate english cold_arriv_aur_17811082:

    # me "В таком случае ты такая же жертва."
    me "那你也一样是受害者。"

# game/a15/6cold_arriv.rpy:453
translate english cold_arriv_aur_52f60f93:

    # aur "Он ведь... не сделал ничего непоправимого? У вас не будет войны?"
    aur "他……没做什么不可挽回的事吧？你们不会开战吧？"

# game/a15/6cold_arriv.rpy:454
translate english cold_arriv_aur_8d6f791e:

    # me "О боже, даже не думай об этом. Конечно нет."
    me "天哪，想都别想。当然不会。"

# game/a15/6cold_arriv.rpy:455
translate english cold_arriv_aur_50a77a23:

    # aur "Я так волнуюсь..."
    aur "我好担心……"

# game/a15/6cold_arriv.rpy:456
translate english cold_arriv_aur_c11660d2:

    # me "Не стоит. Все нормально. Тебе нужно отдохнуть. И мне тоже."
    me "不必。一切都好。你需要休息。我也是。"

# game/a15/6cold_arriv.rpy:457
translate english cold_arriv_aur_73a96e75:

    # aur "Да... пожалуй."
    aur "对……也许吧。"

# game/a15/6cold_arriv.rpy:458
translate english cold_arriv_aur_e77d03ca:

    # me "Пойдем спать, Аврора."
    me "去睡吧，奥若拉。"

# game/a15/6cold_arriv.rpy:459
translate english cold_arriv_aur_c94aa853:

    # aur "Да. Пойдем."
    aur "好。走吧。"

# game/a15/6cold_arriv.rpy:464
translate english cold_arriv_aur_254801a8:

    # me "Твои извинения ничего не значат, Аврора."
    me "你的道歉毫无意义，奥若拉。"

# game/a15/6cold_arriv.rpy:465
translate english cold_arriv_aur_9deef98c:

    # aur "Я понимаю. Но я не знаю, что еще я могу сделать!?"
    aur "我明白。但我不知道还能做什么！？"

# game/a15/6cold_arriv.rpy:466
translate english cold_arriv_aur_4c283e61:

    # me "Ничего. Ты ничего не можешь сделать."
    me "什么都做不了。你什么都做不了。"

# game/a15/6cold_arriv.rpy:467
translate english cold_arriv_aur_83bb65c4:

    # aur "Мне жаль. Мне очень жаль."
    aur "对不起。我很抱歉。"

# game/a15/6cold_arriv.rpy:468
translate english cold_arriv_aur_5fbb52b1:

    # me "Верю. Но вот кому точно не жаль - это твоему отцу."
    me "我相信。但肯定不觉得抱歉的——是你父亲。"

# game/a15/6cold_arriv.rpy:469
translate english cold_arriv_aur_1a6f03a4_2:

    # aur "..."
    aur "……"

# game/a15/6cold_arriv.rpy:470
translate english cold_arriv_aur_3c638fd8:

    # me "И судя по всему, ему не жаль не только своих лордов и зятя, но и его дочь."
    me "而且看样子，他不仅不觉得对不起自己的领主和女婿，也不觉得对不起自己的女儿。"

# game/a15/6cold_arriv.rpy:471
translate english cold_arriv_aur_564255e2:

    # aur "...прости меня..."
    aur "……原谅我……"

# game/a15/6cold_arriv.rpy:472
translate english cold_arriv_aur_c5b33f38:

    # me "Мне нужно отдохнуть."
    me "我需要休息。"

# game/a15/6cold_arriv.rpy:473
translate english cold_arriv_aur_a9a03a64:

    # aur "Ты можешь остаться здесь."
    aur "你可以留在这里。"

# game/a15/6cold_arriv.rpy:474
translate english cold_arriv_aur_f3fd919a:

    # me "Мне нужно побыть одному."
    me "我需要一个人待会儿。"

# game/a15/6cold_arriv.rpy:475
translate english cold_arriv_aur_56561931:

    # aur "Понимаю... прости... прости, пожалуйста."
    aur "我明白……对不起……求你，原谅我。"

# game/a15/6cold_arriv.rpy:480
translate english cold_arriv_aur_8f9071f9:

    # me "Конечно."
    me "当然。"

# game/a15/6cold_arriv.rpy:481
translate english cold_arriv_aur_0a7d3d9e:

    # aur "Точно? С моим отцом бывает... трудно совладать."
    aur "确定？我父亲有时候……很难对付。"

# game/a15/6cold_arriv.rpy:482
translate english cold_arriv_aur_5f8acce5:

    # me "Мне это удалось."
    me "我做到了。"

# game/a15/6cold_arriv.rpy:484
translate english cold_arriv_aur_6c6efa4f:

    # aur "Ох, я так рада, ты не представляешь. Я так переживала, что мой отец учудит что-нибудь нехорошее."
    aur "哦，你不知道我有多高兴。我一直担心我父亲会搞出什么坏事。"

# game/a15/6cold_arriv.rpy:485
translate english cold_arriv_aur_9e647279:

    # me "Ну он..."
    me "嗯，他……"

# game/a15/6cold_arriv.rpy:486
translate english cold_arriv_aur_3f77b8b3:

    # aur "[mename]? Ты сказал, что все в порядке."
    aur "[mename]？你说一切都好。"

# game/a15/6cold_arriv.rpy:487
translate english cold_arriv_aur_800bffa5:

    # me "А все и в порядке. Просто твой отец... специфический человек."
    me "一切确实都好。只是你父亲……是个特别的人。"

# game/a15/6cold_arriv.rpy:488
translate english cold_arriv_aur_fb9987d2:

    # aur "Это не то слово."
    aur "这说得太轻了。"

# game/a15/6cold_arriv.rpy:489
translate english cold_arriv_aur_e36013c2:

    # me "Но мы пришли к своего рода договоренности."
    me "但我们达成了某种约定。"

# game/a15/6cold_arriv.rpy:490
translate english cold_arriv_aur_82e3b391:

    # aur "Хорошо. Это самое главное."
    aur "好。这才是最重要的。"

# game/a15/6cold_arriv.rpy:491
translate english cold_arriv_aur_3820771a_1:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:492
translate english cold_arriv_aur_dfa6de7d:

    # aur "Ты какой-то холодный."
    aur "你有点冷。"

# game/a15/6cold_arriv.rpy:493
translate english cold_arriv_aur_edda6228:

    # me "Я две недели ехал по снегам и грязи."
    me "我在雪和泥里赶了两周路。"

# game/a15/6cold_arriv.rpy:494
translate english cold_arriv_aur_5b80a0e4:

    # aur "Тебе нужно согреться. Или ты заболеешь."
    aur "你得暖和起来。不然会生病。"

# game/a15/6cold_arriv.rpy:495
translate english cold_arriv_aur_4d81c778:

    # me "Меня кое-кто греет прямо сейчас."
    me "现在有人正在给我暖身子。"

# game/a15/6cold_arriv.rpy:496
translate english cold_arriv_aur_fd51f64c:

    # aur "Нет. Так не пойдет. Садись к камину."
    aur "不行。不能这样。坐到壁炉边去。"

# game/a15/6cold_arriv.rpy:498
translate english cold_arriv_aur_fc7d3a18:

    # "Пару минут спустя."
    "几分钟后。"

# game/a15/6cold_arriv.rpy:501
translate english cold_arriv_aur_c320896e:

    # aur "Так... Север не станет частью Империи?"
    aur "那么……北方不会成为帝国的一部分？"

# game/a15/6cold_arriv.rpy:502
translate english cold_arriv_aur_972bc50c:

    # me "Нет. Не сейчас."
    me "不。现在不会。"

# game/a15/6cold_arriv.rpy:503
translate english cold_arriv_aur_1972f27d_1:

    # aur "Ох..."
    aur "哦……"

# game/a15/6cold_arriv.rpy:504
translate english cold_arriv_aur_29100f0f:

    # me "Не волнуйся, Аврора."
    me "别担心，奥若拉。"

# game/a15/6cold_arriv.rpy:505
translate english cold_arriv_aur_ef6690cd:

    # aur "Нет... я не... вы ведь не повздорили?"
    aur "不……我不是……你们没吵架吧？"

# game/a15/6cold_arriv.rpy:506
translate english cold_arriv_aur_0d52bef9:

    # me "Ну что ты. Твой отец не такой человек. Он просто сделал мне предложение и я от него отказался."
    me "怎么会。你父亲不是那种人。他只是向我提了个建议，我拒绝了。"

# game/a15/6cold_arriv.rpy:507
translate english cold_arriv_aur_1a6f03a4_3:

    # aur "..."
    aur "……"

# game/a15/6cold_arriv.rpy:508
translate english cold_arriv_aur_3fb00a90:

    # me "Это не сделало нас врагами."
    me "这没让我们变成敌人。"

# game/a15/6cold_arriv.rpy:509
translate english cold_arriv_aur_1a6f03a4_4:

    # aur "..."
    aur "……"

# game/a15/6cold_arriv.rpy:510
translate english cold_arriv_aur_5451af34:

    # me "Правда. Не стоит переживать."
    me "真的。不必担心。"

# game/a15/6cold_arriv.rpy:511
translate english cold_arriv_aur_9ea839b3:

    # aur "Точно все хорошо? Я достаточно... стойкая. Если что-то произошло..."
    aur "真的都好吗？我足够……坚强。如果出了什么事……"

# game/a15/6cold_arriv.rpy:512
translate english cold_arriv_aur_5b39059e:

    # me "Все хорошо."
    me "一切都好。"

# game/a15/6cold_arriv.rpy:513
translate english cold_arriv_aur_22f2d303:

    # aur "Не обязательно меня успокаивать."
    aur "不必安慰我。"

# game/a15/6cold_arriv.rpy:514
translate english cold_arriv_aur_34da7baa:

    # me "Я же говорю - все хорошо. Успокойся. Пожалуйста."
    me "我说了——一切都好。冷静。求你。"

# game/a15/6cold_arriv.rpy:515
translate english cold_arriv_aur_3d9ae61f:

    # aur "Ладно. Ладно... я мало понимаю в политике. Просто не хотела, чтобы мой муж и мой отец были врагами."
    aur "好吧。好吧……我不太懂政治。只是不想我丈夫和我父亲成为敌人。"

# game/a15/6cold_arriv.rpy:516
translate english cold_arriv_aur_2fc1e7e1:

    # me "Мы не враги."
    me "我们不是敌人。"

# game/a15/6cold_arriv.rpy:517
translate english cold_arriv_aur_2a8cb6e6:

    # aur "Но мы ведь еще можем... попасть на Север."
    aur "但我们还是可以……去北方吧？"

# game/a15/6cold_arriv.rpy:518
translate english cold_arriv_aur_8084c27a:

    # me "Что? Сейчас?"
    me "什么？现在？"

# game/a15/6cold_arriv.rpy:519
translate english cold_arriv_aur_0950735c:

    # aur "В будущем."
    aur "以后。"

# game/a15/6cold_arriv.rpy:520
translate english cold_arriv_aur_5c24a5c7:

    # me "Разумеется. Уверен через пару лет условия изменятся. Может твой отец сам позовет нас."
    me "当然。我相信几年后条件会变。也许你父亲会亲自邀请我们。"

# game/a15/6cold_arriv.rpy:521
translate english cold_arriv_aur_bea314ec:

    # aur "Уверена... уверена когда он увидит своего внука... он будет более... дружелюбным."
    aur "我相信……我相信等他看到自己的孙子……他会更……友善。"

# game/a15/6cold_arriv.rpy:522
translate english cold_arriv_aur_a153ce2c:

    # me "Наверняка. Расстелишь мне кровать? Я жутко устал."
    me "多半会。你能给我铺床吗？我累坏了。"

# game/a15/6cold_arriv.rpy:523
translate english cold_arriv_aur_adb5f397:

    # aur "Конечно, [mename]."
    aur "当然，[mename]。"

# game/a15/6cold_arriv.rpy:526
translate english cold_arriv_aur_69e1cccf:

    # aur "...это потрясающие новости, [mename]! Север станет частью Империи."
    aur "……这真是惊人的好消息，[mename]！北方会成为帝国的一部分。"

# game/a15/6cold_arriv.rpy:527
translate english cold_arriv_aur_0d8ee431:

    # me "Да. Наш сын станет наследником Севера. Может его дед даже подучит, как эффективно править."
    me "对。我们的儿子会成为北方的继承人。也许他祖父甚至会教他怎么有效统治。"

# game/a15/6cold_arriv.rpy:528
translate english cold_arriv_aur_978da1ee:

    # aur "Ох... как хорошо. Я знала, что отец тебе поможет."
    aur "哦……太好了。我就知道父亲会帮你。"

# game/a15/6cold_arriv.rpy:529
translate english cold_arriv_aur_f24ab67b:

    # me "Ну... он помог не просто так."
    me "嗯……他不是白帮的。"

# game/a15/6cold_arriv.rpy:530
translate english cold_arriv_aur_58c2a287:

    # aur "Он что-то попросил взамен?"
    aur "他要求了什么回报吗？"

# game/a15/6cold_arriv.rpy:531
translate english cold_arriv_aur_1ff3b529:

    # me "Да. Но я думаю его предложение разумно. Я в этом уверен. Иначе я бы не согласился на него."
    me "对。但我觉得他的提议合理。我确信。否则我不会同意。"

# game/a15/6cold_arriv.rpy:532
translate english cold_arriv_aur_13223a14:

    # aur "И что это за предложение?"
    aur "是什么提议？"

# game/a15/6cold_arriv.rpy:533
translate english cold_arriv_aur_cebec887:

    # me "Твой отец пока посторожит место короля для нашего сына."
    me "你父亲暂时替我们的儿子看着王位。"

# game/a15/6cold_arriv.rpy:534
translate english cold_arriv_aur_a1c353ce:

    # aur "Ну... он ведь и так."
    aur "嗯……他本来不就是。"

# game/a15/6cold_arriv.rpy:535
translate english cold_arriv_aur_2c40989a:

    # me "Да. Но теперь его право на корону будет защищать Империя."
    me "对。但现在帝国会保护他的王冠权利。"

# game/a15/6cold_arriv.rpy:536
translate english cold_arriv_aur_989d9e98:

    # aur "Я... немного в этом понимаю..."
    aur "我……对这些懂一点……"

# game/a15/6cold_arriv.rpy:537
translate english cold_arriv_aur_2e7e93dd:

    # me "Это взаимовыгодное сотрудничество."
    me "这是互利的合作。"

# game/a15/6cold_arriv.rpy:538
translate english cold_arriv_aur_0300ff21:

    # aur "Так... вы расстались друзьями? Ну... или хотя бы на хорошей ноте?"
    aur "那……你们是友好分别的？嗯……或者至少气氛不错？"

# game/a15/6cold_arriv.rpy:539
translate english cold_arriv_aur_cc6076cc:

    # me "Конечно. Не волнуйся."
    me "当然。别担心。"

# game/a15/6cold_arriv.rpy:540
translate english cold_arriv_aur_b2f724a3:

    # aur "Хорошо.... хорошо."
    aur "好……好。"

# game/a15/6cold_arriv.rpy:541
translate english cold_arriv_aur_3820771a_2:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:542
translate english cold_arriv_aur_854cc5b4:

    # aur "Ты наверное устал. Расстелить тебе постель?"
    aur "你大概累了。要我给你铺床吗？"

# game/a15/6cold_arriv.rpy:543
translate english cold_arriv_aur_75ae5756:

    # me "Буду благодарен, Аврора."
    me "我会很感激，奥若拉。"

# game/a15/6cold_arriv.rpy:544
translate english cold_arriv_aur_4f6d2810:

    # aur "Сейчас."
    aur "马上。"

# game/a15/6cold_arriv.rpy:550
translate english cold_arriv_elin_53e805f4:

    # elin "{i}...{/i}"
    elin "{i}……{/i}"

# game/a15/6cold_arriv.rpy:551
translate english cold_arriv_elin_f6f29042:

    # elin "{i}Это наказание? За что? За любовь?{/i}"
    elin "{i}这是惩罚吗？为什么？因为爱吗？{/i}"

# game/a15/6cold_arriv.rpy:552
translate english cold_arriv_elin_dbf54419:

    # elin "{i}Боги жестоки, если это вообще их воля.{/i}"
    elin "{i}如果这真是神的旨意，那神太残酷了。{/i}"

# game/a15/6cold_arriv.rpy:553
translate english cold_arriv_elin_37d59dc5:

    # elin "{i}А если это их воля... то зачем? Нет. Даже не хочу об этом думать.{/i}"
    elin "{i}如果这是他们的旨意……那为什么？不。我连想都不愿想。{/i}"

# game/a15/6cold_arriv.rpy:554
translate english cold_arriv_elin_e5aabdf5:

    # elin "{i}Ты заговоришь. Заплачешь. Я знаю.{/i}"
    elin "{i}你会开口的。你会哭的。我知道。{/i}"

# game/a15/6cold_arriv.rpy:555
translate english cold_arriv_elin_53e805f4_1:

    # elin "{i}...{/i}"
    elin "{i}……{/i}"

# game/a15/6cold_arriv.rpy:556
translate english cold_arriv_elin_2384edc7:

    # elin "{i}Ты... ты что-то видишь. Я уверена. Я видела слепцов. У них другой взгляд.{/i}"
    elin "{i}你……你能看到什么。我确定。我见过盲人。他们的眼神不一样。{/i}"

# game/a15/6cold_arriv.rpy:557
translate english cold_arriv_elin_53e805f4_2:

    # elin "{i}...{/i}"
    elin "{i}……{/i}"

# game/a15/6cold_arriv.rpy:558
translate english cold_arriv_elin_fad0a695:

    # elin "{i}Боги, я не заслужила этого. Моя дочь не заслужила этого.{/i}"
    elin "{i}天哪，我不该受这个。我女儿不该受这个。{/i}"

# game/a15/6cold_arriv.rpy:560
translate english cold_arriv_elin_c1b4e866:

    # me "{i}Вот и она. [elin]. Красива в свете луны.{/i}"
    me "{i}她在这儿。[elin]。月光下很美。{/i}"

# game/a15/6cold_arriv.rpy:561
translate english cold_arriv_elin_c22c45db:

    # me "{i}Она и ее дитя. И мое дитя. Наше дитя?{/i}"
    me "{i}她和她的孩子。也是我的孩子。我们的孩子？{/i}"

# game/a15/6cold_arriv.rpy:562
translate english cold_arriv_elin_7137fa5e:

    # me "{i}Что же мы наделали...{/i}"
    me "{i}我们都做了什么……{/i}"

# game/a15/6cold_arriv.rpy:563
translate english cold_arriv_elin_5b14ded0:

    # me "{i}Это... это живое доказательство нашего греха.{/i}"
    me "{i}这……这是我们罪孽的活证。{/i}"

# game/a15/6cold_arriv.rpy:564
translate english cold_arriv_elin_8ce9b26f:

    # me "{i}Наша дочь. Откуда я знаю, что это дочь?{/i}"
    me "{i}我们的女儿。我怎么知道是女儿？{/i}"

# game/a15/6cold_arriv.rpy:565
translate english cold_arriv_elin_5c76dbe7:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a15/6cold_arriv.rpy:566
translate english cold_arriv_elin_006a5bd0:

    # me "{i}Ну конечно... видения. Это не может быть просто так. Просто не может быть.{/i}"
    me "{i}当然……幻象。这不可能是巧合。绝不可能。{/i}"

# game/a15/6cold_arriv.rpy:567
translate english cold_arriv_elin_3305601d:

    # me "{i}Я слышал и видел ее десятки раз. Я уже знаю ее имя.{/i}"
    me "{i}我听过也见过她几十次。我已经知道她的名字。{/i}"

# game/a15/6cold_arriv.rpy:568
translate english cold_arriv_elin_5750e427:

    # me "{i}Селина.{/i}"
    me "{i}塞琳娜。{/i}"

# game/a15/6cold_arriv.rpy:570
translate english cold_arriv_elin_21d55922:

    # elin "Я велела оставить меня одну."
    elin "我吩咐过让我一个人待着。"

# game/a15/6cold_arriv.rpy:571
translate english cold_arriv_elin_4a72c92c:

    # me "Здесь прохладно для ребенка."
    me "这里对孩子来说太冷了。"

# game/a15/6cold_arriv.rpy:572
translate english cold_arriv_elin_a027cc87:

    # elin "Ей тепло."
    elin "她很暖和。"

# game/a15/6cold_arriv.rpy:573
translate english cold_arriv_elin_1a377d44:

    # me "А тебе?"
    me "那你呢？"

# game/a15/6cold_arriv.rpy:574
translate english cold_arriv_elin_b07e5013:

    # elin "И мне."
    elin "我也暖和。"

# game/a15/6cold_arriv.rpy:575
translate english cold_arriv_elin_8ba354d8:

    # me "И долго ты..."
    me "你打算……"

# game/a15/6cold_arriv.rpy:576
translate english cold_arriv_elin_fdc1e436:

    # elin "Сколько понадобится. [mename], то есть мой брат... он вернется в любой момент. Я чувствую, что..."
    elin "需要多久就多久。[mename]，也就是我哥哥……他随时会回来。我感觉……"

# game/a15/6cold_arriv.rpy:577
translate english cold_arriv_elin_3820771a:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:578
translate english cold_arriv_elin_ac39bf7b:

    # elin "Стой...."
    elin "等等……"

# game/a15/6cold_arriv.rpy:580
translate english cold_arriv_elin_6eb918f6:

    # elin "[mename]?!"
    elin "[mename]？！"

# game/a15/6cold_arriv.rpy:581
translate english cold_arriv_elin_21b30eb3:

    # me "[elin]."
    me "[elin]。"

# game/a15/6cold_arriv.rpy:584
translate english cold_arriv_elin_92ce34b9:

    # elin "{size=+8}[mename]! О, боги! Я знала! Я ЗНАЛА ЧТО ТЫ ВЕРНЕШЬСЯ!{/size}"
    elin "{size=+8}[mename]！哦，天哪！我知道！我就知道你会回来！{/size}"

# game/a15/6cold_arriv.rpy:585
translate english cold_arriv_elin_c1badeb4:

    # me "Воу! Аккуратнее. Ты больше не маленькая девочка."
    me "哇！轻点。你不再是小孩了。"

# game/a15/6cold_arriv.rpy:586
translate english cold_arriv_elin_d867e598:

    # elin "{size=+8}Я ЧУВСТВОВАЛА, ЧУВСТВОВАЛА, ЧТО ТЫ УЖЕ РЯДОМ!{/size}"
    elin "{size=+8}我感觉到，感觉到你已经在附近了！{/size}"

# game/a15/6cold_arriv.rpy:587
translate english cold_arriv_elin_4ebb9205:

    # me "Я тут минуту стоял, прежде чем ты меня узнала."
    me "我在这儿站了一分钟你才认出我。"

# game/a15/6cold_arriv.rpy:588
translate english cold_arriv_elin_05b6523e:

    # elin "{size=+8}БОГИ, я так тебя ждала, [mename]!{/size}"
    elin "{size=+8}天哪，我等了你这么久，[mename]！{/size}"

# game/a15/6cold_arriv.rpy:590
translate english cold_arriv_elin_cce6997c:

    # elin "Больше никогда, никогда меня не оставляй одну!"
    elin "再也不要，再也不要留我一个人！"

# game/a15/6cold_arriv.rpy:591
translate english cold_arriv_elin_5a9d1279:

    # me "Ты была тут не одна."
    me "你在这儿不是一个人。"

# game/a15/6cold_arriv.rpy:592
translate english cold_arriv_elin_82ebb72f:

    # elin "Без тебя я всегда одна."
    elin "没有你，我永远是一个人。"

# game/a15/6cold_arriv.rpy:593
translate english cold_arriv_elin_3820771a_1:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:594
translate english cold_arriv_elin_3c4a6f2a:

    # elin "А ты по мне скучал?"
    elin "你想我吗？"

# game/a15/6cold_arriv.rpy:595
translate english cold_arriv_elin_8f9071f9:

    # me "Конечно."
    me "当然。"

# game/a15/6cold_arriv.rpy:596
translate english cold_arriv_elin_29b2e856:

    # elin "Я думала, что умру. Честное слово. Каждый день был все труднее предыдущего."
    elin "我以为我会死。真的。每一天都比前一天更难熬。"

# game/a15/6cold_arriv.rpy:597
translate english cold_arriv_elin_91a472e5:

    # me "С каждым днем я был все ближе."
    me "每一天我都更近一些。"

# game/a15/6cold_arriv.rpy:598
translate english cold_arriv_elin_34b59e38:

    # elin "Или дальше. Пришли вести о кораблях. Я думала, что тебе придется ждать их починки. Что... что порт Хельвика замерзнет и ты останешься на зиму на Севере."
    elin "或者更远。传来了船的消息。我以为你得等它们修好。以为……赫尔维克港会冻住，你会留在北方过冬。"

# game/a15/6cold_arriv.rpy:599
translate english cold_arriv_elin_fc4ac8dc:

    # me "Так и произошло. Порт замерз."
    me "确实如此。港口冻住了。"

# game/a15/6cold_arriv.rpy:600
translate english cold_arriv_elin_832c7cf3:

    # elin "Ты добирался по суше?"
    elin "你是走陆路回来的？"

# game/a15/6cold_arriv.rpy:601
translate english cold_arriv_elin_14ba0579:

    # me "Да. Через вольные города."
    me "对。穿过自由城市。"

# game/a15/6cold_arriv.rpy:602
translate english cold_arriv_elin_2d5d0bdb:

    # elin "Как же так? Там ведь бушует чума."
    elin "怎么会？那里瘟疫肆虐。"

# game/a15/6cold_arriv.rpy:603
translate english cold_arriv_elin_d5e71379:

    # me "Она уже убила всех, кого могла."
    me "它已经杀光了它能杀的人。"

# game/a15/6cold_arriv.rpy:604
translate english cold_arriv_elin_44f7e39d:

    # elin "Ты все равно рисковал."
    elin "你还是冒险了。"

# game/a15/6cold_arriv.rpy:605
translate english cold_arriv_elin_4894de96:

    # me "У меня было ради кого."
    me "我有值得为之冒险的人。"

# game/a15/6cold_arriv.rpy:606
translate english cold_arriv_elin_b0269b75:

    # elin "Нет... нет. Оно того не стоит. Если бы ты умер... я бы тоже умерла."
    elin "不……不。不值得。如果你死了……我也会死。"

# game/a15/6cold_arriv.rpy:607
translate english cold_arriv_elin_d997652c:

    # me "Но я жив. И я здесь."
    me "但我活着。而且我在这里。"

# game/a15/6cold_arriv.rpy:608
translate english cold_arriv_elin_3877aca5:

    # elin "Да."
    elin "对。"

# game/a15/6cold_arriv.rpy:612
translate english cold_arriv_elin_dfb1a0fd:

    # elin "{i}Я люблю тебя.{/i}"
    elin "{i}我爱你。{/i}"

# game/a15/6cold_arriv.rpy:613
translate english cold_arriv_elin_8799dc8e:

    # me "{i}[elin]?{/i}"
    me "{i}[elin]？{/i}"

# game/a15/6cold_arriv.rpy:614
translate english cold_arriv_elin_f34211e3:

    # elin "{i}Ты снова слышишь мои мысли?{/i}"
    elin "{i}你又能听到我的想法了？{/i}"

# game/a15/6cold_arriv.rpy:615
translate english cold_arriv_elin_26aa8569:

    # me "{i}Да. И ты мои.{/i}"
    me "{i}对。你也能听到我的。{/i}"

# game/a15/6cold_arriv.rpy:616
translate english cold_arriv_elin_906e1e9e:

    # elin "{i}Плевать. Мне нечего таить от тебя. Я люблю. Люблю, люблю, люблю тебя.{/i}"
    elin "{i}无所谓。我对你没什么可隐瞒的。我爱你。爱你，爱你，爱你。{/i}"

# game/a15/6cold_arriv.rpy:617
translate english cold_arriv_elin_6b76b94d:

    # me "{i}И я тебя люблю, сестренка.{/i}"
    me "{i}我也爱你，妹妹。{/i}"

# game/a15/6cold_arriv.rpy:618
translate english cold_arriv_elin_8bceebd2:

    # elin "{i}Клянусь богами, если бы ты погиб по пути...{/i}"
    elin "{i}我向神发誓，如果你在路上死了……{/i}"

# game/a15/6cold_arriv.rpy:619
translate english cold_arriv_elin_5c283629:

    # me "{i}То что?{/i}"
    me "{i}那又怎样？{/i}"

# game/a15/6cold_arriv.rpy:620
translate english cold_arriv_elin_fbb6b7ef:

    # elin "{i}Я бы отправилась в бездну. Я бы вырвала твое имя у безымянных богов. Клянусь.{/i}"
    elin "{i}我会下到深渊。我会从无名之神那里夺回你的名字。我发誓。{/i}"

# game/a15/6cold_arriv.rpy:622
translate english cold_arriv_elin_59da65e3:

    # me "{i}Подумать только. Даже жена так не встречала меня.{/i}"
    me "{i}想想看。连我妻子都没这样迎接过我。{/i}"

# game/a15/6cold_arriv.rpy:623
translate english cold_arriv_elin_417449b4:

    # me "{i}[elin] любит меня. Не то, чтобы я раньше в этом сомневался, но сейчас...{/i}"
    me "{i}[elin]爱我。倒不是我以前怀疑过，但现在……{/i}"

# game/a15/6cold_arriv.rpy:624
translate english cold_arriv_elin_617c5f75:

    # me "{i}Она бы отправилась со мной в бездну.{/i}"
    me "{i}她会跟我一起下深渊。{/i}"

# game/a15/6cold_arriv.rpy:625
translate english cold_arriv_elin_5c3393a7:

    # me "{i}...кто знает. Может туда это нас и заведет.{/i}"
    me "{i}……谁知道。也许这真会把我们带到那里去。{/i}"

# game/a15/6cold_arriv.rpy:626
translate english cold_arriv_elin_65d3ca99:

    # me "{i}Но сейчас мне плевать.{/i}"
    me "{i}但现在我不在乎。{/i}"

# game/a15/6cold_arriv.rpy:627
translate english cold_arriv_elin_a212a627:

    # me "{i}Я скучал так же, как скучала она.{/i}"
    me "{i}我和她一样想念。{/i}"

# game/a15/6cold_arriv.rpy:629
translate english cold_arriv_elin_92d397c8:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:630
translate english cold_arriv_elin_3820771a_2:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:631
translate english cold_arriv_elin_361fcb4a:

    # elin "Мне было так плохо без тебя... ужасно. Невыносимо."
    elin "没有你我好难受……好可怕。难以忍受。"

# game/a15/6cold_arriv.rpy:632
translate english cold_arriv_elin_cb375715:

    # me "Теперь я рядом."
    me "现在我就在你身边。"

# game/a15/6cold_arriv.rpy:633
translate english cold_arriv_elin_31d9d5d1:

    # elin "Я... от меня будто оторвали половину тела. Половину моего сердца."
    elin "我……好像有人从我身上撕掉了一半。我一半的心。"

# game/a15/6cold_arriv.rpy:634
translate english cold_arriv_elin_d1b26d3f:

    # me "Оно снова целое."
    me "它又完整了。"

# game/a15/6cold_arriv.rpy:635
translate english cold_arriv_elin_e758b0d0:

    # elin "Да, но... боги, я больше никогда не хочу чувствовать этого. Это хуже любой пытки."
    elin "对，但……天哪，我再也不想有那种感觉了。那比任何折磨都糟。"

# game/a15/6cold_arriv.rpy:636
translate english cold_arriv_elin_3820771a_3:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:637
translate english cold_arriv_elin_c91853ff:

    # elin "Пообещай мне."
    elin "答应我。"

# game/a15/6cold_arriv.rpy:638
translate english cold_arriv_elin_2b513065:

    # me "Что пообещать?"
    me "答应什么？"

# game/a15/6cold_arriv.rpy:639
translate english cold_arriv_elin_61264e2b:

    # elin "Что больше никогда меня не оставишь."
    elin "再也不离开我。"

# game/a15/6cold_arriv.rpy:640
translate english cold_arriv_elin_c4720c1f:

    # me "Ты же знаешь, что я этого не хочу."
    me "你知道我不想离开。"

# game/a15/6cold_arriv.rpy:641
translate english cold_arriv_elin_22407935:

    # elin "Так пообещай."
    elin "那就答应我。"

# game/a15/6cold_arriv.rpy:642
translate english cold_arriv_elin_21b30eb3_1:

    # me "[elin]."
    me "[elin]。"

# game/a15/6cold_arriv.rpy:644
translate english cold_arriv_elin_6b6e7570:

    # elin "Что?"
    elin "什么？"

# game/a15/6cold_arriv.rpy:645
translate english cold_arriv_elin_bef4b70e:

    # me "Я люблю тебя."
    me "我爱你。"

# game/a15/6cold_arriv.rpy:646
translate english cold_arriv_elin_a96608ac:

    # elin "Нет... нет... не уходи... не уходи от обязательств. Пообещай мне."
    elin "不……不……别走……别逃避承诺。答应我。"

# game/a15/6cold_arriv.rpy:647
translate english cold_arriv_elin_13af8f3b:

    # me "Ты же знаешь, что я не могу."
    me "你知道我不能。"

# game/a15/6cold_arriv.rpy:648
translate english cold_arriv_elin_e0b07b4d:

    # elin "Можешь."
    elin "你能。"

# game/a15/6cold_arriv.rpy:649
translate english cold_arriv_elin_65ec3ede:

    # me "Я люблю тебя и не хочу тебе лгать. Я хочу дать обещание, но я не знаю, смогу ли его сдержать."
    me "我爱你，不想对你撒谎。我想许下承诺，但我不知道能不能守住。"

# game/a15/6cold_arriv.rpy:650
translate english cold_arriv_elin_ff98ba9e:

    # elin "Почему?"
    elin "为什么？"

# game/a15/6cold_arriv.rpy:651
translate english cold_arriv_elin_84897369:

    # me "Ты знаешь почему."
    me "你知道为什么。"

# game/a15/6cold_arriv.rpy:652
translate english cold_arriv_elin_56a451e2:

    # elin "Неужели эти обязанности, этот долг, эта корона того стоят?"
    elin "那些职责、那份义务、那顶王冠真的值得吗？"

# game/a15/6cold_arriv.rpy:653
translate english cold_arriv_elin_ac657966:

    # me "[elin], мы уже говорили с тобой об этом."
    me "[elin]，我们已经谈过这个了。"

# game/a15/6cold_arriv.rpy:654
translate english cold_arriv_elin_439e090d:

    # elin "Я знаю... но... но тогда пообещай, что не бросишь меня сам. Что никогда не оставишь меня по собственной воле."
    elin "我知道……但……那至少答应我，你不会自己抛弃我。永远不会自愿离开我。"

# game/a15/6cold_arriv.rpy:655
translate english cold_arriv_elin_9538b431:

    # me "Обещаю."
    me "我答应。"

# game/a15/6cold_arriv.rpy:656
translate english cold_arriv_elin_a90ebc42:

    # elin "Хорошо... хорошо..."
    elin "好……好……"

# game/a15/6cold_arriv.rpy:657
translate english cold_arriv_elin_3820771a_4:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:658
translate english cold_arriv_elin_c9d2d002:

    # elin "Тебе не тяжело?..."
    elin "我不重吗？……"

# game/a15/6cold_arriv.rpy:659
translate english cold_arriv_elin_56907f0f:

    # me "Немного. Хотя надо признать ты чуть прибавила в весе."
    me "有一点。不过得承认，你重了一点。"

# game/a15/6cold_arriv.rpy:660
translate english cold_arriv_elin_eff25d55:

    # elin "Прости. Я сейчас слезу."
    elin "抱歉。我这就下来。"

# game/a15/6cold_arriv.rpy:662
translate english cold_arriv_elin_36925805:

    # elin "Ты уже проведал жену?"
    elin "你去看过妻子了吗？"

# game/a15/6cold_arriv.rpy:663
translate english cold_arriv_elin_fc30fd2b:

    # me "Да."
    me "看过了。"

# game/a15/6cold_arriv.rpy:664
translate english cold_arriv_elin_deba414a:

    # elin "Выходит ты сначала пошел к ней."
    elin "所以你先去找她了。"

# game/a15/6cold_arriv.rpy:665
translate english cold_arriv_elin_9ac49b0d:

    # me "[elin]..."
    me "[elin]……"

# game/a15/6cold_arriv.rpy:666
translate english cold_arriv_elin_8266d2ad:

    # elin "Что? Это правда. Сначала ты проверил, как она, а не как я."
    elin "怎么？这是事实。你先去看她，而不是我。"

# game/a15/6cold_arriv.rpy:667
translate english cold_arriv_elin_cca7255c:

    # me "Тебя не было в твоих покоях."
    me "你不在自己房里。"

# game/a15/6cold_arriv.rpy:668
translate english cold_arriv_elin_890ca2dc:

    # elin "Ну я..."
    elin "嗯我……"

# game/a15/6cold_arriv.rpy:669
translate english cold_arriv_elin_a467e581:

    # me "Слуги сказали, что ты много гуляешь. Что ты не берешь с собой не только охрану, но и слуг."
    me "仆人说你经常散步。不仅不带护卫，连仆人都不要。"

# game/a15/6cold_arriv.rpy:670
translate english cold_arriv_elin_3877aca5_1:

    # elin "Да."
    elin "对。"

# game/a15/6cold_arriv.rpy:671
translate english cold_arriv_elin_658d2c78:

    # me "Они сказали, что обычно ты возвращаешься поздней ночью."
    me "他们说你通常深夜才回来。"

# game/a15/6cold_arriv.rpy:672
translate english cold_arriv_elin_69b974cc:

    # elin "Так ты пришел сначала ко мне?"
    elin "所以你是先来找我的？"

# game/a15/6cold_arriv.rpy:673
translate english cold_arriv_elin_f14a33bf:

    # me "Я просто тебя не нашел. Прости. Я был слишком уставший с дороги. А раз уже вышло, что моя жена как раз находится там же, где моя постель..."
    me "我只是找不到你。抱歉。我路上太累了。既然我妻子正好在我床所在的地方……"

# game/a15/6cold_arriv.rpy:674
translate english cold_arriv_elin_d0334f9c:

    # elin "Ладно. Я поняла, прости."
    elin "好吧。我明白了，抱歉。"

# game/a15/6cold_arriv.rpy:675
translate english cold_arriv_elin_7ee0e7b4:

    # me "Я проснулся ночью, но тебя все еще не было. Пришлось расспрашивать слуг о том, где тебя можно найти."
    me "我夜里醒了，你还没回来。只好问仆人能在哪儿找到你。"

# game/a15/6cold_arriv.rpy:676
translate english cold_arriv_elin_9a2c9906:

    # elin "Я... чаще всего была здесь. Наблюдала за морем. Ждала тебя."
    elin "我……大多时候都在这儿。看着海。等你。"

# game/a15/6cold_arriv.rpy:677
translate english cold_arriv_elin_3820771a_5:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:678
translate english cold_arriv_elin_9c50aa62:

    # elin "Ты не успел."
    elin "你没赶上。"

# game/a15/6cold_arriv.rpy:679
translate english cold_arriv_elin_5cfe3b32:

    # me "Знаю. Прости. Как наша дочь?"
    me "我知道。抱歉。我们的女儿怎么样？"

# game/a15/6cold_arriv.rpy:680
translate english cold_arriv_elin_c986163b:

    # elin "Тебе рассказали, что это девочка?"
    elin "有人告诉你是个女孩？"

# game/a15/6cold_arriv.rpy:681
translate english cold_arriv_elin_dd69c3a1:

    # me "Можно и так сказать."
    me "也可以这么说。"

# game/a15/6cold_arriv.rpy:682
translate english cold_arriv_elin_e2aea4a7:

    # elin "Тебе не рассказали... не рассказали что она..."
    elin "他们没告诉你……没告诉你她……"

# game/a15/6cold_arriv.rpy:683
translate english cold_arriv_elin_ad02f53a:

    # me "Что?"
    me "什么？"

# game/a15/6cold_arriv.rpy:685
translate english cold_arriv_elin_901c2e07:

    # elin "Она слепа, [mename]."
    elin "她看不见，[mename]。"

# game/a15/6cold_arriv.rpy:686
translate english cold_arriv_elin_dd7b6520:

    # me "Слепа?"
    me "看不见？"

# game/a15/6cold_arriv.rpy:687
translate english cold_arriv_elin_ce65334a:

    # elin "Да. Полностью. У нее мутные маленькие зрачки. Они не реагируют на свет."
    elin "对。完全看不见。她的小瞳孔浑浊。对光没有反应。"

# game/a15/6cold_arriv.rpy:688
translate english cold_arriv_elin_b5617c5e:

    # me "Ох..."
    me "哦……"

# game/a15/6cold_arriv.rpy:689
translate english cold_arriv_elin_aaaadb06:

    # elin "Доктора говорят, что она еще и глухонемая."
    elin "医生们还说她又聋又哑。"

# game/a15/6cold_arriv.rpy:690
translate english cold_arriv_elin_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/6cold_arriv.rpy:691
translate english cold_arriv_elin_3559fec0:

    # elin "Потому что она рождалась без криков. Совсем. И с тех пор не проронила ни звука."
    elin "因为她出生时没有哭声。完全没有。从那以后也没发出过一点声音。"

# game/a15/6cold_arriv.rpy:692
translate english cold_arriv_elin_914a5590:

    # me "Вообще?"
    me "完全没有？"

# game/a15/6cold_arriv.rpy:693
translate english cold_arriv_elin_4c7aed48:

    # elin "Вообще. Ни разу. Ни плача, ни всхлипа, ни крика, ни смеха, ничего."
    elin "完全没有。一次都没有。不哭、不抽泣、不喊叫、不笑，什么都没有。"

# game/a15/6cold_arriv.rpy:694
translate english cold_arriv_elin_3820771a_6:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:695
translate english cold_arriv_elin_f70773e9:

    # elin "Но я думаю, что они ошибаются."
    elin "但我觉得他们错了。"

# game/a15/6cold_arriv.rpy:696
translate english cold_arriv_elin_bc09a8e2:

    # me "Доктора?"
    me "医生？"

# game/a15/6cold_arriv.rpy:697
translate english cold_arriv_elin_a7382f55:

    # elin "Да. Она слышит. Это точно. Она реагирует на звуки. Я сама видела. Просто она обращает внимание только на некоторые источники звука."
    elin "对。她能听见。这肯定。她对声音有反应。我亲眼见过。只是她只注意某些声音。"

# game/a15/6cold_arriv.rpy:698
translate english cold_arriv_elin_e473fa2f:

    # me "Например?"
    me "比如？"

# game/a15/6cold_arriv.rpy:699
translate english cold_arriv_elin_68630c97:

    # elin "Например когда я говорю с ней. Она поворачивает голову в мою сторону. Она слышит, я знаю. И иногда мне кажется, что видит."
    elin "比如我跟她说话时。她会把头转向我。她能听见，我知道。有时我还觉得她能看见。"

# game/a15/6cold_arriv.rpy:700
translate english cold_arriv_elin_f4c7fd7f:

    # elin "Может очень плохо... но она все-таки что-то видит. Я знаю это. Она смотрит... слишком осмысленно. Будто понимает, что перед ней."
    elin "也许看得很差……但她还是能看到什么。我知道。她看人的样子……太有意识了。仿佛明白眼前是什么。"

# game/a15/6cold_arriv.rpy:701
translate english cold_arriv_elin_3820771a_7:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:702
translate english cold_arriv_elin_fc0088a5:

    # elin "Будь она полностью слепой с рождения... она бы даже не понимала, что такое видит. И все же она переводит взгляд. Я это видела."
    elin "如果她从出生就完全失明……她甚至不会明白看见是什么。可她还是会移动目光。我见过。"

# game/a15/6cold_arriv.rpy:704
translate english cold_arriv_elin_828f8493:

    # me "Ее глаза..."
    me "她的眼睛……"

# game/a15/6cold_arriv.rpy:705
translate english cold_arriv_elin_d773d582:

    # elin "Да. Я знаю. Наверное я просто хочу верить в лучшее."
    elin "对。我知道。大概我只是想往好处想。"

# game/a15/6cold_arriv.rpy:706
translate english cold_arriv_elin_0c9a3014:

    # me "Позволишь, я попробую проверить?"
    me "让我试试看可以吗？"

# game/a15/6cold_arriv.rpy:707
translate english cold_arriv_elin_d65ff2b8:

    # elin "М?"
    elin "嗯？"

# game/a15/6cold_arriv.rpy:708
translate english cold_arriv_elin_c4615034:

    # me "Ну-ка. Коснись меня, маленькая."
    me "来。摸摸我，小家伙。"

# game/a15/6cold_arriv.rpy:710
translate english cold_arriv_elin_a2ab55db:

    # elin "О боги..."
    elin "哦天哪……"

# game/a15/6cold_arriv.rpy:711
translate english cold_arriv_elin_9b8944f2:

    # me "Похоже что-то она все же видит."
    me "看来她确实能看到什么。"

# game/a15/6cold_arriv.rpy:712
translate english cold_arriv_elin_c5fb9f22:

    # elin "Наверное... или услышала тебя, когда ты нагнулся."
    elin "也许……或者你弯腰时她听到了你。"

# game/a15/6cold_arriv.rpy:713
translate english cold_arriv_elin_04e543fa:

    # me "В любом случае что-то из этого у нее должно быть, верно? Или зрение или слух."
    me "不管怎样，她总得有其中一样，对吧？不是视力就是听力。"

# game/a15/6cold_arriv.rpy:714
translate english cold_arriv_elin_d5678533:

    # elin "Да. Должно. Ты прав."
    elin "对。应该有。你说得对。"

# game/a15/6cold_arriv.rpy:715
translate english cold_arriv_elin_74f3732f:

    # me "Видишь? Уже на одну причину для слез меньше."
    me "看？少了一个哭的理由。"

# game/a15/6cold_arriv.rpy:716
translate english cold_arriv_elin_4bade01a:

    # elin "...это так мило."
    elin "……这真贴心。"

# game/a15/6cold_arriv.rpy:717
translate english cold_arriv_elin_fcb15973:

    # me "Крепко держит. Не отпускает."
    me "抓得很紧。不肯松开。"

# game/a15/6cold_arriv.rpy:718
translate english cold_arriv_elin_bb08a98c:

    # elin "Еще бы. Она впервые видит... слышит и чувствует отца."
    elin "当然。她第一次看到……听到并感觉到父亲。"

# game/a15/6cold_arriv.rpy:719
translate english cold_arriv_elin_ffd8f7c2:

    # me "Как ее зовут? "
    me "她叫什么名字？"

# game/a15/6cold_arriv.rpy:720
translate english cold_arriv_elin_58520e8b:

    # elin "C..."
    elin "塞……"

# game/a15/6cold_arriv.rpy:721
translate english cold_arriv_elin_ab4b032f:

    # me "Селина?"
    me "塞琳娜？"

# game/a15/6cold_arriv.rpy:722
translate english cold_arriv_elin_1f9d37c6:

    # elin "Кто тебе сказал?"
    elin "谁告诉你的？"

# game/a15/6cold_arriv.rpy:723
translate english cold_arriv_elin_8cc8ea72:

    # me "Она."
    me "她。"

# game/a15/6cold_arriv.rpy:724
translate english cold_arriv_elin_d65ff2b8_1:

    # elin "М?"
    elin "嗯？"

# game/a15/6cold_arriv.rpy:725
translate english cold_arriv_elin_8d76fe0b:

    # me "Красивое имя. Ты придумала?"
    me "好美的名字。你想的？"

# game/a15/6cold_arriv.rpy:726
translate english cold_arriv_elin_9ec35991:

    # elin "Оно мне приснилось."
    elin "它出现在我梦里。"

# game/a15/6cold_arriv.rpy:728
translate english cold_arriv_elin_e6d12a85:

    # me "Хороший был сон. Она мне тоже снится."
    me "那是个好梦。我也梦到她。"

# game/a15/6cold_arriv.rpy:729
translate english cold_arriv_elin_1796a11d:

    # elin "Наша дочь? Правда? Ты говорил о видениях, я помню."
    elin "我们的女儿？真的？我记得你说过幻象。"

# game/a15/6cold_arriv.rpy:730
translate english cold_arriv_elin_eae18afb:

    # me "Иногда это сны, иногда видения... не могу отличить их друг от друга."
    me "有时是梦，有时是幻象……我分不清。"

# game/a15/6cold_arriv.rpy:731
translate english cold_arriv_elin_c9d77683:

    # elin "И это хорошие сны?"
    elin "那是好梦吗？"

# game/a15/6cold_arriv.rpy:732
translate english cold_arriv_elin_7ae92b8e:

    # me "...хорошие."
    me "……是好梦。"

# game/a15/6cold_arriv.rpy:733
translate english cold_arriv_elin_6640ca38:

    # elin "О чем они?"
    elin "梦到什么？"

# game/a15/6cold_arriv.rpy:734
translate english cold_arriv_elin_dfec7561:

    # me "О том, что все будет хорошо."
    me "梦到一切都会好起来。"

# game/a15/6cold_arriv.rpy:735
translate english cold_arriv_elin_77b60866:

    # elin "Ты меня дуришь."
    elin "你在骗我。"

# game/a15/6cold_arriv.rpy:736
translate english cold_arriv_elin_e18dd6a9:

    # me "Не дурю."
    me "没骗你。"

# game/a15/6cold_arriv.rpy:737
translate english cold_arriv_elin_e4d9a0b0:

    # elin "[mename]..."
    elin "[mename]……"

# game/a15/6cold_arriv.rpy:738
translate english cold_arriv_elin_71e0d390:

    # me "Я видел ее взрослой. Она будет настоящей красавицей."
    me "我见过她长大的样子。她会是个真正的美人。"

# game/a15/6cold_arriv.rpy:739
translate english cold_arriv_elin_9c6de5fa:

    # elin "Правда?"
    elin "真的？"

# game/a15/6cold_arriv.rpy:740
translate english cold_arriv_elin_e5a3e12d:

    # me "Я бы не стал лгать о таком."
    me "这种事我不会撒谎。"

# game/a15/6cold_arriv.rpy:741
translate english cold_arriv_elin_b8cf8157:

    # elin "Это... это замечательно."
    elin "这……这太好了。"

# game/a15/6cold_arriv.rpy:742
translate english cold_arriv_elin_f863a151:

    # me "Она говорила со мной. И все слышала."
    me "她和我说话了。而且什么都听见了。"

# game/a15/6cold_arriv.rpy:743
translate english cold_arriv_elin_e353280a:

    # elin "Что она тебе говорила?"
    elin "她跟你说了什么？"

# game/a15/6cold_arriv.rpy:744
translate english cold_arriv_elin_c174d41c:

    # me "Разное. Все и не вспомню. Главное - она со мной говорила."
    me "各种各样。我记不全了。重要的是——她和我说话了。"

# game/a15/6cold_arriv.rpy:745
translate english cold_arriv_elin_c777df1a:

    # elin "А видела?"
    elin "那她看到了吗？"

# game/a15/6cold_arriv.rpy:746
translate english cold_arriv_elin_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a15/6cold_arriv.rpy:747
translate english cold_arriv_elin_4e2f76e0:

    # elin "У нее было зрение в этих твоих снах?"
    elin "在你那些梦里，她有视力吗？"

# game/a15/6cold_arriv.rpy:748
translate english cold_arriv_elin_3820771a_8:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:750
translate english cold_arriv_elin_1d73d154:

    # elin "Выходит она была слепа..."
    elin "所以她是看不见的……"

# game/a15/6cold_arriv.rpy:751
translate english cold_arriv_elin_5c4e0a2d:

    # me "Это просто сны. Может она и не слепа вовсе. Просто не очень хорошо видит."
    me "那只是梦。也许她根本不算盲。只是看得不太好。"

# game/a15/6cold_arriv.rpy:752
translate english cold_arriv_elin_64a63787:

    # elin "Не обманывайся, [mename]. Ты видишь ее глаза. Доктора говорят это единственное, в чем они уверены наверняка."
    elin "别自欺欺人，[mename]。你看得见她的眼睛。医生说这是他们唯一确定的事。"

# game/a15/6cold_arriv.rpy:753
translate english cold_arriv_elin_cdfcf9a2:

    # elin "Слух и голос... такое бывает в младенчестве. Но глаза... если даже в твоих снах она приходит слепой..."
    elin "听力和声音……婴儿期会有这种情况。但眼睛……如果连在你梦里她都是盲的……"

# game/a15/6cold_arriv.rpy:754
translate english cold_arriv_elin_edf19204:

    # me "Она бойкая для слепой. Держит мой палец уже обеими ручками."
    me "作为一个盲孩子，她很有劲。已经用两只小手抓住我的手指了。"

# game/a15/6cold_arriv.rpy:755
translate english cold_arriv_elin_96533e4d:

    # elin "Думаешь это наказание богов?"
    elin "你觉得这是神的惩罚吗？"

# game/a15/6cold_arriv.rpy:756
translate english cold_arriv_elin_9508d41b:

    # me "За что?"
    me "为什么？"

# game/a15/6cold_arriv.rpy:757
translate english cold_arriv_elin_3e62130b:

    # elin "Ты знаешь за что."
    elin "你知道为什么。"

# game/a15/6cold_arriv.rpy:758
translate english cold_arriv_elin_704ef71f:

    # me "Нет. Не знаю."
    me "不。我不知道。"

# game/a15/6cold_arriv.rpy:759
translate english cold_arriv_elin_f0858feb:

    # elin "За то что мы сделали."
    elin "因为我们做的事。"

# game/a15/6cold_arriv.rpy:760
translate english cold_arriv_elin_17dea075:

    # me "Что-то я не слышал о том, что безымянные боги наставляли не любить свою сестру."
    me "我可没听说无名之神教导过不许爱自己的妹妹。"

# game/a15/6cold_arriv.rpy:761
translate english cold_arriv_elin_dea78311:

    # elin "Но люди... Закон..."
    elin "但人们……法律……"

# game/a15/6cold_arriv.rpy:762
translate english cold_arriv_elin_0d517c5f:

    # me "Если боги существуют, им плевать на законы людей, я тебя уверяю."
    me "如果神存在，他们根本不在乎人的法律，我向你保证。"

# game/a15/6cold_arriv.rpy:763
translate english cold_arriv_elin_eddfc16a:

    # elin "Ты не можешь этого знать."
    elin "你不可能知道。"

# game/a15/6cold_arriv.rpy:765
translate english cold_arriv_elin_2e7f2d7d:

    # me "Ты правда думаешь, что в бездне без имен и самого времени, богам есть дело до того, чья кровь мешается наверху?"
    me "你真觉得在一个没有名字、连时间都没有的深渊里，神会在乎上面谁的血混在一起？"

# game/a15/6cold_arriv.rpy:766
translate english cold_arriv_elin_516ff048:

    # elin "Я не знаю."
    elin "我不知道。"

# game/a15/6cold_arriv.rpy:767
translate english cold_arriv_elin_c47da634:

    # me "Божественного наказания не существует, [elin]. Как и благословения."
    me "神罚不存在，[elin]。神佑也不存在。"

# game/a15/6cold_arriv.rpy:768
translate english cold_arriv_elin_4b6093fe:

    # elin "Откуда тебе..."
    elin "你怎么会……"

# game/a15/6cold_arriv.rpy:769
translate english cold_arriv_elin_399379cc:

    # me "Людвиг читал нам одни и те же книги. Как много ублюдков, нарушивших все мыслимые и немыслимые людские законы, спокойно упокоились, не знав бед и горя:"
    me "路德维希给我们读过同样的书。多少违反了一切能想到和想不到的人类法律的混蛋，平静地死去，不知苦难与悲伤。"

# game/a15/6cold_arriv.rpy:770
translate english cold_arriv_elin_92d397c8_1:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:771
translate english cold_arriv_elin_4d20371b:

    # me "Как много благородных и справедливых людей страдали так, что смерть была для них избавлением?"
    me "又有多少高贵公正的人痛苦到死亡对他们反而是解脱？"

# game/a15/6cold_arriv.rpy:772
translate english cold_arriv_elin_5720db8a:

    # elin "И все же... и все же она слепа."
    elin "可还是……可她还是盲的。"

# game/a15/6cold_arriv.rpy:773
translate english cold_arriv_elin_71df27cb:

    # me "Она человек. Как ты и я. Как сотни тысяч других по всему Континенту. Люди иногда рождаются без рук и ног, без головы или вообще мертвецами."
    me "她是人。像你和我。像大陆上成千上万的人。人有时生来没有手脚、没有头，甚至生来就是死胎。"

# game/a15/6cold_arriv.rpy:774
translate english cold_arriv_elin_14dec580:

    # me "Такое случается. В этом нет никакой воли богов. Либо их правила настолько случайны, что пытаться угадать их бесполезно."
    me "这种事会发生。其中没有神的意志。要么他们的规则就是如此随机，试图猜测毫无意义。"

# game/a15/6cold_arriv.rpy:776
translate english cold_arriv_elin_c8e54e1e:

    # elin "Наверное ты прав."
    elin "也许你说得对。"

# game/a15/6cold_arriv.rpy:777
translate english cold_arriv_elin_6b5d6197:

    # me "Я прав. Знаешь, у тебя ведь никогда не было приступов гибридной лихорадки?"
    me "我说得对。你知道你从没得过混合热发作吧？"

# game/a15/6cold_arriv.rpy:778
translate english cold_arriv_elin_8fa945c9:

    # elin "Нет..."
    elin "没有……"

# game/a15/6cold_arriv.rpy:779
translate english cold_arriv_elin_e0dafa87:

    # me "А у меня были. И когда они были... я видел такое... мне кажется будто я говорил с богами."
    me "而我有过。发作时……我看到了那样的东西……感觉像是我和神说过话。"

# game/a15/6cold_arriv.rpy:780
translate english cold_arriv_elin_9c6de5fa_1:

    # elin "Правда?"
    elin "真的？"

# game/a15/6cold_arriv.rpy:781
translate english cold_arriv_elin_d1ab00f4:

    # me "Из всех людей на Континенте, мне стоило бы больше остальных в них верить."
    me "大陆上所有人里，我本该是最该信他们的人。"

# game/a15/6cold_arriv.rpy:782
translate english cold_arriv_elin_36939e49:

    # elin "А ты не веришь?"
    elin "你不信？"

# game/a15/6cold_arriv.rpy:783
translate english cold_arriv_elin_b37b9063:

    # me "А это не важно. Верю я в них или нет. Я следую своей воле. В чем ценность моей жизни, если я обязан следовать воле другого существа?"
    me "这不重要。信不信都一样。我遵循自己的意志。如果我必须遵循另一个存在的意志，我的生命还有什么价值？"

# game/a15/6cold_arriv.rpy:784
translate english cold_arriv_elin_c869819d:

    # elin "А если это существо хочет тебе хорошего."
    elin "如果那个存在想让你好呢？"

# game/a15/6cold_arriv.rpy:785
translate english cold_arriv_elin_219f185f:

    # me "Это в любом случае решать мне. Конечное решение принимаю я."
    me "无论如何都由我决定。最终选择在我。"

# game/a15/6cold_arriv.rpy:786
translate english cold_arriv_elin_39f095d2:

    # elin "И какое твое конечное решение?"
    elin "那你的最终选择是什么？"

# game/a15/6cold_arriv.rpy:787
translate english cold_arriv_elin_c1aa3de2:

    # me "Любить свою сестру."
    me "爱我的妹妹。"

# game/a15/6cold_arriv.rpy:788
translate english cold_arriv_elin_92d397c8_2:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:789
translate english cold_arriv_elin_3820771a_9:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:791
translate english cold_arriv_elin_1a10e84b:

    # elin "Ох, [mename]..."
    elin "哦，[mename]……"

# game/a15/6cold_arriv.rpy:792
translate english cold_arriv_elin_9ac49b0d_1:

    # me "[elin]..."
    me "[elin]……"

# game/a15/6cold_arriv.rpy:793
translate english cold_arriv_elin_13fa4ff8:

    # elin "Ты единственный в этом мире, кто способен меня успокоить."
    elin "你是这世上唯一能让我安心的人。"

# game/a15/6cold_arriv.rpy:794
translate english cold_arriv_elin_080f1731:

    # me "Я хочу пользоваться этим как можно меньше. Ты слишком много плачешь, сестренка."
    me "我希望能尽量少用这一点。你哭得太多了，妹妹。"

# game/a15/6cold_arriv.rpy:795
translate english cold_arriv_elin_9aca6289:

    # elin "Теперь, когда ты вернулся, я буду плакать меньше, обещаю."
    elin "现在你回来了，我会少哭的，我保证。"

# game/a15/6cold_arriv.rpy:796
translate english cold_arriv_elin_70f9aad8:

    # me "Я запомнил твое обещание."
    me "我记住你的承诺了。"

# game/a15/6cold_arriv.rpy:797
translate english cold_arriv_elin_be80ad73:

    # elin "Как и я твое."
    elin "我也记住你的。"

# game/a15/6cold_arriv.rpy:798
translate english cold_arriv_elin_faf23b78:

    # me "Уверен хранить эти обещания будет легко."
    me "我相信守住这些承诺会很容易。"

# game/a15/6cold_arriv.rpy:799
translate english cold_arriv_elin_877beb09:

    # elin "Ты так думаешь?"
    elin "你这么觉得？"

# game/a15/6cold_arriv.rpy:800
translate english cold_arriv_elin_e5e3e00a:

    # me "Да. Пока мы рядом - да."
    me "对。只要我们在一起——就是。"

# game/a15/6cold_arriv.rpy:801
translate english cold_arriv_elin_aa3cadb0:

    # elin "Я надеюсь мы рядом навсегда."
    elin "我希望我们永远在一起。"

# game/a15/6cold_arriv.rpy:802
translate english cold_arriv_elin_247e3c8b:

    # me "Я соскучился по твоим губам."
    me "我想念你的嘴唇。"

# game/a15/6cold_arriv.rpy:803
translate english cold_arriv_elin_4adb622b:

    # elin "А я по твоим."
    elin "我也想念你的。"

# game/a15/6cold_arriv.rpy:806
translate english cold_arriv_elin_e64ebf9c:

    # elin "Ммнм!"
    elin "嗯嗯！"

# game/a15/6cold_arriv.rpy:807
translate english cold_arriv_elin_935e197f:

    # me "Мнмн!"
    me "嗯嗯！"

# game/a15/6cold_arriv.rpy:808
translate english cold_arriv_elin_9cd9800d:

    # elin "Мм...ммнм..мм..."
    elin "嗯……嗯嗯……嗯……"

# game/a15/6cold_arriv.rpy:809
translate english cold_arriv_elin_49979b81:

    # me "Ятебятоже..."
    me "我也爱你……"

# game/a15/6cold_arriv.rpy:810
translate english cold_arriv_elin_415f9d93:

    # elin "Пжлст..."
    elin "求你……"

# game/a15/6cold_arriv.rpy:811
translate english cold_arriv_elin_8df69cf5:

    # me "Ммнм..."
    me "嗯嗯……"

# game/a15/6cold_arriv.rpy:812
translate english cold_arriv_elin_9448ee21:

    # elin "Счс..."
    elin "现在……"

# game/a15/6cold_arriv.rpy:813
translate english cold_arriv_elin_ac5b8898:

    # me "Здс?"
    me "这儿？"

# game/a15/6cold_arriv.rpy:814
translate english cold_arriv_elin_cd9a7292:

    # elin "Мнм.."
    elin "嗯……"

# game/a15/6cold_arriv.rpy:815
translate english cold_arriv_elin_b9b88151:

    # me "Уврн?"
    me "确定？"

# game/a15/6cold_arriv.rpy:816
translate english cold_arriv_elin_d83c08db:

    # elin "Д..."
    elin "是……"

# game/a15/6cold_arriv.rpy:817
translate english cold_arriv_elin_d2ee81dd:

    # me "Мнмннммм..."
    me "嗯嗯嗯嗯……"

# game/a15/6cold_arriv.rpy:818
translate english cold_arriv_elin_65d7caa6:

    # elin "Зкрлдвр?"
    elin "关门了吗？"

# game/a15/6cold_arriv.rpy:819
translate english cold_arriv_elin_66948067:

    # me "Мгм."
    me "嗯。"

# game/a15/6cold_arriv.rpy:822
translate english cold_arriv_elin_158df706:

    # elin "Помоги мне с платьем."
    elin "帮我脱裙子。"

# game/a15/6cold_arriv.rpy:823
translate english cold_arriv_elin_09f999ba:

    # me "Стой. Дай я сниму штаны."
    me "等等。让我先把裤子脱了。"

# game/a15/6cold_arriv.rpy:824
translate english cold_arriv_elin_55693d98:

    # elin "Сейчас..."
    elin "马上……"

# game/a15/6cold_arriv.rpy:825
translate english cold_arriv_elin_6a47b214:

    # me "Привстань немного."
    me "稍微抬起来点。"

# game/a15/6cold_arriv.rpy:826
translate english cold_arriv_elin_a447b008:

    # elin "Я вроде привстала."
    elin "我好像抬了。"

# game/a15/6cold_arriv.rpy:827
translate english cold_arriv_elin_9f7f7ea3:

    # me "Немного зацепилось."
    me "有点卡住了。"

# game/a15/6cold_arriv.rpy:828
translate english cold_arriv_elin_7f6777f1:

    # elin "Да... сейчас..."
    elin "对……等等……"

# game/a15/6cold_arriv.rpy:829
translate english cold_arriv_elin_9da17818:

    # me "Теперь ты."
    me "现在你了。"

# game/a15/6cold_arriv.rpy:830
translate english cold_arriv_elin_1649d076:

    # elin "Ага."
    elin "嗯。"

# game/a15/6cold_arriv.rpy:831
translate english cold_arriv_elin_1b2a7f38:

    # me "Спадает вниз..."
    me "滑下来了……"

# game/a15/6cold_arriv.rpy:832
translate english cold_arriv_elin_96b8ca2e:

    # elin "Сними его целиком."
    elin "整个脱掉。"

# game/a15/6cold_arriv.rpy:833
translate english cold_arriv_elin_959af475:

    # me "Тебе не будет холодно?"
    me "你不会冷吗？"

# game/a15/6cold_arriv.rpy:834
translate english cold_arriv_elin_e844d9b7:

    # elin "Уверена, что не будет. Через голову."
    elin "我确定不会。从头上脱。"

# game/a15/6cold_arriv.rpy:836
translate english cold_arriv_elin_ee3162a9:

    # elin "Все."
    elin "好了。"

# game/a15/6cold_arriv.rpy:837
translate english cold_arriv_elin_66a21e69:

    # me "Садись."
    me "坐下。"

# game/a15/6cold_arriv.rpy:839
translate english cold_arriv_elin_70e2c6b8:

    # elin "Ах... о боги... да..."
    elin "啊……哦天哪……对……"

# game/a15/6cold_arriv.rpy:840
translate english cold_arriv_elin_d6725d08:

    # me "Ты... стала фигуристее."
    me "你……身材更丰满了。"

# game/a15/6cold_arriv.rpy:841
translate english cold_arriv_elin_5fecc6f6:

    # elin "После родов немного набрала. Тебе тяжело?"
    elin "生完孩子后胖了一点。我太重吗？"

# game/a15/6cold_arriv.rpy:842
translate english cold_arriv_elin_ecfb2872:

    # me "Нет. Просто..."
    me "不。只是……"

# game/a15/6cold_arriv.rpy:843
translate english cold_arriv_elin_6d8ac354:

    # elin "Хочешь я лягу снизу?"
    elin "你想让我躺下面吗？"

# game/a15/6cold_arriv.rpy:844
translate english cold_arriv_elin_8b048ba9:

    # me "Нет... я..."
    me "不……我……"

# game/a15/6cold_arriv.rpy:845
translate english cold_arriv_elin_64eae4fd:

    # elin "Как тебе будет удобно."
    elin "随你舒服。"

# game/a15/6cold_arriv.rpy:846
translate english cold_arriv_elin_43012a3a:

    # me "Я просто хотел сказать тебе, что ты стала еще красивее, чем была."
    me "我只是想告诉你，你比以前更美了。"

# game/a15/6cold_arriv.rpy:847
translate english cold_arriv_elin_92d397c8_3:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:848
translate english cold_arriv_elin_aa004fcf:

    # elin "...докажи..."
    elin "……证明给我看……"

# game/a15/6cold_arriv.rpy:850
translate english cold_arriv_elin_4776a353:

    # elin "Ах..."
    elin "啊……"

# game/a15/6cold_arriv.rpy:851
translate english cold_arriv_elin_3820771a_10:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:852
translate english cold_arriv_elin_92d397c8_4:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:853
translate english cold_arriv_elin_2f1a732f:

    # me "...помедленнее?"
    me "……慢一点？"

# game/a15/6cold_arriv.rpy:854
translate english cold_arriv_elin_f236455f:

    # elin "Нет. Быстрее."
    elin "不。快一点。"

# game/a15/6cold_arriv.rpy:855
translate english cold_arriv_elin_ad067b58:

    # me "Быстрее?"
    me "快一点？"

# game/a15/6cold_arriv.rpy:856
translate english cold_arriv_elin_3877aca5_2:

    # elin "Да."
    elin "对。"

# game/a15/6cold_arriv.rpy:857
translate english cold_arriv_elin_97778ad0:

    # me "Мы уже делаем это так быстро, как это только возможно."
    me "我们已经尽可能快了。"

# game/a15/6cold_arriv.rpy:858
translate english cold_arriv_elin_3992c68d:

    # elin "Правда? Я? Я... я даже не заметила."
    elin "是吗？我？我……我都没注意到。"

# game/a15/6cold_arriv.rpy:859
translate english cold_arriv_elin_3820771a_11:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:860
translate english cold_arriv_elin_92d397c8_5:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:861
translate english cold_arriv_elin_d3737668:

    # me "У тебя грудь стала больше."
    me "你的胸变大了。"

# game/a15/6cold_arriv.rpy:862
translate english cold_arriv_elin_00977323:

    # elin "Не смотри."
    elin "别看。"

# game/a15/6cold_arriv.rpy:863
translate english cold_arriv_elin_3820771a_12:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:864
translate english cold_arriv_elin_352377ee:

    # elin "Ладно. Смотри если хочешь."
    elin "好吧。想看就看。"

# game/a15/6cold_arriv.rpy:865
translate english cold_arriv_elin_678888d7:

    # me "Знаешь, я бы смотрел, даже если бы ты мне не разрешила."
    me "你知道吗，就算你不许，我也会看。"

# game/a15/6cold_arriv.rpy:866
translate english cold_arriv_elin_402beac3:

    # elin "Я... я знаю... я знаю..."
    elin "我……我知道……我知道……"

# game/a15/6cold_arriv.rpy:868
translate english cold_arriv_elin_b0abdf75:

    # elin "[mename]?"
    elin "[mename]？"

# game/a15/6cold_arriv.rpy:869
translate english cold_arriv_elin_dfcceeac_1:

    # me "М?"
    me "嗯？"

# game/a15/6cold_arriv.rpy:870
translate english cold_arriv_elin_8354cb6c:

    # elin "По этому я тоже скучала."
    elin "这个我也想念。"

# game/a15/6cold_arriv.rpy:871
translate english cold_arriv_elin_3820771a_13:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:872
translate english cold_arriv_elin_92d397c8_6:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:873
translate english cold_arriv_elin_54aee577:

    # me "И я."
    me "我也是。"

# game/a15/6cold_arriv.rpy:874
translate english cold_arriv_elin_92d397c8_7:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:875
translate english cold_arriv_elin_3820771a_14:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:876
translate english cold_arriv_elin_d00b87b1:

    # elin "Ты...?"
    elin "你……？"

# game/a15/6cold_arriv.rpy:877
translate english cold_arriv_elin_798a57fe:

    # me "Да. Почти."
    me "对。快了。"

# game/a15/6cold_arriv.rpy:878
translate english cold_arriv_elin_906df245:

    # elin "Терпи."
    elin "忍住。"

# game/a15/6cold_arriv.rpy:879
translate english cold_arriv_elin_b6626098:

    # me "А?"
    me "啊？"

# game/a15/6cold_arriv.rpy:880
translate english cold_arriv_elin_58c2dff5:

    # elin "Терпи... я тоже почти. Мы должны сделать это одновременно."
    elin "忍住……我也快了。我们要一起。"

# game/a15/6cold_arriv.rpy:881
translate english cold_arriv_elin_741ea251:

    # me "Я не могу..."
    me "我忍不住……"

# game/a15/6cold_arriv.rpy:882
translate english cold_arriv_elin_b512046d:

    # elin "Терпи... терпи ради меня..."
    elin "忍住……为了我忍住……"

# game/a15/6cold_arriv.rpy:883
translate english cold_arriv_elin_3820771a_15:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:884
translate english cold_arriv_elin_92d397c8_8:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:885
translate english cold_arriv_elin_bbc9f7af:

    # me "Я..."
    me "我……"

# game/a15/6cold_arriv.rpy:886
translate english cold_arriv_elin_2f3c768e:

    # elin "Теперь и я."
    elin "现在我也到了。"

# game/a15/6cold_arriv.rpy:889
translate english cold_arriv_elin_5db6a96d:

    # elin "Ох..."
    elin "哦……"

# game/a15/6cold_arriv.rpy:890
translate english cold_arriv_elin_6866fe53:

    # me "Боги..."
    me "天哪……"

# game/a15/6cold_arriv.rpy:891
translate english cold_arriv_elin_d3ca51b3:

    # elin "Нам не стоило... но если боги... если боги проклинают за это... я готова быть проклятой."
    elin "我们不该……但如果神……如果神因此诅咒我们……我愿意被诅咒。"

# game/a15/6cold_arriv.rpy:892
translate english cold_arriv_elin_960e8283:

    # me "Ты передумала?"
    me "你改主意了？"

# game/a15/6cold_arriv.rpy:893
translate english cold_arriv_elin_beb24a46:

    # elin "Либо... либо это величайшее искушение, либо ты прав, и волю богов понять невозможно."
    elin "要么……要么这是最大的诱惑，要么你说得对，神的意志根本无法理解。"

# game/a15/6cold_arriv.rpy:895
translate english cold_arriv_elin_5cc1d282:

    # elin "А иначе это не было бы так приятно."
    elin "否则它不会这么让人舒服。"

# game/a15/6cold_arriv.rpy:896
translate english cold_arriv_elin_0454f9b7:

    # me "Вот именно."
    me "正是。"

# game/a15/6cold_arriv.rpy:897
translate english cold_arriv_elin_92d397c8_9:

    # elin "..."
    elin "……"

# game/a15/6cold_arriv.rpy:898
translate english cold_arriv_elin_db0aaa75:

    # me "У тебя выросла грудь."
    me "你的胸变大了。"

# game/a15/6cold_arriv.rpy:899
translate english cold_arriv_elin_01533f70:

    # elin "Ты уже говорил."
    elin "你已经说过了。"

# game/a15/6cold_arriv.rpy:900
translate english cold_arriv_elin_70ce29d0:

    # me "Я имею в виду... она прямо выросла-выросла."
    me "我是说……它真的变大了。"

# game/a15/6cold_arriv.rpy:901
translate english cold_arriv_elin_a8c0715a:

    # elin "Я вскармливаю ребенка. Ничего удивительного."
    elin "我在喂孩子。没什么奇怪的。"

# game/a15/6cold_arriv.rpy:902
translate english cold_arriv_elin_5f031b18:

    # me "Ага..."
    me "嗯……"

# game/a15/6cold_arriv.rpy:903
translate english cold_arriv_elin_0ef5f329:

    # elin "Тебе нравится моя грудь?"
    elin "你喜欢我的胸吗？"

# game/a15/6cold_arriv.rpy:904
translate english cold_arriv_elin_db05c9ef:

    # me "Ты нравишься мне целиком."
    me "我喜欢你的全部。"

# game/a15/6cold_arriv.rpy:905
translate english cold_arriv_elin_b2f52329:

    # elin "Она постоянно болит. Селина слишком мало ест."
    elin "它总是疼。塞琳娜吃得太少。"

# game/a15/6cold_arriv.rpy:906
translate english cold_arriv_elin_6a13a415:

    # me "Я могу иногда ее подменять."
    me "我有时可以替她。"

# game/a15/6cold_arriv.rpy:907
translate english cold_arriv_elin_e6317ee0:

    # elin "Фу, [mename], ты же шутишь, да?"
    elin "呸，[mename]，你在开玩笑，对吧？"

# game/a15/6cold_arriv.rpy:908
translate english cold_arriv_elin_595d7b8c:

    # me "Не знаю."
    me "不知道。"

# game/a15/6cold_arriv.rpy:909
translate english cold_arriv_elin_99f0eb69:

    # elin "...прекрати."
    elin "……别说了。"

# game/a15/6cold_arriv.rpy:910
translate english cold_arriv_elin_2a22090a:

    # me "Хех."
    me "嘿嘿。"

# game/a15/6cold_arriv.rpy:912
translate english cold_arriv_elin_3abe3566:

    # elin "Ох... совсем забыла. Локхарт просил проводить его у ворот замка."
    elin "哦……我差点忘了。洛克哈特让我在城堡门口送他。"

# game/a15/6cold_arriv.rpy:913
translate english cold_arriv_elin_25f7abbc:

    # me "Куда?"
    me "去哪儿？"

# game/a15/6cold_arriv.rpy:914
translate english cold_arriv_elin_e94a91a9:

    # elin "[lia]. У нее скоро свадьба. Локхарт хотел подарить ее жениху хорошую породистую лошадь."
    elin "[lia]。她快结婚了。洛克哈特想送她未婚夫一匹好种的马。"

# game/a15/6cold_arriv.rpy:916
translate english cold_arriv_elin_ad4e4694:

    # elin "С тех пор как Генри умер, отец задаривает Локхарта деньгами. А тот их тратит при любой возможности."
    elin "自从亨利死后，父亲就不断给洛克哈特钱。而他一有机会就花掉。"

# game/a15/6cold_arriv.rpy:918
translate english cold_arriv_elin_30406dd0:

    # elin "Генри присылает Локхарту деньги, а тот их все тратит при любой возможности."
    elin "亨利给洛克哈特寄钱，而他一有机会就全花掉。"

# game/a15/6cold_arriv.rpy:920
translate english cold_arriv_elin_862c186e:

    # elin "С тех пор, как Локхарт стал лордом - он сорит деньгами налево и направо."
    elin "自从洛克哈特成为领主后——他就到处挥霍钱财。"

# game/a15/6cold_arriv.rpy:922
translate english cold_arriv_elin_ad4e4694_1:

    # elin "С тех пор как Генри умер, отец задаривает Локхарта деньгами. А тот их тратит при любой возможности."
    elin "自从亨利死后，父亲就不断给洛克哈特钱。而他一有机会就花掉。"

# game/a15/6cold_arriv.rpy:923
translate english cold_arriv_elin_fa83cba3:

    # me "Он хотел купить лошадь в городе?"
    me "他想在城里买马？"

# game/a15/6cold_arriv.rpy:924
translate english cold_arriv_elin_a43aa29f:

    # elin "Нет. Где-то неподалеку есть заводчик. Или что-то вроде того. Локхарт должен был отъехать к нему сегодня в полночь."
    elin "不。附近有个育马人。或者类似的人。洛克哈特本该今天午夜出发去他那儿。"

# game/a15/6cold_arriv.rpy:925
translate english cold_arriv_elin_240f6113:

    # me "А ты должна была его проводить?"
    me "你本该去送他？"

# game/a15/6cold_arriv.rpy:926
translate english cold_arriv_elin_19753776:

    # elin "Он попросил меня и малышку попрощаться с ним у ворот. Но, полагаю, я уже опоздала."
    elin "他让我和宝宝在门口跟他道别。但我想我已经迟了。"

# game/a15/6cold_arriv.rpy:927
translate english cold_arriv_elin_3d9eed1a:

    # me "...он... он что-нибудь подозревает?"
    me "……他……他怀疑什么吗？"

# game/a15/6cold_arriv.rpy:928
translate english cold_arriv_elin_f3b32b69:

    # elin "Нет. И это хуже всего."
    elin "不。而这才是最糟的。"

# game/a15/6cold_arriv.rpy:929
translate english cold_arriv_elin_3642f725:

    # me "Почему это?"
    me "为什么？"

# game/a15/6cold_arriv.rpy:930
translate english cold_arriv_elin_5bb48cea:

    # elin "Потому что он поддерживает меня. Говорит, что любит меня и дочь. Сказал попробует привезти какого-то врача с Запада."
    elin "因为他支持我。他说他爱我和女儿。他说会试着从西方请个医生来。"

# game/a15/6cold_arriv.rpy:931
translate english cold_arriv_elin_3820771a_16:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:932
translate english cold_arriv_elin_9ad6bfa3:

    # elin "Понимаешь, да? Если бы он подозревал... мне было бы проще. А так... мне больно находиться рядом с ним. Я чувствую себя конченой сукой."
    elin "你明白吧？如果他怀疑……我反而会好受些。可现在……待在他身边让我痛苦。我觉得自己是个彻头彻尾的婊子。"

# game/a15/6cold_arriv.rpy:933
translate english cold_arriv_elin_3820771a_17:

    # me "..."
    me "……"

# game/a15/6cold_arriv.rpy:934
translate english cold_arriv_elin_98df397d:

    # elin "Может ты смог бы сводить его куда-нибудь... не знаю... в бордель? Или что-то вроде того."
    elin "也许你能带他去什么地方……我不知道……妓院？或者类似的地方。"

# game/a15/6cold_arriv.rpy:935
translate english cold_arriv_elin_e016818b:

    # me "В бордель?"
    me "妓院？"

# game/a15/6cold_arriv.rpy:936
translate english cold_arriv_elin_04dc06e2:

    # elin "Или познакомь с какой-нибудь... голодной до золота одинокой аристократкой."
    elin "或者介绍他认识某个……贪金子又孤独的女贵族。"

# game/a15/6cold_arriv.rpy:937
translate english cold_arriv_elin_06a75e20:

    # me "Ты хочешь чтобы он завел любовницу? Тебе станет от этого легче?"
    me "你想让他找个情妇？这能让你好受点？"

# game/a15/6cold_arriv.rpy:938
translate english cold_arriv_elin_1259f7f4:

    # elin "Да. Не знаю... наверно? Наверное мне будет легче, если он будет изменять мне, так же как я изменяю ему."
    elin "对。不知道……也许吧？也许如果他像我不忠一样对我不忠，我会好受些。"

# game/a15/6cold_arriv.rpy:939
translate english cold_arriv_elin_10271be4:

    # me "...я подумаю, что можно сделать."
    me "……我会想想能做什么。"

# game/a15/6cold_arriv.rpy:941
translate english cold_arriv_elin_95be78e7:

    # elin "Ты... ты слышишь?"
    elin "你……你听到了吗？"

# game/a15/6cold_arriv.rpy:942
translate english cold_arriv_elin_22b39c78:

    # me "Она плачет?"
    me "她在哭？"

# game/a15/6cold_arriv.rpy:943
translate english cold_arriv_elin_93c2c65a:

    # elin "О боги... у нее все же есть голос."
    elin "哦天哪……她终于有声音了。"

# game/a15/6cold_arriv.rpy:944
translate english cold_arriv_elin_adec2cf5:

    # me "Неужели это действительно ее первый раз?"
    me "这真的是她第一次吗？"

# game/a15/6cold_arriv.rpy:945
translate english cold_arriv_elin_5d684d32:

    # elin "Первый! Я не отходила от нее почти никогда. Она всегда молчала."
    elin "第一次！我几乎从没离开过她。她一直都很安静。"

# game/a15/6cold_arriv.rpy:946
translate english cold_arriv_elin_d53027e5:

    # me "Думаешь... это из-за нас?"
    me "你觉得……是因为我们吗？"

# game/a15/6cold_arriv.rpy:947
translate english cold_arriv_elin_f6abb281:

    # elin "А?"
    elin "啊？"

# game/a15/6cold_arriv.rpy:948
translate english cold_arriv_elin_eee598ff:

    # me "Может она услышала твой голос и подумала, что тебе не хорошо, а плохо."
    me "也许她听到你的声音，以为你不舒服——以为你痛苦。"

# game/a15/6cold_arriv.rpy:949
translate english cold_arriv_elin_976a0a82:

    # elin "О боги... как же я рада."
    elin "哦天哪……我太高兴了。"

# game/a15/6cold_arriv.rpy:951
translate english cold_arriv_elin_a0f0f9ad:

    # elin "Никогда не думала, что буду радоваться слезам и крикам моей дочери."
    elin "我从没想过会为女儿的眼泪和哭声高兴。"

# game/a15/6cold_arriv.rpy:952
translate english cold_arriv_elin_f7ed4027:

    # me "Я тоже."
    me "我也是。"

# game/a15/6cold_arriv.rpy:953
translate english cold_arriv_elin_0331ac09:

    # elin "Думаешь это... действительно из-за того, что мы..."
    elin "你觉得这……真的因为我们在……"

# game/a15/6cold_arriv.rpy:954
translate english cold_arriv_elin_972655f4:

    # me "Забавная история."
    me "真是个有趣的故事。"

# game/a15/6cold_arriv.rpy:955
translate english cold_arriv_elin_27d991d2:

    # elin "Но ей лучше ее не рассказывать. 'Знаешь, милая, ты так долго молчала, что мы думали, что ты глухонемая, а потом я и твой... дядя...'"
    elin "但最好别讲给她听。‘你知道吗，亲爱的，你沉默太久，我们都以为你又聋又哑，然后我和你……叔叔……’"

# game/a15/6cold_arriv.rpy:956
translate english cold_arriv_elin_acbbd157:

    # me "Может ты просто впервые так далеко и надолго от нее отошла."
    me "也许你只是第一次离开她这么远、这么久。"

# game/a15/6cold_arriv.rpy:957
translate english cold_arriv_elin_c1ec1dab:

    # elin "Ну... может и так. [mename], мне... нужно ее проведать. Наши теории конечно красивые, но вдруг она впервые заплакала, потому что у нее что-то болит."
    elin "嗯……也许吧。[mename]，我……得去看看她。我们的理论当然好听，但万一她第一次哭是因为哪里疼呢。"

# game/a15/6cold_arriv.rpy:958
translate english cold_arriv_elin_302ff505:

    # me "Да. Конечно. Тем более мне пора."
    me "对。当然。而且我也该走了。"

# game/a15/6cold_arriv.rpy:959
translate english cold_arriv_elin_dfee36ae:

    # elin "Не уходи."
    elin "别走。"

# game/a15/6cold_arriv.rpy:960
translate english cold_arriv_elin_eac71f4c:

    # me "Если нас обоих долго не будет по ночам в наших покоях..."
    me "如果我们两人夜里都长时间不在各自房里……"

# game/a15/6cold_arriv.rpy:961
translate english cold_arriv_elin_30ca0f2a:

    # elin "Ладно. Ты прав. Увидимся завтра."
    elin "好吧。你说得对。明天见。"

# game/a15/6cold_arriv.rpy:962
translate english cold_arriv_elin_146049ff:

    # me "До завтра, [elin]."
    me "明天见，[elin]。"

translate english strings:

    # game/a15/6cold_arriv.rpy:237
    old "Уединиться с ней"
    new "与她独处"

    # game/a15/6cold_arriv.rpy:406
    old "Рассказать ей об отце всю правду."
    new "把关于她父亲的真相全告诉她。"

    # game/a15/6cold_arriv.rpy:406
    old "Не говорить ей ничего."
    new "什么都不告诉她。"

    # game/a15/6cold_arriv.rpy:442
    old "Утешить ее"
    new "安慰她"

    # game/a15/6cold_arriv.rpy:442
    old "Не утешать ее"
    new "不安慰她"

