    # guardia "{size=+9}СЕВЕР НАШ! УРА!{/size}"
    guardia "{size=+9}北方是我们的！乌拉！{/size}"

# game/a15/5little_homeland.rpy:71
translate english little_homeland_d515b4e2:

    # guardia "{size=+9}ЗА ИМПЕРИЮ!{/size}"
    guardia "{size=+9}为了帝国！{/size}"

# game/a15/5little_homeland.rpy:73
translate english little_homeland_ade1606d:

    # guardia "{size=+9}НА ЮГ! НА ЮГ! НА ЮГ!{/size}"
    guardia "{size=+9}去南方！去南方！去南方！{/size}"

# game/a15/5little_homeland.rpy:75
translate english little_homeland_3e781517:

    # guardia "{size=+9}ДА БУДЕТ ВОЛЯ ЖЕЛЕЗОМ!{/size}"
    guardia "{size=+9}愿意志如铁！{/size}"

# game/a15/5little_homeland.rpy:77
translate english little_homeland_f2a72cc4:

    # guardia "{size=+9}ЗОЛОТОЙ ПОРЯДОК ВЕЧЕН!{/size}"
    guardia "{size=+9}黄金秩序永存！{/size}"
