# TODO: Translation updated at 2026-08-26 02:04

# game/a15/5little_homeland.rpy:3
translate english little_homeland_adb20273:

    # "День спустя."
    "一天后。"

# game/a15/5little_homeland.rpy:4
translate english little_homeland_c558c113:

    # harold "...вы уверены, что это была хорошая идея?"
    harold "……您确定这是个好主意吗？"

# game/a15/5little_homeland.rpy:5
translate english little_homeland_5841d258:

    # me "Не уверен. Но оставаться на Севере на целую зиму я не хочу."
    me "不确定。但我不想在北方待一整个冬天。"

# game/a15/5little_homeland.rpy:6
translate english little_homeland_ec35b7d3:

    # harold "И все же... условия неблагоприятны."
    harold "不过……条件不太有利。"

# game/a15/5little_homeland.rpy:7
translate english little_homeland_692373f4:

    # me "Холод меня не сильно страшит."
    me "寒冷不太吓得到我。"

# game/a15/5little_homeland.rpy:8
translate english little_homeland_da4f45e9:

    # harold "Думаю у лошади под вами другое мнение."
    harold "我想您胯下的马另有看法。"

# game/a15/5little_homeland.rpy:9
translate english little_homeland_ba98f422:

    # me "Я не принимаю решения с учетом голоса от ездовой скотины."
    me "我不会根据坐骑牲口的意见做决定。"

# game/a15/5little_homeland.rpy:10
translate english little_homeland_8279a93f:

    # harold "..."
    harold "……"

# game/a15/5little_homeland.rpy:11
translate english little_homeland_5823b439:

    # me "Мы ведь будем делать остановки в городах."
    me "我们会在城里停留的。"

# game/a15/5little_homeland.rpy:12
translate english little_homeland_f39bb2a6:

    # harold "В этом и беда. В свободных городах бушует болотная чума."
    harold "问题就在这里。自由城市里沼泽瘟疫正在肆虐。"

# game/a15/5little_homeland.rpy:13
translate english little_homeland_683c58f1:

    # me "Холод убивает эпидемии."
    me "寒冷能杀死瘟疫。"

# game/a15/5little_homeland.rpy:15
translate english little_homeland_833c0e40:

    # harold "Чем южнее мы будем - тем будет теплее. Я думаю в Бригдоке еще даже не выпал снег."
    harold "我们越往南——就越暖和。我想布里格多克甚至还没下雪。"

# game/a15/5little_homeland.rpy:16
translate english little_homeland_386f72b3:

    # me "Значит не будем спешить. Пусть зима следует за нами по пятам."
    me "那我们就不急。让冬天跟在我们后头吧。"

# game/a15/5little_homeland.rpy:17
translate english little_homeland_5e20224c:

    # harold "Воздуху нужно дать как следует промерзнуть, чтобы он убил заразу."
    harold "空气得彻底冻透，才能杀死病菌。"

# game/a15/5little_homeland.rpy:18
translate english little_homeland_c6944678:

    # me "Что ты хочешь Гарольд? Мне вернуться и подождать месяцок?"
    me "你想怎样，哈罗德？让我回去等一个月？"

# game/a15/5little_homeland.rpy:19
translate english little_homeland_895db8d5:

    # harold "Разумнее будет миновать большие города и останавливаться в деревнях."
    harold "更明智的做法是绕过大城市，在村庄停留。"

# game/a15/5little_homeland.rpy:20
translate english little_homeland_cfa53d36:

    # me "Это затянет путь назад на добрую неделю."
    me "那回去的路要拖长整整一周。"

# game/a15/5little_homeland.rpy:21
translate english little_homeland_8279a93f_1:

    # harold "..."
    harold "……"

# game/a15/5little_homeland.rpy:22
translate english little_homeland_0cb60981:

    # me "Ладно. Ты прав. Не будем рисковать."
    me "好吧。你说得对。我们不冒险。"

# game/a15/5little_homeland.rpy:23
translate english little_homeland_c526873a:

    # harold "Разумное решение, мой принц."
    harold "明智的决定，我的王子。"

# game/a15/5little_homeland.rpy:24
translate english little_homeland_3820771a:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:25
translate english little_homeland_1551afb4:

    # harold "Мой принц, могу я спросить?"
    harold "我的王子，我能问一句吗？"

# game/a15/5little_homeland.rpy:26
translate english little_homeland_cd917d11:

    # me "Давай."
    me "问吧。"

# game/a15/5little_homeland.rpy:27
translate english little_homeland_51e5f974:

    # harold "Ваши люди интересуются... спрашивают о результатах нашей... дипломатической поездки."
    harold "您的人很好奇……在问我们这次……外交之行的结果。"

# game/a15/5little_homeland.rpy:28
translate english little_homeland_f03a2ee6:

    # me "И что они хотят знать?"
    me "他们想知道什么？"

# game/a15/5little_homeland.rpy:29
translate english little_homeland_05ccfdcc:

    # harold "Мы добились успеха?"
    harold "我们成功了吗？"

# game/a15/5little_homeland.rpy:32
translate english little_homeland_93217aeb:

    # me "Знаешь, Гарольд, я тоже хочу спросить у тебя кое-что."
    me "你知道吗，哈罗德，我也想问你点事。"

# game/a15/5little_homeland.rpy:33
translate english little_homeland_83be4cca:

    # harold "Конечно, мой принц."
    harold "当然，我的王子。"

# game/a15/5little_homeland.rpy:34
translate english little_homeland_86bdfb1b:

    # me "Ты бы продал свой меч?"
    me "你会卖掉你的剑吗？"

# game/a15/5little_homeland.rpy:35
translate english little_homeland_7c96c10f:

    # harold "Продал? Кому?"
    harold "卖掉？卖给谁？"

# game/a15/5little_homeland.rpy:36
translate english little_homeland_b834d1fc:

    # me "Представь, что не сопровождаешь меня, а идешь в столицу один. По пути тебе встречается странствующий торговец."
    me "想象一下，你不是在护送我，而是一个人前往首都。路上遇到一个流浪商人。"

# game/a15/5little_homeland.rpy:37
translate english little_homeland_3e06a657:

    # me "Ты платишь ему пару монет и он дает тебе пищу. А потом замечает твой меч. Он предлагает тебе за него сто платиновых солнц."
    me "你给他几枚硬币，他给你食物。然后他注意到你的剑。他出价一百枚白金太阳买它。"

# game/a15/5little_homeland.rpy:38
translate english little_homeland_000c8c9a:

    # harold "Сто? Он столько не стоит."
    harold "一百？它不值那么多。"

# game/a15/5little_homeland.rpy:39
translate english little_homeland_2ae72267:

    # me "Но именно столько он и предлагает."
    me "但他出的就是这个价。"

# game/a15/5little_homeland.rpy:40
translate english little_homeland_8279a93f_2:

    # harold "..."
    harold "……"

# game/a15/5little_homeland.rpy:41
translate english little_homeland_a652bdbf:

    # me "Ну? Ты бы продал ему свой меч?"
    me "怎么样？你会把剑卖给他吗？"

# game/a15/5little_homeland.rpy:42
translate english little_homeland_884b6ed2:

    # harold "Нет."
    harold "不会。"

# game/a15/5little_homeland.rpy:43
translate english little_homeland_c4dfb201:

    # me "Почему же?"
    me "为什么？"

# game/a15/5little_homeland.rpy:44
translate english little_homeland_7af35fdb:

    # harold "Здесь что-то не чисто. Меч столько не стоит."
    harold "这里面有鬼。剑不值那么多。"

# game/a15/5little_homeland.rpy:45
translate english little_homeland_e45643e0:

    # me "И все же он предлагает именно столько."
    me "可他出的就是这个价。"

# game/a15/5little_homeland.rpy:46
translate english little_homeland_8279a93f_3:

    # harold "..."
    harold "……"

# game/a15/5little_homeland.rpy:47
translate english little_homeland_e5e99356:

    # harold "Нет, не продал бы. Зачем торговцу мой меч? Разве что он хочет обезоружить меня."
    harold "不，不会卖。商人要我的剑做什么？除非他想让我手无寸铁。"

# game/a15/5little_homeland.rpy:48
translate english little_homeland_f5e82974:

    # me "Вот и я не доверяю блеску золота. Даже если это блеск тысячи платиновых солнц... или даже блеск короны."
    me "我也不信任黄金的光泽。即使那是一千枚白金太阳的光泽……甚至是王冠的光泽。"

# game/a15/5little_homeland.rpy:49
translate english little_homeland_1db7434e:

    # me "Я предпочту остаться со своим мечом."
    me "我宁愿留着自己的剑。"

# game/a15/5little_homeland.rpy:52
translate english little_homeland_39bdc11f:

    # me "Ну... как тебе сказать."
    me "嗯……怎么说呢。"

# game/a15/5little_homeland.rpy:53
translate english little_homeland_9c4effee:

    # harold "Скажите как есть, мой принц. Ваши люди шли за вами вслепую на край мира. Мы не задавали вопросов. Просто исполняли свой долг."
    harold "照实说吧，我的王子。您的人盲目跟着您走到世界尽头。我们没问问题。只是履行自己的职责。"

# game/a15/5little_homeland.rpy:54
translate english little_homeland_28bec15b:

    # harold "Вы не обязаны, конечно. Наша служба - наша честь. "
    harold "当然，您不必如此。我们的服役就是我们的荣誉。"

# game/a15/5little_homeland.rpy:55
translate english little_homeland_4c315891:

    # harold "И все же мы бы были благодарны, если наш принц рассказал нам, ради чего все это было."
    harold "不过如果我们的王子能告诉我们这一切是为了什么，我们会很感激。"

# game/a15/5little_homeland.rpy:56
translate english little_homeland_7e39490b:

    # me "Знаешь... рассказывать все в подробностях было бы слишком долго."
    me "你知道……详细讲一切会太长了。"

# game/a15/5little_homeland.rpy:57
translate english little_homeland_5c53bc09:

    # harold "...понимаю, мой принц."
    harold "……我明白，我的王子。"

# game/a15/5little_homeland.rpy:58
translate english little_homeland_7315174b:

    # me "Проще будет показать.."
    me "直接展示更简单……"

# game/a15/5little_homeland.rpy:60
translate english little_homeland_a2dee1f3:

    # me "{size=+4}СЕВЕР НАШ, БРАТЬЯ!{/size}"
    me "{size=+4}北方是我们的，兄弟们！{/size}"

# game/a15/5little_homeland.rpy:61
translate english little_homeland_f58107f8:

    # guardsy "{size=+9}СЕВЕР НАШ! УРА!{/size}"
    guardsy "{size=+9}北方是我们的！乌拉！{/size}"

# game/a15/5little_homeland.rpy:62
translate english little_homeland_35bb0cb8:

    # me "{size=+4}ДА ЗДРАВСТВУЕТ ВОЗРОЖДЕННАЯ ИМПЕРИЯ!{/size}"
    me "{size=+4}重生帝国万岁！{/size}"

# game/a15/5little_homeland.rpy:63
translate english little_homeland_0096802e:

    # guardsy "{size=+9}ЗА ИМПЕРИЮ!{/size}"
    guardsy "{size=+9}为了帝国！{/size}"

# game/a15/5little_homeland.rpy:64
translate english little_homeland_0c992723:

    # me "{size=+4}ОСТАЛСЯ ТОЛЬКО ЮГ!{/size}"
    me "{size=+4}只剩下南方了！{/size}"

# game/a15/5little_homeland.rpy:65
translate english little_homeland_3077bb98:

    # guardsy "{size=+9}НА ЮГ! НА ЮГ! НА ЮГ!{/size}"
    guardsy "{size=+9}去南方！去南方！去南方！{/size}"

# game/a15/5little_homeland.rpy:66
translate english little_homeland_aedd155f:

    # me "{size=+4}Да будет моя воля и воля моего отца Железом.{/size}"
    me "{size=+4}愿我的意志和我父亲的意志如铁。{/size}"

# game/a15/5little_homeland.rpy:67
translate english little_homeland_d589432e:

    # guardsy "{size=+9}ДА БУДЕТ ВОЛЯ ЖЕЛЕЗОМ!{/size}"
    guardsy "{size=+9}愿意志如铁！{/size}"

# game/a15/5little_homeland.rpy:68
translate english little_homeland_fb57c1f3:

    # me "{size=+4}Пусть Золотой Порядок будет вечен!{/size}"
    me "{size=+4}愿黄金秩序永存！{/size}"

# game/a15/5little_homeland.rpy:69
translate english little_homeland_b7d60ba7:

    # guardsy "{size=+9}ЗОЛОТОЙ ПОРЯДОК ВЕЧЕН!{/size}"
    guardsy "{size=+9}黄金秩序永存！{/size}"

# game/a15/5little_homeland.rpy:71
translate english little_homeland_24b271ca:

    # "Неделю спустя."
    "一周后。"

# game/a15/5little_homeland.rpy:72
translate english little_homeland_b34f6316:

    # harold "...не стоило нам сюда ехать."
    harold "……我们不该来这儿。"

# game/a15/5little_homeland.rpy:73
translate english little_homeland_c99cf242:

    # me "Я просто хочу посмотреть."
    me "我只是想看看。"

# game/a15/5little_homeland.rpy:74
translate english little_homeland_8c560333:

    # harold "Опасно это. Очень."
    harold "这很危险。非常危险。"

# game/a15/5little_homeland.rpy:75
translate english little_homeland_6e85ef17:

    # me "Всего на час-другой и мы тут же уедем."
    me "就一两个小时，我们马上就走。"

# game/a15/5little_homeland.rpy:76
translate english little_homeland_99b68861:

    # harold "...припасы здесь лучше не покупать."
    harold "……最好别在这儿买补给。"

# game/a15/5little_homeland.rpy:77
translate english little_homeland_07e93b97:

    # me "Нет. Конечно. Само собой разумеется."
    me "不。当然。这是自然。"

# game/a15/5little_homeland.rpy:78
translate english little_homeland_68e25fb5:

    # lace "Ну и вонь здесь."
    lace "天哪，这里真臭。"

# game/a15/5little_homeland.rpy:79
translate english little_homeland_1e7aece0:

    # harold "Так пахнет чумной город."
    harold "瘟疫城市就是这个味道。"

# game/a15/5little_homeland.rpy:80
translate english little_homeland_6aedce7d:

    # me "Ни то что ни одного стражника... на улице не единого живого человека... это место легко захватить..."
    me "不仅没有一个守卫……街上连一个活人都没有……这地方很容易攻下……"

# game/a15/5little_homeland.rpy:81
translate english little_homeland_5ed0e706:

    # harold "Приведете сюда армию и через неделю она вся перемрет."
    harold "您把军队带来，一周后就会全死光。"

# game/a15/5little_homeland.rpy:82
translate english little_homeland_3820771a_1:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:83
translate english little_homeland_d04de178:

    # harold "Видели небо? Кажется и тут скоро все заметет снегом."
    harold "看到天了吗？看来这里很快也会被雪埋住。"

# game/a15/5little_homeland.rpy:85
translate english little_homeland_7e1c392b:

    # me "Думаю местные были бы не против. Снег за окном точно лучше трупов в мешках. Почему их не убирают?"
    me "我想本地人不会反对。窗外的雪总比袋子里的尸体好。为什么不清理它们？"

# game/a15/5little_homeland.rpy:86
translate english little_homeland_03e3a5a8:

    # harold "Наверное они бояться подхватить чуму."
    harold "大概是怕染上瘟疫。"

# game/a15/5little_homeland.rpy:87
translate english little_homeland_f905dc61:

    # me "Но кто-то же засовывает их в мешки."
    me "但总有人把它们塞进袋子里。"

# game/a15/5little_homeland.rpy:88
translate english little_homeland_c4b1ac33:

    # harold "Наверное их семьи. Прячут тело в мешок и выставляют за порог, чтобы тело не гнило в доме."
    harold "大概是他们的家人。把尸体装进袋子放到门外，免得在屋里腐烂。"

# game/a15/5little_homeland.rpy:89
translate english little_homeland_8a7d6e0a:

    # me "А что толку? Весь город пропах трупятиной. Если они не хотят их закапывать - пусть хотя бы сожгут."
    me "有什么用？整座城都是尸臭味。如果他们不想埋——至少烧掉吧。"

# game/a15/5little_homeland.rpy:90
translate english little_homeland_bb80c39f:

    # harold "Значит это некому делать. Болезнь не приходит одна. С ней об руку идет голод. Кормилец умирает и вот уже остальные взрослые в семье вынуждены рвать спину вдвое больше."
    harold "那就是没人能做。疾病从不单独来。饥饿与它携手同行。养家的人死了，家里其他成年人就得加倍拼命。"

# game/a15/5little_homeland.rpy:91
translate english little_homeland_3820771a_2:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:92
translate english little_homeland_e6428239:

    # harold "Думаю о достойных похоронах нет смысла думать, когда ты и сам недалеко от смерти."
    harold "我想当自己也离死不远时，就谈不上什么体面葬礼了。"

# game/a15/5little_homeland.rpy:93
translate english little_homeland_beb30a2a:

    # me "Но ведь это распространяет болезнь."
    me "但这会传播疾病。"

# game/a15/5little_homeland.rpy:94
translate english little_homeland_3e66e623:

    # harold "Эпидемия это замкнутый цикл. Пока болезнь не отступит сама - что бы ты не делал, это будет ей только помогать. Прикажешь сжигать трупы и те кто будут их таскать заразятся."
    harold "瘟疫是个闭环。除非疾病自行退去，否则你做什么都只会助长它。你下令烧尸体，搬尸体的人就会感染。"

# game/a15/5little_homeland.rpy:95
translate english little_homeland_7e09cf32:

    # me "А если изолировать больных?"
    me "那隔离病人呢？"

# game/a15/5little_homeland.rpy:96
translate english little_homeland_11c90f68:

    # harold "А кто это будет делать?"
    harold "谁来做？"

# game/a15/5little_homeland.rpy:97
translate english little_homeland_ac90c9ad:

    # me "Стражники."
    me "守卫。"

# game/a15/5little_homeland.rpy:98
translate english little_homeland_d8040498:

    # harold "А они не заразятся? К тому же всех больных еще надо найти."
    harold "他们不会感染吗？而且还得找出所有病人。"

# game/a15/5little_homeland.rpy:99
translate english little_homeland_d77aa56e:

    # lace "А если сам стражник заболеет?"
    lace "那如果守卫自己病了呢？"

# game/a15/5little_homeland.rpy:100
translate english little_homeland_e5080aca:

    # me "Будет ходить от дома к дому и заражать всех остальных."
    me "他会挨家挨户走，把其他人全传染。"

# game/a15/5little_homeland.rpy:101
translate english little_homeland_8c1560a6:

    # harold "Вот именно."
    harold "正是如此。"

# game/a15/5little_homeland.rpy:102
translate english little_homeland_59cc6aa7:

    # me "Да уж... печально все это."
    me "是啊……这一切真令人悲哀。"

# game/a15/5little_homeland.rpy:103
translate english little_homeland_094a0f73:

    # harold "Чума... убийца городов."
    harold "瘟疫……城市的杀手。"

# game/a15/5little_homeland.rpy:105
translate english little_homeland_59ecf78c:

    # me "Сколько же здесь крыс."
    me "这里老鼠真多。"

# game/a15/5little_homeland.rpy:106
translate english little_homeland_584f59a1:

    # lace "Мой отец был лекарем. Говорил, что крысы и есть причина чумы."
    lace "我父亲是医生。他说老鼠就是瘟疫的源头。"

# game/a15/5little_homeland.rpy:107
translate english little_homeland_2dca60ac:

    # me "Не похоже, что они больны."
    me "看起来它们没病。"

# game/a15/5little_homeland.rpy:108
translate english little_homeland_12277fa3:

    # lace "Крысы носят болезнь в себе."
    lace "老鼠把病带在身上。"

# game/a15/5little_homeland.rpy:109
translate english little_homeland_b7ef29ef:

    # me "А сами не болеют? Как такое возможно?"
    me "它们自己不生病？怎么可能？"

# game/a15/5little_homeland.rpy:110
translate english little_homeland_027843a0:

    # harold "Мне кажется, что болеют. Просто размножаются быстрее, чем дохнут."
    harold "我觉得它们也会病。只是繁殖得比死得快。"

# game/a15/5little_homeland.rpy:111
translate english little_homeland_a58ac4d1:

    # lace "Может и так."
    lace "也许吧。"

# game/a15/5little_homeland.rpy:112
translate english little_homeland_dfacee5f:

    # me "Не зря они назвали эту чуму болотной. Видимо она пришла с топей на западе."
    me "他们把这场瘟疫叫沼泽瘟疫不是没道理。看来是从西边的沼泽来的。"

# game/a15/5little_homeland.rpy:113
translate english little_homeland_4549f6d4:

    # lace "Говорят у зараженных пахнет трясиной изо рта."
    lace "据说感染者嘴里有沼泽味。"

# game/a15/5little_homeland.rpy:114
translate english little_homeland_a6627e7f:

    # harold "Да ну? Правда?"
    harold "真的？当真？"

# game/a15/5little_homeland.rpy:115
translate english little_homeland_3638b4bc:

    # me "Проверять как-то не хочется."
    me "不太想去验证。"

# game/a15/5little_homeland.rpy:117
translate english little_homeland_4023cfae:

    # me "Подумать только, сколько же тут трупов. Я даже не знал, что в этом городе жило столько людей."
    me "想想看，这里尸体真多。我甚至不知道这城里住过这么多人。"

# game/a15/5little_homeland.rpy:118
translate english little_homeland_b45ad459:

    # harold "Моя мать говорила, что болезни есть божье наказание. За непочтительность к предкам."
    harold "我母亲说疾病是神的惩罚。因为不敬祖先。"

# game/a15/5little_homeland.rpy:119
translate english little_homeland_c45f94a6:

    # me "А ты сам как думаешь?"
    me "你自己怎么看？"

# game/a15/5little_homeland.rpy:120
translate english little_homeland_a97166d7:

    # harold "Не знаю. Но болезнь это единственное чего стоит бояться в этом мире. От чумы не защититься ни острым мечом, ни острым умом. Чуме плевать, рыцарь ты, король или торговец рыбой."
    harold "不知道。但疾病是这世上唯一真正值得害怕的东西。瘟疫既挡不住利剑，也挡不住聪慧。瘟疫不在乎你是骑士、国王还是鱼贩。"

# game/a15/5little_homeland.rpy:121
translate english little_homeland_fe77f9b7:

    # me "Кем бы ты ни был, ты умрешь... медленно и мучительно."
    me "无论你是谁，都会死……缓慢而痛苦。"

# game/a15/5little_homeland.rpy:122
translate english little_homeland_ac057625:

    # harold "Все так..."
    harold "确实如此……"

# game/a15/5little_homeland.rpy:123
translate english little_homeland_3820771a_3:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:124
translate english little_homeland_8279a93f_4:

    # harold "..."
    harold "……"

# game/a15/5little_homeland.rpy:125
translate english little_homeland_f1df6b20:

    # me "Думаю они только рады будут, если мы предложим им помощь в обмен на вхождение в Империю."
    me "我想如果我们以援助换取加入帝国，他们只会高兴。"

# game/a15/5little_homeland.rpy:126
translate english little_homeland_8e18a492:

    # harold "Свободные города?"
    harold "自由城市？"

# game/a15/5little_homeland.rpy:127
translate english little_homeland_8ba9bfca:

    # me "Да. Если даже Бригдок в таком запустении, то боюсь представить, что творится в городах побольше."
    me "对。如果连布里格多克都这么荒废，我不敢想象更大的城市是什么样。"

# game/a15/5little_homeland.rpy:128
translate english little_homeland_b6bf8184:

    # harold "Я бы все-таки подождал."
    harold "我还是会等一等。"

# game/a15/5little_homeland.rpy:129
translate english little_homeland_26cfa2f5:

    # me "Не волнуйся. Я не собираюсь рисковать своими людьми. Пусть пройдет зима. Как только снег сойдет и болезнь исчезнет - это место снова станет имперской землей."
    me "别担心。我不打算拿我的人冒险。等冬天过去。雪一化、病一消——这地方就会重新成为帝国的土地。"

# game/a15/5little_homeland.rpy:130
translate english little_homeland_3d7bd6b7:

    # harold "Если болезнь исчезнет после зимы."
    harold "如果冬天过后病能消失的话。"

# game/a15/5little_homeland.rpy:131
translate english little_homeland_8936bd21:

    # me "Посмотри вокруг - тут больше некому умирать."
    me "看看四周——这里已经没人可死了。"

# game/a15/5little_homeland.rpy:132
translate english little_homeland_8279a93f_5:

    # harold "..."
    harold "……"

# game/a15/5little_homeland.rpy:133
translate english little_homeland_3820771a_4:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:134
translate english little_homeland_10e289c5:

    # harold "Можем возвращаться?"
    harold "我们可以回去了吗？"

# game/a15/5little_homeland.rpy:135
translate english little_homeland_81eb9efd:

    # me "Да. Только заедем в одно место."
    me "好。不过再去一个地方。"

# game/a15/5little_homeland.rpy:136
translate english little_homeland_e3187a78:

    # harold "В какое?"
    harold "哪儿？"

# game/a15/5little_homeland.rpy:139
translate english little_homeland_fc7d3a18:

    # "Пару минут спустя."
    "几分钟后。"

# game/a15/5little_homeland.rpy:140
translate english little_homeland_95efcfe1:

    # me "Эй!"
    me "嘿！"

# game/a15/5little_homeland.rpy:141
translate english little_homeland_2d3813ef:

    # me "Открывай. Веснушка!"
    me "开门。雀斑姑娘！"

# game/a15/5little_homeland.rpy:142
translate english little_homeland_37393640:

    # me "Это я. Принц [mename]."
    me "是我。[mename]王子。"

# game/a15/5little_homeland.rpy:143
translate english little_homeland_577cae76:

    # me "Открой дверь."
    me "开门。"

# game/a15/5little_homeland.rpy:144
translate english little_homeland_5bf7364e:

    # me "{size=+4}Там вообще кто-нибудь есть?{/size}"
    me "{size=+4}里面到底有人吗？{/size}"

# game/a15/5little_homeland.rpy:145
translate english little_homeland_327b05c1:

    # me "{size=+4}ЭЙ! КТО-НИБУДЬ!{/size}"
    me "{size=+4}喂！有人吗！{/size}"

# game/a15/5little_homeland.rpy:146
translate english little_homeland_c7244919:

    # me "{size=+4}Вы меня слышите?{/size}"
    me "{size=+4}你们能听见我吗？{/size}"

# game/a15/5little_homeland.rpy:147
translate english little_homeland_9739b1d1:

    # me "Твою мать..."
    me "妈的……"

# game/a15/5little_homeland.rpy:150
translate english little_homeland_949c9486:

    # boln "{size=-5}...я так понимаю ты не отсюда.{/size}"
    boln "{size=-5}……我看你不是本地人。{/size}"

# game/a15/5little_homeland.rpy:151
translate english little_homeland_419bb916:

    # me "С кем я говорю?"
    me "我在和谁说话？"

# game/a15/5little_homeland.rpy:152
translate english little_homeland_1fc383ee:

    # boln "{size=-5}С тем, с кем лучше говорить через дверь.{/size}"
    boln "{size=-5}和一个你最好隔着门说话的人。{/size}"

# game/a15/5little_homeland.rpy:153
translate english little_homeland_387a109a:

    # me "Вы заражены?"
    me "您感染了吗？"

# game/a15/5little_homeland.rpy:154
translate english little_homeland_08bd1725:

    # boln "{size=-5}Был бы рад ошибаться, но сомневаюсь, что рвота кровью это симптом простой простуды{/size}."
    boln "{size=-5}我倒希望是我弄错了，但我不觉得呕血是普通感冒的症状。{/size}"

# game/a15/5little_homeland.rpy:155
translate english little_homeland_c7b49dae:

    # me "Я стучал минут пять."
    me "我敲了五分钟。"

# game/a15/5little_homeland.rpy:156
translate english little_homeland_4983f274:

    # boln "{size=-5}Ты меня не слышишь? Я подыхаю, болван. Скажи спасибо, что я вообще подошел к двери.{/size}"
    boln "{size=-5}你没听见吗？我快死了，蠢货。谢天谢地我还走到门口了。{/size}"

# game/a15/5little_homeland.rpy:157
translate english little_homeland_bad04a4e:

    # me "Мне нужна Веснушка."
    me "我要找雀斑姑娘。"

# game/a15/5little_homeland.rpy:158
translate english little_homeland_8ba4d761:

    # boln "{size=-5}Кто?{/size}"
    boln "{size=-5}谁？{/size}"

# game/a15/5little_homeland.rpy:159
translate english little_homeland_3b9626ef:

    # me "Девушка. Молодая. Каштановые волосы. Невысокий рост. Она работала в таверне у моста."
    me "一个姑娘。年轻。栗色头发。个子不高。她在桥边酒馆干活。"

# game/a15/5little_homeland.rpy:160
translate english little_homeland_cafe45a4:

    # boln "{size=-5}Прости, не знаю такую.{/size}"
    boln "{size=-5}抱歉，不认识。{/size}"

# game/a15/5little_homeland.rpy:161
translate english little_homeland_420ed4f5:

    # me "Ты в ее доме."
    me "你就在她家里。"

# game/a15/5little_homeland.rpy:162
translate english little_homeland_0ff8d1ae:

    # boln "{size=-5}Может быть. Он был бесхозным{/size}."
    boln "{size=-5}也许吧。这房子没人要。{/size}"

# game/a15/5little_homeland.rpy:163
translate english little_homeland_d5f27bbb:

    # me "И ты просто его занял?"
    me "你就直接占了？"

# game/a15/5little_homeland.rpy:164
translate english little_homeland_4a20067b:

    # boln "{size=-5}Я пришел сюда умирать. Не хочу, чтобы моя семья смотрела, как я блюю своими органами, а потом заворачивала мое тело в мешок.{/size}"
    boln "{size=-5}我来这儿等死。我不想让家人看着我吐内脏，然后再把我的尸体裹进袋子。{/size}"

# game/a15/5little_homeland.rpy:165
translate english little_homeland_b90ade68:

    # me "Умирать..."
    me "等死……"

# game/a15/5little_homeland.rpy:166
translate english little_homeland_67e76dbe:

    # boln "{size=-5}Я говорю правду. Впрочем если хочешь можешь зайти и проверить. Но я бы не рекомендовал...кха-кха... если ты0 конечно, не хочешь сдохнуть вместе со мной.{/size}"
    boln "{size=-5}我说的是实话。不过你想的话可以进来看看。但我不建议……咳咳……当然，除非你想和我一起死。{/size}"

# game/a15/5little_homeland.rpy:167
translate english little_homeland_14df139b:

    # me "...а...когда ты сюда пришел... может ты видел какую-нибудь записку или..."
    me "……那……你来的时候……有没有看到什么字条或者……"

# game/a15/5little_homeland.rpy:168
translate english little_homeland_6ae0b429:

    # boln "{size=-5}Нет. Здесь все перевернуто вверх дном. Думаю здесь уже месяца три никто не жил. Может твоя подруга уехала?{/size}"
    boln "{size=-5}没有。这里全被翻得乱七八糟。我看至少三个月没人住了。也许你那位姑娘走了？{/size}"

# game/a15/5little_homeland.rpy:169
translate english little_homeland_f56fde7e:

    # me "Уехала? Куда?"
    me "走了？去哪儿？"

# game/a15/5little_homeland.rpy:170
translate english little_homeland_f39d3e21:

    # boln "{size=-5}Куда глаза глядят. Когда началась болезнь из города все начали бежать. Может они еще и живы.{/size}"
    boln "{size=-5}走到哪算哪。瘟疫一开始，全城人都跑了。也许她还活着。{/size}"

# game/a15/5little_homeland.rpy:171
translate english little_homeland_3820771a_5:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:172
translate english little_homeland_285f7ae6:

    # boln "{size=-5}Вернись сюда через год, может когда болезнь уйдет - она вернется.{/size}"
    boln "{size=-5}一年后再回来吧，也许瘟疫退了——她会回来。{/size}"

# game/a15/5little_homeland.rpy:173
translate english little_homeland_61d00264:

    # me "...ладно...спасибо."
    me "……好吧……谢谢。抱歉让你在这种情况下还得说话。"

# game/a15/5little_homeland.rpy:174
translate english little_homeland_e686488a:

    # boln "{size=-5}Не за что. Было приятно поболтать с кем-то перед тем как я умру.{/size}"
    boln "{size=-5}没事。死前能和人聊两句也不错。{/size}"

# game/a15/5little_homeland.rpy:175
translate english little_homeland_9b021167:

    # me "Я могу как-то помочь?"
    me "我能帮上什么忙吗？"

# game/a15/5little_homeland.rpy:176
translate english little_homeland_ab008cf5:

    # boln "{size=-5}Если ты не безымянный бог, то сомневаюсь.{/size}"
    boln "{size=-5}除非你是无名之神，不然我怀疑不能。{/size}"

# game/a15/5little_homeland.rpy:177
translate english little_homeland_a925faa9:

    # me "Прощай."
    me "再会。"

# game/a15/5little_homeland.rpy:178
translate english little_homeland_b70c8625:

    # boln "{size=-5}Прощай, незнакомец.{/size}"
    boln "{size=-5}再会，陌生人。{/size}"

# game/a15/5little_homeland.rpy:181
translate english little_homeland_2fa3e4fe:

    # me "Ладно. Выламываем дверь."
    me "好吧。把门撬开。"

# game/a15/5little_homeland.rpy:183
translate english little_homeland_79d82858:

    # "Десять минут спустя."
    "十分钟后。"

# game/a15/5little_homeland.rpy:184
translate english little_homeland_d507fa9d:

    # me "Ну? Что-нибудь нашли?"
    me "怎么样？找到什么了吗？"

# game/a15/5little_homeland.rpy:185
translate english little_homeland_e57caa52:

    # lace "Нет. Только хлам. Похоже это место давно заброшено. Судя по пыли и паутине полгода точно."
    lace "没有。只有破烂。看来这地方早就荒废了。看灰尘和蛛网，至少半年。"

# game/a15/5little_homeland.rpy:186
translate english little_homeland_d2669ed2:

    # me "Странно. Здесь все перевернуто вверх дном, но дверь была закрыта."
    me "奇怪。这里全被翻乱了，门却是锁着的。"

# game/a15/5little_homeland.rpy:187
translate english little_homeland_7360a688:

    # harold "Может залезли через окно?"
    harold "也许是从窗户进来的？"

# game/a15/5little_homeland.rpy:188
translate english little_homeland_0e5160a6:

    # me "Окно целое. Его еще и закрыли шкафом."
    me "窗户完好。还被柜子堵上了。"

# game/a15/5little_homeland.rpy:189
translate english little_homeland_1d5af984:

    # lace "Здесь есть другие комнаты?"
    lace "还有别的房间吗？"

# game/a15/5little_homeland.rpy:190
translate english little_homeland_d976af6d:

    # me "Нет. Только эта."
    me "没有。就这一间。"

# game/a15/5little_homeland.rpy:191
translate english little_homeland_b632fad2:

    # harold "Странно. Выходит здесь порылись, поломали вещи, вышли и закрыли дверь ключом?"
    harold "奇怪。就是说他们翻了这里，砸了东西，出去还锁了门？"

# game/a15/5little_homeland.rpy:192
translate english little_homeland_aa8a9fdc:

    # me "Да. Действительно странно."
    me "对。确实奇怪。"

# game/a15/5little_homeland.rpy:193
translate english little_homeland_9b0236d1:

    # lace "Что вообще можно искать в таком доме? Кто здесь жил?"
    lace "这种地方能找什么？谁住在这儿？"

# game/a15/5little_homeland.rpy:194
translate english little_homeland_e6450662:

    # me "Девушка. Официантка из таверны."
    me "一个姑娘。酒馆的女招待。"

# game/a15/5little_homeland.rpy:195
translate english little_homeland_6741fb88:

    # harold "Вы что-то оставляли ей? Может кто-то подумал, что у нее были драгоценности или еще что-нибудь такое?"
    harold "您给她留过什么吗？也许有人以为她有珠宝之类的？"

# game/a15/5little_homeland.rpy:196
translate english little_homeland_dabf7fb0:

    # me "Нет. Здесь никто не знал, кто я."
    me "没有。这里没人知道我是谁。"

# game/a15/5little_homeland.rpy:197
translate english little_homeland_1808aa8f:

    # lace "Нашел!"
    lace "找到了！"

# game/a15/5little_homeland.rpy:199
translate english little_homeland_047c6a1d:

    # me "Что это? Письмо? Где оно было?"
    me "这是什么？信？在哪儿找到的？"

# game/a15/5little_homeland.rpy:200
translate english little_homeland_ad89238d:

    # lace "Я порасшатывал пару кирпичей. Мы с братом так в детстве часто что-то прятали в стенах."
    lace "我晃松了几块砖。我和我兄弟小时候常把东西藏在墙里。"

# game/a15/5little_homeland.rpy:201
translate english little_homeland_90026205:

    # me "{i}Привет, Кэти, я знаю, что мы плохо расстались и что у тебя наверняка уже своя семья, но мне больше не к кому обратиться.{/i}"
    me "{i}你好，凯蒂。我知道我们分手时闹得很不愉快，也知道你多半已经有了自己的家，但我实在没人可以求助了。{/i}"

# game/a15/5little_homeland.rpy:202
translate english little_homeland_d403d049:

    # me "{i}Ты ведь знаешь, что я живу одна в дядином доме и работаю в таверне. В один из дней я совершила ошибку. Большую ошибку. Я забеременела. С тех пор мое положение ухудшилось.{/i}"
    me "{i}你知道我一个人住在叔叔的房子里，在酒馆干活。有一天我犯了个错。大错。我怀孕了。从那以后我的处境越来越糟。{/i}"

# game/a15/5little_homeland.rpy:203
translate english little_homeland_60c0912c:

    # me "{i}Но не думай, что я прошу о деньгах или еще о чем-то таком! Хозяйка вошла в мое положение и стала платить больше, а теперь позволяет мне не носить тарелки, а только разливать напитки.{/i}"
    me "{i}但别以为我是来要钱或别的什么！老板娘体谅我，给我涨了工钱，现在只让我倒酒，不用端盘子了。{/i}"

# game/a15/5little_homeland.rpy:204
translate english little_homeland_ddafabeb:

    # me "{i}Проблема совершенно в другом! Меня стали преследовать какие-то люди. Я не знаю кто они и что им надо. Но я точно уверена, что они за мной следят!{/i}"
    me "{i}问题完全在别处！有些人开始跟踪我。我不知道他们是谁，想要什么。但我确定他们在监视我！{/i}"

# game/a15/5little_homeland.rpy:205
translate english little_homeland_09a90486:

    # me "{i}В таверне, в городе, на реке, даже в моем доме! Я видела их тени у окон! Они ходят в балахонах и скрывают лица.{/i}"
    me "{i}在酒馆、城里、河边，甚至在我家里！我看见他们在窗边的影子！他们穿着长袍，遮着脸。{/i}"

# game/a15/5little_homeland.rpy:206
translate english little_homeland_2dfcd879:

    # me "{i}Клянусь, я не сумасшедшая! Я обращалась к страже, но они говорят, что я выдумываю. А я говорю правду!{/i}"
    me "{i}我发誓我没疯！我找过守卫，但他们说我在编故事。可我说的是真话！{/i}"

# game/a15/5little_homeland.rpy:207
translate english little_homeland_6af1d281:

    # me "{i}Тот парень, что сделал мне ребенка, он признался мне, что он принц Золотого Королевства! Я думала, что он врет, но теперь не уверена.{/i}"
    me "{i}那个让我怀孕的男人，他向我承认他是黄金王国的王子！我本以为他在撒谎，但现在我不确定了。{/i}"

# game/a15/5little_homeland.rpy:208
translate english little_homeland_c2d7c089:

    # me "{i}Может это его люди? Я пыталась говорить с ними, кричала. Но они всегда держатся на расстоянии. И все же с каждым днем они ближе.{/i}"
    me "{i}也许是他的人？我试着和他们说话，冲他们喊。但他们总保持距离。可每天都更近一些。{/i}"

# game/a15/5little_homeland.rpy:209
translate english little_homeland_83e81e1c:

    # me "{i}Сестра, умоляю, позволь мне вернуться в отцовский дом, я готова к любой работе! Только спаси меня от этих людей!{/i}"
    me "{i}姐姐，求你了，让我回父亲家吧，什么活我都愿意干！只求你救我摆脱那些人！{/i}"

# game/a15/5little_homeland.rpy:210
translate english little_homeland_3ff4b4dc:

    # lace "Ну что там?"
    lace "上面写了什么？"

# game/a15/5little_homeland.rpy:211
translate english little_homeland_40a1ee2b:

    # me "Кто-то следил за ней."
    me "有人在跟踪她。"

# game/a15/5little_homeland.rpy:212
translate english little_homeland_19d7310e:

    # lace "Кто?"
    lace "谁？"

# game/a15/5little_homeland.rpy:213
translate english little_homeland_f486def9:

    # me "Не знаю. Но похоже эти люди до нее добрались. Иначе это письмо было бы отправлено."
    me "不知道。但看来那些人找到她了。否则这封信早该寄出去了。"

# game/a15/5little_homeland.rpy:214
translate english little_homeland_b11aeb72:

    # lace "Может это письмо и искали?"
    lace "也许他们找的就是这封信？"

# game/a15/5little_homeland.rpy:215
translate english little_homeland_695f640f:

    # me "Вряд ли. Хотя... может они увидели, что она пишет его и решили действовать."
    me "不太可能。不过……也许他们看见她在写信，就决定动手了。"

# game/a15/5little_homeland.rpy:216
translate english little_homeland_8366f2e1:

    # lace "А она успела спрятать его в стену."
    lace "而她来得及把它藏进墙里。"

# game/a15/5little_homeland.rpy:217
translate english little_homeland_999345d6:

    # me "Верно. Потом они все тут перевернули, пока искали письмо, а позже ушли, забрали девушку."
    me "没错。然后他们翻遍这里找信，之后离开，带走了那姑娘。"

# game/a15/5little_homeland.rpy:218
translate english little_homeland_7f3e166f:

    # lace "А как они вообще поняли, что она пишет письмо? Подсмотрели через окно? Оно ведь было заставлено шкафом. Или это они его туда поставили?"
    lace "可他们怎么知道她在写信？从窗户偷看？窗户被柜子挡住了。还是柜子就是他们搬过去的？"

# game/a15/5little_homeland.rpy:219
translate english little_homeland_0aa7d58b:

    # me "Ладно. Что бы тут не произошло, это произошло давно, искать Веснушку здесь больше нет смысла."
    me "算了。不管这里发生了什么，都过去很久了，在这里再找雀斑姑娘没有意义了。"

# game/a15/5little_homeland.rpy:221
translate english little_homeland_0f476a5d:

    # "Чуть позже."
    "稍后。"

# game/a15/5little_homeland.rpy:222
translate english little_homeland_bbe4dd01:

    # me "...так... он умер?"
    me "……那么……他死了？"

# game/a15/5little_homeland.rpy:223
translate english little_homeland_f5ba4834:

    # rosa "Месяц назад."
    rosa "一个月前。"

# game/a15/5little_homeland.rpy:224
translate english little_homeland_1a8984c1:

    # me "Мне жаль."
    me "我很遗憾。"

# game/a15/5little_homeland.rpy:225
translate english little_homeland_cb2a06e1:

    # rosa "Он не мучился. Сгорел за пару дней. Когда почувствовал, что слишком плох, то просто ушел из таверны, чтобы мне не пришлось вытаскивать его труп."
    rosa "他没受罪。两天就烧完了。当他觉得自己不行了，就自己离开了酒馆，免得我还得拖他的尸体出去。"

# game/a15/5little_homeland.rpy:226
translate english little_homeland_43943066:

    # me "...жаль. Джуно был единственный, кто был ко мне добр. Давал пить в долг."
    me "……可惜。朱诺是唯一对我好的人。还让我赊账喝酒。"

# game/a15/5little_homeland.rpy:227
translate english little_homeland_92bc2a2c:

    # rosa "Он вспоминал тебя пару раз."
    rosa "他提过你几次。"

# game/a15/5little_homeland.rpy:228
translate english little_homeland_489a247d:

    # me "Правда?"
    me "真的？"

# game/a15/5little_homeland.rpy:229
translate english little_homeland_e3c9af6c:

    # rosa "Да. Говорил, что ты бы ему пригодился, чтобы защищаться от мародеров."
    rosa "对。他说你要是在，就能帮他防着掠夺者了。"

# game/a15/5little_homeland.rpy:230
translate english little_homeland_58210f7d:

    # me "Мародеров?"
    me "掠夺者？"

# game/a15/5little_homeland.rpy:231
translate english little_homeland_b52d1c66:

    # rosa "Как только все это началось - город объял хаос. Стражники поначалу выполняли долг, но и их вскоре поразила болезнь."
    rosa "这一切一开始——城市就陷入混乱。守卫起初还履行职责，但很快也被疾病击倒。"

# game/a15/5little_homeland.rpy:233
translate english little_homeland_3e89ef8b:

    # me "Ну это место выглядит целым."
    me "不过这里看起来还完好。"

# game/a15/5little_homeland.rpy:234
translate english little_homeland_4661cd75:

    # rosa "Джуно нанял парочку завсегдатаев, платил выпивкой и едой."
    rosa "朱诺雇了两个常客，用酒和食物付钱。"

# game/a15/5little_homeland.rpy:235
translate english little_homeland_f91fd3eb:

    # me "У вас было столько еды?"
    me "你们有那么多食物？"

# game/a15/5little_homeland.rpy:236
translate english little_homeland_e375bbb4:

    # rosa "Нет... кхм-кхм... но она кончилась позже, чем мародеры. Чем кто бы то ни был, кто способен держать в руках нож, но не сбежал из этого проклятого места. КХм-кхм."
    rosa "没有……咳咳……但它比掠夺者撑得久。比任何还拿得动刀、却没逃离这鬼地方的人撑得久。咳咳。"

# game/a15/5little_homeland.rpy:237
translate english little_homeland_53c33862:

    # me "Ты заразилась?"
    me "你感染了？"

# game/a15/5little_homeland.rpy:238
translate english little_homeland_a4113a04:

    # rosa "Кхм-кхм... как слышишь."
    rosa "咳咳……你听得出来。"

# game/a15/5little_homeland.rpy:239
translate english little_homeland_ceb37ecb:

    # me "От кого? Ты же здесь теперь"
    me "从谁那儿？你现在不是一个人在这儿吗？"

# game/a15/5little_homeland.rpy:240
translate english little_homeland_00a4618c:

    # rosa "Не знаю. Наверное крыса укусила во сне или что-то вроде того. У меня нога чесалась до крови а потом начался кашель."
    rosa "不知道。大概是睡觉时被老鼠咬了之类的。我的腿痒到出血，然后就开始咳嗽。"

# game/a15/5little_homeland.rpy:241
translate english little_homeland_1a8984c1_1:

    # me "Мне жаль."
    me "我很遗憾。"

# game/a15/5little_homeland.rpy:242
translate english little_homeland_f5451fc9:

    # rosa "Ну что ты. Это только первые дни. Пока мне еще не так плохо."
    rosa "别这样。这才刚开始几天。我还没那么糟。"

# game/a15/5little_homeland.rpy:243
translate english little_homeland_8006b6de:

    # me "Есть какие-то шансы выжить? Или все кто..."
    me "有活下来的机会吗？还是所有……"

# game/a15/5little_homeland.rpy:244
translate english little_homeland_3e96bd96:

    # rosa "Наверное есть. Кто-то точно выздоравливал. Кхм-хкм. Один из парней, которых нанимал Джуно. Он заболел. Ушел сам. Хкм-кхм."
    rosa "大概有。肯定有人康复过。咳咳。朱诺雇的其中一个男人。他病了。自己走了。咳咳。"

# game/a15/5little_homeland.rpy:245
translate english little_homeland_0d0b1e61:

    # rosa "А через пару недель вернулся. Выздоровел."
    rosa "几周后回来了。康复了。"

# game/a15/5little_homeland.rpy:246
translate english little_homeland_a0f33a9b:

    # me "И что он делал дальше?"
    me "后来他做什么了？"

# game/a15/5little_homeland.rpy:247
translate english little_homeland_d1978b99:

    # rosa "Сказал, что будет помогать тем, кому это надо. Последний раз я видела его неделю назад."
    rosa "他说会去帮需要帮助的人。我最后一次见他是上周。"

# game/a15/5little_homeland.rpy:248
translate english little_homeland_78efaef6:

    # me "Значит шансы у тебя есть."
    me "所以你还有机会。"

# game/a15/5little_homeland.rpy:250
translate english little_homeland_be019a5c:

    # rosa "КХА-КХА-ХКА...КХА-КХА..."
    rosa "咳咳咳……咳咳……"

# game/a15/5little_homeland.rpy:251
translate english little_homeland_3820771a_6:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:252
translate english little_homeland_348e9c25:

    # rosa "[mename]... тебе нельзя здесь находиться... или ты тоже заболеешь."
    rosa "[mename]……你不能待在这儿……不然你也会病。"

# game/a15/5little_homeland.rpy:253
translate english little_homeland_c00bb072:

    # me "Да. Ты права."
    me "对。你说得对。"

# game/a15/5little_homeland.rpy:254
translate english little_homeland_a71d1f5f:

    # rosa "Я рада, что ты зашел... КХА-КХА... Спасибо."
    rosa "我很高兴你来了……咳咳……谢谢。"

# game/a15/5little_homeland.rpy:255
translate english little_homeland_3820771a_7:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:256
translate english little_homeland_5392a13f:

    # rosa "Удивительно... ты не соврал. Ты правда принц...КХА-КХА..."
    rosa "真想不到……你没撒谎。你真的是王子……咳咳……"

# game/a15/5little_homeland.rpy:257
translate english little_homeland_d6fae867:

    # me "Чем я могу помочь?"
    me "我能帮什么忙？"

# game/a15/5little_homeland.rpy:258
translate english little_homeland_2ff72c32:

    # rosa "Ничем. Если вдруг вернешься сюда и увидишь мое тело - сожги его или закопай."
    rosa "帮不了。如果你以后回来看到我的尸体——烧了或者埋了吧。"

# game/a15/5little_homeland.rpy:259
translate english little_homeland_4e135ebc:

    # me "В городе еще торгуют?"
    me "城里还有人做买卖吗？"

# game/a15/5little_homeland.rpy:260
translate english little_homeland_7952b919:

    # rosa "Только в порту."
    rosa "只有港口。"

# game/a15/5little_homeland.rpy:262
translate english little_homeland_71a21743:

    # me "Вот."
    me "拿着。"

# game/a15/5little_homeland.rpy:263
translate english little_homeland_baec2ddd:

    # rosa "Что это?"
    rosa "这是什么？"

# game/a15/5little_homeland.rpy:264
translate english little_homeland_67ae60e3:

    # me "Золото. Купи себе все что нужно, пока ты еще можешь ходить."
    me "黄金。趁你还能走，买点你需要的东西。"

# game/a15/5little_homeland.rpy:265
translate english little_homeland_5d37d398:

    # rosa "Все что нужно?"
    rosa "需要的东西？"

# game/a15/5little_homeland.rpy:266
translate english little_homeland_c56ac0f0:

    # me "Еда. Я вернусь в Столицу и отправлю сюда человека, он проведает тебя через пару недель."
    me "食物。我会回首都，派人过来，几周后来看你。"

# game/a15/5little_homeland.rpy:267
translate english little_homeland_c631c7b2:

    # rosa "...спасибо."
    rosa "……谢谢。"

# game/a15/5little_homeland.rpy:268
translate english little_homeland_acf26d80:

    # me "Тебе спасибо. Это меньшее, что я могу сделать за все те теплые, пьяные и веселые вечера, что я провел здесь."
    me "该谢你。为了我在这里度过的那些温暖、醉醺醺又欢乐的夜晚，这是我能做的最起码的事。"

# game/a15/5little_homeland.rpy:269
translate english little_homeland_f03447c2:

    # rosa "Прощай, [mename]. Если еще будешь в Бригдоке - подними кубок за старую Розу."
    rosa "再会，[mename]。如果你还会来布里格多克——为老罗莎举杯。"

# game/a15/5little_homeland.rpy:270
translate english little_homeland_e8c8a20a:

    # me "Мы поднимем его вместе."
    me "我们一起举。"

# game/a15/5little_homeland.rpy:271
translate english little_homeland_1fd20fd2:

    # rosa "Тебе пора идти, если ты не хочешь через неделю поднимать кубок с безымянными богами."
    rosa "你该走了，除非你想一周后和无名之神们一起举杯。"

# game/a15/5little_homeland.rpy:275
translate english little_homeland2_24b271ca:

    # "Неделю спустя."
    "一周后。"

# game/a15/5little_homeland.rpy:276
translate english little_homeland2_0d761857:

    # me "Ну что там?"
    me "那边怎么样？"

# game/a15/5little_homeland.rpy:277
translate english little_homeland2_bdbc5063:

    # harold "Ничего не видать. Дорогу замело снегом."
    harold "什么都看不见。路被雪埋了。"

# game/a15/5little_homeland.rpy:278
translate english little_homeland2_9daf22b5:

    # me "А что авангард?"
    me "前锋呢？"

# game/a15/5little_homeland.rpy:279
translate english little_homeland2_c452cbde:

    # harold "Далеко впереди, пока не вернется - не узнаем куда ехать."
    harold "在前面很远，等他们回来才知道往哪走。"

# game/a15/5little_homeland.rpy:280
translate english little_homeland2_936fe52c:

    # me "Если они сами поймут куда возвращаться..."
    me "前提是他们自己能找到回来的路……"

# game/a15/5little_homeland.rpy:281
translate english little_homeland2_573de6f4:

    # harold "Кто же знал, что за ночь столько снега выпадет."
    harold "谁知道一夜之间会下这么多雪。"

# game/a15/5little_homeland.rpy:282
translate english little_homeland2_d808e662:

    # me "Странно, вроде и не холодно."
    me "奇怪，好像也不冷。"

# game/a15/5little_homeland.rpy:283
translate english little_homeland2_09cfda0e:

    # harold "Это самое страшное."
    harold "这才最可怕。"

# game/a15/5little_homeland.rpy:284
translate english little_homeland2_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/5little_homeland.rpy:285
translate english little_homeland2_72349fd2:

    # harold "Если все это растает... и мы и лошади будем по колено в грязи."
    harold "如果这些都化了……我们和马都会陷在齐膝的泥里。"

# game/a15/5little_homeland.rpy:286
translate english little_homeland2_b7cba703:

    # me "И что будем делать?"
    me "那我们怎么办？"

# game/a15/5little_homeland.rpy:287
translate english little_homeland2_ba1727b0:

    # harold "Я отправил Лейса в деревню неподалеку. Думаю найдет проводника."
    harold "我派蕾丝去附近的村子了。应该能找到向导。"

# game/a15/5little_homeland.rpy:288
translate english little_homeland2_3820771a:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:289
translate english little_homeland2_64a86dac:

    # harold "Отдыхайте пока, мой принц."
    harold "先休息吧，我的王子。"

# game/a15/5little_homeland.rpy:290
translate english little_homeland2_35630602:

    # me "Это приказ?"
    me "这是命令？"

# game/a15/5little_homeland.rpy:291
translate english little_homeland2_34245c50:

    # harold "Дружеский совет от старого солдата."
    harold "一个老兵的建议。"

# game/a15/5little_homeland.rpy:292
translate english little_homeland2_3bc8dc10:

    # me "Тогда воспользуюсь им."
    me "那我就接受。"

# game/a15/5little_homeland.rpy:295
translate english little_homeland2_6ee4ce96:

    # eva "Ну и чего мы встали?"
    eva "我们怎么停下了？"

# game/a15/5little_homeland.rpy:296
translate english little_homeland2_3efe05fa:

    # me "Дорогу замело."
    me "路被雪埋了。"

# game/a15/5little_homeland.rpy:297
translate english little_homeland2_6798ff41:

    # eva "И что?"
    eva "那又怎样？"

# game/a15/5little_homeland.rpy:298
translate english little_homeland2_230a5685:

    # me "И то."
    me "你说呢。"

# game/a15/5little_homeland.rpy:299
translate english little_homeland2_f1c671a8:

    # eva "Вы не помните в какую сторону ехали?"
    eva "你们不记得往哪边走了？"

# game/a15/5little_homeland.rpy:300
translate english little_homeland2_41de0e39:

    # me "Предлагаешь ехать вслепую на юг?"
    me "你建议我们瞎着眼往南骑？"

# game/a15/5little_homeland.rpy:301
translate english little_homeland2_09964b68:

    # eva "А что?"
    eva "不行吗？"

# game/a15/5little_homeland.rpy:302
translate english little_homeland2_c2c70846:

    # me "Даже не хочу это комментировать."
    me "我连评论都不想评论。"

# game/a15/5little_homeland.rpy:303
translate english little_homeland2_5acd163f:

    # eva "Потому что знаешь что права."
    eva "因为你知道我说得对。"

# game/a15/5little_homeland.rpy:304
translate english little_homeland2_e2c3bae6:

    # me "Знаешь, могу выделить тебе лошадь и ты отправишься к Вингхэдам сама."
    me "你知道吗，我可以给你一匹马，你自己去温格海德家。"

# game/a15/5little_homeland.rpy:305
translate english little_homeland2_62df52fb:

    # eva "Не можешь."
    eva "你不行。"

# game/a15/5little_homeland.rpy:306
translate english little_homeland2_3642f725:

    # me "Почему это?"
    me "为什么？"

# game/a15/5little_homeland.rpy:307
translate english little_homeland2_aca5b5ec:

    # eva "Потому что пока ты везешь меня - я под твоей ответственностью. Даже если я пальчик сломаю, это будет твоя вина."
    eva "因为只要你带着我，我就归你负责。就算我断根手指，也是你的错。"

# game/a15/5little_homeland.rpy:308
translate english little_homeland2_3820771a_1:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:309
translate english little_homeland2_f14b7b26:

    # eva "Так что ты просто нагоняешь спеси. На самом деле ты обязан меня беречь."
    eva "所以你只是在摆架子。实际上你有义务保护我。"

# game/a15/5little_homeland.rpy:310
translate english little_homeland2_21e545fe:

    # me "Чего тебе надо, Ева?"
    me "你想干什么，艾娃？"

# game/a15/5little_homeland.rpy:312
translate english little_homeland2_c1ee311e:

    # eva "Зашла попрощаться. Эдрик сказал поворот к замку Вингхэдов уже скоро."
    eva "来道别。埃德里克说快到通往温格海德城堡的岔路了。"

# game/a15/5little_homeland.rpy:313
translate english little_homeland2_a28b36c4:

    # eva "Правда он сказал об этом вчера, а в этом снеге его можно и не найти."
    eva "不过他昨天这么说的，而这雪里可能根本找不到。"

# game/a15/5little_homeland.rpy:314
translate english little_homeland2_dabc8f13:

    # me "Найдем рано или поздно."
    me "迟早会找到。"

# game/a15/5little_homeland.rpy:315
translate english little_homeland2_bc9c24e4:

    # eva "Лучше бы пораньше, мне надоело использовать переносной нужник. Это отвратительно."
    eva "最好早点，我受够用便携马桶了。真恶心。"

# game/a15/5little_homeland.rpy:316
translate english little_homeland2_8a42641f:

    # me "Все остальные справляют нужду в чистом поле или лесу. Тут только у тебя есть слуга и просторная карета."
    me "其他人都直接在野地或树林里解决。这里只有你有仆人和宽敞马车。"

# game/a15/5little_homeland.rpy:317
translate english little_homeland2_9d6b4ebb:

    # eva "И что? Я принцесса в конце концов. Почему мы не поплыли кораблем?"
    eva "那又怎样？我毕竟是公主。我们为什么没坐船？"

# game/a15/5little_homeland.rpy:318
translate english little_homeland2_32d75578:

    # me "Потому что порт замерз."
    me "因为港口冻住了。"

# game/a15/5little_homeland.rpy:319
translate english little_homeland2_31829d40:

    # eva "Ааа... а я думала, что это из-за того что ваш корабль сожгли."
    eva "啊啊……我还以为是因为你们的船被烧了。"

# game/a15/5little_homeland.rpy:320
translate english little_homeland2_510786a0:

    # me "Ты что-то об этом знаешь?"
    me "你知道这件事？"

# game/a15/5little_homeland.rpy:321
translate english little_homeland2_af806d57:

    # eva "Нет. Ничего."
    eva "不。什么都不知道。"

# game/a15/5little_homeland.rpy:322
translate english little_homeland2_3820771a_2:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:323
translate english little_homeland2_53352fc0:

    # eva "..."
    eva "……"

# game/a15/5little_homeland.rpy:324
translate english little_homeland2_14e3d538:

    # me "Что тебе нужно, Ева?"
    me "我再问一次。你想干什么，艾娃？"

# game/a15/5little_homeland.rpy:327
translate english little_homeland2_07295bc8:

    # eva "После того, что между нами было как-то неприлично задавать такие вопросы."
    eva "在我们之间发生那种事之后，问这种问题有点不礼貌。"

# game/a15/5little_homeland.rpy:328
translate english little_homeland2_85425ecd:

    # me "Между нами ничего не было."
    me "我们之间什么都没发生。"

# game/a15/5little_homeland.rpy:329
translate english little_homeland2_992203e8:

    # eva "Расслабься. Твой рыцарь отошел."
    eva "放松。你的骑士走开了。"

# game/a15/5little_homeland.rpy:330
translate english little_homeland2_5f4cb6dd:

    # me "Он гвардеец, а не рыцарь."
    me "他是卫兵，不是骑士。"

# game/a15/5little_homeland.rpy:331
translate english little_homeland2_7328b7d7:

    # eva "Да какая разница? Главное, что его тут нет."
    eva "有什么区别？重要的是他不在这儿。"

# game/a15/5little_homeland.rpy:332
translate english little_homeland2_aafad2ff:

    # me "Слезь с меня. Нас могут увидеть."
    me "从我身上下去。会被人看见的。"

# game/a15/5little_homeland.rpy:333
translate english little_homeland2_e1b67353:

    # eva "Кто? Твои рыцари-гвардейцы? И что?"
    eva "谁？你的骑士卫兵？那又怎样？"

# game/a15/5little_homeland.rpy:334
translate english little_homeland2_077bb268:

    # me "И то. Ты едешь со своим женихом в его замок на свадьбу."
    me "那又怎样。你正和未婚夫一起去他的城堡结婚。"

# game/a15/5little_homeland.rpy:335
translate english little_homeland2_f30f9626:

    # eva "А... и мне не приличествует сидеть на коленях у другого мужчины?"
    eva "啊……我就不该坐在别的男人腿上？"

# game/a15/5little_homeland.rpy:336
translate english little_homeland2_eeb619ea:

    # me "Какая ты проницательная."
    me "你真敏锐。"

# game/a15/5little_homeland.rpy:337
translate english little_homeland2_f6262b87:

    # eva "А мне приличествует трахаться с другими мужчинами?"
    eva "那我跟别的男人上床就合适？"

# game/a15/5little_homeland.rpy:338
translate english little_homeland2_084e7568:

    # me "...эх..."
    me "……唉……"

# game/a15/5little_homeland.rpy:339
translate english little_homeland2_39b59f3b:

    # eva "Я помню наш первый раз в башне. У меня задница еще неделю болела."
    eva "我记得我们在塔里的第一次。我屁股疼了一周。"

# game/a15/5little_homeland.rpy:340
translate english little_homeland2_7a9d7dda:

    # me "...ага."
    me "……嗯。"

# game/a15/5little_homeland.rpy:341
translate english little_homeland2_e27babc5:

    # eva "А ты. Помнишь?"
    eva "那你呢？记得吗？"

# game/a15/5little_homeland.rpy:342
translate english little_homeland2_fb373ff5:

    # me "Помню. Но если кто-то спросит, то я буду все отрицать. И ты тоже должна."
    me "记得。但如果有人问，我会全部否认。你也得否认。"

# game/a15/5little_homeland.rpy:343
translate english little_homeland2_b2d442cd:

    # eva "Разумеется. Просто подумала, что ты захочешь повторить."
    eva "当然。只是觉得你可能想再来一次。"

# game/a15/5little_homeland.rpy:344
translate english little_homeland2_be266056:

    # me "Что? Прям здесь? Я бы спросил, ни больная ли ты, но я знаю, что больная."
    me "什么？就在这儿？我本想问你是不是有病，但我知道你有病。"

# game/a15/5little_homeland.rpy:345
translate english little_homeland2_8c5b50b1:

    # eva "В моей карете."
    eva "在我的马车里。"

# game/a15/5little_homeland.rpy:346
translate english little_homeland2_3820771a_3:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:347
translate english little_homeland2_57401922:

    # eva "Шучу."
    eva "开玩笑。"

# game/a15/5little_homeland.rpy:350
translate english little_homeland2_010826c7:

    # eva "А может и не шучу..."
    eva "也许不是开玩笑……"

# game/a15/5little_homeland.rpy:351
translate english little_homeland2_7759b3e7:

    # me "Прекрати."
    me "住口。"

# game/a15/5little_homeland.rpy:352
translate english little_homeland2_8c20cd91:

    # eva "Ты бы хотел? Хотел бы трахнуть меня прямо пока мы добираемся до замка моего жениха?"
    eva "你想吗？想在去我未婚夫城堡的路上就上我？"

# game/a15/5little_homeland.rpy:353
translate english little_homeland2_3820771a_4:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:354
translate english little_homeland2_e2153589:

    # eva "Знаешь, он смотрит на тебя влюбленными глазами."
    eva "你知道吗，他看你的眼神满是爱慕。"

# game/a15/5little_homeland.rpy:355
translate english little_homeland2_a444ac12:

    # me "Кто?"
    me "谁？"

# game/a15/5little_homeland.rpy:356
translate english little_homeland2_6176a6e3:

    # eva "Эдрик. Он еще такой мальчишка, хочет быть похожим на своего принца. Уверена, он тебя идеализирует."
    eva "埃德里克。他还是个孩子，想成为自己王子那样的人。我确定他把你理想化了。"

# game/a15/5little_homeland.rpy:357
translate english little_homeland2_3820771a_5:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:358
translate english little_homeland2_3235134e:

    # eva "И даже не подозревает, что ты трахал его жену. Будущую жену."
    eva "而且根本不知道你上过他的妻子。未来的妻子。"

# game/a15/5little_homeland.rpy:359
translate english little_homeland2_a152d5e7:

    # me "Зачем ты мне это говоришь?"
    me "你为什么告诉我这个？"

# game/a15/5little_homeland.rpy:360
translate english little_homeland2_0d435e39:

    # eva "Потому что тебе это нравится, так же как и мне."
    eva "因为你喜欢，就像我一样。"

# game/a15/5little_homeland.rpy:361
translate english little_homeland2_3820771a_6:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:362
translate english little_homeland2_ad8d6072:

    # eva "Хотя всегда можно сделать еще лучше, да? Знаешь для чего используют красный эдельвейс?"
    eva "不过总能做得更好，对吧？你知道红色雪绒花是干什么用的吗？"

# game/a15/5little_homeland.rpy:363
translate english little_homeland2_ac9cb8bc:

    # me "Понятия не имею."
    me "完全不知道。"

# game/a15/5little_homeland.rpy:366
translate english little_homeland2_338b466b:

    # eva "Редкий алхимический компонент, у него есть брат-близнец, бледный эдельвейс. Из него делают вытяжку для снятия головной боли."
    eva "一种稀有的炼金材料。它有个孪生兄弟——苍白雪绒花。用它制成的提取物能缓解头痛。"

# game/a15/5little_homeland.rpy:367
translate english little_homeland2_3820771a_7:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:368
translate english little_homeland2_c5c4e0c0:

    # eva "Правда он ухудшает зрение. При долгом приеме человек и вовсе слепнет."
    eva "不过它会损害视力。长期服用人会彻底失明。"

# game/a15/5little_homeland.rpy:369
translate english little_homeland2_1fd29e84:

    # me "Повторяю вопрос - зачем ты мне это рассказываешь?"
    me "我再问一遍——你为什么告诉我这个？"

# game/a15/5little_homeland.rpy:370
translate english little_homeland2_ed9ecdfe:

    # eva "Я бы могла годами травить моего будущего мужа... Через пару лет, бедняга Эдрик бы совсем ослеп."
    eva "我可以长年给我未来的丈夫下药……几年后，可怜的埃德里克就会彻底瞎掉。"

# game/a15/5little_homeland.rpy:371
translate english little_homeland2_3820771a_8:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:372
translate english little_homeland2_dd527626:

    # eva "И тут бы его замок навестил сам принц... Он был бы так счастлив. Он бы жал твою руку и плакал своими бледными слепыми глазами."
    eva "然后王子本人就会来他的城堡……他会多高兴啊。他会握着你的手，用那双苍白失明的眼睛流泪。"

# game/a15/5little_homeland.rpy:373
translate english little_homeland2_3820771a_9:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:374
translate english little_homeland2_d4f91708:

    # eva "А ночью, принц бы трахал его жену прямо у Эдрика под носом. В одних с ним покоях. О это было бы так неправильно..."
    eva "而夜里，王子就会在埃德里克鼻子底下上他的妻子。就在同一间房里。哦，那该多不道德……"

# game/a15/5little_homeland.rpy:375
translate english little_homeland2_627e59a4:

    # me "Он бы был слепым, а не глухим, или ты собираешься трахаться не издавая звуков?"
    me "他瞎了，不是聋了。还是你打算一声不出地上床？"

# game/a15/5little_homeland.rpy:376
translate english little_homeland2_b7fbf07e:

    # eva "О... так тебе нравится идея, да, [mename]? Надо просто немного доработать детали?"
    eva "哦……所以你其实喜欢这个主意，对吧，[mename]？只是需要再完善下细节？"

# game/a15/5little_homeland.rpy:377
translate english little_homeland2_a0db6856:

    # me "Заткнись. Гарольд возвращается. Вставай."
    me "闭嘴。哈罗德回来了。起来。"

# game/a15/5little_homeland.rpy:379
translate english little_homeland2_c1973212:

    # eva "Знаешь, у Эдрика есть старший брат. Будуший лорд Серого Утеса."
    eva "你知道吗，埃德里克有个哥哥。未来的灰崖领主。"

# game/a15/5little_homeland.rpy:380
translate english little_homeland2_3820771a_10:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:381
translate english little_homeland2_f50a0f35:

    # eva "Как думаешь, что лучше? Соблазнить его или убить? Может и то и другое?"
    eva "你觉得哪个更好？勾引他还是杀了他？还是两样都来？"

# game/a15/5little_homeland.rpy:382
translate english little_homeland2_2f4524ec:

    # me "А может исполнишь свой долг и будешь хорошей женой?"
    me "或者你履行自己的义务，做个好妻子？"

# game/a15/5little_homeland.rpy:383
translate english little_homeland2_fb5ffe76:

    # eva "Женой мелкого лорда без замка? Нет, я думаю определенно стоит убить брата Эдрика. И его отца заодно."
    eva "做没有城堡的小领主的妻子？不，我觉得肯定该杀了埃德里克的哥哥。顺便还有他父亲。"

# game/a15/5little_homeland.rpy:384
translate english little_homeland2_6315010b:

    # eva "Думаю, когда ты увидишь меня в следующий раз, мой дорогой муж уже будет лордом Вингхэдом."
    eva "我想下次你见到我时，我亲爱的丈夫已经是温格海德领主了。"

# game/a15/5little_homeland.rpy:385
translate english little_homeland2_edaa51ee:

    # me "А кем будешь ты?"
    me "那你呢？"

# game/a15/5little_homeland.rpy:386
translate english little_homeland2_b90b0370:

    # eva "Леди Серого Утеса. Леди Вингхэд."
    eva "灰崖夫人。温格海德夫人。"

# game/a15/5little_homeland.rpy:387
translate english little_homeland2_14fe61d8:

    # me "Смотри не окажись в петле уже после первой жертвы."
    me "小心别在第一个牺牲者之后自己上了绞架。"

# game/a15/5little_homeland.rpy:388
translate english little_homeland2_cde68218:

    # eva "Я буду очень осторожна. Ты меня знаешь... и я знаю тебя."
    eva "我会非常小心的。你了解我……我也了解你。"

# game/a15/5little_homeland.rpy:389
translate english little_homeland2_248d314f:

    # me "Это ты к чему?"
    me "你什么意思？"

# game/a15/5little_homeland.rpy:390
translate english little_homeland2_c6cf2a3e:

    # eva "Это я к тому, что мы еще обязательно встретимся. Верно?"
    eva "我的意思是我们一定还会再见。对吧？"

# game/a15/5little_homeland.rpy:391
translate english little_homeland2_3820771a_11:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:392
translate english little_homeland2_5463d83a:

    # eva "До встречи, принц [mename]."
    eva "再会，[mename]王子。"

# game/a15/5little_homeland.rpy:393
translate english little_homeland2_868f907a:

    # me "...до встречи, Ева."
    me "……再会，艾娃。"

# game/a15/5little_homeland.rpy:396
translate english little_homeland2_a8c64968:

    # eva "До встречи, [mename]."
    eva "再会，[mename]。"

# game/a15/5little_homeland.rpy:397
translate english little_homeland2_18134530:

    # me "До встречи."
    me "再会。"

# game/a15/5little_homeland.rpy:398
translate english little_homeland2_989989a5:

    # eva "Может навестишь меня на моей свадьбе."
    eva "也许你会来参加我的婚礼。"

# game/a15/5little_homeland.rpy:399
translate english little_homeland2_75bf423e:

    # me "Сомневаюсь, что у меня хватит времени."
    me "我怀疑我没那个时间。"

# game/a15/5little_homeland.rpy:400
translate english little_homeland2_caa03c52:

    # eva "Я попробую отложить свадьбу на попозже."
    eva "我会试着把婚礼推迟一点。"

# game/a15/5little_homeland.rpy:401
translate english little_homeland2_3820771a_12:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:402
translate english little_homeland2_38707711:

    # eva "Но даже если не получится - приезжай после. Уверена, что Эдрик тоже рад будет тебя увидеть."
    eva "但就算不行——之后也来吧。我确信埃德里克也会很高兴见到你。见不到，也听得到……"

# game/a15/5little_homeland.rpy:403
translate english little_homeland2_3820771a_13:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:404
translate english little_homeland2_f13dd59c:

    # eva "Ну и я, конечно. Обещаю, надену красное платье к твоему приезду."
    eva "当然还有我。我保证你来的那天穿红裙子。"

# game/a15/5little_homeland.rpy:405
translate english little_homeland2_18b53fd1:

    # me "Иди уже."
    me "去吧。"

# game/a15/5little_homeland.rpy:408
translate english little_homeland2_5665a312:

    # eva "Я же сказала - пришла попрощаться."
    eva "我说了——我是来道别的。"

# game/a15/5little_homeland.rpy:409
translate english little_homeland2_a925faa9:

    # me "Прощай."
    me "再会。"

# game/a15/5little_homeland.rpy:410
translate english little_homeland2_2c53a911:

    # eva "Прощай, [mename]."
    eva "再会，[mename]。"

# game/a15/5little_homeland.rpy:414
translate english little_homeland3_24b271ca:

    # "Неделю спустя."
    "一周后。"

# game/a15/5little_homeland.rpy:415
translate english little_homeland3_a64ba823:

    # me "Ну наконец-то дома."
    me "终于回家了。"

# game/a15/5little_homeland.rpy:416
translate english little_homeland3_5f282207:

    # harold "Скучали по этим улицам?"
    harold "想这些街道吗？"

# game/a15/5little_homeland.rpy:417
translate english little_homeland3_4ab88ffb:

    # me "Не так сильно, как по замку и семье."
    me "没想城堡和家人那么多。"

# game/a15/5little_homeland.rpy:418
translate english little_homeland3_68b1608f:

    # harold "Ну разумеется."
    harold "当然。"

# game/a15/5little_homeland.rpy:420
translate english little_homeland3_c6306c2e:

    # me "А тут снега нет."
    me "这里没雪。"

# game/a15/5little_homeland.rpy:421
translate english little_homeland3_7c62f6a9:

    # harold "Пойдет со дня на день. Узнаю это небо. Будто едва сдерживается, чтобы все тут не засыпать."
    harold "随时会下。我认得这天。它好像快忍不住要把这里全埋了。"

# game/a15/5little_homeland.rpy:422
translate english little_homeland3_8b8839aa:

    # me "Ну... пусть я не успел отбыть с Севера до первого снега, я хотя бы успел прибыть до первого снега сюда."
    me "嗯……虽然我没能在初雪前离开北方，至少我在初雪前赶到了这里。"

# game/a15/5little_homeland.rpy:423
translate english little_homeland3_a55a0d42:

    # harold "Думаете ваша сестра уже вышла замуж?"
    harold "您觉得您妹妹已经结婚了吗？"

# game/a15/5little_homeland.rpy:424
translate english little_homeland3_d7fd7cc7:

    # me "Уверен, что она сначала бы дождалась моего прибытия, но прошло столько времени... кто знает?"
    me "我确定她会先等我回来，但过了这么久……谁知道呢？"

# game/a15/5little_homeland.rpy:425
translate english little_homeland3_bd87c132:

    # harold "Эх... жду не дождусь, чтобы уложить свои кости в кровать."
    harold "唉……我迫不及待想把自己的骨头扔到床上。"

# game/a15/5little_homeland.rpy:426
translate english little_homeland3_82f34f64:

    # me "Аналогично. Думаю все в нашей колонне только об этом и думают. Разве что еще о хорошем вине и девках."
    me "一样。我想我们整支队伍都在想这个。也许还想想好酒和女人。"

# game/a15/5little_homeland.rpy:429
translate english little_homeland3_80f45634:

    # cass "Я думала сдохну в этом снегу."
    cass "我以为我会死在那雪里。"

# game/a15/5little_homeland.rpy:430
translate english little_homeland3_726596c6:

    # me "Так ты здесь? Я думал ты была в авангарде и уже давно в замке."
    me "你在这儿？我以为你在前锋，早就到城堡了。"

# game/a15/5little_homeland.rpy:431
translate english little_homeland3_c07efa1a:

    # cass "В последний момент передумала. Захотела въехать в город вместе с тобой."
    cass "最后一刻改主意了。想和你一起进城。"

# game/a15/5little_homeland.rpy:433
translate english little_homeland3_4bd0a2c3:

    # me "А я еду без короны, рядом со мной места не очень престижные."
    me "我可没戴王冠，我旁边的位置不太体面。"

# game/a15/5little_homeland.rpy:434
translate english little_homeland3_783f62eb:

    # cass "Успокойся. Никто и не ожидал, что ты вернешься с Севера с Севером."
    cass "别紧张。没人指望你从北方带回北方。"

# game/a15/5little_homeland.rpy:435
translate english little_homeland3_5f031b18:

    # me "Ага..."
    me "嗯……"

# game/a15/5little_homeland.rpy:436
translate english little_homeland3_4e1f03b9:

    # cass "Что-то нас тут не особо ждут."
    cass "看来这儿没多少人等我们。"

# game/a15/5little_homeland.rpy:437
translate english little_homeland3_176d1185:

    # me "Нас ждали с моря."
    me "他们以为我们从海上来。"

# game/a15/5little_homeland.rpy:438
translate english little_homeland3_6374b8b3:

    # cass "Ты не писал письмо?"
    cass "你没写信？"

# game/a15/5little_homeland.rpy:439
translate english little_homeland3_c2e35832:

    # me "Писал. Но зимой голуби не летают, а гонец похоже заплутал."
    me "写了。但冬天鸽子不飞，信使似乎迷路了。"

# game/a15/5little_homeland.rpy:440
translate english little_homeland3_a978b47d:

    # cass "У меня какое-то дурное предчувствие."
    cass "我有种不祥的预感。"

# game/a15/5little_homeland.rpy:441
translate english little_homeland3_ca62e42f:

    # me "Да? Ну давай его проверим."
    me "是吗？那就验证一下。"

# game/a15/5little_homeland.rpy:443
translate english little_homeland3_261bd221:

    # me "Как с триумфатором?"
    me "像凯旋者一样？"

# game/a15/5little_homeland.rpy:444
translate english little_homeland3_08fc5b17:

    # cass "Вроде того. Правда нас тут как будто не особо ждали."
    cass "差不多。不过这儿似乎没多少人等我们。"

# game/a15/5little_homeland.rpy:445
translate english little_homeland3_176d1185_1:

    # me "Нас ждали с моря."
    me "他们以为我们从海上来。"

# game/a15/5little_homeland.rpy:446
translate english little_homeland3_6374b8b3_1:

    # cass "Ты не писал письмо?"
    cass "你没写信？"

# game/a15/5little_homeland.rpy:447
translate english little_homeland3_c2e35832_1:

    # me "Писал. Но зимой голуби не летают, а гонец похоже заплутал."
    me "写了。但冬天鸽子不飞，信使似乎迷路了。"

# game/a15/5little_homeland.rpy:448
translate english little_homeland3_28249a9f:

    # cass "Можешь надеть корону, соберешь толпу по пути к замку."
    cass "你可以戴上王冠，去城堡的路上就能聚起一群人。"

# game/a15/5little_homeland.rpy:449
translate english little_homeland3_7332342b:

    # me "Зачем?"
    me "为什么？"

# game/a15/5little_homeland.rpy:450
translate english little_homeland3_a62db9e2:

    # cass "Вдруг отец передумал нас миловать, тогда возьмем стены штурмом."
    cass "万一父亲改主意不赦免我们，那我们就攻墙。"

# game/a15/5little_homeland.rpy:451
translate english little_homeland3_8f3c3003:

    # me "Смешно."
    me "好笑。"

# game/a15/5little_homeland.rpy:452
translate english little_homeland3_5fad8d33:

    # cass "А я и не то чтобы шучу. У меня какое-то дурное предчувствие."
    cass "我也不是完全在开玩笑。我有种不祥的预感。"

# game/a15/5little_homeland.rpy:452
translate english little_homeland3_aed52bf3:

    # me "Ну... давай его проверим."
    me "嗯……那就验证一下。"

# game/a15/5little_homeland.rpy:455
translate english little_homeland3_8097dfc8:

    # cass "В замок нас пустили. Это уже хороший знак."
    cass "他们放我们进城堡了。这已经是个好兆头。"

# game/a15/5little_homeland.rpy:456
translate english little_homeland3_a10adbcf:

    # me "Видела плащи у гвардейцев?"
    me "看到卫兵的斗篷了吗？"

# game/a15/5little_homeland.rpy:457
translate english little_homeland3_7ee00c62:

    # cass "Ага. Золотые."
    cass "嗯。金色的。"

# game/a15/5little_homeland.rpy:458
translate english little_homeland3_b039f3d4:

    # me "Отец выделил золота из казны на смену цвета плащей для гвардии?"
    me "父亲从国库拨金子给卫兵换斗篷颜色？"

# game/a15/5little_homeland.rpy:459
translate english little_homeland3_b4e0be02:

    # cass "Может больше не хочет ассоциаций с Красным Императором."
    cass "也许他不想再和红皇扯上关系。"

# game/a15/5little_homeland.rpy:460
translate english little_homeland3_8e60920e:

    # me "Похоже на то... а может и нет. Ты хоть кого-то узнала?"
    me "看起来是……也许不是。你认出谁了吗？"

# game/a15/5little_homeland.rpy:461
translate english little_homeland3_a4434748:

    # cass "Нет. Все новые лица."
    cass "没有。全是新面孔。"

# game/a15/5little_homeland.rpy:462
translate english little_homeland3_3820771a:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:463
translate english little_homeland3_01945cee:

    # cass "Поворачивать назад поздновато."
    cass "现在回头有点晚了。"

# game/a15/5little_homeland.rpy:464
translate english little_homeland3_dbbbb602:

    # me "И то верно."
    me "确实。"

# game/a15/5little_homeland.rpy:466
translate english little_homeland3_9044d50d:

    # leonard "Принц [mename], принцесса [cassa]."
    leonard "[mename]王子，[cassa]公主。"

# game/a15/5little_homeland.rpy:467
translate english little_homeland3_30d89b48:

    # cass "Лорд Леонард."
    cass "莱昂纳德领主。"

# game/a15/5little_homeland.rpy:468
translate english little_homeland3_a1dff2ab:

    # me "Лорд Леонард."
    me "莱昂纳德领主。"

# game/a15/5little_homeland.rpy:469
translate english little_homeland3_dcb3c43a:

    # leonard "Рад, что вы осилили такую трудную дорогу."
    leonard "很高兴您走完了这么艰难的路。"

# game/a15/5little_homeland.rpy:470
translate english little_homeland3_8eeb9f7b:

    # cass "И мы рады."
    cass "我们也是。"

# game/a15/5little_homeland.rpy:471
translate english little_homeland3_46731888:

    # me "Гвардия поменяла плащи?"
    me "卫队换斗篷了？"

# game/a15/5little_homeland.rpy:472
translate english little_homeland3_b0fd918a:

    # leonard "Да. Она ведь служит Золотому Порядку, а значит и цвета должны быть соответствующие."
    leonard "对。他们为黄金秩序效力，颜色自然也该相称。"

# game/a15/5little_homeland.rpy:473
translate english little_homeland3_34659f25:

    # cass "Понятно. Выглядит хорошо. А почему вы не в золотом? Вы золотому порядку не служите?"
    cass "明白了。挺好看。那您怎么没穿金色？您不为黄金秩序效力吗？"

# game/a15/5little_homeland.rpy:474
translate english little_homeland3_bf3e0682:

    # me "[cass]..."
    me "[cass]……"

# game/a15/5little_homeland.rpy:475
translate english little_homeland3_0561cbe2:

    # leonard "А я не гвардеец. Но Золотому Порядку я служу, вы правы."
    leonard "我不是卫兵。但您说得对，我为黄金秩序效力。"

# game/a15/5little_homeland.rpy:476
translate english little_homeland3_651ccc28:

    # cass "..."
    cass "……"

# game/a15/5little_homeland.rpy:477
translate english little_homeland3_3820771a_1:

    # me "..."
    me "……"

# game/a15/5little_homeland.rpy:478
translate english little_homeland3_04a735cd:

    # leonard "..."
    leonard "……"

# game/a15/5little_homeland.rpy:479
translate english little_homeland3_63e038d6:

    # cass "Так и будем стоять? Или вы дадите пройти и я наконец-то справлю свою золотую нужду, приму золотую ванну и по-золотому улягусь спать."
    cass "我们就一直站着？还是您让开，好让我终于去解决我那黄金般的需求，洗个黄金般的澡，然后黄金般地睡一觉。"

# game/a15/5little_homeland.rpy:480
translate english little_homeland3_65198be5:

    # leonard "Боюсь ванну вы сегодня не примите, принцесса [cassa]."
    leonard "恐怕您今天洗不了澡，[cassa]公主。"

# game/a15/5little_homeland.rpy:481
translate english little_homeland3_b71ac77f:

    # cass "Что это значит?"
    cass "什么意思？"

# game/a15/5little_homeland.rpy:483
translate english little_homeland3_ebe120a2:

    # leonard "Городской Трибунал приказал арестовать вас."
    leonard "城市法庭下令逮捕您。"

# game/a15/5little_homeland.rpy:484
translate english little_homeland3_4cfecd2f:

    # cass "Городской Трибунал? С чего бы вдруг?"
    cass "城市法庭？凭什么？"

# game/a15/5little_homeland.rpy:485
translate english little_homeland3_2c46e0e2:

    # leonard "После предоставленных доказательств, Трибунал решил, что вы причастны к отравлению вашего отца и к попытке узурпации власти."
    leonard "在收到证据后，法庭认定您参与了对您父亲的毒害，以及企图篡权。"

# game/a15/5little_homeland.rpy:486
translate english little_homeland3_f94ec4b8:

    # cass "Узурпации власти? Я что, ношу корону моего отца на голове, кретин?"
    cass "篡权？我头上戴着我父亲的王冠吗，白痴？"

# game/a15/5little_homeland.rpy:487
translate english little_homeland3_72acacf6:

    # leonard "Прошу, не усложняйте. Трибунал не выносит решения просто так."
    leonard "请别让事情更复杂。法庭不会无缘无故做决定。"

# game/a15/5little_homeland.rpy:488
translate english little_homeland3_4f182fdf:

    # cass "Это абсурд. Я отвергаю все обвинения. На чем вообще они строятся?"
    cass "这太荒谬了。我否认所有指控。它们到底基于什么？"

# game/a15/5little_homeland.rpy:489
translate english little_homeland3_679355ee:

    # leonard "На показаниях арестованных и на документах и письмах, что они предоставили."
    leonard "基于被捕者的证词，以及他们提供的文件和信件。"

# game/a15/5little_homeland.rpy:490
translate english little_homeland3_d5398ae0:

    # cass "Гуран..."
    cass "古兰……"

# game/a15/5little_homeland.rpy:491
translate english little_homeland3_b0a7bc97:

    # leonard "Да. Ваш дядя не стал отпираться и честно во всем признался. Как и другие ваши сообщники."
    leonard "对。您叔叔没有否认，老实承认了一切。您的其他同伙也是。"

# game/a15/5little_homeland.rpy:492
translate english little_homeland3_d3bd7015:

    # cass "Какие еще сообщники?"
    cass "还有什么同伙？"

# game/a15/5little_homeland.rpy:493
translate english little_homeland3_6626447a:

    # leonard "Головорезы с Черной Косы, которых вы переодели в форму королевской Гвардии."
    leonard "黑镰的暴徒，您把他们换上了王室卫队的制服。"

# game/a15/5little_homeland.rpy:494
translate english little_homeland3_651ccc28_1:

    # cass "..."
    cass "……"

# game/a15/5little_homeland.rpy:496
translate english little_homeland3_eadebd6c:

    # leonard "Они не много знали, но все как один, утверждали, что подчинялись вам."
    leonard "他们知道的不多，但所有人都说听命于您。"

# game/a15/5little_homeland.rpy:497
translate english little_homeland3_c7335cba:

    # harold "Принц?"
    harold "王子？"

# game/a15/5little_homeland.rpy:498
translate english little_homeland3_c01a1006:

    # me "Будьте готовы."
    me "做好准备。"

# game/a15/5little_homeland.rpy:499
translate english little_homeland3_da019721:

    # cass "А что мой отец? Если я не причастна к его отравлению он может меня защитить."
    cass "那我父亲呢？如果我没参与毒害他，他可以保护我。"

# game/a15/5little_homeland.rpy:500
translate english little_homeland3_f7b4e9f1:

    # leonard "Ваш отец был отравлен в тот день, он потерял память из-за белой крови."
    leonard "您父亲那天中了毒，因白血症失去了记忆。"

# game/a15/5little_homeland.rpy:501
translate english little_homeland3_fad05eee:

    # me "Мой отец так и сказал? Что не помнит тот день?"
    me "我父亲是这么说的？不记得那天？"

# game/a15/5little_homeland.rpy:502
translate english little_homeland3_7f8a58ef:

    # leonard "Да. Но он знаком с деталями расследования. Если он захочет - даст показания."
    leonard "对。但他了解调查细节。如果他愿意——可以作证。"

# game/a15/5little_homeland.rpy:503
translate english little_homeland3_475dd1d1:

    # cass "Так мой отец не обвинял меня, с чего вдруг Трибунал разрешил меня арестовать?"
    cass "所以我父亲没指控我。那法庭凭什么允许逮捕我？"

# game/a15/5little_homeland.rpy:504
translate english little_homeland3_85549698:

    # leonard "Ваш дядя..."
    leonard "您叔叔……"

# game/a15/5little_homeland.rpy:505
translate english little_homeland3_69eafe91:

    # cass "Мой дядя мог соврать."
    cass "我叔叔可能撒谎。"

# game/a15/5little_homeland.rpy:506
translate english little_homeland3_d94119a6:

    # leonard "И сфальсифицировать десятки писем? А ублюдки из Черной Косы? Ваш дядя нанял, чтобы вас подставить?"
    leonard "还伪造几十封信？那黑镰的杂种呢？也是您叔叔雇来陷害您的？"

# game/a15/5little_homeland.rpy:507
translate english little_homeland3_1ed2c90e:

    # cass "Моего отца отравила Прицсилла!"
    cass "是普里西拉毒了我父亲！"

# game/a15/5little_homeland.rpy:509
translate english little_homeland3_e7a5fb27:

    # leonard "Она могла быть с вами в сговоре."
    leonard "她可能与您串通。"

# game/a15/5little_homeland.rpy:510
translate english little_homeland3_d961d194:

    # cass "Она призналась."
    cass "她认罪了。"

# game/a15/5little_homeland.rpy:511
translate english little_homeland3_298926b9:

    # leonard "Может быть. Это не отменяет того факта, что вы могли действовать сообща."
    leonard "也许。但这不改变你们可能合作的事实。"

# game/a15/5little_homeland.rpy:512
translate english little_homeland3_9b789997:

    # cass "И как же Трибунал собирается это выяснить, если она мертва?"
    cass "那法庭打算怎么查清这个，如果她已经死了？"

# game/a15/5little_homeland.rpy:513
translate english little_homeland3_b57e9eb4:

    # leonard "У Трибунала есть другие доказательства вашей вины, [cassa]."
    leonard "法庭还有证明您有罪的其他证据，[cassa]。"

# game/a15/5little_homeland.rpy:514
translate english little_homeland3_459dd1fb:

    # cass "Письма? Показания моего дяди? Это все?"
    cass "信件？我叔叔的证词？就这些？"

# game/a15/5little_homeland.rpy:516
translate english little_homeland3_e7a5fb27_1:

    # leonard "Она могла быть с вами в сговоре."
    leonard "她可能与您串通。"

# game/a15/5little_homeland.rpy:517
translate english little_homeland3_10a7d5d8:

    # cass "Спросите ее сами."
    cass "您自己去问她。"

# game/a15/5little_homeland.rpy:518
translate english little_homeland3_6d742bc7:

    # leonard "Уже спросили."
    leonard "已经问过了。"

# game/a15/5little_homeland.rpy:519
translate english little_homeland3_40a6a58a:

    # cass "И что?"
    cass "然后呢？"

# game/a15/5little_homeland.rpy:520
translate english little_homeland3_028c5ca2:

    # leonard "Она отрицает вашу причастность."
    leonard "她否认您参与其中。"

# game/a15/5little_homeland.rpy:521
translate english little_homeland3_5f27faf1:

    # cass "НУ! Вот!"
    cass "看吧！这不就结了！"

# game/a15/5little_homeland.rpy:522
translate english little_homeland3_044cf435:

    # leonard "Что не отменяет факт наличия других улик, указывающих на вашу вину, [cassa]."
    leonard "但这不改变还有指向您有罪的其他证据，[cassa]。"

# game/a15/5little_homeland.rpy:523
translate english little_homeland3_459dd1fb_1:

    # cass "Письма? Показания моего дяди? Это все?"
    cass "信件？我叔叔的证词？就这些？"

# game/a15/5little_homeland.rpy:524
translate english little_homeland3_8d0b0e51:

    # leonard "Мне это надоело. Вам все объяснят в Трибунале. Аресстуйте ее."
    leonard "我受够了。到了法庭他们会向您解释一切。逮捕她。"

# game/a15/5little_homeland.rpy:529
translate english little_homeland3_06d3e544:

    # me "К оружию!"
    me "拿起武器！"

# game/a15/5little_homeland.rpy:530
translate english little_homeland3_fe16dfa8:

    # harold "Следи за спиной, Рекс."
    harold "注意背后，雷克斯。"

# game/a15/5little_homeland.rpy:531
translate english little_homeland3_be8fd377:

    # cass "Вы используете оружие против детей вашего Императора."
    cass "你们竟对自己皇帝的孩子动武。"

# game/a15/5little_homeland.rpy:532
translate english little_homeland3_06dd84fe:

    # leonard "Постойте..."
    leonard "住手……"

# game/a15/5little_homeland.rpy:533
translate english little_homeland3_94e3d30b:

    # cass "Вот это действительно смахивает на измену."
    cass "这才真像是叛国。"

# game/a15/5little_homeland.rpy:534
translate english little_homeland3_6dca2400:

    # leonard "Вы усложняете необходимый процесс."
    leonard "您在让必要程序复杂化。"

# game/a15/5little_homeland.rpy:535
translate english little_homeland3_fee12235:

    # cass "Вы решили так отомстить мне за вашего сына?"
    cass "您就这么为您儿子向我报仇？"

# game/a15/5little_homeland.rpy:536
translate english little_homeland3_73e9b94b:

    # leonard "Я действую согласно Золотому Порядку."
    leonard "我是在按黄金秩序行事。"

# game/a15/5little_homeland.rpy:537
translate english little_homeland3_dbae09cd:

    # cass "Я арестовала его, как и всех гостей, мне надо было выяснить, кто является отравителем. Я не виновата, что он решил бежать и попытался убить стражника."
    cass "我逮捕了他，和所有客人一样，我需要查明下毒者是谁。他想逃、还试图杀守卫，这不是我的错。"

# game/a15/5little_homeland.rpy:538
translate english little_homeland3_145826ad:

    # leonard "Не волнуйтесь, показания арестованных знатных гостей тоже часть обвинения Трибунала."
    leonard "别担心。被捕贵族客人的证词也是法庭指控的一部分。"

# game/a15/5little_homeland.rpy:539
translate english little_homeland3_d5a41a13:

    # cass "И что же такого в их показаниях?"
    cass "他们的证词里有什么特别的？"

# game/a15/5little_homeland.rpy:540
translate english little_homeland3_c842f588:

    # leonard "Вы им угрожали."
    leonard "您威胁过他们。"

# game/a15/5little_homeland.rpy:541
translate english little_homeland3_51fed9aa:

    # cass "Угрожала? Я требовала от них сотрудничества."
    cass "威胁？我要求他们合作。"

# game/a15/5little_homeland.rpy:542
translate english little_homeland3_1b5303ef:

    # leonard "Признания ваших нелегитимных полномочий."
    leonard "承认您不合法的权力。"

# game/a15/5little_homeland.rpy:543
translate english little_homeland3_3f3a06c4:

    # cass "Я сняла их с себя, когда кризис миновал."
    cass "危机过去后我就卸下了权力。"

# game/a15/5little_homeland.rpy:544
translate english little_homeland3_38533726:

    # leonard "Какая щедрость."
    leonard "真是慷慨。"

# game/a15/5little_homeland.rpy:546
translate english little_homeland3_fb5adb19:

    # me "В чем обвиняется моя сестра?"
    me "我妹妹被指控什么？"

# game/a15/5little_homeland.rpy:547
translate english little_homeland3_e3e6440b:

    # leonard "Принц [mename], я уже сказал..."
    leonard "[mename]王子，我已经说了……"

# game/a15/5little_homeland.rpy:548
translate english little_homeland3_ec560b84:

    # me "В отравлении моего отца? В этом признался другой человек. А мой отец - жив. И не назвал мою сестру отравителем."
    me "毒害我父亲？另一个人已经认罪了。而我父亲还活着。他也没说我妹妹是下毒者。"

# game/a15/5little_homeland.rpy:549
translate english little_homeland3_5e57f448:

    # leonard "Но..."
    leonard "但……"

# game/a15/5little_homeland.rpy:550
translate english little_homeland3_74677977:

    # me "Полномочия, что взвалила на себя моя сестра были необходимостью. Мы искали убийцу. Она хотела узурпировать власть? Тогда зачем она от нее отказалась?"
    me "我妹妹承担的权力是必要的。我们在找凶手。她想篡权？那她为什么又放弃了？"

# game/a15/5little_homeland.rpy:551
translate english little_homeland3_04a735cd_1:

    # leonard "..."
    leonard "……"

# game/a15/5little_homeland.rpy:552
translate english little_homeland3_1f94198f:

    # me "Моя сестра - главная причина по которой наша Империя это Империя, а не королевство. Но что-то я не вижу на ней короны Запада. Она передала ее моему отцу, как и положено."
    me "我妹妹是我们帝国仍是帝国而非王国的首要原因。可我没在她头上看到西方王冠。她按规矩把它交还给了我父亲。"

# game/a15/5little_homeland.rpy:553
translate english little_homeland3_f7e776f8:

    # leonard "Ее дядя..."
    leonard "她叔叔……"

# game/a15/5little_homeland.rpy:554
translate english little_homeland3_b36a20b6:

    # me "Ее дядя мог наплести любой чуши. Моя сестра нашла каменного советника получше и он затаил обиду."
    me "她叔叔可以胡编乱造。我妹妹找到了更好的石顾问，他就怀恨在心。"

# game/a15/5little_homeland.rpy:555
translate english little_homeland3_8dc99737:

    # leonard "Гвардейцев она тоже нашла 'получше'?"
    leonard "卫兵她也是找到了‘更好的’？"

# game/a15/5little_homeland.rpy:556
translate english little_homeland3_394a9dec:

    # me "А гвардейцы, что стоят по обе стороны от вас, я их раньше не видел. Привезли их с собой из Арании? Если я прикажу им опустить мечи, они послушают вас или меня?"
    me "那站在您两边的卫兵，我以前没见过。是从阿拉尼亚带来的？如果我命令他们放下剑，他们会听您的还是听我的？"

# game/a15/5little_homeland.rpy:557
translate english little_homeland3_04a735cd_2:

    # leonard "..."
    leonard "……"

# game/a15/5little_homeland.rpy:558
translate english little_homeland3_449f29bf:

    # me "Оу...Похоже Трибуналу надо арестовать не только мою сестру, но и вас."
    me "哦……看来法庭要逮捕的不只是我妹妹，还有您。"

# game/a15/5little_homeland.rpy:559
translate english little_homeland3_dabbbc59:

    # leonard "Принц [mename]..."
    leonard "[mename]王子……"

# game/a15/5little_homeland.rpy:560
translate english little_homeland3_7b085940:

    # me "Прикажите вашим людям опустить мечи, или я вместе с настоящими гвардейцами будем биться насмерть."
    me "命令您的人放下剑，否则我和真正的卫兵会血战到底。"

# game/a15/5little_homeland.rpy:561
translate english little_homeland3_79e9068b:

    # cass "...спасибо, [mename]."
    cass "……谢谢，[mename]。"

# game/a15/5little_homeland.rpy:562
translate english little_homeland3_eb902309:

    # leonard "Опустите мечи."
    leonard "放下剑。"

# game/a15/5little_homeland.rpy:564
translate english little_homeland3_2bcc7112:

    # leonard "Вы меня неправильно поняли, принц [mename]. Ваша сестра пока только обвиняется в преступлении. Я не собирался казнить ее или..."
    leonard "您误会我了，[mename]王子。您妹妹目前只是被指控犯罪。我没打算处决她或……"

# game/a15/5little_homeland.rpy:565
translate english little_homeland3_29f436af:

    # me "Но вы собирались ее арестовать."
    me "但您打算逮捕她。"

# game/a15/5little_homeland.rpy:566
translate english little_homeland3_4e851d3a:

    # leonard "Она может быть опасна. У трибунала есть доказательства ее убийств."
    leonard "她可能很危险。法庭有她杀人的证据。"

# game/a15/5little_homeland.rpy:567
translate english little_homeland3_ab2f31c7:

    # cass "И кого же я убила?"
    cass "我杀了谁？"

# game/a15/5little_homeland.rpy:568
translate english little_homeland3_76dbe421:

    # leonard "Оракулов вашего отца."
    leonard "您父亲的先知们。"

# game/a15/5little_homeland.rpy:569
translate english little_homeland3_3fb5aa90:

    # cass "Да ну... и что же это за доказательства?"
    cass "真的吗……那是什么证据？"

# game/a15/5little_homeland.rpy:570
translate english little_homeland3_017e3777:

    # leonard "Боюсь раз ваш брат препятствует вашему аресту - я не могу разглашать эту информацию. Вы можете ей воспользоваться."
    leonard "既然您哥哥在妨碍逮捕您——恐怕我不能透露这些信息。您可能会利用它。"

# game/a15/5little_homeland.rpy:571
translate english little_homeland3_98b2e8df:

    # cass "Нет у вас никаких доказательств. Мы просто мстите мне за смерть вашего сына, хотя я в ней не виновата."
    cass "您根本没有任何证据。您只是在为您儿子的死向我报仇，虽然我对此没有责任。"

# game/a15/5little_homeland.rpy:572
translate english little_homeland3_f58a6883:

    # leonard "До этого мы дойдем позже."
    leonard "这个我们之后再说。"

# game/a15/5little_homeland.rpy:573
translate english little_homeland3_651ccc28_2:

    # cass "..."
    cass "……"

# game/a15/5little_homeland.rpy:574
translate english little_homeland3_64d9efc9:

    # me "Уберите своих людей, Леонард."
    me "让您的人退下，莱昂纳德。"

# game/a15/5little_homeland.rpy:575
translate english little_homeland3_efc5ffe5:

    # leonard "Как пожелаете, мой принц. За мной."
    leonard "如您所愿，我的王子。跟我来。"

# game/a15/5little_homeland.rpy:577
translate english little_homeland3_5776745b:

    # cass "Спасибо, [mename]."
    cass "谢谢，[mename]。"

# game/a15/5little_homeland.rpy:578
translate english little_homeland3_741ce2d1:

    # me "Не благодари. Я не мог поступить иначе."
    me "别谢。我没法不这么做。"

# game/a15/5little_homeland.rpy:580
translate english little_homeland3_5ad2e3aa:

    # cass "Вот же кусок говна."
    cass "真是个混蛋。"

# game/a15/5little_homeland.rpy:581
translate english little_homeland3_2c32ef9b:

    # me "Он не простит тебе смерть сына."
    me "他不会原谅你儿子的死。"

# game/a15/5little_homeland.rpy:582
translate english little_homeland3_786b0151:

    # cass "Я к этому отношения не имею. Он сам захотел сдохнуть. Все, кто сидели в подземеле тихо - остались в целости и сохранности."
    cass "那跟我没关系。是他自己想死。所有在地牢里老实待着的人都完好无损。"

# game/a15/5little_homeland.rpy:583
translate english little_homeland3_e1c3cff9:

    # me "Сомневаюсь, что его это успокаивает. По-моему это только бесит его сильнее. Его ребенок единственный погибший."
    me "我怀疑这安慰不了他。我觉得这只会让他更恼火。他孩子是唯一死的人。"

# game/a15/5little_homeland.rpy:584
translate english little_homeland3_a99ca7a5:

    # cass "Ну... не прям чтобы единственный."
    cass "嗯……也不完全是唯一一个。"

# game/a15/5little_homeland.rpy:585
translate english little_homeland3_094fb738:

    # me "Единственный из дворян и лордов."
    me "是贵族和领主中唯一的一个。"

# game/a15/5little_homeland.rpy:586
translate english little_homeland3_51d6f2ae:

    # cass "...да..."
    cass "……对……"

# game/a15/5little_homeland.rpy:587
translate english little_homeland3_5c55fcfa:

    # me "Тебе бы лучше пока быть под защитой. Гарольд?"
    me "你最好先待在有保护的地方。哈罗德？"

# game/a15/5little_homeland.rpy:588
translate english little_homeland3_752e8bba:

    # harold "Будет сделано."
    harold "遵命。"

# game/a15/5little_homeland.rpy:589
translate english little_homeland3_bf63c380:

    # cass "Ты прав... он не отстанет... надо бы что-то придумать..."
    cass "你说得对……他不会罢休……得想个办法……"

# game/a15/5little_homeland.rpy:590
translate english little_homeland3_bf3e0682_1:

    # me "[cass]..."
    me "[cass]……"

# game/a15/5little_homeland.rpy:591
translate english little_homeland3_a6424325:

    # cass "Нет. Нет. Ты меня неправильно понял. Я не собираюсь его убивать. Но в одном замке мы с ним не уживемся."
    cass "不。不。你误会了。我不打算杀他。但我们没法住在同一座城堡里。"

# game/a15/5little_homeland.rpy:592
translate english little_homeland3_3a3e8710:

    # me "Это точно."
    me "这倒是。"

# game/a15/5little_homeland.rpy:593
translate english little_homeland3_e05aa48b:

    # cass "Ладно. Что-нибудь придумаю. Сообщу тебе на днях."
    cass "好吧。我会想办法。过几天告诉你。"

# game/a15/5little_homeland.rpy:594
translate english little_homeland3_bebce7b5:

    # me "Хорошо. Тогда до встречи?"
    me "好。那就再会？"

# game/a15/5little_homeland.rpy:595
translate english little_homeland3_9d88752e:

    # cass "До встречи, [mename]."
    cass "再会，[mename]。"

# game/a15/5little_homeland.rpy:598
translate english little_homeland3_6bdc892a:

    # me "Не двигайся."
    me "别动。"

# game/a15/5little_homeland.rpy:599
translate english little_homeland3_df0d7596:

    # cass "Ты чего делаешь?"
    cass "你干什么？"

# game/a15/5little_homeland.rpy:600
translate english little_homeland3_c7335cba_1:

    # harold "Принц?"
    harold "王子？"

# game/a15/5little_homeland.rpy:601
translate english little_homeland3_016b2b1d:

    # me "Я верю Леонарду и Трибуналу. Ведь я и сам был там. В подземелье."
    me "我相信莱昂纳德和法庭。毕竟我自己也在那儿待过。在地牢里。"

# game/a15/5little_homeland.rpy:602
translate english little_homeland3_b7c1dc54:

    # cass "[mename]!"
    cass "[mename]！"

# game/a15/5little_homeland.rpy:603
translate english little_homeland3_0ed5b0b8:

    # me "Что? Думала я просто все забуду? Вы арестовали всех ее людей?"
    me "什么？你以为我会就这么忘了？她的人你们都抓了吗？"

# game/a15/5little_homeland.rpy:604
translate english little_homeland3_af3b486b:

    # leonard "До единого."
    leonard "一个不剩。"

# game/a15/5little_homeland.rpy:605
translate english little_homeland3_27fca37d:

    # me "Отлично. Тогда настал ее черед."
    me "很好。那轮到她了。"

# game/a15/5little_homeland.rpy:607
translate english little_homeland3_9174ac02:

    # cass "Пустите, ублюдки сраные!"
    cass "放开我，你们这些烂混蛋！"

# game/a15/5little_homeland.rpy:608
translate english little_homeland3_6935f114:

    # leonard "[cassa] Стархэд. Вы арестованы по запросу Городского Трибунала Золотой Столицы."
    leonard "[cassa]·斯塔赫德。您因黄金首都城市法庭的命令被捕。"

# game/a15/5little_homeland.rpy:609
translate english little_homeland3_3e7abe62:

    # cass "Это хуйня какая-то!"
    cass "这他妈什么鬼！"

# game/a15/5little_homeland.rpy:610
translate english little_homeland3_321489bb:

    # leonard "Вы обвиняетесь в попытке свержения законной власти вашего отца, а также в намерении отравить его."
    leonard "您被指控企图推翻您父亲的合法权力，以及意图毒害他。"

# game/a15/5little_homeland.rpy:611
translate english little_homeland3_54e07110:

    # cass "Сучьи дети!"
    cass "狗娘养的！"

# game/a15/5little_homeland.rpy:612
translate english little_homeland3_48e203ec:

    # leonard "Вы также обвиняетесь в незаконной узурпации неполагающихся вам властных полномочий, в роспуске совета, в незаконных арестах и удержании вне воли."
    leonard "您还被指控非法篡夺不属于您的权力、解散议会、非法逮捕和非法拘禁。"

# game/a15/5little_homeland.rpy:613
translate english little_homeland3_f31155ac:

    # cass "Отпустите!"
    cass "放开我！"

# game/a15/5little_homeland.rpy:614
translate english little_homeland3_0cc81191:

    # leonard "А также... в убийствах."
    leonard "以及……谋杀。"

# game/a15/5little_homeland.rpy:615
translate english little_homeland3_3641d5fb:

    # cass "Пидарасы!"
    cass "死基佬！"

# game/a15/5little_homeland.rpy:616
translate english little_homeland3_fec95fd8:

    # leonard "Вы будете сопровождены в тюрьму при Трибунале для дальнейшего разбирательства и суда."
    leonard "您将被押送至法庭监狱，接受进一步调查和审判。"

# game/a15/5little_homeland.rpy:618
translate english little_homeland3_44e96998:

    # cass "Предатель!"
    cass "叛徒！"

# game/a15/5little_homeland.rpy:619
translate english little_homeland3_eeb3f1eb:

    # me "Предатель? Это ты предательница."
    me "叛徒？你才是叛徒。"

# game/a15/5little_homeland.rpy:620
translate english little_homeland3_d4000767:

    # cass "Ты дал слово!"
    cass "你发过誓！"

# game/a15/5little_homeland.rpy:621
translate english little_homeland3_482f236d:

    # me "Ты взяла его у меня, когда посадила в тюрьму."
    me "你把我关进牢里的时候，就已经把它拿走了。"

# game/a15/5little_homeland.rpy:622
translate english little_homeland3_25141823:

    # cass "И все же ты его дал."
    cass "可你还是发了。"

# game/a15/5little_homeland.rpy:623
translate english little_homeland3_8c954312:

    # me "Не учи меня чести, отцеубийца."
    me "别教我什么叫荣誉，弑父者。"

# game/a15/5little_homeland.rpy:624
translate english little_homeland3_a1ea75cb:

    # cass "Наш отец жив."
    cass "我们的父亲还活着。"

# game/a15/5little_homeland.rpy:625
translate english little_homeland3_025e1324:

    # me "К твоему большому сожалению."
    me "让你非常遗憾。"

# game/a15/5little_homeland.rpy:626
translate english little_homeland3_903aa384:

    # cass "Будь ты проклят! Кусок дерьма! Идиот! Предатель!"
    cass "你不得好死！一坨屎！白痴！叛徒！"

# game/a15/5little_homeland.rpy:627
translate english little_homeland3_0ce53b99:

    # me "Прибереги свое красноречие для суда."
    me "把你的口才留到法庭上吧。"

# game/a15/5little_homeland.rpy:628
translate english little_homeland3_4d56e3ba:

    # cass "Хуесос!"
    cass "屌吸子！"

# game/a15/5little_homeland.rpy:629
translate english little_homeland3_dddb5c19:

    # leonard "Уведите ее уже."
    leonard "把她带走吧。"

# game/a15/5little_homeland.rpy:631
translate english little_homeland3_d469ae9f:

    # me "Мой отец знает?"
    me "我父亲知道吗？"

# game/a15/5little_homeland.rpy:632
translate english little_homeland3_ac583a08:

    # leonard "Да."
    leonard "知道。"

# game/a15/5little_homeland.rpy:633
translate english little_homeland3_05d04b51:

    # me "И о расследовании и об аресте?"
    me "调查和逮捕他都知道？"

# game/a15/5little_homeland.rpy:634
translate english little_homeland3_26239ef6:

    # leonard "Да. Он сказал действовать согласно правилам Золотого Порядка, но не вредить тебе."
    leonard "对。他吩咐按黄金秩序的规矩行事，但不要伤害你。"

# game/a15/5little_homeland.rpy:635
translate english little_homeland3_0686c829:

    # me "Ну... мне никто не навредил. А вот что будет с ней?"
    me "嗯……没人伤害我。那她会怎样？"

# game/a15/5little_homeland.rpy:636
translate english little_homeland3_b2dd3e02:

    # leonard "Зависит от того, что докажет Трибунал. В любом случае свободы она больше не увидит."
    leonard "取决于法庭能证明什么。无论如何，她再也见不到自由了。"

# game/a15/5little_homeland.rpy:637
translate english little_homeland3_0de30cb3:

    # me "Смертная казнь?"
    me "死刑？"

# game/a15/5little_homeland.rpy:638
translate english little_homeland3_11b9b7aa:

    # leonard "Может быть. Разве что ваш отец не захочет даровать ей жизнь."
    leonard "也许。除非您父亲愿意饶她一命。"

# game/a15/5little_homeland.rpy:639
translate english little_homeland3_9ee8d9b2:

    # me "И что тогда?"
    me "那然后呢？"

# game/a15/5little_homeland.rpy:640
translate english little_homeland3_745993d2:

    # leonard "Тогда она проведет остаток жизни в какой-нибудь башне."
    leonard "那她就会在某座塔里度过余生。"

# game/a15/5little_homeland.rpy:641
translate english little_homeland3_54235078:

    # me "...спасибо, что помогли мне."
    me "……谢谢您帮我。"

# game/a15/5little_homeland.rpy:642
translate english little_homeland3_54bac767:

    # leonard "Это мой долг. Да будет воля вашего отца железом."
    leonard "这是我的职责。愿您父亲的意志如铁。"

# game/a15/5little_homeland.rpy:643
translate english little_homeland3_51c65b91:

    # me "Да будет Золотой Порядок вечен."
    me "愿黄金秩序永存。"

# game/a15/5little_homeland.rpy:647
translate english little_homeland3_06d3e544_1:

    # me "К оружию!"
    me "拿起武器！"

# game/a15/5little_homeland.rpy:648
translate english little_homeland3_fe16dfa8_1:

    # harold "Следи за спиной, Рекс."
    harold "注意背后，雷克斯。"

# game/a15/5little_homeland.rpy:649
translate english little_homeland3_be8fd377_1:

    # cass "Вы используете оружие против детей вашего Императора."
    cass "你们竟对自己皇帝的孩子动武。"

# game/a15/5little_homeland.rpy:650
translate english little_homeland3_06dd84fe_1:

    # leonard "Постойте..."
    leonard "住手……"

# game/a15/5little_homeland.rpy:651
translate english little_homeland3_94e3d30b_1:

    # cass "Вот это действительно смахивает на измену."
    cass "这才真像是叛国。"

# game/a15/5little_homeland.rpy:652
translate english little_homeland3_6dca2400_1:

    # leonard "Вы усложняете необходимый процесс."
    leonard "您在让必要程序复杂化。"

# game/a15/5little_homeland.rpy:653
translate english little_homeland3_fee12235_1:

    # cass "Вы решили так отомстить мне за вашего сына?"
    cass "您就这么为您儿子向我报仇？"

# game/a15/5little_homeland.rpy:654
translate english little_homeland3_73e9b94b_1:

    # leonard "Я действую согласно Золотому Порядку."
    leonard "我是在按黄金秩序行事。"

# game/a15/5little_homeland.rpy:655
translate english little_homeland3_dbae09cd_1:

    # cass "Я арестовала его, как и всех гостей, мне надо было выяснить, кто является отравителем. Я не виновата, что он решил бежать и попытался убить стражника."
    cass "我逮捕了他，和所有客人一样，我需要查明下毒者是谁。他想逃、还试图杀守卫，这不是我的错。"

# game/a15/5little_homeland.rpy:656
translate english little_homeland3_145826ad_1:

    # leonard "Не волнуйтесь, показания арестованных знатных гостей тоже часть обвинения Трибунала."
    leonard "别担心。被捕贵族客人的证词也是法庭指控的一部分。"

# game/a15/5little_homeland.rpy:657
translate english little_homeland3_d5a41a13_1:

    # cass "И что же такого в их показаниях?"
    cass "他们的证词里有什么特别的？"

# game/a15/5little_homeland.rpy:658
translate english little_homeland3_c842f588_1:

    # leonard "Вы им угрожали."
    leonard "您威胁过他们。"

# game/a15/5little_homeland.rpy:659
translate english little_homeland3_51fed9aa_1:

    # cass "Угрожала? Я требовала от них сотрудничества."
    cass "威胁？我要求他们合作。"

# game/a15/5little_homeland.rpy:660
translate english little_homeland3_1b5303ef_1:

    # leonard "Признания ваших нелегитимных полномочий."
    leonard "承认您不合法的权力。"

# game/a15/5little_homeland.rpy:661
translate english little_homeland3_99eac84a:

    # cass "Я сняла их себя, когда кризис миновал."
    cass "危机过去后我就卸下了权力。"

# game/a15/5little_homeland.rpy:662
translate english little_homeland3_38533726_1:

    # leonard "Какая щедрость."
    leonard "真是慷慨。"

# game/a15/5little_homeland.rpy:664
translate english little_homeland3_fb5adb19_1:

    # me "В чем обвиняется моя сестра?"
    me "我妹妹被指控什么？"

# game/a15/5little_homeland.rpy:665
translate english little_homeland3_e3e6440b_1:

    # leonard "Принц [mename], я уже сказал..."
    leonard "[mename]王子，我已经说了……"

# game/a15/5little_homeland.rpy:666
translate english little_homeland3_ec560b84_1:

    # me "В отравлении моего отца? В этом признался другой человек. А мой отец - жив. И не назвал мою сестру отравителем."
    me "毒害我父亲？另一个人已经认罪了。而我父亲还活着。他也没说我妹妹是下毒者。"

# game/a15/5little_homeland.rpy:667
translate english little_homeland3_5e57f448_1:

    # leonard "Но..."
    leonard "但……"

# game/a15/5little_homeland.rpy:668
translate english little_homeland3_74677977_1:

    # me "Полномочия, что взвалила на себя моя сестра были необходимостью. Мы искали убийцу. Она хотела узурпировать власть? Тогда зачем она от нее отказалась?"
    me "我妹妹承担的权力是必要的。我们在找凶手。她想篡权？那她为什么又放弃了？"

# game/a15/5little_homeland.rpy:669
translate english little_homeland3_04a735cd_3:

    # leonard "..."
    leonard "……"

# game/a15/5little_homeland.rpy:670
translate english little_homeland3_1f94198f_1:

    # me "Моя сестра - главная причина по которой наша Империя это Империя, а не королевство. Но что-то я не вижу на ней короны Запада. Она передала ее моему отцу, как и положено."
    me "我妹妹是我们帝国仍是帝国而非王国的首要原因。可我没在她头上看到西方王冠。她按规矩把它交还给了我父亲。"

# game/a15/5little_homeland.rpy:671
translate english little_homeland3_f7e776f8_1:

    # leonard "Ее дядя..."
    leonard "她叔叔……"

# game/a15/5little_homeland.rpy:672
translate english little_homeland3_b36a20b6_1:

    # me "Ее дядя мог наплести любой чуши. Моя сестра нашла каменного советника получше и он затаил обиду."
    me "她叔叔可以胡编乱造。我妹妹找到了更好的石顾问，他就怀恨在心。"

# game/a15/5little_homeland.rpy:673
translate english little_homeland3_8dc99737_1:

    # leonard "Гвардейцев она тоже нашла 'получше'?"
    leonard "卫兵她也是找到了‘更好的’？"

# game/a15/5little_homeland.rpy:674
translate english little_homeland3_394a9dec_1:

    # me "А гвардейцы, что стоят по обе стороны от вас, я их раньше не видел. Привезли их с собой из Арании? Если я прикажу им опустить мечи, они послушают вас или меня?"
    me "那站在您两边的卫兵，我以前没见过。是从阿拉尼亚带来的？如果我命令他们放下剑，他们会听您的还是听我的？"

# game/a15/5little_homeland.rpy:675
translate english little_homeland3_04a735cd_4:

    # leonard "..."
    leonard "……"

# game/a15/5little_homeland.rpy:676
translate english little_homeland3_449f29bf_1:

    # me "Оу...Похоже Трибуналу надо арестовать не только мою сестру, но и вас."
    me "哦……看来法庭要逮捕的不只是我妹妹，还有您。"

# game/a15/5little_homeland.rpy:677
translate english little_homeland3_dabbbc59_1:

    # leonard "Принц [mename]..."
    leonard "[mename]王子……"

# game/a15/5little_homeland.rpy:678
translate english little_homeland3_7b085940_1:

    # me "Прикажите вашим людям опустить мечи, или я вместе с настоящими гвардейцами будем биться насмерть."
    me "命令您的人放下剑，否则我和真正的卫兵会血战到底。"

# game/a15/5little_homeland.rpy:679
translate english little_homeland3_79e9068b_1:

    # cass "...спасибо, [mename]."
    cass "……谢谢，[mename]。"

# game/a15/5little_homeland.rpy:680
translate english little_homeland3_eb902309_1:

    # leonard "Опустите мечи."
    leonard "放下剑。"

# game/a15/5little_homeland.rpy:682
translate english little_homeland3_2bcc7112_1:

    # leonard "Вы меня неправильно поняли, принц [mename]. Ваша сестра пока только обвиняется в преступлении. Я не собирался казнить ее или..."
    leonard "您误会我了，[mename]王子。您妹妹目前只是被指控犯罪。我没打算处决她或……"

# game/a15/5little_homeland.rpy:683
translate english little_homeland3_29f436af_1:

    # me "Но вы собирались ее арестовать."
    me "但您打算逮捕她。"

# game/a15/5little_homeland.rpy:684
translate english little_homeland3_4e851d3a_1:

    # leonard "Она может быть опасна. У трибунала есть доказательства ее убийств."
    leonard "她可能很危险。法庭有她杀人的证据。"

# game/a15/5little_homeland.rpy:685
translate english little_homeland3_ab2f31c7_1:

    # cass "И кого же я убила?"
    cass "我杀了谁？"

# game/a15/5little_homeland.rpy:686
translate english little_homeland3_76dbe421_1:

    # leonard "Оракулов вашего отца."
    leonard "您父亲的先知们。"

# game/a15/5little_homeland.rpy:687
translate english little_homeland3_3fb5aa90_1:

    # cass "Да ну... и что же это за доказательства?"
    cass "真的吗……那是什么证据？"

# game/a15/5little_homeland.rpy:688
translate english little_homeland3_017e3777_1:

    # leonard "Боюсь раз ваш брат препятствует вашему аресту - я не могу разглашать эту информацию. Вы можете ей воспользоваться."
    leonard "既然您哥哥在妨碍逮捕您——恐怕我不能透露这些信息。您可能会利用它。"

# game/a15/5little_homeland.rpy:689
translate english little_homeland3_98b2e8df_1:

    # cass "Нет у вас никаких доказательств. Мы просто мстите мне за смерть вашего сына, хотя я в ней не виновата."
    cass "您根本没有任何证据。您只是在为您儿子的死向我报仇，虽然我对此没有责任。"

# game/a15/5little_homeland.rpy:690
translate english little_homeland3_f58a6883_1:

    # leonard "До этого мы дойдем позже."
    leonard "这个我们之后再说。"

# game/a15/5little_homeland.rpy:691
translate english little_homeland3_651ccc28_3:

    # cass "..."
    cass "……"

# game/a15/5little_homeland.rpy:692
translate english little_homeland3_64d9efc9_1:

    # me "Уберите своих людей, Леонард."
    me "让您的人退下，莱昂纳德。"

# game/a15/5little_homeland.rpy:693
translate english little_homeland3_efc5ffe5_1:

    # leonard "Как пожелаете, мой принц. За мной."
    leonard "如您所愿，我的王子。跟我来。"

# game/a15/5little_homeland.rpy:695
translate english little_homeland3_5776745b_1:

    # cass "Спасибо, [mename]."
    cass "谢谢，[mename]。"

# game/a15/5little_homeland.rpy:696
translate english little_homeland3_741ce2d1_1:

    # me "Не благодари. Я не мог поступить иначе."
    me "别谢。我没法不这么做。"

# game/a15/5little_homeland.rpy:698
translate english little_homeland3_5ad2e3aa_1:

    # cass "Вот же кусок говна."
    cass "真是个混蛋。"

# game/a15/5little_homeland.rpy:699
translate english little_homeland3_2c32ef9b_1:

    # me "Он не простит тебе смерть сына."
    me "他不会原谅你儿子的死。"

# game/a15/5little_homeland.rpy:700
translate english little_homeland3_f3c84a22:

    # cass "Я к этому отношения не имею. Он сам захотел сдохнуть. Все кто сидели в подземелье тихо - остались в целости и сохранности."
    cass "那跟我没关系。是他自己想死。所有在地牢里老实待着的人都完好无损。"

# game/a15/5little_homeland.rpy:701
translate english little_homeland3_4522fd80:

    # me "Сомневаюсь, что его это успокаивает. По-моему, это только бесит его сильнее. Его ребенок единственный погибший."
    me "我怀疑这安慰不了他。我觉得这只会让他更恼火。他孩子是唯一死的人。"

# game/a15/5little_homeland.rpy:702
translate english little_homeland3_a99ca7a5_1:

    # cass "Ну... не прям чтобы единственный."
    cass "嗯……也不完全是唯一一个。"

# game/a15/5little_homeland.rpy:703
translate english little_homeland3_094fb738_1:

    # me "Единственный из дворян и лордов."
    me "是贵族和领主中唯一的一个。"

# game/a15/5little_homeland.rpy:704
translate english little_homeland3_51d6f2ae_1:

    # cass "...да..."
    cass "……对……"

# game/a15/5little_homeland.rpy:705
translate english little_homeland3_5c55fcfa_1:

    # me "Тебе бы лучше пока быть под защитой. Гарольд?"
    me "你最好先待在有保护的地方。哈罗德？"

# game/a15/5little_homeland.rpy:706
translate english little_homeland3_752e8bba_1:

    # harold "Будет сделано."
    harold "遵命。"

# game/a15/5little_homeland.rpy:707
translate english little_homeland3_bf63c380_1:

    # cass "Ты прав... он не отстанет... надо бы что-то придумать..."
    cass "你说得对……他不会罢休……得想个办法……"

# game/a15/5little_homeland.rpy:708
translate english little_homeland3_bf3e0682_2:

    # me "[cass]..."
    me "[cass]……"

# game/a15/5little_homeland.rpy:709
translate english little_homeland3_a6424325_1:

    # cass "Нет. Нет. Ты меня неправильно понял. Я не собираюсь его убивать. Но в одном замке мы с ним не уживемся."
    cass "不。不。你误会了。我不打算杀他。但我们没法住在同一座城堡里。"

# game/a15/5little_homeland.rpy:710
translate english little_homeland3_3a3e8710_1:

    # me "Это точно."
    me "这倒是。"

# game/a15/5little_homeland.rpy:711
translate english little_homeland3_e05aa48b_1:

    # cass "Ладно. Что-нибудь придумаю. Сообщу тебе на днях."
    cass "好吧。我会想办法。过几天告诉你。"

# game/a15/5little_homeland.rpy:712
translate english little_homeland3_bebce7b5_1:

    # me "Хорошо. Тогда до встречи?"
    me "好。那就再会？"

# game/a15/5little_homeland.rpy:713
translate english little_homeland3_9d88752e_1:

    # cass "До встречи, [mename]."
    cass "再会，[mename]。"

# game/a15/5little_homeland.rpy:717
translate english little_homeland3_8f4ff58a:

    # me "У тебя есть семья, Гарольд."
    me "你有家人吗，哈罗德？"

# game/a15/5little_homeland.rpy:718
translate english little_homeland3_b82c263e:

    # harold "Есть. Небольшая. Здесь. В городе."
    harold "有。不多。就在这里。城里。"

# game/a15/5little_homeland.rpy:719
translate english little_homeland3_fa4df690:

    # me "Тогда ты свободен."
    me "那你自由了。"

# game/a15/5little_homeland.rpy:720
translate english little_homeland3_f1080da6:

    # harold "Мой принц?"
    harold "我的王子？"

# game/a15/5little_homeland.rpy:721
translate english little_homeland3_cd8b2a43:

    # me "Отдохни. Меня сопроводят остальные."
    me "休息吧。其他人会护送我。"

# game/a15/5little_homeland.rpy:722
translate english little_homeland3_ef6031ed:

    # harold "Я капитан вашей стражи в этой поездке. Пока я не доведу вас до ваших покоев - мой дозор продолжается."
    harold "这次出行我是您的卫队队长。在把您送到寝殿之前——我的值守还没结束。"

# game/a15/5little_homeland.rpy:723
translate english little_homeland3_f4774d00:

    # me "Уверен?"
    me "确定？"

# game/a15/5little_homeland.rpy:724
translate english little_homeland3_8fd49b8c:

    # harold "Я давал клятву."
    harold "我发过誓。"

# game/a15/5little_homeland.rpy:725
translate english little_homeland3_0a018792:

    # me "Ну ладно. Тогда не буду задерживать ни тебя ни себя."
    me "那好吧。那我不耽搁你，也不耽搁自己。"

# game/a15/5little_homeland.rpy:727
translate english little_homeland3_d741cd07:

    # me "Видел новые цвета гвардии?"
    me "看到卫队的新颜色了吗？"

# game/a15/5little_homeland.rpy:728
translate english little_homeland3_f8f5a3b3:

    # harold "Ага. Золотые плащи."
    harold "嗯。金色斗篷。"

# game/a15/5little_homeland.rpy:729
translate english little_homeland3_03b75c86:

    # me "Кажется мой отец решил чуть потратиться из казны."
    me "看来我父亲决定从国库里花点钱了。"

# game/a15/5little_homeland.rpy:730
translate english little_homeland3_7ecdcb13:

    # harold "Похоже на то. Может перед свадьбой вашей сестры?"
    harold "看起来是。也许是为了您妹妹的婚礼？"

# game/a15/5little_homeland.rpy:731
translate english little_homeland3_01f7d087:

    # me "Наверное. Тебе какие цвета нравятся больше?"
    me "大概吧。你更喜欢哪种颜色？"

# game/a15/5little_homeland.rpy:732
translate english little_homeland3_55a32a69:

    # harold "Я бы хотел сохранить красные, мой принц."
    harold "我想保留红色，我的王子。"

# game/a15/5little_homeland.rpy:733
translate english little_homeland3_7b083b5d:

    # me "...тогда носи красное."
    me "……那就穿红色吧。"

# game/a15/5little_homeland.rpy:734
translate english little_homeland3_4a456423:

    # harold "Спасибо, мой принц."
    harold "谢谢，我的王子。"

# game/a15/5little_homeland.rpy:736
translate english little_homeland3_3dc3d74a:

    # leonard "Принц [mename]."
    leonard "[mename]王子。"

# game/a15/5little_homeland.rpy:737
translate english little_homeland3_a1dff2ab_1:

    # me "Лорд Леонард."
    me "莱昂纳德领主。"

# game/a15/5little_homeland.rpy:738
translate english little_homeland3_7bf00889:

    # leonard "Рад приветствовать вас в Золотой Столице."
    leonard "很高兴欢迎您来到黄金首都。"

# game/a15/5little_homeland.rpy:739
translate english little_homeland3_8f875d6d:

    # me "Здесь все хорошо?"
    me "这里一切都好吗？"

# game/a15/5little_homeland.rpy:740
translate english little_homeland3_25d3bae2:

    # leonard "Да. Более того - вашему отцу намного лучше."
    leonard "好。而且——您父亲好多了。"

# game/a15/5little_homeland.rpy:741
translate english little_homeland3_d7ad565f:

    # me "Правда? Это отличные новости. Здесь много новых лиц."
    me "真的？这消息太好了。这里好多新面孔。"

# game/a15/5little_homeland.rpy:742
translate english little_homeland3_edb98187:

    # leonard "Ваш отец расширил королевскую гвардию, раз уж теперь она стала имперской."
    leonard "既然王室卫队现在成了帝国卫队，您父亲扩充了它。"

# game/a15/5little_homeland.rpy:743
translate english little_homeland3_4d29b0ac:

    # me "Замечательно."
    me "太好了。"

# game/a15/5little_homeland.rpy:744
translate english little_homeland3_0c600535:

    # leonard "Мне любопытно, с чем вы вернулись, но подозреваю, что сейчас вы хотите помыться и отдохнуть."
    leonard "我很好奇您带回了什么，但我猜您现在想洗个澡、休息一下。"

# game/a15/5little_homeland.rpy:745
translate english little_homeland3_3608b55d:

    # me "Вы правы."
    me "您说得对。"

# game/a15/5little_homeland.rpy:746
translate english little_homeland3_7e48023b:

    # leonard "Тогда не буду вас задерживать. С возвращением, принц [mename]."
    leonard "那我就不耽搁您了。欢迎回来，[mename]王子。"

# game/a15/5little_homeland.rpy:747
translate english little_homeland3_e9ada28b:

    # me "Рад быть дома."
    me "很高兴回家。"

translate english strings:

    # game/a15/5little_homeland.rpy:526
    old "Защитить [cass]"
    new "保护[cass]"

    # game/a15/5little_homeland.rpy:526
    old "Встать на сторону Золотого Порядка"
    new "站在黄金秩序一边"

