translate english campaign3_str_254dc420:

    # me "Разве Зверь Севера будет послушно терпеть ошейник, как псина?"
    me "北方之兽会像狗一样乖乖戴着项圈吗？"

# game/a15/1campaign.rpy:314
translate english campaign3_str_c5953d2f:

    # yar "Что ты несешь?"
    yar "你在胡说什么？"

# game/a15/1campaign.rpy:316
translate english campaign3_str_43435262:

    # me "Послушная собачка Дубовицкого!"
    me "杜博维茨基的听话小狗！"

# game/a15/1campaign.rpy:317
translate english campaign3_str_fc1d7d98:

    # ice_guard2 "Стоит их разнять?"
    ice_guard2 "要不要把他们拉开？"

