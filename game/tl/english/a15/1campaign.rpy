    # me "Так..."
    me "那……"

# game/a15/1campaign.rpy:668
translate english campaign6_62801f6e:

    # gaston "Но я верю в знаки. Сегодня ночью я видел сон. Чудесный чистый дух говорил со мной."
    gaston "但我相信征兆。昨夜我做了个梦。一个奇妙纯净的灵魂和我说话。"

# game/a15/1campaign.rpy:669
translate english campaign6_fa788f00:

    # me "И что он сказал?"
    me "它说了什么？"

# game/a15/1campaign.rpy:670
translate english campaign6_b8a71e33:

    # gaston "Сказал, что я могу верить тебе. Верить в твою честь. Верить в твои слова."
    gaston "它说我可以相信你。相信你的荣誉。相信你的话。"

# game/a15/1campaign.rpy:671
translate english campaign6_4c23b8fb:

    # me "Так вы..."
    me "所以您……"

# game/a15/1campaign.rpy:672
translate english campaign6_6cb0f5a2:

    # gaston "Я проголосую так, как тебе нужно."
    gaston "我会按你需要的投票。"

# game/a15/1campaign.rpy:673
