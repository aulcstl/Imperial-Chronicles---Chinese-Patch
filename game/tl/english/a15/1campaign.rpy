translate english campaign3_str_cc304341:

    # ice_guard "Ни в коем случае."
    ice_guard "绝对不行。"

# game/a15/1campaign.rpy:319
translate english campaign3_str_8efd984f:

    # ice_guard2 "Почему? Они же дерутся. Один из них наш лорд."
    ice_guard2 "为什么？他们在打架。其中一个还是我们的领主。"

# game/a15/1campaign.rpy:320
translate english campaign3_str_1394ae36:

    # ice_guard "Вот именно. Попробуешь вмешаться - он тебе потом все зубы выбьет."
    ice_guard "正是如此。你敢插手——他之后会把你牙全打掉。"

# game/a15/1campaign.rpy:321
translate english campaign3_str_2e840c17:

    # ice_guard2 "За что?"
    ice_guard2 "为什么？"

# game/a15/1campaign.rpy:322
translate english campaign3_str_0ae387d4:

    # ice_guard "За то, что помешал честной схватке."
    ice_guard "因为你打扰了一场公平决斗。"

# game/a15/1campaign.rpy:323
translate english campaign3_str_f6f2bfa5:

    # ice_guard2 "А если он..."
    ice_guard2 "那要是他……"

# game/a15/1campaign.rpy:324
translate english campaign3_str_18a96146:

    # ice_guard "Никаких 'если'. Пока никто из них не достал меч или нож - даже не двигайся."
    ice_guard "没有什么‘要是’。只要他们没人拔出剑或刀——你就别动。"

# game/a15/1campaign.rpy:325
translate english campaign3_str_8db24c0c:

    # ice_guard2 "Ладно."
    ice_guard2 "好吧。"

# game/a15/1campaign.rpy:327
translate english campaign3_str_81e1aa8f:

    # yar "Я не собачка!"
    yar "我不是狗！"

# game/a15/1campaign.rpy:328
translate english campaign3_str_e00a9eb2:

    # me "Да вроде она и есть. По первому зову явился к хозяину."
    me "看起来就是。主人一叫就来了。"

# game/a15/1campaign.rpy:329
translate english campaign3_str_eeac2ad5:

    # yar "Это наша традиция!"
    yar "这是我们的传统！"

# game/a15/1campaign.rpy:331
translate english campaign3_str_b3eda89a:

    # yar "БЛЯДЬ!"
    yar "操！"

# game/a15/1campaign.rpy:332
translate english campaign3_str_cdd01dc4:

    # me "Традиция явится к хозяину и проголосовать как он попросит."
    me "传统就是跑到主人那里，按他要求投票。"

# game/a15/1campaign.rpy:333
translate english campaign3_str_dd5ee333:

    # yar "Неправда!"
    yar "胡说！"

# game/a15/1campaign.rpy:334
translate english campaign3_str_dae36352:

    # me "Правда."
    me "是真的。"

# game/a15/1campaign.rpy:336
translate english campaign3_str_b858ca84:

    # yar "ПОЛУЧАЙ, СУКА!"
    yar "接招吧，婊子！"

# game/a15/1campaign.rpy:337
translate english campaign3_str_9d6834f8:

    # me "Мимо. Что? Злоба разбирает от того, что я говорю правду?"
    me "没打中。怎么？我说真话让你恼羞成怒？"

# game/a15/1campaign.rpy:338
translate english campaign3_str_155ee37d:

    # yar "И что мне? Проголосовать, как ты хочешь?"
    yar "那又怎样？按你想要的投票？"

# game/a15/1campaign.rpy:340
translate english campaign3_str_3ea53209:

    # me "Нет. Просто против твоего хозяина."
    me "不。只是投反对你主人的票。"

# game/a15/1campaign.rpy:341
translate english campaign3_str_04242a8f:

    # yar "ЕБАНЫЙ РОТ!"
    yar "操他妈的！"

# game/a15/1campaign.rpy:343
translate english campaign3_str_0e55f736:

    # yar "Ахахахахха!"
    yar "哈哈哈哈哈哈！"

# game/a15/1campaign.rpy:344
translate english campaign3_str_3820771a:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:345
translate english campaign3_str_21620b3a:

    # yar "А ты молодец. Давно меня с ног никто не валил."
    yar "你不错。很久没人把我打倒了。"

# game/a15/1campaign.rpy:346
translate english campaign3_str_2d7366a2:

    # me "Давно?"
    me "很久？"

# game/a15/1campaign.rpy:347
translate english campaign3_str_7db09071:

    # yar "Очень давно. Все эти трусы ссутся драться со мной в полную силу даже когда я прошу. Но ты не стал извиняться или поддаваться."
    yar "非常久。这些懦夫就算我要求，也不敢全力和我打。但你没道歉，也没放水。"

# game/a15/1campaign.rpy:348
translate english campaign3_str_3b8d047f:

    # me "Ты первый напал."
    me "是你先动手的。"

# game/a15/1campaign.rpy:349
translate english campaign3_str_d009fb88:

    # yar "Ты первый меня оскорбил."
    yar "是你先侮辱我的。"

# game/a15/1campaign.rpy:350
translate english campaign3_str_76019d58:

    # me "Я не хотел. Просто..."
    me "我不是有意的。只是……"

# game/a15/1campaign.rpy:351
translate english campaign3_str_a3d800cd:

    # yar "Ты прав. Борис зовет меня, чтобы я проголосовал, как он хочет."
    yar "你说得对。鲍里斯叫我来，就是为了让我按他的意思投票。"

# game/a15/1campaign.rpy:353
translate english campaign3_str_d7fd06db:

    # yar "Но я не буду."
    yar "但我不会。"

# game/a15/1campaign.rpy:354
translate english campaign3_str_c1078897:

    # me "Не будешь?"
    me "不会？"

# game/a15/1campaign.rpy:355
translate english campaign3_str_4f07ed4c:

    # yar "Не буду. Я проголосую против него."
    yar "不会。我会投反对他。"

# game/a15/1campaign.rpy:356
translate english campaign3_str_9eafe13e:

    # me "За Империю?"
    me "支持帝国？"

# game/a15/1campaign.rpy:357
translate english campaign3_str_33dbbbe2:

    # yar "Ага. Но с одним условием."
    yar "对。但有一个条件。"

# game/a15/1campaign.rpy:358
translate english campaign3_str_0bedc56c:

    # me "Каким?"
    me "什么条件？"

# game/a15/1campaign.rpy:359
translate english campaign3_str_6d21ae8e:

    # yar "Мы с тобой еще пару раз подеремся."
    yar "你和我再打几架。"

# game/a15/1campaign.rpy:360
translate english campaign3_str_3820771a_1:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:361
translate english campaign3_str_2e9878dc:

    # yar "Только я буду без брони. Я из-за нее такой неповоротливый был."
    yar "不过我不穿甲。就是因为甲我才那么笨重。"

# game/a15/1campaign.rpy:362
translate english campaign3_str_d7f0e857:

    # me "Я... я согласен."
    me "我……我同意。"

# game/a15/1campaign.rpy:363
translate english campaign3_str_a69b2510:

    # yar "Ну? Подай мне руку. Я покажу тебе, почему меня зовут Северным Зверем."
    yar "怎么样？拉我一把。我会让你知道为什么他们叫我北方之兽。"

# game/a15/1campaign.rpy:368
translate english campaign4_adb20273:

    # "День спустя."
    "一天后。"

# game/a15/1campaign.rpy:369
translate english campaign4_a50b3dfe:

    # ostr_old "...снег... немного обезопашивает... да... поэтому я и поехал... не стал бы летом... неееет... точно не стал бы."
    ostr_old "……雪……稍微安全点……对……所以我才上路……夏天就不会……不……肯定不会。"

# game/a15/1campaign.rpy:370
translate english campaign4_38beb74b:

    # me "Обезопашивает?"
    me "安全点？"

# game/a15/1campaign.rpy:371
translate english campaign4_cf3d77dd:

    # ostr_old "Да. Они крадутся. Тихо. Ооо... они знают, как двигаться как мыши... нет! Они хуже! Мыши скрипят, их маленькие коготочки... шкряб...шкряб..."
    ostr_old "对。他们潜行。悄无声息。哦哦……他们知道怎么像老鼠一样移动……不！他们更糟！老鼠会吱吱叫，它们的小爪子……抓……抓……"

# game/a15/1campaign.rpy:372
translate english campaign4_3820771a:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:373
translate english campaign4_3094c778:

    # ostr_old "А у вампиров.... у них поступь хищника. Неслышимая... нееет... совершенно неслышимая..."
    ostr_old "而吸血鬼……他们有着掠食者的步伐。听不见……不……完全听不见……"

# game/a15/1campaign.rpy:374
translate english campaign4_eb3f4589:

    # me "А снег выдает их?"
    me "雪会暴露他们吗？"

# game/a15/1campaign.rpy:375
translate english campaign4_96f9c7c2:

    # ostr_old "Да! ДА! С потрохами! Выдает этих наглых, мерзких ублюдочных абоминаций!"
    ostr_old "对！对！彻底暴露！暴露这些无耻、恶心、杂种般的可憎之物！"

# game/a15/1campaign.rpy:376
translate english campaign4_613b83d3:

    # me "...понятно. Они преследуют вас?"
    me "……明白了。他们在追猎您吗？"

# game/a15/1campaign.rpy:377
translate english campaign4_fd5508f3:

    # ostr_old "Меня? Кто? Вампиры? Ну конечно. Всюду! Они хотят моей смерти!"
    ostr_old "我？谁？吸血鬼？当然。到处都是！他们想要我死！"

# game/a15/1campaign.rpy:378
translate english campaign4_06e22178:

    # me "Зачем? Почему они хотят вашей смерти? Род Острожских чем-то не угодил вампирам?"
    me "为什么？他们为什么想要您死？奥斯特罗日斯基家族哪里得罪吸血鬼了？"

# game/a15/1campaign.rpy:380
translate english campaign4_da891d09:

    # ostr_old "ТСС!!! Не так громко! Их уши улавливают звуки на чудовищных расстояниях. Не произносите мое имя."
    ostr_old "嘘！！！别那么大声！他们的耳朵能在可怕的距离外听到声音。别说我的名字。"

# game/a15/1campaign.rpy:381
translate english campaign4_4f7753af:

    # me "Но если они уже следят за вами, то какая разница?"
    me "但如果他们已经在监视您，那有什么区别？"

# game/a15/1campaign.rpy:382
translate english campaign4_a93166aa:

    # ostr_old "Следят... следят за мной... да? Откуда вы знаете? Кто вам это рассказал?"
    ostr_old "监视……监视我……是吗？您怎么知道？谁告诉您的？"

# game/a15/1campaign.rpy:383
translate english campaign4_b0572a03:

    # me "Это... общеизвестно."
    me "这是……众所周知。"

# game/a15/1campaign.rpy:384
translate english campaign4_556f22a0:

    # ostr_old "Нда... конечно... только мое имя... среди них мое имя по устам, прыгает как зайчик в снегу - прыг, прыг."
    ostr_old "嗯……当然……只是我的名字……在他们口中，我的名字像雪地里的兔子一样跳——跳，跳。"

# game/a15/1campaign.rpy:385
translate english campaign4_3820771a_1:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:386
translate english campaign4_347c3ef1:

    # ostr_old "Они меня боятся. Я убил одного однажды, я рассказывал?"
    ostr_old "他们怕我。我曾杀过一个，我讲过吗？"

# game/a15/1campaign.rpy:387
translate english campaign4_77d84309:

    # me "Лорд Острожский, я хотел поговорить о голосовании."
    me "奥斯特罗日斯基领主，我想谈谈投票的事。"

# game/a15/1campaign.rpy:388
translate english campaign4_dd2414e9:

    # ostr_old "Голосование... да... они меня преследуют... Потому что знают... они знают, что я знаю..."
    ostr_old "投票……对……他们在追猎我……因为他们知道……他们知道我知道……"

# game/a15/1campaign.rpy:390
translate english campaign4_66613fb2:

    # me "Мне нужен ваш голос. На вече."
    me "我需要您的票。在市民大会上。"

# game/a15/1campaign.rpy:391
translate english campaign4_3e8c4508:

    # ostr_old "Будет!"
    ostr_old "会有的！"

# game/a15/1campaign.rpy:392
translate english campaign4_55f55acf:

    # me "Будет?"
    me "会有？"

# game/a15/1campaign.rpy:393
translate english campaign4_970ab277:

    # ostr_old "Конечно. Без меня ничего не выйдет. Я единственный знаю их тайну. Они хотят меня убить. Хуже. Есть участь и хуже смерти."
    ostr_old "当然。没有我什么都不会成。只有我知道他们的秘密。他们想杀我。更糟。有比死亡更糟的命运。"

# game/a15/1campaign.rpy:394
translate english campaign4_38d30c7e:

    # me "Так насчет голоса..."
    me "那关于投票……"

# game/a15/1campaign.rpy:395
translate english campaign4_48ee34b4:

    # ostr_old "У... да... вам придется проголосовать за меня."
    ostr_old "呃……对……您得投票支持我。"

# game/a15/1campaign.rpy:396
translate english campaign4_abb1d063:

    # me "За вас? Я говорю о присоединении Севера к Империи..."
    me "支持您？我说的是北方加入帝国……"

# game/a15/1campaign.rpy:397
translate english campaign4_70f28e40:

    # ostr_old "Да... Империя. Я ее помню. Эти существа старше... старше империи, они были здесь до эльфов, гномов, орков и сирен. Их сущности древнее, чем любая раса на континенте, они бродили здесь на заре времен."
    ostr_old "对……帝国。我记得它。这些存在比……比帝国更古老，在精灵、矮人、兽人和海妖之前他们就在这里。他们的本质比大陆上任何种族都古老，他们在时间黎明时就游荡于此。"

# game/a15/1campaign.rpy:398
translate english campaign4_aa008a0c:

    # me "Голосование..."
    me "投票……"

# game/a15/1campaign.rpy:399
translate english campaign4_6fca4a4d:

    # ostr_old "Да... проголосуем все вместе. За сожжение каменного леса. Они прячутся там. Наверняка. Нельзя терять времени. Скорее на вече. Идемте!"
    ostr_old "对……我们一起投票。烧毁石林。他们藏在那里。肯定。不能浪费时间。快去市民大会。走吧！"

# game/a15/1campaign.rpy:401
translate english campaign4_c2e4b1ec:

    # ostr_old "Ну? Что-нибудь видели?"
    ostr_old "怎么样？看到什么了吗？"

# game/a15/1campaign.rpy:402
translate english campaign4_a692da74:

    # hunterf "Нет, мой лорд. Все хорошо."
    hunterf "没有，我的领主。一切正常。"

# game/a15/1campaign.rpy:403
translate english campaign4_d73bde4b:

    # ostr_old "Боятся... они меня боятся... проверяют..."
    ostr_old "害怕……他们怕我……在试探……"

# game/a15/1campaign.rpy:404
translate english campaign4_8153d10b:

    # hunterf "..."
    hunterf "……"

# game/a15/1campaign.rpy:405
translate english campaign4_716a9ebf:

    # ostr_old "Думают... рассуждают... пытаются понять, почему я выбрался из замка. Боятся убивать прежде, чем поймут."
    ostr_old "他们在想……在推理……想弄明白我为什么离开城堡。在弄明白之前不敢杀。"

# game/a15/1campaign.rpy:406
translate english campaign4_e6381173:

    # hunterf "Пока вы в безопасности."
    hunterf "目前您是安全的。"

# game/a15/1campaign.rpy:407
translate english campaign4_9061e910:

    # ostr_old "Да... Пока что... Колья выточены?"
    ostr_old "对……暂时……木桩削好了吗？"

# game/a15/1campaign.rpy:408
translate english campaign4_4d528aae:

    # hunterf "Да. Каждый воин сейчас с колом при себе."
    hunterf "是。每个战士现在都带着木桩。"

# game/a15/1campaign.rpy:409
translate english campaign4_07cc60d5:

    # ostr_old "А зелья?"
    ostr_old "那药水呢？"

# game/a15/1campaign.rpy:410
translate english campaign4_37005c25:

    # hunterf "Как раз варим."
    hunterf "正在熬。"

# game/a15/1campaign.rpy:411
translate english campaign4_235c8f21:

    # ostr_old "Поторопитесь... Они варят свои эликсиры, они могут усыпить всех сразу... нужно противоядие..."
    ostr_old "快点……他们在熬自己的药剂，他们能一次让所有人沉睡……需要解药……"

# game/a15/1campaign.rpy:413
translate english campaign4_6ba4758e:

    # me "{i}Ух... он совершенно помешался на вампирах.{/i}"
    me "{i}唉……他完全迷上吸血鬼了。{/i}"

# game/a15/1campaign.rpy:414
translate english campaign4_be39fd7c:

    # me "{i}Похоже договориться с ним о голосовании не выйдет.{/i}"
    me "{i}看来没法和他谈投票的事。{/i}"

# game/a15/1campaign.rpy:415
translate english campaign4_cc0bdc57:

    # me "{i}Если с ним вообще можно хоть о чем-то договориться.{/i}"
    me "{i}如果和他还能谈成任何事的话。{/i}"

# game/a15/1campaign.rpy:418
translate english campaign4_f71c90f1:

    # me "Ну?"
    me "怎么样？"

# game/a15/1campaign.rpy:419
translate english campaign4_96274fb0:

    # sona "Он ненастоящий."
    sona "他是假的。"

# game/a15/1campaign.rpy:420
translate english campaign4_7effd947:

    # me "Кто? Острожский?"
    me "谁？奥斯特罗日斯基？"

# game/a15/1campaign.rpy:421
translate english campaign4_5f778485:

    # sona "Охотник."
    sona "猎人。"

# game/a15/1campaign.rpy:422
translate english campaign4_f1343ded:

    # me "В смысле? "
    me "什么意思？"

# game/a15/1campaign.rpy:423
translate english campaign4_598a2551:

    # sona "В прямом. Шляпа с пером, рапира из серебра, колья на ремне. Этот человек прочитал пару книг про вампиров и выдает себя за них."
    sona "字面意思。插羽毛的帽子、银制细剑、腰带上的木桩。这人读了几本吸血鬼的书就冒充猎人。"

# game/a15/1campaign.rpy:424
translate english campaign4_5f9abfe2:

    # me "Уверена?"
    me "你确定？"

# game/a15/1campaign.rpy:425
translate english campaign4_a59616d9:

    # sona "Уверена. Настоящий охотник на вампиров выглядит как простой человек. Самое тяжелое это не убить вампира, а поймать его и застать врасплох."
    sona "确定。真正的吸血鬼猎人看起来就像普通人。最难的不是杀死吸血鬼，而是抓住他并出其不意。"

# game/a15/1campaign.rpy:426
translate english campaign4_f7e9899b:

    # sona "Представь, что ты идешь на охоту в лес и стучишь в барабан с криками, что ты охотник. Это идиотизм. Задача охотника спровоцировать, обмануть, а не выглядеть, как идиот."
    sona "想象你进森林打猎，却敲着鼓大喊自己是猎人。那是白痴。猎人的任务是挑衅、欺骗，而不是看起来像个白痴。"

# game/a15/1campaign.rpy:427
translate english campaign4_e578e6ca:

    # me "Ну... даже если это ненастоящий охотник, похоже Острожский ему доверяет."
    me "嗯……就算这不是真猎人，看来奥斯特罗日斯基信任他。"

# game/a15/1campaign.rpy:428
translate english campaign4_e1c193c5:

    # sona "Думаешь это можно использовать?"
    sona "你觉得这能利用？"

# game/a15/1campaign.rpy:429
translate english campaign4_482dc446:

    # me "Да. Нужна будет твоя помощь."
    me "能。需要你帮忙。"

# game/a15/1campaign.rpy:430
translate english campaign4_4d6a9af2:

    # sona "Еще бы. Что нужно сделать?"
    sona "那当然。要做什么？"

# game/a15/1campaign.rpy:431
translate english campaign4_6db384c4:

    # me "Встретимся в замке Дубовицких. Я все объясню."
    me "在杜博维茨基城堡见。我会解释一切。"

# game/a15/1campaign.rpy:434
translate english campaign4_b3f432ac:

    # cass "Ну как?"
    cass "怎么样？"

# game/a15/1campaign.rpy:435
translate english campaign4_2a54ff5c:

    # me "Ужас."
    me "糟透了。"

# game/a15/1campaign.rpy:436
translate english campaign4_a05d01b5:

    # cass "Не вышло убедить его?"
    cass "没能说服他？"

# game/a15/1campaign.rpy:437
translate english campaign4_b9ee6f0d:

    # me "Не вышло даже поговорить. Он сумасшедший."
    me "连话都说不上。他疯了。"

# game/a15/1campaign.rpy:438
translate english campaign4_34c30951:

    # cass "Прям... сумасшедший сумасшедший?"
    cass "真的……疯得彻底？"

# game/a15/1campaign.rpy:439
translate english campaign4_09124542:

    # me "Ну... он не кидался в меня своим дерьмом, что безусловно плюс, но за всю беседу он так ни разу и не услышал, что я ему говорю. Беседовал сам с собой."
    me "嗯……他没朝我扔自己的屎，这当然是好事，但整个谈话他一次都没听见我说什么。他在自说自话。"

# game/a15/1campaign.rpy:440
translate english campaign4_bc5aabc8:

    # cass "Понятно. Не отчаивайся, я нашла нам второй вариант."
    cass "明白了。别灰心，我给我们找到了第二个选择。"

# game/a15/1campaign.rpy:441
translate english campaign4_4e7dfaf3:

    # me "Какой?"
    me "什么？"

# game/a15/1campaign.rpy:442
translate english campaign4_c4378f98:

    # cass "Его сын."
    cass "他儿子。"

# game/a15/1campaign.rpy:444
translate english campaign4_1f4b7a6b:

    # me "Этот паренек?"
    me "那个小子？"

# game/a15/1campaign.rpy:445
translate english campaign4_e92cf7fd:

    # cass "Ага. Я поговорила с ним. Он и сам не в восторге от состояния своего отца."
    cass "对。我和他谈过了。他自己也对父亲的状况很不满。"

# game/a15/1campaign.rpy:446
translate english campaign4_f95c9fc9:

    # me "И?"
    me "然后？"

# game/a15/1campaign.rpy:447
translate english campaign4_d9b56103:

    # cass "Сказал, что тот опозорит весь род Острожских, если появится на вече в таком состоянии."
    cass "他说如果他父亲以这种状态出现在市民大会上，会丢尽奥斯特罗日斯基家族的脸。"

# game/a15/1campaign.rpy:448
translate english campaign4_f2d7fb5e:

    # me "Он же..."
    me "他不是……"

# game/a15/1campaign.rpy:449
translate english campaign4_c282b606:

    # cass "Нет. Нет. Я намекнула, но похоже идея преждевременной кончины отца его не устраивает."
    cass "不。不。我暗示过，但他似乎不接受父亲早逝的主意。"

# game/a15/1campaign.rpy:450
translate english campaign4_63cb07df:

    # me "В таком случае это все бесполезно."
    me "那这一切都没用。"

# game/a15/1campaign.rpy:451
translate english campaign4_c55aed64:

    # cass "Я не договорила. Он хоть и против смерти отца, но не против заменить его на вече."
    cass "我还没说完。他虽然反对父亲死，但不反对在市民大会上代替他。"

# game/a15/1campaign.rpy:452
translate english campaign4_fb59132d:

    # me "Я за него рад. Если его отец жив..."
    me "我为他高兴。如果他父亲还活着……"

# game/a15/1campaign.rpy:453
translate english campaign4_fdea5eed:

    # cass "Да дослушай ты."
    cass "你先听我说完。"

# game/a15/1campaign.rpy:454
translate english campaign4_01822020:

    # me "Ладно."
    me "好吧。"

# game/a15/1campaign.rpy:455
translate english campaign4_7a94c379:

    # cass "Он сказал, его отец во всем слушает этого шарлатана."
    cass "他说他父亲什么都听那个骗子的。"

# game/a15/1campaign.rpy:456
translate english campaign4_288fb7f4:

    # me "Охотника?"
    me "那个猎人？"

# game/a15/1campaign.rpy:457
translate english campaign4_10c4f052:

    # cass "Ага. Говорит отец сошел с ума на теме вампиров, а этот ублюдок вовремя оказался рядом."
    cass "对。他说父亲在吸血鬼这话题上疯了，而那混蛋正好及时出现。"

# game/a15/1campaign.rpy:458
translate english campaign4_9c282ae1:

    # me "Так... можно воздействовать на Острожского при помощи..."
    me "那么……可以通过……影响奥斯特罗日斯基。"

# game/a15/1campaign.rpy:459
translate english campaign4_e0e0fe03:

    # cass "Да. И сын вовсе не против, чтобы вы использовали любые методы."
    cass "对。而且儿子完全不反对你们用任何手段。"

# game/a15/1campaign.rpy:460
translate english campaign4_89b718e7:

    # me "Хорошо. Это хорошо. С этим можно что-нибудь придумать."
    me "好。很好。这可以想办法。"

# game/a15/1campaign.rpy:461
translate english campaign4_df4d5e26:

    # cass "Я молодец."
    cass "我很棒吧。"

# game/a15/1campaign.rpy:462
translate english campaign4_6fceae53:

    # me "Молодец."
    me "很棒。"

# game/a15/1campaign.rpy:463
translate english campaign4_4ca0414c:

    # cass "У меня даже есть одна идея..."
    cass "我甚至有个主意……"

# game/a15/1campaign.rpy:466
translate english campaign4_450742bd:

    # me "{i}Но может быть его сын...{/i}"
    me "{i}但也许他儿子……{/i}"

# game/a15/1campaign.rpy:467
translate english campaign4_222dd1e1:

    # me "{i}Да. Если кто и страдает от сумасшествия этого человека больше всего, так это его семья.{/i}"
    me "{i}对。若说谁最受这人疯狂的折磨，那就是他的家人。{/i}"

# game/a15/1campaign.rpy:468
translate english campaign4_ca7e7326:

    # me "{i}Стоит поговорить с ним.{/i}"
    me "{i}该和他谈谈。{/i}"

# game/a15/1campaign.rpy:470
translate english campaign4_7dac0600:

    # "Пару часов спустя."
    "几个小时后。"

# game/a15/1campaign.rpy:471
translate english campaign4_21776ac0:

    # me "{i}Ага. Вот он.{/i}"
    me "{i}啊。他在这儿。{/i}"

# game/a15/1campaign.rpy:472
translate english campaign4_92c3ca32:

    # me "{i}Нужно подгадать момент, чтобы нас никто не слышал.{/i}"
    me "{i}得找个没人听见的时机。{/i}"

# game/a15/1campaign.rpy:473
translate english campaign4_fd238b4d:

    # me "{i}Впрочем, в самом замке я могу его уже не найти.{/i}"
    me "{i}再说，进了城堡我可能就找不到他了。{/i}"

# game/a15/1campaign.rpy:475
translate english campaign4_428071cc:

    # me "Лорд Острожский."
    me "奥斯特罗日斯基领主。"

# game/a15/1campaign.rpy:476
translate english campaign4_c786b92a:

    # ostr_young "Еще не лорд."
    ostr_young "还不是领主。"

# game/a15/1campaign.rpy:477
translate english campaign4_7c55f2bc:

    # me "Как я могу вас звать?"
    me "我该怎么称呼您？"

# game/a15/1campaign.rpy:478
translate english campaign4_6bac4f3e:

    # ostr_young "Виктор."
    ostr_young "维克。"

# game/a15/1campaign.rpy:479
translate english campaign4_9b0fcf1c:

    # me "Виктор. Хорошо. Я..."
    me "维克。好。我……"

# game/a15/1campaign.rpy:480
translate english campaign4_e9a6b253:

    # ostr_young "Я знаю, кто вы. И чего вы хотите."
    ostr_young "我知道您是谁。也知道您想要什么。"

# game/a15/1campaign.rpy:481
translate english campaign4_b1766526:

    # me "Замечательно. В таком случае самое сложное позади."
    me "太好了。那最难的部分已经过去了。"

# game/a15/1campaign.rpy:482
translate english campaign4_171ccbc1:

    # ostr_young "Я все равно ничем не могу вам помочь."
    ostr_young "我仍然帮不了您。"

# game/a15/1campaign.rpy:483
translate english campaign4_22b99399:

    # me "Можете. Вы ведь будете заменять отца на совете, в случае его отсутствия."
    me "您能。如果父亲缺席，您会代替他参加议会。"

# game/a15/1campaign.rpy:484
translate english campaign4_467ccaf3:

    # ostr_young "..."
    ostr_young "……"

# game/a15/1campaign.rpy:485
translate english campaign4_02c761d0:

    # me "Разве я не прав? Уверен, что вы не хотели бы, чтобы честь вашей семьи была опорочена... болезненным состоянием ума вашего отца."
    me "我说得不对吗？我确信您不希望家族荣誉因……您父亲病态的精神状态而蒙羞。"

# game/a15/1campaign.rpy:486
translate english campaign4_9c9d531b:

    # ostr_young "И что? Вы его излечите?"
    ostr_young "那又怎样？您能治好他？"

# game/a15/1campaign.rpy:487
translate english campaign4_2bcfdb67:

    # me "Боюсь, что это маловероятно."
    me "恐怕不太可能。"

# game/a15/1campaign.rpy:488
translate english campaign4_b635b029:

    # ostr_young "Это невозможно. А заменять я могу его, только если он будет прикован к постели или умрет."
    ostr_young "那不可能。只有他卧床不起或死了，我才能代替他。"

# game/a15/1campaign.rpy:489
translate english campaign4_3820771a_2:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:490
translate english campaign4_64f1417e:

    # ostr_young "А этого я ему не желаю."
    ostr_young "而我不想让他这样。"

# game/a15/1campaign.rpy:491
translate english campaign4_9d2d464f:

    # me "Есть еще одна возможная причина."
    me "还有另一种可能的原因。"

# game/a15/1campaign.rpy:493
translate english campaign4_4a02fd7f:

    # me "Если ваш отец уедет самостоятельно. Вернется в замок. А вас оставит."
    me "如果您父亲自己离开。回城堡去。把您留下。"

# game/a15/1campaign.rpy:494
translate english campaign4_b24bdc10:

    # ostr_young "Зачем бы ему это делать?"
    ostr_young "他为什么要这么做？"

# game/a15/1campaign.rpy:495
translate english campaign4_9dd9a3d5:

    # me "Я думал, что с этим поможете мне вы."
    me "我以为这件事您会帮我。"

# game/a15/1campaign.rpy:496
translate english campaign4_e4bafc9c:

    # ostr_young "...как?"
    ostr_young "……怎么帮？"

# game/a15/1campaign.rpy:497
translate english campaign4_b56bfdb7:

    # me "Я найду способ. Все что мне нужно - ваша помощь."
    me "我会找到办法。我只需要您的帮助。"

# game/a15/1campaign.rpy:498
translate english campaign4_467ccaf3_1:

    # ostr_young "..."
    ostr_young "……"

# game/a15/1campaign.rpy:499
translate english campaign4_916632cd:

    # me "Ну же. Это честный обмен. Вы наконец замените отца на должности, на которой не следует находиться больному человеку. А я получу голос."
    me "来吧。这是公平交换。您终于能取代父亲坐上不该由病人担任的位置。而我会得到票。"

# game/a15/1campaign.rpy:500
translate english campaign4_0b8f8220:

    # ostr_young "Я не хочу ему вредить."
    ostr_young "我不想害他。"

# game/a15/1campaign.rpy:501
translate english campaign4_d50beb67:

    # me "Мы и не будем."
    me "我们不会。"

# game/a15/1campaign.rpy:502
translate english campaign4_467ccaf3_2:

    # ostr_young "..."
    ostr_young "……"

# game/a15/1campaign.rpy:503
translate english campaign4_a2b7f290:

    # me "Обещаю, ваш отец не пострадает. Если вы мне поможете."
    me "我保证，您父亲不会受伤。只要您帮我。"

# game/a15/1campaign.rpy:504
translate english campaign4_244a5373:

    # ostr_young "Как?"
    ostr_young "怎么做？"

# game/a15/1campaign.rpy:505
translate english campaign4_f4ed5acf:

    # me "Дадите ключ от его комнаты. Поговорите с ним и скажете ему то, что я вам скажу. Отвлечете на себя охотника, что вечно рядом."
    me "把他房间的钥匙给我。去和他说话，把我告诉您的话说给他听。引开那个总在旁边的猎人。"

# game/a15/1campaign.rpy:506
translate english campaign4_467ccaf3_3:

    # ostr_young "..."
    ostr_young "……"

# game/a15/1campaign.rpy:507
translate english campaign4_f46925c3:

    # me "Я не вампир. Можете проверить любыми методами."
    me "我不是吸血鬼。您可以用任何方法检查。"

# game/a15/1campaign.rpy:508
translate english campaign4_d3e251b2:

    # ostr_young "Я верю... ладно... хорошо. Я помогу вам и вы поможете мне."
    ostr_young "我相信……好吧……好。我帮您，您帮我。"

# game/a15/1campaign.rpy:511
translate english campaign4_b2d81d74:

    # me "{i}С ним не договориться.{/i}"
    me "{i}和他谈不成。{/i}"

# game/a15/1campaign.rpy:512
translate english campaign4_20cb7c68:

    # me "{i}Он слишком сумасшедший.{/i}"
    me "{i}他太疯了。{/i}"

# game/a15/1campaign.rpy:513
translate english campaign4_cb20ab87:

    # me "{i}Ладно. Он не единственный лорд с голосом.{/i}"
    me "{i}算了。他不是唯一有票的领主。{/i}"

# game/a15/1campaign.rpy:517
translate english campaign5_1fce5a74:

    # "Вечером."
    "傍晚。"

# game/a15/1campaign.rpy:518
translate english campaign5_e7d841ba:

    # me "{i}Так.. Все лорды в замке. Голосование совсем скоро.{/i}"
    me "{i}那么……所有领主都在城堡里。投票很快了。{/i}"

# game/a15/1campaign.rpy:519
translate english campaign5_8716eadd:

    # me "{i}Пора поговорить с теми, кто все время тут.{/i}"
    me "{i}该和一直在这里的人谈谈了。{/i}"

# game/a15/1campaign.rpy:520
translate english campaign5_1cb267ae:

    # me "{i}Дубовицкий не даст мне надавить на лордов в его замке.{/i}"
    me "{i}杜博维茨基不会让我在他的城堡里对领主施压。{/i}"

# game/a15/1campaign.rpy:521
translate english campaign5_85202f44:

    # me "{i}Может даже и просто поговорить будет проблемой.{/i}"
    me "{i}甚至只是谈谈都会成问题。{/i}"

# game/a15/1campaign.rpy:522
translate english campaign5_71b8ffae:

    # me "{i}Придется хитрить.{/i}"
    me "{i}得耍点手段。{/i}"

# game/a15/1campaign.rpy:523
translate english campaign5_ce1eef41:

    # me "Ну как там?"
    me "那边怎么样？"

# game/a15/1campaign.rpy:525
translate english campaign5_7259d0f4:

    # mary "Лорд Корвин ужинает в башне."
    mary "科文领主在塔里用餐。"

# game/a15/1campaign.rpy:526
translate english campaign5_50614657:

    # me "Один?"
    me "一个人？"

# game/a15/1campaign.rpy:527
translate english campaign5_05437c60:

    # mary "Двое стражников снаружи."
    mary "外面有两个守卫。"

# game/a15/1campaign.rpy:528
translate english campaign5_3820771a:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:529
translate english campaign5_1968b419:

    # mary "Я могу провести вас с другой стороны."
    mary "我可以从另一边带您进去。"

# game/a15/1campaign.rpy:530
translate english campaign5_1ecc5ebe:

    # me "Отлично. Молодец."
    me "很好。干得好。"

# game/a15/1campaign.rpy:531
translate english campaign5_3052bfbb:

    # mary "Наш... наш договор все еще в силе?"
    mary "我们……我们的约定还算数吗？"

# game/a15/1campaign.rpy:532
translate english campaign5_3dbd674e:

    # me "Разумеется."
    me "当然。"

# game/a15/1campaign.rpy:534
translate english campaign5_6779150a:

    # me "Приятного аппетита, лорд Корвин."
    me "祝您用餐愉快，科文领主。"

# game/a15/1campaign.rpy:535
translate english campaign5_018f9ffd:

    # corwin "О! [mename]! Я думал, Борис ограничивает вас в общении с лордами перед голосованием."
    corwin "哦！[mename]！我以为鲍里斯在投票前限制您和领主们接触。"

# game/a15/1campaign.rpy:536
translate english campaign5_3820771a_1:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:537
translate english campaign5_a04c308a:

    # corwin "Вы зашли через другую дверь..."
    corwin "您从另一扇门进来的……"

# game/a15/1campaign.rpy:538
translate english campaign5_80e3c235:

    # me "Если вы беспокоитесь за свою жизнь, стоит брать и свою охрану тоже."
    me "如果您担心自己的性命，也该带上自己的护卫。"

# game/a15/1campaign.rpy:539
translate english campaign5_f2b26e91:

    # corwin "Сомневаюсь, что вы здесь, чтобы мне навредить."
    corwin "我怀疑您来这里是为了害我。"

# game/a15/1campaign.rpy:540
translate english campaign5_0f44b538:

    # me "Ни в коем случае."
    me "绝无此意。"

# game/a15/1campaign.rpy:541
translate english campaign5_dbe07cd1:

    # corwin "Зачем тогда?"
    corwin "那为什么来？"

# game/a15/1campaign.rpy:542
translate english campaign5_7b464f2c:

    # me "Нам надо поговорить."
    me "我们得谈谈。"

# game/a15/1campaign.rpy:543
translate english campaign5_099d773e:

    # corwin "Этот разговор не может подождать конца моей трапезы?"
    corwin "这谈话不能等我吃完吗？"

# game/a15/1campaign.rpy:544
translate english campaign5_bba79eee:

    # me "Не может."
    me "不能。"

# game/a15/1campaign.rpy:545
translate english campaign5_3213c5fd:

    # corwin "В таком случае говорите, принц."
    corwin "那就说吧，王子。"

# game/a15/1campaign.rpy:547
translate english campaign5_93fcf002:

    # me "По поводу голосования."
    me "关于投票。"

# game/a15/1campaign.rpy:548
translate english campaign5_a8e989fe:

    # corwin "А что с ним?"
    corwin "投票怎么了？"

# game/a15/1campaign.rpy:549
translate english campaign5_20ba9bd2:

    # me "Бросьте, Лорд Корвин. Вы знаете о чем я хочу попросить."
    me "别装了，科文领主。您知道我想请求什么。"

# game/a15/1campaign.rpy:550
translate english campaign5_08cfef32:

    # corwin "Знаю - но и вы ведь знаете, как здесь обстоят дела."
    corwin "我知道——但您也知道这里的情况。"

# game/a15/1campaign.rpy:551
translate english campaign5_4e1a30ad:

    # me "И как же?"
    me "什么情况？"

# game/a15/1campaign.rpy:552
translate english campaign5_412e1ada:

    # corwin "Все уже давно решено."
    corwin "一切早就决定了。"

# game/a15/1campaign.rpy:553
translate english campaign5_7f7fb0e4:

    # me "Это не так."
    me "并非如此。"

# game/a15/1campaign.rpy:554
translate english campaign5_f97c7413:

    # corwin "Не напитайте свой сосуд иллюзий, он больно лопается о суровую реальность."
    corwin "别让你的器皿装满幻想，它撞上严酷现实会痛苦地碎裂。"

# game/a15/1campaign.rpy:555
translate english campaign5_e2a4b089:

    # me "Я говорил с лордами, что прибыли позже."
    me "我和后来到的领主谈过了。"

# game/a15/1campaign.rpy:556
translate english campaign5_26641381:

    # corwin "Все лорды уже здесь... а..."
    corwin "所有领主都已经在这里了……啊……"

# game/a15/1campaign.rpy:557
translate english campaign5_7db96596:

    # me "Угу. Я говорил с ними до того, как они попали в замок."
    me "嗯。我在他们进城堡之前和他们谈过了。"

# game/a15/1campaign.rpy:558
translate english campaign5_bd23c810:

    # corwin "И? Что они сказали? Кто-то согласился?"
    corwin "然后？他们怎么说？有人同意了吗？"

# game/a15/1campaign.rpy:559
translate english campaign5_1e575a6a:

    # me "Кто-то согласился. Кто-то нет."
    me "有人同意。有人没有。"

# game/a15/1campaign.rpy:560
translate english campaign5_d1b07b06:

    # corwin "Меня интересует конкретное число."
    corwin "我关心具体数字。"

# game/a15/1campaign.rpy:561
translate english campaign5_3e4579c0:

    # me "В этом числе вы недостающая единица."
    me "在这个数字里，您是缺少的那一个。"

# game/a15/1campaign.rpy:562
translate english campaign5_cd0d8adc:

    # corwin "..."
    corwin "……"

# game/a15/1campaign.rpy:565
translate english campaign5_bbe1cbd4:

    # me "И вы проголосуете так, как нужно мне и нашим общим друзьям."
    me "您要按我和我们共同的朋友需要的方式投票。"

# game/a15/1campaign.rpy:566
translate english campaign5_6ace59c6:

    # corwin "Друзьям?"
    corwin "朋友？"

# game/a15/1campaign.rpy:567
translate english campaign5_67aabd36:

    # me "Они ведь уже сообщили вам, что нужно помогать мне всеми доступными путями?"
    me "他们不是已经通知您要用一切可用手段帮助我吗？"

# game/a15/1campaign.rpy:568
translate english campaign5_58aa93d2:

    # corwin "Да, но..."
    corwin "是，但……"

# game/a15/1campaign.rpy:569
translate english campaign5_8ca12dbc:

    # me "Мы берем на себя все издержки, лорд Корвин. А все преимущества от этого голоса достанутся вам."
    me "我们承担所有代价，科文领主。而这一票带来的所有好处都归您。"

# game/a15/1campaign.rpy:570
translate english campaign5_3368a7e9:

    # corwin "А такие будут?"
    corwin "会有好处吗？"

# game/a15/1campaign.rpy:571
translate english campaign5_00e4b719:

    # me "Конечно будут."
    me "当然会有。"

# game/a15/1campaign.rpy:572
translate english campaign5_ff3a3489:

    # corwin "Видите ли, мой принц, если я буду единственным..."
    corwin "您看，我的王子，如果我是唯一一个……"

# game/a15/1campaign.rpy:573
translate english campaign5_81ce3cab:

    # me "Вы не будете единственным, Корвин. Просто проголосуйте. Это важно. Для нас. И для вас. Для вашего положения."
    me "您不会是唯一一个，科文。投票吧。这很重要。对我们。也对您。对您的地位。"

# game/a15/1campaign.rpy:574
translate english campaign5_cd0d8adc_1:

    # corwin "..."
    corwin "……"

# game/a15/1campaign.rpy:575
translate english campaign5_3aad8b66:

    # me "Мы договорились?"
    me "我们说定了？"

# game/a15/1campaign.rpy:576
translate english campaign5_005db286:

    # corwin "Да."
    corwin "好。"

# game/a15/1campaign.rpy:577
translate english campaign5_41a77bf6:

    # me "Вот и отлично."
    me "那就好。"

# game/a15/1campaign.rpy:581
translate english campaign5_3f7f8058:

    # me "Мне есть что вам предложить."
    me "我有东西可以给您。"

# game/a15/1campaign.rpy:582
translate english campaign5_b3cdbb07:

    # corwin "Что же?"
    corwin "什么？"

# game/a15/1campaign.rpy:583
translate english campaign5_65aac1dc:

    # me "Я слышал, что вы с лордом Пойнасом друзья."
    me "我听说您和珀纳斯领主是朋友。"

# game/a15/1campaign.rpy:584
translate english campaign5_d05543d3:

    # corwin "Ну это громко сказано... мы точно не друзья..."
    corwin "这说得太夸张了……我们肯定不是朋友……"

# game/a15/1campaign.rpy:585
translate english campaign5_a9fcc5fd:

    # me "Коллеги по ремеслу. Вы наверняка слышали, что я отдал ему Долину."
    me "同行。您肯定听说我把山谷给了他。"

# game/a15/1campaign.rpy:586
translate english campaign5_133e6573:

    # corwin "Слышал."
    corwin "听说了。"

# game/a15/1campaign.rpy:587
translate english campaign5_d3744e52:

    # me "Так вот я мог бы одним росчерком пера прекратить всю вашу нелегальную деятельность, все ваши цепочки поставок из Долины просто испарятся."
    me "我大笔一挥就能终止你们所有非法活动，你们从山谷来的所有供应链都会蒸发。"

# game/a15/1campaign.rpy:588
translate english campaign5_89297460:

    # corwin "Я не торгую с Долиной."
    corwin "我不和山谷做生意。"

# game/a15/1campaign.rpy:589
translate english campaign5_bc0469c5:

    # me "Конечно. Долина торгует с вами. Ваш замок - крупнейший черный рынок на Севере."
    me "当然。是山谷和您做生意。您的城堡是北方最大的黑市。"

# game/a15/1campaign.rpy:590
translate english campaign5_3919eac5:

    # corwin "Понятия не имею о чем вы говорите..."
    corwin "我完全不知道您在说什么……"

# game/a15/1campaign.rpy:591
translate english campaign5_8f6654e9:

    # me "Но я мог бы сделать и обратное. Позволить и вам и Пойнасу вести дела дальше. Более того. Раз уж Пойнас строит город и дорогу через Долину на Север..."
    me "但我也可以反过来。允许您和珀纳斯继续做生意。而且。既然珀纳斯正在修建城市和穿过山谷通往北方的道路……"

# game/a15/1campaign.rpy:592
translate english campaign5_a20a3eae:

    # me "Я бы мог даровать вам право обслуживать эту дорогу. Охранять ее и пользоваться так, как вам необходимо."
    me "我可以授予您维护这条路的权利。守卫它并按需使用。"

# game/a15/1campaign.rpy:593
translate english campaign5_9dd6b677:

    # corwin "Это займет целую вечность."
    corwin "那得花一辈子。"

# game/a15/1campaign.rpy:594
translate english campaign5_a5d02736:

    # me "Если Север станет частью Империи, я смогу одним указом даровать новый северный тракт через Долину в пользование вашему дому, лорд Корвин."
    me "如果北方成为帝国的一部分，我就能一道命令把穿过山谷的新北方大道授予您的家族使用，科文领主。"

# game/a15/1campaign.rpy:595
translate english campaign5_6b3c6017:

    # corwin "Звучит так же сладко, как сладок этот десерт."
    corwin "听起来和这甜点一样甜。"

# game/a15/1campaign.rpy:596
translate english campaign5_d5a95edb:

    # me "И все же это правда. Спросите у вашего друга Пойнаса, умею ли я быть щедрым. Мы договорились?"
    me "但这仍是事实。问问您的朋友珀纳斯，我是否懂得慷慨。我们说定了？"

# game/a15/1campaign.rpy:597
translate english campaign5_fba887a0:

    # corwin "Ну... если кто-то еще проголосует..."
    corwin "嗯……如果还有别人也投票……"

# game/a15/1campaign.rpy:598
translate english campaign5_2d8930ac:

    # me "Проголосуют."
    me "他们会投的。"

# game/a15/1campaign.rpy:599
translate english campaign5_b9b8163d:

    # corwin "Я не обещаю быть первым. Но если мой голос действительно будет что-то решать - я проголосую, принц [mename]."
    corwin "我不保证第一个。但如果我的票真的能决定什么——我会投，[mename]王子。"

# game/a15/1campaign.rpy:600
translate english campaign5_0726690d:

    # me "Вот и замечательно."
    me "那就好。"

# game/a15/1campaign.rpy:604
translate english campaign5_3aad8b66_1:

    # me "Мы договорились?"
    me "我们说定了？"

# game/a15/1campaign.rpy:605
translate english campaign5_5d822c5c:

    # corwin "Я..."
    corwin "我……"

# game/a15/1campaign.rpy:606
translate english campaign5_0d8536f0:

    # me "Уверен, что вы понимаете, что это решение будет выгодно и для вас."
    me "我确信您明白这个决定对您也有利。"

# game/a15/1campaign.rpy:607
translate english campaign5_8567c71f:

    # corwin "...возможно. И все же я не хотел бы... быть тем, кто первый идет в бой, если вы понимаете о чем я."
    corwin "……也许。但我还是不想……当第一个冲锋的人，如果您明白我的意思。"

# game/a15/1campaign.rpy:608
translate english campaign5_2ebeb6ef:

    # me "Но если бы кто-то другой был в авангарде."
    me "但如果别人在前面。"

# game/a15/1campaign.rpy:609
translate english campaign5_7577a4fa:

    # corwin "Мне было бы проще принять это решение."
    corwin "我会更容易做这个决定。"

# game/a15/1campaign.rpy:610
translate english campaign5_dfe54e9a:

    # me "Понимаю. В таком случае я постараюсь, чтобы вы шли в обозе."
    me "明白。那我会尽量让您走在辎重队里。"

# game/a15/1campaign.rpy:611
translate english campaign5_c6cb3c48:

    # corwin "Благодарю, мой принц."
    corwin "谢谢，我的王子。"

# game/a15/1campaign.rpy:614
translate english campaign6_da8e2d4c:

    # "Утром следующего дня."
    "第二天早上。"

# game/a15/1campaign.rpy:615
translate english campaign6_e9a6579c:

    # gaston "...боюсь подобные решения ничего не меняют."
    gaston "……恐怕这样的决定改变不了什么。"

# game/a15/1campaign.rpy:616
translate english campaign6_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/1campaign.rpy:617
translate english campaign6_68d67b15:

    # gaston "Это все просто рассуждения о форме, а не о содержании. Важна не корона, а голова на которой она держится."
    gaston "这些都只是在谈形式，不是内容。重要的不是王冠，而是戴它的那颗脑袋。"

# game/a15/1campaign.rpy:618
translate english campaign6_3820771a:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:619
translate english campaign6_edb30b70:

    # gaston "Не подумайте, принц, я вовсе не считаю вас неспособным правителем."
    gaston "别误会，王子，我并不认为您是无能的统治者。"

# game/a15/1campaign.rpy:621
translate english campaign6_e739778a:

    # me "Так в чем же тогда дело?"
    me "那问题在哪里？"

# game/a15/1campaign.rpy:622
translate english campaign6_e3862ff2:

    # gaston "В том, что Борис достаточно компетентен. А любая смена власти - это потрясение."
    gaston "在于鲍里斯已经足够胜任。而任何权力更替都是动荡。"

# game/a15/1campaign.rpy:623
translate english campaign6_2f505bb9:

    # me "Вхождение в состав Империи на правах автономии не подразумевает смену власти. Скорее ее трансформацию. Это даст Северу множество преимуществ."
    me "以自治身份加入帝国并不意味着权力更替。更像是转型。这会给北方带来许多优势。"

# game/a15/1campaign.rpy:624
translate english campaign6_8b32c621:

    # gaston "А в чем же преимущество для тебя? В блеске короны? Если подобное решение не добавит тебе власти, не стоит так сильно на это тратиться."
    gaston "那对你有什么好处？王冠的光辉？如果这样的决定不会给你增加权力，就不值得花这么大力气。"

# game/a15/1campaign.rpy:625
translate english campaign6_d4e1a55c:

    # me "Дело не только во власти."
    me "不只是为了权力。"

# game/a15/1campaign.rpy:626
translate english campaign6_799ee747:

    # gaston "А в чем же еще?"
    gaston "那还为了什么？"

# game/a15/1campaign.rpy:627
translate english campaign6_a4425102:

    # me "В единстве."
    me "统一。"

# game/a15/1campaign.rpy:628
translate english campaign6_c87f86f9:

    # gaston "Единство бывает разное."
    gaston "统一有很多种。"

# game/a15/1campaign.rpy:629
translate english campaign6_6a3aacee:

    # me "Естественно. Именно поэтому я здесь и говорю с вами."
    me "自然。所以我在这里和您说话。"

# game/a15/1campaign.rpy:630
translate english campaign6_50b8dfbc:

    # gaston "Ты похож на своего деда."
    gaston "你像你祖父。"

# game/a15/1campaign.rpy:631
translate english campaign6_14c46ea9:

    # me "Я не он. Я не хочу ни войны ни насилия. Сейчас, Око Бури стихло, торговля с Востоком процветает. Горы снова одарили златоносную реку сверкающими плодами. Запад снова часть Империи."
    me "我不是他。我不想要战争，也不想要暴力。如今风暴之眼已平息，与东方的贸易繁荣。群山再次赐予产金之河闪耀的果实。西方再次成为帝国的一部分。"

# game/a15/1campaign.rpy:632
translate english campaign6_fe75fdd4:

    # me "Долина становится безопасней. Мой брак обеспечил крепкий союз. У меня родился наследник. Наш новый Золотой Век начинается. И я хочу, чтобы вместе со мной его рассвет увидел и Север."
    me "山谷变得更安全。我的婚姻确保了牢固联盟。我有了继承人。我们新的黄金时代正在开始。我希望北方也能和我一起看到它的黎明。"

# game/a15/1campaign.rpy:633
translate english campaign6_5cffc61b:

    # gaston "..."
    gaston "……"

# game/a15/1campaign.rpy:634
translate english campaign6_5c5effb2:

    # me "Неужели я никак не могу убедить вас в своих добрых намерениях, лорд Гастон?"
    me "难道我完全无法让您相信我的善意吗，加斯顿领主？"

# game/a15/1campaign.rpy:637
translate english campaign6_e7e362c6:

    # gaston "Тебе и не нужно меня убеждать. Я тебе верю."
    gaston "你不需要说服我。我相信你。"

# game/a15/1campaign.rpy:638
translate english campaign6_489a247d:

    # me "Правда?"
    me "真的？"

# game/a15/1campaign.rpy:639
translate english campaign6_04008049:

    # gaston "Да. Я не думаю, что ты плохой человек. Ты напоминаешь мне Лотрика. Молодого Лотрика. Он был человеком чести. Проявил ко мне милосердие."
    gaston "是的。我不认为你是坏人。你让我想起洛特里克。年轻的洛特里克。他是个有荣誉的人。对我展现过仁慈。"

# game/a15/1campaign.rpy:640
translate english campaign6_18dfa619:

    # me "Когда?"
    me "什么时候？"

# game/a15/1campaign.rpy:641
translate english campaign6_eb6d4263:

    # gaston "Так давно... еще до рождения твоего отца. Я всю жизнь думал, что обязан отплатить ему. Но когда мы встретились опять, он уже не был Лотриком. Он был Красным Императором."
    gaston "很久以前……还在你父亲出生之前。我一生都以为我欠他回报。但当我们再次相遇时，他不再是洛特里克。他是红皇。"

# game/a15/1campaign.rpy:642
translate english campaign6_3820771a_1:

    # me "..."
    me "……"

# game/a15/1campaign.rpy:643
translate english campaign6_9bdfc9ab:

    # gaston "Мне некому было возвращать долг. Но теперь я вижу... вижу, что судьба подарила мне второй шанс."
    gaston "我已无人可以偿还那笔债。但现在我明白……命运给了我第二次机会。"

# game/a15/1campaign.rpy:644
translate english campaign6_5e9878ef:

    # me "Так... вы с самого начала хотели мне помочь?"
    me "那……您从一开始就想帮我？"

# game/a15/1campaign.rpy:645
translate english campaign6_b131fb53:

    # gaston "Конечно нет. Но твоя речь звучала убедительно. Я бы сомневался в ней, как и следует сомневаться в любых словах, но я доверяю не только своим собственным суждениям."
    gaston "当然不是。但你的话听起来有说服力。我本该怀疑它，就像该怀疑任何话一样，但我并不只相信自己的判断。"

# game/a15/1campaign.rpy:646
translate english campaign6_95b70e2e:

    # gaston "Моя жена и мой сын доверяют вам. Говорят, что вы человек слова. К тому же мы скоро породнимся, верно?"
    gaston "我的妻子和儿子信任您。他们说您是守信之人。而且我们很快会结为姻亲，对吧？"

# game/a15/1campaign.rpy:647
translate english campaign6_eb0d474a:

    # me "Верно."
    me "对。"

# game/a15/1campaign.rpy:648
translate english campaign6_55bae69f:

    # gaston "Но прежде чем вы уйдете я должен сказать вам."
    gaston "但在您离开前，我必须告诉您。"

# game/a15/1campaign.rpy:649
translate english campaign6_e79d0fd5:

    # me "Да?"
    me "什么？"

# game/a15/1campaign.rpy:650
translate english campaign6_64057423:

    # gaston "Я проголосую так, как вы хотите, но я остаюсь при своем мнении. Ничего не поменяется. Ищите друзей, а не водружайте короны на голову."
    gaston "我会按您希望的投票，但我保留自己的看法。什么都不会改变。去寻找朋友，而不是把王冠往头上戴。"

# game/a15/1campaign.rpy:651
translate english campaign6_b07922bd:

    # gaston "Корона не возьмет меч, чтобы умереть за вас и даже оплакать вас не сможет."
    gaston "王冠不会拿起剑为您而死，甚至无法为您哀悼。"

# game/a15/1campaign.rpy:652
translate english campaign6_97071b38:

    # me "Я понимаю это."
    me "我明白。"

# game/a15/1campaign.rpy:653
translate english campaign6_586dbff3:

    # gaston "Хорошо. Это значит, что вы уже хоть чуть-чуть ближе к тому, чтобы быть достойным этой короны на самом деле."
    gaston "好。这意味着您已经稍微接近真正配得上这顶王冠了。"

# game/a15/1campaign.rpy:654
translate english campaign6_de5384df:

    # me "Спасибо, лорд Гастон. И за ваше решение и за ваш совет."
    me "谢谢您，加斯顿领主。既感谢您的决定，也感谢您的忠告。"

# game/a15/1campaign.rpy:658
