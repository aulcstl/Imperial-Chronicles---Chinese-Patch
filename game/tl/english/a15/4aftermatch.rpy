    lotric "是啊……某种短暂、遥远的东西。溶在雾里。我一伸手，它就消失了……"

# game/a15/4aftermatch.rpy:732
translate english aftermatch_god_11ff0a61:

    # zwetana "Понятно... слуга принес вам вина, будете?"
    zwetana "明白了……仆人给您拿酒来了，要喝吗？"

# game/a15/4aftermatch.rpy:734
translate english aftermatch_god_3a9f3e9b:

    # zwetana "Вот. Это сделали в Ривелье."
    zwetana "给。这是里维耶酿的。"

# game/a15/4aftermatch.rpy:735
translate english aftermatch_god_fd0b1cf9:

    # peter "За Лотрика! За нового Имперского Смотрителя!"
    peter "为洛特里克！为新任帝国监视者！"

# game/a15/4aftermatch.rpy:736
translate english aftermatch_god_1d080444:

    # gosti "За Лотрика!"
    gosti "为洛特里克！"

# game/a15/4aftermatch.rpy:737
translate english aftermatch_god_2bcc9dcb:

    # zwetana "Какое вино вам нравится?"
    zwetana "您喜欢什么酒？"

# game/a15/4aftermatch.rpy:738
translate english aftermatch_god_d25321c1:

    # lotric "Я люблю аранское золотое."
    lotric "我喜欢阿兰金酒。"

# game/a15/4aftermatch.rpy:739
translate english aftermatch_god_79776ae7:

    # zwetana "Я попрошу мужа купить пару бочонков, раз уж вы к нам надолго. Петер?"
    zwetana "既然您要待很久，我让丈夫买几桶。彼得？"

# game/a15/4aftermatch.rpy:740
translate english aftermatch_god_859817ad:

    # peter "Я куплю."
    peter "我会买。"

# game/a15/4aftermatch.rpy:741
translate english aftermatch_god_30241a5e:

    # lotric "Не стоит утруждаться."
    lotric "不必麻烦。"

# game/a15/4aftermatch.rpy:742
translate english aftermatch_god_df5069e4:

    # zwetana "Ну что вы. Вы ведь не только Имперский Смотритель, но и наш гость."
    zwetana "别这样。您不仅是帝国监视者，也是我们的客人。"

# game/a15/4aftermatch.rpy:743
translate english aftermatch_god_c7e6e51f:

    # lotric "Благодарю."
    lotric "谢谢。"

# game/a15/4aftermatch.rpy:744
translate english aftermatch_god_69b2b94d:

    # zwetana "Петер сам хотел делать вино, но боюсь наши края не слишком располагают к росту винограда."
    zwetana "彼得本来想自己酿酒，但恐怕我们这里不太适合种葡萄。"

# game/a15/4aftermatch.rpy:745
translate english aftermatch_god_80c0e93e_1:

    # lotric "..."
    lotric "……"

# game/a15/4aftermatch.rpy:746
translate english aftermatch_god_2bf65ae3:

    # peter "Не позорь меня перед гостем."
    peter "别在客人面前让我丢脸。"

# game/a15/4aftermatch.rpy:747
translate english aftermatch_god_342b7872:

    # zwetana "Ну что ты, я еще даже не начинала. Вот держите."
    zwetana "别这样，我还没开始呢。拿着。"

# game/a15/4aftermatch.rpy:748
translate english aftermatch_god_7da85583:

    # lotric "Спасибо."
    lotric "谢谢。"

# game/a15/4aftermatch.rpy:750
translate english aftermatch_god_4e7048fa:

    # zwetana "Не хотелось бы омрачать подобный вечер разговорами о делах, но... наши договоренности еще в силе?"
    zwetana "不想用正事破坏这样的夜晚，但……我们的约定还有效吗？"

# game/a15/4aftermatch.rpy:751
translate english aftermatch_god_7fe2b493:

    # lotric "Я похож на человека, нарушающего свое слово?"
    lotric "我看起来像违背诺言的人吗？"

# game/a15/4aftermatch.rpy:752
translate english aftermatch_god_9e886365:

    # zwetana "Ну что вы, я вовсе не это имела в виду. Я неправильно выразилась. Я хотела сказать, что наши договоренности... уже совсем скоро потребуются."
    zwetana "别这样，我不是这个意思。我说得不好。我是说，我们的约定……很快就要用上了。"

# game/a15/4aftermatch.rpy:753
translate english aftermatch_god_49b9355b:

    # lotric "В этом я не уверен."
    lotric "这我不确定。"

# game/a15/4aftermatch.rpy:754
translate english aftermatch_god_bb072957:

    # zwetana "Я слышала ваш брат погиб, упав со стены?"
    zwetana "我听说您兄弟从墙上摔下来死了？"

# game/a15/4aftermatch.rpy:755
translate english aftermatch_god_dc3680f4:

    # lotric "Да."
    lotric "对。"

# game/a15/4aftermatch.rpy:756
translate english aftermatch_god_240aeef4:

    # zwetana "Жаль это слышать. Но ему нужно было быть осторожнее."
    zwetana "很遗憾。但他本该更小心。"

# game/a15/4aftermatch.rpy:757
translate english aftermatch_god_80c0e93e_2:

    # lotric "..."
    lotric "……"

# game/a15/4aftermatch.rpy:758
translate english aftermatch_god_03626a7c:

    # zwetana "Стоило уловить связь между количеством племянников и вероятностью погибнуть от трагической случайности."
    zwetana "该察觉到侄子数量和死于悲剧性意外的概率之间的联系。"

# game/a15/4aftermatch.rpy:759
translate english aftermatch_god_5e5e2891:

    # lotric "Тяжело с этим поспорить."
    lotric "这很难反驳。"

# game/a15/4aftermatch.rpy:760
translate english aftermatch_god_fc1988da:

    # zwetana "Уверяю вас, Лотрик. Здесь подобные случайности невозможны. Можете чувствовать себя тут как дома."
    zwetana "我向您保证，洛特里克。这里不会有这种意外。您可以像在家一样。"

# game/a15/4aftermatch.rpy:761
translate english aftermatch_god_7da85583_1:

    # lotric "Спасибо."
    lotric "谢谢。"

# game/a15/4aftermatch.rpy:762
translate english aftermatch_god_b93ed868:

    # zwetana "Как думаете у вашего последнего живого брата есть шанс занять престол?"
    zwetana "您觉得您最后一个活着的兄弟有机会登上王位吗？"

# game/a15/4aftermatch.rpy:763
translate english aftermatch_god_e95b2fea:

    # lotric "Согласно линии наследования."
    lotric "按继承顺序。"

# game/a15/4aftermatch.rpy:764
translate english aftermatch_god_8999e361:

    # zwetana "Ну разумеется. Я имею в виду... вдруг трагические случайности и дальше будут преследовать вашу семью."
    zwetana "当然。我是说……万一悲剧性意外继续缠着您家族呢。"

# game/a15/4aftermatch.rpy:765
translate english aftermatch_god_54a70e3c:

    # lotric "Полагаю это надо спрашивать не у меня. Я к этому отношения не имею."
    lotric "我想这不该问我。我和那没关系。"

# game/a15/4aftermatch.rpy:766
translate english aftermatch_god_131d9c73:

    # zwetana "Разумеется. Просто хотела узнать какова вероятность... впрочем неважно."
    zwetana "当然。只是想知道概率有多大……不过算了。"

# game/a15/4aftermatch.rpy:767
translate english aftermatch_god_8e57330c:

    # zwetana "Ваш отец так и не назвал наследника?"
    zwetana "您父亲还没指定继承人？"

# game/a15/4aftermatch.rpy:768
translate english aftermatch_god_8f46b7ac:

    # lotric "Нет."
    lotric "没有。"

# game/a15/4aftermatch.rpy:769
translate english aftermatch_god_3c059b93:

    # zwetana "Жаль. И я и мой муж уверены, что вы подходите на эту роль больше всего. Верно, Петер?"
    zwetana "遗憾。我和我丈夫都相信您最适合这个角色。对吧，彼得？"

# game/a15/4aftermatch.rpy:771
translate english aftermatch_god_6bca2a72:

    # peter "Верно."
    peter "对。"

# game/a15/4aftermatch.rpy:772
translate english aftermatch_god_bd826db3:

    # lotric "Очередность наследования определена Золотым Порядком. Если мой отец не назвал наследника, то им станет старший сын."
    lotric "继承顺序由黄金秩序决定。如果我父亲没指定继承人，那就是长子。"

# game/a15/4aftermatch.rpy:773
translate english aftermatch_god_c3aa97d8:

    # zwetana "Конечно. Мы уважаем Золотой Порядок. Наша Империя стоит на нем сотни лет."
    zwetana "当然。我们尊重黄金秩序。我们的帝国靠它屹立了数百年。"

# game/a15/4aftermatch.rpy:774
translate english aftermatch_god_e04d370a:

    # peter "Жаль ваши племянники другого мнения."
    peter "可惜您的侄子们不这么想。"

# game/a15/4aftermatch.rpy:775
translate english aftermatch_god_a31af15c:

    # zwetana "Да. Жаль."
    zwetana "是啊。可惜。"

# game/a15/4aftermatch.rpy:776
translate english aftermatch_god_3cc3cc2b:

    # lotric "Я за них не в ответе."
    lotric "我不为他们负责。"

# game/a15/4aftermatch.rpy:777
translate english aftermatch_god_08935bb2:

    # peter "И все же Империя может пострадать от их... самоуправства."
    peter "但帝国仍可能因他们的……专横行径而受损。"

# game/a15/4aftermatch.rpy:778
translate english aftermatch_god_90b758e7:

    # zwetana "Верно. Империи не нужны смутьяны. Ей нужен легитимный наследник. Достойный наследник."
    zwetana "没错。帝国不需要叛乱者。它需要合法继承人。一个配得上的继承人。"

# game/a15/4aftermatch.rpy:779
translate english aftermatch_god_32a03441:

    # lotric "Никто из моих племянников не является наследником. Им станет мой брат."
    lotric "我的侄子们都不是继承人。继承人是我的兄弟。"

# game/a15/4aftermatch.rpy:780
translate english aftermatch_god_a184e6e1:

    # peter "Или вы."
    peter "或者您。"

# game/a15/4aftermatch.rpy:782
translate english aftermatch_god_4f4cffc8:

    # zwetana "Да. Если с вашим братом что-то случится."
    zwetana "对。如果您兄弟出了什么事。"

# game/a15/4aftermatch.rpy:783
translate english aftermatch_god_8fa25de9:

    # lotric "Чтобы вы не задумали..."
    lotric "不管你们在谋划什么……"

# game/a15/4aftermatch.rpy:784
translate english aftermatch_god_d6fa4cae:

    # zwetana "Да бросьте, Лотрик. Ваши племянники в открытую посещают лордов Империи, заручаясь их поддержкой в грядущей войне."
    zwetana "别这样，洛特里克。您的侄子们公开拜访帝国领主，为即将到来的战争争取支持。"

# game/a15/4aftermatch.rpy:785
translate english aftermatch_god_5a16ca38:

    # peter "И судьба ваших 'трагически погибших' братьев, тоже не секрет."
    peter "而且您那些‘悲剧性死去’的兄弟的命运也不是秘密。"

# game/a15/4aftermatch.rpy:786
translate english aftermatch_god_be22c7f3:

    # lotric "Я просил о защите."
    lotric "我请求的是保护。"

# game/a15/4aftermatch.rpy:787
translate english aftermatch_god_6c7eeecd:

    # zwetana "И вы ее получите. Но когда начнется бойня, а она начнется, вам придется не только защищаться."
    zwetana "您会得到。但当屠杀开始——它一定会开始——您就不能只是防守了。"

# game/a15/4aftermatch.rpy:788
translate english aftermatch_god_12b061a5:

    # peter "Вам придется навести порядок. Как наследнику. Как Императору."
    peter "您必须恢复秩序。作为继承人。作为皇帝。"

# game/a15/4aftermatch.rpy:789
translate english aftermatch_god_2bedf0f7:

    # lotric "Наследник и будущий Император - мой брат."
    lotric "继承人和未来的皇帝是我兄弟。"

# game/a15/4aftermatch.rpy:790
translate english aftermatch_god_0435740e:

    # zwetana "Даррон и Горран убили одного вашего брата. Вы бы не уговорили отца назначить вас сюда, если бы верили, что они остановятся только на нем."
    zwetana "达隆和戈兰杀了您一个兄弟。如果您相信他们会就此停手，就不会说服父亲把您派到这里。"

# game/a15/4aftermatch.rpy:791
translate english aftermatch_god_80c0e93e_3:

    # lotric "..."
    lotric "……"

# game/a15/4aftermatch.rpy:792
translate english aftermatch_god_b0da65ce:

    # peter "У Маррика была власть и влияние, и он все равно погиб. Как много шансов удержаться у власти у Галиона?"
    peter "马里有过权力和影响力，可他还是死了。加里昂保住权力的机会有多少？"

# game/a15/4aftermatch.rpy:793
translate english aftermatch_god_23131cc4:

    # zwetana "Полагаю лучшее, что он может сделать это спрятаться, как и вы. Но если слухи верны - ему не хватит для этого благоразумия."
    zwetana "我想他最好的选择就是像您一样躲起来。但如果传闻属实，他缺乏这种明智。"

# game/a15/4aftermatch.rpy:794
translate english aftermatch_god_285f28bd:

    # zwetana "В отличие от вас, он не покинул столицу, а наоборот туда отправился. Навстречу смерти."
    zwetana "和您不同，他没离开首都，反而去了那里。迎向死亡。"

# game/a15/4aftermatch.rpy:795
translate english aftermatch_god_2c2ef7ce:

    # zwetana "Может он даже протянет год или два. Но стоит вашему отцу умереть - дети ваших братьев убьют его и утопят Империю в крови, убивая друг друга."
    zwetana "他也许还能撑一两年。但您父亲一死——您兄弟们的孩子会杀了他，并在互相残杀中把帝国淹没在血里。"

# game/a15/4aftermatch.rpy:796
translate english aftermatch_god_f2e6f0e0:

    # lotric "Выходит, вы делаете свою ставку на меня."
    lotric "所以你们把赌注押在我身上。"

# game/a15/4aftermatch.rpy:797
translate english aftermatch_god_5c59fe75:

    # zwetana "Я и мой муж уверены, что вы лучший кандидат."
    zwetana "我和我丈夫确信您是最佳人选。"

# game/a15/4aftermatch.rpy:798
translate english aftermatch_god_2e1a4f33:

    # lotric "Почему я?"
    lotric "为什么是我？"

# game/a15/4aftermatch.rpy:799
translate english aftermatch_god_8737cfb7:

    # peter "Потому что вы единственный, кто не участвует в кровавой грызне при живом Императоре."
    peter "因为您是唯一一个在皇帝还活着时没有参与血腥争夺的人。"

# game/a15/4aftermatch.rpy:800
translate english aftermatch_god_4da22338:

    # lotric "Так по-вашему я самый достойный? Такие обычно дворцовые интриги не переживают."
    lotric "所以你们觉得我最配？这种人通常活不过宫廷阴谋。"

# game/a15/4aftermatch.rpy:801
translate english aftermatch_god_82db9d51:

    # zwetana "Если слухи о вас хоть в половину правдивы - вы не дадите убить себя просто так."
    zwetana "如果关于您的传闻有一半是真的，您不会轻易让人杀掉。"

# game/a15/4aftermatch.rpy:802
translate english aftermatch_god_883d26b0:

    # lotric "И все же это рискованная ставка. Не боитесь оказаться в петле? Они придут за мной."
    lotric "但这仍是冒险的赌注。不怕上绞架吗？他们会来找我。"

# game/a15/4aftermatch.rpy:803
translate english aftermatch_god_d4a84f54:

    # peter "Пускай приходят. На это мы и рассчитываем."
    peter "让他们来。我们正指望这个。"

# game/a15/4aftermatch.rpy:804
translate english aftermatch_god_09ad7572:

    # zwetana "Все, что они могут сделать - внезапно ударить по одному из замков, пытаясь угадать, где вы."
    zwetana "他们能做的，就是突袭某座城堡，试图猜出您在哪儿。"

# game/a15/4aftermatch.rpy:805
translate english aftermatch_god_c75d6ec7:

    # peter "Северяне гордый народ. После этого все объединятся вокруг вас. За вами будет целое королевство. "
    peter "北方人是骄傲的民族。那之后所有人都会团结在您周围。您会得到整个王国。"

# game/a15/4aftermatch.rpy:806
translate english aftermatch_god_ea4bcc5d:

    # lotric "...полагаю на жертвы не идут просто так."
    lotric "……我想牺牲不会无缘无故。"

# game/a15/4aftermatch.rpy:807
translate english aftermatch_god_fc365417:

    # peter "Уверены, что вы не забудете, кто вам помог."
    peter "我们确信您不会忘记是谁帮了您。"

# game/a15/4aftermatch.rpy:808
translate english aftermatch_god_82112a28:

    # zwetana "Но и конечно мы ждем обозначения ваших намерений. Вашего принятия нашего союза."
    zwetana "当然，我们也期待您表明意图。接受我们的同盟。"

# game/a15/4aftermatch.rpy:809
translate english aftermatch_god_24f38840:

    # lotric "Что я должен сделать."
    lotric "我该做什么？"

# game/a15/4aftermatch.rpy:810
translate english aftermatch_god_05e9b144:

    # zwetana "Женитесь на северянке."
    zwetana "娶一个北方女人。"

# game/a15/4aftermatch.rpy:811
translate english aftermatch_god_625fdb80:

    # lotric "На ком-то конкретном? На вашей дочери?"
    lotric "某个特定的人？您的女儿？"

# game/a15/4aftermatch.rpy:812
translate english aftermatch_god_ec48971e:

    # zwetana "Пока у меня только сын. Впрочем я еще молода, так если бы дочь у меня и была, она бы не подходила вам по возрасту."
    zwetana "我目前只有儿子。不过我还年轻——就算我有女儿，年龄也不适合您。"

# game/a15/4aftermatch.rpy:813
translate english aftermatch_god_bee2e260:

    # lotric "Не подходила?"
    lotric "不适合？"

# game/a15/4aftermatch.rpy:814
translate english aftermatch_god_0acd0c5c:

    # peter "Лучше консумировать брак как можно быстрее."
    peter "最好尽快圆房。"

# game/a15/4aftermatch.rpy:815
translate english aftermatch_god_6a0048b4:

    # lotric "Так... кого мне выбрать?"
    lotric "那……我该选谁？"

# game/a15/4aftermatch.rpy:816
translate english aftermatch_god_f38a37fb:

    # zwetana "Мы пригласили несколько дочерей наших... добрых друзей. Вы вольны выбирать любую."
    zwetana "我们邀请了几位我们……好朋友的女儿。您可以随意选择。"

# game/a15/4aftermatch.rpy:818
translate english aftermatch_god_99814134:

    # gaston "Ты вовсе не обязана этого делать."
    gaston "你没必要这么做。"

# game/a15/4aftermatch.rpy:819
translate english aftermatch_god_469e3f3c:

    # marana "Гастон... прошу. Ты же знаешь у меня нет выбора."
    marana "加斯顿……求你。你知道我没得选。"

# game/a15/4aftermatch.rpy:820
translate english aftermatch_god_58e41391:

    # gaston "Выбор есть всегда. Ты можешь быть со мной."
    gaston "总有选择。你可以和我在一起。"

# game/a15/4aftermatch.rpy:821
translate english aftermatch_god_44fcdfca:

    # marana "Мой отец дал тебе ответ."
    marana "我父亲已经给过你答复了。"

# game/a15/4aftermatch.rpy:822
translate english aftermatch_god_c925f7b5:

    # gaston "Твой отец над тобой не властвует."
    gaston "你父亲管不了你。"

# game/a15/4aftermatch.rpy:823
