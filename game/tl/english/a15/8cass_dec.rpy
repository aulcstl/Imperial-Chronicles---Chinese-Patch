translate english lisa_mid_ev_a7d00507:

    # lisa "Пошел дурить голову той южанке, на которой женился. Они все глупые, поверят в любую чушь. Срочное дело государственной важности."
    lisa "去糊弄他娶的那个南方女人了。她们都很蠢，什么胡话都信。什么紧急国务。"

# game/a15/8cass_dec.rpy:603
translate english lisa_mid_ev_92d397c8_3:

    # elin "..."
    elin "……"

# game/a15/8cass_dec.rpy:604
