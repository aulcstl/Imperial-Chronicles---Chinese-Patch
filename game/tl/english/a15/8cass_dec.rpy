    # cass "Я делала все по рецепту."
    cass "我都是按配方做的。"

# game/a15/8cass_dec.rpy:421
translate english cass_dec_break_bd630972:

    # melissa "Закрой пасть."
    melissa "闭嘴。"

# game/a15/8cass_dec.rpy:422
translate english cass_dec_break_8f7be3a8:

    # me "Нет. Все было вкусно. Думаю [cass] заслуживает поощрения."
    me "不。都很好吃。我想[cass]该得到奖赏。"

# game/a15/8cass_dec.rpy:423
translate english cass_dec_break_a337cedc:

    # cass "Какого?"
    cass "什么奖赏？"

# game/a15/8cass_dec.rpy:424
translate english cass_dec_break_7b6d20ae:

    # melissa "Я сказала - захлопни пасть, пока к тебе не обратились, не смей даже открывать рот."
    melissa "我说了——没人问你之前闭嘴，连张嘴都不许。"

# game/a15/8cass_dec.rpy:425
translate english cass_dec_break_77a84346:

    # me "Нет. Пусть говорит. Она хорошо постаралась. Я хочу ее отблагодарить, пусть она и ... теперь полностью твоя ученица."
    me "不。让她说。她做得很好。我想谢她，哪怕她……现在完全归你管教了。"

# game/a15/8cass_dec.rpy:426
translate english cass_dec_break_4437ed01_1:

    # melissa "..."
    melissa "……"

# game/a15/8cass_dec.rpy:428
translate english cass_dec_break_6370f709:

    # me "Ты бы хотела свою комнату?"
    me "你想要自己的房间吗？"

# game/a15/8cass_dec.rpy:429
translate english cass_dec_break_aedb303c:

    # cass "Свою комнату? Да. Хотела бы."
    cass "自己的房间？想。想要。"

# game/a15/8cass_dec.rpy:430
translate english cass_dec_break_29b4c788:

    # me "Думаю ты ее заслужила."
    me "我想你配得上。"

# game/a15/8cass_dec.rpy:431
translate english cass_dec_break_ee221890:

    # cass "Это... боги, это было бы хорошо."
    cass "这……天哪，那太好了。"

# game/a15/8cass_dec.rpy:432
translate english cass_dec_break_8b36b0aa:

    # me "Ты неплохо справляешься. Ты ведь утихомирила свою гордыню?"
    me "你做得不错。你压住自己的傲气了吧？"

# game/a15/8cass_dec.rpy:433
translate english cass_dec_break_bee3f924:

    # cass "Да. Да. Конечно."
    cass "对。对。当然。"

# game/a15/8cass_dec.rpy:434
translate english cass_dec_break_45fea4fc:

    # me "Хорошо. Значит ты встала на путь исправления."
    me "好。那你已走上改过之路。"

# game/a15/8cass_dec.rpy:435
translate english cass_dec_break_065fce1a:

    # cass "Да. Да. Встала."
    cass "对。对。走上了。"

# game/a15/8cass_dec.rpy:436
translate english cass_dec_break_dd1a3f05:

    # me "Но ты же не заставишь меня пожалеть?"
    me "但你不会让我后悔吧？"

# game/a15/8cass_dec.rpy:437
translate english cass_dec_break_2ba4c3a3_1:

    # cass "Нет."
    cass "不会。"

# game/a15/8cass_dec.rpy:438
translate english cass_dec_break_b0558950:

    # me "Ну тогда я рекомендую дать тебе комнату."
    me "那我就建议给你一间房。"

# game/a15/8cass_dec.rpy:439
translate english cass_dec_break_5d90de82:

    # cass "Рекомендуешь?"
    cass "建议？"

# game/a15/8cass_dec.rpy:440
translate english cass_dec_break_ce8f13f7:

    # me "Я бы и рад приказать. Но все-таки ты теперь... полностью под властью Мелиссы. Она твой наставник."
    me "我倒是想下命令。但你毕竟现在……完全在梅丽莎的管束下。她是你的导师。"

# game/a15/8cass_dec.rpy:441
translate english cass_dec_break_d892cee3:

    # cass "В каком смысле?"
    cass "什么意思？"

# game/a15/8cass_dec.rpy:444
translate english cass_dec_break_30a02b4f:

    # melissa "Никакой тебе комнаты, сука! Отцеубийца!"
    melissa "休想要房间，婊子！弑父者！"

# game/a15/8cass_dec.rpy:445
translate english cass_dec_break_cea3986a:

    # cass "АГРХ!"
    cass "啊呃！"

# game/a15/8cass_dec.rpy:446
translate english cass_dec_break_9a4e65c4:

    # melissa "Будешь спать в картофельных очистках, как и раньше, спать и радоваться, что тебя не вздернули за то, что ты хотела отравить своего отца."
    melissa "你还像以前一样睡在土豆皮里吧，睡吧，庆幸自己没因为想毒害父亲被吊死。"

# game/a15/8cass_dec.rpy:447
translate english cass_dec_break_1250a243:

    # cass "...пусти..."
    cass "……放开我……"

# game/a15/8cass_dec.rpy:449
translate english cass_dec_break_4a1c71d8:

    # cass "{siz=+6}СУКА! ОТПУСТИ МЕНЯ!{/size}"
    cass "{siz=+6}婊子！放开我！{/size}"

# game/a15/8cass_dec.rpy:450
translate english cass_dec_break_9770ce37:

    # melissa "Не подумаю."
    melissa "想都别想。"

# game/a15/8cass_dec.rpy:451
translate english cass_dec_break_b02aefa8:

    # cass "{siz=+6}Мне дали комнату!{/size}"
    cass "{siz=+6}王子给了我房间！{/size}"

# game/a15/8cass_dec.rpy:452
translate english cass_dec_break_91913daf:

    # melissa "Ты ее не получишь."
    melissa "你得不到。"

# game/a15/8cass_dec.rpy:453
translate english cass_dec_break_d838ce07:

    # cass "{siz=+6}ТВАРЬ! СУКА! НЕНАВИЖУ!{/size}"
    cass "{siz=+6}畜生！婊子！我恨你！{/size}"

# game/a15/8cass_dec.rpy:454
translate english cass_dec_break_b8dc0711:

    # melissa "Заткнись. А то и очистков лишишься. Будешь спать на полу."
    melissa "闭嘴。不然连土豆皮都没了。你就睡地板。"

# game/a15/8cass_dec.rpy:455
translate english cass_dec_break_941a032b:

    # cass "{siz=+6}[mename]!{/size}"
    cass "{siz=+6}[mename]！{/size}"

# game/a15/8cass_dec.rpy:456
translate english cass_dec_break_5e76dabd:

    # melissa "Принц отдал тебя мне, ты теперь моя игрушка, девочка."
    melissa "王子把你交给我了。你现在是我的玩具，丫头。"

# game/a15/8cass_dec.rpy:457
translate english cass_dec_break_1a8af48d:

    # cass "{siz=+6}ПУСТИ, МРАЗЬ! Я ТЕБЯ УБЬЮ!{/size}"
    cass "{siz=+6}放开我，恶棍！我要杀了你！{/size}"

# game/a15/8cass_dec.rpy:458
translate english cass_dec_break_eb4a1627:

    # melissa "Сначала ты приготовишь ужин для лордов."
    melissa "先给领主们做晚饭。"

# game/a15/8cass_dec.rpy:459
translate english cass_dec_break_067d20e6:

    # cass "{siz=+6}Я ПРИГОТОВЛЮ УЖИН ИЗ ТВОИХ ПОТРОХОВ, ТВАРЬ!{/size}"
    cass "{siz=+6}我要用你的内脏做晚饭，畜生！{/size}"

# game/a15/8cass_dec.rpy:460
translate english cass_dec_break_78c935f1:

    # me "{i}Отлично, она почти готова.{/i}"
    me "{i}很好，她快差不多了。{/i}"

# game/a15/8cass_dec.rpy:464
translate english lisa_mid_ev_0f476a5d:

    # "Чуть позже."
    "稍后。"

# game/a15/8cass_dec.rpy:465
translate english lisa_mid_ev_50c582c9:

    # librarian "Она царапает пол своими колесами!"
    librarian "她的轮子在刮地板！"

# game/a15/8cass_dec.rpy:466
translate english lisa_mid_ev_c4bf1b07:

    # me "Она не может передвигаться иначе."
    me "她没法用别的方式移动。"

# game/a15/8cass_dec.rpy:467
translate english lisa_mid_ev_f9b4565a:

    # librarian "Я понимаю, но вы видели эти шипы?"
    librarian "我明白，但您看到那些尖刺了吗？"

# game/a15/8cass_dec.rpy:468
translate english lisa_mid_ev_b451313a:

    # me "Дома она чаще была на камнях и земле, чем на дереве."
    me "在家时，她多在石头和泥地上，而不是木地板上。"

# game/a15/8cass_dec.rpy:469
translate english lisa_mid_ev_f65272ce:

    # librarian "Но здесь она не дома."
    librarian "但这里不是她家。"

# game/a15/8cass_dec.rpy:470
translate english lisa_mid_ev_a5d9c54b:

    # me "Я попрошу кузнеца стесать шипы."
    me "我会让铁匠把尖刺磨平。"

# game/a15/8cass_dec.rpy:471
translate english lisa_mid_ev_1605326c:

    # librarian "Пожалуйста, мой принц! Она исцарапала весь пол."
    librarian "求您了，我的王子！她把地板全刮花了。"

# game/a15/8cass_dec.rpy:472
translate english lisa_mid_ev_8381fa34:

    # me "Конечно. Успокойтесь. Попрошу кузнеца сегодня же."
    me "当然。别急。我今天就找铁匠。"

# game/a15/8cass_dec.rpy:474
translate english lisa_mid_ev_907a48cc:

    # me "Ты только прибыла в замок, а на тебя уже жалуются."
    me "你刚到城堡，就已经有人投诉你了。"

# game/a15/8cass_dec.rpy:475
translate english lisa_mid_ev_f4395457:

    # lisa "Прости, не смогла удержаться. Очень хотелось увидеть вашу огромную библиотеку своими глазами."
    lisa "抱歉，我忍不住。很想亲眼看看你们这座巨大的图书馆。"

# game/a15/8cass_dec.rpy:476
translate english lisa_mid_ev_5f027f04:

    # me "Я так и понял. Я нашел тебя по следам на деревянном полу."
    me "我就知道。我是顺着木地板上的痕迹找到你的。"

# game/a15/8cass_dec.rpy:477
translate english lisa_mid_ev_bd8a0d44:

    # lisa "В свое оправдание могу сказать, что пол в библиотеке моего отца тоже деревянный, но моё кресло на нём столько следов не оставляет."
    lisa "为自己辩解一句，我父亲图书馆的地板也是木头的，但我的椅子不会留下这么多痕迹。"

# game/a15/8cass_dec.rpy:478
translate english lisa_mid_ev_6f4077a1:

    # me "Надо было спросить у него, как он этого добился."
    me "该问问他怎么做到的。"

# game/a15/8cass_dec.rpy:479
translate english lisa_mid_ev_5f3a90ba:

    # lisa "Да ладно тебе, неужели я и вправду оставила столько следов?"
    lisa "得了吧，我真留了那么多痕迹？"

# game/a15/8cass_dec.rpy:480
translate english lisa_mid_ev_5de2ea8f:

    # me "Я вообще ничего не заметил, пока мне не сказал о следах здешний хранитель. Да и какая разница? В таком месте надо смотреть в книгу, а не на пол."
    me "在这里的图书管理员告诉我之前，我什么都没注意到。而且有什么关系？在这种地方该看书，而不是看地板。"

# game/a15/8cass_dec.rpy:481
translate english lisa_mid_ev_4c4d258f:

    # lisa "Ну... наверное это тоже неправильно."
    lisa "嗯……也许那样也不对。"

# game/a15/8cass_dec.rpy:482
translate english lisa_mid_ev_ed9b14fd:

    # me "Я велю кузнецу сточить шипы на твоем кресле. Может вообще переделать его?"
    me "我会让铁匠磨平你椅子上的尖刺。也许干脆重做？"

# game/a15/8cass_dec.rpy:483
translate english lisa_mid_ev_658fc6da:

    # lisa "Переделать? Зачем?"
    lisa "重做？为什么？"

# game/a15/8cass_dec.rpy:484
translate english lisa_mid_ev_b5dfb64e:

    # me "Оно слишком массивное. У меня нет таких сильных слуг и в этом замке не такие широкие коридоры, как в Совином Камне."
    me "它太笨重了。我没有那么强壮的仆人，这座城堡的走廊也不像猫头鹰岩那样宽。"

# game/a15/8cass_dec.rpy:485
translate english lisa_mid_ev_91030a4d:

    # lisa "Да у вас здесь в принципе паршивенько."
    lisa "你们这儿本来就挺糟的。"

# game/a15/8cass_dec.rpy:486
translate english lisa_mid_ev_dace5d68:

    # me "Да? Может вернуть тебя обратно?"
    me "是吗？要不要把你送回去？"

# game/a15/8cass_dec.rpy:487
translate english lisa_mid_ev_9271b137:

    # lisa "Не получится. Порт замерз."
    lisa "不行。港口冻住了。"

# game/a15/8cass_dec.rpy:489
translate english lisa_mid_ev_771ce3ac:

    # me "Ничего страшного. Я впрягу лошадь в твое кресло и поедешь с ветерком домой."
    me "没关系。我把马套到你的椅子上，你就能风驰电掣地回家了。"

# game/a15/8cass_dec.rpy:490
translate english lisa_mid_ev_c0241aed:

    # lisa "Через чумные города? Это небезопасно."
    lisa "穿过瘟疫城市？那不安全。"

# game/a15/8cass_dec.rpy:491
translate english lisa_mid_ev_412851e0:

    # me "Ты уже ехала через них."
    me "你已经穿过它们了。"

# game/a15/8cass_dec.rpy:492
translate english lisa_mid_ev_02c0c8dd:

    # lisa "В карете. Твоим оригинальным способом ни разу."
    lisa "坐马车。从没用你那套独创方法。"

# game/a15/8cass_dec.rpy:493
translate english lisa_mid_ev_62ea98c3:

    # me "Уверен, что когда чума увидит, что ты уже побита судьбой - она тебя пощадит."
    me "我相信当瘟疫看到命运已经把你揍得够惨时——它会饶过你。"

# game/a15/8cass_dec.rpy:494
translate english lisa_mid_ev_772bb304:

    # lisa "Очень интересные представления об эпидемиологии. Удивлена, что ты до сих пор жив. Притворялся хромым, когда въезжал в Бригдок?"
    lisa "很有意思的流行病学观念。我很惊讶你还活着。你进布里格多克时假装瘸子了吗？"

# game/a15/8cass_dec.rpy:495
translate english lisa_mid_ev_5596a42c:

    # me "Нет. Просто примотал два колеса к стулу и сидел на нем в телеге."
    me "没有。只是把两个轮子绑在椅子上，然后坐在推车里的椅子上。"

# game/a15/8cass_dec.rpy:496
translate english lisa_mid_ev_7232ccc8:

    # lisa "Ух ты. Ты почти один в один описал мое первое кресло."
    lisa "哇。你几乎把我第一把椅子描述得一模一样。"

# game/a15/8cass_dec.rpy:497
translate english lisa_mid_ev_dac9f1f5:

    # me "По-моему твое кресло и сейчас так выглядит, просто на нем еще и шипы, которые царапают пол в библиотеке."
    me "我觉得你的椅子现在看起来也还是那样，只是多了会刮花图书馆地板的尖刺。"

# game/a15/8cass_dec.rpy:498
translate english lisa_mid_ev_4b50f628:

    # lisa "Все. Хватит меня смешить."
    lisa "好了。别再逗我笑了。"

# game/a15/8cass_dec.rpy:499
translate english lisa_mid_ev_3820771a:

    # me "..."
    me "……"

# game/a15/8cass_dec.rpy:500
translate english lisa_mid_ev_616fb448:

    # me "Как тебе здесь? Я велел отдать тебе хорошую комнату."
    me "你在这儿怎么样？我让他们给了你一间好房。"

# game/a15/8cass_dec.rpy:501
translate english lisa_mid_ev_3959d642:

    # lisa "Потолки высоковаты."
    lisa "天花板有点太高了。"

# game/a15/8cass_dec.rpy:502
translate english lisa_mid_ev_83fb095b:

    # me "А... все еще шутим."
    me "啊……还在开玩笑。"

# game/a15/8cass_dec.rpy:503
translate english lisa_mid_ev_efae483e:

    # lisa "Нет. В этот раз я серьезно."
    lisa "不。这次我是认真的。"

# game/a15/8cass_dec.rpy:504
translate english lisa_mid_ev_07fde840:

    # me "Объясни."
    me "解释一下。"

# game/a15/8cass_dec.rpy:505
translate english lisa_mid_ev_5d5817ad:

    # lisa "Ты был в моей комнате на Севере хоть раз?"
    lisa "你去过我在北方的房间吗？"

# game/a15/8cass_dec.rpy:506
translate english lisa_mid_ev_5a7a7577:

    # me "Нет."
    me "没有。"

# game/a15/8cass_dec.rpy:508
translate english lisa_mid_ev_a56264f5:

    # me "А что в ней?"
    me "那里面有什么？"

# game/a15/8cass_dec.rpy:509
translate english lisa_mid_ev_0c4a5139:

    # lisa "Я... если рядом не было слуги, я пользовалась веревками."
    lisa "我……如果旁边没仆人，我就用绳子。"

# game/a15/8cass_dec.rpy:510
translate english lisa_mid_ev_b08b5412:

    # me "Веревками? Ты вязала петлю и накидывала ее на нужные предметы?"
    me "绳子？你打个套索，再套到需要的东西上？"

# game/a15/8cass_dec.rpy:511
translate english lisa_mid_ev_3fc523df:

    # lisa "Что? Это было бы смешно, но нет."
    lisa "什么？那会挺好笑，但不是。"

# game/a15/8cass_dec.rpy:512
translate english lisa_mid_ev_e2960fb5:

    # me "А что тогда?"
    me "那是什么？"

# game/a15/8cass_dec.rpy:513
translate english lisa_mid_ev_003e5728:

    # lisa "Мастера моего отца прикрепили к кровати и потолку множество веревок. Хватаясь за них, я могла сама залезть с кровати на кресло и наоборот."
    lisa "我父亲的工匠在床和天花板上固定了许多绳子。抓着它们，我能自己从床上挪到椅子上，反之亦然。"

# game/a15/8cass_dec.rpy:514
translate english lisa_mid_ev_788f70a1:

    # lisa "Могла сесть за стол, в кресло, добраться до моих низких книжных полок."
    lisa "我能坐到桌边、坐到椅子里，也能碰到我那些低矮的书架。"

# game/a15/8cass_dec.rpy:515
translate english lisa_mid_ev_e2df7112:

    # me "Может и на ночной горшок ты могла сесть сама?"
    me "也许你还能自己坐到夜壶上？"

# game/a15/8cass_dec.rpy:516
translate english lisa_mid_ev_1044f8af:

    # lisa "Фу. [mename]. Это неприлично спрашивать. Но вообще да. Могла."
    lisa "呸。[mename]。这问题不礼貌。不过是的，我能。"

# game/a15/8cass_dec.rpy:517
translate english lisa_mid_ev_af608f05:

    # me "Я поговорю с мастерами в городе. Кто-то точно возьмется за это."
    me "我会和城里的工匠谈谈。肯定有人会接这活。"

# game/a15/8cass_dec.rpy:518
