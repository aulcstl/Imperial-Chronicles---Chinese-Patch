    # elin "Мы... мы сейчас вместе найдем моего брата и..."
    elin "我们……我们现在一起去找我哥哥，然后……"

# game/a15/8cass_dec.rpy:606
translate english lisa_mid_ev_6299f65f:

    # lisa "И что?"
    lisa "然后呢？"

# game/a15/8cass_dec.rpy:607
