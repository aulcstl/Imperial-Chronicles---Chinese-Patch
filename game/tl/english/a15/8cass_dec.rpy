# game/a15/8cass_dec.rpy:615
translate english lisa_mid_ev_f085b86d:

    # lisa "Ага. Поможете или нет?"
    lisa "嗯。帮还是不帮？"

# game/a15/8cass_dec.rpy:616
translate english lisa_mid_ev_6cec8bb8:

    # elin "Вы... зачем оно вам?"
    elin "您……要它做什么？"

