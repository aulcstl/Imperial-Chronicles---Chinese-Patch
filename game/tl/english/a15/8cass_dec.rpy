# game/a15/8cass_dec.rpy:10
translate english cass_dec_fix_0f476a5d:

    # "Чуть позже."
    "稍后。"

# game/a15/8cass_dec.rpy:11
translate english cass_dec_fix_aff84e18:

    # me "{i}Надеюсь, с ней всё в порядке.{/i}"
    me "{i}希望她没事。{/i}"

# game/a15/8cass_dec.rpy:12
translate english cass_dec_fix_4162a294:

    # me "{i}Боги свидетели - если ее хоть раз ударили хлыстом...{/i}"
    me "{i}苍天作证——要是有人敢用鞭子抽她哪怕一下……{/i}"

# game/a15/8cass_dec.rpy:13
translate english cass_dec_fix_e12bfa44:

    # me "{i}...я лично иссеку спину гвардейцу, что это позволил сделать.{/i}"
    me "{i}……我会亲手抽烂那个允许此事发生的卫兵的背。{/i}"

# game/a15/8cass_dec.rpy:14
translate english cass_dec_fix_f65fea8f:

    # me "{i}Теперь, когда замок полнится золотой гвардией... пожалуй, стоит приставить к [cass] верных мне людей.{/i}"
    me "{i}如今城堡里满是黄金卫队……也许该派忠于我的人去看守[cass]。{/i}"

# game/a15/8cass_dec.rpy:15
translate english cass_dec_fix_dfdc1a9f:

    # me "{i}Трибунал наверняка не забыл ее попытку захвата власти.{/i}"
    me "{i}法庭肯定没忘记她那次夺权企图。{/i}"

# game/a15/8cass_dec.rpy:16
translate english cass_dec_fix_b61b15c0:

    # me "{i}А может он уже...{/i}"
    me "{i}也许他们已经……{/i}"

# game/a15/8cass_dec.rpy:17
translate english cass_dec_fix_5662e868:

    # me "{i}Нет. Нет. Надеюсь все хорошо.{/i}"
    me "{i}不。不。希望一切都好。{/i}"

# game/a15/8cass_dec.rpy:19
translate english cass_dec_fix_318d8014:

    # me "Где моя сестра?"
    me "我妹妹在哪儿？"

# game/a15/8cass_dec.rpy:20
translate english cass_dec_fix_e7527f74:

    # guard "Мой принц."
    guard "我的王子。"

# game/a15/8cass_dec.rpy:21
translate english cass_dec_fix_2aed4035:

    # me "Отвечай."
    me "回答。"

# game/a15/8cass_dec.rpy:22
translate english cass_dec_fix_9f645ed5:

    # guard "С ней все в порядке."
    guard "她没事。"

# game/a15/8cass_dec.rpy:23
translate english cass_dec_fix_639e4bd8:

    # me "Где она?"
    me "她在哪儿？"

# game/a15/8cass_dec.rpy:24
translate english cass_dec_fix_00191e70:

    # guard "Дальше. В подземелье. На уровень ниже."
    guard "往里面。在地牢。下一层。"

# game/a15/8cass_dec.rpy:25
translate english cass_dec_fix_d37cb203:

    # me "Что она там делает?"
    me "她在那里做什么？"

# game/a15/8cass_dec.rpy:26
translate english cass_dec_fix_11b7397e:

    # guard "Вы велели ее защитить."
    guard "您下令保护她。"

# game/a15/8cass_dec.rpy:27
translate english cass_dec_fix_0d9faf20:

    # me "...и?"
    me "……然后？"

# game/a15/8cass_dec.rpy:28
translate english cass_dec_fix_bd471e8c:

    # guard "Ей интересовался трибунал и лорды."
    guard "法庭和领主们对她感兴趣。"

# game/a15/8cass_dec.rpy:29
translate english cass_dec_fix_2d7366a2:

    # me "Давно?"
    me "多久了？"

# game/a15/8cass_dec.rpy:30
translate english cass_dec_fix_ed846329:

    # guard "Уже две недели сюда захаживают. Золотой судья и гвардия... новая."
    guard "他们来这儿已经两周了。金裁决和新卫队……"

# game/a15/8cass_dec.rpy:31
translate english cass_dec_fix_21ad2a6d:

    # me "А что вы?"
    me "那你们呢？"

# game/a15/8cass_dec.rpy:32
translate english cass_dec_fix_5cf7f794:

    # guard "Говорим, что ведем допрос по вашему приказу."
    guard "我们说是在按您的命令审讯。"

# game/a15/8cass_dec.rpy:33
translate english cass_dec_fix_0a7d99df:

    # me "Но вы ведь..."
    me "但你们其实……"

# game/a15/8cass_dec.rpy:34
translate english cass_dec_fix_7d024964:

    # guard "Нет... нет. Только для вида. Чтобы был повод не отдавать вашу сестру."
    guard "不……不。只是做样子。好有个不交出您妹妹的理由。"

# game/a15/8cass_dec.rpy:35
translate english cass_dec_fix_06136cee:

    # me "Приведите меня к ней."
    me "带我去见她。"

# game/a15/8cass_dec.rpy:36
translate english cass_dec_fix_fda81ab5:

    # guard "Как пожелаете, мой принц."
    guard "如您所愿，我的王子。"

# game/a15/8cass_dec.rpy:38
translate english cass_dec_fix_fc7d3a18:

    # "Пару минут спустя."
    "几分钟后。"

# game/a15/8cass_dec.rpy:39
translate english cass_dec_fix_9f8370ee:

    # me "[cass]."
    me "[cass]。"

# game/a15/8cass_dec.rpy:40
translate english cass_dec_fix_651ccc28:

    # cass "..."
    cass "……"

# game/a15/8cass_dec.rpy:41
translate english cass_dec_fix_09a2bd31:

    # me "Просыпайся, [cass]."
    me "醒醒，[cass]。"

# game/a15/8cass_dec.rpy:42
translate english cass_dec_fix_d0065918:

    # cass "М? Ну что опять?"
    cass "嗯？又怎么了？"

# game/a15/8cass_dec.rpy:43
translate english cass_dec_fix_a2dabf0d:

    # me "Это я. Вставай. Нужно поговорить."
    me "是我。起来。得谈谈。"

# game/a15/8cass_dec.rpy:44
translate english cass_dec_fix_1c81a4a4:

    # cass "Боги, да что вам нужно?"
    cass "天哪，你们到底要什么？"

# game/a15/8cass_dec.rpy:45
translate english cass_dec_fix_50185b0e:

    # me "Это я - [mename]. Вставай."
    me "是我——[mename]。起来。"

# game/a15/8cass_dec.rpy:46
translate english cass_dec_fix_23cdbfee:

    # cass "А?"
    cass "啊？"

# game/a15/8cass_dec.rpy:47
translate english cass_dec_fix_7b953cc3:

    # me "Вставай!"
    me "起来！"

# game/a15/8cass_dec.rpy:49
translate english cass_dec_fix_1f232da4:

    # cass "Ты вернулся."
    cass "你回来了。"

# game/a15/8cass_dec.rpy:50
translate english cass_dec_fix_86ca5302:

    # me "Вернулся. Как ты?"
    me "回来了。你怎么样？"

# game/a15/8cass_dec.rpy:51
translate english cass_dec_fix_14534628:

    # cass "Бывало и лучше. А ты как? Как твоя поездка на Север?"
    cass "有过更好的时候。你呢？北方之行怎么样？"

# game/a15/8cass_dec.rpy:52
translate english cass_dec_fix_5751efe3:

    # me "Сейчас не обо мне нужно говорить."
    me "现在不该谈我。"

# game/a15/8cass_dec.rpy:53
translate english cass_dec_fix_6d3eb01c:

    # cass "Хотя бы в двух словах."
    cass "至少说两句。"

# game/a15/8cass_dec.rpy:54
translate english cass_dec_fix_e7ce88cd:

    # me "Нормально."
    me "还行。"

# game/a15/8cass_dec.rpy:55
translate english cass_dec_fix_f64960be:

    # cass "Это одно слово."
    cass "这是一个词。"

# game/a15/8cass_dec.rpy:56
translate english cass_dec_fix_bf3e0682:

    # me "[cass]..."
    me "[cass]……"

# game/a15/8cass_dec.rpy:57
translate english cass_dec_fix_b909b7b9:

    # cass "Что? Просто дурачусь."
    cass "怎么了？我只是闹着玩。"

# game/a15/8cass_dec.rpy:58
translate english cass_dec_fix_332c6f10:

    # me "Ну я рад, что ты в хорошем расположении духа, но ты ведь понимаешь, что тебе грозит казнь?"
    me "嗯，我很高兴你心情不错，但你知道他们想处决你吧？"

# game/a15/8cass_dec.rpy:59
translate english cass_dec_fix_07ff8cc2:

    # cass "Правда? За что?"
    cass "真的？为什么？"

# game/a15/8cass_dec.rpy:60
translate english cass_dec_fix_3820771a:

    # me "..."
    me "……"

# game/a15/8cass_dec.rpy:61
translate english cass_dec_fix_23794701:

    # cass "Я думала меня просто наругают и отпустят. Как в детстве, помнишь? Когда мы воровали сладкое с кухни."
    cass "我以为他们只会骂我一顿就放了我。像小时候那样，记得吗？我们偷厨房甜点的时候。"

# game/a15/8cass_dec.rpy:62
translate english cass_dec_fix_77103a2c:

    # me "Пожалуйста, [cass]. Будь серьезнее."
    me "拜托，[cass]。认真点。"

# game/a15/8cass_dec.rpy:63
translate english cass_dec_fix_655bcab1:

    # cass "Понятия не имею, чем моя серьезность тебе поможет. Если ты не заметил - я в тюремной камере в сыром подземелье."
    cass "我不知道我认真起来能帮你什么。如果你没注意到——我正待在一间潮湿地牢的牢房里。"

# game/a15/8cass_dec.rpy:65
translate english cass_dec_fix_77d5e5e8:

    # me "Об этом я и хотел поговорить. К тебе приходил Золотой Судья?"
    me "这正是我想谈的。金裁决来找过你吗？"

# game/a15/8cass_dec.rpy:66
translate english cass_dec_fix_1356af2f:

    # cass "Да. Я даже не знала, что они могут покидать здание Трибунала."
    cass "来过。我甚至不知道他们可以离开法庭大楼。"

# game/a15/8cass_dec.rpy:67
translate english cass_dec_fix_62620fb6:

    # me "И что он хотел?"
    me "他想要什么？"

# game/a15/8cass_dec.rpy:68
translate english cass_dec_fix_f55b6e5f:

    # cass "Забрать меня в свою тюрьму. Но твои люди не позволили. "
    cass "把我带去他们的监狱。但你的人不让。"

# game/a15/8cass_dec.rpy:69
translate english cass_dec_fix_efa9151e:

    # me "Допросы?"
    me "审讯？"

# game/a15/8cass_dec.rpy:70
translate english cass_dec_fix_11783e82:

    # cass "Да. Похоже у них нет одобрения отца и они не могут нарушить твой приказ."
    cass "对。看来他们没有得到父亲的批准，也不能违反你的命令。"

# game/a15/8cass_dec.rpy:71
translate english cass_dec_fix_e25fba09:

    # me "Отец им запретил?"
    me "父亲禁止了他们？"

# game/a15/8cass_dec.rpy:72
translate english cass_dec_fix_c2195c76:

    # cass "Нет. Полагаю ему вообще насрать. У них нет ни его одобрения, ни его запрета. Но его молчание для них гораздо полезнее."
    cass "不。我觉得他根本不在乎。他们既没有他的批准，也没有他的禁令。但他的沉默对他们更有用。"

# game/a15/8cass_dec.rpy:73
translate english cass_dec_fix_0f471515:

    # me "Они не могут действовать без воли короля. Императора."
    me "没有国王的意志，他们不能行动。皇帝的意志。"

# game/a15/8cass_dec.rpy:74
translate english cass_dec_fix_d7398a5e:

    # cass "У него право вето, [mename]. Если он безмолвствует, они вольны судить и наказывать за нарушение Золотого Порядка без чьего-либо одобрения."
    cass "他有否决权，[mename]。如果他保持沉默，他们就有权在无人批准的情况下审判并惩罚违反黄金秩序的人。"

# game/a15/8cass_dec.rpy:75
translate english cass_dec_fix_012e9fb1:

    # me "И все же они не забрали тебя. Значит мой приказ они нарушить не могут."
    me "可他们还是没带走你。说明他们不能违反我的命令。"

# game/a15/8cass_dec.rpy:76
translate english cass_dec_fix_15bbf62b:

    # cass "Ты кронпринц, твоя власть первого порядка, но ты не Император и теперь даже не регент. А значит твое решение они могут оспорить."
    cass "你是王储，你的权力是第一等的，但你不是皇帝，现在也不是摄政了。所以他们可以质疑你的决定。"

# game/a15/8cass_dec.rpy:77
translate english cass_dec_fix_297c7d95:

    # me "И все же пока не оспорили."
    me "可他们还没质疑。"

# game/a15/8cass_dec.rpy:78
translate english cass_dec_fix_e68bea3d:

    # cass "Тебя не было в столице. Это все, что их останавливало."
    cass "你不在首都。这就是唯一拦住他们的事。"

# game/a15/8cass_dec.rpy:79
translate english cass_dec_fix_98fb4da3:

    # me "Как это связано?"
    me "这有什么关系？"

# game/a15/8cass_dec.rpy:80
translate english cass_dec_fix_c68b2293:

    # cass "Золотой Порядок обязывает их сначала уведомить тебя и узнать, легитимна ли причина, по которой ты удерживаешь меня здесь."
    cass "黄金秩序要求他们先通知你，弄清你把我关在这里的理由是否合法。"

# game/a15/8cass_dec.rpy:82
translate english cass_dec_fix_8b133a37:

    # me "Я могу придумать еще тысячу причин."
    me "我还能想出一千个理由。"

# game/a15/8cass_dec.rpy:83
translate english cass_dec_fix_bd91ffdf:

    # cass "Думаешь, в законе, что существовал сотни лет, нет решения на этот случай? Сомневаюсь, что ты можешь допрашивать меня вечно."
    cass "你觉得存在了数百年的法律会没有应对这种情况的办法？我怀疑你不能永远审问我。"

# game/a15/8cass_dec.rpy:84
translate english cass_dec_fix_1e6f81eb:

    # me "И все же раньше они сюда не совались."
    me "可他们以前并没来这儿插手。"

# game/a15/8cass_dec.rpy:85
translate english cass_dec_fix_ff70db7e:

    # cass "Теперь у них есть поддержка от лордов."
    cass "现在他们有领主们的支持。"

# game/a15/8cass_dec.rpy:86
translate english cass_dec_fix_d841a36b:

    # me "Я думал, они уже все разьехались."
    me "我以为他们都已经走了。"

# game/a15/8cass_dec.rpy:87
translate english cass_dec_fix_385efa9f:

    # cass "Леонард. Его сын погиб по моей вине. Он пытался выбраться отсюда и его смертельно ранил мой человек. Он не успокоится и не уедет, пока я не умру."
    cass "莱昂纳德。他儿子因我而死。他想从这里逃出去，被我的人重伤致死。只要我不死，他就不会罢休，也不会离开。"

# game/a15/8cass_dec.rpy:88
translate english cass_dec_fix_1dd24aac:

    # me "Я все равно могу не отдавать тебя. Поставлю тебя охранять верных мне людей."
    me "我还是可以不交出你。我会派忠于我的人看守你。"

# game/a15/8cass_dec.rpy:89
translate english cass_dec_fix_a2f8fb14:

    # cass "А если Золотой Судья придет сюда с сотней мечей?"
    cass "要是金裁决带着一百把剑来这儿呢？"

# game/a15/8cass_dec.rpy:90
translate english cass_dec_fix_bdb75d62:

    # me "Я буду сам тебя охранять. Они не посмеют убить сына Императора."
    me "我会亲自守着你。他们不敢杀皇帝的儿子。"

# game/a15/8cass_dec.rpy:91
translate english cass_dec_fix_d37e7890:

    # cass "Не сходи с ума, [mename], они могут прийти, когда угодно, ты не можешь сидеть здесь в заточении вместе со мной вечно."
    cass "别疯了，[mename]。他们随时都能来。你不能永远和我一起关在这里。"

# game/a15/8cass_dec.rpy:92
translate english cass_dec_fix_e812e82f:

    # me "Странно, если все, что их удерживало, - это мое отсутствие, почему лорд Леонард не сообщил мне о решении Трибунала при встрече?"
    me "奇怪。如果唯一拦住他们的只是我不在，为什么莱昂纳德领主见面时没告诉我法庭的决定？"

# game/a15/8cass_dec.rpy:93
translate english cass_dec_fix_561e3361:

    # me "Спросил бы, а сегодня Трубинал вынес бы решение и они попытались бы тебя забрать."
    me "他本可以问，然后今天法庭作出裁决，他们就会试图带走你。"

# game/a15/8cass_dec.rpy:94
translate english cass_dec_fix_e21e251c:

    # cass "Они делают все по Закону. Может им нужен был именно эмиссар Трибунала? Может он уже ждет тебя на выходе из этой тюрьмы?"
    cass "他们一切都依法行事。也许他们需要的正是法庭特使？也许他已经在监狱出口等着你了？"

# game/a15/8cass_dec.rpy:95
translate english cass_dec_fix_c73131c7:

    # me "Выходит, только отец может тебя спасти?"
    me "所以只有父亲能救你？"

# game/a15/8cass_dec.rpy:96
translate english cass_dec_fix_16e1d3dd:

    # cass "А он станет?"
    cass "他会吗？"

# game/a15/8cass_dec.rpy:97
translate english cass_dec_fix_f44cf4ae:

    # me "Не уверен... но если нет - тогда обратной дороги не будет. Я не хочу рисковать."
    me "不确定……但如果不救——那就没有回头路了。我不想冒险。"

# game/a15/8cass_dec.rpy:99
translate english cass_dec_fix_96eb865c:

    # me "Ты выполнил мой приказ. Ты верен мне?"
    me "你执行了我的命令。你忠于我吗？"

# game/a15/8cass_dec.rpy:100
translate english cass_dec_fix_e7527f74_1:

    # guard "Мой принц."
    guard "我的王子。"

# game/a15/8cass_dec.rpy:101
translate english cass_dec_fix_b6e4f9aa:

    # me "Ты знаешь, что я брал приступом этот замок и проливал за него кровь. Ты знаешь, что я бился за моего отца и его жизнь, верно? Ты верен мне?"
    me "你知道我攻下过这座城堡，为它流过血。你知道我为父亲和他的性命而战，对吧？你忠于我吗？"

# game/a15/8cass_dec.rpy:102
translate english cass_dec_fix_6005c985:

    # guard "Верен, мой принц."
    guard "我忠于您，我的王子。"

# game/a15/8cass_dec.rpy:103
translate english cass_dec_fix_3a761b5c:

    # me "Поверишь ли ты мне, если я скажу, что убить мою сестру будет ошибкой?"
    me "如果我说杀我妹妹是个错误，你会相信我吗？"

# game/a15/8cass_dec.rpy:104
translate english cass_dec_fix_3cd96912:

    # guard "Мой принц... я не знаю..."
    guard "我的王子……我不知道……"

# game/a15/8cass_dec.rpy:105
translate english cass_dec_fix_7814c540:

    # me "Она виновна. Она заслужила наказание. И все же это не она отравила моего отца и убила сына лорда Леонарда. Ее казнь - излишняя и вредная жестокость."
    me "她有罪。她该受罚。但毒害我父亲、杀死莱昂纳德领主之子的不是她。处决她只会带来多余而有害的残酷。"

# game/a15/8cass_dec.rpy:106
translate english cass_dec_fix_5233a746:

    # guard "..."
    guard "……"

# game/a15/8cass_dec.rpy:107
translate english cass_dec_fix_82a6ee9c:

    # me "Мне нужна твоя помощь. Помоги мне и я сделаю тебя своим гвардейцем. Личным. А когда я стану Императором, ты будешь в моей личной охране."
    me "我需要你的帮助。帮帮我，我就让你当我的卫兵。贴身卫兵。等我成为皇帝，你就在我的亲卫队里。"

# game/a15/8cass_dec.rpy:108
translate english cass_dec_fix_abb29409:

    # guard "Да, мой принц."
    guard "是，我的王子。"

# game/a15/8cass_dec.rpy:109
translate english cass_dec_fix_1b0f814f:

    # me "Хорошо. Кто из тех, кто выполняет мой приказ здесь мне верен?"
    me "好。在这里执行我命令的人里，谁忠于我？"

# game/a15/8cass_dec.rpy:110
translate english cass_dec_fix_6c0b1742:

    # guard "Все... все, мой принц."
    guard "所有人……所有人，我的王子。"

# game/a15/8cass_dec.rpy:111
translate english cass_dec_fix_971ae31b:

    # me "Ты замялся."
    me "你犹豫了。"

# game/a15/8cass_dec.rpy:112
translate english cass_dec_fix_694faa00:

    # guard "Может... в паре людей я не уверен, они сомневались в вашем приказе, когда пришел Золотой Судья."
    guard "也许……有几个人我不确定。金裁决来的时候，他们怀疑过您的命令。"

# game/a15/8cass_dec.rpy:113
translate english cass_dec_fix_6cc9cb8a:

    # me "Хорошо. Скажешь мне их имена. В ночь свадьбы моей младшей сестры здесь должны будут оставаться только верные мне люди. Вы освободите мою сестру."
    me "好。把他们的名字告诉我。我妹妹婚礼那晚，这里只该留下忠于我的人。你们放走我妹妹。"

# game/a15/8cass_dec.rpy:114
translate english cass_dec_fix_56480deb:

    # guard "Мой принц. Мы можем вывести ее из тюрьмы, но и замок и город охраняются людьми верными Золотому Порядку."
    guard "我的王子。我们可以把她带出监狱，但城堡和城市都由忠于黄金秩序的人守卫。"

# game/a15/8cass_dec.rpy:117
translate english cass_dec_fix_c45c50ee:

    # me "Моя сестра поедет раздавать милостыню. Вся городская стража будет там. С моей сестрой и ее мужем будут молодые дети лордов, я в этом уверен. Замковая гвардия тоже будет занята."
    me "我妹妹要去施舍。全城守卫都会在那儿。她和她丈夫身边会有领主们的年轻子弟，我确定。城堡卫队也会忙着。"

# game/a15/8cass_dec.rpy:118
translate english cass_dec_fix_0757254d:

    # guard "Вашу сестру все еще могут выдать простолюдины."
    guard "平民仍可能出卖您妹妹。"

# game/a15/8cass_dec.rpy:119
translate english cass_dec_fix_ff5d3163:

    # me "Не волнуйся. Я уже кое-что придумал. Я расскажу тебе о полном плане позже. Для безопасности."
    me "别担心。我已经想到了一些办法。完整的计划我之后再告诉你。为了安全。"

# game/a15/8cass_dec.rpy:120
translate english cass_dec_fix_abb29409_1:

    # guard "Да, мой принц."
    guard "是，我的王子。"

# game/a15/8cass_dec.rpy:122
translate english cass_dec_fix_9c18f2f1:

    # cass "[mename], тебе не обязательно этого делать."
    cass "[mename]，你不必这么做。"

# game/a15/8cass_dec.rpy:123
translate english cass_dec_fix_7d5ac7fc:

    # me "Иначе тебя казнят."
    me "否则他们会处决你。"

# game/a15/8cass_dec.rpy:124
translate english cass_dec_fix_4570f0ca:

    # cass "Они поймут, что это сделал ты."
    cass "他们会明白这是你做的。"

# game/a15/8cass_dec.rpy:125
translate english cass_dec_fix_9858d324:

    # me "Мне плевать. У них не будет доказательств."
    me "我不在乎。他们不会有证据。"

# game/a15/8cass_dec.rpy:126
translate english cass_dec_fix_c7f43148:

    # cass "А охрана? Как они объяснят мою пропажу?"
    cass "那守卫呢？他们怎么解释我消失了？"

# game/a15/8cass_dec.rpy:127
translate english cass_dec_fix_bd3f497c:

    # me "Очень просто. 'Кто-то' помог тебе. Просунул тебе ключ и ты сбежала на пересменке, оглушив охранника."
    me "很简单。‘有人’帮了你。把钥匙塞给你，你在换班时打晕守卫逃了。"

# game/a15/8cass_dec.rpy:128
translate english cass_dec_fix_fa5a8f35:

    # cass "Их будут допрашивать."
    cass "他们会被审问。"

# game/a15/8cass_dec.rpy:129
translate english cass_dec_fix_56525b9f:

    # me "Ну что ты. Я отправлю всех своих людей на твой поиск. Они будут очень заняты твоей поимкой. Ты как раз хотела сбежать... куда там? В вольные города? Твой след теряется там."
    me "怎么会。我会派我所有人去搜捕你。他们会忙着抓你。你不是正想逃吗……去哪儿来着？自由城市？你的踪迹会在那里消失。"

# game/a15/8cass_dec.rpy:130
translate english cass_dec_fix_c2d4ba74:

    # cass "Они не идиоты. Они поймут, что это твоих рук дело. Что ты помог мне сбежать и спасаешь своих людей. Ты себя подставляешь."
    cass "他们不是傻子。他们会看出来这是你干的。你帮我逃走，还在保你的人。你在把自己搭进去。"

# game/a15/8cass_dec.rpy:131
translate english cass_dec_fix_b940a7b7:

    # me "Это мое решение. И оно окончательно."
    me "这是我的决定。而且是最终决定。"

# game/a15/8cass_dec.rpy:132
translate english cass_dec_fix_9cb98882:

    # cass "[mename]..."
    cass "[mename]……"

# game/a15/8cass_dec.rpy:133
translate english cass_dec_fix_48ee56cf:

    # me "Можешь не уговаривать меня поступить иначе. Я не дам тебе умереть."
    me "不用劝我改变主意。我不会让你死。"

# game/a15/8cass_dec.rpy:134
translate english cass_dec_fix_a214a7db:

    # cass "...спасибо."
    cass "……谢谢。"

# game/a15/8cass_dec.rpy:135
translate english cass_dec_fix_bd0ee1c9:

    # me "Мне ещё нужно подготовиться. Не могу больше тратить время. Увидимся, [cass]."
    me "我还得准备。不能再浪费时间了。再见，[cass]。"

# game/a15/8cass_dec.rpy:139
translate english cass_dec_fix2_424a9d52:

    # "Час спустя на выезде из города."
    "一小时后，在城门外。"

# game/a15/8cass_dec.rpy:140
translate english cass_dec_fix2_5c76dbe7:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a15/8cass_dec.rpy:141
translate english cass_dec_fix2_c2d9787b:

    # me "{i}...что-то их долго нет.{/i}"
    me "{i}……他们怎么这么久还不来。{/i}"

# game/a15/8cass_dec.rpy:142
translate english cass_dec_fix2_dcbe09c1:

    # me "{i}Может что-то случилось?{/i}"
    me "{i}也许出事了？{/i}"

# game/a15/8cass_dec.rpy:143
translate english cass_dec_fix2_f0eaa4f7:

    # me "{i}Нет. Наверняка просто все дороги забиты простым людом.{/i}"
    me "{i}不。多半只是路上挤满了平民。{/i}"

# game/a15/8cass_dec.rpy:144
translate english cass_dec_fix2_3459e189:

    # me "{i}Может он перепутал дороги?{/i}"
    me "{i}也许他走错路了？{/i}"

# game/a15/8cass_dec.rpy:145
translate english cass_dec_fix2_5c76dbe7_1:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a15/8cass_dec.rpy:146
translate english cass_dec_fix2_4c4e33cd:

    # me "{i}Эх... похоже придется идти проверять самому. А нет... вот и запах.{/i}"
    me "{i}唉……看来得我自己去看看了。不……味道来了。{/i}"

# game/a15/8cass_dec.rpy:148
translate english cass_dec_fix2_008884b6:

    # guard_per "Принц, [mename]."
    guard_per "[mename]王子。"

# game/a15/8cass_dec.rpy:149
translate english cass_dec_fix2_c3e3e803:

    # me "Ты чего так долго?"
    me "你怎么这么久？"

# game/a15/8cass_dec.rpy:150
translate english cass_dec_fix2_3fbe5ace:

    # guard_per "У мостов дежурили стражники. Пришлось искать объездные пути."
    guard_per "桥上有守卫。只能找绕行的路。"

# game/a15/8cass_dec.rpy:151
translate english cass_dec_fix2_c69a5273:

    # me "Впервые я не рад, что Столица так хорошо охраняется."
    me "这是我第一次不高兴首都守得这么好。"

# game/a15/8cass_dec.rpy:152
translate english cass_dec_fix2_0b81cc05:

    # guard_per "И я. Нас все же остановили."
    guard_per "我也是。他们还是拦住了我们。"

# game/a15/8cass_dec.rpy:153
translate english cass_dec_fix2_025280e8:

    # me "Правда? Где?"
    me "真的？在哪儿？"

# game/a15/8cass_dec.rpy:154
translate english cass_dec_fix2_f4cea0b1:

    # guard_per "У самого выезда из города."
    guard_per "就在出城口。"

# game/a15/8cass_dec.rpy:155
translate english cass_dec_fix2_2325fa76:

    # me "И что?"
    me "然后呢？"

# game/a15/8cass_dec.rpy:156
translate english cass_dec_fix2_09eb5a3a:

    # guard_per "Все нормально. Вы были правы, мой принц, никто не захотел проверять телегу золотаря. Правда этот запах ещё не скоро сойдёт."
    guard_per "没事。您说得对，我的王子，没人想检查清粪工的推车。不过这味道一时半会儿散不掉。"

# game/a15/8cass_dec.rpy:157
translate english cass_dec_fix2_7427fc10:

    # me "Я отблагодарю тебя как следует, не волнуйся. Этот запах еще будет ассоциироваться у тебя с золотом."
    me "我会好好谢你，别担心。以后这味道会让你联想到黄金。"

# game/a15/8cass_dec.rpy:159
translate english cass_dec_fix2_9f8370ee:

    # me "[cass]."
    me "[cass]。"

# game/a15/8cass_dec.rpy:160
translate english cass_dec_fix2_38a615fa:

    # cass "{size=-5}Тут никого нет.{/size}"
    cass "{size=-5}这里没人。{/size}"

# game/a15/8cass_dec.rpy:161
translate english cass_dec_fix2_2f3f2957:

    # me "Вылазь."
    me "出来。"

# game/a15/8cass_dec.rpy:162
translate english cass_dec_fix2_38fbb6d2:

    # cass "{size=-5}Кодовое слово.{/size}"
    cass "{size=-5}暗号。{/size}"

# game/a15/8cass_dec.rpy:163
translate english cass_dec_fix2_498c67a6:

    # me "Мы не придумывали никаких кодовых слов."
    me "我们没定过什么暗号。"

# game/a15/8cass_dec.rpy:164
translate english cass_dec_fix2_d340a339:

    # cass "{size=-5}Очень зря. Как я могу понять, что там ты, а не стражники?{/size}"
    cass "{size=-5}太糟了。我怎么知道外面是你，不是守卫？{/size}"

# game/a15/8cass_dec.rpy:165
translate english cass_dec_fix2_4ec8651d:

    # me "По голосу."
    me "凭声音。"

# game/a15/8cass_dec.rpy:166
translate english cass_dec_fix2_83b5b944:

    # cass "{size=-5}И все? У тебя просто может быть похожий голос.{/size}"
    cass "{size=-5}就这？也许有人声音像你。{/size}"

# game/a15/8cass_dec.rpy:167
translate english cass_dec_fix2_960ef75c:

    # me "Знаешь, если тебе нравится ехать в окружении вонючих бочек - можешь и до Черной Косы так добраться."
    me "你知道，如果你喜欢在臭桶堆里赶路——你可以就这样一路坐到黑镰。"

# game/a15/8cass_dec.rpy:168
translate english cass_dec_fix2_b8b79c2b:

    # cass "{size=-5}Боги, нет.{/size}"
    cass "{size=-5}天哪，不。{/size}"

# game/a15/8cass_dec.rpy:170
translate english cass_dec_fix2_9ddcad8f:

    # cass "Я думала, что сдохну. Воняет жутко."
    cass "我以为我要死了。臭得要命。"

# game/a15/8cass_dec.rpy:171
translate english cass_dec_fix2_0616ae74:

    # me "Это запах свободы."
    me "这是自由的味道。"

# game/a15/8cass_dec.rpy:172
translate english cass_dec_fix2_6682b584:

    # cass "Я все равно пару раз чуть не блеванула. Обязательно было везти меня среди дерьма?"
    cass "我还是差点吐了两次。非得让我待在一堆屎里吗？"

# game/a15/8cass_dec.rpy:173
translate english cass_dec_fix2_fff86519:

    # me "Обязательно, если ты хотела, чтобы тебя не нашли. И не нашли."
    me "如果你想不被发现，那就非得如此。而你没被发现。"

# game/a15/8cass_dec.rpy:174
translate english cass_dec_fix2_3cf5cf8d:

    # cass "Не уверена, что этого стоило. Это платье теперь воняет дерьмом."
    cass "我不确定这值不值。这裙子现在一股屎味。"

# game/a15/8cass_dec.rpy:175
translate english cass_dec_fix2_fe2743c9:

    # me "Радуйся, что я купил у золотаря только бочки, сначала я хотел купить и саму телегу, но она воняла так, что мне самому стало дурно."
    me "庆幸我只从清粪工那儿买了桶。起初我还想买推车本身，但它臭得连我都恶心。"

# game/a15/8cass_dec.rpy:176
translate english cass_dec_fix2_5c16c556:

    # cass "Что за шум был на улицах? Свадьба?"
    cass "街上那些喧闹是什么？婚礼？"

# game/a15/8cass_dec.rpy:177
translate english cass_dec_fix2_ddf9a145:

    # me "Ага. [lia] обеспечила нам частичное прикрытие своей раздачей милостыни. Хотя после выхода золота из реки, я не уверен, что эта милостыня вообще хоть кому-то нужна в этом городе."
    me "对。[lia]的施舍给我们提供了部分掩护。不过自从河里出了黄金，我不确定这城里还有谁需要施舍。"

# game/a15/8cass_dec.rpy:178
translate english cass_dec_fix2_b2bc17a0:

    # cass "Ух.. у меня спина затекла так сидеть. Поможешь вылезти?"
    cass "哎……这样坐着我背都僵了。帮我出去？"

# game/a15/8cass_dec.rpy:179
translate english cass_dec_fix2_93bddcf2:

    # me "Конечно. Держи руку."
    me "当然。抓住我的手。"

# game/a15/8cass_dec.rpy:181
translate english cass_dec_fix2_00c05ea5:

    # cass "Ну и?"
    cass "然后呢？"

# game/a15/8cass_dec.rpy:182
translate english cass_dec_fix2_ad02f53a:

    # me "Что?"
    me "什么？"

# game/a15/8cass_dec.rpy:183
translate english cass_dec_fix2_d7def28b:

    # cass "Что дальше?"
    cass "接下来怎么办？"

# game/a15/8cass_dec.rpy:184
translate english cass_dec_fix2_affec7d8:

    # me "Дальше Янт отцепит телегу и отдаст тебе лошадь."
    me "接下来扬特会把车卸下，把马给你。"

# game/a15/8cass_dec.rpy:185
translate english cass_dec_fix2_8041ab57:

    # cass "Лошадь?"
    cass "马？"

# game/a15/8cass_dec.rpy:186
translate english cass_dec_fix2_01939e80:

    # me "Ну можешь ехать на телеге, если хочешь."
    me "你想的话也可以坐推车走。"

# game/a15/8cass_dec.rpy:187
translate english cass_dec_fix2_d8dc7243:

    # cass "О боги, нет."
    cass "哦天哪，不。"

# game/a15/8cass_dec.rpy:188
translate english cass_dec_fix2_e695160b:

    # me "Я дам тебе немного золота. Достаточно, чтобы добраться до места, но не слишком много, чтобы привлекать внимание."
    me "我会给你一点黄金。够你到目的地，但不会多到引人注意。"

# game/a15/8cass_dec.rpy:189
translate english cass_dec_fix2_7c1ff9f0:

    # cass "Добраться куда?"
    cass "到哪儿？"

# game/a15/8cass_dec.rpy:190
translate english cass_dec_fix2_651498c7:

    # me "В Черную Косу."
    me "去黑镰。"

# game/a15/8cass_dec.rpy:191
translate english cass_dec_fix2_1ec9415b:

    # cass "В Черную Косу? Думаешь меня будут рады там видеть?"
    cass "去黑镰？你觉得他们会乐意看到我？"

# game/a15/8cass_dec.rpy:192
translate english cass_dec_fix2_1fccc14e:

    # me "Тебе хотят отрубить там голову?"
    me "他们想在那里砍你的头？"

# game/a15/8cass_dec.rpy:193
translate english cass_dec_fix2_5dc71130:

    # cass "Вроде нет."
    cass "好像没有。"

# game/a15/8cass_dec.rpy:194
translate english cass_dec_fix2_43bc120e:

    # me "Значит там уже лучше, чем здесь."
    me "那已经比这里好了。"

# game/a15/8cass_dec.rpy:195
translate english cass_dec_fix2_235104f6:

    # cass "...наверное. А чем мне защищаться в случае чего? Знаешь, одинокая девушка на лошади..."
    cass "……大概吧。那万一出事我拿什么自卫？你知道，一个骑马独行的姑娘……"

# game/a15/8cass_dec.rpy:196
translate english cass_dec_fix2_8e743e0a:

    # me "Я положил тебе в седло два кинжала. По дороге тебя встретит мой человек. Он поможет тебе пересечь Долину."
    me "我在鞍袋里放了两把匕首。路上我的人会接应你。他会帮你穿过山谷。"

# game/a15/8cass_dec.rpy:197
translate english cass_dec_fix2_1bc7dad7:

    # cass "Один?"
    cass "一个人？"

# game/a15/8cass_dec.rpy:198
translate english cass_dec_fix2_0a1c0ff1:

    # me "А ты хотела целую армию? Если вас будет слишком много - это привлечет ненужное внимание, по твоему следу могут пойти."
    me "你想要一整支军队？人太多会引来不必要的注意，可能会有人循着你的踪迹追来。"

# game/a15/8cass_dec.rpy:199
translate english cass_dec_fix2_72477a92:

    # cass "Я все еще хочу сказать, что это плохая идея."
