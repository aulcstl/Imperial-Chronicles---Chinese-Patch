    # elin "Где [mename]?"
    elin "[mename]在哪儿？"

# game/a15/8cass_dec.rpy:598
translate english lisa_mid_ev_1681d089:

    # elin "Пошел дурить голову моей сестре. Наплетет ей что-нибудь о том, что ему нужно в Столицу на пару дней. Срочное дело государственной важности."
    elin "去糊弄我妹妹了。他会跟她说他得去首都几天。什么紧急国务。"

# game/a15/8cass_dec.rpy:599
translate english lisa_mid_ev_7fa35a3f_1:

    # lisa "..."
    lisa "……"

# game/a15/8cass_dec.rpy:600
