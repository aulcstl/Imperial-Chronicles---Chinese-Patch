# TODO: Translation updated at 2026-09-06 06:53

# game/a15/10white_night.rpy:3
translate english white_night_396c128f:

    # "Час спустя."
    "一小时后。"

# game/a15/10white_night.rpy:4
translate english white_night_f967385f:

    # me "{i}...так, [lia] вернулась со своей раздачи милостыни.{i}"
    me "{i}……那么，[lia] 施舍完回来了。{i}"

# game/a15/10white_night.rpy:5
translate english white_night_41c4bc7b:

    # me "{i}Людей стало меньше.{i}"
    me "{i}人变少了。{i}"

# game/a15/10white_night.rpy:6
translate english white_night_78fbe6fe:

    # me "{i}Похоже остались только самые терпеливые и молодые.{i}"
    me "{i}看来只剩下最有耐心和最年轻的人了。{i}"

# game/a15/10white_night.rpy:7
translate english white_night_c57cff06:

    # me "{i}Хотя... я вижу отца.{i}"
    me "{i}不过……我看见父亲了。{i}"

# game/a15/10white_night.rpy:8
translate english white_night_8a08b8b9:

    # me "{i}Он тоже пообещал невесте танец или просто хочет уважить дочь присутствием?{i}"
    me "{i}他也答应了新娘要跳舞，还是只想用到场来表达对女儿的尊重？{i}"

# game/a15/10white_night.rpy:9
translate english white_night_03e2c234:

    # me "{i}О, кажется она меня заметила.{i}"
    me "{i}哦，她好像看到我了。{i}"

# game/a15/10white_night.rpy:10
translate english white_night_50de0857:

    # me "{i}Ну теперь точно нет дороги назад.{i}"
    me "{i}现在肯定没有回头路了。{i}"

# game/a15/10white_night.rpy:12
translate english white_night_9770a311:

    # lia "[mename]!"
    lia "[mename]！"

# game/a15/10white_night.rpy:13
translate english white_night_e09f9719:

    # me "Ну и как твоя авантюра с простолюдинами?"
    me "你和平民的那场冒险怎么样了？"

# game/a15/10white_night.rpy:14
translate english white_night_c17fe64d:

    # lia "Ты про раздачу милостыни? Замечательно! Люди так громко скандировали мое имя, что я думала, что оглохну."
    lia "你是说施舍？好极了！人们那么大声地喊我的名字，我还以为我要聋了。"

# game/a15/10white_night.rpy:15
translate english white_night_97008b8d:

    # me "Ты там не организовала давку? Помнишь свою первую раздачу хлеба?"
    me "你没在那儿搞出踩踏吧？还记得你第一次分发面包吗？"

# game/a15/10white_night.rpy:16
translate english white_night_081a77bc:

    # lia "Нет! Знаешь... горожане больше рады были меня видеть, никто особенно не стремился получить хлеб и монеты."
    lia "没有！你知道……城里人更高兴见到我，没人特别急着拿面包和钱币。"

# game/a15/10white_night.rpy:17
translate english white_night_ad77e8af:

    # me "Похоже недавний выход золота из реки сделал милостыню не столько востребованной."
    me "看来最近河里出金子的事让施舍没那么受欢迎了。"

# game/a15/10white_night.rpy:18
translate english white_night_765169d9:

    # lia "Наверное. Но все равно было весело! К тому же Кайден предложил раздавать вино."
    lia "大概吧。不过还是很好玩！而且凯登提议分发葡萄酒。"

# game/a15/10white_night.rpy:19
translate english white_night_b5cef831:

    # me "Аранское золотое?"
    me "阿兰的金色葡萄酒？"

# game/a15/10white_night.rpy:20
translate english white_night_7f25e3dd:

    # lia "Нет. То красное из Ривелье."
    lia "不是。是里维耶那种红的。"

# game/a15/10white_night.rpy:21
translate english white_night_bae72046:

    # me "Фух. Я уже испугался, что ты перевела лучшее вино на простолюдинов."
    me "呼。我还已经吓了一跳，以为你把最好的酒都用在平民身上了。"

# game/a15/10white_night.rpy:22
translate english white_night_15b766ac:

    # lia "Ты помнишь свое обещание?"
    lia "你记得你的承诺吗？"

# game/a15/10white_night.rpy:23
translate english white_night_5817956f:

    # me "Если бы не помнил - не пришел бы."
    me "要是不记得，我就不会来了。"

# game/a15/10white_night.rpy:24
translate english white_night_4dd8e913:

    # lia "Тогда пошли танцевать!"
    lia "那就去跳舞吧！"

# game/a15/10white_night.rpy:26
translate english white_night_349057df:

    # me "Что? Сейчас? Музыка не слишком подходящая."
    me "什么？现在？音乐不太合适。"

# game/a15/10white_night.rpy:27
translate english white_night_ad8da109:

    # lia "Как только музыканты увидят, что мы танцуем, они нам подыграют."
    lia "乐师们一看到我们在跳舞，就会给我们伴奏的。"

# game/a15/10white_night.rpy:28
translate english white_night_0ed50b11:

    # me "Ладно-ладно. Не тяни так за рукав - порвешь."
    me "好吧好吧。别那么拽袖子——会扯破的。"

# game/a15/10white_night.rpy:29
translate english white_night_461085b7:

    # lia "Ты и так опоздал."
    lia "你本来就迟到了。"

# game/a15/10white_night.rpy:30
translate english white_night_33181a85:

    # me "Опоздал? Мы вроде не уславливались на конкретное время."
    me "迟到？我们好像没约具体时间吧。"

# game/a15/10white_night.rpy:31
translate english white_night_bb355926:

    # lia "Знаю. Но дворяне и так почти все разошлись."
    lia "我知道。可贵族们几乎都已经散了。"

# game/a15/10white_night.rpy:32
translate english white_night_51856684:

    # me "Стесняешься танцевать одна?"
    me "不好意思一个人跳？"

# game/a15/10white_night.rpy:33
translate english white_night_5ecc2c1a:

    # lia "Я? Нет, конечно. Но вместе с другими всяко веселей."
    lia "我？当然不是。但和别人一起总归更开心。"

# game/a15/10white_night.rpy:35
translate english white_night_dbfd21db:

    # me "Забыл тебя предупредить - я танцор не очень."
    me "忘了提醒你——我跳舞不太行。"

# game/a15/10white_night.rpy:36
translate english white_night_ef689d4b:

    # lia "Не ври, я знаю, что перед свадьбой ты ходил на бал."
    lia "别撒谎，我知道你婚礼前去过舞会。"

# game/a15/10white_night.rpy:37
translate english white_night_45e0b730:

    # me "А. Тот самый, на который она тебя не пустила?"
    me "啊。就是她没让你去的那个？"

# game/a15/10white_night.rpy:38
translate english white_night_af78121d:

    # lia "Да!"
    lia "对！"

# game/a15/10white_night.rpy:39
translate english white_night_2289c4d6:

    # me "Тогда я танцевал в первый и последний раз в жизни."
    me "那是我人生中第一次也是最后一次跳舞。"

# game/a15/10white_night.rpy:40
translate english white_night_f3eb3dbc:

    # lia "Уже не в последний."
    lia "已经不是最后一次了。"

# game/a15/10white_night.rpy:41
translate english white_night_9f8b303b:

    # me "Получается так."
    me "看来是这样。"

# game/a15/10white_night.rpy:42
translate english white_night_de0c2a2d:

    # lia "Просто танцуй, как тебе велит музыка и все."
    lia "就按音乐让你跳的那样跳就行了。"

# game/a15/10white_night.rpy:43
translate english white_night_51e3d1e1:

    # me "Боюсь это будет выглядеть смешно."
    me "我怕那看起来会很可笑。"

# game/a15/10white_night.rpy:44
translate english white_night_0840dbad:

    # lia "Никто не посмеет смеяться над невестой."
    lia "没人敢嘲笑新娘。"

# game/a15/10white_night.rpy:45
translate english white_night_080cefe8:

    # me "А вот над ее партнером по танцам..."
    me "可她的舞伴就……"

# game/a15/10white_night.rpy:46
translate english white_night_eb55a7af:

    # lia "Здесь все уже достаточно пьяны, что бы смеяться над чем угодно над чем угодно."
    lia "这里所有人都已经醉到可以嘲笑任何事了。"

# game/a15/10white_night.rpy:47
translate english white_night_db84bdec:

    # me "И ты?"
    me "那你呢？"

# game/a15/10white_night.rpy:48
translate english white_night_c1fdc781:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:49
translate english white_night_1f8673fc:

    # me "[lia]?"
    me "[lia]？"

# game/a15/10white_night.rpy:50
translate english white_night_dd747e3f:

    # lia "Может чуть-чуть."
    lia "也许有一点。"

# game/a15/10white_night.rpy:53
translate english white_night_b5890181:

    # lagg "Эх... может пуститься в пляс вместе с ними?"
    lagg "唉……要不也跟他们一起跳起来？"

# game/a15/10white_night.rpy:54
translate english white_night_d61e9a54:

    # leonard "По-моему вы немного опоздали, Лаггариус."
    leonard "我看您有点迟了，拉加里乌斯。"

# game/a15/10white_night.rpy:55
translate english white_night_2d13c7cc:

    # lagg "Они только начали."
    lagg "他们才刚开始。"

# game/a15/10white_night.rpy:56
translate english white_night_099670f8:

    # leonard "Я не об этом. Вы будете слегка не к месту, не думаете?"
    leonard "我不是说这个。您会有点不合时宜，不觉得吗？"

# game/a15/10white_night.rpy:57
translate english white_night_83381123:

    # lagg "Почему это? Накину золотой плащ и..."
    lagg "怎么会？我披上金披风就……"

# game/a15/10white_night.rpy:58
translate english white_night_c0ece96c:

    # leonard "Да при чем тут ваша одежда? Вы староваты для танцев."
    leonard "您的衣服跟这有什么关系？您跳舞有点太老了。"

# game/a15/10white_night.rpy:59
translate english white_night_7d888b10:

    # lagg "Староват? В каком это смысле?"
    lagg "太老？什么意思？"

# game/a15/10white_night.rpy:60
translate english white_night_0aac48f4:

    # leonard "В прямом. Ваши лучшие годы для танцев прошли лет так тридцать назад."
    leonard "就是字面意思。您跳舞的最好年华大概三十年前就过去了。"

# game/a15/10white_night.rpy:61
translate english white_night_7de33863:

    # lagg "Я не так уж и стар."
    lagg "我没那么老。"

# game/a15/10white_night.rpy:62
translate english white_night_1b1b5da8:

    # leonard "Ваша седина с вами не согласна."
    leonard "您的白发可不同意。"

# game/a15/10white_night.rpy:63
translate english white_night_de332c61:

    # lagg "Мой отец говорил, что мужчина по-настоящему стареет, когда у него начинают выпадать зубы."
    lagg "我父亲说过，男人真正变老，是从牙齿开始掉的时候。"

# game/a15/10white_night.rpy:64
translate english white_night_fab29477:

    # leonard "Вы столько выпили, что если пуститесь в пляс, то пару зубов точно потеряете."
    leonard "您喝了那么多，要是跳起来，肯定得掉几颗牙。"

# game/a15/10white_night.rpy:65
translate english white_night_e6ea3c19:

    # lagg "Ну хоть и мне и остальным будет весело."
    lagg "至少我和别人都会开心。"

# game/a15/10white_night.rpy:66
translate english white_night_13a38145:

    # leonard "Что же, если самоцель это покалечиться и опозориться - не смею вас задерживать, Лаггариус."
    leonard "好吧，如果目的就是弄伤自己还丢脸——那我不拦您，拉加里乌斯。"

# game/a15/10white_night.rpy:69
translate english white_night_c0aef935:

    # leonard "Удивительно, как вы еще живы."
    leonard "真奇怪，您居然还活着。"

# game/a15/10white_night.rpy:70
translate english white_night_fafe3a89:

    # pojnas "М?"
    pojnas "嗯？"

# game/a15/10white_night.rpy:71
translate english white_night_61bcd9b7:

    # leonard "Если бы я столько съел и выпил, но мне бы еще неделю пришлось приходить в себя."
    leonard "要是我吃喝了那么多，我得再花一个星期才能缓过来。"

# game/a15/10white_night.rpy:72
translate english white_night_5e3cfb8e:

    # pojnas "Дело в тренировках."
    pojnas "这是训练的问题。"

# game/a15/10white_night.rpy:73
translate english white_night_b0c3837f:

    # leonard "В тренировках? Ни в жизнь не поверю, что вы тренируетесь с чем-то кроме куска жирной жареной свинины."
    leonard "训练？我死也不信您除了拿一块油腻的烤猪肉之外还会拿什么训练。"

# game/a15/10white_night.rpy:74
translate english white_night_50941fda:

    # pojnas "Разумеется нет. Эти руки для кубка с дорогим вином, а не для меча. Вот с вином и едой я регулярно и тренируюсь."
    pojnas "当然不是。这双手是拿来端昂贵酒杯的，不是拿剑的。我倒是经常拿酒和食物训练。"

# game/a15/10white_night.rpy:75
translate english white_night_a9043b6c:

    # leonard "Заметно. Ваш ремень едва сдерживает ваше брюхо."
    leonard "看得出来。您的腰带都快拦不住您的肚子了。"

# game/a15/10white_night.rpy:76
translate english white_night_456be3dc:

    # pojnas "Правда? Спасибо, я его ослаблю."
    pojnas "是吗？谢谢，我会把它放松点。"

# game/a15/10white_night.rpy:77
translate english white_night_4d3f1952:

    # leonard "Не проще носить платье?"
    leonard "穿裙子不是更省事？"

# game/a15/10white_night.rpy:78
translate english white_night_bf01865b:

    # pojnas "Спасибо за совет. Я подумаю. Так в меня влезет еще больше вкусной еды."
    pojnas "谢谢建议。我会考虑。这样还能塞进更多好吃的。"

# game/a15/10white_night.rpy:79
translate english white_night_2cfef1d7:

    # leonard "Боюсь, что в таком темпе один из ваших следующих пиров станет последним."
    leonard "我怕照这个速度，您接下来的某场宴会就会是最后一场。"

# game/a15/10white_night.rpy:80
translate english white_night_615f714f:

    # pojnas "О. Ничего страшного. Зато я провожу время на пирах с большим удовольствием, а не брюзжу, как старик."
    pojnas "哦。没什么。至少我在宴会上过得很开心，而不是像个老头一样发牢骚。"

# game/a15/10white_night.rpy:81
translate english white_night_04a735cd:

    # leonard "..."
    leonard "……"

# game/a15/10white_night.rpy:83
translate english white_night_d8fd78da:

    # me "Танцевала с Кайденом?"
    me "和凯登跳舞了吗？"

# game/a15/10white_night.rpy:84
translate english white_night_e7893e97:

    # lia "Конечно! Тебя тогда уже не было в зале."
    lia "当然！那时候你已经不在大厅里了。"

# game/a15/10white_night.rpy:85
translate english white_night_0a3ed49e:

    # me "Да. Большие скопления людей меня быстро утомляют."
    me "是啊。人一多我很快就累了。"

# game/a15/10white_night.rpy:86
translate english white_night_197635ab:

    # lia "Отец приставил ко мне охрану и они быстро отсекали просителей."
    lia "父亲给我派了守卫，他们很快就把求见的人挡开了。"

# game/a15/10white_night.rpy:87
translate english white_night_489a247d:

    # me "Правда?"
    me "真的？"

# game/a15/10white_night.rpy:88
translate english white_night_ae529391:

    # lia "Ага. Так что вечер прошел очень хорошо. Так что тебе не стоило уходить."
    lia "嗯。所以晚上过得很不错。所以你本不该走的。"

# game/a15/10white_night.rpy:89
translate english white_night_3642f725:

    # me "Почему это?"
    me "为什么？"

# game/a15/10white_night.rpy:90
translate english white_night_20286a0c:

    # lia "Попросил бы и отец приставил гвардейцев и к тебе."
    lia "你开口的话，父亲也会给你派卫兵的。"

# game/a15/10white_night.rpy:91
translate english white_night_a60719a4:

    # me "Во-первых они мне не нравятся."
    me "第一，我不喜欢他们。"

# game/a15/10white_night.rpy:92
translate english white_night_6cf968e9:

    # lia "Новые гвардейцы? Почему?"
    lia "新卫兵？为什么？"

# game/a15/10white_night.rpy:93
translate english white_night_e9f3f765:

    # me "Долго объяснять."
    me "说来话长。"

# game/a15/10white_night.rpy:94
translate english white_night_2c65efe7:

    # lia "Ладно. А во-вторых?"
    lia "好吧。那第二呢？"

# game/a15/10white_night.rpy:95
translate english white_night_dfcceeac:

    # me "М?"
    me "嗯？"

# game/a15/10white_night.rpy:96
translate english white_night_16e345dd:

    # lia "Ты сказал во-первых, значит есть и во-вторых."
    lia "你说了第一，那就肯定有第二。"

# game/a15/10white_night.rpy:97
translate english white_night_727535b7:

    # me "Во-вторых я не молодая невеста. Если я буду закрываться от людей гвардейцами это их оскорбит."
    me "第二，我不是年轻新娘。要是我用卫兵把自己和人们隔开，会冒犯他们。"

# game/a15/10white_night.rpy:98
translate english white_night_96e360a8:

    # lia "А если ты будешь избегать их?"
    lia "那你躲着他们呢？"

# game/a15/10white_night.rpy:99
translate english white_night_c2881531:

    # me "Это куда более пристойно."
    me "那要体面得多。"

# game/a15/10white_night.rpy:101
translate english white_night_353d5d46:

    # lia "Ты ведь... придешь сегодня ночью?"
    lia "你……今晚会来吗？"

# game/a15/10white_night.rpy:102
translate english white_night_4cefc080:

    # me "Тише. Не так громко."
    me "小声点。别那么大声。"

# game/a15/10white_night.rpy:103
translate english white_night_c1fdc781_1:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:104
translate english white_night_3820771a:

    # me "..."
    me "……"

# game/a15/10white_night.rpy:105
translate english white_night_ddb91119:

    # lia "Так..."
    lia "那么……"

# game/a15/10white_night.rpy:106
translate english white_night_b3577fb9:

    # me "Приду."
    me "会来。"

# game/a15/10white_night.rpy:107
translate english white_night_ce2aae07:

    # lia "Хорошо. Я буду ждать. Мы будем ждать."
    lia "好。我会等你。我们会等你。"

# game/a15/10white_night.rpy:109
translate english white_night_88460042:

    # me "Знаешь, у тебя очень неплохо получается."
    me "你知道，你跳得相当不错。"

# game/a15/10white_night.rpy:110
translate english white_night_8c0b11af:

    # lia "Правда?"
    lia "真的？"

# game/a15/10white_night.rpy:111
translate english white_night_70fb8752:

    # me "Да. Я конечно не эксперт по танцам, но мне кажется у тебя выходит очень хорошо."
    me "是啊。我当然不是舞蹈专家，但我觉得你跳得很好。"

# game/a15/10white_night.rpy:112
translate english white_night_3c8f0256:

    # lia "Это потому что мы двигаемся в потоке музыки. Опыт не так важен, сколько чувства."
    lia "那是因为我们随着音乐的流动在动。比起经验，感觉更重要。"

# game/a15/10white_night.rpy:113
translate english white_night_cf8fcc71:

    # me "...не уверен, что дело только в этом. Ты тренировалась?"
    me "……我不确定只是因为这个。你练过？"

# game/a15/10white_night.rpy:114
translate english white_night_45a96806:

    # lia "Конечно. Много раз!"
    lia "当然。练过很多次！"

# game/a15/10white_night.rpy:115
translate english white_night_0959698a:

    # me "Я так и подумал. Уверен ты умела танцевать еще к тому времени, как мать тебе запретила идти на бал."
    me "我就这么想。我敢肯定，在母亲禁止你去舞会之前，你就已经会跳舞了。"

# game/a15/10white_night.rpy:116
translate english white_night_57af685a:

    # lia "Ну да..."
    lia "嗯，是啊……"

# game/a15/10white_night.rpy:117
translate english white_night_a997a03e:

    # lia "Тебе правда нравится?"
    lia "你真的喜欢吗？"

# game/a15/10white_night.rpy:118
translate english white_night_c22f8e04:

    # me "Ага. Удивлен, как моя сестренка может быть такой женственной."
    me "嗯。我很惊讶，我的小妹居然能这么有女人味。"

# game/a15/10white_night.rpy:119
translate english white_night_5bebe283:

    # lia "Спасибо!"
    lia "谢谢！"

# game/a15/10white_night.rpy:120
translate english white_night_70f558f2:

    # me "Ты красивее всех на этой свадьбе."
    me "你是这场婚礼上最漂亮的。"

# game/a15/10white_night.rpy:121
translate english white_night_4a7a7b3d:

    # lia "Так и должно быть! Я невеста!"
    lia "本来就该这样！我是新娘！"

# game/a15/10white_night.rpy:122
translate english white_night_6a2f5d7a:

    # me "Разумеется. Но кто бы мог подумать, что невеста еще и танцевать будет лучше всех."
    me "当然。但谁能想到，新娘还会跳得比谁都好。"

# game/a15/10white_night.rpy:123
translate english white_night_7d1df699:

    # lia "По-моему ты мне уже просто льстишь."
    lia "我觉得你现在只是在奉承我。"

# game/a15/10white_night.rpy:124
translate english white_night_bc805d96:

    # me "Нет. Уверен ты бы блистала и на том балу, куда тебя не пустили."
    me "不是。我敢肯定，在那个没让你去的舞会上，你也会大放光彩。"

# game/a15/10white_night.rpy:125
translate english white_night_f2e57b5b:

    # lia "Наверное..."
    lia "大概吧……"

# game/a15/10white_night.rpy:128
translate english white_night_41b9ff6c:

    # lia "Жаль ее нет на моей свадьбе..."
    lia "可惜她不在我的婚礼上……"

# game/a15/10white_night.rpy:129
translate english white_night_2b923f6a:

    # me "Ну... она отправилась по имперскому поручению. Кажется..."
    me "嗯……她去执行帝国任务了。好像……"

# game/a15/10white_night.rpy:130
translate english white_night_166e71a0:

    # lia "Знаю. Но я все равно думала, что она сначала дождется моей свадьбы."
    lia "我知道。但我还是以为她会先等我的婚礼结束。"

# game/a15/10white_night.rpy:131
translate english white_night_1d88577f:

    # me "Ну видимо дело... действительно важное."
    me "看来事情……确实很重要。"

# game/a15/10white_night.rpy:132
translate english white_night_57b349e7:

    # lia "Не знаю. Я спрашивала отца и он говорил, что это вообще была ее инициатива."
    lia "我不知道。我问过父亲，他说这本来就是她的主意。"

# game/a15/10white_night.rpy:133
translate english white_night_a6412a8f:

    # me "Мм... ну... уверен она хотела бы побывать на твоей свадьбе."
    me "嗯……这个……我相信她会想来参加你的婚礼的。"

# game/a15/10white_night.rpy:134
translate english white_night_e5a976c3:

    # lia "Так странно, она все последние месяцы носила свободную одежду и вела себя беспокойно. Будто болела или... не знаю... была беременна?"
    lia "真奇怪，她最后这几个月都穿宽松衣服，还心神不宁。像是病了，或者……我不知道……怀孕了？"

# game/a15/10white_night.rpy:135
translate english white_night_5e7e885e:

    # me "...правда?"
    me "……真的？"

# game/a15/10white_night.rpy:136
translate english white_night_059cceb2:

    # lia "Мгм. А перед отъездом попрощалась со мной и заплакала. А живот у нее был совсем большой."
    lia "嗯。而且临走前跟我告别时还哭了。她的肚子已经很大了。"

# game/a15/10white_night.rpy:137
translate english white_night_3820771a_1:

    # me "..."
    me "……"

# game/a15/10white_night.rpy:138
translate english white_night_266f8da5:

    # lia "Думаешь, что-то плохое могло случиться?"
    lia "你觉得可能出什么不好的事了吗？"

# game/a15/10white_night.rpy:139
translate english white_night_3674d9bb:

    # me "Нет. Нет. Уверен, что все в порядке."
    me "不。不。我相信一切都没事。"

# game/a15/10white_night.rpy:140
translate english white_night_21f400e9:

    # lia "Но разве отец не должен был быть счастлив ребенку?"
    lia "可父亲不是应该为孩子高兴吗？"

# game/a15/10white_night.rpy:141
translate english white_night_f7747ded:

    # me "Ну... мы ведь не знаем, беременна ли Императрица. Тем более отец и мать могли поссориться, потому что мать решила рожать в эльфийской роще."
    me "嗯……我们毕竟不知道皇后是不是怀孕了。更何况父亲和母亲可能吵过，因为母亲决定在精灵林间生产。"

# game/a15/10white_night.rpy:142
translate english white_night_6a8cfa97:

    # lia "Она так решила?"
    lia "她这么决定了？"

# game/a15/10white_night.rpy:143
translate english white_night_3ac192c9:

    # me "Нет...я просто предположил."
    me "不……我只是猜的。"

# game/a15/10white_night.rpy:144
translate english white_night_c1fdc781_2:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:145
translate english white_night_515e3308:

    # me "Не грусти. Она еще вернется."
    me "别难过。她还会回来的。"

# game/a15/10white_night.rpy:146
translate english white_night_76417e7f:

    # lia "Ну да. Конечно."
    lia "嗯。当然。"

# game/a15/10white_night.rpy:148
translate english white_night_c1096561:

    # lia "А еще я так давно не видела дядю Конрада."
    lia "还有，我好久没见到康拉德叔叔了。"

# game/a15/10white_night.rpy:149
translate english white_night_3820771a_2:

    # me "..."
    me "……"

# game/a15/10white_night.rpy:150
translate english white_night_e23355bd:

    # lia "С ним все нормально? Отец не говорит куда он делся."
    lia "他没事吧？父亲不说他去哪儿了。"

# game/a15/10white_night.rpy:151
translate english white_night_20808130:

    # me "Уверен он на каком-то важном поручении."
    me "我相信他在执行什么重要任务。"

# game/a15/10white_night.rpy:152
translate english white_night_12ba2bcb:

    # lia "...да? Ну ладно."
    lia "……是吗？那好吧。"

# game/a15/10white_night.rpy:154
translate english white_night_adc53788:

    # me "Кстати, где сама Императрица?"
    me "对了，皇后本人呢？"

# game/a15/10white_night.rpy:155
translate english white_night_412c63e5:

    # lia "Пошла провожать тех гостей, кто больше уже не в состоянии ни танцевать, ни пить."
    lia "去送那些已经既跳不动也喝不下的客人了。"

# game/a15/10white_night.rpy:156
translate english white_night_ffc51265:

    # me "Понятно."
    me "明白了。"

# game/a15/10white_night.rpy:158
translate english white_night_acddf54f:

    # lia "Тебе нужно пригласить [elin]."
    lia "你该去邀请[elin]。"

# game/a15/10white_night.rpy:159
translate english white_night_dfcceeac_1:

    # me "М?"
    me "嗯？"

# game/a15/10white_night.rpy:160
translate english white_night_47895b75:

    # lia "Она с тебя целый вечер глаз не сводит."
    lia "她一晚上都没把眼睛从你身上移开。"

# game/a15/10white_night.rpy:161
translate english white_night_489a247d_1:

    # me "Правда?"
    me "真的？"

# game/a15/10white_night.rpy:162
translate english white_night_da4a6037:

    # lia "Да. Наверняка тоже хочет потанцевать."
    lia "是啊。肯定也想跳舞。"

# game/a15/10white_night.rpy:163
translate english white_night_5e671aad:

    # me "Ну... у нее же есть Локхарт."
    me "嗯……可她有洛克哈特啊。"

# game/a15/10white_night.rpy:164
translate english white_night_b5539cbd:

    # lia "Думаю она хочет потанцевать именно с тобой!"
    lia "我觉得她想跳的就是和你跳！"

# game/a15/10white_night.rpy:165
translate english white_night_fe3fe08f:

    # me "Понимаю. Но не слишком прилично приглашать на... публичный танец чужую жену."
    me "我明白。可邀请别人的妻子去……公开跳舞，不太体面。"

# game/a15/10white_night.rpy:166
translate english white_night_752bf906:

    # lia "Но это твоя сестра. К тому же Локхарт будет не против, я уверена."
    lia "可她是你的姐妹。而且洛克哈特不会介意的，我敢肯定。"

# game/a15/10white_night.rpy:167
translate english white_night_9fcd227e:

    # me "Так что, мне оставить тебя и пригласить [elin]?"
    me "那我该丢下你去邀请[elin]？"

# game/a15/10white_night.rpy:168
translate english white_night_10ddbcfd:

    # lia "Нет. Сначала дотанцуй со мной."
    lia "不。先和我跳完这支舞。"

# game/a15/10white_night.rpy:169
translate english white_night_914c30c6:

    # me "Как скажете, моя принцесса."
    me "如您所愿，我的公主。"

# game/a15/10white_night.rpy:170
translate english white_night_0db9bc21:

    # lia "Лучше называй меня [ophie]."
    lia "最好叫我[ophie]。"

# game/a15/10white_night.rpy:171
translate english white_night_78cc1f6b:

    # me "Конечно, принцесса [ophie]."
    me "当然，[ophie]公主。"

# game/a15/10white_night.rpy:173
translate english white_night_758062d7:

    # lia "Спасибо, [mename]."
    lia "谢谢你，[mename]。"

# game/a15/10white_night.rpy:174
translate english white_night_9508d41b:

    # me "За что?"
    me "谢什么？"

# game/a15/10white_night.rpy:175
translate english white_night_19f58e72:

    # lia "За то, что сдержал обещание."
    lia "谢谢你遵守了承诺。"

# game/a15/10white_night.rpy:176
translate english white_night_bc2f981c:

    # me "Ну что ты. Это было не слишком сложно."
    me "哎呀。这也不算太难。"

# game/a15/10white_night.rpy:177
translate english white_night_ecc87acf:

    # lia "Все равно спасибо. Ты хороший брат."
    lia "还是谢谢。你是个好兄弟。"

# game/a15/10white_night.rpy:178
translate english white_night_a69b45b2:

    # me "Обязательно напиши об этом в Хрониках."
    me "一定要把这事写进编年史。"

# game/a15/10white_night.rpy:179
translate english white_night_53c321be:

    # lia "Напишу."
    lia "我会写。"

# game/a15/10white_night.rpy:180
translate english white_night_5453301d:

    # me "Я пошутил."
    me "我开玩笑的。"

# game/a15/10white_night.rpy:181
translate english white_night_69155f72:

    # lia "А я нет. Любовь к семье это хорошая черта для правителя, я уверена."
    lia "我不是。对家人的爱是统治者很好的品质，我敢肯定。"

# game/a15/10white_night.rpy:182
translate english white_night_139771ed:

    # me "Тебя легко любить, [lia], ты не какой-нибудь злобный младший брат, претендующий на трон."
    me "你很容易让人爱，[lia]，你不是那种觊觎王位的恶毒弟弟。"

# game/a15/10white_night.rpy:183
translate english white_night_130ccde5:

    # lia "Уверена, если бы у тебя был брат, ты бы его любил не меньше."
    lia "我相信，如果你有兄弟，你也会一样爱他。"

# game/a15/10white_night.rpy:184
translate english white_night_3820771a_3:

    # me "..."
    me "……"

# game/a15/10white_night.rpy:185
translate english white_night_c1fdc781_3:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:187
translate english white_night_6e00b3b0:

    # me "Не устала?"
    me "不累吗？"

# game/a15/10white_night.rpy:188
translate english white_night_b4e657af:

    # lia "М-м."
    lia "嗯。"

# game/a15/10white_night.rpy:189
translate english white_night_bcf516e1:

    # me "Точно? Ты уже довольно давно на ногах."
    me "确定？你已经站了挺久了。"

# game/a15/10white_night.rpy:191
translate english white_night_c1fdc781_4:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:192
translate english white_night_92a3c489:

    # me "Ты точно не устала?"
    me "你确定不累吗？"

# game/a15/10white_night.rpy:193
translate english white_night_769b564a:

    # lia "Не волнуйся обо мне."
    lia "别担心我。"

# game/a15/10white_night.rpy:194
translate english white_night_77c1e45f:

    # me "Не могу. Ты моя сестра и я тебя люблю."
    me "我做不到。你是我妹妹，我爱你。"

# game/a15/10white_night.rpy:195
translate english white_night_dd50945b:

    # lia "Спасибо. Я тоже тебя люблю."
    lia "谢谢。我也爱你。"

# game/a15/10white_night.rpy:196
translate english white_night_1aed96b7:

    # me "Так что?"
    me "那么？"

# game/a15/10white_night.rpy:197
translate english white_night_bf613fc9:

    # lia "М?"
    lia "嗯？"

# game/a15/10white_night.rpy:198
translate english white_night_a2e4644a:

    # me "Думаю пора заканчивать."
    me "我觉得该结束了。"

# game/a15/10white_night.rpy:199
translate english white_night_9dfc3d7d:

    # lia "Еще один танец. Последний."
    lia "再跳一支。最后一支。"

# game/a15/10white_night.rpy:200
translate english white_night_d5b2a7fe:

    # me "[ophie]."
    me "[ophie]。"

# game/a15/10white_night.rpy:201
translate english white_night_0767f39d:

    # lia "Сегодня белая ночь."
    lia "今晚是白夜。"

# game/a15/10white_night.rpy:202
translate english white_night_3709c914:

    # me "Белая?"
    me "白夜？"

# game/a15/10white_night.rpy:203
translate english white_night_ad07a795:

    # lia "Да. Так называется ночь свадьбы, выпавшая на полнолуние."
    lia "对。落在满月上的婚礼之夜就叫这个。"

# game/a15/10white_night.rpy:204
translate english white_night_c84bad46:

    # me "Я не знал."
    me "我不知道。"

# game/a15/10white_night.rpy:205
translate english white_night_c1fdc781_5:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:206
translate english white_night_6e4920cd:

    # me "...это что-то значит?"
    me "……这有什么含义吗？"

# game/a15/10white_night.rpy:207
translate english white_night_97165cd1:

    # lia "Конечно. Это не случайно. Ничего не случайно..."
    lia "当然。这不是偶然。什么都不是偶然……"

# game/a15/10white_night.rpy:208
translate english white_night_581a885e:

    # me "[ophie]?"
    me "[ophie]？"

# game/a15/10white_night.rpy:209
translate english white_night_c2825cba:

    # lia "Ты любишь ее?"
    lia "你爱她吗？"

# game/a15/10white_night.rpy:210
translate english white_night_2a985733:

    # me "Кого?"
    me "谁？"

# game/a15/10white_night.rpy:211
translate english white_night_f7087214:

    # lia "[elin]."
    lia "[elin]。"

# game/a15/10white_night.rpy:214
translate english white_night_e95f0df7:

    # lia "Не устала. К тому же ты еще должен мне... ночь."
    lia "不累。而且你还欠我……一夜。"

# game/a15/10white_night.rpy:215
translate english white_night_ffbed5a6:

    # me "Кхм-кхм."
    me "咳咳。"

# game/a15/10white_night.rpy:216
translate english white_night_18dc3480:

    # lia "{size=-6} К тому же ты еще должен мне ночь{/size}"
    lia "{size=-6} 而且你还欠我一夜{/size}"

# game/a15/10white_night.rpy:217
translate english white_night_fb143829:

    # me "{size=-6}Лучше вообще не говорить об этом. Даже тихо.{/size}"
    me "{size=-6}最好根本别提这事。哪怕小声也别提。{/size}"

# game/a15/10white_night.rpy:218
translate english white_night_1c0f5496:

    # lia "Ну ладно-ладно."
    lia "好吧好吧。"

# game/a15/10white_night.rpy:219
translate english white_night_9ec6ca6e:

    # me "...ваши покои будут охранять."
    me "……你们的房间会有人守卫。"

# game/a15/10white_night.rpy:220
translate english white_night_d774e740:

    # lia "Никто не стоит перед дверями молодоженов."
    lia "没人会站在新婚夫妇门前。"

# game/a15/10white_night.rpy:221
translate english white_night_070ad37e:

    # me "А в коридоре?"
    me "那走廊里呢？"

# game/a15/10white_night.rpy:222
translate english white_night_2739190c:

    # lia "Кайден их отвлечет. Просто приходи и жди."
    lia "凯登会把他们的注意力引开。你只管来等着。"

# game/a15/10white_night.rpy:223
translate english white_night_71d3b8c8:

    # me "Хорошо."
    me "好。"

# game/a15/10white_night.rpy:224
translate english white_night_c1fdc781_6:

    # lia "..."
    lia "……"

# game/a15/10white_night.rpy:225
translate english white_night_3820771a_4:

    # me "..."
    me "……"

# game/a15/10white_night.rpy:226
translate english white_night_7b03790a:

    # lia "Ты такой теплый, [mename]..."
    lia "你好温暖，[mename]……"

# game/a15/10white_night.rpy:227
translate english white_night_a38bf7c0:

    # me "Знаешь, мы уже достаточно натанцевались."
    me "你知道，我们跳得够多了。"

# game/a15/10white_night.rpy:228
translate english white_night_3c9a5bbd:

    # lia "Постой."
    lia "等等。"

# game/a15/10white_night.rpy:229
