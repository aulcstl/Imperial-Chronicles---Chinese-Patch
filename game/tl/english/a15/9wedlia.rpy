# TODO: Translation updated at 2026-09-02 02:24

# game/a15/9wedlia.rpy:4
translate english wedlia_adff26a9:

    # "Вечером следующего дня."
    "第二天傍晚。"

# game/a15/9wedlia.rpy:5
translate english wedlia_ccddc41b:

    # gosti "Яства мне нравятся."
    gosti "我喜欢这些菜肴。"

# game/a15/9wedlia.rpy:6
translate english wedlia_8c2b2634:

    # gosti2 "Еще бы. Лартуа славятся своими мясниками."
    gosti2 "当然。拉尔图阿家族以他们的屠夫闻名。"

# game/a15/9wedlia.rpy:7
translate english wedlia_2697e427:

    # gosti3 "По-вашему мясо везли сюда из Хальсбера? Оно бы стухло по пути."
    gosti3 "您觉得肉是从哈尔斯贝运来的？路上早就坏了。"

# game/a15/9wedlia.rpy:8
translate english wedlia_03d33bad:

    # gosti "Говорят, девчонка всё ещё больна и не годна для свадьбы."
    gosti "据说那姑娘还病着，不适合结婚。"

# game/a15/9wedlia.rpy:9
translate english wedlia_98f4a4a1:

    # gosti2 "Тс... не так громко."
    gosti2 "嘘……别那么大声。"

# game/a15/9wedlia.rpy:10
translate english wedlia_097d0311:

    # gosti3 "А что такого? Это же правда."
    gosti3 "怎么了？这是事实。"

# game/a15/9wedlia.rpy:11
translate english wedlia_fa250c8a:

    # gosti "Напомнить, как золотая гвардия хлестала на площади тех, кто распространял слухи о немощи короля?"
    gosti "要提醒你黄金卫队是怎么在广场上抽打那些散布国王虚弱谣言的人吗？"

# game/a15/9wedlia.rpy:12
translate english wedlia_716e22ba:

    # gosti2 "Не нравятся они мне. Поменяли плащи на золотые, а методы как при Лотрике."
    gosti2 "我不喜欢他们。斗篷换成了金色，手段却和洛特里克时代一样。"

# game/a15/9wedlia.rpy:13
translate english wedlia_df17819e:

    # gosti3 "При Лотрике вас бы уже казнили за такие разговорчики."
    gosti3 "在洛特里克时代，你这种话早就被处决了。"

# game/a15/9wedlia.rpy:14
translate english wedlia_e3131d5a:

    # gosti "Говорят принцесса будет раздавать милостыню."
    gosti "据说公主会施舍。"

# game/a15/9wedlia.rpy:15
translate english wedlia_ba4dc4c6:

    # gosti2 "Какая чушь. Простолюдинов нужно держать подальше, а с этим золотом из реки и раздачей еды они и вовсе с ума сойдут."
    gosti2 "真是胡扯。平民就该被挡远点，再加上河里出的黄金和发放食物，他们非彻底疯了不可。"

# game/a15/9wedlia.rpy:16
translate english wedlia_47c473b7:

    # gosti3 "Ваш род-то сам был простолюдинским."
    gosti3 "你们家族自己本来不就是平民出身吗。"

# game/a15/9wedlia.rpy:17
translate english wedlia_65117109:

    # gosti "Ну-ну. Попрошу! Мой отец получил торговую марку тридцать лет назад!"
    gosti "哎哎。请您注意！我父亲三十年前就拿到贸易特许状了！"

# game/a15/9wedlia.rpy:20
translate english wedlia_cdbe7115:

    # ala "Рада, что вы целы, мой принц."
    ala "很高兴您平安无事，我的王子。"

# game/a15/9wedlia.rpy:21
translate english wedlia_6ebf39b2:

    # me "Я тоже этому рад."
    me "我也很高兴。"

# game/a15/9wedlia.rpy:22
translate english wedlia_1074e326:

    # ala "Я слышала, вы повстречали горцев."
    ala "我听说您遇到了高地人。"

# game/a15/9wedlia.rpy:23
translate english wedlia_1b0c09c1:

    # me "Повстречал."
    me "遇到了。"

# game/a15/9wedlia.rpy:24
translate english wedlia_002a71c3:

    # ala "И как?"
    ala "然后呢？"

# game/a15/9wedlia.rpy:25
translate english wedlia_3e73b880:

    # me "Все хорошо. Как видите, все конечности у меня на месте."
    me "一切都好。如您所见，我四肢俱全。"

# game/a15/9wedlia.rpy:26
translate english wedlia_89a79304:

    # ala "..."
    ala "……"

# game/a15/9wedlia.rpy:27
translate english wedlia_d6a68100:

    # me "Прекрасные кубки, это серебро?"
    me "好漂亮的杯子，是银的吗？"

# game/a15/9wedlia.rpy:28
translate english wedlia_365dec03:

    # ala "А как прошел ваш дипломатический вояж?"
    ala "您的外交之行怎么样？"

# game/a15/9wedlia.rpy:29
translate english wedlia_e7ce88cd:

    # me "Нормально."
    me "还行。"

# game/a15/9wedlia.rpy:30
translate english wedlia_89a79304_1:

    # ala "..."
    ala "……"

# game/a15/9wedlia.rpy:31
translate english wedlia_9196566f:

    # me "Леди Алейна, я не хочу говорить о делах на празднике."
    me "阿莱娜女士，我不想在庆典上谈公事。"

# game/a15/9wedlia.rpy:32
translate english wedlia_2bca960a:

    # ala "Как пожелаете, мой принц. Я не буду вам докучать."
    ala "随您意，我的王子。我不会再打扰您。"

# game/a15/9wedlia.rpy:33
translate english wedlia_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a15/9wedlia.rpy:36
translate english wedlia_73284574:

    # ala "Как все прошло?"
    ala "一切怎么样？"

# game/a15/9wedlia.rpy:37
translate english wedlia_e7ce88cd_1:

    # me "Нормально."
    me "还行。"

# game/a15/9wedlia.rpy:38
translate english wedlia_61127718:

    # ala "Нормально? Ты ведь связался с..."
    ala "还行？你不是和……联系上了吗……"

# game/a15/9wedlia.rpy:39
translate english wedlia_59e067cf:

    # me "Связался. Эльфы хорошо встретили меня в замке лорда Корвина."
    me "联系上了。精灵们在科文领主的城堡里好好接待了我。"

# game/a15/9wedlia.rpy:40
translate english wedlia_694d7746:

    # ala "Кто говорил с тобой?"
    ala "谁和你谈的？"

# game/a15/9wedlia.rpy:41
translate english wedlia_da8d7b64:

    # me "Селестина."
    me "塞莱丝蒂娜。"

# game/a15/9wedlia.rpy:42
translate english wedlia_0231dbe6:

    # ala "Само собой. Я имею в виду в замке лорда Корвина."
    ala "当然。我是指在科文领主的城堡里。"

# game/a15/9wedlia.rpy:43
translate english wedlia_a1510906:

    # me "Там полно эльфов."
    me "那里到处都是精灵。"

# game/a15/9wedlia.rpy:44
translate english wedlia_9759e7a0:

    # ala "Уверена, что говорил с тобой какой-то конкретный."
    ala "我确信是某个特定的人和你谈的。"

# game/a15/9wedlia.rpy:45
translate english wedlia_ef8ef9e9:

    # me "С трудом могу поверить, что эта информация вам недоступна, леди Алейна."
    me "我很难相信这信息对您不可得，阿莱娜女士。"

# game/a15/9wedlia.rpy:46
translate english wedlia_6f012d99:

    # ala "Я не всемогуща."
    ala "我并非无所不能。"

# game/a15/9wedlia.rpy:47
translate english wedlia_d36d3fbd:

    # me "...кажется ее звали Миранда."
    me "……好像她叫米兰达。"

# game/a15/9wedlia.rpy:48
translate english wedlia_4049d396:

    # ala "Понятно..."
    ala "明白了……"

# game/a15/9wedlia.rpy:49
translate english wedlia_b544a629:

    # me "Это что-то меняет?"
    me "这有什么影响吗？"

# game/a15/9wedlia.rpy:50
translate english wedlia_f66e0e3c:

    # ala "Нет... нет. Просто континент огромен. Новости доходят с опозданием. Мне нужно было убедиться, что ничего не поменялось. Или наоборот поменялось."
    ala "不……不。只是大陆太辽阔。消息总会迟到。我得确认一切没变。或者，恰恰相反，变了。"

# game/a15/9wedlia.rpy:51
translate english wedlia_09868c6a:

    # me "И как? Ей можно доверять?"
    me "那怎样？能信任她吗？"

# game/a15/9wedlia.rpy:52
translate english wedlia_b3c47d58:

    # ala "Если ей доверяет Селестина, думаю, что всё в порядке."
    ala "如果塞莱丝蒂娜信任她，我想就没问题。"

# game/a15/9wedlia.rpy:53
translate english wedlia_31ab26e0:

    # me "Она у вас главная?"
    me "她是你们的首领吗？"

# game/a15/9wedlia.rpy:54
translate english wedlia_6a9b9ec5:

    # ala "У нас нет главных. У нас у всех одна цель и мы к ней стремимся."
    ala "我们没有首领。我们所有人都只有一个目标，并朝它努力。"

# game/a15/9wedlia.rpy:55
translate english wedlia_a65f0bbe:

    # me "И что это за цель?"
    me "那是什么目标？"

# game/a15/9wedlia.rpy:56
translate english wedlia_8ac7193b:

    # ala "Свобода, [mename]."
    ala "自由，[mename]。"

# game/a15/9wedlia.rpy:58
translate english wedlia_e3ca2261:

    # ala "Я слышала, что ты столкнулся с горцами."
    ala "我听说你遇到了高地人。"

# game/a15/9wedlia.rpy:60
translate english wedlia_3544e0fb:

    # me "Для них это закончилось плохо."
    me "对他们来说结局很糟。"

# game/a15/9wedlia.rpy:61
translate english wedlia_82ade63b:

    # ala "Правда?"
    ala "是吗？"

# game/a15/9wedlia.rpy:62
translate english wedlia_c3f453dc:

    # me "Да. Я убил всех, до кого смог дотянуться."
    me "对。我杀光了所有我能碰到的人。"

# game/a15/9wedlia.rpy:63
translate english wedlia_52264da2:

    # ala "Хорошо... это ведь не помешало тебе... на пути к собственным достижениям?"
    ala "好……这没有妨碍你……走向自己的成就吧？"

# game/a15/9wedlia.rpy:64
translate english wedlia_7419bc22:

    # me "Может даже и помогло."
    me "甚至可能帮了忙。"

# game/a15/9wedlia.rpy:65
translate english wedlia_7a82795e:

    # ala "Хорошо. Уничтожать наших врагов это полезно, но нельзя забывать - что твоя власть — это самое сильное оружие, что у нас есть. И мы не можем этим рисковать."
    ala "好。消灭我们的敌人是有益的，但不能忘记——你的权力是我们拥有的最强武器。我们不能拿它冒险。"

# game/a15/9wedlia.rpy:66
translate english wedlia_9adcd514:

    # me "Я не рисковал. Делал, что должно."
    me "我没有冒险。我做了该做的事。"

# game/a15/9wedlia.rpy:67
translate english wedlia_a6c614be:

    # ala "Отлично. Не все враги должны быть уничтожены, но те, в чьем миропредставлении нет для нас места даже в качестве рабов..."
    ala "很好。并非所有敌人都必须被消灭，但那些在他们的世界观里连我们当奴隶的位置都没有的……"

# game/a15/9wedlia.rpy:68
translate english wedlia_754b5b48:

    # ala "Такие враги должны быть уничтожены."
    ala "这样的敌人没有存在的权利。"

# game/a15/9wedlia.rpy:69
translate english wedlia_5e286c0e:

    # me "Не надо меня убеждать еще раз. Я уже их убил."
    me "不用再说服我了。我已经把他们杀了。"

# game/a15/9wedlia.rpy:70
translate english wedlia_89a79304_2:

    # ala "..."
    ala "……"

# game/a15/9wedlia.rpy:71
translate english wedlia_69710296:

    # me "И вообще, я хотел бы приберечь все эти разговоры на потом. Я на празднике."
    me "总之，我想把这些谈话留到以后。我在庆典上。"

# game/a15/9wedlia.rpy:72
translate english wedlia_ab1be663:

    # ala "Конечно, Elan'or, наслаждайся вечером. Я не буду тебя больше беспокоить."
    ala "当然，Elan'or。享受这个夜晚吧。我不会再打扰你。"

# game/a15/9wedlia.rpy:73
translate english wedlia_3066598f_1:

    # me "Спасибо."
    me "谢谢。"

# game/a15/9wedlia.rpy:75
translate english wedlia_4b177aaf:

    # me "Селестина хотела, чтобы я их убил."
    me "塞莱丝蒂娜想让我杀了他们。"

# game/a15/9wedlia.rpy:76
translate english wedlia_c3b5f029:

    # ala "Но ты этого не сделал?"
    ala "但你没做？"

# game/a15/9wedlia.rpy:77
translate english wedlia_66d81ced:

    # me "Не посчитал нужным."
    me "我觉得没必要。"

# game/a15/9wedlia.rpy:78
translate english wedlia_89a79304_3:

    # ala "..."
    ala "……"

# game/a15/9wedlia.rpy:79
translate english wedlia_63d0cf2d:

    # me "Я знаю, что они враги эльфов."
    me "我知道他们是精灵的敌人。"

# game/a15/9wedlia.rpy:80
translate english wedlia_e3f2ef91:

    # ala "Враги - это мягко сказано. Горцам даже не нужно выдумывать суды и преступления, чтобы вешать нас на деревьях."
    ala "说敌人还是轻的。高地人甚至不需要编造法庭和罪名，就能把我们吊在树上。"

# game/a15/9wedlia.rpy:81
translate english wedlia_9c32df45:

    # me "Знаю. Но в тот момент их убийство противоречило моим собственным интересам."
    me "我知道。但那时杀了他们违背我自己的利益。"

# game/a15/9wedlia.rpy:82
translate english wedlia_69242c7b:

    # ala "...понимаю."
    ala "……我明白。"

# game/a15/9wedlia.rpy:83
translate english wedlia_489a247d:

    # me "Правда?"
    me "真的？"

# game/a15/9wedlia.rpy:84
translate english wedlia_48fe7c6d:

    # ala "Твоя власть это самое сильное оружие, что у нас есть. И мы не можем этим рисковать. Если ты решил, что убийство горцев тебе навредит - мы должны это принять."
    ala "你的权力是我们拥有的最强武器。我们不能拿它冒险。如果你认定杀高地人会害了你——我们就必须接受。"

# game/a15/9wedlia.rpy:85
translate english wedlia_501aab54:

    # me "Я думал мое решение вызовет ваше сомнение во мне, леди Алейна."
    me "我以为我的决定会让您怀疑我，阿莱娜女士。"

# game/a15/9wedlia.rpy:86
translate english wedlia_a48aa26e:

    # ala "Ты доказал свою лояльность гораздо более существенными делами."
    ala "你已经用远比这重要的事证明了你的忠诚。"

# game/a15/9wedlia.rpy:87
translate english wedlia_eb0d474a:

    # me "Верно."
    me "没错。"

# game/a15/9wedlia.rpy:88
translate english wedlia_edd17a40:

    # ala "Чем ты сильнее - тем сильнее все мы. Все, кто тебе верят. Горцы не стоят того, чтобы рисковать всей твоей властью и жизнью."
    ala "你越强——我们所有人就越强。所有信任你的人。高地人不值得拿你全部的权力和性命去冒险。"

# game/a15/9wedlia.rpy:89
translate english wedlia_fc30fd2b:

    # me "Да."
    me "对。"

# game/a15/9wedlia.rpy:90
translate english wedlia_049b957f:

    # ala "Наслаждайся вечером, Elan'or, я узнала всё, что хотела и не буду тебя больше беспокоить."
    ala "享受这个夜晚吧，Elan'or。我想知道的都知道了，不会再打扰你。"

# game/a15/9wedlia.rpy:93
translate english wedlia_3166c47e:

    # me "{i}Какие красивые кубки.{/i}"
    me "{i}多漂亮的杯子。{/i}"

# game/a15/9wedlia.rpy:94
translate english wedlia_11491310:

    # me "{i}Лорд Лартуа прислал? Серебро. Непотемневшее, значит молодое. Приятно лежит в руках.{/i}"
    me "{i}拉尔图阿领主送来的？银的。没发黑，说明还新。握在手里很舒服。{/i}"

# game/a15/9wedlia.rpy:95
translate english wedlia_e4b0fdc7:

    # me "{i}И аранское золотое в кубках.{/i}"
    me "{i}杯里装的是阿兰金酒。{/i}"

# game/a15/9wedlia.rpy:96
translate english wedlia_95a00d16:

    # me "{i}Главное преимущество от нахождения лорда Леонарда при дворе.{/i}"
    me "{i}莱昂纳德领主在宫廷里的主要好处。{/i}"

# game/a15/9wedlia.rpy:97
translate english wedlia_c91050c0:

    # me "{i}Ладно. Думаю пир уже скоро начнется. Можно пить сколько влезет.{/i}"
    me "{i}好吧。我想宴席很快就开始了。可以想喝多少喝多少。{/i}"

# game/a15/9wedlia.rpy:98
translate english wedlia_724f9d17:

    # me "{i}Соблюдая приличия, конечно.{/i}"
    me "{i}当然，要守礼。{/i}"

# game/a15/9wedlia.rpy:99
translate english wedlia_5c76dbe7:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a15/9wedlia.rpy:100
translate english wedlia_527d624c:

    # me "{i}Стараясь их соблюдать.{/i}"
    me "{i}尽量遵守。{/i}"

# game/a15/9wedlia.rpy:102
translate english wedlia_b1df5874:

    # lartua_y "Принц, [mename]?"
    lartua_y "[mename]王子？"

# game/a15/9wedlia.rpy:103
translate english wedlia_6e31506f:

    # me "Кайден?"
    me "凯登？"

# game/a15/9wedlia.rpy:104
translate english wedlia_13829293:

    # lartua_y "Вы не видели вашу сестру?"
    lartua_y "您见到您妹妹了吗？"

# game/a15/9wedlia.rpy:105
translate english wedlia_740dd7ad:

    # me "Какую из?"
    me "哪个妹妹？"

# game/a15/9wedlia.rpy:106
translate english wedlia_f0368dc2:

    # lartua_y "Ту, на которой я сегодня женюсь."
    lartua_y "今天我要娶的那个。"

# game/a15/9wedlia.rpy:107
translate english wedlia_edae34a8:

    # me "А ты не знаешь, где она?"
    me "你不知道她在哪儿？"

# game/a15/9wedlia.rpy:108
translate english wedlia_36bd34f5:

    # lartua_y "Должна быть уже тут."
    lartua_y "她本该已经在这里了。"

# game/a15/9wedlia.rpy:109
translate english wedlia_e3f26942:

    # me "Наверное примеряет платье."
    me "大概在试裙子。"

# game/a15/9wedlia.rpy:110
translate english wedlia_fae2d613:

    # lartua_y "Не могли бы вы... поторопить ее? Все гости уже собрались. Это неприлично."
    lartua_y "您能不能……催催她？宾客都到齐了。这不合适。"

# game/a15/9wedlia.rpy:111
translate english wedlia_2fc95273:

    # me "Конечно. Только сначала сам найду ее."
    me "当然。不过我得先找到她。"

# game/a15/9wedlia.rpy:112
translate english wedlia_0e7ff61e:

    # lartua_y "Спасибо."
    lartua_y "谢谢。"

# game/a15/9wedlia.rpy:115
translate english wedlia_f2f58740:

    # me "Прежде чем я уйду, я хотел поговорить о договоренности."
    me "在我走之前，我想谈谈约定。"

# game/a15/9wedlia.rpy:116
translate english wedlia_326e2165:

    # lartua_y "Вы имеете в виду..."
    lartua_y "您是指……"

# game/a15/9wedlia.rpy:117
translate english wedlia_fc30fd2b_1:

    # me "Да."
    me "对。"

# game/a15/9wedlia.rpy:118
translate english wedlia_d0cd661a:

    # lartua_y "Все в силе."
    lartua_y "仍然有效。"

# game/a15/9wedlia.rpy:119
translate english wedlia_642b36ce:

    # me "Хорошо. Что по времени?"
    me "好。时间呢？"

# game/a15/9wedlia.rpy:120
translate english wedlia_095c7009:

    # lartua_y "Ну... когда пир и процессия в городе окончатся."
    lartua_y "嗯……等宴席和城里游行结束后。"

# game/a15/9wedlia.rpy:121
translate english wedlia_ff048a2c:

    # me "А остальное?"
    me "那其余的呢？"

# game/a15/9wedlia.rpy:122
translate english wedlia_192a9017:

    # lartua_y "М?"
    lartua_y "嗯？"

# game/a15/9wedlia.rpy:123
translate english wedlia_d82f674e:

    # me "Мне нужно будет попасть к вам в комнату."
    me "我得进你们的房间。"

# game/a15/9wedlia.rpy:124
translate english wedlia_1f06a4c7:

    # lartua_y "Приходите ровно через полчаса. Я отошлю стражу."
    lartua_y "正好半小时后来。我会把守卫支开。"

# game/a15/9wedlia.rpy:125
translate english wedlia_71d3b8c8:

    # me "Хорошо."
    me "好。"

# game/a15/9wedlia.rpy:126
translate english wedlia_ec927c15:

    # lartua_y "...что-то еще?"
    lartua_y "……还有别的事吗？"

# game/a15/9wedlia.rpy:127
translate english wedlia_642551a5:

    # me "Нет. Пойду найду мою сестру."
    me "没有。我去找我妹妹。"

# game/a15/9wedlia.rpy:129
translate english wedlia_5b63b669:

    # me "Вот ты где. Пир уже начался."
    me "你在这儿。宴席已经开始了。"

# game/a15/9wedlia.rpy:130
translate english wedlia_3ac15118:

    # lia "Я знаю. Пришлось менять платье на золотое в последний момент."
    lia "我知道。最后关头不得不把裙子换成金色的。"

# game/a15/9wedlia.rpy:131
translate english wedlia_7332342b:

    # me "Зачем?"
    me "为什么？"

# game/a15/9wedlia.rpy:132
translate english wedlia_d30df91f:

    # lia "Ну мы же теперь снова Золотая Империя. Значит и платье должно быть золотым."
    lia "我们现在又是黄金帝国了。所以裙子也得是金色的。"

# game/a15/9wedlia.rpy:133
translate english wedlia_6e94d904:

    # me "...логично. Ну и долго еще?"
    me "……有道理。还要多久？"

# game/a15/9wedlia.rpy:134
translate english wedlia_6b1c1d25:

    # lia "Почти закончили?"
    lia "快好了吗？"

# game/a15/9wedlia.rpy:135
translate english wedlia_8d1fef75:

    # slug "Одну минутку. Не двигайтесь, моя принцесса."
    slug "一分钟。别动，我的公主。"

# game/a15/9wedlia.rpy:136
translate english wedlia_7f49a948:

    # lia "Гости сильно скучают?"
    lia "宾客们很无聊吗？"

# game/a15/9wedlia.rpy:137
translate english wedlia_23a02a84:

    # me "Нет. Музыка, вино и пища их отвлекают."
    me "没有。音乐、酒和食物让他们分着神呢。"

# game/a15/9wedlia.rpy:138
translate english wedlia_45bebab5:

    # slug "Не дергайте ухом, моя принцесса."
    slug "别动耳朵，我的公主。"

# game/a15/9wedlia.rpy:139
translate english wedlia_3d128e82:

    # lia "Так у меня еще есть время вплести ленты в волосы?"
    lia "那我还有时间把缎带编进头发里吗？"

# game/a15/9wedlia.rpy:140
translate english wedlia_024f4504:

    # me "А венка тебе мало?"
    me "花环还不够吗？"

# game/a15/9wedlia.rpy:141
translate english wedlia_b011dbda:

    # slug "Принести ленты?"
    slug "要拿缎带来吗？"

# game/a15/9wedlia.rpy:142
translate english wedlia_25141948:

    # lia "Ну..."
    lia "嗯……"

# game/a15/9wedlia.rpy:143
translate english wedlia_246bd9f8:

    # me "[lia]..."
    me "[lia]……"

# game/a15/9wedlia.rpy:144
translate english wedlia_fe294624:

    # lia "Ладно, не нужно."
    lia "好吧，不用了。"

# game/a15/9wedlia.rpy:145
translate english wedlia_6fceae53:

    # me "Молодец."
    me "乖。"

# game/a15/9wedlia.rpy:146
translate english wedlia_a9cb21da:

    # slug "Закончили."
    slug "好了。"

# game/a15/9wedlia.rpy:148
translate english wedlia_37ff41cd:

    # lia "Ну? Как тебе?"
    lia "怎么样？你觉得如何？"

# game/a15/9wedlia.rpy:149
translate english wedlia_b57abe01:

    # me "Прекрасно."
    me "很美。"

# game/a15/9wedlia.rpy:150
translate english wedlia_d5f9b1c9:

    # lia "Правда? Тебе нравится?"
    lia "真的？你喜欢吗？"

# game/a15/9wedlia.rpy:151
translate english wedlia_ddcf1769:

    # me "Нравится. Хорошо выглядишь."
    me "喜欢。你看起来很好。"

# game/a15/9wedlia.rpy:152
translate english wedlia_85844ab0:

    # lia "Я похожа на принцессу Белатрису?"
    lia "我像贝拉特丽萨公主吗？"

# game/a15/9wedlia.rpy:153
translate english wedlia_8859cdcf:

    # me "Понятия не имею, она умерла сколько... двести лет назад?"
    me "我完全不知道。她死了多久了……两百年？"

# game/a15/9wedlia.rpy:154
translate english wedlia_a29f09f5:

    # lia "Чуть меньше. Сто пятьдесят."
    lia "稍微少点。一百五十年。"

# game/a15/9wedlia.rpy:155
translate english wedlia_3820771a:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:156
translate english wedlia_1777c4dc:

    # lia "У нее платье было очень похожее! Тоже в золото."
    lia "她的裙子非常像！也是金色的。"

# game/a15/9wedlia.rpy:157
translate english wedlia_5647c519:

    # me "В то время у всех невест были золотые платья."
    me "那时候所有新娘都穿金色裙子。"

# game/a15/9wedlia.rpy:158
translate english wedlia_66264865:

    # lia "Вовсе не у всех, принцесса Лейна..."
    lia "根本不是所有人，莱娜公主就……"

# game/a15/9wedlia.rpy:159
translate english wedlia_ca542968:

    # me "Ладно-ладно. Давай без экскурсов в историю придворной моды. Платье красивое и золотое. Этого достаточно."
    me "行了行了。别给我上宫廷时尚史课了。裙子漂亮，又是金色的。这就够了。"

# game/a15/9wedlia.rpy:160
translate english wedlia_48a41e78:

    # lia "Только платье красивое?"
    lia "只有裙子漂亮？"

# game/a15/9wedlia.rpy:161
translate english wedlia_8e0ca0e1:

    # me "И невеста в нем тоже."
    me "穿它的新娘也漂亮。"

# game/a15/9wedlia.rpy:162
translate english wedlia_5bebe283:

    # lia "Спасибо!"
    lia "谢谢！"

# game/a15/9wedlia.rpy:163
translate english wedlia_e4b9bce5:

    # me "Пойдем уже."
    me "走吧。"

# game/a15/9wedlia.rpy:164
translate english wedlia_e35309f9:

    # lia "Проведи меня."
    lia "带我过去。"

# game/a15/9wedlia.rpy:166
translate english wedlia_b152a6ed:

    # me "Забавно. Помню как мы с [elin] пробирались в эту комнату, чтобы пронести тебе взрослых книг и сладостей."
    me "真有意思。我记得我和[elin]偷偷溜进这个房间，给你带成人书和糖果。"

# game/a15/9wedlia.rpy:167
translate english wedlia_724c7b0f:

    # lia "О. Я это помню. Мама потом вас страшно наказывала и мне было стыдно."
    lia "哦。我记得。妈妈后来狠狠惩罚了你们，我很惭愧。"

# game/a15/9wedlia.rpy:168
translate english wedlia_d50036d7:

    # me "Да... а вот уже я в этой комнате смотрю, как тебя одевают для свадьбы."
    me "是啊……而现在我在这房间里看着你为婚礼更衣。"

# game/a15/9wedlia.rpy:169
translate english wedlia_592618db:

    # lia "Ну ведь это хорошо? Я вообще могла не дожить до этого момента. Но дожила."
    lia "这不是好事吗？我本来可能活不到这一刻。但我活下来了。"

# game/a15/9wedlia.rpy:170
translate english wedlia_33e8cf87:

    # me "Конечно. И все же..."
    me "当然。不过……"

# game/a15/9wedlia.rpy:171
translate english wedlia_6bc67803:

    # lia "Что тебя тревожит? Бег времени?"
    lia "什么让你不安？时间的流逝？"

# game/a15/9wedlia.rpy:172
translate english wedlia_ab58e581:

    # me "Наверное. Его скорость."
    me "大概是。它的速度。"

# game/a15/9wedlia.rpy:173
translate english wedlia_8d3333f9:

    # lia "Лучше вообще об этом не думать."
    lia "最好根本别想这个。"

# game/a15/9wedlia.rpy:174
translate english wedlia_27c8240c:

    # me "О, я хотел бы об этом не думать. Но эта мысль всегда рядом."
    me "哦，我倒希望不去想。但这个念头总在。"

# game/a15/9wedlia.rpy:175
translate english wedlia_7d3f7df7:

    # lia "А у меня получается. Я просто наслаждаюсь тем моментом, что у меня есть сейчас."
    lia "我却做得到。我只是享受现在拥有的这一刻。"

# game/a15/9wedlia.rpy:176
translate english wedlia_b3df6216:

    # me "И что же? Ты никогда не думаешь о смерти?"
    me "是吗？你从不想死亡？"

# game/a15/9wedlia.rpy:177
translate english wedlia_5c55e501:

    # lia "Думаю. Но ведь она неизбежна."
    lia "会想。但它毕竟不可避免。"

# game/a15/9wedlia.rpy:178
translate english wedlia_08199ad2:

    # me "Но срок ее у каждого свой."
    me "但每个人的期限不同。"

# game/a15/9wedlia.rpy:179
translate english wedlia_4e568ed1:

    # lia "А мне кажется у всех одинаковый."
    lia "我觉得大家都一样。"

# game/a15/9wedlia.rpy:180
translate english wedlia_59fac1fb:

    # me "Ты же знаешь, что это не так."
    me "你知道不是这样。"

# game/a15/9wedlia.rpy:181
translate english wedlia_f8158140:

    # lia "Не знаю на самом деле. И ты не знаешь. Может жизнь бабочки-однодневки ощущается так же, как и жизнь столетнего старца?"
    lia "其实我不知道。你也不知道。也许蜉蝣的一生，和一个百岁老人的一生感受相同？"

# game/a15/9wedlia.rpy:182
translate english wedlia_685b9c2d:

    # me "...может быть."
    me "……也许吧。"

# game/a15/9wedlia.rpy:183
translate english wedlia_f247701e:

    # lia "Давай не будем обсуждать смерть на моей свадьбе."
    lia "别在我的婚礼上谈死亡了。"

# game/a15/9wedlia.rpy:184
translate english wedlia_c7bde06f:

    # me "Конечно. Прости."
    me "当然。抱歉。"

# game/a15/9wedlia.rpy:186
translate english wedlia_1f8673fc:

    # me "[lia]?"
    me "[lia]？"

# game/a15/9wedlia.rpy:187
translate english wedlia_bf613fc9:

    # lia "М?"
    lia "嗯？"

# game/a15/9wedlia.rpy:188
translate english wedlia_71c02e9a:

    # me "Могу я тебя о кое-чем попросить?"
    me "我能求你件事吗？"

# game/a15/9wedlia.rpy:189
translate english wedlia_8b19de1d:

    # lia "Конечно!"
    lia "当然！"

# game/a15/9wedlia.rpy:190
translate english wedlia_75cc5909:

    # me "Я немного переживаю за твою сохранность. Могла бы ты попросить у отца взять с собой на раздачу милостыни больше золотых гвардейцев?"
    me "我有点担心你的安全。你能不能跟父亲说，施舍时多带些黄金卫兵？"

# game/a15/9wedlia.rpy:191
translate english wedlia_72c3ec14:

    # lia "Со мной и так будут почти все."
    lia "本来几乎所有人都会跟着我。"

# game/a15/9wedlia.rpy:192
translate english wedlia_7c0cbe5b:

    # me "Верно. Но я все равно за тебя тревожусь. Мне было бы спокойнее, если бы с тобой было еще больше."
    me "没错。但我还是担心你。如果跟着你的人更多，我会更安心。"

# game/a15/9wedlia.rpy:193
translate english wedlia_930318b4:

    # lia "Ну ладно..."
    lia "好吧……"

# game/a15/9wedlia.rpy:194
translate english wedlia_3066598f_2:

    # me "Спасибо."
    me "谢谢。"

# game/a15/9wedlia.rpy:196
translate english wedlia_3610cbb8:

    # lia "Мне нужно поговорить с гостями и принять поздравления. Ты со мной?"
    lia "我得和宾客说话，接受祝贺。你和我一起吗？"

# game/a15/9wedlia.rpy:197
translate english wedlia_f9a63d8d:

    # me "Пожалуй оставлю тебя с этим наедине."
    me "我还是让你独自应付吧。"

# game/a15/9wedlia.rpy:198
translate english wedlia_9ac81d7e:

    # lia "Это будет весело."
    lia "会很有意思的。"

# game/a15/9wedlia.rpy:199
translate english wedlia_f9603b13:

    # me "Сомневаюсь."
    me "我怀疑。"

# game/a15/9wedlia.rpy:200
translate english wedlia_53931cc9:

    # lia "Думаешь, они будут меня о чём-то просить?"
    lia "你觉得他们会求我什么吗？"

# game/a15/9wedlia.rpy:201
translate english wedlia_b5b99b33:

    # me "Уверен в этом. Но если рядом с тобой буду я, они ещё будут о чем-то просить и меня."
    me "我确定会。但如果我站在你旁边，他们也会求我。"

# game/a15/9wedlia.rpy:202
translate english wedlia_5f0d5aa4:

    # lia "Ну как знаешь."
    lia "随你吧。"

# game/a15/9wedlia.rpy:204
translate english wedlia_24e6753f:

    # me "{i}Так... чем бы заняться?{/i}"
    me "{i}那么……做点什么好呢？{/i}"

# game/a15/9wedlia.rpy:205
translate english wedlia_9f5a0067:

    # me "{i}Говорить с гостями я не хочу.{/i}"
    me "{i}我不想和宾客说话。{/i}"

# game/a15/9wedlia.rpy:206
translate english wedlia_1bec1d43:

    # me "{i}Отца еще нет.{/i}"
    me "{i}父亲还没来。{/i}"

# game/a15/9wedlia.rpy:207
translate english wedlia_1976e75f:

    # me "{i}Выпить еще вина? Нет. Рановато. Если продолжу в том же темпе, то уже через час буду с трудом говорить.{/i}"
    me "{i}再喝点酒？不。太早了。如果保持这个速度，一小时后我就说不清话了。{/i}"

# game/a15/9wedlia.rpy:208
translate english wedlia_7ad2783d:

    # me "{i}Нужно чуть отойти от предыдущих кубков.{/i}"
    me "{i}得从刚才那几杯里缓一缓。{/i}"

# game/a15/9wedlia.rpy:209
translate english wedlia_98ee58de:

    # me "{i}Хм...{/i}"
    me "{i}嗯……{/i}"

# game/a15/9wedlia.rpy:210
translate english wedlia_55b69477:

    # me "{i}О. Лорды отца.{/i}"
    me "{i}哦。父亲的领主们。{/i}"

# game/a15/9wedlia.rpy:211
translate english wedlia_8d0ea86a:

    # me "{i}Хорошее время для разговора.{/i}"
    me "{i}谈话的好时机。{/i}"

# game/a15/9wedlia.rpy:214
translate english wedlia_d27a1207:

    # me "Лорд Леонард. Лорд Пойнас."
    me "莱昂纳德领主。珀纳斯领主。"

# game/a15/9wedlia.rpy:215
translate english wedlia_229c6f01:

    # pojnas "О! Принц, [mename]! Рад вас видеть."
    pojnas "哦！[mename]王子！很高兴见到您。"

# game/a15/9wedlia.rpy:216
translate english wedlia_6feaf76e:

    # leonard "Принц, [mename]."
    leonard "[mename]王子。"

# game/a15/9wedlia.rpy:217
translate english wedlia_97cc458f:

    # me "Наслаждаетесь вечером?"
    me "享受这个夜晚吗？"

# game/a15/9wedlia.rpy:218
translate english wedlia_de5246ae:

    # pojnas "Еще как! Вино - замечательное. Еда еще лучше!"
    pojnas "当然！酒非常好。食物更好！"

# game/a15/9wedlia.rpy:219
translate english wedlia_52b81707:

    # me "Я смотрю вы сменили наряды."
    me "我看你们换了装束。"

# game/a15/9wedlia.rpy:220
translate english wedlia_0e8f3244:

    # pojnas "Лорду в Золотой Империи следует одеваться в золото. По-моему логично."
    pojnas "黄金帝国的领主该穿金色。我觉得很合理。"

# game/a15/9wedlia.rpy:221
translate english wedlia_f295411a:

    # me "Как и гвардейцам."
    me "卫兵也是。"

# game/a15/9wedlia.rpy:222
translate english wedlia_4bd0184d:

    # pojnas "Все верно."
    pojnas "没错。"

# game/a15/9wedlia.rpy:223
translate english wedlia_7be6daea:

    # me "Я так понимаю все эти новые лица — это ваших рук дело."
    me "我猜这些新面孔都是您的手笔。"

# game/a15/9wedlia.rpy:224
translate english wedlia_cc8e7282:

    # pojnas "Разумеется! Я лично проспонсировал перевооружение и набор новых гвардейцев. Империя и Император должны быть в безопасности."
    pojnas "当然！我亲自资助了重新武装和招募新卫兵。帝国和皇帝必须安全。"

# game/a15/9wedlia.rpy:225
translate english wedlia_f7b2934e:

    # me "Безопасность."
    me "安全。"

# game/a15/9wedlia.rpy:226
translate english wedlia_d2ff59e3:

    # pojnas "Ага. И ваша тоже, принц."
    pojnas "对。还有您的，王子。"

# game/a15/9wedlia.rpy:227
translate english wedlia_9e7f2838:

    # me "Разумеется. Вы поэтому остались при дворе? Наладить безопасность?"
    me "当然。所以您留在宫廷？是为了整顿安全？"

# game/a15/9wedlia.rpy:228
translate english wedlia_f91124c1:

    # pojnas "Ну... я думал мне достанется работа в Долине. Но раз уж не вышло, я применяю мои навыки там, где я буду наиболее полезен Империи."
    pojnas "嗯……我以为我会得到山谷的工作。但既然没有，我就在对帝国最有用的地方施展我的才能。"

# game/a15/9wedlia.rpy:229
translate english wedlia_fbcf525b:

    # me "Здесь."
    me "这里。"

# game/a15/9wedlia.rpy:230
translate english wedlia_71bb48f0:

    # pojnas "Здесь!"
    pojnas "这里！"

# game/a15/9wedlia.rpy:233
translate english wedlia_df7f154b:

    # me "Лорд Леонард. Лорд Лаггариус."
    me "莱昂纳德领主。拉加里乌斯领主。"

# game/a15/9wedlia.rpy:234
translate english wedlia_56a56a47:

    # lagg "[mename]! Друг мой. Рад тебя видеть."
    lagg "[mename]！我的朋友。很高兴见到你。"

# game/a15/9wedlia.rpy:235
translate english wedlia_6feaf76e_1:

    # leonard "Принц, [mename]."
    leonard "[mename]王子。"

# game/a15/9wedlia.rpy:236
translate english wedlia_97cc458f_1:

    # me "Наслаждаетесь вечером?"
    me "享受这个夜晚吗？"

# game/a15/9wedlia.rpy:237
translate english wedlia_c9214edf:

    # lagg "Конечно. Не каждый день дочь Короля выходит замуж."
    lagg "当然。国王的女儿可不是天天出嫁。"

# game/a15/9wedlia.rpy:238
translate english wedlia_6f1bb655:

    # me "Императора."
    me "是皇帝。"

# game/a15/9wedlia.rpy:239
translate english wedlia_dfef39cf:

    # lagg "Императора. Ну конечно. Теперь мы все часть Золотой Империи. Снова."
    lagg "皇帝。当然。现在我们都是黄金帝国的一部分。又一次。"

# game/a15/9wedlia.rpy:240
translate english wedlia_e6123d88:

    # me "Я так понимаю, что вы как раз и имеете непосредственное отношение к 'озолачиванию' Империи."
    me "我猜您和帝国的‘镀金’有直接关系。"

# game/a15/9wedlia.rpy:241
translate english wedlia_2d3270c9:

    # lagg "Я плачу налог! Конечно."
    lagg "我交税！当然。"

# game/a15/9wedlia.rpy:242
translate english wedlia_f550dffd:

    # me "Перевооружение гвардии тоже часть вашего налога?"
    me "卫队重新武装也是您税金的一部分？"

# game/a15/9wedlia.rpy:243
translate english wedlia_b5f120eb:

    # lagg "Нет. Здесь я действую от чистого сердца. Хочу помочь своему Императору."
    lagg "不。这里我出于真心。我想帮助我的皇帝。"

# game/a15/9wedlia.rpy:244
translate english wedlia_37d1d045:

    # me "Помочь с чем?"
    me "帮什么？"

# game/a15/9wedlia.rpy:245
translate english wedlia_e6b6f579:

    # lagg "С установлением Золотого Порядка, конечно же."
    lagg "当然是建立黄金秩序。"

# game/a15/9wedlia.rpy:246
translate english wedlia_d3ba24bd:

    # me "Он уже установлен."
    me "它已经建立了。"

# game/a15/9wedlia.rpy:247
translate english wedlia_2a78a0ac:

    # lagg "Ну значит с его поддержанием."
    lagg "那就是维护它。"

# game/a15/9wedlia.rpy:249
translate english wedlia_7d2e26c8:

    # me "Я так понимаю идеологическая часть этого решения за вами, лорд Леонард."
    me "我猜这个决定的意识形态部分由您负责，莱昂纳德领主。"

# game/a15/9wedlia.rpy:250
translate english wedlia_36422d83:

    # leonard "Какого решения?"
    leonard "什么决定？"

# game/a15/9wedlia.rpy:251
translate english wedlia_259f0035:

    # me "О смене плащей на золотые."
    me "把斗篷换成金色。"

# game/a15/9wedlia.rpy:252
translate english wedlia_c1ec576f:

    # leonard "Давно была пора. Наша Империя золотая, а не красная."
    leonard "早该如此。我们的帝国是金色的，不是红色的。"

# game/a15/9wedlia.rpy:253
translate english wedlia_b7243090:

    # me "Полагаю, что если бы дело было только в эстетике - я бы не замечал среди гвардейцев столько новых лиц."
    me "我想如果只是审美问题——我不会在卫兵里看到这么多新面孔。"

# game/a15/9wedlia.rpy:254
translate english wedlia_661ade43:

    # leonard "Это усиление."
    leonard "这是加强。"

# game/a15/9wedlia.rpy:255
translate english wedlia_5111ae00:

    # me "Усиление гвардии."
    me "加强卫队。"

# game/a15/9wedlia.rpy:256
translate english wedlia_bcd9c2d3:

    # leonard "Усиление Империи. Усиление Золотого Порядка."
    leonard "加强帝国。加强黄金秩序。"

# game/a15/9wedlia.rpy:257
translate english wedlia_6e3a3873:

    # me "И конечно же усиление императорской власти."
    me "当然还有加强皇权。"

# game/a15/9wedlia.rpy:258
translate english wedlia_380fb03a:

    # leonard "...ваш отец дал на это согласие, если вам интересно, мой принц."
    leonard "……如果您想知道，您父亲同意了，我的王子。"

# game/a15/9wedlia.rpy:259
translate english wedlia_7fa36b43:

    # me "А мой отец..."
    me "那我父亲……"

# game/a15/9wedlia.rpy:260
translate english wedlia_3fc9ae55:

    # leonard "Гвардия подчинена вашему отцу. Не стоит волноваться."
    leonard "卫队听命于您父亲。不必担心。"

# game/a15/9wedlia.rpy:261
translate english wedlia_12217d91:

    # me "И мой отец отдает ей приказы."
    me "而我父亲给他们下命令。"

# game/a15/9wedlia.rpy:262
translate english wedlia_8e54dbe7:

    # leonard "Когда не поручает это своим людям."
    leonard "当他不把这事交给他的人时。"

# game/a15/9wedlia.rpy:263
translate english wedlia_2d98d6c8:

    # me "Например вам."
    me "比如您。"

# game/a15/9wedlia.rpy:264
translate english wedlia_1898eccd:

    # leonard "Например мне. Но я уверяю вас, принц, я действую только исходя из правил Золотого Порядка."
    leonard "比如我。但我向您保证，王子，我只按黄金秩序的规则行事。"

# game/a15/9wedlia.rpy:267
translate english wedlia_12de85ae:

    # me "И вы тоже. Просто поддерживаете Золотой Порядок, лорд Пойнас?"
    me "您也是。只是维护黄金秩序吗，珀纳斯领主？"

# game/a15/9wedlia.rpy:268
translate english wedlia_1a46ea5e:

    # pojnas "Мгм."
    pojnas "嗯。"

# game/a15/9wedlia.rpy:269
translate english wedlia_346af11b:

    # me "И что же. Это просто такой альтруизм?"
    me "那这是纯粹的利他主义吗？"

# game/a15/9wedlia.rpy:270
translate english wedlia_f4ec729b:

    # pojnas "Ну что вы. Альтруизм тут не при чем. От усиления власти Золотого Порядка, крепнет и сама Империя."
    pojnas "哪里。这和利他无关。黄金秩序的权力越强，帝国本身也越强。"

# game/a15/9wedlia.rpy:271
translate english wedlia_e4ab67ad:

    # me "И ее лорды."
    me "还有它的领主们。"

# game/a15/9wedlia.rpy:272
translate english wedlia_5278c674:

    # pojnas "Верно мыслите."
    pojnas "您想得对。"

# game/a15/9wedlia.rpy:273
translate english wedlia_36456cc5:

    # me "А что же приказы."
    me "那命令呢。"

# game/a15/9wedlia.rpy:274
translate english wedlia_00092c8c:

    # pojnas "Какие приказы?"
    pojnas "什么命令？"

# game/a15/9wedlia.rpy:275
translate english wedlia_81685688:

    # me "Если я отдам новой гвардии приказ, они подчинятся?"
    me "如果我给新卫队下令，他们会服从吗？"

# game/a15/9wedlia.rpy:276
translate english wedlia_01c0523f:

    # pojnas "Если...."
    pojnas "如果……"

# game/a15/9wedlia.rpy:277
translate english wedlia_682e5793:

    # me "Если?"
    me "如果？"

# game/a15/9wedlia.rpy:278
translate english wedlia_580dd89b:

    # pojnas "Если ваш отец делегирует вам власть над ними."
    pojnas "如果您父亲把对他们的权力授予您。"

# game/a15/9wedlia.rpy:279
translate english wedlia_ffc51265:

    # me "Понятно."
    me "明白了。"

# game/a15/9wedlia.rpy:280
translate english wedlia_cd56ce3f:

    # pojnas "Какое же вкусное вино."
    pojnas "这酒真好喝。"

# game/a15/9wedlia.rpy:281
translate english wedlia_aafaaf3d:

    # me "Еще увидимся, лорды."
    me "回头见，领主们。"

# game/a15/9wedlia.rpy:282
translate english wedlia_a1ea0bdb:

    # pojnas "Принц [mename]."
    pojnas "[mename]王子。"

# game/a15/9wedlia.rpy:283
translate english wedlia_3dc3d74a:

    # leonard "Принц [mename]."
    leonard "[mename]王子。"

# game/a15/9wedlia.rpy:286
translate english wedlia_ebf35e87:

    # me "И вы тоже. Просто поддерживаете Золотой Порядок, лорд Лаггариус?"
    me "您也是。只是维护黄金秩序吗，拉加里乌斯领主？"

# game/a15/9wedlia.rpy:287
translate english wedlia_878aa7d8:

    # lagg "Поддерживаю? Да я живу ради него. Золотой Порядок - первооснова для всего в этой Империи."
    lagg "维护？我为它而活。黄金秩序是这帝国一切的首要基础。"

# game/a15/9wedlia.rpy:288
translate english wedlia_0ec16939:

    # me "Я думал мой отец первооснова."
    me "我以为我父亲才是首要基础。"

# game/a15/9wedlia.rpy:289
translate english wedlia_edef729d:

    # lagg "Ваш отец - гарант. Гарант того, что Золотой Порядок не будет нарушен."
    lagg "您父亲是保障。是黄金秩序不被破坏的保障。"

# game/a15/9wedlia.rpy:290
translate english wedlia_8362bc51:

    # me "А кто же будет трактовать положения Золотого Порядка?"
    me "那谁来解释黄金秩序的条款？"

# game/a15/9wedlia.rpy:291
translate english wedlia_6baeb62b:

    # lagg "Ну конечно же Трибунал!"
    lagg "当然是法庭！"

# game/a15/9wedlia.rpy:292
translate english wedlia_51b9f4e4:

    # me "Понятно. Хотел ещё кое-что спросить."
    me "明白了。我还想问一件事。"

# game/a15/9wedlia.rpy:293
translate english wedlia_15eb8fac:

    # lagg "Спрашивайте."
    lagg "请说。"

# game/a15/9wedlia.rpy:294
translate english wedlia_2ab79310:

    # me "В скором времени мне понадобится пара гвардейцев. Я ведь могу отдавать им приказы?"
    me "不久后我需要几个卫兵。我可以给他们下令吧？"

# game/a15/9wedlia.rpy:295
translate english wedlia_85e37525:

    # lagg "Конечно, мой принц. Только..."
    lagg "当然，我的王子。只是……"

# game/a15/9wedlia.rpy:296
translate english wedlia_db28de7c:

    # me "Только что?"
    me "只是什么？"

# game/a15/9wedlia.rpy:297
translate english wedlia_d13e1743:

    # lagg "Только сначала ваш отец должен делегировать вам эти полномочия."
    lagg "只是首先您父亲得把这些权力授予您。"

# game/a15/9wedlia.rpy:298
translate english wedlia_ffc51265_1:

    # me "Понятно."
    me "明白了。"

# game/a15/9wedlia.rpy:299
translate english wedlia_b9c6c98c:

    # lagg "Выпьем за золотой порядок?"
    lagg "为黄金秩序喝一杯？"

# game/a15/9wedlia.rpy:300
translate english wedlia_2b337121:

    # me "Попозже. Я оставлю вас, лорды, если позволите."
    me "晚点吧。如果允许，我先告辞了，领主们。"

# game/a15/9wedlia.rpy:301
translate english wedlia_9cb20243:

    # lagg "Принц [mename]."
    lagg "[mename]王子。"

# game/a15/9wedlia.rpy:302
translate english wedlia_3dc3d74a_1:

    # leonard "Принц [mename]."
    leonard "[mename]王子。"

# game/a15/9wedlia.rpy:304
translate english wedlia_100cc52e:

    # lia "А говорил, что не будешь разговаривать ни с кем."
    lia "你还说不会和任何人说话。"

# game/a15/9wedlia.rpy:305
translate english wedlia_245e6c72:

    # me "Ага. Мне пришлось."
    me "是啊。我不得已。"

# game/a15/9wedlia.rpy:306
translate english wedlia_0751123c:

    # lartua_y "Все нормально, принц [mename]?"
    lartua_y "一切都好吗，[mename]王子？"

# game/a15/9wedlia.rpy:307
translate english wedlia_b0656691:

    # me "...более чем. Ну так что? Приняли поздравления?"
    me "……再好不过。那么？接受祝贺了吗？"

# game/a15/9wedlia.rpy:308
translate english wedlia_8f6c03d3:

    # lia "Да. Подарков столько, что пришлось складывать их в отдельной комнате."
    lia "对。礼物多到只能堆在另一个房间里。"

# game/a15/9wedlia.rpy:309
translate english wedlia_0ed7ca29:

    # lartua_y "Думаю часть можно продать на Западе, чтобы оплатить часть свадьбы."
    lartua_y "我想可以把一部分卖到西方，支付婚礼的一部分开销。"

# game/a15/9wedlia.rpy:310
translate english wedlia_e52a02e8:

    # me "Уверен, что моя сестра будет против."
    me "我确定我妹妹会反对。"

# game/a15/9wedlia.rpy:311
translate english wedlia_74472cd1:

    # lia "Ну... нам понадобятся покои втрое больше, если мы захотим все уместить."
    lia "嗯……如果想全放下，我们需要三倍大的房间。"

# game/a15/9wedlia.rpy:312
translate english wedlia_9ecbe7b1:

    # lartua_y "Городская знать оказалась более щедрой, чем мы ожидали."
    lartua_y "城市贵族比我们预想的更慷慨。"

# game/a15/9wedlia.rpy:313
translate english wedlia_309b95c5:

    # me "Ну... это хорошо."
    me "嗯……那很好。"

# game/a15/9wedlia.rpy:315
translate english wedlia_fc4bf5cc:

    # lia "Ты ведь придешь сегодня ночью?"
    lia "你今晚会来吗？"

# game/a15/9wedlia.rpy:316
translate english wedlia_cb478e92:

    # me "Приду. Мы уже обсудили это с твоим женихом."
    me "会来。我已经和你未婚夫谈过了。"

# game/a15/9wedlia.rpy:317
translate english wedlia_9b5b287f:

    # lartua_y "Да... через полчаса."
    lartua_y "对……半小时后。"

# game/a15/9wedlia.rpy:318
translate english wedlia_043c09d2:

    # lia "Лучше не показываться лишний раз на людях."
    lia "最好别在人前多露面。"

# game/a15/9wedlia.rpy:319
translate english wedlia_ff0863a8:

    # lartua_y "Да... это было бы..."
    lartua_y "对……那就……"

# game/a15/9wedlia.rpy:320
translate english wedlia_b57f067a:

    # me "Я буду осторожен."
    me "我会小心。"

# game/a15/9wedlia.rpy:321
translate english wedlia_35f3a72a:

    # lia "Хорошо."
    lia "好。"

# game/a15/9wedlia.rpy:323
translate english wedlia_0b4fb640:

    # lia "Ты же станцуешь со мной?"
    lia "你会和我跳舞吗？"

# game/a15/9wedlia.rpy:324
translate english wedlia_8084c27a:

    # me "Что? Сейчас?"
    me "什么？现在？"

# game/a15/9wedlia.rpy:325
translate english wedlia_691137b5:

    # lia "Нет. Когда мы вернемся из города."
    lia "不。等我们从城里回来。"

# game/a15/9wedlia.rpy:326
translate english wedlia_6eaf089c:

    # me "Я думал ты будешь танцевать с Кайденом."
    me "我以为你会和凯登跳。"

# game/a15/9wedlia.rpy:327
translate english wedlia_3affadc8:

    # lartua_y "Это не свадебный танец."
    lartua_y "那不是婚礼舞。"

# game/a15/9wedlia.rpy:328
translate english wedlia_3c8aa025:

    # lia "Ночью тут останется только молодая знать. Все будут танцевать друг с другом."
    lia "夜里这里只剩年轻贵族。大家会互相跳舞。"

# game/a15/9wedlia.rpy:329
translate english wedlia_c97fadc0:

    # me "Ну..."
    me "嗯……"

# game/a15/9wedlia.rpy:330
translate english wedlia_b671ed6c:

    # lia "Ты придешь? Я хочу потанцевать с тобой тоже."
    lia "你会来吗？我也想和你跳舞。"

# game/a15/9wedlia.rpy:331
translate english wedlia_5a31611b:

    # me "Ну ладно."
    me "那好吧。"

# game/a15/9wedlia.rpy:332
translate english wedlia_208a9eff:

    # lia "ОТЛИЧНО!"
    lia "太好了！"

# game/a15/9wedlia.rpy:333
translate english wedlia_40e42336:

    # lartua_y "Вернитесь сюда после полуночи. Либо когда мы вернемся из города."
    lartua_y "午夜后回这里。或者等我们从城里回来。"

# game/a15/9wedlia.rpy:336
translate english wedlia_d428a84c:

    # zabawa "Принц [mename]."
    zabawa "[mename]王子。"

# game/a15/9wedlia.rpy:337
translate english wedlia_e732ecad:

    # conrad "Племянник."
    conrad "侄子。"

# game/a15/9wedlia.rpy:338
translate english wedlia_9ec9c617:

    # me "Чудесно выглядите. Оба."
    me "你们看起来很棒。两位都是。"

# game/a15/9wedlia.rpy:339
translate english wedlia_c493f309:

    # zabawa "Спасибо."
    zabawa "谢谢。"

# game/a15/9wedlia.rpy:340
translate english wedlia_48fa3486:

    # conrad "Спасибо."
    conrad "谢谢。"

# game/a15/9wedlia.rpy:341
translate english wedlia_b3ad5836:

    # me "Надеюсь вам не сильно утруждает положение пары номер два на этой свадьбе."
    me "希望这场婚礼上二号新人的身份不会太让你们为难。"

# game/a15/9wedlia.rpy:342
translate english wedlia_849fb486:

    # zabawa "Напротив - меньше ненужного внимания."
    zabawa "恰恰相反——少了不必要的关注。"

# game/a15/9wedlia.rpy:343
translate english wedlia_7778d21b:

    # conrad "Хотя видя дары, что преподнесли твоей сестре..."
    conrad "不过看到送给你妹妹的礼物……"

# game/a15/9wedlia.rpy:344
translate english wedlia_26d9fdea:

    # me "Можете забрать половину."
    me "你们可以拿走一半。"

# game/a15/9wedlia.rpy:345
translate english wedlia_bdd5a087:

    # zabawa "Принц [mename]! Конрад!"
    zabawa "[mename]王子！康拉德！"

# game/a15/9wedlia.rpy:346
translate english wedlia_26e71cec:

    # conrad "А что? Я бы не отказался от той золотой посуды, что прислал старик Лартуа."
    conrad "怎么了？我倒不介意收下老拉尔图阿送来的那套金餐具。"

# game/a15/9wedlia.rpy:347
translate english wedlia_1f6184e1:

    # me "В этом замке она все равно общая."
    me "在这城堡里它反正是公用的。"

# game/a15/9wedlia.rpy:348
translate english wedlia_a65a08c8:

    # conrad "Я бы хранил ее в сундуке и приносил ее с собой на ужин."
    conrad "我会把它锁在箱子里，吃晚饭时再带来。"

# game/a15/9wedlia.rpy:349
translate english wedlia_73454ae6:

    # me "И уносил бы грязную?"
    me "然后再脏着带回去？"

# game/a15/9wedlia.rpy:350
translate english wedlia_a1e2c382:

    # zabawa "Вы же сейчас не серьезно?"
    zabawa "你们不是认真的吧？"

# game/a15/9wedlia.rpy:351
translate english wedlia_94cb9036:

    # conrad "Кто знает?"
    conrad "谁知道呢？"

# game/a15/9wedlia.rpy:352
translate english wedlia_74086cfa:

    # me "Рад, что вы успели подготовиться. Неужели нам замковый портной так хорош?"
    me "很高兴你们来得及准备。难道城堡裁缝真那么好？"

# game/a15/9wedlia.rpy:353
translate english wedlia_7920d3bf:

    # zabawa "Конрад купил мне платье в городе."
    zabawa "康拉德在城里给我买了裙子。"

# game/a15/9wedlia.rpy:354
translate english wedlia_a84f40bb:

    # conrad "А кафтан я одолжил у брата."
    conrad "而长袍是我从兄弟那儿借的。"

# game/a15/9wedlia.rpy:355
translate english wedlia_5715b9e4:

    # me "Надеюсь это не значит, что Император придет голым."
    me "希望这不代表皇帝会光着身子来。"

# game/a15/9wedlia.rpy:356
translate english wedlia_4e84d129:

    # conrad "Уверен это не посрамит его императорское величие. Полагаю гости предпочтут этого не замечать."
    conrad "我相信这不会辱没他的皇帝威严。我想宾客们会宁可不注意。"

# game/a15/9wedlia.rpy:357
translate english wedlia_49d5f5b8:

    # zabawa "О боже, прекратите."
    zabawa "哦天哪，别说了。"

# game/a15/9wedlia.rpy:359
translate english wedlia_0cf5a7a4:

    # me "Примите мои поздравления."
    me "请接受我的祝贺。"

# game/a15/9wedlia.rpy:360
translate english wedlia_c493f309_1:

    # zabawa "Спасибо."
    zabawa "谢谢。"

# game/a15/9wedlia.rpy:361
translate english wedlia_950abe6d:

    # conrad "Спасибо, без тебя этого бы не произошло."
    conrad "谢谢，没有你就不会有这一切。"

# game/a15/9wedlia.rpy:362
translate english wedlia_66845997:

    # me "Не буду скромничать - моя вина. Хотя так же вынужден признать, что я это сделал не только из добрых намерений."
    me "我不谦虚——是我的功劳。不过我也得承认，我这么做不只是出于善意。"

# game/a15/9wedlia.rpy:363
translate english wedlia_418c822c:

    # zabawa "Намерения не так важны."
    zabawa "意图没那么重要。"

# game/a15/9wedlia.rpy:364
translate english wedlia_76422b17:

    # conrad "Вот именно. Главное - это результат. И он очень даже хороший."
    conrad "正是。重要的是结果。而这结果非常好。"

# game/a15/9wedlia.rpy:365
translate english wedlia_b2cc8f52:

    # me "Я смотрю вы хорошо поладили."
    me "看来你们相处得很好。"

# game/a15/9wedlia.rpy:366
translate english wedlia_5edee282:

    # zabawa "Более чем."
    zabawa "不止是好。"

# game/a15/9wedlia.rpy:367
translate english wedlia_c0c62fb8:

    # conrad "Не думал, что женюсь на северянке. Но пару дней в компании этой красавицы меня переубедили."
    conrad "我没想到会娶个北方姑娘。但和这位美人待了几天，我就改主意了。"

# game/a15/9wedlia.rpy:368
translate english wedlia_9c0d0623:

    # zabawa "Прекрати, Конрад."
    zabawa "别说了，康拉德。"

# game/a15/9wedlia.rpy:369
translate english wedlia_29105491:

    # me "Не волнуйтесь, Забава, он врет и всегда хотел женится на северянке. Я рад за вас. Не хотелось бы, что это был просто сухой брак по расчету."
    me "别担心，扎巴娃，他在撒谎，他一直想娶北方姑娘。我为你们高兴。不希望这只是干巴巴的政治婚姻。"

# game/a15/9wedlia.rpy:370
translate english wedlia_089dab86:

    # zabawa "Этого и не будет."
    zabawa "不会是那样。"

# game/a15/9wedlia.rpy:371
translate english wedlia_d7e147b9:

    # conrad "Конечно нет."
    conrad "当然不会。"

# game/a15/9wedlia.rpy:372
translate english wedlia_198674ba:

    # me "Что же... рад, что случайность родила любовь."
    me "那么……很高兴偶然生出了爱。"

# game/a15/9wedlia.rpy:373
translate english wedlia_08ed24b6:

    # zabawa "Выпьете с нами?"
    zabawa "和我们喝一杯？"

# game/a15/9wedlia.rpy:374
translate english wedlia_f4b505ed:

    # conrad "Да, [mename], давай в благодарность мы защитим тебя от всех этих прилипал. Посиди и выпей вина с нами."
    conrad "对，[mename]，作为答谢，我们帮你挡住那些缠人精。坐下和我们喝杯酒吧。"

# game/a15/9wedlia.rpy:375
translate english wedlia_0d730dc6:

    # me "С удовольствием."
    me "乐意之至。"

# game/a15/9wedlia.rpy:377
translate english wedlia_83749a03:

    # "Полчаса спустя."
    "半小时后。"

# game/a15/9wedlia.rpy:378
translate english wedlia_13fa9de7:

    # slug "Еще мой принц?"
    slug "还要吗，我的王子？"

# game/a15/9wedlia.rpy:379
translate english wedlia_66948067:

    # me "Мгм."
    me "嗯。"

# game/a15/9wedlia.rpy:380
translate english wedlia_74e81629:

    # slug "Какого?"
    slug "哪种？"

# game/a15/9wedlia.rpy:381
translate english wedlia_bd8a3643:

    # me "Арнскзлтг."
    me "阿兰金酒。"

# game/a15/9wedlia.rpy:382
translate english wedlia_2faaac98:

    # slug "Карское?"
    slug "喀尔酒？"

# game/a15/9wedlia.rpy:383
translate english wedlia_fe3ea6f7:

    # me "МмНМ."
    me "嗯嗯。"

# game/a15/9wedlia.rpy:384
translate english wedlia_47d8ffce:

    # slug "Прошу прощения, я не расслышала."
    slug "抱歉，我没听清。"

# game/a15/9wedlia.rpy:385
translate english wedlia_bd8a3643_1:

    # me "Арнскзлтг."
    me "阿兰金酒。"

# game/a15/9wedlia.rpy:386
translate english wedlia_f0b25e8a:

    # slug "Аранского золотого?"
    slug "阿兰金酒？"

# game/a15/9wedlia.rpy:387
translate english wedlia_66948067_1:

    # me "Мгм."
    me "嗯。"

# game/a15/9wedlia.rpy:390
translate english wedlia_ed98902b:

    # slug "Бочка с ним в другом конце зала. Подождете пока король... император пройдет."
    slug "酒桶在大厅另一端。等国王……皇帝过去吧。"

# game/a15/9wedlia.rpy:391
translate english wedlia_36c19eec:

    # me "Уже не надо."
    me "不用了。"

# game/a15/9wedlia.rpy:392
translate english wedlia_4f26f815:

    # slug "Мой принц?"
    slug "我的王子？"

# game/a15/9wedlia.rpy:393
translate english wedlia_06aee95b:

    # me "Я передумал пить."
    me "我改主意不喝了。"

# game/a15/9wedlia.rpy:394
translate english wedlia_6488d863:

    # slug "Как скажете, мой принц."
    slug "遵命，我的王子。"

# game/a15/9wedlia.rpy:396
translate english wedlia_6db85267:

    # lia "Папа!"
    lia "爸爸！"

# game/a15/9wedlia.rpy:397
translate english wedlia_808b714d:

    # king "[ophie]."
    king "[ophie]。"

# game/a15/9wedlia.rpy:398
translate english wedlia_664d3e09:

    # lia "Я так рада, что ты пришел!"
    lia "你来了我真高兴！"

# game/a15/9wedlia.rpy:399
translate english wedlia_6320d9b4:

    # king "Я рад не меньше, дочь моя."
    king "我同样高兴，我的女儿。"

# game/a15/9wedlia.rpy:400
translate english wedlia_c27240fe:

    # lia "Все только тебя и ждали."
    lia "大家都只等你。"

# game/a15/9wedlia.rpy:401
translate english wedlia_0a1ec932:

    # king "Почему?"
    king "为什么？"

# game/a15/9wedlia.rpy:402
translate english wedlia_a6000186:

    # lia "Я сказала, что первый тост обязан быть от Императора."
    lia "我说第一杯祝酒必须由皇帝来。"

# game/a15/9wedlia.rpy:403
translate english wedlia_c4f91678:

    # king "Ух... и когда ты успела так вырасти?"
    king "哎……你什么时候长这么大了？"

# game/a15/9wedlia.rpy:404
translate english wedlia_ba07e4c3:

    # lia "Совсем недавно! Я покажу тебе потом, что подарили мне лорды и городская знать?"
    lia "就最近！我晚点给你看领主们和城市贵族送了我什么，好吗？"

# game/a15/9wedlia.rpy:405
translate english wedlia_fa164777:

    # king "Конечно. Я не против разделить твою радость, птичка."
    king "当然。我不介意分享你的快乐，小鸟。"

# game/a15/9wedlia.rpy:406
translate english wedlia_73e04395:

    # lia "Можем начинать?"
    lia "可以开始了吗？"

# game/a15/9wedlia.rpy:407
translate english wedlia_bf0d6687:

    # king "Давно пора."
    king "早该开始了。"

# game/a15/9wedlia.rpy:408
translate english wedlia_000eaac3:

    # lia "Хорошо. Попросить молчания?"
    lia "好。要大家安静吗？"

# game/a15/9wedlia.rpy:409
translate english wedlia_4cb21b7a:

    # king "Нет. Я сам оглашу тост."
    king "不。我自己来祝酒。"

# game/a15/9wedlia.rpy:410
translate english wedlia_79dff697:

    # lia "Хорошо. Попросить музыкантов перестать играть?"
    lia "好。要乐师停下吗？"

# game/a15/9wedlia.rpy:411
translate english wedlia_3ed515aa:

    # king "Я еще не настолько стар, чтобы струны заглушили мой голос."
    king "我还没老到琴弦会盖过我的声音。"

# game/a15/9wedlia.rpy:412
translate english wedlia_35f3a72a_1:

    # lia "Хорошо."
    lia "好。"

# game/a15/9wedlia.rpy:413
translate english wedlia_02ab7501:

    # me "Здравствуй, отец."
    me "你好，父亲。"

# game/a15/9wedlia.rpy:415
translate english wedlia_2408fa27:

    # king "[mename]."
    king "[mename]。"

# game/a15/9wedlia.rpy:416
translate english wedlia_2ba68507:

    # me "Отец."
    me "父亲。"

# game/a15/9wedlia.rpy:417
translate english wedlia_be48b211:

    # king "Рад видеть тебя в добром здравии, сын мой."
    king "很高兴看到你身体康健，我的儿子。"

# game/a15/9wedlia.rpy:418
translate english wedlia_530cb588:

    # me "И я рад тебя видеть в добром здравии, отец."
    me "我也很高兴看到你身体康健，父亲。"

# game/a15/9wedlia.rpy:419
translate english wedlia_7e31ff9b:

    # king "Как прошла твоя поездка на Север?"
    king "你北方之行怎么样？"

# game/a15/9wedlia.rpy:421
translate english wedlia_81015e1d:

    # me "С пользой."
    me "卓有成效。"

# game/a15/9wedlia.rpy:422
translate english wedlia_a8fb5aac:

    # king "Ты добился какой-нибудь пользы для Империи?"
    king "你为帝国取得了什么好处吗？"

# game/a15/9wedlia.rpy:423
translate english wedlia_772144f2:

    # me "Да. Но боюсь, что это тема не для настолько публичного разговора."
    me "有。但恐怕这不是适合在这么公开场合谈的话题。"

# game/a15/9wedlia.rpy:426
translate english wedlia_167779f2:

    # me "Я добыл тебе новую корону, отец."
    me "我为你赢得了一顶新王冠，父亲。"

# game/a15/9wedlia.rpy:427
translate english wedlia_b0ca3b9a:

    # king "Чудесно. Ты оправдываешь все возложенные на тебя надежды, сын мой."
    king "太好了。你正配得上寄托在你身上的所有期望，我的儿子。"

# game/a15/9wedlia.rpy:428
translate english wedlia_763bb5fa:

    # me "Рад служить Империи."
    me "乐意为帝国效劳。"

# game/a15/9wedlia.rpy:429
translate english wedlia_bb83009b:

    # king "Ты поделишься подробностями?"
    king "你会分享细节吗？"

# game/a15/9wedlia.rpy:430
translate english wedlia_772144f2_1:

    # me "Да. Но боюсь, что это тема не для настолько публичного разговора."
    me "会。但恐怕这不是适合在这么公开场合谈的话题。"

# game/a15/9wedlia.rpy:431
translate english wedlia_d5810880:

    # king "Конечно. Обсудим это потом."
    king "当然。以后再谈。"

# game/a15/9wedlia.rpy:432
translate english wedlia_75994275:

    # me "Я вижу в замке много новых лиц. И все в золотых плащах."
    me "我看到城堡里有许多新面孔。都穿着金斗篷。"

# game/a15/9wedlia.rpy:433
translate english wedlia_6e3645a4:

    # king "Милостью моих подданных мы собрали средства для усиления имперской гвардии."
    king "托我臣民的恩典，我们筹集了加强帝国卫队的资金。"

# game/a15/9wedlia.rpy:434
translate english wedlia_48eb43e3:

    # me "И как давно это произошло?"
    me "这是多久前的事？"

# game/a15/9wedlia.rpy:435
translate english wedlia_c9f8caa8:

    # king "Как только мне стало лучше, сын мой. Лорды предложили мне оплатить эти изменения из своей казны."
    king "等我好些后，我的儿子。领主们提出从自己的金库支付这些变动。"

# game/a15/9wedlia.rpy:436
translate english wedlia_5c775f21:

    # me "И ты согласился."
    me "而你同意了。"

# game/a15/9wedlia.rpy:437
translate english wedlia_8bdb15ef:

    # king "Это пойдет на пользу Империи и Золотому Порядку."
    king "这对帝国和黄金秩序都有好处。"

# game/a15/9wedlia.rpy:438
translate english wedlia_3820771a_1:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:439
translate english wedlia_8a78a088:

    # king "Ты не согласен с моим решением, сын мой?"
    king "你不赞同我的决定吗，我的儿子？"

# game/a15/9wedlia.rpy:440
translate english wedlia_2992b012:

    # me "Я не могу его оспаривать, отец. Я рад, что наш дом теперь под еще большей защитой."
    me "我无法质疑它，父亲。我很高兴我们的家族现在受到更强的保护。"

# game/a15/9wedlia.rpy:441
translate english wedlia_cdfb3134:

    # king "..."
    king "……"

# game/a15/9wedlia.rpy:443
translate english wedlia_6de29027:

    # king "Свадьба моего брата..."
    king "我弟弟的婚礼……"

# game/a15/9wedlia.rpy:444
translate english wedlia_610c3b1a:

    # me "Да. Это моя инициатива. Долго объяснять и ни к месту. Но уверяю тебя, что я не оказывал ни на кого давления."
    me "对。是我的提议。说来话长，也不合时宜。但我向你保证，我没有对任何人施压。"

# game/a15/9wedlia.rpy:445
translate english wedlia_81ef4375:

    # king "Хорошо."
    king "好。"

# game/a15/9wedlia.rpy:446
translate english wedlia_0a362777:

    # king "Мне сказали, что ты прибыл верхом. Через Вольные города."
    king "有人告诉我你是骑马来的。穿过自由城市。"

# game/a15/9wedlia.rpy:447
translate english wedlia_c92d0235:

    # me "Порт замерз."
    me "港口冻住了。"

# game/a15/9wedlia.rpy:448
translate english wedlia_b9351137:

    # king "Как болезнь, что свирепствовала там? Что можешь сказать?"
    king "那里的疫病怎么样？你有什么可说的？"

# game/a15/9wedlia.rpy:449
translate english wedlia_68c6c63b:

    # me "Она стихает."
    me "正在消退。"

# game/a15/9wedlia.rpy:450
translate english wedlia_943ee8fa:

    # king "Достаточно, чтобы можно было начать с ними переговоры?"
    king "足够开始和他们谈判了吗？"

# game/a15/9wedlia.rpy:451
translate english wedlia_e9293f1f:

    # me "Боюсь, что переговоры там вести особо не с кем."
    me "恐怕那里已经没什么人可谈了。"

# game/a15/9wedlia.rpy:452
translate english wedlia_3b5b15ce:

    # king "Неужели болезнь была столь ужасна?"
    king "疫病真有那么可怕？"

# game/a15/9wedlia.rpy:453
translate english wedlia_8407c63b:

    # me "Думаю если целью переговоров является присоединение Вольных Городов к Империи - достаточно просто предложить помощь."
    me "我想如果谈判的目标是让自由城市加入帝国——只需提供援助就够了。"

# game/a15/9wedlia.rpy:454
translate english wedlia_832c42c2:

    # king "Что же, если они откажутся?"
    king "那如果他们拒绝呢？"

# game/a15/9wedlia.rpy:459
translate english wedlia_62c4da0a:

    # me "Не откажутся, отец. Поверь мне, положение там таково, что достаточно крупный отряд наемников способен захватить целый город."
    me "他们不会拒绝，父亲。相信我，那里的局势是，一支足够大的雇佣兵队伍就能攻下一整座城。"

# game/a15/9wedlia.rpy:460
translate english wedlia_eeb6275c:

    # king "Выходит я не прогадал, когда закрыл все мосты через Кайсу."
    king "看来我关闭凯萨河上所有桥梁时没有算错。"

# game/a15/9wedlia.rpy:461
translate english wedlia_bbcc4934:

    # me "Это было чрезвычайно мудрое решение."
    me "那是极为明智的决定。"

# game/a15/9wedlia.rpy:462
translate english wedlia_add2bef2:

    # king "...хорошо."
    king "……好。"

# game/a15/9wedlia.rpy:463
translate english wedlia_776a6dab:

    # me "Но я бы не рекомендовал нарушать изоляцию хотя бы до окончания зимы. Болезнь идет на спад. Но кто знает, сколько она способна жить в трупах и крысах."
    me "但我不建议至少在冬天结束前解除隔离。疫病正在消退。但谁知道它能在尸体和老鼠身上存活多久。"

# game/a15/9wedlia.rpy:464
translate english wedlia_20f09368:

    # king "Ты не встречал Преториуса?"
    king "你没遇到普雷托里乌斯？"

# game/a15/9wedlia.rpy:465
translate english wedlia_43847290:

    # me "Я миновал все города, кроме Бригдока. Он был в нем?"
    me "我绕过了除布里格多克外的所有城市。他在那儿吗？"

# game/a15/9wedlia.rpy:466
translate english wedlia_5be7e657:

    # king "Он путешествует по всем Вольным Городам. Но похоже найти лекарство от этой болезни гораздо сложнее, чем от того недуга, которым страдал я."
    king "他走遍了所有自由城市。但看来找到这种病的解药，比我当初所患病症要难得多。"

# game/a15/9wedlia.rpy:467
translate english wedlia_d9c94031:

    # me "Слишком разный метод передачи. Белая Кровь жила в жидкостях. В воде, в крови и прочих выделениях. А Болотную Чуму похоже переносит и воздух и звери."
    me "传播方式差别太大。白血症存在于液体中。水、血液和其他分泌物。而沼泽瘟疫似乎还通过空气和野兽传播。"

# game/a15/9wedlia.rpy:468
translate english wedlia_a0b8c49e:

    # king "Хм..."
    king "嗯……"

# game/a15/9wedlia.rpy:469
translate english wedlia_41caa6a9:

    # me "Наверное не стоит говорить о чуме на свадьбе."
    me "大概不该在婚礼上谈瘟疫。"

# game/a15/9wedlia.rpy:470
translate english wedlia_efea661e:

    # king "Ты прав, сын мой. Лучше расскажи как тебе красоты Севера."
    king "你说得对，我的儿子。不如跟我说说北方的美景。"

# game/a15/9wedlia.rpy:471
translate english wedlia_6fa1e62e:

    # me "Ты бывал там?"
    me "你去过那里吗？"

# game/a15/9wedlia.rpy:472
translate english wedlia_1e5b5bd7:

    # king "Бывал. Правда насладиться красотами мне мешала война."
    king "去过。不过战争让我无暇欣赏美景。"

# game/a15/9wedlia.rpy:473
translate english wedlia_28a6d49b:

    # lia "Ты немного напутал, пап. На войне был дядя Рагвеллион."
    lia "你记错了，爸爸。参战的是拉格维隆叔叔。"

# game/a15/9wedlia.rpy:474
translate english wedlia_269aaf08:

    # me "...{i}Она права. Об этом лучше не говорить публично.{/i}"
    me "……{i}她说得对。这事最好别公开谈。{/i}"

# game/a15/9wedlia.rpy:475
translate english wedlia_cdfb3134_1:

    # king "..."
    king "……"

# game/a15/9wedlia.rpy:476
translate english wedlia_f5aa3caa:

    # me "Прекрасные блюда сегодня, правда отец?"
    me "今天的菜真好，对吧，父亲？"

# game/a15/9wedlia.rpy:477
translate english wedlia_dba476ef:

    # king "Да. Лорд Лауртуа прислал своих слуг-поваров и целый обоз со скотом и съестным."
    king "对。拉尔图阿领主派来了他的厨仆和一整队牲畜和食物。"

# game/a15/9wedlia.rpy:478
translate english wedlia_4b036910:

    # me "Отлично. Щедрость семьи жениха — это хороший знак."
    me "很好。新郎家族的慷慨是好兆头。"

# game/a15/9wedlia.rpy:479
translate english wedlia_834303da:

    # lia "Правда? Какой?"
    lia "真的？什么兆头？"

# game/a15/9wedlia.rpy:480
translate english wedlia_b9195304:

    # me "Значит брак будет в богатстве."
    me "意味着婚姻会富足。"

# game/a15/9wedlia.rpy:481
translate english wedlia_4bcec84c:

    # king "Думаю ценность союза определяется не в золоте."
    king "我认为联盟的价值不由黄金衡量。"

# game/a15/9wedlia.rpy:482
translate english wedlia_8e93214c:

    # me "Конечно, отец. И все же звон золота делает веселей и свадьбу свинопаса и свадьбу короля."
    me "当然，父亲。不过黄金的叮当声能让猪倌的婚礼和国王的婚礼都更欢快。"

# game/a15/9wedlia.rpy:483
translate english wedlia_cdfb3134_2:

    # king "..."
    king "……"

# game/a15/9wedlia.rpy:485
translate english wedlia_16eb2bee:

    # king "Поднимите свои кубки."
    king "举起你们的杯子。"

# game/a15/9wedlia.rpy:486
translate english wedlia_7865ec85:

    # king "Лорды и леди, знатные горожане и все вассалы моего знамени и Золотого Порядка, гости, пришедшие под эту крышу не из праздного любопытства, а по долгу и по чести."
    king "领主与女士们，高贵的市民们，我的旗帜与黄金秩序的所有附庸，来到这屋檐下并非出于无聊好奇，而是出于职责与荣誉的客人们。"

# game/a15/9wedlia.rpy:487
translate english wedlia_e9cb758e:

    # king "Сегодня королевский дом отдаёт свою кровь в новый союз."
    king "今天王室将自己的血脉交入新的联盟。"

# game/a15/9wedlia.rpy:488
translate english wedlia_6b9e68bf:

    # king "И вы все, сыновья и дочери Империи - свидетели этого союза."
    king "而你们所有人，帝国的儿女们——是这个联盟的见证者。"

# game/a15/9wedlia.rpy:489
translate english wedlia_a149e19b:

    # king "Поднимите кубки и уважьте союз дома Лартуа и Стархэдов."
    king "举起杯子，敬拉尔图阿家族与斯塔赫德家族的联盟。"

# game/a15/9wedlia.rpy:491
translate english wedlia_9b81306a:

    # king "Мой дорогой брат Конрад сегодня тоже дарит нашей семье новый союз."
    king "我亲爱的弟弟康拉德今天也为我们的家族带来新的联盟。"

# game/a15/9wedlia.rpy:492
translate english wedlia_0f993558:

    # king "Дом Красиных - великий и могучий, как сам Север, сегодня роднится с нашим домом."
    king "克拉辛家族——如北方本身般伟大强盛——今天与我们的家族结亲。"

# game/a15/9wedlia.rpy:493
translate english wedlia_718321b9:

    # king "Видят боги - это доброе знамение общего будущего наших королевств."
    king "众神见证——这是我们两国共同未来的好兆头。"

# game/a15/9wedlia.rpy:494
translate english wedlia_21dad916:

    # king "Уверен, оба этих союза будут крепки, как Железная Воля и вечны, как Золотой Порядок."
    king "我确信，这两个联盟都将如铁之意志般坚固，如黄金秩序般永恒。"

# game/a15/9wedlia.rpy:496
translate english wedlia_d930ffe6:

    # king "Уверен, этот союз будет крепок, как Железная Воля и вечен, как Золотой Порядок."
    king "我确信，这个联盟将如铁之意志般坚固，如黄金秩序般永恒。"

# game/a15/9wedlia.rpy:498
translate english wedlia_64a435a1:

    # gosti "ПУСТЬ ЖЕЛЕЗНОЙ БУДЕТ ТВОЯ ВОЛЯ."
    gosti "愿你的意志如铁。"

# game/a15/9wedlia.rpy:499
translate english wedlia_0cef1865:

    # gosti2 "ПУСТЬ ЗОЛОТОЙ ПОРЯДОК БУДЕТ ВЕЧЕН."
    gosti2 "愿黄金秩序永存。"

# game/a15/9wedlia.rpy:500
translate english wedlia_c0660e9e:

    # king "Пейте за этот прекрасный союз молодых сердец."
    king "为这年轻心灵的美好联盟干杯。"

# game/a15/9wedlia.rpy:501
translate english wedlia_64d6ccb5:

    # king "Пейте за этот чудесный вечер."
    king "为这美妙的夜晚干杯。"

# game/a15/9wedlia.rpy:502
translate english wedlia_f90e1a18:

    # king "Пейте за этот смех и радость."
    king "为这欢笑与喜悦干杯。"

# game/a15/9wedlia.rpy:503
translate english wedlia_e14e683f:

    # king "Пейте за эту музыку, пока она ещё не стихла."
    king "为这尚未沉寂的音乐干杯。"

# game/a15/9wedlia.rpy:504
translate english wedlia_f17076a0:

    # king "Пейте за этот кубок, пока в нём ещё играет золото вина."
    king "为这杯中仍在荡漾的黄金酒液干杯。"

# game/a15/9wedlia.rpy:505
translate english wedlia_57bfd30e:

    # king "Пейте за этот огонь в очагах - да не погаснет он никогда."
    king "为炉中的火焰干杯——愿它永不熄灭。"

# game/a15/9wedlia.rpy:506
translate english wedlia_29d6a697:

    # king "Пейте за ваши дома и за Империю - наш общий дом."
    king "为你们的家族，也为帝国——我们共同的家园干杯。"

# game/a15/9wedlia.rpy:507
translate english wedlia_ac9e7cc5:

    # king "Пейте за ваших матерей и детей."
    king "为你们的母亲和孩子干杯。"

# game/a15/9wedlia.rpy:509
translate english wedlia_f3e4c8c3:

    # king "Пейте за корону Севера, что мой сын принес как самое сладкое угощение к столу!"
    king "为北方王冠干杯——我的儿子把它作为最甜美的佳肴带上了桌！"

# game/a15/9wedlia.rpy:511
translate english wedlia_587408a3:

    # king "Пейте за здравие моего наследника! За моего сына и за моего внука!"
    king "为我的继承人健康干杯！为我的儿子和我的孙子干杯！"

# game/a15/9wedlia.rpy:513
translate english wedlia_5ef6742e:

    # king "Пейте за здравие моего сына, что вернулся с Севера!"
    king "为从北方归来的我儿子健康干杯！"

# game/a15/9wedlia.rpy:515
translate english wedlia_b9440275:

    # king "Пейте за здравие моего наследника и его наследника! За моего сына и за моего внука!"
    king "为我的继承人和他的继承人健康干杯！为我的儿子和我的孙子干杯！"

# game/a15/9wedlia.rpy:516
translate english wedlia_4fe645ac:

    # king "Пейте за доблесть и отвагу наших мужчин."
    king "为我们男人的英勇与胆气干杯。"

# game/a15/9wedlia.rpy:517
translate english wedlia_fe9ec8b4:

    # king "Пейте за теплоту и доброту наших женщин."
    king "为我们女人的温暖与善良干杯。"

# game/a15/9wedlia.rpy:518
translate english wedlia_f32dcb7e:

    # king "Пейте за клятвы и честь."
    king "为誓言与荣誉干杯。"

# game/a15/9wedlia.rpy:519
translate english wedlia_8dfd54af:

    # king "Пейте за любовь и красоту."
    king "为爱与美干杯。"

# game/a15/9wedlia.rpy:520
translate english wedlia_2d7ea9c9:

    # king "Пейте за меня! Пейте друг за друга! Пейте за женский смех и мужскую стать."
    king "为我干杯！为彼此干杯！为女人的笑声和男人的体魄干杯。"

# game/a15/9wedlia.rpy:521
translate english wedlia_97e99c2c:

    # king "Пейте, веселитесь и танцуйте, пока молоды."
    king "趁年轻，喝吧，欢闹吧，跳舞吧。"

# game/a15/9wedlia.rpy:523
translate english wedlia_6387f7e7:

    # king "{i}Ух ты... давно не видел отца в таком добром расположении духа. По-моему, он даже улыбался.{/i}"
    king "{i}哎呀……很久没见过父亲心情这么好了。我觉得他甚至笑了。{/i}"

# game/a15/9wedlia.rpy:524
translate english wedlia_1c845eb7:

    # gosti "За Империю!"
    gosti "为帝国！"

# game/a15/9wedlia.rpy:525
translate english wedlia_b19338f9:

    # gosti2 "За тебя, дружище!"
    gosti2 "为你，朋友！"

# game/a15/9wedlia.rpy:526
translate english wedlia_1c8635ff:

    # gosti3 "Нет, за тебя!"
    gosti3 "不，为你！"

# game/a15/9wedlia.rpy:527
translate english wedlia_af8fd3ef:

    # king "За всех нас!"
    king "为我们所有人！"

# game/a15/9wedlia.rpy:528
translate english wedlia_ec4f8a4d:

    # gosti "Налейте мне еще!"
    gosti "再给我倒一杯！"

# game/a15/9wedlia.rpy:529
translate english wedlia_8927c22b:

    # gosti2 "И мне! И мне!"
    gosti2 "我也要！我也要！"

# game/a15/9wedlia.rpy:530
translate english wedlia_5baab52f:

    # gosti3 "За меня!"
    gosti3 "为我！"

# game/a15/9wedlia.rpy:531
translate english wedlia_2a0f5bfd:

    # king "Ну... напоить всех у него точно удалось."
    king "嗯……他确实把所有人都灌醉了。"

# game/a15/9wedlia.rpy:532
translate english wedlia_86b95c09:

    # gosti "За моего деда!"
    gosti "为我祖父！"

# game/a15/9wedlia.rpy:533
translate english wedlia_1141ad35:

    # gosti2 "За любовь!"
    gosti2 "为爱！"

# game/a15/9wedlia.rpy:534
translate english wedlia_1b321547:

    # gosti3 "Кто выпьет со мной?"
    gosti3 "谁和我喝？"

# game/a15/9wedlia.rpy:538
translate english wedlia2_396c128f:

    # "Час спустя."
    "一小时后。"

# game/a15/9wedlia.rpy:539
translate english wedlia2_da596869:

    # romna "...но вы уехали на Север."
    romna "……可您去了北方。"

# game/a15/9wedlia.rpy:540
translate english wedlia2_9a71b061:

    # me "Да. Появились срочные дела."
    me "对。有急事。"

# game/a15/9wedlia.rpy:541
translate english wedlia2_a4812d6e:

    # romna "Понимаю. Но вы ведь не отказываете нам в визите?"
    romna "我明白。但您不会拒绝我们的拜访吧？"

# game/a15/9wedlia.rpy:542
translate english wedlia2_8ee6a52e:

    # me "Не отказываю."
    me "不会。"

# game/a15/9wedlia.rpy:543
translate english wedlia2_4b7ff719:

    # romna "Но вы не можете назвать точную дату."
    romna "但您说不出确切日期。"

# game/a15/9wedlia.rpy:544
translate english wedlia2_ad288837:

    # me "Не могу. Сейчас мне точно не до разъездов по лордам."
    me "不能。现在我没空拜访领主们。"

# game/a15/9wedlia.rpy:545
translate english wedlia2_9029a066:

    # romna "Но..."
    romna "但……"

# game/a15/9wedlia.rpy:546
translate english wedlia2_ba7f2226:

    # me "Лорд Лаггариус может сам спросить меня об этом. Не обязательно посылать свою дочь."
    me "拉加里乌斯领主可以自己问我。没必要派女儿来。"

# game/a15/9wedlia.rpy:547
translate english wedlia2_56dc1764:

    # romna "Надеюсь вы не оскорблены, мой принц."
    romna "希望您没被冒犯，我的王子。"

# game/a15/9wedlia.rpy:548
translate english wedlia2_eb70de15:

    # me "Нет. Но передайте отцу - я посещу его замок, как только появится возможность. А сейчас такой возможности нет."
    me "没有。但转告你父亲——一有机会我就去他的城堡。而现在没有这个机会。"

# game/a15/9wedlia.rpy:549
translate english wedlia2_adafb9d0:

    # romna "Конечно. Я передам."
    romna "当然。我会转告。"

# game/a15/9wedlia.rpy:550
translate english wedlia2_3066598f:

    # me "Спасибо."
    me "谢谢。"

# game/a15/9wedlia.rpy:551
translate english wedlia2_aaf550cb:

    # romna "Я не буду вам более докучать. До встречи, принц [mename]."
    romna "我不再打扰您了。再会，[mename]王子。"

# game/a15/9wedlia.rpy:554
translate english wedlia2_48ade1a7:

    # elin "Почему каждый раз, когда я тебя вижу, с тобой рядом новая... леди."
    elin "为什么每次见到你，你身边都有新的……女士。"

# game/a15/9wedlia.rpy:555
translate english wedlia2_95a82117:

    # me "И тебе привет, сестренка."
    me "也向你问好，妹妹。"

# game/a15/9wedlia.rpy:556
translate english wedlia2_4b0fbb74:

    # lockhart "Рад видеть вас, принц [mename]."
    lockhart "很高兴见到您，[mename]王子。"

# game/a15/9wedlia.rpy:557
translate english wedlia2_7ae96991:

    # me "Здравствуй, Локхарт."
    me "你好，洛克哈特。"

# game/a15/9wedlia.rpy:558
translate english wedlia2_82a33ef9:

    # elin "Кто это?"
    elin "那是谁？"

# game/a15/9wedlia.rpy:559
translate english wedlia2_069070d0:

    # me "Ровна. Дочь лорда Лаггариуса."
    me "罗姆娜。拉加里乌斯领主的女儿。"

# game/a15/9wedlia.rpy:560
translate english wedlia2_24fadfc5:

    # elin "И что она хотела?"
    elin "她想要什么？"

# game/a15/9wedlia.rpy:561
translate english wedlia2_f7e1f9e5:

    # me "Звала посетить их родовой замок."
    me "邀请我去他们的祖传城堡。"

# game/a15/9wedlia.rpy:562
translate english wedlia2_fac47ed1:

    # elin "И ты, конечно же, согласился."
    elin "你当然答应了。"

# game/a15/9wedlia.rpy:563
translate english wedlia2_9527c1ab:

    # me "Нет. Решил, что для дипломатического визита сойдет и принцесса."
    me "没有。我觉得公主也够进行一次外交拜访了。"

# game/a15/9wedlia.rpy:564
translate english wedlia2_46e98711:

    # lockhart "О. Было бы здорово."
    lockhart "哦。那会很好。"

# game/a15/9wedlia.rpy:565
translate english wedlia2_23f2453c:

    # elin "Нет. Мы никуда не поедем. У нас ребенок."
    elin "不。我们哪儿也不去。我们有孩子。"

# game/a15/9wedlia.rpy:566
translate english wedlia2_4e196bd4:

    # me "Ребенка можно оставить."
    me "孩子可以留下。"

# game/a15/9wedlia.rpy:567
translate english wedlia2_e7596023:

    # lockhart "Она начала произносить звуки, представляете? Хотя доктора сказали, что она глухонемая."
    lockhart "她开始发声了，你能想象吗？虽然医生说她聋哑。"

# game/a15/9wedlia.rpy:568
translate english wedlia2_9be732c8:

    # elin "Он знает. В смысле... я ему уже рассказала."
    elin "他知道。我是说……我已经告诉他了。"

# game/a15/9wedlia.rpy:570
translate english wedlia2_d10313e6:

    # me "А по-моему хорошая идея. Съездите — расслабитесь. Говорят родовой замок Лейном в очень живописном месте."
    me "我觉得这主意不错。去一趟——放松一下。据说莱恩家族的祖传城堡在非常风景如画的地方。"

# game/a15/9wedlia.rpy:571
translate english wedlia2_71b42d2c:

    # elin "Не могу... мне нужно следить за ребенком."
    elin "我不能……我得照看孩子。"

# game/a15/9wedlia.rpy:572
translate english wedlia2_6e979dd5:

    # me "Няни прекрасно за ним проследят."
    me "保姆会照看得很好。"

# game/a15/9wedlia.rpy:573
translate english wedlia2_ac252681:

    # elin "Я им не доверяю."
    elin "我不信任她们。"

# game/a15/9wedlia.rpy:574
translate english wedlia2_08bcb890:

    # me "А с кем Селина сейчас?"
    me "那塞琳娜现在和谁在一起？"

# game/a15/9wedlia.rpy:575
translate english wedlia2_6b382cfb:

    # elin "Ну это... другое. Есть разница. Так я недалеко от нее, а не в далёком замке."
    elin "那是……另一回事。有区别。这样我离她不远，而不是在一座遥远城堡里。"

# game/a15/9wedlia.rpy:576
translate english wedlia2_7b874578:

    # lockhart "Я могу побыть с ней. Если ты переживаешь."
    lockhart "我可以陪着她。如果你担心的话。"

# game/a15/9wedlia.rpy:577
translate english wedlia2_890ca2dc:

    # elin "Ну я..."
    elin "嗯我……"

# game/a15/9wedlia.rpy:578
translate english wedlia2_dba5e5c1:

    # me "Кто-нибудь должен будет съездить к Лейнам. Иначе они так и продолжат наседать на меня всей семьей."
    me "总得有人去莱恩家一趟。否则他们会继续全家一起缠着我。"

# game/a15/9wedlia.rpy:579
translate english wedlia2_94f955f9:

    # lockhart "Что скажешь, [elin]?"
    lockhart "你怎么说，[elin]？"

# game/a15/9wedlia.rpy:580
translate english wedlia2_b5823e7c:

    # elin "Ну... может быть. Но ненадолго. Может... принц [mename] поедет вместе со мной?"
    elin "嗯……也许吧。但不会太久。也许……[mename]王子和我一起去？"

# game/a15/9wedlia.rpy:581
translate english wedlia2_3820771a:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:582
translate english wedlia2_c9ac19f2:

    # elin "Ну... просто чтобы показаться там. Погостишь так, для приличия, пару дней и вернешься. А я, так и быть, погощу у них подольше."
    elin "嗯……只是去露个面。客套地待几天就回去。而我，就勉为其难在他们那儿多待一阵。"

# game/a15/9wedlia.rpy:583
translate english wedlia2_f499f4c0:

    # lockhart "Неплохая идея. Ты должна отдохнуть, милая."
    lockhart "主意不错。你该休息一下，亲爱的。"

# game/a15/9wedlia.rpy:584
translate english wedlia2_5d95f3ab:

    # elin "Да...я... спасибо, Локхарт. Так... что думаешь, [mename]? Визит и принца и принцессы точно обрадует Лейнов."
    elin "对……我……谢谢，洛克哈特。那么……你怎么想，[mename]？王子和公主一起去拜访，莱恩家肯定会很高兴。"

# game/a15/9wedlia.rpy:585
translate english wedlia2_1a2461be:

    # me "...я подумаю над этим."
    me "……我会考虑的。"

# game/a15/9wedlia.rpy:586
translate english wedlia2_5ba8400d:

    # lockhart "Подумайте оба. А пока - надо поздравить твою сестру, [elin]."
    lockhart "你们都想想。不过现在——得去祝贺你妹妹了，[elin]。"

# game/a15/9wedlia.rpy:587
translate english wedlia2_b9737bb1:

    # elin "Да. Да... конечно. Пойдем."
    elin "对。对……当然。走吧。"

# game/a15/9wedlia.rpy:590
translate english wedlia2_f2eb658c:

    # elin "Приветствую, [mename]."
    elin "问候你，[mename]。"

# game/a15/9wedlia.rpy:591
translate english wedlia2_e8526d9b:

    # me "[elin]. Локхарт."
    me "[elin]。洛克哈特。"

# game/a15/9wedlia.rpy:592
translate english wedlia2_a9216839:

    # lockhart "Принц [mename]."
    lockhart "[mename]王子。"

# game/a15/9wedlia.rpy:593
translate english wedlia2_a42e07d6:

    # elin "Ты... ты даже не зашел, чтобы сказать, что прибыл."
    elin "你……你甚至没来告诉我你回来了。"

# game/a15/9wedlia.rpy:594
translate english wedlia2_de643d7f:

    # me "Прости. Не было времени."
    me "抱歉。没时间。"

# game/a15/9wedlia.rpy:595
translate english wedlia2_083fb5a2:

    # elin "На питие вина и разговоры с девушками у тебя время есть."
    elin "喝酒和跟姑娘们说话，你倒有时间。"

# game/a15/9wedlia.rpy:596
translate english wedlia2_75ad435b:

    # me "И я рад тебя видеть."
    me "我也很高兴见到你。"

# game/a15/9wedlia.rpy:597
translate english wedlia2_817e7026:

    # elin "...как твоя поездка? Надеюсь все хорошо?"
    elin "……你的旅程怎么样？希望一切都好？"

# game/a15/9wedlia.rpy:598
translate english wedlia2_03bae7a8:

    # me "Да, я..."
    me "对，我……"

# game/a15/9wedlia.rpy:599
translate english wedlia2_bc61a739:

    # elin "Вот и славно."
    elin "那就好。"

# game/a15/9wedlia.rpy:600
translate english wedlia2_e86dc4fb:

    # lockhart "Говорят, вы добирались верхом? Через чумные города..."
    lockhart "听说您是骑马回来的？穿过瘟疫城市……"

# game/a15/9wedlia.rpy:601
translate english wedlia2_da222be2:

    # elin "Локхарт, у принца [mename] нет на нас времени."
    elin "洛克哈特，[mename]王子没时间理我们。"

# game/a15/9wedlia.rpy:602
translate english wedlia2_7d58d472:

    # me "Я сейчас свободен."
    me "我现在有空。"

# game/a15/9wedlia.rpy:603
translate english wedlia2_642d38ee:

    # elin "Ну что вы, принц, похоже вы очень занятой человек, не будем отнимать ни секунды вашего драгоценного времени."
    elin "哪里，王子，看来您是个大忙人，我们就不占用您宝贵的时间了。"

# game/a15/9wedlia.rpy:604
translate english wedlia2_9ac49b0d:

    # me "[elin]..."
    me "[elin]……"

# game/a15/9wedlia.rpy:605
translate english wedlia2_ac4390e6:

    # elin "Пойдем, Локхарт, нужно еще поздравить мою сестру."
    elin "走吧，洛克哈特，还得去祝贺我妹妹。"

# game/a15/9wedlia.rpy:606
translate english wedlia2_f7809653:

    # lockhart "Эм... ну... до встречи, [mename]."
    lockhart "呃……嗯……再会，[mename]。"

# game/a15/9wedlia.rpy:607
translate english wedlia2_50457e62:

    # elin "Да. До встречи, [mename]. Надеюсь в вашем забитом графике найдется для нас время и в следующий раз мы встретимся не в следующем году."
    elin "对。再会，[mename]。希望您排满的日程里能给我们留点时间，下次见面别是明年。"

# game/a15/9wedlia.rpy:608
translate english wedlia2_3820771a_1:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:609
translate english wedlia2_a751d608:

    # elin "Мы уходим, Локхарт. За мной."
    elin "我们走了，洛克哈特。跟我来。"

# game/a15/9wedlia.rpy:611
translate english wedlia2_b93ec7aa:

    # shipman "Принц, [mename]."
    shipman "[mename]王子。"

# game/a15/9wedlia.rpy:612
translate english wedlia2_03bae7a8_1:

    # me "Да, я..."
    me "对，我……"

# game/a15/9wedlia.rpy:613
translate english wedlia2_599410e5:

    # shipman "Я пришёл сообщить..."
    shipman "我来报告……"

# game/a15/9wedlia.rpy:614
translate english wedlia2_2b635632:

    # me "Вообще-то я покинул пир, чтобы ни с кем не разговаривать. Буду честен - сейчас я бы хотел попить вина наедине с собой."
    me "其实我离开宴席就是为了不跟任何人说话。老实说——现在我只想独自喝点酒。"

# game/a15/9wedlia.rpy:615
translate english wedlia2_a700286e:

    # shipman "Понимаю. И все же..."
    shipman "我明白。不过……"

# game/a15/9wedlia.rpy:616
translate english wedlia2_ccca4715:

    # me "Свадьба сегодня не у меня. Нет смысла у меня ничего просить."
    me "今天又不是我的婚礼。求我也没用。"

# game/a15/9wedlia.rpy:617
translate english wedlia2_40c8997d:

    # shipman "Я ничего и не собирался просить."
    shipman "我也没打算求什么。"

# game/a15/9wedlia.rpy:618
translate english wedlia2_f3392580:

    # me "А зачем вы..."
    me "那您为什么……"

# game/a15/9wedlia.rpy:619
translate english wedlia2_54c1cc03:

    # shipman "У меня новости по кораблям, что сожгли в Хельвике."
    shipman "我有关于赫尔维克被烧船只的消息。"

# game/a15/9wedlia.rpy:620
translate english wedlia2_a2f0270d:

    # me "Ох... простите меня. Я думал вы один из просителей."
    me "哦……请原谅。我以为您是来求助的。"

# game/a15/9wedlia.rpy:622
translate english wedlia2_7f944397:

    # shipman "Все нормально. Я понимаю."
    shipman "没事。我理解。"

# game/a15/9wedlia.rpy:623
translate english wedlia2_05dda27d:

    # me "Так... что там по итогу?"
    me "那么……结果如何？"

# game/a15/9wedlia.rpy:624
translate english wedlia2_d0e71bbf:

    # shipman "Корабли починили. Борис Дубовицкий все оплатил."
    shipman "船修好了。鲍里斯·杜博维茨基付了全部费用。"

# game/a15/9wedlia.rpy:625
translate english wedlia2_c719263f:

    # me "Нашли тех, кто это сделал?"
    me "找到干这事的人了吗？"

# game/a15/9wedlia.rpy:626
translate english wedlia2_7fff7528:

    # shipman "Нет, мой принц."
    shipman "没有，我的王子。"

# game/a15/9wedlia.rpy:627
translate english wedlia2_b5617c5e:

    # me "Ох..."
    me "哦……"

# game/a15/9wedlia.rpy:628
translate english wedlia2_d39570c4:

    # shipman "Но кое-что все же нашли. Мы готовили корабли к зимовке - вырубали лед слоями, чтобы оставить киль в ледяной чаше."
    shipman "但还是发现了些东西。我们在为船只过冬做准备——分层凿冰，把龙骨留在冰碗里。"

# game/a15/9wedlia.rpy:629
translate english wedlia2_105c388e:

    # shipman "И случайно заметили рядом с кораблем горшок. Он бы утонул, но перед тем, как упасть в воду, он набрал воздух и остался на поверхности. Так и вмерз в лед."
    shipman "偶然发现船边有个罐子。它本该沉下去，但落水前灌了空气，浮在水面上。就这样冻进了冰里。"

# game/a15/9wedlia.rpy:630
translate english wedlia2_2325fa76:

    # me "И что?"
    me "然后呢？"

# game/a15/9wedlia.rpy:631
translate english wedlia2_12ee6fcd:

    # shipman "Внутри были следы каменного масла."
    shipman "里面有石油的痕迹。"

# game/a15/9wedlia.rpy:632
translate english wedlia2_b65ac3dc:

    # me "Кровь гор..."
    me "群山之血……"

# game/a15/9wedlia.rpy:633
translate english wedlia2_08e2b57a:

    # shipman "Она горит даже в воде. Видимо те, кто подпалили корабли, использовали горшки с этой дрянью."
    shipman "它在水里也能燃烧。看来烧船的人用了装这玩意儿的罐子。"

# game/a15/9wedlia.rpy:634
translate english wedlia2_dd8b92c2:

    # me "Этим каменным маслом пользуется кто-то кроме дворфов?"
    me "除了矮人，还有人用这种石油吗？"

# game/a15/9wedlia.rpy:635
translate english wedlia2_598ef1ed:

    # shipman "Я не знаю никого, кроме них, кто собирает эту дрянь."
    shipman "除了他们，我不知道还有谁会收集这玩意儿。"

# game/a15/9wedlia.rpy:636
translate english wedlia2_bb342479:

    # me "Может кто-то захотел их подставить?"
    me "也许有人想栽赃他们？"

# game/a15/9wedlia.rpy:637
translate english wedlia2_8ae00ab2:

    # shipman "Зачем тогда выбрасывали горшок за борт?"
    shipman "那为什么把罐子扔下船？"

# game/a15/9wedlia.rpy:638
translate english wedlia2_a4d676e1:

    # me "Но я не понимаю, зачем дворфам сжигать мои корабли, это чушь какая-то."
    me "但我不明白矮人为什么要烧我的船，这太荒唐了。"

# game/a15/9wedlia.rpy:639
translate english wedlia2_c5ca1794:

    # shipman "Я не знаю, мой принц."
    shipman "我不知道，我的王子。"

# game/a15/9wedlia.rpy:640
translate english wedlia2_f585feb9:

    # me "Ты следовал за мной?"
    me "你一路跟着我吗？"

# game/a15/9wedlia.rpy:641
translate english wedlia2_499d7489:

    # shipman "Мы чуть-чуть разминулись. Когда я прибыл в Совиный Камень вы уже как несколько дней были в дороге."
    shipman "我们稍微错过了。等我到猫头鹰岩时，您已经上路好几天了。"

# game/a15/9wedlia.rpy:642
translate english wedlia2_9a167ff7:

    # me "Ладно... спасибо за информацию."
    me "好吧……谢谢你告诉我。"

# game/a15/9wedlia.rpy:643
translate english wedlia2_ebbecb4f:

    # shipman "Вы дадите золота на обратную дорогу?"
    shipman "您能给点回去路上的金子吗？"

# game/a15/9wedlia.rpy:644
translate english wedlia2_2855d050:

    # me "Конечно. Я оплачу вашу дорогу и вашу внимательность."
    me "当然。我会支付你们的路费和你们的细心。"

# game/a15/9wedlia.rpy:645
translate english wedlia2_4757e62d:

    # shipman "Спасибо, мой принц."
    shipman "谢谢，我的王子。"

# game/a15/9wedlia.rpy:648
translate english wedlia2_5d990763:

    # me "Как там [lia], она уже отправилась раздавать милостыню?"
    me "[lia]怎么样了，她出发去施舍了吗？"

# game/a15/9wedlia.rpy:649
translate english wedlia2_2446b89e:

    # fake_cass "Кхм-кхм."
    fake_cass "咳咳。"

# game/a15/9wedlia.rpy:650
translate english wedlia2_eb655f0d:

    # me "[cass]?"
    me "[cass]？"

# game/a15/9wedlia.rpy:651
translate english wedlia2_7daf42a5:

    # fake_cass "Да... наверное."
    fake_cass "对……大概吧。"

# game/a15/9wedlia.rpy:652
translate english wedlia2_457d6f07:

    # me "Наверное? Ты же идешь оттуда."
    me "大概？你刚从那边过来。"

# game/a15/9wedlia.rpy:653
translate english wedlia2_ed7b070a:

    # fake_cass "Да. Как раз все собираются у ворот."
    fake_cass "对。大家正聚在门口。"

# game/a15/9wedlia.rpy:654
translate english wedlia2_4f4dc3d7:

    # me "А ты куда идешь?"
    me "那你去哪儿？"

# game/a15/9wedlia.rpy:655
translate english wedlia2_68af6c69:

    # fake_cass "С ними. Раздавать милостыню."
    fake_cass "和他们一起。去施舍。"

# game/a15/9wedlia.rpy:656
translate english wedlia2_de2d5f09:

    # me "Ты? Милостыню? Что с твоим голосом?"
    me "你？施舍？你声音怎么了？"

# game/a15/9wedlia.rpy:657
translate english wedlia2_c0734c53:

    # fake_cass "..."
    fake_cass "……"

# game/a15/9wedlia.rpy:659
translate english wedlia2_7d48c4cc:

    # me "Стой."
    me "站住。"

# game/a15/9wedlia.rpy:660
translate english wedlia2_b1cfd9e1:

    # fake_cass "Пусти меня."
    fake_cass "放开我。"

# game/a15/9wedlia.rpy:661
translate english wedlia2_bca3ddfc:

    # me "Эй. Да ты вообще не [cass]."
    me "喂。你根本不是[cass]。"

# game/a15/9wedlia.rpy:662
translate english wedlia2_23399f20:

    # fake_cass "Тише! Пожалуйста."
    fake_cass "小声点！求你了。"

# game/a15/9wedlia.rpy:663
translate english wedlia2_aa350d7a:

    # me "Ты кто такая?"
    me "你是谁？"

# game/a15/9wedlia.rpy:664
translate english wedlia2_5fe38c4b:

    # fake_cass "Если тебе дорога [cass], говори тише."
    fake_cass "如果你在乎[cass]，就小声点。"

# game/a15/9wedlia.rpy:666
translate english wedlia2_56ffc4ea:

    # me "{size=+5}Ух... ты такая красивая сегодня. Не признал. Прости. Выглядишь шикарно, [cass].{/size}"
    me "{size=+5}哦……你今天真美。我没认出来。抱歉。你看起来棒极了，[cass]。{/size}"

# game/a15/9wedlia.rpy:667
translate english wedlia2_d2720f59:

    # me "{size=-5}Ну? Так в чем дело... [cass]?{/size}"
    me "{size=-5}那么？到底怎么回事……[cass]？{/size}"

# game/a15/9wedlia.rpy:668
translate english wedlia2_37fc4579:

    # fake_cass "{size=-5}Твоя сестра попросила меня...{/size}"
    fake_cass "{size=-5}你妹妹求我……{/size}"

# game/a15/9wedlia.rpy:669
translate english wedlia2_a9aed9e2:

    # me "{size=-5}Это я уже понял. Сомневаюсь, что кто-то станет наряжаться в мою сестру просто так.{/size}"
    me "{size=-5}这我明白了。我不信有人会平白扮成我妹妹。{/size}"

# game/a15/9wedlia.rpy:670
translate english wedlia2_18c0cbe1:

    # fake_cass "{size=-5}Сегодня идеальный день.{/size}"
    fake_cass "{size=-5}今天是完美的日子。{/size}"

# game/a15/9wedlia.rpy:671
translate english wedlia2_d38af7ae:

    # me "{size=-5}Для чего?{/size}"
    me "{size=-5}做什么？{/size}"

# game/a15/9wedlia.rpy:672
translate english wedlia2_78cd0a06:

    # fake_cass "{size=-5}Для побега.{/size}"
    fake_cass "{size=-5}逃跑。{/size}"

# game/a15/9wedlia.rpy:673
translate english wedlia2_40712645:

    # me "{size=-5}От кого она бежит?{/size}"
    me "{size=-5}她在躲谁？{/size}"

# game/a15/9wedlia.rpy:674
translate english wedlia2_244359c0:

    # fake_cass "{size=-5}Сам знаешь.{/size}"
    fake_cass "{size=-5}你自己知道。{/size}"

# game/a15/9wedlia.rpy:675
translate english wedlia2_6970c4bc:

    # me "{size=-5}Золотой Порядок?{/size}"
    me "{size=-5}黄金秩序？{/size}"

# game/a15/9wedlia.rpy:676
translate english wedlia2_118093f6:

    # fake_cass "{size=-5}Лорд Леонард. Вчера Трибунал вынес обвинительный вердикт ее дяде.{/size}"
    fake_cass "{size=-5}莱昂纳德领主。昨天法庭对她叔叔作出了有罪判决。{/size}"

# game/a15/9wedlia.rpy:677
translate english wedlia2_07229132:

    # me "{size=-5}Гуран? Он что-нибудь признавал?{/size}"
    me "{size=-5}古兰？他承认了什么吗？{/size}"

# game/a15/9wedlia.rpy:678
translate english wedlia2_8a274cde:

    # fake_cass "{size=-5}Видимо да. Раз ваша сестра решила сбежать.{/size}"
    fake_cass "{size=-5}看来是。既然你妹妹决定逃跑。{/size}"

# game/a15/9wedlia.rpy:679
translate english wedlia2_2ed018e6:

    # me "{size=-5}Почему она меня не предупредила?{/size}"
    me "{size=-5}她为什么不提前告诉我？{/size}"

# game/a15/9wedlia.rpy:680
translate english wedlia2_3ac05c01:

    # fake_cass "{size=-5}Я не знаю.{/size}"
    fake_cass "{size=-5}我不知道。{/size}"

# game/a15/9wedlia.rpy:681
translate english wedlia2_1c422366:

    # me "{size=-5}Где она сейчас?{/size}"
    me "{size=-5}她现在在哪儿？{/size}"

# game/a15/9wedlia.rpy:682
translate english wedlia2_f1968d9e:

    # fake_cass "{size=-5}Вы уверены?{/size}"
    fake_cass "{size=-5}您确定？{/size}"

# game/a15/9wedlia.rpy:683
translate english wedlia2_ebac11aa:

    # me "{size=+5}Да, [cass], я хочу это знать.{/size}"
    me "{size=+5}是的，[cass]，我想知道。{/size}"

# game/a15/9wedlia.rpy:684
translate english wedlia2_7df1183f:

    # fake_cass "{size=-5}Ну ладно-ладно.{/size}"
    fake_cass "{size=-5}好吧好吧。{/size}"

# game/a15/9wedlia.rpy:686
translate english wedlia2_0f476a5d:

    # "Чуть позже."
    "稍后。"

# game/a15/9wedlia.rpy:687
translate english wedlia2_1b310f51:

    # cass "Тише... тише..."
    cass "轻点……轻点……"

# game/a15/9wedlia.rpy:688
translate english wedlia2_bfb432b0:

    # cass "Тише говорю, мать вашу, вы чего такие беспокойные. Я пришла взять одну из вас для небольшой прогулки. Я что, похожа на волка?"
    cass "我说轻点，妈的，你们怎么这么不安分。我是来带你们其中一个出去散散步。我看起来像狼吗？"

# game/a15/9wedlia.rpy:689
translate english wedlia2_e56594cc:

    # cass "Так... этот слишком большой... быстро выдохнется... эта слишком мелкая... будет уставать под моим весом."
    cass "那么……这匹太大了……很快会累垮……这匹太小了……驮我会累。"

# game/a15/9wedlia.rpy:690
translate english wedlia2_d8ffe461:

    # cass "Вот ты... ты приятель в самый раз."
    cass "你……你正合适，伙计。"

# game/a15/9wedlia.rpy:691
translate english wedlia2_b38c5c2f:

    # cass "Ну... тише... тише, мальчик."
    cass "好了……轻点……轻点，小子。"

# game/a15/9wedlia.rpy:692
translate english wedlia2_04822a0f:

    # cass "Или девочка. У меня нет времени смотреть на твои гениталии, прости."
    cass "或者丫头。我没时间看你的生殖器，抱歉。"

# game/a15/9wedlia.rpy:694
translate english wedlia2_6b7e24ee:

    # me "Ну и как это понимать?"
    me "这该怎么解释？"

# game/a15/9wedlia.rpy:695
translate english wedlia2_897b3de8:

    # cass "Ух ты, сука! [mename], ты меня напугал! Ты как сюда попал?"
    cass "哎呀，操！[mename]，你吓死我了！你怎么进来的？"

# game/a15/9wedlia.rpy:696
translate english wedlia2_27dc78d9:

    # me "Так же как и ты. Перешагнул через пьяного конюха. Признаться честно, я сначала подумал, что ты его убила."
    me "和你一样。跨过那个醉倒的马夫。老实说，我一开始以为你杀了他。"

# game/a15/9wedlia.rpy:697
translate english wedlia2_67e0f459:

    # cass "Если бы он не был так охоч до бутылки - возможно мне бы пришлось."
    cass "如果他不那么贪杯——也许我就得动手了。"

# game/a15/9wedlia.rpy:698
translate english wedlia2_eb655f0d_1:

    # me "[cass]?"
    me "[cass]？"

# game/a15/9wedlia.rpy:699
translate english wedlia2_c2487b65:

    # cass "Что?"
    cass "什么？"

# game/a15/9wedlia.rpy:700
translate english wedlia2_489998a1:

    # me "Что ты делаешь?"
    me "你在做什么？"

# game/a15/9wedlia.rpy:701
translate english wedlia2_9f82a243:

    # cass "Сматываюсь отсюда, на что это еще похоже?"
    cass "从这儿溜走，还能像什么？"

# game/a15/9wedlia.rpy:702
translate english wedlia2_6a41a210:

    # me "Даже не поговорив со мной?"
    me "都不和我谈谈？"

# game/a15/9wedlia.rpy:703
translate english wedlia2_8c9632d1:

    # cass "Прости, это некрасиво, но ты мог бы меня выдать."
    cass "抱歉，这不好看，但你可能把我供出去。"

# game/a15/9wedlia.rpy:704
translate english wedlia2_672a5a4c:

    # me "Ты серьезно?"
    me "你是认真的？"

# game/a15/9wedlia.rpy:705
translate english wedlia2_69081e7b:

    # cass "Я имею в виду неспециально. Пошел бы просить отца меня помиловать, это бы услышали лорды и... ну ты понял."
    cass "我是指无意的。你要是去求父亲赦免我，领主们会听到，然后……你懂的。"

# game/a15/9wedlia.rpy:706
translate english wedlia2_a865e420:

    # me "Так я в твоем плане побега - помеха."
    me "所以我在你的逃跑计划里是个障碍。"

# game/a15/9wedlia.rpy:707
translate english wedlia2_ddf3d953:

    # cass "Ну прости."
    cass "抱歉。"

# game/a15/9wedlia.rpy:708
translate english wedlia2_3820771a_2:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:709
translate english wedlia2_4548fa73:

    # cass "Как ты понял? Ярвель не слишком на меня похожа?"
    cass "你怎么看出来的？雅维尔不太像我吗？"

# game/a15/9wedlia.rpy:710
translate english wedlia2_9fcabb08:

    # me "Похожа. Но только внешне. Ведет она себя не как [cass]."
    me "像。只是外表像。她的举止不像[cass]。"

# game/a15/9wedlia.rpy:711
translate english wedlia2_0fd1ec19:

    # cass "У меня не было много времени на ее обучение."
    cass "我没多少时间训练她。"

# game/a15/9wedlia.rpy:713
translate english wedlia2_4de1a534:

    # me "Что ты сделала со своими волосами?"
    me "你对你的头发做了什么？"

# game/a15/9wedlia.rpy:714
translate english wedlia2_9c1220e7:

    # cass "Остригла их."
    cass "剪了。"

# game/a15/9wedlia.rpy:715
translate english wedlia2_7332342b:

    # me "Зачем?"
    me "为什么？"

# game/a15/9wedlia.rpy:716
translate english wedlia2_b906a287:

    # cass "Чтобы не быть похожей на себя. Зачем еще?"
    cass "为了不像自己。还能为什么？"

# game/a15/9wedlia.rpy:717
translate english wedlia2_72689ac8:

    # me "[cass], ты слишком бурно реагируешь."
    me "[cass]，你反应太激烈了。"

# game/a15/9wedlia.rpy:718
translate english wedlia2_ae475615:

    # cass "[mename], послушай меня, твои люди не могут меня вечно охранять. Их слишком мало. Замок кишит золотыми плащами."
    cass "[mename]，听我说。你的人不能永远保护我。他们太少了。城堡里全是金斗篷。"

# game/a15/9wedlia.rpy:719
translate english wedlia2_e03db930:

    # me "Но..."
    me "但……"

# game/a15/9wedlia.rpy:720
translate english wedlia2_eb32793b:

    # cass "Мой дядя арестован. Все мои люди - арестованы. Вчера Трибунал доказал их вину. А еще эти мертвые оракулы... Это дело времени, когда они возьмутся за меня."
    cass "我叔叔被捕了。我所有人——都被捕了。昨天法庭证明了他们的罪。还有那些死去的先知……他们迟早会来找我。"

# game/a15/9wedlia.rpy:721
translate english wedlia2_43d7111f:

    # me "Мы можем переиграть их."
    me "我们可以反败为胜。"

# game/a15/9wedlia.rpy:722
translate english wedlia2_b5b49679:

    # cass "Как?"
    cass "怎么？"

# game/a15/9wedlia.rpy:723
translate english wedlia2_b5aa74ec:

    # me "Как-нибудь. Что-нибудь придумаем."
    me "总有办法。我们会想出点什么。"

# game/a15/9wedlia.rpy:724
translate english wedlia2_8351ecc4:

    # cass "Может быть придумали бы. Но для этого нужно время и свобода действий. У меня нет ни того, ни другого. Леонард не остановится, пока моя голова не окажется на плахе."
    cass "也许能想出。但那需要时间和行动自由。我两样都没有。莱昂纳德不把我的头放上断头台是不会停的。"

# game/a15/9wedlia.rpy:725
translate english wedlia2_5ee92eee:

    # me "Попросим отца..."
    me "我们求父亲……"

# game/a15/9wedlia.rpy:726
translate english wedlia2_56323bf2:

    # cass "И что? Надеяться на его милость? А если он не простит меня?"
    cass "然后呢？指望他的仁慈？如果他不原谅我呢？"

# game/a15/9wedlia.rpy:727
translate english wedlia2_dff18bb2:

    # me "Меня он простил."
    me "他原谅了我。"

# game/a15/9wedlia.rpy:728
translate english wedlia2_3ef073d9:

    # cass "Против тебя нет никаких доказательств. Все было совершено мной и моими людьми. Слово нашего отца - спасет тебя, но не спасет меня."
    cass "没有对你不利的证据。一切都是我和我的人做的。我们父亲的话能救你，但救不了我。"

# game/a15/9wedlia.rpy:729
translate english wedlia2_a2a5f477:

    # cass "А даже если и спасет - это навлечет и на тебя и на отца гнев вассалов."
    cass "就算能救——也会把附庸们的怒火引到你和父亲身上。"

# game/a15/9wedlia.rpy:730
translate english wedlia2_7395e524:

    # cass "К сожалению справедливый. Я не хочу рушить то, что у нас так хорошо получается строить."
    cass "遗憾的是，这怒火是公正的。我不想毁掉我们正建造得那么好的东西。"

# game/a15/9wedlia.rpy:731
translate english wedlia2_3820771a_3:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:732
translate english wedlia2_5b370764:

    # cass "Сейчас это единственный выход. Перетерпеть. Пересидеть и переждать."
    cass "现在这是唯一的办法。忍耐。躲一阵，等一等。"

# game/a15/9wedlia.rpy:733
translate english wedlia2_3447cadd:

    # cass "И ты это знаешь. Иди сюда."
    cass "你知道的。过来。"

# game/a15/9wedlia.rpy:736
translate english wedlia2_59273ea6:

    # me "{i}Эх... она права.{/i}"
    me "{i}唉……她说得对。{/i}"

# game/a15/9wedlia.rpy:737
translate english wedlia2_090a8d43:

    # me "{i}Как же неудачно сложились все обстоятельства.{/i}"
    me "{i}一切怎么就这么不巧。{/i}"

# game/a15/9wedlia.rpy:738
translate english wedlia2_f7bae3fd:

    # me "{i}Если бы сын лорда Леонарда не попытался сбежать...{/i}"
    me "{i}如果莱昂纳德领主之子没试图逃跑……{/i}"

# game/a15/9wedlia.rpy:739
translate english wedlia2_def965ec:

    # me "{i}Бездна... ничего этого бы сейчас не было.{/i}"
    me "{i}深渊……现在就不会有这些事。{/i}"

# game/a15/9wedlia.rpy:740
translate english wedlia2_d1ea0cfd:

    # me "{i}Теперь я не знаю, когда увижу [cass] в следующий раз.{/i}"
    me "{i}现在我不知道下次见到[cass]是什么时候。{/i}"

# game/a15/9wedlia.rpy:741
translate english wedlia2_cfd3ffb6:

    # me "{i}Я добыл Империи корону Запада, но не могу защитить одного человека.{/i}"
    me "{i}我为帝国赢得了西方王冠，却保护不了一个人。{/i}"

# game/a15/9wedlia.rpy:742
translate english wedlia2_5c76dbe7:

    # me "{i}...{/i}"
    me "{i}……{/i}"

# game/a15/9wedlia.rpy:743
translate english wedlia2_e7a8255c:

    # me "{i}Вернее могу, но он этой защиты не желает.{/i}"
    me "{i}或者说我能，但她不要这种保护。{/i}"

# game/a15/9wedlia.rpy:744
translate english wedlia2_8c9ec0c3:

    # me "{i}Может она и права. Сейчас единство Империи важнее.{/i}"
    me "{i}也许她是对的。现在帝国的统一更重要。{/i}"

# game/a15/9wedlia.rpy:745
translate english wedlia2_62cdd265:

    # me "{i}К тому же ей есть куда бежать.{/i}"
    me "{i}而且她有地方可逃。{/i}"

# game/a15/9wedlia.rpy:746
translate english wedlia2_768c504f:

    # me "{i}И все же... все же мне тяжело ее отпускать.{/i}"
    me "{i}但我还是……还是很难放她走。{/i}"

# game/a15/9wedlia.rpy:747
translate english wedlia2_8e3de0fd:

    # me "{i}Но видимо другого выбора нет.{/i}"
    me "{i}但看来别无选择。{/i}"

# game/a15/9wedlia.rpy:749
translate english wedlia2_0e158ca4:

    # cass "Вот. Держи. Последняя узнаваемая деталь моего образа."
    cass "给。拿着。我形象最后一件可辨认的东西。"

# game/a15/9wedlia.rpy:750
translate english wedlia2_039c377d:

    # me "Думаешь камень в глазу обличает тебя меньше?"
    me "你觉得眼里的石头暴露你更少？"

# game/a15/9wedlia.rpy:751
translate english wedlia2_e6d12761:

    # cass "Не волнуйся, я достану и его."
    cass "别担心，那个我也会取出来。"

# game/a15/9wedlia.rpy:752
translate english wedlia2_4435675c:

    # me "Куда ты едешь? На Запад. В Черную Косу?"
    me "你去哪儿？西方。黑镰？"

# game/a15/9wedlia.rpy:753
translate english wedlia2_221c818d:

    # cass "Других мест, где я могу спрятаться, нет."
    cass "没有别的地方能让我藏身。"

# game/a15/9wedlia.rpy:754
translate english wedlia2_eefd98c3:

    # me "Думаешь Леонард об этом не знает?"
    me "你觉得莱昂纳德不知道？"

# game/a15/9wedlia.rpy:755
translate english wedlia2_86b7d37d:

    # cass "Уверена, что знает."
    cass "我确定他知道。"

# game/a15/9wedlia.rpy:756
translate english wedlia2_6ca0a88e:

    # me "Он может отправиться за тобой."
    me "他可能会追你。"

# game/a15/9wedlia.rpy:757
translate english wedlia2_19c1c1a8:

    # cass "Удачи с поисками. Найти меня в Черной Косе ему не помогут даже боги."
    cass "祝他搜捕顺利。在黑镰找我，连神都帮不了他。"

# game/a15/9wedlia.rpy:758
translate english wedlia2_3820771a_4:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:759
translate english wedlia2_a6013d27:

    # cass "Зато он легко там найдет свою смерть."
    cass "不过他在那儿很容易找到自己的死路。"

# game/a15/9wedlia.rpy:761
translate english wedlia2_688d3e83:

    # me "В Долине могут быть люди лорда Лаггариуса."
    me "山谷里可能有拉加里乌斯领主的人。"

# game/a15/9wedlia.rpy:762
translate english wedlia2_5b13c7e3:

    # cass "Я знаю. Я буду осторожна. Буду двигаться только по ночам."
    cass "我知道。我会小心。只在夜里赶路。"

# game/a15/9wedlia.rpy:764
translate english wedlia2_001d58f5:

    # me "В Долине могут быть люди лорда Пойнаса."
    me "山谷里可能有珀纳斯领主的人。"

# game/a15/9wedlia.rpy:765
translate english wedlia2_5b13c7e3_1:

    # cass "Я знаю. Я буду осторожна. Буду двигаться только по ночам."
    cass "我知道。我会小心。只在夜里赶路。"

# game/a15/9wedlia.rpy:767
translate english wedlia2_f8a90e6e:

    # me "В Долине опасно."
    me "山谷很危险。"

# game/a15/9wedlia.rpy:768
translate english wedlia2_ccc6d7b2:

    # cass "Я знаю. Я буду осторожна."
    cass "我知道。我会小心。"

# game/a15/9wedlia.rpy:769
translate english wedlia2_3820771a_5:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:770
translate english wedlia2_21188456:

    # cass "Здесь для меня точно опаснее, чем в Долине."
    cass "这里对我来说肯定比山谷更危险。"

# game/a15/9wedlia.rpy:771
translate english wedlia2_8e064a46:

    # me "Ты... дашь мне знак, что ты добралась и с тобой все в порядке?"
    me "你……会给我个信号，告诉我你到了、你没事吗？"

# game/a15/9wedlia.rpy:772
translate english wedlia2_62b12c1e:

    # cass "Дам, конечно. Помоги залезть на лошадь."
    cass "当然会。帮我上马。"

# game/a15/9wedlia.rpy:774
translate english wedlia2_be57cb2d:

    # me "Ну и что это будет за знак?"
    me "那会是什么信号？"

# game/a15/9wedlia.rpy:775
translate english wedlia2_61709443:

    # cass "Ну... не знаю. Может ворон?"
    cass "嗯……不知道。也许是乌鸦？"

# game/a15/9wedlia.rpy:776
translate english wedlia2_3582f7b4:

    # me "Ворон? Ты пришлешь ворона."
    me "乌鸦？你会送来一只乌鸦。"

# game/a15/9wedlia.rpy:777
translate english wedlia2_ddce981a:

    # cass "Ворон это условный знак - увидишь что-то с ним связанное, где-то, где его быть не должно, и все поймешь."
    cass "乌鸦是个暗号——看到和它有关的东西，出现在不该出现的地方，你就会明白。"

# game/a15/9wedlia.rpy:778
translate english wedlia2_cdc855ab:

    # me "...хорошо. Что если я не увижу этот знак?"
    me "……好。如果我没看到这个信号呢？"

# game/a15/9wedlia.rpy:779
translate english wedlia2_8aa247b7:

    # cass "Значит я мертва."
    cass "那就说明我死了。"

# game/a15/9wedlia.rpy:780
translate english wedlia2_bf3e0682:

    # me "[cass]..."
    me "[cass]……"

# game/a15/9wedlia.rpy:781
translate english wedlia2_1b348033:

    # cass "Со мной все будет в порядке. Лучше побеспокойся о своих детях."
    cass "我会没事的。还是操心你的孩子们吧。"

# game/a15/9wedlia.rpy:782
translate english wedlia2_47fd9bca:

    # me "У меня он один."
    me "我只有一个。"

# game/a15/9wedlia.rpy:783
translate english wedlia2_3c381f80:

    # cass "Два. Империя нуждается в тебе ничуть не меньше, чем [sonname]."
    cass "两个。帝国需要你不亚于[sonname]需要你。"

# game/a15/9wedlia.rpy:784
translate english wedlia2_3820771a_6:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:785
translate english wedlia2_3c8854b3:

    # cass "Все будет хорошо, [mename]. Не печалься, мы еще встретимся, обещаю."
    cass "一切都会好的，[mename]。别难过，我们还会再见的，我保证。"

# game/a15/9wedlia.rpy:786
translate english wedlia2_7c5f3fab:

    # me "Не смей это обещание нарушать. Или я буду преследовать тебя в посмертии, ясно?"
    me "不许违背这个承诺。否则我会在死后追着你，明白吗？"

# game/a15/9wedlia.rpy:787
translate english wedlia2_33935cc4:

    # cass "Ясно. До встречи, мой маленький братик-принц."
    cass "明白。再会，我的小王子弟弟。"

# game/a15/9wedlia.rpy:788
translate english wedlia2_2350dac5:

    # cass "Ворота открылись для процессии нашей младшей сестры. Другого шанса не будет."
    cass "城门为我们妹妹的游行队伍打开了。不会再有别的机会。"

# game/a15/9wedlia.rpy:789
translate english wedlia2_3351e52b:

    # me "Понимаю. До встречи, [cass]."
    me "我明白。再会，[cass]。"

# game/a15/9wedlia.rpy:790
translate english wedlia2_2c39e431:

    # cass "До встречи, мой маленький братик-принц."
    cass "再会，我的小王子弟弟。"

# game/a15/9wedlia.rpy:792
translate english wedlia2_396c128f_1:

    # "Час спустя."
    "一小时后。"

# game/a15/9wedlia.rpy:793
translate english wedlia2_18230881:

    # me "Моя сестра еще не вернулась?"
    me "我妹妹还没回来吗？"

# game/a15/9wedlia.rpy:794
translate english wedlia2_969a1a19:

    # slug "Нет. Она и другая знать празднуют с простолюдинами."
    slug "没有。她和其他贵族正和平民一起庆祝。"

# game/a15/9wedlia.rpy:795
translate english wedlia2_00d68cd0:

    # me "Серьезно?"
    me "当真？"

# game/a15/9wedlia.rpy:796
translate english wedlia2_df9ad723:

    # slug "Похоже ваша сестра вознамерена стать любимицей горожан."
    slug "看来您妹妹打算成为市民的宠儿。"

# game/a15/9wedlia.rpy:797
translate english wedlia2_3820771a_7:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:798
translate english wedlia2_50a1828b:

    # slug "Уверена, что это безопасно. С ней две сотни гвардейцев."
    slug "我确定这很安全。两百名卫兵跟着她。"

# game/a15/9wedlia.rpy:799
translate english wedlia2_4036747e:

    # me "Все, хватит."
    me "够了。"

# game/a15/9wedlia.rpy:800
translate english wedlia2_efe0085d:

    # slug "Мне сходить еще за кувшином?"
    slug "要再去拿一壶吗？"

# game/a15/9wedlia.rpy:801
translate english wedlia2_2fa944bb:

    # me "А в этом что-то осталось?"
    me "这壶里还有吗？"

# game/a15/9wedlia.rpy:802
translate english wedlia2_5b18d8ee:

    # slug "Да."
    slug "有。"

# game/a15/9wedlia.rpy:803
translate english wedlia2_8d42a2b6:

    # me "Тогда пока не нужно."
    me "那暂时不用。"

# game/a15/9wedlia.rpy:806
translate english wedlia2_feb8cd71:

    # callah "[mename]. Друг мой."
    callah "[mename]。我的朋友。"

# game/a15/9wedlia.rpy:807
translate english wedlia2_1e0f6fc5:

    # me "Рад тебя видеть."
    me "很高兴见到你。"

# game/a15/9wedlia.rpy:808
translate english wedlia2_0770e61f:

    # callah "И я. Как добрался домой?"
    callah "我也是。回家路上怎么样？"

# game/a15/9wedlia.rpy:809
translate english wedlia2_d03718c3:

    # me "Не без трудностей."
    me "并非没有困难。"

# game/a15/9wedlia.rpy:810
translate english wedlia2_81511da4:

    # callah "О. Уверен у тебя есть пара новых потрясающих историй."
    callah "哦。我相信你有几个新的惊人故事。"

# game/a15/9wedlia.rpy:811
translate english wedlia2_254a38e7:

    # me "Разве что потрясающе опасных."
    me "顶多是惊人地危险。"

# game/a15/9wedlia.rpy:812
translate english wedlia2_35beaac0:

    # callah "Это самые интересные."
    callah "那才最有趣。"

# game/a15/9wedlia.rpy:813
translate english wedlia2_8469021f:

    # me "Присоединяйся."
    me "加入吧。"

# game/a15/9wedlia.rpy:814
translate english wedlia2_b36e0b9c:

    # callah "С удовольствием."
    callah "乐意。"

# game/a15/9wedlia.rpy:816
translate english wedlia2_79d82858:

    # "Десять минут спустя."
    "十分钟后。"

# game/a15/9wedlia.rpy:818
translate english wedlia2_a8fbf3e8:

    # callah "Чудесное серебро, да? Говорят спасает от вампиров."
    callah "好银器，对吧？据说能防吸血鬼。"

# game/a15/9wedlia.rpy:819
translate english wedlia2_60dc8705:

    # me "Чушь."
    me "胡说。"

# game/a15/9wedlia.rpy:820
translate english wedlia2_903a45ce:

    # callah "Полная."
    callah "完全是胡说。"

# game/a15/9wedlia.rpy:821
translate english wedlia2_dde4b619:

    # me "Так что насчёт Острожского?"
    me "那奥斯特罗日斯基呢？"

# game/a15/9wedlia.rpy:822
translate english wedlia2_7d237c7b:

    # callah "Прости, я не контактирую с сородичами. Я понятия не имею, правильно ли он опасается за свою жизнь или просто сошел с ума."
    callah "抱歉，我不和同类来往。我完全不知道他为性命担忧是否正确，还是只是疯了。"

# game/a15/9wedlia.rpy:823
translate english wedlia2_4366e696:

    # me "Ладно..."
    me "好吧……"

# game/a15/9wedlia.rpy:824
translate english wedlia2_69a02be1:

    # callah "А что твоя подруга? Все следит за тобой?"
    callah "你那位女友呢？还在盯着你？"

# game/a15/9wedlia.rpy:825
translate english wedlia2_3820771a_8:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:826
translate english wedlia2_c93b89ec:

    # callah "Да ладно тебе. Я ее чувствую."
    callah "得了吧。我能感觉到她。"

# game/a15/9wedlia.rpy:827
translate english wedlia2_f2d360b5:

    # me "Значит следит."
    me "那就是在盯着。"

# game/a15/9wedlia.rpy:828
translate english wedlia2_d0b48eca:

    # callah "Понятно."
    callah "明白了。"

# game/a15/9wedlia.rpy:830
translate english wedlia2_ccc1f143:

    # callah "Чудесное вино. И кубки... Произведение искусства."
    callah "好酒。还有杯子……艺术品。"

# game/a15/9wedlia.rpy:831
translate english wedlia2_fc30fd2b:

    # me "Да."
    me "对。"

# game/a15/9wedlia.rpy:832
translate english wedlia2_9a5e633f:

    # callah "У лорда Лартуа определенно есть вкус."
    callah "拉尔图阿领主确实有品味。"

# game/a15/9wedlia.rpy:833
translate english wedlia2_ab7b72d5:

    # me "С этим не поспоришь."
    me "这没法反驳。"

# game/a15/9wedlia.rpy:834
translate english wedlia2_8a73a68a:

    # me "Я хотел поговорить о Золотом Порядке. И о том, кто его защищает."
    me "我想谈谈黄金秩序。还有谁在守护它。"

# game/a15/9wedlia.rpy:836
translate english wedlia2_528e190a:

    # callah "А что о нем говорить?"
    callah "有什么可谈的？"

# game/a15/9wedlia.rpy:837
translate english wedlia2_d0ad1384:

    # me "Я думал... ты захочешь сохранить свою власть и кольца."
    me "我以为……你想保住自己的权力和戒指。"

# game/a15/9wedlia.rpy:838
translate english wedlia2_27445d31:

    # callah "Моя власть гарантирована принцем-регентом. Ты больше не принц-регент."
    callah "我的权力由摄政王子保障。你不再是摄政王子了。"

# game/a15/9wedlia.rpy:839
translate english wedlia2_eb0d474a:

    # me "Верно."
    me "没错。"

# game/a15/9wedlia.rpy:840
translate english wedlia2_912250eb:

    # callah "Так что ты от меня хочешь? "
    callah "那你想从我这儿要什么？"

# game/a15/9wedlia.rpy:841
translate english wedlia2_548d95f9:

    # me "Знаешь, в ту ночь ты был более... амбициозен."
    me "你知道，那晚你更有……野心。"

# game/a15/9wedlia.rpy:842
translate english wedlia2_eb200917:

    # callah "В ту ночь ты сказал мне, что твой отец мертв."
    callah "那晚你告诉我你父亲死了。"

# game/a15/9wedlia.rpy:843
translate english wedlia2_f509ca9b:

    # me "Я сказал, что он отравлен."
    me "我说他被下毒了。"

# game/a15/9wedlia.rpy:844
translate english wedlia2_d557e1db:

    # callah "В любом случае - обстоятельства изменились."
    callah "不管怎样——情况变了。"

# game/a15/9wedlia.rpy:845
translate english wedlia2_7d6b1e88:

    # callah "К тому же сам Император одобрил расширение гвардии."
    callah "而且皇帝本人批准了卫队的扩充。"

# game/a15/9wedlia.rpy:846
translate english wedlia2_66f55b51:

    # me "Ты больше не..."
    me "你不再是……"

# game/a15/9wedlia.rpy:847
translate english wedlia2_147dcde1:

    # callah "Конечно нет. Совет снова воссоздан."
    callah "当然不是。议会已经重建。"

# game/a15/9wedlia.rpy:848
translate english wedlia2_30790aba:

    # me "И ты его часть?"
    me "而你是其中一员？"

# game/a15/9wedlia.rpy:849
translate english wedlia2_971c2f52:

    # callah "Да."
    callah "对。"

# game/a15/9wedlia.rpy:850
translate english wedlia2_a5980f64:

    # me "И как тебе это удалось?"
    me "你是怎么做到的？"

# game/a15/9wedlia.rpy:851
translate english wedlia2_7dc7b660:

    # callah "Так же, как мне однажды удалось занять все места сразу - я удивительно лоялен."
    callah "就像我曾一度同时占下所有席位一样——我出奇地忠诚。"

# game/a15/9wedlia.rpy:852
translate english wedlia2_a62521c3:

    # me "А что насчёт расследования Трибунала?"
    me "那法庭的调查呢？"

# game/a15/9wedlia.rpy:854
translate english wedlia2_591ee2ff:

    # callah "Я бы не волновался на этот счет."
    callah "我不会担心这个。"

# game/a15/9wedlia.rpy:855
translate english wedlia2_c3006c9e:

    # me "Но я все же волнуюсь."
    me "但我还是担心。"

# game/a15/9wedlia.rpy:856
translate english wedlia2_0a144cf1:

    # callah "[mename], я вступил с тобой в сговор. Зачем мне оговаривать тебя?"
    callah "[mename]，我和你有密约。我为什么要告发你？"

# game/a15/9wedlia.rpy:857
translate english wedlia2_b4804848:

    # me "И все же я должен был удостовериться в твоей разумности и лояльности."
    me "不过我还是得确认你的理智和忠诚。"

# game/a15/9wedlia.rpy:858
translate english wedlia2_27a84195:

    # callah "Я лоялен Империи. Но разум мой все еще достаточно крепок, чтобы понимать, что никакой пользы от меня не будет, если я буду в темнице."
    callah "我忠于帝国。但我的头脑还足够清醒，知道如果我进了地牢，就对谁都没用。"

# game/a15/9wedlia.rpy:859
translate english wedlia2_717cbd93:

    # me "А если я буду мертв?"
    me "如果我死了呢？"

# game/a15/9wedlia.rpy:860
translate english wedlia2_bd4b548a:

    # callah "Мы помазаны одной кровью. Кровью твоей сестры. Не существует обстоятельств, при которых я бы стал свидетельствовать против себя самого."
    callah "我们被同一血脉涂膏。你妹妹的血。没有任何情况会让我作证害自己。"

# game/a15/9wedlia.rpy:861
translate english wedlia2_819e96e3:

    # me "Может ты и не станешь. Но такие обстоятельства существуют."
    me "也许你不会。但这种情况是存在的。"

# game/a15/9wedlia.rpy:862
translate english wedlia2_9d61e7cc:

    # callah "Например."
    callah "比如。"

# game/a15/9wedlia.rpy:863
translate english wedlia2_c8b3ee6a:

    # me "Например попытка защитить семью."
    me "比如试图保护家人。"

# game/a15/9wedlia.rpy:864
translate english wedlia2_e037afd4:

    # callah "У меня нет семьи."
    callah "我没有家人。"

# game/a15/9wedlia.rpy:867
translate english wedlia2_30ed8c81:

    # me "А как же твой брат?"
    me "那你兄弟呢？"

# game/a15/9wedlia.rpy:869
translate english wedlia2_e7c765d1:

    # callah "Кто?"
    callah "谁？"

# game/a15/9wedlia.rpy:870
translate english wedlia2_2325c59e:

    # me "Твой брат. Или [cass] его убила и ты поэтому так был так рад вступить со мной в сговор."
    me "你兄弟。或者[cass]杀了他，所以你才那么高兴和我密谋。"

# game/a15/9wedlia.rpy:871
translate english wedlia2_e3c5738d:

    # callah "Какой еще брат?"
    callah "什么兄弟？"

# game/a15/9wedlia.rpy:872
translate english wedlia2_8bd4c874:

    # me "Роуэн... или как-то так."
    me "罗文……或者差不多这样。"

# game/a15/9wedlia.rpy:873
translate english wedlia2_c435dba7:

    # callah "У меня никогда не было братьев, [mename]."
    callah "我从来没有兄弟，[mename]。"

# game/a15/9wedlia.rpy:874
translate english wedlia2_3820771a_9:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:875
translate english wedlia2_0480b287:

    # callah "Откуда ты вообще это взял?"
    callah "你从哪儿听来的？"

# game/a15/9wedlia.rpy:876
translate english wedlia2_2e78a1f2:

    # me "Да так... похоже шутка прямиком из бездны."
    me "没什么……看来是个直接从深渊来的玩笑。"

# game/a15/9wedlia.rpy:877
translate english wedlia2_e09419e1:

    # callah "В каком смысле?"
    callah "什么意思？"

# game/a15/9wedlia.rpy:878
translate english wedlia2_a686081e:

    # me "А двоюродные братья? Никто из них не женился?"
    me "那堂兄弟呢？他们没人结婚？"

# game/a15/9wedlia.rpy:879
translate english wedlia2_61cd1700:

    # callah "У меня и двоюродных братьев нет. Я последний мужчина в семье."
    callah "我也没有堂兄弟。我是家里最后一个男人。"

# game/a15/9wedlia.rpy:880
translate english wedlia2_3820771a_10:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:881
translate english wedlia2_3012faa8:

    # callah "Так кто тебе это рассказал?"
    callah "那是谁告诉你的？"

# game/a15/9wedlia.rpy:882
translate english wedlia2_9daad802:

    # me "Забудь. Приятного вечера, Каллахан."
    me "算了。晚上愉快，卡拉汉。"

# game/a15/9wedlia.rpy:883
translate english wedlia2_90723130:

    # callah "Приятного вечера, [mename]."
    callah "晚上愉快，[mename]。"

# game/a15/9wedlia.rpy:886
translate english wedlia2_01822020:

    # me "Ладно."
    me "好吧。"

# game/a15/9wedlia.rpy:887
translate english wedlia2_f388d784:

    # callah "Я свободен от твоих подозрений хотя бы на время?"
    callah "至少暂时我能摆脱你的怀疑了吗？"

# game/a15/9wedlia.rpy:888
translate english wedlia2_20a8c00c:

    # me "На время."
    me "暂时。"

# game/a15/9wedlia.rpy:889
translate english wedlia2_697b2749:

    # callah "Я этому рад. Хорошего вечера, принц [mename]."
    callah "我很高兴。晚上好，[mename]王子。"

# game/a15/9wedlia.rpy:890
translate english wedlia2_97631802:

    # me "Хорошего вечера, Каллахан."
    me "晚上好，卡拉汉。"

# game/a15/9wedlia.rpy:894
translate english wedlia2_c2e929bf:

    # arcadia "...когда ты станешь старше, я обязательно тебя отпущу."
    arcadia "……等你大一点，我一定放你出去。"

# game/a15/9wedlia.rpy:895
translate english wedlia2_441c1113:

    # arc_son "Все дети Императора уже замужем. Больше свадеб не будет."
    arc_son "皇帝的孩子都结婚了。不会再有婚礼了。"

# game/a15/9wedlia.rpy:896
translate english wedlia2_79619167:

    # arcadia "Будут и другие празднества."
    arcadia "还会有别的庆典。"

# game/a15/9wedlia.rpy:897
translate english wedlia2_2c30f578:

    # arc_son "Какие например?"
    arc_son "比如什么？"

# game/a15/9wedlia.rpy:898
translate english wedlia2_d145c449:

    # arcadia "Какие угодно. Балы, коронации, рождения детей. Не волнуйся. Ты еще сможешь нагуляться."
    arcadia "什么都行。舞会、加冕、孩子出生。别担心。你还有得玩。"

# game/a15/9wedlia.rpy:899
translate english wedlia2_3b154358:

    # arc_son "Я просто не понимаю, почему я не могу пойти с остальными?"
    arc_son "我就是不明白为什么不能和别人一起去？"

# game/a15/9wedlia.rpy:900
translate english wedlia2_bf1efe60:

    # arcadia "Потому что ты еще слишком юн."
    arcadia "因为你还太年轻。"

# game/a15/9wedlia.rpy:901
translate english wedlia2_60f2e9af:

    # arc_son "В моем возрасте становятся рыцарями!"
    arc_son "我这年纪都当骑士了！"

# game/a15/9wedlia.rpy:902
translate english wedlia2_2376dcd7:

    # arcadia "Ты об этом в книге прочитал?"
    arcadia "你从书里看来的？"

# game/a15/9wedlia.rpy:903
translate english wedlia2_78d92fa7:

    # arc_son "Может быть..."
    arc_son "也许吧……"

# game/a15/9wedlia.rpy:904
translate english wedlia2_b11e3677:

    # arcadia "Ладно. Если хочешь - можешь остаться на пире после полуночи."
    arcadia "好吧。如果你愿意——午夜后可以留在宴会上。"

# game/a15/9wedlia.rpy:905
translate english wedlia2_459a7608:

    # arc_son "Правда?"
    arc_son "真的？"

# game/a15/9wedlia.rpy:906
translate english wedlia2_d29373aa:

    # arcadia "Да. Как раз скоро невеста вернется из города."
    arcadia "对。新娘快从城里回来了。"

# game/a15/9wedlia.rpy:907
translate english wedlia2_5728b771:

    # arc_son "Могу я пойти один?"
    arc_son "我可以一个人去吗？"

# game/a15/9wedlia.rpy:908
translate english wedlia2_27be0a30:

    # arcadia "Иди."
    arcadia "去吧。"

# game/a15/9wedlia.rpy:910
translate english wedlia2_63c53f88:

    # arcadia "Принц [mename]. Рада вас видеть."
    arcadia "[mename]王子。很高兴见到您。"

# game/a15/9wedlia.rpy:911
translate english wedlia2_ef89e78a:

    # me "Леди Аркадия. Что? Трудности воспитания?"
    me "阿卡迪亚女士。怎么了？育儿的烦恼？"

# game/a15/9wedlia.rpy:912
translate english wedlia2_0037eb5a:

    # arcadia "Еще какие. Если бы знала как будет сложно, я бы отправилась на Восток вместо мужа."
    arcadia "可不是。早知道这么难，我就替丈夫去东方了。"

# game/a15/9wedlia.rpy:913
translate english wedlia2_7f6d67e6:

    # me "Ну вы вроде неплохо справляетесь."
    me "您看起来应付得还不错。"

# game/a15/9wedlia.rpy:914
translate english wedlia2_01e9b5b3:

    # arcadia "Как могу. Нынешняя молодежь - немного меня пугает. Я слышала на пиру такие разговоры, что если честно мне и самой страшно находиться без компании мужа."
    arcadia "尽力而为。现在的年轻人——让我有点害怕。我在宴会上听到一些话，说实话，没有丈夫陪着我自己都害怕。"

# game/a15/9wedlia.rpy:915
translate english wedlia2_1bea9e8e:

    # me "Уверен с вашим сыном все будет в порядке."
    me "我相信您儿子会没事的。"

# game/a15/9wedlia.rpy:916
translate english wedlia2_68457fc3:

    # arcadia "Здесь хотя бы он под присмотром. Надеюсь самые буйные осядут в тавернах и борделях по пути обратно."
    arcadia "至少在这里他有人看着。希望最闹腾的那些回去路上会留在酒馆和妓院里。"

# game/a15/9wedlia.rpy:917
translate english wedlia2_c1164a65:

    # me "Я бы не был так уверен. Молитесь чтобы они не вернулись с простолюдинами в обнимку."
    me "我不会那么确定。祈祷他们别搂着平民回来吧。"

# game/a15/9wedlia.rpy:918
translate english wedlia2_63b37654:

    # arcadia "Не пугайте меня, принц. Кстати, как ваша дипломатическая поездка?"
    arcadia "别吓我，王子。顺便问一句，您的外交之行怎么样？"

# game/a15/9wedlia.rpy:919
translate english wedlia2_9cb374da:

    # me "О... это долгая история."
    me "哦……说来话长。"

# game/a15/9wedlia.rpy:920
translate english wedlia2_4b1d6ca7:

    # arcadia "Ночь длинная. Я готова послушать."
    arcadia "夜还长。我愿听。"

# game/a15/9wedlia.rpy:921
translate english wedlia2_d8540526:

    # me "Хорошо. Оставьте нам кувшин и принесите еще один."
    me "好。把这壶留下，再拿一壶来。"

# game/a15/9wedlia.rpy:922
translate english wedlia2_fd7d3022:

    # slug "Да, мой принц."
    slug "是，我的王子。"

# game/a15/9wedlia.rpy:924
translate english wedlia2_5249269a:

    # "Пятнадцать минут спустя."
    "十五分钟后。"

# game/a15/9wedlia.rpy:925
translate english wedlia2_5a87aedd:

    # me "...так что если не считать грязи и снега мы добрались без происшествий."
    me "……所以除了泥和雪，我们一路平安。"

# game/a15/9wedlia.rpy:926
translate english wedlia2_fa6791c3:

    # arcadia "Удивительно. У вас было целое приключение."
    arcadia "真不可思议。您整整经历了一场冒险。"

# game/a15/9wedlia.rpy:927
translate english wedlia2_12956f76:

    # me "Да. Но время в седле летит не очень интересно. Если вся жизнь наследного принца и будет состоять из бесконечных разъездов, боюсь я не замечу, как постарею."
    me "对。但马背上的时间过得并不有趣。如果王储的一生就是无尽奔波，我怕自己会不知不觉就老了。"

# game/a15/9wedlia.rpy:928
translate english wedlia2_a871b551:

    # arcadia "Благо ваша кровь немного это компенсирует."
    arcadia "幸好您的血脉能稍微弥补这一点。"

# game/a15/9wedlia.rpy:929
translate english wedlia2_bac31bd1:

    # me "Не знаю. По-моему, это ничего не компенсирует. К тому же у меня развивается страх лошадей."
    me "不知道。我觉得这什么都弥补不了。而且我开始怕马了。"

# game/a15/9wedlia.rpy:930
translate english wedlia2_25020529:

    # arcadia "Правда?"
    arcadia "真的？"

# game/a15/9wedlia.rpy:931
translate english wedlia2_c8cb87b4:

    # me "Правда-правда. Я до сих пор ощущаю седло под задницей."
    me "真的真的。我现在还感觉屁股底下有马鞍。"

# game/a15/9wedlia.rpy:932
translate english wedlia2_39547250:

    # arcadia "Уверен вашу высокородную задницу уже достаточно обласкали за этот вечер. Простите."
    arcadia "我相信您那高贵的屁股今晚已经被奉承够了。抱歉。"

# game/a15/9wedlia.rpy:933
translate english wedlia2_061e1774:

    # me "Нет. Все нормально. Но вообще я именно поэтому здесь и стою."
    me "不。没事。不过我正是因此才站在这儿。"

# game/a15/9wedlia.rpy:934
translate english wedlia2_994ea708:

    # arcadia "Не любите просителей?"
    arcadia "不喜欢求见的人？"

# game/a15/9wedlia.rpy:935
translate english wedlia2_635187db:

    # me "А кто их любит?"
    me "谁喜欢？"

# game/a15/9wedlia.rpy:936
translate english wedlia2_9e65b9ee:

    # arcadia "И то верно. А моя компания вас не раздражает?"
    arcadia "确实。那我的陪伴不惹您烦吗？"

# game/a15/9wedlia.rpy:937
translate english wedlia2_46cfc548:

    # me "Будьте уверены, если бы раздражала, я бы сказал."
    me "您放心，如果烦，我会说的。"

# game/a15/9wedlia.rpy:938
translate english wedlia2_94dafd37:

    # arcadia "...Вы повзрослели, принц."
    arcadia "……您长大了，王子。"

# game/a15/9wedlia.rpy:939
translate english wedlia2_eec717fb:

    # me "Называйте меня [mename]. Давайте без формальностей в этот прекрасный вечер."
    me "叫我[mename]。在这美好的夜晚，我们别拘礼。"

# game/a15/9wedlia.rpy:940
translate english wedlia2_7287a371:

    # arcadia "Ну ладно."
    arcadia "好吧。"

# game/a15/9wedlia.rpy:941
translate english wedlia2_2ce84a70:

    # me "Еще вина?"
    me "再来点酒？"

# game/a15/9wedlia.rpy:942
translate english wedlia2_4295f3b0:

    # arcadia "... а давайте."
    arcadia "……那就来吧。"

# game/a15/9wedlia.rpy:944
translate english wedlia2_83749a03:

    # "Полчаса спустя."
    "半小时后。"

# game/a15/9wedlia.rpy:945
translate english wedlia2_058bba1b:

    # arcadia "...так что я просто сказала, что если они хотят перевооружить гвардию - пусть сами и платят."
    arcadia "……所以我就说，如果他们想重新武装卫队——就自己掏钱。"

# game/a15/9wedlia.rpy:946
translate english wedlia2_8c5fdce5:

    # me "Так это ваших рук дело."
    me "原来是您的手笔。"

# game/a15/9wedlia.rpy:947
translate english wedlia2_0d932d3a:

    # arcadia "Моих? Нет, конечно. Все было решено и без меня. С тех пор как Преториус в отъезде, в совете правит лорд Леонард."
    arcadia "我的？当然不是。没有我也都决定了。自从普雷托里乌斯离开后，议会由莱昂纳德领主说了算。"

# game/a15/9wedlia.rpy:948
translate english wedlia2_76dfe8c5:

    # me "Тогда как вы убедили его заплатить?"
    me "那您怎么说服他掏钱的？"

# game/a15/9wedlia.rpy:949
translate english wedlia2_71d39b7b:

    # arcadia "Пришлось подключать все мое красноречие, ну и Каллахан немного помог. Я поставила лордов вашего отца в неудобное положение и они все же согласились потратиться."
    arcadia "不得不动用我所有的口才，卡拉汉也帮了点忙。我让你父亲的领主们陷入尴尬，他们还是同意花钱了。"

# game/a15/9wedlia.rpy:950
translate english wedlia2_a137173f:

    # me "Выходит вы сэкономили короне кучу золота."
    me "所以您为王室省了一大笔金子。"

# game/a15/9wedlia.rpy:951
translate english wedlia2_4ac22005:

    # arcadia "Ну не прям кучу..."
    arcadia "也没一大笔……"

# game/a15/9wedlia.rpy:952
translate english wedlia2_e2d53c58:

    # me "И все же. Этим должен заниматься Каллахан."
    me "但毕竟。这是卡拉汉该做的。"

# game/a15/9wedlia.rpy:953
translate english wedlia2_2b015b4e:

    # arcadia "Мы действуем с ним вместе. Особенно с тех пор как вы взяли в привычку отнимать у меня обязанности."
    arcadia "我和他一起做。尤其是自从您养成抢我职责的习惯后。"

# game/a15/9wedlia.rpy:954
translate english wedlia2_7b8abd12:

    # me "Простите!"
    me "抱歉！"

# game/a15/9wedlia.rpy:955
translate english wedlia2_5f4044f8:

    # arcadia "Я шучу. Но переговоры с Западными лордами всегда одинаковы."
    arcadia "我开玩笑。但和西方领主的谈判总是一样。"

# game/a15/9wedlia.rpy:956
translate english wedlia2_982008d5:

    # me "Они просят золота на восстановление?"
    me "他们请求金子重建？"

# game/a15/9wedlia.rpy:957
translate english wedlia2_f30b1a05:

    # arcadia "Они просят золото на восстановление."
    arcadia "他们请求金子重建。"

# game/a15/9wedlia.rpy:958
translate english wedlia2_c29840f7:

    # me "Но вы, конечно, его не даете?"
    me "但您当然不给？"

# game/a15/9wedlia.rpy:959
translate english wedlia2_03b356c7:

    # arcadia "Моя работа делить их запросы надвое. Работа Каллахана делать так еще раз."
    arcadia "我的工作是把他们的请求减半。卡拉汉的工作是再减半。"

# game/a15/9wedlia.rpy:960
translate english wedlia2_4a1ac3e9:

    # me "Выходит, к вам сразу нужно идти с учетверёнными запросами."
    me "所以来找您，一开始就得把请求翻四倍。"

# game/a15/9wedlia.rpy:961
translate english wedlia2_84d008e7:

    # arcadia "Ха-ха. Похоже на то."
    arcadia "哈哈。看起来是。"

# game/a15/9wedlia.rpy:963
translate english wedlia2_46d54d6a:

    # arcadia "Ох, [mename], вы меня напоили."
    arcadia "哦，[mename]，您把我灌醉了。"

# game/a15/9wedlia.rpy:964
translate english wedlia2_072960bc:

    # me "Прямо уж."
    me "哪有。"

# game/a15/9wedlia.rpy:965
translate english wedlia2_2c007ecd:

    # arcadia "Нет, правда. Я давно столько не пила."
    arcadia "不，真的。我很久没喝这么多了。"

# game/a15/9wedlia.rpy:966
translate english wedlia2_a0d2c6af:

    # me "Не притворяйтесь. Я только и вижу вас с кубком. Вы с Каллаханом знатные любители вина."
    me "别装。我总看到您拿着杯子。您和卡拉汉可是出了名的爱酒。"

# game/a15/9wedlia.rpy:967
translate english wedlia2_f0909d5b:

    # arcadia "Есть разница между парой кубков в день и двумя кувшинами за час."
    arcadia "一天几杯和一小时两壶是有区别的。"

# game/a15/9wedlia.rpy:968
translate english wedlia2_fb7a6253:

    # me "Мы пили поровну."
    me "我们喝得一样多。"

# game/a15/9wedlia.rpy:969
translate english wedlia2_1571b593:

    # arcadia "Не дурите мне голову, принц. Я уже давно не та молодая дворянка, которую можно незаметно напоить дорогим вином."
    arcadia "别糊弄我，王子。我早不是那个能被人悄悄用贵酒灌醉的年轻贵族小姐了。"

# game/a15/9wedlia.rpy:970
translate english wedlia2_9407bc65:

    # me "Я вовсе..."
    me "我根本……"

# game/a15/9wedlia.rpy:971
translate english wedlia2_89f58efc:

    # arcadia "Вы подливали мне больше, чем себе."
    arcadia "您给我倒的比给自己多。"

# game/a15/9wedlia.rpy:972
translate english wedlia2_146338d4:

    # me "От вас ничего не утаить."
    me "什么都瞒不过您。"

# game/a15/9wedlia.rpy:973
translate english wedlia2_fe7565a2:

    # arcadia "Моя работа быть внимательной в любых ситуациях."
    arcadia "我的工作就是在任何情况下都保持警觉。"

# game/a15/9wedlia.rpy:974
translate english wedlia2_5685f67e:

    # me "В свое оправдание могу сказать, что я уже выпил четыре кубка до этого."
    me "为自己辩解，我之前已经喝了四杯。"

# game/a15/9wedlia.rpy:975
translate english wedlia2_4dd0b37f:

    # arcadia "Как вы до сих пор стоите на ногах?"
    arcadia "您怎么还站得住？"

# game/a15/9wedlia.rpy:976
translate english wedlia2_7543c0e7:

    # me "Я пил такую дрянь в Бригдоке, что Аранское Золотое для меня теперь как родниковая вода."
    me "我在布里格多克喝过那种烂东西，现在阿兰金酒对我来说就像泉水。"

# game/a15/9wedlia.rpy:977
translate english wedlia2_c6fe97cf:

    # arcadia "Ох, а я и забыла, что вы принц-разбойник."
    arcadia "哦，我忘了您是强盗王子。"

# game/a15/9wedlia.rpy:978
translate english wedlia2_19c117bf:

    # me "Разбойник?"
    me "强盗？"

# game/a15/9wedlia.rpy:979
translate english wedlia2_1cbe534c:

    # arcadia "Ну знаете? Так называют тех принцев, что ведут образ жизни мало похожий на образ жизни дворянина."
    arcadia "您知道的吧？那是形容那些生活方式不太像贵族的王子。"

# game/a15/9wedlia.rpy:980
translate english wedlia2_e2ea7a7d:

    # me "Это в прошлом. Теперь я самый нормальный и обычный, скучный принц."
    me "那是过去。现在我是最正常、最普通、最无聊的王子。"

# game/a15/9wedlia.rpy:981
translate english wedlia2_63faff0e:

    # arcadia "Но с перчинкой прошлой жизни."
    arcadia "但带着过去生活的一点辛辣。"

# game/a15/9wedlia.rpy:982
translate english wedlia2_e7daedbe:

    # me "С перчинкой?"
    me "辛辣？"

# game/a15/9wedlia.rpy:983
translate english wedlia2_2004d601:

    # arcadia "Ну знаете, самое обычное блюдо, но с малой долей необычного, несвойственного ему вкуса."
    arcadia "您知道的，最普通的菜，却带一点不属于它的、不寻常的味道。"

# game/a15/9wedlia.rpy:984
translate english wedlia2_87c0b3ac:

    # me "Такое кому-то нравится?"
    me "有人喜欢这样吗？"

# game/a15/9wedlia.rpy:985
translate english wedlia2_5aba1319:

    # arcadia "Наверняка."
    arcadia "肯定有。"

# game/a15/9wedlia.rpy:986
translate english wedlia2_ef69da85:

    # me "А вам нравится?"
    me "您喜欢吗？"

# game/a15/9wedlia.rpy:988
translate english wedlia2_52e24e9a:

    # arcadia "Я не могу отвечать на такие вопросы. Я жената."
    arcadia "我不能回答这种问题。我结婚了。"

# game/a15/9wedlia.rpy:989
translate english wedlia2_8c69a069:

    # me "Давно и счастливо?"
    me "很久且幸福？"

# game/a15/9wedlia.rpy:990
translate english wedlia2_4991ef4c:

    # arcadia "..."
    arcadia "……"

# game/a15/9wedlia.rpy:991
translate english wedlia2_d1e6e2e4:

    # me "Простите."
    me "抱歉。"

# game/a15/9wedlia.rpy:992
translate english wedlia2_5f6fa59d:

    # arcadia "Нет. Все нормально."
    arcadia "不。没事。"

# game/a15/9wedlia.rpy:993
translate english wedlia2_283e0475:

    # me "Точно? Я не хотел..."
    me "确定？我不是有意……"

# game/a15/9wedlia.rpy:994
translate english wedlia2_b8f8a14f:

    # arcadia "Это уже давно не причиняет мне боль. Слишком много времени прошло. Я давно это отрефлексировала."
    arcadia "这早就不让我痛苦了。时间过去太久了。我早就想通了。"

# game/a15/9wedlia.rpy:995
translate english wedlia2_8eec02fd:

    # me "Два года?"
    me "两年？"

# game/a15/9wedlia.rpy:996
translate english wedlia2_768db189:

    # arcadia "Почти четыре. Думаю надежды на возвращение нет."
    arcadia "快四年。我想没希望回来了。"

# game/a15/9wedlia.rpy:997
translate english wedlia2_443c3500:

    # me "Ну... всякое бывает."
    me "嗯……什么事都可能发生。"

# game/a15/9wedlia.rpy:998
translate english wedlia2_5f484f34:

    # arcadia "Ему негде было затеряться. На Востоке моряков не пускают дальше портов. Так что если он не вернулся - значит мертв."
    arcadia "他没地方可失踪。在东方，水手不许离开港口。所以如果他没回来——那就是死了。"

# game/a15/9wedlia.rpy:999
translate english wedlia2_d6e83f5b:

    # me "Может буря отнесла корабль куда-нибудь в неизведанные земли?"
    me "也许风暴把船吹到了某个未知之地？"

# game/a15/9wedlia.rpy:1000
translate english wedlia2_3f7474a4:

    # arcadia "Я чувствую себя на месте моего сына."
    arcadia "我觉得自己就像我儿子。"

# game/a15/9wedlia.rpy:1001
translate english wedlia2_5ac38cf1:

    # me "Почему?"
    me "为什么？"

# game/a15/9wedlia.rpy:1002
translate english wedlia2_22cf3d40:

    # arcadia "Вынуждена выслушивать самые нелепые объяснения на свете, вместо того, чтобы просто принять правду."
    arcadia "被迫听世上最荒唐的解释，而不是接受真相。"

# game/a15/9wedlia.rpy:1003
translate english wedlia2_3820771a_11:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:1004
translate english wedlia2_50f6edc1:

    # arcadia "Простите."
    arcadia "抱歉。"

# game/a15/9wedlia.rpy:1005
translate english wedlia2_19b9ff65:

    # me "Так вы смирились."
    me "所以您认命了。"

# game/a15/9wedlia.rpy:1006
translate english wedlia2_e1685f7f:

    # arcadia "Наверное."
    arcadia "大概吧。"

# game/a15/9wedlia.rpy:1007
translate english wedlia2_3820771a_12:

    # me "..."
    me "……"

# game/a15/9wedlia.rpy:1009
translate english wedlia2_7b91c8df:

