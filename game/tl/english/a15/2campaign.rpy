    eva "不……不是杀人……你能看我画画吗？"

# game/a15/2campaign.rpy:124
translate english campaign8_e55f056b:

    # me "Рисуешь? И все?"
    me "画画？就这些？"

# game/a15/2campaign.rpy:125
translate english campaign8_c995429d:

    # eva "Да..."
    eva "嗯……"

# game/a15/2campaign.rpy:126
translate english campaign8_a02ab402:

    # me "...ладно. Но только после того, как ты сделаешь то, что мне пообещала."
    me "……好吧。但得在你完成答应我的事之后。"

# game/a15/2campaign.rpy:127
translate english campaign8_393d0b69:

    # eva "Конечно... да..."
    eva "当然……好……"

# game/a15/2campaign.rpy:129
translate english campaign8_98478776:

    # me "В таком случае желаю удачи."
    me "那就祝你好运。"

# game/a15/2campaign.rpy:130
translate english campaign8_86bed2c8:

    # eva "И я тебе."
    eva "也祝你好运。"

# game/a15/2campaign.rpy:131
translate english campaign8_bb397530:

    # me "Мне она не понадобится. Я уже все сделал. Меня ожидают только последствия моих решений."
    me "我不需要。我已经做完了一切。等着我的只有我决定的后果。"

# game/a15/2campaign.rpy:132
translate english campaign8_acb64b04:

    # eva "[mename]?"
    eva "[mename]？"

# game/a15/2campaign.rpy:133
translate english campaign8_ad02f53a_2:

    # me "Что?"
    me "什么？"

# game/a15/2campaign.rpy:134
translate english campaign8_727f7918:

    # eva "Может, когда будем трахаться в следующий раз, придушишь меня?"
    eva "也许下次我们做爱时，你会掐我？"

# game/a15/2campaign.rpy:135
translate english campaign8_e9e73c45:

    # me "Сначала заслужи следующий раз."
    me "先争取到下次再说。"

# game/a15/2campaign.rpy:136
translate english campaign8_5989a02c:

    # eva "Ладно. Я буду полезной, обещаю."
    eva "好吧。我会有用的，我保证。"

# game/a15/2campaign.rpy:137
translate english campaign8_27918a1c:

    # me "Завтра посмотрим."
    me "明天看。"

# game/a15/2campaign.rpy:142
translate english campaign9_1fce5a74:

    # "Вечером."
    "傍晚。"

# game/a15/2campaign.rpy:143
translate english campaign9_618d3fd5:

    # ukradd "Гонец доставлял письма?"
    ukradd "信使送信来了吗？"

# game/a15/2campaign.rpy:144
translate english campaign9_e5250d70:

    # cold_guard "Еще нет, мой лорд."
    cold_guard "还没有，我的领主。"

# game/a15/2campaign.rpy:145
translate english campaign9_e7e604a7:

    # ukradd "А когда доставит?"
    ukradd "那什么时候送到？"

# game/a15/2campaign.rpy:146
translate english campaign9_9160cf7f:

    # cold_guard "Должен был сегодня, но наверное его задержала метель."
    cold_guard "本该今天到，但大概被暴风雪耽搁了。"

# game/a15/2campaign.rpy:147
translate english campaign9_b52e8560:

    # ukradd "Если придет письмо от моей жены - сообщите."
    ukradd "如果有我妻子的信——告诉我。"

# game/a15/2campaign.rpy:148
translate english campaign9_36010e5f:

    # cold_guard "Конечно, мой лорд."
    cold_guard "当然，我的领主。"

# game/a15/2campaign.rpy:150
translate english campaign9_82529f45:

    # ukradd "Ну? Кого там ветром занесло?"
    ukradd "怎么？风又把谁吹来了？"

# game/a15/2campaign.rpy:151
translate english campaign9_bfd7e9b7:

    # cold_guard "Мой лорд, это принц [mename]."
    cold_guard "我的领主，是[mename]王子。"

# game/a15/2campaign.rpy:152
translate english campaign9_23d2f225:

    # ukradd "Вижу, что не Церах."
    ukradd "我看得出不是策拉赫。"

# game/a15/2campaign.rpy:153
translate english campaign9_414c68c8:

    # me "Можем поговорить?"
    me "能谈谈吗？"

# game/a15/2campaign.rpy:154
translate english campaign9_c2fb993d:

    # cold_guard "Мой лорд, Король сказал..."
    cold_guard "我的领主，国王说过……"

# game/a15/2campaign.rpy:155
translate english campaign9_c0b7a661:

    # ukradd "Все нормально, уверен принц здесь не для того, чтобы оказывать на меня давление. Верно?"
    ukradd "没事。我确定王子来这里不是为了向我施压。对吧？"

# game/a15/2campaign.rpy:156
translate english campaign9_3dbd674e:

    # me "Разумеется."
    me "当然。"

# game/a15/2campaign.rpy:157
translate english campaign9_a90aa212:

    # ukradd "Пропусти."
    ukradd "让他进来。"

# game/a15/2campaign.rpy:158
translate english campaign9_421b9d41:

    # cold_guard "Да, мой лорд."
    cold_guard "是，我的领主。"

# game/a15/2campaign.rpy:160
translate english campaign9_d93db2fa:

    # ukradd "Сразу скажу - если ты пришел за моим голосом, то это бесполезно."
    ukradd "我直说——如果你是为我的票而来，那没用。"

# game/a15/2campaign.rpy:161
translate english campaign9_c4dfb201:

    # me "Почему же?"
    me "为什么？"

# game/a15/2campaign.rpy:162
translate english campaign9_6f251f79:

    # ukradd "Потому что я принимаю решения сам."
    ukradd "因为我自己做决定。"

# game/a15/2campaign.rpy:163
translate english campaign9_87f274ff:

    # me "Я и не собирался давить."
    me "我也没打算施压。"

# game/a15/2campaign.rpy:164
translate english campaign9_c801c153:

    # ukradd "А что ты хотел сделать? Подкупить меня? Шантажировать?"
    ukradd "那你想做什么？贿赂我？勒索我？"

# game/a15/2campaign.rpy:165
translate english campaign9_7e726320:

    # me "Вас есть чем шантажировать, лорд Украдский?"
    me "有什么能勒索您的吗，乌克拉德斯基领主？"

# game/a15/2campaign.rpy:166
translate english campaign9_201f745f:

    # ukradd "Не знаю, это ты мне скажи."
    ukradd "不知道，你告诉我。"

# game/a15/2campaign.rpy:167
translate english campaign9_3cba0540:

    # me "Думаю, что вы достаточно благопристойны, чтобы этого не бояться."
    me "我认为您足够端正，不必害怕这种事。"

# game/a15/2campaign.rpy:168
translate english campaign9_46e072d1:

    # ukradd "А если бы не был, ты бы стал этим пользоваться?"
    ukradd "如果我不是呢，你会利用吗？"

# game/a15/2campaign.rpy:169
translate english campaign9_3820771a:

    # me "..."
    me "……"

# game/a15/2campaign.rpy:170
translate english campaign9_56dc19f4:

    # me "Возможно и стал бы. Зависит от того, что это был бы за компромат и смог бы я договориться другими способами."
    me "也许会。取决于那是什么样的把柄，以及我能否用其他方式达成协议。"

# game/a15/2campaign.rpy:171
translate english campaign9_a51d781e:

    # ukradd "Ну... меня радует, что вы со мной честны. Но как я уже и сказал - я приму решение сам."
    ukradd "嗯……我很高兴您对我坦诚。但如我所说——我会自己做决定。"

# game/a15/2campaign.rpy:172
translate english campaign9_fd3ad84a:

    # me "...точно сами?"
    me "……完全自己做？"

# game/a15/2campaign.rpy:173
translate english campaign9_a3498a70:

    # ukradd "Вы что-то хотите сказать, мой принц?"
    ukradd "您想说什么吗，我的王子？"

# game/a15/2campaign.rpy:174
translate english campaign9_bbafcb63:

    # me "В этом самостоятельном принятии решения не будет руки вашего короля?"
    me "在您这个自主决定里，不会有您国王的手吗？"

# game/a15/2campaign.rpy:175
translate english campaign9_583036a8:

    # ukradd "Будет. Но там будете и вы. И ты, и Борис - внешние обстоятельства. Но могу уверить тебя, Король Севера влияет на мое решение не больше, чем принц Золотой Империи."
    ukradd "会有。但你也在。你和鲍里斯都是外部因素。但我可以向你保证，北方之王对我的决定的影响，不比黄金帝国王子更多。"

# game/a15/2campaign.rpy:176
translate english campaign9_97b209b8:

    # me "Полагаю я узнаю это завтра."
    me "我想明天就会知道。"

# game/a15/2campaign.rpy:177
translate english campaign9_d485f398:

    # ukradd "Между нами нет никакого сговора. Если то, о чем ты говорил на совете, правда - Борис поступил бесчестно, и я первый ему это скажу."
    ukradd "我们之间没有勾结。如果你在议会上说的是真的——鲍里斯行事无耻，我会第一个告诉他。"

# game/a15/2campaign.rpy:178
translate english campaign9_db1fcf0b:

    # me "А вы сомневаетесь в том, что это правда?"
    me "您怀疑那是真的吗？"

# game/a15/2campaign.rpy:179
translate english campaign9_4f13958f:

    # ukradd "А какие этому есть доказательства, кроме ваших слов?"
    ukradd "除了您的话，还有什么证据？"

# game/a15/2campaign.rpy:181
translate english campaign9_7601c911:

    # me "Самые простые - Скаладан не наказан."
    me "最简单的——斯凯拉丹没有受罚。"

# game/a15/2campaign.rpy:182
translate english campaign9_fa58857b:

    # ukradd "..."
    ukradd "……"

# game/a15/2campaign.rpy:183
translate english campaign9_5f8a109c:

    # me "Вы это знаете."
    me "您知道这一点。"

# game/a15/2campaign.rpy:184
translate english campaign9_47b230b5:

    # ukradd "Править простолюдинами сложнее, чем кажется. А править лордами еще сложнее. Иногда Борис делает то, что мне не нравится. Но он не бесчестил Север."
    ukradd "统治平民比看起来更难。统治领主更难。有时鲍里斯做我不喜欢的事。但他没有让北方蒙羞。"

# game/a15/2campaign.rpy:185
translate english campaign9_2ca06604:

    # me "Север бесчестил Скаладан. А Борис его поддерживал."
    me "让北方蒙羞的是斯凯拉丹。而鲍里斯支持他。"

# game/a15/2campaign.rpy:186
translate english campaign9_435e9a80:

    # ukradd "Это неправда. Иначе тебя туда не послали. К тому же горцы первые перешли к насилию. Они могли стребовать справедливости, но не дождались суда."
    ukradd "不对。否则不会派你去。而且高地人先动武。他们本可以要求公正，却没等审判。"

# game/a15/2campaign.rpy:187
translate english campaign9_b9c1bf5b:

    # me "Скаладан выгнал законную жену из дома. Сколько ждать справедливости в таком деле? Год? Десять лет?"
    me "斯凯拉丹把合法妻子赶出家门。这种事要等多久公正？一年？十年？"

# game/a15/2campaign.rpy:188
translate english campaign9_da8e83d0:

    # ukradd "Скаладана напоили. Да. Он обесчестил себя. И все же его хотя бы отчасти оправдывает наглый обман горцев и их нечестные намерения."
    ukradd "斯凯拉丹被灌醉了。是的。他让自己蒙羞。但高地人的无耻欺骗和不诚实意图至少部分为他开脱。"

# game/a15/2campaign.rpy:189
translate english campaign9_0c6fa482:

    # me "Хорошо. А что же Войцех?"
    me "好。那沃伊采赫呢？"

# game/a15/2campaign.rpy:190
translate english campaign9_45d43172:

    # ukradd "А что с ним?"
    ukradd "他怎么了？"

# game/a15/2campaign.rpy:191
translate english campaign9_337571ce:

    # me "Он пострадал. Не простолюдины. Не горцы. Другой лорд. Такой же, как и вы."
    me "他受了害。不是平民。不是高地人。另一个领主。和您一样的人。"

# game/a15/2campaign.rpy:192
translate english campaign9_be4ea459:

    # ukradd "И в чем же тут вина Бориса?"
    ukradd "那鲍里斯的错在哪里？"

# game/a15/2campaign.rpy:193
translate english campaign9_2395125e:

    # me "Даже если этот обман не был согласован - здесь точно есть вина Скаладана. Опять. Но он не наказан. Почему? Потому что для вашего короля один вассал ценнее другого?"
    me "就算这场欺骗没有协调——这里肯定有斯凯拉丹的错。又一次。但他没受罚。为什么？因为在你们国王眼里，一个附庸比另一个更值钱？"

# game/a15/2campaign.rpy:194
translate english campaign9_20ba2920:

    # ukradd "Если лорду Войцеху угодно, он может затребовать справедливости сам, но он прибыл в замок и молчит."
    ukradd "如果沃伊采赫领主愿意，他可以自己要求公正，但他到了城堡却沉默不语。"

# game/a15/2campaign.rpy:196
translate english campaign9_6af3c8e8:

    # me "Признайтесь, лорд Украдский, вы старательно оправдываете Бориса, но знаете, что он не прав."
    me "承认吧，乌克拉德斯基领主，您努力为鲍里斯辩解，但您知道他是错的。"

# game/a15/2campaign.rpy:197
translate english campaign9_156243f0:

    # ukradd "Ни я ни Борис не отвечаем за недостаток смелости у других лордов."
    ukradd "我和鲍里斯都不为其他领主缺乏勇气负责。"

# game/a15/2campaign.rpy:198
translate english campaign9_3820771a_1:

    # me "..."
    me "……"

# game/a15/2campaign.rpy:199
translate english campaign9_c8050e0a:

    # ukradd "По вашему вы будете лучшим королем? Вы думаете это легко?"
    ukradd "您觉得自己会是更好的国王？您以为这容易？"

# game/a15/2campaign.rpy:200
translate english campaign9_02ad9a96:

    # me "Я не собираюсь быть королем."
    me "我不打算当国王。"

# game/a15/2campaign.rpy:201
translate english campaign9_25923b30:

    # ukradd "Императором. Еще лучше. Вам нужно будет беспокоиться еще о десятках вассалов на Западе и в Золотом Королевстве."
    ukradd "皇帝。那更好。您还得操心西方和黄金王国几十个附庸。"

# game/a15/2campaign.rpy:202
translate english campaign9_482048f8:

    # me "Я собираюсь принести Золотой Порядок. С этими законами Империя процветала сотни лет. Это гарантия справедливости."
    me "我要带来黄金秩序。凭借这些法律，帝国繁荣了数百年。这是公正的保障。"

# game/a15/2campaign.rpy:203
translate english campaign9_cd52a5c6:

    # ukradd "Это гарантия того, что недовольный вассал может призвать сюда армии захватчиков. Я знаю о чем говорю. "
    ukradd "这保障的是，不满的附庸可以召来侵略军。我知道我在说什么。"

# game/a15/2campaign.rpy:204
translate english campaign9_1b79f3f6:

    # ukradd "Мой отец был одним из немногих сторонников твоего деда на Севере, даже когда тот уже обезумел. "
    ukradd "我父亲是北方少数支持你祖父的人之一，即使在他已经发疯之后。"

# game/a15/2campaign.rpy:205
translate english campaign9_406dfadb:

    # ukradd "Эти правила служат справедливости только до тех пор, пока тот кто стоит над ними не решит воспользоваться ими в своих целях."
    ukradd "这些规则只在站在其上的人不决定为己所用时，才服务于公正。"

# game/a15/2campaign.rpy:206
translate english campaign9_b10e9ef4:

    # me "Над Золотым Порядком никто не стоит."
    me "没人站在黄金秩序之上。"

# game/a15/2campaign.rpy:207
translate english campaign9_f00ef77b:

    # ukradd "Ты в это веришь?"
    ukradd "你相信这个？"

# game/a15/2campaign.rpy:208
translate english campaign9_b94f70bf:

    # me "Я верю в это так же, как ты веришь в своего Короля. "
    me "我相信它，就像你相信你的国王一样。"

# game/a15/2campaign.rpy:209
translate english campaign9_d31e0b1a:

    # me "Я предлагаю автономию. Если Император обесчестит себя несправедливостью и попранием закона - вы будете вольны сделать все то же самое, что сделал Север тридцать лет назад."
    me "我提议自治。如果皇帝因不公和践踏法律而蒙羞——你们将有权做北方三十年前做过的同样的事。"

# game/a15/2campaign.rpy:210
translate english campaign9_59169a41:

    # me "Но в этот раз это будет абсолютно законно."
    me "但这一次将完全合法。"

# game/a15/2campaign.rpy:211
translate english campaign9_fa58857b_1:

    # ukradd "..."
    ukradd "……"

# game/a15/2campaign.rpy:212
translate english campaign9_1992f053:

    # ukradd "Иди, принц. Мне нужно подумать."
    ukradd "去吧，王子。我没兴致再谈了，怕冻坏舌头，而且我需要想想。"

# game/a15/2campaign.rpy:213
translate english campaign9_71d3b8c8:

    # me "Хорошо."
    me "好。"

# game/a15/2campaign.rpy:220
translate english campaign10_7dac0600:

    # "Пару часов спустя."
    "几个小时后。"

