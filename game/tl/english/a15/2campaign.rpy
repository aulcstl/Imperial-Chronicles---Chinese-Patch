    # me "Ты как?"
    me "你怎么样？"

# game/a15/2campaign.rpy:342
translate english campaign10_83927d1c:

    # sona "Замечательно. Древняя кровь напитывает меня. Сила распространяется по телу. Я снова чувствую себя живой."
    sona "好极了。古老的血滋养着我。力量在体内蔓延。我又感觉自己活着了。"

# game/a15/2campaign.rpy:343
translate english campaign10_958e170e:

    # me "Думаю тебе пора идти, у тебя не слишком подходящий вид для коридоров этого замка."
    me "我想你该走了。你这副样子不太适合出现在这城堡的走廊里。"

# game/a15/2campaign.rpy:344
translate english campaign10_b18ace46:

    # sona "Да. Ты прав."
    sona "是。你说得对。"

# game/a15/2campaign.rpy:346
translate english campaign10_1e98933b:

    # me "И никого больше здесь не кусай."
    me "别再咬这里的其他人。"

# game/a15/2campaign.rpy:347
translate english campaign10_da92e651:

    # sona "{size=+5}Постараюсь!{/size}"
    sona "{size=+5}我尽量！{/size}"

# game/a15/2campaign.rpy:348
translate english campaign10_ebdfd667:

    # me "Если ты конечно не хочешь увидеть в этих стенах настоящих охотников."
    me "当然，除非你想在这城墙里见到真正的猎人。"

# game/a15/2campaign.rpy:349
translate english campaign10_69e033e5:

    # sona "{size=+5}Я буду аккуратна.{/size}"
    sona "{size=+5}我会小心。{/size}"

# game/a15/2campaign.rpy:350
translate english campaign10_3820771a_4:

    # me "..."
    me "……"

# game/a15/2campaign.rpy:351
translate english campaign10_a4be8207:

    # sona "{size=+5}Если тебе еще понадобится моя помощь...{/size}"
    sona "{size=+5}如果你还需要我帮忙……{/size}"

# game/a15/2campaign.rpy:352
translate english campaign10_a0d14a72:

    # me "Ага. Я обязательно тебе сообщу."
    me "嗯。我一定会告诉你。"

# game/a15/2campaign.rpy:353
translate english campaign10_824a7e60:

    # sona "{size=+5}Я всегда буду рядом!{/size}"
    sona "{size=+5}我会一直在附近！{/size}"

# game/a15/2campaign.rpy:354
translate english campaign10_1150228b:

    # me "Не сомневаюсь."
    me "我不怀疑。"

# game/a15/2campaign.rpy:358
translate english campaign10_7dac0600_1:

    # "Пару часов спустя."
    "几个小时后。"

# game/a15/2campaign.rpy:359
translate english campaign10_6e0b8ddc_1:

    # hunterf "...я так и не понял, чем могу помочь."
    hunterf "……我还是不明白我能帮什么。"

# game/a15/2campaign.rpy:360
translate english campaign10_4e4415da_1:

    # me "Я беспокоюсь о безопасности вашего лорда."
    me "我担心您领主的安全。"

# game/a15/2campaign.rpy:361
translate english campaign10_ce66a9fa_1:

    # hunterf "Уверяю вас - он в безопасности."
    hunterf "我向您保证——他很安全。"

# game/a15/2campaign.rpy:362
translate english campaign10_18532400_1:

    # me "И все же..."
    me "但还是……"

# game/a15/2campaign.rpy:363
translate english campaign10_1ab4eee9_1:

    # hunterf "Послушайте, принц, охота на вампиров - тонкое искусство. Я ведь не даю советы художникам и скульпторам. Я не знаю ничего о их ремесле."
    hunterf "听着，王子，猎杀吸血鬼是门精细的艺术。我不会给画家和雕塑家建议。我对他们的手艺一无所知。"

# game/a15/2campaign.rpy:364
translate english campaign10_55dbdbe5:

    # me "Я хотел обсудить вовсе не это."
    me "我想讨论的根本不是这个。"

# game/a15/2campaign.rpy:365
translate english campaign10_330650e5:

    # hunterf "А что?"
    hunterf "那是什么？"

# game/a15/2campaign.rpy:367
translate english campaign10_4376431a:

    # cass "Охотников на вампиров."
    cass "吸血鬼猎人。"

# game/a15/2campaign.rpy:368
translate english campaign10_729ceac1:

    # hunterf "Простите?"
    hunterf "什么？"

# game/a15/2campaign.rpy:369
translate english campaign10_503513e1:

    # me "Это моя сестра. Она всегда интересовалась вашим ремеслом. Попросила меня вас познакомить."
    me "这是我妹妹。她一直对您的手艺感兴趣。让我介绍你们认识。"

# game/a15/2campaign.rpy:370
translate english campaign10_8564aa21:

    # cass "Ага. С детства люблю книжки про охотников на вампиров."
    cass "对。我从小就喜欢吸血鬼猎人的书。"

# game/a15/2campaign.rpy:371
translate english campaign10_2de871dc:

    # hunterf "Да ну..."
    hunterf "是吗……"

# game/a15/2campaign.rpy:372
translate english campaign10_5de80f87:

    # me "Правда. Мы все детство в них играли."
    me "真的。我们整个童年都在玩这个。"

# game/a15/2campaign.rpy:373
translate english campaign10_69564879:

    # cass "Только увидела ваши колья, вашу серебряную рапиру, шляпу с желтым камнем и эти защитные руны... вы просто персонаж из книги... как вас там?"
    cass "一看到您的木桩、银制细剑、带黄石头的帽子和那些防护符文……您简直就是书里的人物……您叫什么来着？"

# game/a15/2campaign.rpy:374
translate english campaign10_93782e70:

    # hunterf "Зачем вам мое имя?"
    hunterf "您要我的名字做什么？"

# game/a15/2campaign.rpy:375
translate english campaign10_2611796f:

    # me "Было бы невежливо общаться на 'ты'."
    me "一直用‘你’称呼太不礼貌了。"

# game/a15/2campaign.rpy:376
translate english campaign10_10dd2617:

    # cass "Очень невежливо."
    cass "非常不礼貌。"

# game/a15/2campaign.rpy:377
translate english campaign10_830fd2bb:

    # hunterf "Знаете, господа, я с удовольствием с вами бы поговорил... но уже поздно и..."
    hunterf "你们知道吗，先生们，我很乐意和你们谈……但已经很晚了，而且……"

# game/a15/2campaign.rpy:379
translate english campaign10_139533c7:

    # me "Боюсь откладывать до завтра мы не можем."
    me "恐怕不能拖到明天。"

# game/a15/2campaign.rpy:380
translate english campaign10_95948d8b:

    # cass "Ага. Мы торопимся."
    cass "对。我们赶时间。"

# game/a15/2campaign.rpy:381
translate english campaign10_6dbfef63:

    # hunterf "Что вам надо?"
    hunterf "你们要什么？"

# game/a15/2campaign.rpy:382
translate english campaign10_b8598b5a:

    # me "Мы хотим помочь твоему лорду."
    me "我们想帮你领主。"

# game/a15/2campaign.rpy:383
translate english campaign10_4f7d70ee:

    # cass "Угу. Ты же обеспечиваешь его безопасность?"
    cass "嗯。你不是在保障他的安全吗？"

# game/a15/2campaign.rpy:384
translate english campaign10_eea9d6bd:

    # hunterf "Это делает его стража. Я обеспечиваю..."
    hunterf "那是他的卫兵做的。我提供的是……"

# game/a15/2campaign.rpy:385
translate english campaign10_7a70c2fd:

    # me "Спокойствие?"
    me "安心？"

# game/a15/2campaign.rpy:386
translate english campaign10_72604343:

    # cass "Похоже на то."
    cass "看起来是。"

# game/a15/2campaign.rpy:387
translate english campaign10_1a306a0f:

    # hunterf "Лорд Острожский очень беспокоится из-за вампиров."
    hunterf "奥斯特罗日斯基领主非常担心吸血鬼。"

# game/a15/2campaign.rpy:388
translate english campaign10_3dff8f48:

    # me "Это мы знаем."
    me "我们知道。"

# game/a15/2campaign.rpy:389
translate english campaign10_2fe01e91:

    # cass "Ему однозначно нужна помощь такого специалиста, как ты. Думаю если бы не твоя рапира, он бы уже был мертв."
    cass "他肯定需要你这样的专家帮忙。我想要不是你的细剑，他早死了。"

# game/a15/2campaign.rpy:390
translate english campaign10_c2857608:

    # hunterf "Вампиры реальны. Так же, как и мы с вами. Иначе мой орден бы не существовал."
    hunterf "为什么这么讽刺？吸血鬼是真的。就像你和我一样真。否则我的修会就不会存在。"

# game/a15/2campaign.rpy:391
translate english campaign10_e2fee9c6:

    # me "Разумеется. И именно поэтому ты должен сказать своему лорду убираться из этого замка немедленно."
    me "当然。所以你必须告诉你的领主立刻离开这座城堡。"

# game/a15/2campaign.rpy:392
translate english campaign10_16e62f22:

    # hunterf "Это еще почему?"
    hunterf "这又是为什么？"

# game/a15/2campaign.rpy:393
translate english campaign10_053bfa39:

    # cass "Потому что тут очень много вампиров."
    cass "因为这里有很多吸血鬼。"

# game/a15/2campaign.rpy:394
translate english campaign10_c02a0d91:

    # me "Но не настолько много, чтобы уезжать вместе с сыном."
    me "但没多到要带儿子一起走。"

# game/a15/2campaign.rpy:395
translate english campaign10_79d8b316:

    # cass "Ага. Ну так. Средне вампиров."
    cass "对。就那样。中等数量的吸血鬼。"

# game/a15/2campaign.rpy:396
translate english campaign10_fcb2e7a5:

    # hunterf "Что вы несете? Я ухожу."
    hunterf "你们在胡说什么？我走了。"

# game/a15/2campaign.rpy:397
translate english campaign10_033bfa61:

    # me "Значит будет по-плохому."
    me "那就来硬的。"

# game/a15/2campaign.rpy:399
translate english campaign10_0c4932d2:

    # hunterf "Вы что делаете?"
    hunterf "你们在做什么？"

# game/a15/2campaign.rpy:400
translate english campaign10_4278feed:

    # me "Думаешь распотрошить его прямо здесь?."
    me "你觉得我们该就在这里把他开膛？"

# game/a15/2campaign.rpy:401
translate english campaign10_52736d96:

    # cass "Ага. Сначала я выколю ему глаза, а потом отрежу язык. Закончу его яицами."
    cass "对。先挖他的眼睛，再割他的舌头。最后割掉他的蛋。"

# game/a15/2campaign.rpy:402
translate english campaign10_5d58166b:

    # hunterf "Прошу! Не надо! Что вы..."
    hunterf "求你们！不要！你们……"

# game/a15/2campaign.rpy:403
translate english campaign10_872b4f8c:

    # cass "Дебил, не притворяйся, что не понял, что нам нужно."
    cass "白痴，别装不懂我们要什么。"

# game/a15/2campaign.rpy:404
translate english campaign10_a8d32b87:

    # hunterf "Я не... не понимаю зачем вам это?"
    hunterf "我不……不明白你们为什么要这样？"

# game/a15/2campaign.rpy:405
translate english campaign10_f44abf06:

    # me "А тебе и не нужно."
    me "你不需要明白。"

# game/a15/2campaign.rpy:406
translate english campaign10_455ee1c8:

    # cass "Вот именно. Сделай, что от тебя требуется и все."
    cass "没错。做你该做的就行。"

# game/a15/2campaign.rpy:407
translate english campaign10_adae024f:

    # hunterf "Увезти лорда Острожского?"
    hunterf "把奥斯特罗日斯基领主带走？"

# game/a15/2campaign.rpy:408
translate english campaign10_31eacc4f:

    # me "Да. А его сына здесь оставить."
    me "对。把他儿子留下。"

# game/a15/2campaign.rpy:409
translate english campaign10_1d526839:

    # hunterf "Как я это сделаю?"
    hunterf "我该怎么做？"

# game/a15/2campaign.rpy:410
translate english campaign10_09052fbf:

    # me "Придумай что-то. До этого же ты водил старика за нос."
    me "想办法。你之前不也一直牵着那老头的鼻子走。"

# game/a15/2campaign.rpy:411
translate english campaign10_2693b1cb_1:

    # hunterf "В каком смысле?"
    hunterf "什么意思？"

# game/a15/2campaign.rpy:412
translate english campaign10_481c262b:

    # cass "Не придуривайся. Или я запихну тебе твой бутафорский меч прямо в задницу."
    cass "别装傻。不然我把你那把道具剑塞进你屁股里。"

# game/a15/2campaign.rpy:413
translate english campaign10_26680038_1:

    # hunterf "Я..."
    hunterf "我……"

# game/a15/2campaign.rpy:414
translate english campaign10_5fdadc27:

    # cass "Что? Хочешь сказать весь этот идиотский маскарад для сражения с вампирами?"
    cass "什么？你想说这整套白痴伪装是为了和吸血鬼战斗？"

# game/a15/2campaign.rpy:415
translate english campaign10_6a1c6699:

    # hunterf "...что мне сказать? Я могу напугать его, но он заберет сына с собой."
    hunterf "……我该说什么？我可以吓唬他，但他会带儿子一起走。"

# game/a15/2campaign.rpy:416
translate english campaign10_962fa806:

    # me "Скажи что это место прокляли именно для старшей крови, что с сыном будет все в порядке, а сам лорд Острожский умрет."
    me "告诉他这地方被诅咒专门针对年长之血，他儿子会没事，但奥斯特罗日斯基领主本人会死。"

# game/a15/2campaign.rpy:417
translate english campaign10_8946ec0f:

    # cass "Или что на него объявил охоту могущественный вампир и ехать надо прямо сейчас, запутай его, сними еле проснувшегося с постели, соври что сын поедет вместе с ним."
    cass "或者说有个强大的吸血鬼在猎杀他，必须马上走。把他搞糊涂，把刚睡醒的他从床上拉起来，骗他说儿子会和他一起去。"

# game/a15/2campaign.rpy:418
translate english campaign10_4bd7b795:

    # cass "Какого хера мы должны придумывать за тебя?"
    cass "凭什么我们要替你想？"

# game/a15/2campaign.rpy:419
translate english campaign10_e5936bbd:

    # hunterf "Ладно-ладно. Я все сделаю."
    hunterf "好吧好吧。我会照做。"

# game/a15/2campaign.rpy:420
translate english campaign10_c96a2ee3:

    # me "И не вздумай нас обмануть. Иначе твой секрет раскроется."
    me "别想骗我们。否则你的秘密就会暴露。"

# game/a15/2campaign.rpy:421
translate english campaign10_e8795d8d:

    # cass "Мы действуем не одни - попросишь защиты и тебе отрубит голову сын твоего лорда."
    cass "我们不是单独行动——你若去求保护，你领主的儿子会砍掉你的头。"

# game/a15/2campaign.rpy:422
translate english campaign10_f6fbd66c:

    # hunterf "Вы.. вы заодно?"
    hunterf "你们……你们是一伙的？"

# game/a15/2campaign.rpy:423
translate english campaign10_2caee91a:

    # me "Сделай, что нужно и тебе не придется об этом думать вообще."
    me "做该做的事，你就根本不用想这个。"

# game/a15/2campaign.rpy:424
translate english campaign10_892b9015:

    # cass "Ладно. Отпускай его."
    cass "好了。放他走。"

# game/a15/2campaign.rpy:426
translate english campaign10_ff3d12e1:

    # me "Ну что? Думаешь сработает?"
    me "怎么样？你觉得能行吗？"

# game/a15/2campaign.rpy:427
translate english campaign10_7a454f3d:

    # cass "Надеюсь."
    cass "希望吧。"

# game/a15/2campaign.rpy:428
translate english campaign10_8d88c0e7:

    # me "Откуда ты знала, что он не настоящий охотник?"
    me "你怎么知道他不是真猎人？"

# game/a15/2campaign.rpy:429
translate english campaign10_dfb5b838:

    # cass "Я и не знала. Просто показалось странным, что охотник одевается ровно так же, как и персонаж из книги."
    cass "我也不知道。只是觉得奇怪，一个猎人穿得和书里角色一模一样。"

# game/a15/2campaign.rpy:430
translate english campaign10_12e0ebf7:

    # me "Было бы неловко, если бы это оказался настоящий охотник."
    me "要是他真是猎人，那就尴尬了。"

# game/a15/2campaign.rpy:431
translate english campaign10_879f5687:

    # cass "Это бы ничего не поменяло."
    cass "那也不会改变什么。"

# game/a15/2campaign.rpy:432
translate english campaign10_b14e56de:

    # me "Может быть. А может быть он оказался бы мужественнее."
    me "也许。也许他会更勇敢。"

# game/a15/2campaign.rpy:433
translate english campaign10_5dacf2d5:

    # cass "А может он и оказался. Только не мужественнее, а хитрее - притворился, что послушал нас."
    cass "也许他确实更勇敢。但不是更勇敢，而是更狡猾——假装听了我们的。"

# game/a15/2campaign.rpy:434
translate english campaign10_3820771a_5:

    # me "..."
    me "……"

# game/a15/2campaign.rpy:435
translate english campaign10_d46d9a61:

    # cass "Ладно. Не думаю, что это так. В любом случае мы всегда можем просто все отрицать."
    cass "好了。我不觉得会这样。无论如何，我们总能一概否认。"

# game/a15/2campaign.rpy:436
translate english campaign10_dbbbb602:

    # me "И то верно."
    me "确实。"

# game/a15/2campaign.rpy:437
translate english campaign10_dfa6ab56:

    # cass "У тебя еще есть с кем поговорить?"
    cass "你还有别人要谈吗？"

# game/a15/2campaign.rpy:438
translate english campaign10_fc30fd2b:

    # me "Да."
    me "有。"

# game/a15/2campaign.rpy:439
translate english campaign10_4cc9600a:

    # cass "Тогда не буду отвлекать."
    cass "那我不打扰了。"

# game/a15/2campaign.rpy:440
translate english campaign10_2e2b7a66:

    # me "Спасибо, [cass]."
    me "谢谢，[cass]。"

# game/a15/2campaign.rpy:441
translate english campaign10_f0dc9787:

    # cass "Не благодари. Это наше общее дело."
    cass "别谢。这是我们共同的事。"

# game/a15/2campaign.rpy:445
translate english campaign10_0f476a5d:

    # "Чуть позже."
    "稍后。"

# game/a15/2campaign.rpy:446
translate english campaign10_1229b7a9:

    # ostr_old "...проверьте крипту..."
    ostr_old "……检查地穴……"

# game/a15/2campaign.rpy:447
translate english campaign10_6044eb9c:

    # ostr_old "Нет... дважды проверьте крипту..."
    ostr_old "不……再检查一遍地穴……"

# game/a15/2campaign.rpy:448
translate english campaign10_21ce5441:

    # ostr_old "Пусть лучше стражники держат там круглосуточный дозор."
    ostr_old "最好让守卫在那里全天候看守。"

# game/a15/2campaign.rpy:449
translate english campaign10_7e6ecac1:

    # ostr_old "Дорогая жена...нет.. ее же съели..."
    ostr_old "亲爱的妻子……不……她被吃了……"

# game/a15/2campaign.rpy:450
translate english campaign10_56a972db:

    # ostr_old "Надо написать письмо дочери..."
    ostr_old "该给女儿写信……"

