    # me "Помочь? Вывести тебя на свежий воздух?"
    me "要帮忙吗？带你出去透透气？"

# game/a15/2campaign.rpy:113
translate english campaign8_3ad894fa:

    # eva "Нет... нет... все нормально..."
    eva "不……不……没事……"

# game/a15/2campaign.rpy:114
